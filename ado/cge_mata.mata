*! cge_mata.mata  v0.9.0  2026-10-23
*! cge-stata: Mata library (model structure, calibration, equations, solver)
*! Equation labels and calibration steps follow docs/model_spec.md
*!
*! Author: Mustapha Wasseja
*! Requires: Stata 13+

version 13.0

mata:

// =====================================================================
// Structures
// =====================================================================

struct cge_par {
    real colvector pwm, pwe, tm, te, tq, ta
    real colvector iva, inta, ad, rva, sva
    // top nest: efficiency, value-added share and its complement, exponent, elasticity
    real colvector aa, dla, dlac, rha, sa
    real matrix    ica, dva, theta, icm
    real colvector at, dt, dtc, rt, aq, dq, dqc, rq, sq, st
    real matrix    shif, beta, gamma
    real colvector tins0, mps0, shir, hc, trdg, trdr, trfr, qg, qinv, cwts, dwts, qer
    real matrix    shii
    real scalar    trgr, trrg, trgg
    // health insurance fund: contribution rates, purchases, savings rate and
    // transfers from government and the rest of the world
    real colvector tshi, qshi
    real scalar    sshi, trshi, trshir
    // factor efficiency: exogenous efficiency, elasticity with respect to
    // health services and base volume of health services
    real colvector af, etah
    real scalar    hs0
    // VAT (from version 0.3.1): rates by commodity and credit shares by activity
    real colvector tv, kappa
    // public debt (from version 0.3.1): flag, stocks at the start of the period
    // (domestic in local currency, foreign in foreign currency), interest
    // rates, holders of domestic debt and the foreign share of new borrowing
    real scalar    debt, ddebt, fdebt, rd, rf, phi
    real colvector hold
    // margins by market (from version 0.3.2): services per unit of domestic
    // sales, imports and exports; export demand elasticities (0 = none) and
    // base exports; home consumption shares and subsistence quantities
    real matrix    icd, ici, ice
    real colvector etae, qe0
    real matrix    betah, gammah
    // labour-market regimes (from version 0.3.3): factors with a labour force
    // (flag), labour force, base unemployment rate, wage-curve elasticity,
    // reference real wage, real minimum wage, factors with a floor (flag) and
    // the smoothing parameter of the minimum-wage condition
    real colvector inlf, qlf, u0, epsw, wref, wmin, hasmin
    real scalar    mu
    // health outcomes (from version 0.3.4): factors with days lost to illness
    // (flag), base and current shares of working time lost and their
    // elasticities; base and current death rates and their elasticity, a flag
    // for a death rate, the population index and a flag for the health link
    real colvector ins, sick0, sick, epss
    real scalar    mort0, mort, epsm, hasmort, pop, hlink
    // bounds and complementarity (from version 0.4.4): recipients of the rents
    // on imports, exports and activity output, as positions in the list of
    // factors, households and enterprises, government and rest of the world;
    // for each constraint its regime (0 none, 1 smoothed, 2 binding, 3 not
    // binding), its bound and the reference level of its adjusting variable;
    // and the smoothing of the conditions
    real colvector rrm, rre, rra, bmode, bval, bxbar
    real scalar    bmu
    // taxes on factor use by activity (factor x activity) and on factor income
    // (from version 0.5.0)
    real matrix    tf
    real colvector tfy
    // nests of value added (from version 0.5.1): shares of the nests at the
    // top of value added and their efficiency (nest x activity), shares of
    // commodities within their nests (commodity x activity), and the
    // elasticities and exponents of the nests
    real matrix    dvn, an, dce
    real colvector sgn, rhn
    // output of a commodity from several activities (from version 0.5.2):
    // elasticities (0 for perfect substitutes), exponents and efficiency of
    // the aggregates by commodity, and the shares of the activities
    real colvector sac, rac, aac
    real matrix    dac
    // user parameters (from version 0.7.1): their values, row by row, in the
    // order of M.updef
    real colvector upval
    // lagged values (from version 0.9.2): in a period of a dynamic run, the
    // values of the variables one to four periods before, one column each;
    // none in a static simulation, where the period before is the base
    real matrix    xlag
    // values of later periods (from version 0.10.2): in a period of a run
    // with foresight, the values one to four periods later, one column each,
    // by the terminal condition beyond the last period; none in a static
    // simulation, where they are the base
    real matrix    xlead
    // the period (from version 0.10.2): its number, and 1 in the first and
    // in the last period of a dynamic run; none in a static simulation
    real rowvector tinfo
}

struct cge_model {
    // SAM as read (labels0, S0) and after rewriting layouts (labels, S)
    string colvector labels0, labels
    real matrix      S0, S
    real rowvector   rewritten
    real scalar      mapped, calibrated
    real colvector   iA, iC, iF, iH
    real scalar      igov, isav, irow, idirtax, isaltax, iimptax, iexptax, iacttax
    // health insurance fund (0 when none is mapped)
    real scalar      ishi
    // VAT account (0 when none is mapped; from version 0.3.1)
    real scalar      ivattax
    // from version 0.3.2: market of each margin account in iT (0 composite
    // supply, 1 domestic sales, 2 imports, 3 exports); export-only commodities,
    // commodities with finite export demand, with domestic sales and with
    // composite supply
    real colvector   tmkt, cxe, ced, cdo, cq
    string colvector A, C, F, H, I
    real colvector   iE, imargins, iterritorial, iT, istocks
    string colvector E, D
    // n activities, nC commodities (nC >= n from version 0.1.7)
    real scalar      n, nC, nF, nH, nE, nD, nI
    // model structure
    real colvector   ce, cm, cd, cx, ct, cr, cshi
    // health services whose consumption raises factor efficiency
    real colvector   chs
    // activities with a Leontief top nest, and with a Cobb-Douglas one
    real colvector   lt, cda
    real matrix      fa
    // parameters: base (p0) and current, including shocks (p)
    struct cge_par scalar p0, p
    // variable layout; all variables are stacked in one vector x
    string colvector vname, vset
    real colvector   voff, vrows, vcols
    real colvector   x0, xcur, xscale, exists, fixed, nominal, positive
    // sparsity pattern of the Jacobian for the rows found by grouped differences,
    // as (equation, variable) pairs, and the rows with exact derivatives
    real colvector   jr, jc, drow, drow2
    // reduced system (from version 0.2.0): explicit definitions that are left
    // out (dact, one flag per candidate), the variables they define (derived),
    // the remaining equations (rmask) and their pattern (rjr, rjc, rdrow)
    real colvector   dact, derived, rmask, rjr, rjc, rdrow, rdrow2
    // equation blocks
    string colvector ename
    real colvector   elen, escale, emask
    // built-in equation elements that user equations replace (from version
    // 0.9.3): block and element labels, and their rows in the equations
    string matrix    urep
    // blocks declared with cge_nest (from version 0.11.0): name and the
    // declarations, one per line
    string matrix    unest
    real colvector   erep
    real scalar      neq
    // closure
    string scalar    c_ext, c_gov, c_si, c_num
    // options of the last calibration (from version 0.2.1)
    string rowvector calargs
    string colvector c_fac
    // stored simulations
    string colvector simname, simclosure, simmethod
    real matrix      simx
    struct cge_par rowvector simp
    real colvector   simconv, simiter, simres
    // dynamic runs (from version 0.2.0): run name, period and uniform efficiency
    // factor of each stored simulation ("" and missing for static ones)
    string colvector simrun
    real colvector   simper, simlam
    // constraints (from version 0.4.4): positions of the limited and adjusting
    // variables, bound type (1 upper, -1 lower) and direction of the adjusting
    // variable (1 up, -1 down); the constraints and regimes of each simulation
    real colvector   bY, bX, btype, bdir
    string colvector simcons
    // closure swaps (from version 0.4.5): positions of the variables fixed and
    // of those freed, in pairs, applied after the closure's options
    real colvector   swfix, swfree
    // factor taxes (from version 0.5.0): accounts of taxes on factor use and
    // the factor each taxes (a position in iF), and the account of the tax on
    // factor income (0 if none)
    real colvector   iFT, ftf
    real scalar      iFY
    // nests of value added (from version 0.5.1): names, the nest of each
    // factor and commodity (0 for none), Cobb-Douglas nests, the nests each
    // activity uses (nest x activity) and the commodities in nests that each
    // activity buys (commodity x activity)
    string colvector N
    real scalar      nN
    real colvector   nestf, nestc, cdn
    real matrix      nn, ecell
    // output of a commodity from several activities (from version 0.5.2):
    // commodities aggregated, Cobb-Douglas aggregates, and the activities'
    // outputs aggregated (activity x commodity)
    real colvector   cac, cdac
    real matrix      xac
    // user variables and equations (from version 0.6.1): the number of user
    // variables, the last ones of the layout, and their definitions (name,
    // set, expression or value, index, "nominal", "defined" or "value"); the
    // equations as given (name, index, set, left side, right side); compiled,
    // the postfix rows of each element's two sides (from ustart, of lengths
    // ulen and ulen2), the elements' labels, their GAMS text and the
    // parameters they use
    real scalar      nuv
    string matrix    uvdef, uedef, uegams
    // user sets (name, labels) and parameters (name, set of each index), from
    // version 0.7.1
    string matrix    usdef, updef
    // user macros (from version 0.9.7): name, parameters and expression
    string matrix    umac
    // attributes of variables (from version 0.9.8), as GAMS's .lo, .up,
    // .scale and .l: the definitions of cge_bound (variable, elements, lower,
    // upper, scale, level, "relative"), applied in order; the positions and
    // values of the lower and upper bounds and the starting levels they give,
    // and the positions given a scale
    string matrix    bddef
    real colvector   bdlp, bdlv, bdup, bduv, bdsp, bdsv, bdcp
    // scenario loops (from version 0.9.9): name, simulations and targets
    string matrix    loopdef
    // the linear solver of Newton's steps (from version 0.10.1): 0 or missing
    // dense LU, 1 sparse LU, 2 sparse from 1,000 equations
    real scalar      linsolver
    // a standalone model (from version 0.13.0): 1 for a model written whole
    // in the user language (cge_model new), without a SAM or the built-in
    // equations; missing for a model from a SAM
    real scalar      standalone
    // the method for constraints (from version 0.14.0): 0 or missing the
    // semismooth Newton method, 1 the active-set method of version 0.4.4
    real scalar      mcpsolver
    // the objective of each stored simulation solved as a nonlinear
    // programme (from version 0.15.0): min: or max: and its expression; empty
    // for the others, and missing rows are empty
    string colvector simobj
    // the options of the solver (from version 0.16.0), as GAMS's option
    // statement, saved with the model: the tolerance, iteration limit and time
    // limit (seconds) of cge_solve, and the Jacobian of Newton's method (0 or
    // missing exact, 1 central differences); missing for the defaults
    real scalar      opttol, optit, opttime, optjac
    // the model status and solver status of each stored simulation, in GAMS's
    // codes (from version 0.16.0); missing where unknown
    real matrix      simstat
    // named models (from version 0.17.0), as GAMS's model statement: each
    // name and its list of equations, models or all; and the model each
    // stored simulation solved, empty for the whole model
    string matrix    mdef
    string colvector simmodel
    // integer and binary variables (from version 0.18.0), as GAMS's integer
    // and binary variables: each definition's variable, elements and type
    // (integer, binary or continuous), applied in order
    string matrix    intdef
    // the players of cge_nash (from version 0.20.0): each player's name,
    // instruments, sense (maximize or minimize), objective and bounds
    string matrix    nashdef
    real matrix      utok
    real colvector   ustart, ulen, ulen2
    string colvector uelab, upar
}

// Columns of the Jacobian for one solve (free variables), grouped so that the
// columns of a group share no equation: CSC storage of the pattern (rows of
// column j are crow[cstart[j]..cstart[j+1]-1]) and the members of each group
// (gcol[gstart[g]..gstart[g+1]-1])
struct cge_jpat {
    real colvector cstart, crow, gstart, gcol
    real scalar    ncolour
}

// Package version; it must equal the version in cge.ado
string scalar _cge_version()
{
    return("0.20.0")
}

// =====================================================================
// Storage of the model in a Mata global
// =====================================================================

struct cge_model scalar _cge_load()
{
    pointer() scalar q
    q = findexternal("cge__model")
    if (q == NULL) {
        errprintf("no SAM in memory; load one with cge_sam\n")
        exit(459)
    }
    return(*q)
}

void _cge_store(struct cge_model scalar M)
{
    pointer() scalar q
    if ((q = findexternal("cge__model")) == NULL) q = crexternal("cge__model")
    *q = M
}

void _cge_need(struct cge_model scalar M, string scalar what)
{
    if (what == "mapped" & !M.mapped) {
        errprintf("assign SAM accounts to model roles with cge_map first\n")
        exit(459)
    }
    if (what == "calibrated" & !M.calibrated) {
        errprintf("calibrate the model with cge_calibrate first\n")
        exit(459)
    }
    // a standalone model (from version 0.13.0) has no SAM and no built-in
    // equations
    if (what == "sam" & _cge_sa(M)) {
        errprintf("this command needs a model calibrated from a SAM; the model in memory is a standalone\n")
        errprintf("model, written in the user language (cge_model new)\n")
        exit(459)
    }
}

// Fails when the model in memory is a standalone model (from version
// 0.13.0), before a command that needs a SAM reads its options
void _cge_need_sam()
{
    pointer() scalar q
    struct cge_model scalar M
    if ((q = findexternal("cge__model")) == NULL) return
    M = *q
    _cge_need(M, "sam")
}

// 1 for a standalone model (from version 0.13.0): a model written whole in
// the user language with cge_model new, without a SAM or built-in equations
real scalar _cge_sa(struct cge_model scalar M)
{
    return(M.standalone == 1)
}

// =====================================================================
// Small utilities
// =====================================================================

real scalar _cge_find(string colvector set, string scalar label)
{
    real scalar k
    for (k = 1; k <= rows(set); k++) if (set[k] == label) return(k)
    return(0)
}

// Submatrix of the SAM; an index of 0 (unmapped tax account) gives zeros.
real matrix _cge_sub(real matrix S, real colvector r, real colvector c)
{
    real matrix out
    real scalar i, j
    out = J(rows(r), rows(c), 0)
    for (i = 1; i <= rows(r); i++) {
        for (j = 1; j <= rows(c); j++) {
            if (r[i] > 0 & c[j] > 0) out[i, j] = S[r[i], c[j]]
        }
    }
    return(out)
}

real colvector _cge_elast(string scalar spec, real scalar n, string scalar name)
{
    real rowvector v
    v = strtoreal(tokens(spec))
    if (cols(v) == 1) v = J(1, n, v)
    if (cols(v) != n) {
        errprintf("%s() needs 1 or %f values\n", name, n)
        exit(198)
    }
    if (hasmissing(v) | min(v) <= 0) {
        errprintf("%s() values must be positive\n", name)
        exit(198)
    }
    return(v')
}

// Indices where a mask is set, as a column vector (0 x 1 when none)
real colvector _cge_which(real colvector mask)
{
    if (rows(mask) == 0) return(J(0, 1, .))
    if (!any(mask)) return(J(0, 1, .))
    return(select((1::rows(mask)), mask))
}

void _cge_fail(string scalar msg, real scalar rc)
{
    errprintf("%s\n", msg)
    exit(rc)
}

// Fails if any element of mask is set, naming the accounts concerned
void _cge_fail_if(real colvector mask, string colvector names, string scalar msg, real scalar rc)
{
    string colvector bad
    if (!max(mask)) return
    bad = select(names, mask)
    errprintf("%s: %s%s\n", msg, invtokens(bad[|1 \ min((rows(bad), 10))|]'),
              (rows(bad) > 10 ? sprintf(" and %f more", rows(bad) - 10) : ""))
    exit(rc)
}

// =====================================================================
// Variable layout
// =====================================================================

void _cge_dims(struct cge_model scalar M, string scalar set, real scalar r, real scalar c)
{
    string scalar s1, s2
    if (set == "") {
        r = 1
        c = 1
        return
    }
    // a user set (from version 0.7.1), or two sets (from version 0.9.1)
    _cge_setparts(set, s1, s2)
    r = _cge_setsize(M, s1)
    c = (s2 == "" ? 1 : _cge_setsize(M, s2))
}

// The parts of a set code: two-index codes are "S1|S2" (from version 0.9.1),
// or two letters of the model's sets; one-index codes a letter or "~name"
void _cge_setparts(string scalar set, string scalar s1, string scalar s2)
{
    real scalar k
    s1 = set
    s2 = ""
    if (set == "") return
    k = strpos(set, "|")
    if (k) {
        s1 = substr(set, 1, k - 1)
        s2 = substr(set, k + 1, .)
        return
    }
    if (substr(set, 1, 1) == "~") return
    if (strlen(set) == 2) {
        s1 = substr(set, 1, 1)
        s2 = substr(set, 2, 1)
    }
}

real scalar _cge_setsize(struct cge_model scalar M, string scalar s)
{
    real scalar k
    if (substr(s, 1, 1) == "~") {
        k = _cge_us_find(M, substr(s, 2, .))
        if (!k) _cge_fail("user set " + substr(s, 2, .) + " is not defined", 111)
        return(cols(tokens(M.usdef[k, 2])))
    }
    if (s == "A") return(M.n)
    if (s == "C") return(M.nC)
    if (s == "F") return(M.nF)
    if (s == "H") return(M.nH)
    if (s == "D") return(M.nD)
    if (s == "I") return(M.nI)
    if (s == "N") return(M.nN)
    _cge_fail("cge internal error: unknown set " + s, 3498)
}

void _cge_layout(struct cge_model scalar M)
{
    real scalar k, r, c, off
    // a standalone model (from version 0.13.0) has only user variables
    if (_cge_sa(M)) {
        M.vname = J(0, 1, "")
        M.vset = J(0, 1, "")
    }
    else _cge_layout_std(M)
    // user variables (from version 0.6.1) come last
    M.nuv = rows(M.uvdef)
    if (M.nuv) {
        M.vname = M.vname \ M.uvdef[., 1]
        M.vset = M.vset \ M.uvdef[., 2]
    }
    M.voff = J(rows(M.vname), 1, 0)
    M.vrows = M.voff
    M.vcols = M.voff
    off = 0
    for (k = 1; k <= rows(M.vname); k++) {
        _cge_dims(M, M.vset[k], r, c)
        M.voff[k] = off
        M.vrows[k] = r
        M.vcols[k] = c
        off = off + r * c
    }
}

// The variables of the model built from a SAM, in the order of the layout
void _cge_layout_std(struct cge_model scalar M)
{
    M.vname = ("PA","PVA","PINTA","PX","PD","PE","PM","PQ","W","EXR","CPI","DPI",
               "QA","QVA","QINTA","QF","QINT","QX","QD","QE","QM","QQ","QH","QG","QINV","QFS",
               "YF","YIF","YI","EH","YG","EG","GSAV","FSAV","TINS","MPS","TINSADJ","MPSADJ",
               "IADJ","GADJ","WFDIST","WALRAS","QT","QER","YSHI","SHIADJ","QSHI","EFF","HS",
               "TQADJ","TMADJ","TVADJ","PWE","QHA","LSW","LSM","DW","RM","RE","RA","QNA","PNA",
               "PXAC","QXAC")'
    M.vset  = ("A","A","A","C","C","C","C","C","F","","","",
               "A","A","A","FA","CA","C","C","C","C","C","CH","C","C","F",
               "F","IF","D","H","","","","","D","D","","",
               "","","FA","","C","C","","","C","F","",
               "","","","C","AH","F","F","F","C","C","A","NA","NA","AC","AC")'
}

real scalar _cge_vidx(struct cge_model scalar M, string scalar name)
{
    return(_cge_find(M.vname, name))
}

// Positions of the elements of variable k (none for QNA and PNA without
// nests: in Mata 1::0 counts down)
real colvector _cge_vpos(struct cge_model scalar M, real scalar k)
{
    if (M.vrows[k] * M.vcols[k] == 0) return(J(0, 1, .))
    return(M.voff[k] :+ (1::M.vrows[k] * M.vcols[k]))
}

real matrix _cge_v(struct cge_model scalar M, real colvector x, real scalar k)
{
    if (M.vrows[k] * M.vcols[k] == 0) return(J(M.vrows[k], M.vcols[k], .))
    return(colshape(x[|M.voff[k] + 1 \ M.voff[k] + M.vrows[k] * M.vcols[k]|]', M.vcols[k]))
}

void _cge_setv(struct cge_model scalar M, real colvector x, string scalar name, real matrix value)
{
    real scalar k
    k = _cge_vidx(M, name)
    if (rows(value) != M.vrows[k] | cols(value) != M.vcols[k]) {
        _cge_fail("cge internal error: wrong dimensions for " + name, 3200)
    }
    // a variable without elements (QNA and PNA without nests)
    if (M.vrows[k] * M.vcols[k] == 0) return
    x[|M.voff[k] + 1 \ M.voff[k] + M.vrows[k] * M.vcols[k]|] = colshape(value, 1)
}

// Labels of the elements of variable k, in storage order
void _cge_vlabels(struct cge_model scalar M, real scalar k, string colvector e1, string colvector e2)
{
    string scalar set, p1, p2
    string colvector s1, s2
    real scalar i, j
    set = M.vset[k]
    if (set == "") {
        e1 = ""
        e2 = ""
        return
    }
    if (_cge_nidx(set) == 1) {
        e1 = _cge_setlab(M, set)
        e2 = J(rows(e1), 1, "")
        return
    }
    _cge_setparts(set, p1, p2)
    s1 = _cge_setlab(M, p1)
    s2 = _cge_setlab(M, p2)
    e1 = J(rows(s1) * rows(s2), 1, "")
    e2 = e1
    for (i = 1; i <= rows(s1); i++) {
        for (j = 1; j <= rows(s2); j++) {
            e1[(i - 1) * rows(s2) + j] = s1[i]
            e2[(i - 1) * rows(s2) + j] = s2[j]
        }
    }
}

// =====================================================================
// SAM input and account mapping (model_spec.md, Section 7.0)
// =====================================================================

void _cge_sam(string scalar labelvar, string scalar accounts)
{
    string colvector labels, names
    real matrix S
    real scalar nmiss, k

    labels = st_sdata(., labelvar)
    names = tokens(accounts)'
    if (rows(names) == 0) _cge_fail("no numeric account variables found", 459)
    S = st_data(., accounts)
    if (rows(S) != cols(S)) {
        errprintf("SAM is not square: %f rows and %f account columns\n", rows(S), cols(S))
        exit(459)
    }
    // A label that is not a valid Stata name (for example s-i) cannot be a
    // variable name; when the data were read, the variable was renamed (si).
    // The variable names are then used as labels, and the change is reported.
    if (labels != names) {
        for (k = 1; k <= rows(labels); k++) {
            if (labels[k] == names[k]) continue
            if (st_isname(labels[k])) {
                _cge_fail("row " + strofreal(k) + " of " + labelvar + " is labelled " + labels[k] +
                          " but account variable " + strofreal(k) + " is " + names[k] +
                          "; row labels must match the account variable names, in the same order", 459)
            }
            printf("{txt}Account label {res}%s{txt} is not a valid Stata name; using {res}%s{txt}\n",
                   labels[k], names[k])
        }
        labels = names
        st_sstore(., labelvar, labels)
    }
    nmiss = missing(S)
    if (nmiss) S = editmissing(S, 0)
    _cge_sam_start(labels, S, nmiss, "SAM read")
}

// =====================================================================
// SAM tools (docs/sam_tools.md, from version 0.3.0)
// =====================================================================

// Starts a new model from a SAM: earlier mappings, calibrations and
// simulations are discarded
void _cge_sam_start(string colvector labels, real matrix S, real scalar nmiss, string scalar what)
{
    struct cge_model scalar M
    real scalar maxdiff
    maxdiff = max(abs(rowsum(S) - colsum(S)'))
    M.labels0 = labels
    M.S0 = S
    M.labels = labels
    M.S = S
    M.mapped = 0
    M.calibrated = 0
    _cge_store(M)
    printf("{txt}%s: {res}%f{txt} accounts, total {res}%g\n", what, rows(S), sum(S))
    if (nmiss) printf("{txt}Blank cells treated as zero: {res}%f\n", nmiss)
    printf("{txt}Largest row-column imbalance: {res}%9.3e\n", maxdiff)
    st_numscalar("r(N_accounts)", rows(S))
    st_numscalar("r(total)", sum(S))
    st_numscalar("r(maxdiff)", maxdiff)
    st_numscalar("r(N_blank)", nmiss)
}

// Position of each label, for fast lookups
transmorphic _cge_index(string colvector labels)
{
    transmorphic A
    real scalar k
    A = asarray_create()
    for (k = 1; k <= rows(labels); k++) asarray(A, labels[k], k)
    return(A)
}

real scalar _cge_pos(transmorphic A, string scalar label, string scalar what)
{
    if (!asarray_contains(A, label)) _cge_fail("account " + label + " (" + what + ") is not in the SAM", 111)
    return(asarray(A, label))
}

// A label as a Stata name (Section 1): characters other than letters,
// digits and the underscore removed, then any leading digits, and the result
// cut to 32 characters; "" if that is not a valid name
string scalar _cge_name(string scalar s)
{
    string scalar out, ch
    real scalar k
    if (st_isname(s)) return(s)
    out = ""
    for (k = 1; k <= strlen(s); k++) {
        ch = substr(s, k, 1)
        if ((ch >= "a" & ch <= "z") | (ch >= "A" & ch <= "Z") | (ch >= "0" & ch <= "9") | ch == "_") out = out + ch
    }
    while (strlen(out) > 0) {
        ch = substr(out, 1, 1)
        if (ch < "0" | ch > "9") break
        out = substr(out, 2, .)
    }
    out = substr(out, 1, 32)
    return(st_isname(out) ? out : "")
}

// Labels converted to names; each change is displayed, and a label that
// cannot be converted, or two labels that give the same name, are errors
string colvector _cge_names(string colvector raw)
{
    string colvector out
    transmorphic A
    real scalar k, nchanged
    out = raw
    A = asarray_create()
    nchanged = 0
    for (k = 1; k <= rows(raw); k++) {
        if (raw[k] == "") _cge_fail("account " + strofreal(k) + " has a blank label", 459)
        out[k] = _cge_name(raw[k])
        if (out[k] == "") _cge_fail("account label " + raw[k] + " cannot be converted to a Stata name; rename it", 459)
        if (out[k] != raw[k]) {
            nchanged++
            if (nchanged <= 20) {
                printf("{txt}Account label {res}%s{txt} is not a valid Stata name; using {res}%s{txt}\n", raw[k], out[k])
            }
        }
        if (asarray_contains(A, out[k])) {
            _cge_fail("account labels " + asarray(A, out[k]) + " and " + raw[k] + " both give the name " + out[k] +
                      "; rename one of them", 459)
        }
        asarray(A, out[k], raw[k])
    }
    if (nchanged > 20) printf("{txt}... and {res}%f{txt} more labels changed\n", nchanged - 20)
    return(out)
}

// The whole of a text file, without carriage returns
string scalar _cge_readfile(string scalar fn)
{
    real scalar fh
    string colvector chunks
    string scalar chunk
    if (!fileexists(fn)) _cge_fail("file " + fn + " not found", 601)
    fh = fopen(fn, "r")
    chunks = J(0, 1, "")
    while ((chunk = fread(fh, 4194304)) != J(0, 0, "")) chunks = chunks \ chunk
    fclose(fh)
    if (rows(chunks) == 0) return("")
    return(subinstr(invtokens(chunks', ""), char(13), ""))
}

// Fields of s separated by the character sep; quotes (for example `""""')
// protect separators within a field
string rowvector _cge_split(string scalar s, string scalar sep, string scalar quotes)
{
    transmorphic t
    string rowvector tok, out
    string scalar l2
    real rowvector issep, pos, keep
    // Comma-separated values without quotes or blanks: tokens() is much
    // faster than tokeninit(); empty fields become "."
    if (sep == "," & !strpos(s, `"""') & !strpos(s, " ") & !strpos(s, char(9))) {
        l2 = subinstr(subinstr("," + s + ",", ",,", ",.,"), ",,", ",.,")
        return(tokens(subinstr(substr(l2, 2, strlen(l2) - 2), ",", " ")))
    }
    t = tokeninit("", sep, quotes)
    tokenset(t, s)
    tok = tokengetall(t)
    if (cols(tok) == 0) return("")
    issep = (tok :== sep)
    pos = runningsum(issep) :+ 1
    out = J(1, sum(issep) + 1, "")
    keep = selectindex(!issep)
    if (cols(keep)) out[pos[keep]] = tok[keep]
    return(out)
}

// Fields without surrounding blanks and quotes
string rowvector _cge_unquote(string rowvector f)
{
    string rowvector out
    real rowvector q
    real scalar k, i
    out = strtrim(f)
    q = selectindex((substr(out, 1, 1) :== `"""') :& (substr(out, -1, 1) :== `"""') :& (strlen(out) :>= 2))
    for (k = 1; k <= cols(q); k++) {
        i = q[k]
        out[i] = strtrim(subinstr(substr(out[i], 2, strlen(out[i]) - 2), `""""', `"""'))
    }
    return(out)
}

// Number of account columns in the first line of a CSV file
real scalar _cge_csv_ncols(string scalar fn)
{
    real scalar fh, p
    string scalar s, chunk
    if (!fileexists(fn)) _cge_fail("file " + fn + " not found", 601)
    fh = fopen(fn, "r")
    s = ""
    while ((chunk = fread(fh, 65536)) != J(0, 0, "")) {
        s = s + chunk
        p = strpos(s, char(10))
        if (p) {
            s = substr(s, 1, p - 1)
            break
        }
    }
    fclose(fh)
    return(cols(_cge_split(subinstr(s, char(13), ""), ",", `""""')) - 1)
}

// Reads a wide CSV SAM directly (Section 1, form 2)
void _cge_sam_csv(string scalar fn)
{
    string colvector lines, rlab
    string rowvector head, f
    real matrix S
    real rowvector v, blank, bad
    real scalar n, k, nmiss

    lines = _cge_split(_cge_readfile(fn), char(10), "")'
    lines = select(lines, strtrim(lines) :!= "")
    if (rows(lines) < 2) _cge_fail(fn + " has no SAM rows", 459)
    head = _cge_unquote(_cge_split(lines[1], ",", `""""'))
    n = cols(head) - 1
    if (n < 1) _cge_fail(fn + " has no account columns", 459)
    if (rows(lines) - 1 != n) {
        errprintf("SAM is not square: %f rows and %f account columns\n", rows(lines) - 1, n)
        exit(459)
    }
    S = J(n, n, 0)
    rlab = J(n, 1, "")
    nmiss = 0
    for (k = 1; k <= n; k++) {
        f = _cge_unquote(_cge_split(lines[k + 1], ",", `""""'))
        if (cols(f) != n + 1) {
            _cge_fail("line " + strofreal(k + 1) + " of " + fn + " has " + strofreal(cols(f)) +
                      " fields; the first line has " + strofreal(n + 1), 459)
        }
        rlab[k] = f[1]
        f = f[|2 \ n + 1|]
        blank = (f :== "") :| (f :== ".")
        v = strtoreal(f)
        bad = selectindex(!blank :& (v :>= .))
        if (cols(bad)) {
            _cge_fail("row " + rlab[k] + ", column " + head[bad[1] + 1] + ": " + f[bad[1]] +
                      " is not a number", 459)
        }
        nmiss = nmiss + sum(blank)
        S[k, .] = editmissing(v, 0)
    }
    for (k = 1; k <= n; k++) {
        if (rlab[k] != head[k + 1]) {
            _cge_fail("row " + strofreal(k) + " is labelled " + rlab[k] + " but column " + strofreal(k) +
                      " is labelled " + head[k + 1] + "; row and column labels must agree, in the same order", 459)
        }
    }
    _cge_sam_start(_cge_names(rlab), S, nmiss, "SAM read")
}

// Reads a SAM from long data in memory (Section 1, form 3)
void _cge_sam_long(string scalar rvar, string scalar cvar, string scalar vvar)
{
    string colvector r, c, raw
    real colvector v, ri, ci, key, ord
    real matrix S
    transmorphic A
    real scalar i, n, nmiss, k
    string scalar x

    r = strtrim(st_sdata(., rvar))
    c = strtrim(st_sdata(., cvar))
    v = st_data(., vvar)
    if (rows(r) == 0) _cge_fail("no observations", 2000)
    A = asarray_create()
    raw = J(2 * rows(r), 1, "")
    ri = J(rows(r), 1, .)
    ci = J(rows(r), 1, .)
    // Accounts in the order of their first appearance as row accounts, then
    // any accounts that appear only as column accounts
    n = 0
    for (i = 1; i <= rows(r); i++) {
        if (r[i] == "" | c[i] == "") _cge_fail("observation " + strofreal(i) + " has a blank account label", 459)
        x = r[i]
        if (!asarray_contains(A, x)) {
            n++
            asarray(A, x, n)
            raw[n] = x
        }
        ri[i] = asarray(A, x)
    }
    for (i = 1; i <= rows(r); i++) {
        x = c[i]
        if (!asarray_contains(A, x)) {
            n++
            asarray(A, x, n)
            raw[n] = x
        }
        ci[i] = asarray(A, x)
    }
    raw = raw[|1 \ n|]
    key = (ri :- 1) :* n :+ ci
    ord = order(key, 1)
    for (k = 2; k <= rows(ord); k++) {
        if (key[ord[k]] == key[ord[k - 1]]) {
            _cge_fail("cell " + raw[ri[ord[k]]] + ", " + raw[ci[ord[k]]] + " is given twice", 459)
        }
    }
    nmiss = sum(v :>= .)
    v = editmissing(v, 0)
    S = J(n, n, 0)
    for (i = 1; i <= rows(v); i++) S[ri[i], ci[i]] = v[i]
    _cge_sam_start(_cge_names(raw), S, nmiss, "SAM read")
}

// Numbers as text that reads back as the same double (Section 2)
string rowvector _cge_numstr(real rowvector x)
{
    string rowvector s, sn
    real rowvector bad, nz
    real scalar k
    s = J(1, cols(x), "0")
    nz = selectindex(x :!= 0)
    if (cols(nz) == 0) return(s)
    sn = strtrim(strofreal(x[nz], "%21.0g"))
    bad = selectindex(strtoreal(sn) :!= x[nz])
    for (k = 1; k <= cols(bad); k++) sn[bad[k]] = strtrim(strofreal(x[nz[bad[k]]], "%24.17g"))
    s[nz] = sn
    return(s)
}

// The SAM as read, aggregated or balanced, or after the layout rewrites
void _cge_sam_pick(real scalar mapped, string colvector labels, real matrix S)
{
    struct cge_model scalar M
    M = _cge_load()
    _cge_need(M, "sam")
    if (mapped) {
        _cge_need(M, "mapped")
        labels = M.labels
        S = M.S
    }
    else {
        labels = M.labels0
        S = M.S0
    }
}

// Writes the SAM to a CSV file (Section 2)
void _cge_sam_write(string scalar fn, real scalar islong, real scalar mapped, real scalar replace)
{
    string colvector labels, lines
    real matrix S
    real rowvector nz
    real scalar fh, k, j, ncell

    _cge_sam_pick(mapped, labels, S)
    if (fileexists(fn)) {
        if (!replace) _cge_fail("file " + fn + " already exists; specify replace", 602)
        unlink(fn)
    }
    fh = fopen(fn, "w")
    ncell = 0
    if (islong) {
        fput(fh, "row,column,value")
        for (k = 1; k <= rows(S); k++) {
            nz = selectindex(S[k, .] :!= 0)
            if (cols(nz) == 0) continue
            lines = (labels[k] :+ "," :+ labels[nz]' :+ "," :+ _cge_numstr(S[k, nz]))'
            for (j = 1; j <= rows(lines); j++) fput(fh, lines[j])
            ncell = ncell + cols(nz)
        }
    }
    else {
        fput(fh, "account," + invtokens(labels', ","))
        for (k = 1; k <= rows(S); k++) fput(fh, labels[k] + "," + invtokens(_cge_numstr(S[k, .]), ","))
    }
    fclose(fh)
    if (islong) printf("{txt}SAM saved to {res}%s{txt}: {res}%f{txt} non-zero cells\n", fn, ncell)
    else printf("{txt}SAM saved to {res}%s{txt}: {res}%f{txt} accounts\n", fn, rows(S))
}

// Puts the SAM in the (empty) data in memory (Section 2)
void _cge_sam_todata(real scalar islong, real scalar mapped)
{
    string colvector labels, rl, cl
    real matrix S
    real colvector vl
    real rowvector nz
    real scalar k, n, w, m

    _cge_sam_pick(mapped, labels, S)
    n = rows(S)
    w = max((1, max(strlen(labels))))
    if (islong) {
        m = sum(S :!= 0)
        rl = J(m, 1, "")
        cl = J(m, 1, "")
        vl = J(m, 1, .)
        m = 0
        for (k = 1; k <= n; k++) {
            nz = selectindex(S[k, .] :!= 0)
            if (cols(nz) == 0) continue
            rl[|m + 1 \ m + cols(nz)|] = J(cols(nz), 1, labels[k])
            cl[|m + 1 \ m + cols(nz)|] = labels[nz]
            vl[|m + 1 \ m + cols(nz)|] = S[k, nz]'
            m = m + cols(nz)
        }
        st_addobs(m)
        (void) st_addvar("str" + strofreal(w), "row")
        (void) st_addvar("str" + strofreal(w), "column")
        (void) st_addvar("double", "value")
        if (m) {
            st_sstore(., "row", rl)
            st_sstore(., "column", cl)
            st_store(., "value", vl)
        }
        return
    }
    if (n + 1 > st_numscalar("c(maxvar)")) {
        _cge_fail("the SAM has " + strofreal(n) + " accounts, more than fit as variables (c(maxvar) is " +
                  strofreal(st_numscalar("c(maxvar)")) + "); save it as .csv or use the option long", 900)
    }
    st_addobs(n)
    (void) st_addvar("str" + strofreal(w), "account")
    st_sstore(., "account", labels)
    st_store(., st_addvar(J(1, n, "double"), labels'), S)
}

// ---------------------------------------------------------------------
// Mapping template (Section 3)
// ---------------------------------------------------------------------

string rowvector _cge_role_options()
{
    return(("activities", "commodities", "factors", "households", "enterprises", "government",
            "savinv", "row", "dirtax", "saltax", "imptax", "exptax", "acttax", "margins",
            "territorial", "marginaccounts", "stocks", "insurance", "vattax", "domesticmargins",
            "importmargins", "exportmargins", "factortax", "factorincometax"))
}

// A role entry in standard form: the cge_map options it names, in the order
// of _cge_role_options()
string scalar _cge_role_norm(string scalar cell, string scalar account)
{
    string rowvector opts, sing, tok
    real rowvector has
    real scalar k, m
    opts = _cge_role_options()
    sing = ("activity", "commodity", "factor", "household", "enterprise", "", "", "", "", "", "",
            "", "", "margin", "", "marginaccount", "stock", "", "vat", "domesticmargin", "importmargin",
            "exportmargin", "", "")
    tok = tokens(strlower(subinstr(cell, ",", " ")))
    has = J(1, cols(opts), 0)
    for (k = 1; k <= cols(tok); k++) {
        for (m = 1; m <= cols(opts); m++) if (tok[k] == opts[m] | tok[k] == sing[m]) break
        if (m > cols(opts)) {
            _cge_fail("role " + tok[k] + " of account " + account + " is not a cge_map option (see the " +
                      "template's roles sheet or help cge_template)", 198)
        }
        has[m] = 1
    }
    if (!max(has)) return("")
    return(invtokens(select(opts, has)))
}

void _cge_tmpl_add(string colvector role, real colvector idx, string scalar name)
{
    real scalar k
    for (k = 1; k <= rows(idx); k++) {
        if (idx[k] >= 1 & idx[k] <= rows(role)) role[idx[k]] = strtrim(role[idx[k]] + " " + name)
    }
}

// Puts the template of the SAM in memory in the (empty) data (Section 3);
// role and pair come from the mapping, if there is one
void _cge_template_data()
{
    struct cge_model scalar M
    string colvector role, pair, labels
    string rowvector taxname
    real colvector taxidx
    real scalar n0, k

    M = _cge_load()
    _cge_need(M, "sam")
    labels = M.labels0
    n0 = rows(labels)
    role = J(n0, 1, "")
    pair = J(n0, 1, "")
    if (M.mapped) {
        _cge_tmpl_add(role, M.iA, "activities")
        _cge_tmpl_add(role, M.iC, "commodities")
        _cge_tmpl_add(role, M.iF, "factors")
        _cge_tmpl_add(role, M.iH, "households")
        _cge_tmpl_add(role, M.iE, "enterprises")
        _cge_tmpl_add(role, M.igov, "government")
        _cge_tmpl_add(role, M.isav, "savinv")
        _cge_tmpl_add(role, M.irow, "row")
        // A tax paid directly to government was routed through an internal
        // account after the accounts of the SAM
        taxname = ("dirtax", "saltax", "imptax", "exptax", "acttax", "vattax")
        taxidx = (M.idirtax \ M.isaltax \ M.iimptax \ M.iexptax \ M.iacttax \
                  ((M.ivattax > 0 & M.ivattax < .) ? M.ivattax : 0))
        for (k = 1; k <= 6; k++) {
            // VAT moved out of the sales tax by vatshare() has no role in the template
            if (k == 6 & taxidx[k] > n0) {
                if (M.labels[taxidx[k]] == "_vatshare") continue
            }
            if (taxidx[k] > n0) _cge_tmpl_add(role, M.igov, taxname[k])
            else if (taxidx[k] > 0) _cge_tmpl_add(role, taxidx[k], taxname[k])
        }
        _cge_tmpl_add(role, M.imargins, "margins")
        _cge_tmpl_add(role, M.iterritorial, "territorial")
        if (rows(M.tmkt) != rows(M.iT)) M.tmkt = J(rows(M.iT), 1, 0)
        _cge_tmpl_add(role, select(M.iT, M.tmkt :== 0), "marginaccounts")
        _cge_tmpl_add(role, select(M.iT, M.tmkt :== 1), "domesticmargins")
        _cge_tmpl_add(role, select(M.iT, M.tmkt :== 2), "importmargins")
        _cge_tmpl_add(role, select(M.iT, M.tmkt :== 3), "exportmargins")
        _cge_tmpl_add(role, M.istocks, "stocks")
        if (M.ishi) _cge_tmpl_add(role, M.ishi, "insurance")
        for (k = 1; k <= rows(M.iA); k++) pair[M.iA[k]] = M.labels[M.iC[k]]
        // factor taxes (from version 0.5.0), with the factor taxed as the pair
        _cge_tmpl_add(role, M.iFT, "factortax")
        for (k = 1; k <= rows(M.iFT); k++) pair[M.iFT[k]] = M.F[M.ftf[k]]
        if (M.iFY > 0 & M.iFY < .) _cge_tmpl_add(role, M.iFY, "factorincometax")
    }
    st_addobs(n0)
    (void) st_addvar("str" + strofreal(max((1, max(strlen(labels))))), "account")
    (void) st_addvar("str" + strofreal(max((1, max(strlen(role))))), "role")
    (void) st_addvar("str" + strofreal(max((1, max(strlen(pair))))), "pair")
    (void) st_addvar("str1", "group")
    (void) st_addvar(("double", "double", "double"), ("row_total", "column_total", "difference"))
    st_sstore(., "account", labels)
    st_sstore(., "role", role)
    st_sstore(., "pair", pair)
    st_store(., ("row_total", "column_total", "difference"),
             (rowsum(M.S0), colsum(M.S0)', rowsum(M.S0) - colsum(M.S0)'))
    printf("{txt}Template of {res}%f{txt} accounts%s\n", n0, (M.mapped ? ", with roles from the current mapping" : ""))
}

// Stores the template in memory (account, role, pair, group) for cge_map
// and cge_aggregate; an empty variable name gives a blank column
void _cge_tmpl_store(string scalar accvar, string scalar rolevar, string scalar pairvar, string scalar groupvar)
{
    string matrix T
    pointer() scalar q
    T = strtrim(st_sdata(., accvar))
    T = T, (rolevar != "" ? strtrim(st_sdata(., rolevar)) : J(rows(T), 1, ""))
    T = T, (pairvar != "" ? strtrim(st_sdata(., pairvar)) : J(rows(T), 1, ""))
    T = T, (groupvar != "" ? strtrim(st_sdata(., groupvar)) : J(rows(T), 1, ""))
    T = select(T, T[., 1] :!= "")
    if (rows(T) == 0) _cge_fail("the template has no accounts", 459)
    if ((q = findexternal("cge__template")) == NULL) q = crexternal("cge__template")
    *q = T
}

string matrix _cge_tmpl_get()
{
    pointer() scalar q
    q = findexternal("cge__template")
    if (q == NULL) _cge_fail("no template has been read", 459)
    return(*q)
}

// Members of each account of the SAM in memory: the template rows of the
// account itself, if the SAM has the template's accounts, or of the
// accounts in its group, if the SAM has the template's groups
pointer(real colvector) colvector _cge_tmpl_members(string colvector L, string matrix T, real scalar grouped)
{
    pointer(real colvector) colvector mem
    transmorphic A, G
    string colvector eff
    real scalar k, ok
    A = asarray_create()
    for (k = 1; k <= rows(T); k++) {
        if (asarray_contains(A, T[k, 1])) _cge_fail("account " + T[k, 1] + " appears twice in the template", 459)
        asarray(A, T[k, 1], k)
    }
    eff = T[., 1]
    for (k = 1; k <= rows(T); k++) if (T[k, 4] != "") eff[k] = T[k, 4]
    G = asarray_create()
    for (k = 1; k <= rows(T); k++) {
        if (asarray_contains(G, eff[k])) asarray(G, eff[k], (asarray(G, eff[k]) \ k))
        else asarray(G, eff[k], k)
    }
    // The SAM has the template's accounts, or its groups
    grouped = 0
    ok = (rows(L) == rows(T))
    for (k = 1; ok & k <= rows(L); k++) ok = asarray_contains(A, L[k])
    if (!ok) {
        grouped = 1
        ok = (rows(L) == asarray_elements(G))
        for (k = 1; ok & k <= rows(L); k++) ok = asarray_contains(G, L[k])
        if (!ok) _cge_fail("the accounts of the SAM in memory are neither the template's accounts nor its groups", 459)
    }
    mem = J(rows(L), 1, NULL)
    for (k = 1; k <= rows(L); k++) {
        if (grouped) mem[k] = &(asarray(G, L[k]))
        else mem[k] = &(asarray(A, L[k]))
    }
    return(mem)
}

// Maps the SAM from the template in memory (Section 3)
void _cge_map_template(string scalar reportfile, real scalar replace, | string scalar vatshare)
{
    struct cge_model scalar M
    string matrix T
    string colvector L, role, pairc, eff, lists
    string rowvector opts, single, tt, hl
    string scalar r1, p, cmd
    real colvector hh
    pointer(real colvector) colvector mem
    real colvector m, acts, coms, pairs, used, cands
    real rowvector vals
    transmorphic AL, AT
    real scalar n, k, j, grouped, a, mx, o

    M = _cge_load()
    T = _cge_tmpl_get()
    L = M.labels0
    n = rows(L)
    mem = _cge_tmpl_members(L, T, grouped)
    AL = _cge_index(L)
    AT = _cge_index(T[., 1])
    eff = T[., 1]
    for (k = 1; k <= rows(T); k++) if (T[k, 4] != "") eff[k] = T[k, 4]

    // Roles, which must agree within a group, and pairs
    role = J(n, 1, "")
    pairc = J(n, 1, "")
    for (k = 1; k <= n; k++) {
        m = *mem[k]
        role[k] = _cge_role_norm(T[m[1], 2], T[m[1], 1])
        for (j = 2; j <= rows(m); j++) {
            r1 = _cge_role_norm(T[m[j], 2], T[m[j], 1])
            if (r1 != role[k]) {
                _cge_fail("accounts " + T[m[1], 1] + " and " + T[m[j], 1] + " of group " + L[k] +
                          " have different roles", 459)
            }
        }
        for (j = 1; j <= rows(m); j++) {
            p = T[m[j], 3]
            if (p == "") continue
            // The pair as an account of the SAM in memory: itself, or its group
            if (!asarray_contains(AL, p)) {
                if (grouped & asarray_contains(AT, p)) p = eff[asarray(AT, p)]
                if (!asarray_contains(AL, p)) _cge_fail("pair " + T[m[j], 3] + " of account " + T[m[j], 1] + " is not in the SAM", 111)
            }
            if (pairc[k] != "" & pairc[k] != p) {
                _cge_fail("the members of group " + L[k] + " are paired with different commodities (" +
                          pairc[k] + ", " + p + ")", 459)
            }
            pairc[k] = p
        }
    }

    // Accounts of each option, in the order of the SAM
    opts = _cge_role_options()
    lists = J(cols(opts), 1, "")
    for (o = 1; o <= cols(opts); o++) {
        for (k = 1; k <= n; k++) {
            if (anyof(tokens(role[k]), opts[o])) lists[o] = strtrim(lists[o] + " " + L[k])
        }
    }
    single = ("government", "savinv", "row", "dirtax", "saltax", "imptax", "exptax", "acttax", "insurance",
              "vattax", "factorincometax")
    for (o = 1; o <= cols(opts); o++) {
        if (!anyof(single, opts[o])) continue
        if (cols(tokens(lists[o])) > 1) _cge_fail("role " + opts[o] + " is given to more than one account: " + lists[o], 198)
        if (o <= 8 & o >= 6 & lists[o] == "") _cge_fail("no account has the role " + opts[o], 198)
    }
    for (o = 1; o <= 4; o++) if (lists[o] == "") _cge_fail("no account has the role " + opts[o], 198)
    // territorial(): the correction commodity, which households consume, first
    tt = tokens(lists[15])
    if (cols(tt) == 2) {
        hh = J(0, 1, .)
        hl = tokens(lists[4])
        for (k = 1; k <= cols(hl); k++) hh = hh \ asarray(AL, hl[k])
        if (sum(abs(M.S0[asarray(AL, tt[1]), hh'])) == 0 & sum(abs(M.S0[asarray(AL, tt[2]), hh'])) != 0) {
            lists[15] = tt[2] + " " + tt[1]
        }
    }

    // Pairs: the pair column, or the commodity whose column pays the activity most
    acts = J(0, 1, .)
    coms = J(0, 1, .)
    for (k = 1; k <= n; k++) {
        if (anyof(tokens(role[k]), "activities")) acts = acts \ k
        if (anyof(tokens(role[k]), "commodities")) coms = coms \ k
    }
    if (rows(coms) < rows(acts)) _cge_fail("there are fewer commodities than activities; each activity needs a paired commodity", 198)
    pairs = J(rows(acts), 1, 0)
    for (j = 1; j <= rows(acts); j++) {
        a = acts[j]
        if (pairc[a] != "") {
            pairs[j] = asarray(AL, pairc[a])
            if (!anyof(coms, pairs[j])) _cge_fail("activity " + L[a] + " is paired with " + pairc[a] + ", which is not a commodity", 198)
        }
        else {
            vals = M.S0[a, coms']
            mx = max(vals)
            if (mx <= 0) _cge_fail("activity " + L[a] + " sells to no commodity; give its pair in the template", 459)
            cands = selectindex(vals' :== mx)
            if (rows(cands) > 1) _cge_fail("activity " + L[a] + " sells equal amounts to several commodities; give its pair in the template", 459)
            pairs[j] = coms[cands[1]]
        }
    }
    for (j = 1; j <= rows(acts); j++) {
        for (k = j + 1; k <= rows(acts); k++) {
            if (pairs[j] == pairs[k]) _cge_fail("commodity " + L[pairs[j]] + " is paired with both " + L[acts[j]] + " and " + L[acts[k]], 459)
        }
    }
    used = J(n, 1, 0)
    used[pairs] = J(rows(pairs), 1, 1)
    lists[2] = invtokens(L[pairs]')
    for (k = 1; k <= rows(coms); k++) if (!used[coms[k]]) lists[2] = lists[2] + " " + L[coms[k]]

    // Taxes on factor use: the pair column names the factor taxed (from version 0.5.0)
    if (lists[23] != "") {
        tt = tokens(lists[23])
        lists[23] = ""
        for (k = 1; k <= cols(tt); k++) {
            p = pairc[asarray(AL, tt[k])]
            if (p == "") _cge_fail("factor tax " + tt[k] + ": give the factor it taxes in the pair column", 198)
            lists[23] = strtrim(lists[23] + " " + tt[k] + ":" + p)
        }
    }

    // The equivalent command
    cmd = "cge_map,"
    for (o = 1; o <= cols(opts); o++) if (lists[o] != "") cmd = cmd + " " + opts[o] + "(" + lists[o] + ")"
    if (vatshare != "") cmd = cmd + " vatshare(" + vatshare + ")"
    if (strlen(cmd) <= 2000) printf("{txt}Mapping from the template:\n{res}%s\n", cmd)
    else printf("{txt}Mapping from the template ({res}%f{txt} accounts)\n", n)
    _cge_map(lists[1], lists[2], lists[3], lists[4], lists[5], lists[6], lists[7], lists[8], lists[9],
             lists[10], lists[11], lists[12], lists[13], lists[14], lists[15], lists[16], lists[17],
             lists[18], reportfile, replace, lists[19], vatshare, lists[20], lists[21], lists[22],
             lists[23], lists[24])
    st_global("r(command)", cmd)
}

// ---------------------------------------------------------------------
// Aggregation (Section 4)
// ---------------------------------------------------------------------

// group[k] is the group of account k of the SAM in memory ("" keeps it)
void _cge_aggregate(string colvector group, real scalar netdiag)
{
    struct cge_model scalar M
    string colvector L, g, newl
    real colvector gi, size
    real matrix S, R, X
    transmorphic A
    real scalar n, m, k, ndiag, sdiag

    M = _cge_load()
    L = M.labels0
    S = M.S0
    n = rows(L)
    g = group
    for (k = 1; k <= n; k++) if (g[k] == "") g[k] = L[k]
    A = asarray_create()
    newl = J(n, 1, "")
    gi = J(n, 1, 0)
    m = 0
    for (k = 1; k <= n; k++) {
        if (!asarray_contains(A, g[k])) {
            if (!st_isname(g[k])) _cge_fail("group " + g[k] + " is not a valid Stata name", 198)
            m++
            asarray(A, g[k], m)
            newl[m] = g[k]
        }
        gi[k] = asarray(A, g[k])
    }
    newl = newl[|1 \ m|]
    // X = G S G', summing rows then columns in the order of the accounts
    R = J(m, n, 0)
    for (k = 1; k <= n; k++) R[gi[k], .] = R[gi[k], .] + S[k, .]
    X = J(m, m, 0)
    for (k = 1; k <= n; k++) X[., gi[k]] = X[., gi[k]] + R[., k]
    ndiag = sum(diagonal(X) :!= 0)
    sdiag = sum(diagonal(X))
    if (netdiag) _diag(X, J(m, 1, 0))
    size = J(m, 1, 0)
    for (k = 1; k <= n; k++) size[gi[k]] = size[gi[k]] + 1
    printf("{txt}Accounts merged: {res}%f{txt} accounts into {res}%f{txt} group%s; {res}%f{txt} accounts left as they are\n",
           sum((size :> 1) :* size), sum(size :> 1), (sum(size :> 1) == 1 ? "" : "s"), sum(size :== 1))
    if (ndiag) {
        printf("{txt}Diagonal cells (flows within an account): {res}%f{txt}, total {res}%g{txt}%s\n", ndiag, sdiag,
               (netdiag ? ", removed" : ", kept"))
    }
    _cge_sam_start(newl, X, 0, "Aggregated SAM")
    st_numscalar("r(N_diagonal)", ndiag)
    st_numscalar("r(diagonal)", sdiag)
}

// groups(new: old old ..., new: old ...)
void _cge_aggregate_spec(string scalar spec, real scalar netdiag)
{
    struct cge_model scalar M
    string colvector L, group
    string rowvector parts, mem
    string scalar name
    transmorphic AL
    real scalar k, j, p, i

    M = _cge_load()
    _cge_need(M, "sam")
    L = M.labels0
    AL = _cge_index(L)
    group = J(rows(L), 1, "")
    parts = _cge_split(spec, ",", "")
    for (k = 1; k <= cols(parts); k++) {
        p = strpos(parts[k], ":")
        if (strtrim(parts[k]) == "") continue
        if (!p) _cge_fail("groups(): " + strtrim(parts[k]) + " needs the form new: old old ...", 198)
        name = strtrim(substr(parts[k], 1, p - 1))
        mem = tokens(substr(parts[k], p + 1, .))
        if (name == "" | cols(mem) == 0) _cge_fail("groups(): " + strtrim(parts[k]) + " needs the form new: old old ...", 198)
        for (j = 1; j <= cols(mem); j++) {
            i = _cge_pos(AL, mem[j], "groups()")
            if (group[i] != "") _cge_fail("groups(): account " + mem[j] + " is in two groups", 198)
            group[i] = name
        }
    }
    // A group may take the label of one of its members, but not of another account
    for (k = 1; k <= rows(L); k++) {
        if (group[k] != "" & group[k] != L[k] & asarray_contains(AL, group[k])) {
            i = asarray(AL, group[k])
            if (group[i] != group[k]) _cge_fail("groups(): group " + group[k] + " has the label of an account that is not one of its members", 198)
        }
    }
    _cge_aggregate(group, netdiag)
}

// The template's group column; members of a group must have the same role
void _cge_aggregate_template(real scalar netdiag)
{
    struct cge_model scalar M
    string matrix T
    string colvector L, group
    pointer(real colvector) colvector mem
    transmorphic AT, G
    real colvector m
    real scalar k, j, grouped
    string scalar g, r1, r2

    M = _cge_load()
    T = _cge_tmpl_get()
    L = M.labels0
    mem = _cge_tmpl_members(L, T, grouped)
    if (grouped) _cge_fail("the SAM in memory has already been aggregated with this template", 459)
    AT = _cge_index(T[., 1])
    group = J(rows(L), 1, "")
    for (k = 1; k <= rows(L); k++) group[k] = T[asarray(AT, L[k]), 4]
    // A group may take the label of one of its members, but not of another
    // account, as with groups() (from version 0.6.4)
    for (k = 1; k <= rows(L); k++) {
        if (group[k] != "" & group[k] != L[k]) {
            j = _cge_find(L, group[k])
            if (j) {
                if (group[j] != group[k]) {
                    _cge_fail("template: group " + group[k] + " has the label of an account that is not one of its members", 198)
                }
            }
        }
    }
    // Roles within each group
    G = asarray_create()
    for (k = 1; k <= rows(L); k++) {
        g = (group[k] == "" ? L[k] : group[k])
        if (asarray_contains(G, g)) {
            j = asarray(G, g)
            r1 = _cge_role_norm(T[asarray(AT, L[j]), 2], L[j])
            r2 = _cge_role_norm(T[asarray(AT, L[k]), 2], L[k])
            if (r1 != r2) _cge_fail("accounts " + L[j] + " and " + L[k] + " of group " + g + " have different roles", 459)
        }
        else asarray(G, g, k)
    }
    _cge_aggregate(group, netdiag)
}

// ---------------------------------------------------------------------
// Balancing (Section 5)
// ---------------------------------------------------------------------

// Cells kept at their values: row:col, row:*, *:col or an account
real matrix _cge_fixedmask(string colvector L, string scalar spec)
{
    real matrix mask
    string rowvector tok
    string scalar r, c
    transmorphic AL
    real scalar n, k, p, i, j

    n = rows(L)
    AL = _cge_index(L)
    mask = J(n, n, 0)
    tok = tokens(spec)
    for (k = 1; k <= cols(tok); k++) {
        p = strpos(tok[k], ":")
        if (!p) {
            i = _cge_pos(AL, tok[k], "fixed()")
            mask[i, .] = J(1, n, 1)
            mask[., i] = J(n, 1, 1)
            continue
        }
        r = substr(tok[k], 1, p - 1)
        c = substr(tok[k], p + 1, .)
        if (r == "*" & c == "*") _cge_fail("fixed(): *:* would fix every cell", 198)
        if (r == "*") mask[., _cge_pos(AL, c, "fixed()")] = J(n, 1, 1)
        else if (c == "*") mask[_cge_pos(AL, r, "fixed()"), .] = J(1, n, 1)
        else {
            i = _cge_pos(AL, r, "fixed()")
            j = _cge_pos(AL, c, "fixed()")
            mask[i, j] = 1
        }
    }
    return(mask)
}

// totals(account:value ...)
void _cge_totals(string colvector L, string scalar spec, real colvector K, real colvector t)
{
    string rowvector tok
    transmorphic AL
    real scalar k, p, i
    AL = _cge_index(L)
    tok = tokens(spec)
    K = J(0, 1, .)
    t = J(0, 1, .)
    for (k = 1; k <= cols(tok); k++) {
        p = strpos(tok[k], ":")
        if (!p) _cge_fail("totals(): " + tok[k] + " needs the form account:value", 198)
        i = _cge_pos(AL, substr(tok[k], 1, p - 1), "totals()")
        if (anyof(K, i)) _cge_fail("totals(): " + L[i] + " is given twice", 198)
        K = K \ i
        t = t \ strtoreal(substr(tok[k], p + 1, .))
        if (t[rows(t)] >= .) _cge_fail("totals(): " + tok[k] + " has no valid value", 198)
    }
}

// Positive root x of p x^2 - u x - n = 0, in the stable form for each sign of u
real colvector _cge_ras_factor(real colvector u, real colvector p, real colvector nn, real colvector active,
                               string scalar what, string colvector L)
{
    real colvector x, d, i1, i2, bad
    x = J(rows(u), 1, 1)
    d = sqrt(u:^2 :+ 4 :* p :* nn)
    i1 = selectindex(active :& (u :>= 0))
    i2 = selectindex(active :& (u :< 0))
    if (rows(i1)) x[i1] = (u[i1] :+ d[i1]) :/ (2 :* p[i1])
    if (rows(i2)) x[i2] = 2 :* nn[i2] :/ (d[i2] :- u[i2])
    bad = selectindex(active :& ((x :>= .) :| (x :<= 0)))
    if (rows(bad)) _cge_fail("the " + what + " target of " + L[bad[1]] + " cannot be met with the signs of its cells", 459)
    return(x)
}

// Generalised RAS (Section 5.1)
real matrix _cge_ras(string colvector L, real matrix S0, real matrix fixed, string scalar rule,
                     real colvector K, real colvector tK, real scalar tol, real scalar maxit,
                     real scalar it, real colvector t)
{
    real matrix free, P, N, F, Pt, Nt
    real colvector given, rowfree, colfree, frow, fcol, u, v, r, s, rt, ct, hist, implied
    real scalar n, scale, k, err

    n = rows(L)
    scale = max((1, max(abs(S0))))
    free = (S0 :!= 0) :& !fixed
    P = S0 :* (free :& (S0 :> 0))
    N = -S0 :* (free :& (S0 :< 0))
    F = S0 :* !free
    if (rule == "average") t = 0.5 :* (rowsum(S0) + colsum(S0)')
    else if (rule == "rows") t = rowsum(S0)
    else t = colsum(S0)'
    given = J(n, 1, 0)
    if (rows(K)) {
        t[K] = tK
        given[K] = J(rows(K), 1, 1)
    }
    rowfree = (rowsum(free) :> 0)
    colfree = (colsum(free)' :> 0)
    frow = rowsum(F)
    fcol = colsum(F)'
    // An account whose row (or column) cannot change has that total as its target
    for (k = 1; k <= n; k++) {
        implied = J(0, 1, .)
        if (!rowfree[k]) implied = implied \ frow[k]
        if (!colfree[k]) implied = implied \ fcol[k]
        if (rows(implied) == 0) continue
        if (rows(implied) == 2) {
            if (abs(implied[1] - implied[2]) > tol * scale) {
                _cge_fail(L[k] + ": its row and column cannot change and their totals differ", 459)
            }
        }
        if (given[k] & abs(t[k] - implied[1]) > tol * scale) {
            _cge_fail(L[k] + ": the given total differs from the total of cells that cannot change", 459)
        }
        t[k] = implied[1]
    }
    u = t - frow
    v = t - fcol
    Pt = P'
    Nt = N'
    r = J(n, 1, 1)
    s = J(n, 1, 1)
    hist = J(maxit, 1, .)
    for (it = 1; it <= maxit; it++) {
        r = _cge_ras_factor(u, P * s, N * (1 :/ s), rowfree, "row", L)
        s = _cge_ras_factor(v, Pt * r, Nt * (1 :/ r), colfree, "column", L)
        // Row and column totals without forming the matrix
        rt = r :* (P * s) - (N * (1 :/ s)) :/ r + frow
        ct = s :* (Pt * r) - (Nt * (1 :/ r)) :/ s + fcol
        err = max((max(abs(rt - t)), max(abs(ct - t))))
        if (err <= tol * scale) break
        // A gap that no longer falls: the targets cannot be met
        hist[it] = err
        if (it > 100) {
            if (err >= (1 - 1e-6) * hist[it - 100]) {
                _cge_fail(sprintf("RAS stopped after %f iterations with a gap of %g that no longer falls: the " +
                                  "targets cannot be met with the zeros and fixed cells of the SAM", it, err), 430)
            }
        }
    }
    if (it > maxit) _cge_fail(sprintf("RAS did not converge in %f iterations", maxit), 430)
    return((r :* P :* s') - N :/ (r * s') + F)
}

// Accounts connected by off-diagonal cells that may change: a set number
// for each account, numbered from the account with the lowest position
real colvector _cge_components(real matrix free)
{
    real matrix link
    real colvector comp, stack, nb
    real scalar n, start, k, nc
    n = rows(free)
    link = (free :| free')
    _diag(link, J(n, 1, 0))
    comp = J(n, 1, 0)
    nc = 0
    for (start = 1; start <= n; start++) {
        if (comp[start]) continue
        nc++
        comp[start] = nc
        stack = start
        while (rows(stack)) {
            k = stack[rows(stack)]
            stack = (rows(stack) > 1 ? stack[|1 \ rows(stack) - 1|] : J(0, 1, .))
            nb = selectindex(link[., k] :& (comp :== 0))
            if (rows(nb)) {
                comp[nb] = J(rows(nb), 1, nc)
                stack = stack \ nb
            }
        }
    }
    return(comp)
}

// Cells of the cross-entropy solution for multipliers theta (Section 5.2)
void _cge_ce_cells(real colvector theta, real colvector imu, real colvector iK, real matrix P, real matrix N,
                   real matrix Xp, real matrix Xn, real colvector mu, real colvector rho)
{
    real matrix A
    real scalar n, nmu
    n = rows(P)
    nmu = rows(imu)
    mu = J(n, 1, 0)
    if (nmu) mu[imu] = theta[|1 \ nmu|]
    rho = J(n, 1, 0)
    if (rows(iK)) rho[iK] = theta[|nmu + 1 \ rows(theta)|]
    // a_ij = mu_i - mu_j + rho_i (a column and a row vector are not c-conformable)
    A = (mu + rho) * J(1, n, 1) - J(n, 1, 1) * mu'
    Xp = P :* exp(A :* (P :> 0))
    Xn = N :* exp(-A :* (N :> 0))
}

real scalar _cge_ce_phi(real colvector theta, real colvector imu, real colvector iK, real matrix P, real matrix N,
                        real colvector c, real colvector frow, real colvector t)
{
    real matrix Xp, Xn
    real colvector mu, rho
    _cge_ce_cells(theta, imu, iK, P, N, Xp, Xn, mu, rho)
    // sum() ignores missing values, so an overflow is checked first
    if (hasmissing(Xp) | hasmissing(Xn)) return(.)
    return(sum(Xp) + sum(Xn) + mu' * c + (rows(iK) ? rho[iK]' * (frow[iK] - t[iK]) : 0))
}

// Cross entropy (Section 5.2)
real matrix _cge_ce(string colvector L, real matrix S0, real matrix fixed, real colvector K, real colvector tK,
                    real scalar tol, real scalar maxit, real scalar it)
{
    real matrix free, P, N, F, Xp, Xn, X, W, Hmm, Hrm, H
    real colvector c, frow, fcol, rowfree, colfree, known, t, rhofree, comp, mufree, iK, imu, members
    real colvector theta, mu, rho, g, h, grad, step, rs, cs, trial, rx
    real scalar n, scale, k, kk, implied, nmu, nK, err, f0, f1, slope, alpha, ls

    n = rows(L)
    scale = max((1, max(abs(S0))))
    free = (S0 :!= 0) :& !fixed
    P = S0 :* (free :& (S0 :> 0))
    N = -S0 :* (free :& (S0 :< 0))
    F = S0 :* !free
    frow = rowsum(F)
    fcol = colsum(F)'
    c = frow - fcol
    rowfree = (rowsum(free) :> 0)
    colfree = (colsum(free)' :> 0)
    known = J(n, 1, 0)
    t = J(n, 1, 0)
    if (rows(K)) {
        known[K] = J(rows(K), 1, 1)
        t[K] = tK
    }
    // A known total whose row or column cannot change is implied by the fixed
    // cells; it must agree with them and needs no multiplier
    rhofree = known
    for (kk = 1; kk <= rows(K); kk++) {
        k = K[kk]
        implied = (rowfree[k] ? . : frow[k])
        if (!colfree[k]) implied = fcol[k]
        if (implied < .) {
            if (abs(t[k] - implied) > tol * scale) {
                _cge_fail(L[k] + ": the given total differs from the total of cells that cannot change", 459)
            }
            rhofree[k] = 0
        }
    }
    // One balance multiplier in each connected set of accounts is fixed at
    // zero; the fixed cells of each set must balance among themselves
    comp = _cge_components(free)
    mufree = J(n, 1, 1)
    for (k = 1; k <= max(comp); k++) {
        members = selectindex(comp :== k)
        if (abs(sum(c[members])) > tol * scale) {
            _cge_fail("the cells that cannot change do not balance for accounts " +
                      invtokens(L[members]'), 459)
        }
        mufree[members[1]] = 0
    }
    iK = selectindex(rhofree)
    imu = selectindex(mufree)
    nmu = rows(imu)
    nK = rows(iK)

    theta = J(nmu + nK, 1, 0)
    _cge_ce_cells(theta, imu, iK, P, N, Xp, Xn, mu, rho)
    for (it = 0; it <= maxit; it++) {
        X = Xp - Xn + F
        rx = rowsum(X)
        g = rx - colsum(X)'
        h = (nK ? rx[iK] - t[iK] : J(0, 1, .))
        err = max(abs(g))
        if (nK) err = max((err, max(abs(h))))
        if (err <= tol * scale) break
        if (it == maxit) _cge_fail(sprintf("cross entropy did not converge in %f iterations", maxit), 430)
        W = Xp + Xn
        rs = rowsum(W)
        cs = colsum(W)'
        Hmm = diag(rs + cs) - W - W'
        if (nK) {
            Hrm = -W[iK, .]
            for (kk = 1; kk <= nK; kk++) Hrm[kk, iK[kk]] = Hrm[kk, iK[kk]] + rs[iK[kk]]
            H = (Hmm[imu, imu], Hrm[., imu]' \ Hrm[., imu], diag(rs[iK]))
            grad = g[imu] \ h
        }
        else {
            H = Hmm[imu, imu]
            grad = g[imu]
        }
        step = -cholsolve(H, grad)
        if (hasmissing(step)) step = -lusolve(H, grad)
        if (hasmissing(step)) _cge_fail("cross entropy: the Newton system is singular; the pattern of cells may not allow a unique balanced SAM", 430)
        f0 = _cge_ce_phi(theta, imu, iK, P, N, c, frow, t)
        slope = grad' * step
        // Close to the solution the predicted decrease is below the rounding
        // of the dual, and the full Newton step is taken
        if (-slope <= 1e-12 * max((1, abs(f0)))) trial = theta + step
        else {
            alpha = 1
            for (ls = 1; ls <= 60; ls++) {
                trial = theta + alpha :* step
                f1 = _cge_ce_phi(trial, imu, iK, P, N, c, frow, t)
                if (f1 < . & f1 <= f0 + 1e-4 * alpha * slope) break
                alpha = alpha / 2
            }
            if (ls > 60) _cge_fail("cross entropy: the line search failed; no balanced SAM with this pattern may exist", 430)
        }
        theta = trial
        _cge_ce_cells(theta, imu, iK, P, N, Xp, Xn, mu, rho)
    }
    return(X)
}

void _cge_balance(string scalar method, string scalar rule, string scalar totals, string scalar fixspec,
                  real scalar tol, real scalar maxit, real scalar show)
{
    struct cge_model scalar M
    string colvector L
    real matrix S0, X, fixed
    real colvector K, tK, t, d, top, i, j
    real scalar it, n, before, after, total0, nchanged, maxrel, k, nshow, scale

    M = _cge_load()
    _cge_need(M, "sam")
    L = M.labels0
    S0 = M.S0
    n = rows(L)
    fixed = _cge_fixedmask(L, fixspec)
    _cge_totals(L, totals, K, tK)
    before = max(abs(rowsum(S0) - colsum(S0)'))
    total0 = sum(S0)
    if (method == "ras") X = _cge_ras(L, S0, fixed, rule, K, tK, tol, maxit, it, t)
    else X = _cge_ce(L, S0, fixed, K, tK, tol, maxit, it)
    after = max(abs(rowsum(X) - colsum(X)'))
    nchanged = sum(X :!= S0)
    d = vec(abs(X - S0))
    scale = max((1, max(abs(S0))))
    maxrel = max(vec(abs(X - S0) :/ (abs(S0) + (S0 :== 0))))
    printf("{txt}%s: converged in {res}%f{txt} iterations\n", (method == "ras" ? "RAS" : "Cross entropy"), it)
    printf("{txt}Largest row-column imbalance: {res}%9.3e{txt} before, {res}%9.3e{txt} after\n", before, after)
    printf("{txt}SAM total: {res}%g{txt} before, {res}%g{txt} after\n", total0, sum(X))
    printf("{txt}Cells changed: {res}%f{txt} of {res}%f{txt} non-zero; largest relative change {res}%9.3e\n",
           nchanged, sum(S0 :!= 0), maxrel)
    if (show & nchanged) {
        nshow = min((10, nchanged))
        top = order(d, -1)
        top = top[|1 \ nshow|]
        j = ceil(top :/ n)
        i = top - (j :- 1) :* n
        printf("\n{txt}Largest changes\n")
        printf("{txt}{space 2}%-20s %-20s %14s %14s %10s\n", "row", "column", "before", "after", "change %")
        for (k = 1; k <= nshow; k++) {
            printf("{txt}{space 2}%-20s %-20s {res}%14.6g %14.6g %10.3f\n", abbrev(L[i[k]], 20), abbrev(L[j[k]], 20),
                   S0[i[k], j[k]], X[i[k], j[k]], 100 * (X[i[k], j[k]] / S0[i[k], j[k]] - 1))
        }
        printf("\n")
    }
    _cge_sam_start(L, X, 0, "Balanced SAM")
    st_numscalar("r(iterations)", it)
    st_numscalar("r(maxdiff_before)", before)
    st_numscalar("r(total_before)", total0)
    st_numscalar("r(N_changed)", nchanged)
    st_numscalar("r(maxrelchange)", maxrel)
    st_global("r(method)", method)
}

real colvector _cge_lookup(struct cge_model scalar M, string scalar list, string scalar what)
{
    string rowvector tok
    real colvector idx
    real scalar k
    tok = tokens(list)
    idx = J(cols(tok), 1, 0)
    for (k = 1; k <= cols(tok); k++) {
        idx[k] = _cge_find(M.labels, tok[k])
        if (idx[k] == 0) _cge_fail("account " + tok[k] + " (" + what + ") is not in the SAM", 111)
    }
    return(idx)
}

void _cge_map(string scalar acts, string scalar coms, string scalar facs, string scalar hhs,
              string scalar ents,
              string scalar gov, string scalar sav, string scalar row, string scalar dirtax,
              string scalar saltax, string scalar imptax, string scalar exptax, string scalar acttax,
              string scalar margins, string scalar territorial, string scalar margacc,
              string scalar stocks, string scalar insurance, string scalar reportfile,
              real scalar replace, | string scalar vattax, string scalar vatshare, string scalar domm,
              string scalar impm, string scalar expm, string scalar ftaxspec, string scalar fytax)
{
    struct cge_model scalar M
    real colvector role, iA, iC, imarg, iterr, istk, ishi, mapped, restc
    real rowvector hcons, rest, share
    real scalar ct, at, timp, texp, negsales, negtotal
    real matrix allowed, negok, transfers, S, issues
    string rowvector rolename, taxname
    real scalar i, j, k, tol, nacc, rr, rc, x
    string colvector taxacc, labels
    real colvector taxidx, direct, payers, taxrole, rwidx, vshare

    M = _cge_load()
    _cge_need(M, "sam")
    M.labels = M.labels0
    M.S = M.S0
    S = M.S
    nacc = rows(M.labels)
    rolename = ("activity", "commodity", "factor", "household", "government",
                "savings-investment", "rest of world", "direct tax", "sales tax",
                "import tax", "export tax", "activity tax", "enterprise", "margin account",
                "insurance fund", "VAT account", "unmapped", "factor tax", "factor income tax")
    if (args() < 25) ftaxspec = ""
    if (args() < 26) fytax = ""
    // Role codes of the tax accounts, and the entries of M.rewritten for taxes
    // paid directly to the government (VAT from version 0.3.1)
    taxrole = (8 \ 9 \ 10 \ 11 \ 12 \ 16)
    rwidx = (2 \ 3 \ 4 \ 5 \ 6 \ 11)

    M.iA = _cge_lookup(M, acts, "activity")
    M.iC = _cge_lookup(M, coms, "commodity")
    M.iF = _cge_lookup(M, facs, "factor")
    M.iH = _cge_lookup(M, hhs, "household")
    M.iE = _cge_lookup(M, ents, "enterprise")
    // Margin accounts: per unit of composite supply, then (from version 0.3.2)
    // per unit of domestic sales, imports and exports, with their market in tmkt
    M.iT = _cge_lookup(M, margacc, "margin account")
    M.tmkt = J(rows(M.iT), 1, 0)
    k = rows(M.iT)
    M.iT = M.iT \ _cge_lookup(M, domm, "domestic margin account")
    M.tmkt = M.tmkt \ J(rows(M.iT) - k, 1, 1)
    k = rows(M.iT)
    M.iT = M.iT \ _cge_lookup(M, impm, "import margin account")
    M.tmkt = M.tmkt \ J(rows(M.iT) - k, 1, 2)
    k = rows(M.iT)
    M.iT = M.iT \ _cge_lookup(M, expm, "export margin account")
    M.tmkt = M.tmkt \ J(rows(M.iT) - k, 1, 3)
    M.igov = _cge_lookup(M, gov, "government")
    M.isav = _cge_lookup(M, sav, "savings-investment")
    M.irow = _cge_lookup(M, row, "rest of world")
    ishi = _cge_lookup(M, insurance, "health insurance fund")
    if (rows(ishi) > 1) _cge_fail("insurance() takes one account", 198)
    M.ishi = (rows(ishi) ? ishi[1] : 0)
    taxacc = (dirtax \ saltax \ imptax \ exptax \ acttax \ vattax)
    taxidx = J(6, 1, 0)
    for (k = 1; k <= 6; k++) {
        if (taxacc[k] != "") taxidx[k] = _cge_lookup(M, taxacc[k], rolename[taxrole[k]])
    }
    if (vattax != "" & vatshare != "") _cge_fail("give either vattax() or vatshare(), not both", 198)
    // Taxes on factor use (account:factor) and on factor income (from version 0.5.0)
    _cge_map_ftax(M, ftaxspec, fytax)

    if (rows(M.iC) < rows(M.iA)) {
        _cge_fail("each activity needs a paired commodity: list the commodities paired with the " +
                  "activities first, in the same order, then any commodities without a paired activity", 198)
    }

    // Layouts rewritten before the checks (model_spec.md, Section 7.0):
    // exports recorded as sales by activities, and taxes paid directly to the
    // government account, which are routed through internal tax accounts.
    direct = (taxidx :== M.igov)
    if (sum(direct[(2, 3, 4, 6)]) > 1) {
        _cge_fail("only one of saltax(), imptax(), exptax() and vattax() may name the government account", 198)
    }
    labels = M.labels0
    M.rewritten = J(1, 12, 0)
    for (k = 1; k <= rows(M.iA); k++) {
        x = S[M.iA[k], M.irow]
        if (x != 0) {
            S[M.iC[k], M.irow] = S[M.iC[k], M.irow] + x
            S[M.iA[k], M.iC[k]] = S[M.iA[k], M.iC[k]] + x
            S[M.iA[k], M.irow] = 0
            M.rewritten[1] = M.rewritten[1] + x
        }
    }
    // Margins netted out of margin activities as a negative use of their own product
    imarg = _cge_lookup(M, margins, "margin activity")
    for (k = 1; k <= rows(imarg); k++) {
        j = 0
        for (i = 1; i <= rows(M.iA); i++) if (M.iA[i] == imarg[k]) j = i
        if (j == 0) _cge_fail("margins(): " + M.labels0[imarg[k]] + " is not one of the mapped activities", 198)
        x = S[M.iC[j], M.iA[j]]
        if (x >= 0) {
            _cge_fail("margins(): activity " + M.labels0[M.iA[j]] + " has no negative use of its own product " +
                      M.labels0[M.iC[j]], 459)
        }
        S[M.iA[j], M.iC[j]] = S[M.iA[j], M.iC[j]] - x
        S[M.iC[j], M.iA[j]] = 0
        M.rewritten[7] = M.rewritten[7] - x
    }
    M.imargins = imarg

    // Territorial correction: commodity, then optionally its activity
    iterr = _cge_lookup(M, territorial, "territorial correction")
    if (rows(iterr) > 2) _cge_fail("territorial() takes the correction commodity and, optionally, its activity", 198)
    if (rows(iterr)) {
        mapped = M.iA \ M.iC \ M.iF \ M.iH \ M.iE \ M.iT \ M.igov \ M.isav \ M.irow \ ishi \
                 select(taxidx, taxidx :> 0) \ M.iFT \ (M.iFY > 0 & M.iFY < . ? M.iFY : J(0, 1, .))
        for (k = 1; k <= rows(iterr); k++) {
            if (anyof(mapped, iterr[k])) _cge_fail("territorial(): " + M.labels0[iterr[k]] + " is also mapped to a role", 198)
        }
        tol = 1e-9 * max((1, max(abs(S))))
        ct = iterr[1]
        if (rows(iterr) == 2) {
            at = iterr[2]
            x = S[at, M.irow]
            S[ct, M.irow] = S[ct, M.irow] + x
            S[at, ct] = S[at, ct] + x
            S[at, M.irow] = 0
            if (max(abs(S[at, .])) > tol | max(abs(S[., at])) > tol) {
                _cge_fail("territorial(): " + M.labels0[at] + " still has flows after its exports are moved", 459)
            }
        }
        timp = S[M.irow, ct]
        texp = S[ct, M.irow]
        hcons = S[ct, M.iH']
        rest = S[ct, .]
        rest[M.iH'] = J(1, rows(M.iH), 0)
        rest[M.irow] = 0
        restc = S[., ct]
        restc[M.irow] = 0
        if (max(abs(rest)) > tol | max(abs(restc)) > tol) {
            _cge_fail("territorial(): " + M.labels0[ct] + " may have only household consumption, imports and exports", 459)
        }
        if (abs(sum(hcons)) <= tol) _cge_fail("territorial(): households have no consumption of " + M.labels0[ct], 459)
        share = hcons :/ sum(hcons)
        S[M.irow, M.iH'] = S[M.irow, M.iH'] + share :* timp
        S[M.iH, M.irow] = S[M.iH, M.irow] + share' :* texp
        S[ct, M.iH'] = J(1, rows(M.iH), 0)
        S[ct, M.irow] = 0
        S[M.irow, ct] = 0
        M.rewritten[8] = timp
        M.rewritten[9] = texp
    }
    M.iterritorial = iterr

    // Stock-change accounts, merged into savings-investment (from version 0.1.7)
    istk = _cge_lookup(M, stocks, "stock-change account")
    if (rows(istk)) {
        mapped = M.iA \ M.iC \ M.iF \ M.iH \ M.iE \ M.iT \ M.igov \ M.isav \ M.irow \ ishi \
                 select(taxidx, taxidx :> 0) \ iterr \ M.iFT \ (M.iFY > 0 & M.iFY < . ? M.iFY : J(0, 1, .))
        tol = 1e-9 * max((1, max(abs(S))))
        for (k = 1; k <= rows(istk); k++) {
            i = istk[k]
            if (anyof(mapped, i)) _cge_fail("stocks(): " + M.labels0[i] + " is also mapped to a role", 198)
            rest = S[i, .]
            rest[M.isav] = 0
            if (max(abs(rest)) > tol) {
                _cge_fail("stocks(): " + M.labels0[i] + " may receive payments only from " +
                          M.labels0[M.isav], 459)
            }
            M.rewritten[10] = M.rewritten[10] + S[i, M.isav]
            S[., M.isav] = S[., M.isav] + S[., i]
            S[., i] = J(rows(S), 1, 0)
            S[i, .] = J(1, cols(S), 0)
        }
    }
    M.istocks = istk
    taxname = ("dirtax", "saltax", "imptax", "exptax", "acttax", "vattax")
    for (k = 1; k <= 6; k++) {
        if (!direct[k]) continue
        payers = (k == 1 ? (M.iH \ M.iE) : (k == 5 ? M.iA : M.iC))
        if (_cge_find(labels, "_" + taxname[k])) {
            _cge_fail("the SAM already has an account named _" + taxname[k], 198)
        }
        nacc = rows(labels)
        S = (S, J(nacc, 1, 0)) \ J(1, nacc + 1, 0)
        labels = labels \ ("_" + taxname[k])
        S[nacc + 1, payers'] = S[M.igov, payers']
        S[M.igov, payers'] = J(1, rows(payers), 0)
        S[M.igov, nacc + 1] = sum(S[nacc + 1, .])
        taxidx[k] = nacc + 1
        M.rewritten[rwidx[k]] = sum(S[nacc + 1, .])
    }
    // VAT recorded within the sales tax (model_spec.md, 12.2): the given share
    // of each commodity's sales tax is moved to an internal account _vatshare
    if (vatshare != "") {
        if (taxidx[2] == 0) _cge_fail("vatshare() needs a sales tax account: give saltax()", 198)
        if (_cge_find(labels, "_vatshare")) _cge_fail("the SAM already has an account named _vatshare", 198)
        vshare = _cge_shares(vatshare, labels[M.iC], 0, "vatshare")
        nacc = rows(labels)
        S = (S, J(nacc, 1, 0)) \ J(1, nacc + 1, 0)
        labels = labels \ "_vatshare"
        S[nacc + 1, M.iC'] = vshare' :* S[taxidx[2], M.iC']
        S[taxidx[2], M.iC'] = S[taxidx[2], M.iC'] - S[nacc + 1, M.iC']
        x = sum(S[nacc + 1, .])
        S[M.igov, nacc + 1] = x
        S[M.igov, taxidx[2]] = S[M.igov, taxidx[2]] - x
        taxidx[6] = nacc + 1
        M.rewritten[12] = x
    }
    M.labels = labels
    M.S = S
    nacc = rows(labels)
    M.idirtax = taxidx[1]
    M.isaltax = taxidx[2]
    M.iimptax = taxidx[3]
    M.iexptax = taxidx[4]
    M.iacttax = taxidx[5]
    M.ivattax = taxidx[6]
    _cge_map_rewrites(M)

    // Role of every account; an account may have only one role
    role = J(nacc, 1, 0)
    _cge_assign(M, role, M.iA, 1, rolename)
    _cge_assign(M, role, M.iC, 2, rolename)
    _cge_assign(M, role, M.iF, 3, rolename)
    _cge_assign(M, role, M.iH, 4, rolename)
    _cge_assign(M, role, M.iE, 13, rolename)
    _cge_assign(M, role, M.iT, 14, rolename)
    _cge_assign(M, role, M.igov, 5, rolename)
    _cge_assign(M, role, M.isav, 6, rolename)
    _cge_assign(M, role, M.irow, 7, rolename)
    _cge_assign(M, role, ishi, 15, rolename)
    for (k = 1; k <= 6; k++) if (taxidx[k] > 0) _cge_assign(M, role, taxidx[k], taxrole[k], rolename)
    _cge_assign(M, role, M.iFT, 18, rolename)
    if (M.iFY) _cge_assign(M, role, M.iFY, 19, rolename)

    // Accounts without a role get code 17 ("unmapped"); every problem found
    // is collected as (problem code, row, column, value) and reported at the end:
    // 1 unmapped account with flows, 2 unsupported flow, 3 activity paid by a
    // commodity it is not paired with, 4 negative flow, 5 unbalanced account.
    role = role + 17 :* (role :== 0)
    issues = J(0, 4, .)
    tol = 1e-8 * max((1, max(abs(S))))
    for (i = 1; i <= nacc; i++) {
        if (role[i] == 17 & (max(abs(S[i, .])) > tol | max(abs(S[., i])) > tol)) {
            issues = issues \ (1, i, i, sum(S[i, .]))
        }
        if (abs(sum(S[i, .]) - sum(S[., i])) > tol) {
            issues = issues \ (5, i, i, sum(S[i, .]) - sum(S[., i]))
        }
    }

    // Supported flows (row role, column role); role 13 is an enterprise,
    // role 14 a margin account, role 15 a health insurance fund and role 16 a
    // VAT account
    allowed = J(19, 19, 0)
    allowed[1, 2] = 1
    allowed[2, 1] = 1; allowed[3, 1] = 1; allowed[12, 1] = 1
    allowed[7, 2] = 1; allowed[10, 2] = 1; allowed[9, 2] = 1; allowed[11, 2] = 1
    allowed[2, 4] = 1; allowed[2, 5] = 1; allowed[2, 6] = 1; allowed[2, 7] = 1
    allowed[4, 3] = 1; allowed[13, 3] = 1; allowed[5, 3] = 1; allowed[7, 3] = 1
    allowed[8, 4] = 1; allowed[6, 4] = 1; allowed[8, 13] = 1; allowed[6, 13] = 1
    allowed[5, 8] = 1; allowed[5, 9] = 1; allowed[5, 10] = 1; allowed[5, 11] = 1; allowed[5, 12] = 1
    allowed[6, 5] = 1; allowed[6, 7] = 1
    allowed[14, 2] = 1; allowed[2, 14] = 1
    allowed[15, 3] = 1; allowed[15, 5] = 1; allowed[15, 7] = 1; allowed[2, 15] = 1; allowed[6, 15] = 1
    allowed[16, 2] = 1; allowed[5, 16] = 1
    // home consumption: households pay activities (from version 0.3.2)
    allowed[1, 4] = 1
    // taxes on factor use, paid by activities, and on factor income, paid by
    // factors (from version 0.5.0)
    allowed[18, 1] = 1; allowed[5, 18] = 1; allowed[19, 3] = 1; allowed[5, 19] = 1
    // Transfers: among households and enterprises, from them to the rest of
    // the world, from government (to them, itself and abroad) and from the
    // rest of the world (to them, government and factors)
    transfers = J(19, 19, 0)
    transfers[(4, 13), (4, 13)] = J(2, 2, 1)
    transfers[7, (4, 13)] = J(1, 2, 1)
    transfers[(4, 13, 5, 7), 5] = J(4, 1, 1)
    transfers[(4, 13, 5, 3), 7] = J(4, 1, 1)
    allowed = allowed :| transfers
    // Cells that may be negative
    negok = transfers
    negok[(6, 8, 9, 10, 11, 12, 16, 18, 19), .] = J(9, 19, 1)
    negok[5, (8, 9, 10, 11, 12, 16, 18, 19)] = J(1, 8, 1)
    negok[2, 6] = 1         // investment demand: a fall in inventories
    negok[1, 2] = 1         // sales of commodities by activities: negative yields

    for (i = 1; i <= nacc; i++) {
        for (j = 1; j <= nacc; j++) {
            if (abs(S[i, j]) <= tol) continue
            rr = role[i]
            rc = role[j]
            if (!allowed[rr, rc]) {
                issues = issues \ (2, i, j, S[i, j])
                continue
            }
            if (S[i, j] < 0 & !negok[rr, rc]) issues = issues \ (4, i, j, S[i, j])
        }
    }
    // Note on negative sales of commodities by activities (negative yields)
    negsales = 0
    negtotal = 0
    for (i = 1; i <= rows(M.iA); i++) {
        for (j = 1; j <= rows(M.iC); j++) {
            if (S[M.iA[i], M.iC[j]] < -tol) {
                negsales = negsales + 1
                negtotal = negtotal + S[M.iA[i], M.iC[j]]
                printf("{txt}Note: negative sale of %s by %s ({res}%g{txt}), kept as a negative yield\n",
                       M.labels[M.iC[j]], M.labels[M.iA[i]], S[M.iA[i], M.iC[j]])
            }
        }
    }
    st_numscalar("r(N_negative_sales)", negsales)
    if (reportfile != "") _cge_map_save(M, issues, role, rolename, reportfile, replace)
    if (rows(issues)) {
        _cge_map_report(M, issues, role, rolename)
        exit(459)
    }

    M.A = M.labels[M.iA]
    M.C = M.labels[M.iC]
    M.F = M.labels[M.iF]
    M.H = M.labels[M.iH]
    M.E = (rows(M.iE) ? M.labels[M.iE] : J(0, 1, ""))
    M.D = M.H \ M.E
    M.I = M.D \ M.labels[M.igov] \ M.labels[M.irow]
    if (M.ishi) M.I = M.I \ M.labels[M.ishi]
    M.n = rows(M.iA)
    M.nC = rows(M.iC)
    M.nF = rows(M.iF)
    M.nH = rows(M.iH)
    M.nE = rows(M.iE)
    M.nD = M.nH + M.nE
    M.nI = M.nD + 2 + (M.ishi > 0)
    M.mapped = 1
    M.calibrated = 0
    _cge_store(M)
    printf("{txt}Accounts mapped: {res}%f{txt} activities, {res}%f{txt} commodities, {res}%f{txt} factors, {res}%f{txt} households, {res}%f{txt} enterprises, {res}%f{txt} margin accounts\n",
           M.n, M.nC, M.nF, M.nH, M.nE, rows(M.iT))
    if (M.ishi) printf("{txt}Health insurance fund: {res}%s\n", M.labels[M.ishi])
    for (k = 1; k <= rows(M.iFT); k++) {
        printf("{txt}Tax on the use of %s: {res}%s\n", M.F[M.ftf[k]], M.labels[M.iFT[k]])
    }
    if (M.iFY) printf("{txt}Tax on factor income: {res}%s\n", M.labels[M.iFY])
}

// Amounts moved when rewriting national-accounts layouts
// Taxes on factor use, given as account:factor, and the account of taxes on
// factor income (from version 0.5.0)
void _cge_map_ftax(struct cge_model scalar M, string scalar spec, string scalar fytax)
{
    string rowvector tok
    real colvector a
    real scalar k, pos, f
    M.iFT = J(0, 1, .)
    M.ftf = J(0, 1, .)
    tok = tokens(spec)
    for (k = 1; k <= cols(tok); k++) {
        pos = strpos(tok[k], ":")
        if (!pos) _cge_fail("factortax() entries take the form account:factor, the factor whose use the account taxes", 198)
        a = _cge_lookup(M, substr(tok[k], 1, pos - 1), "factor tax")
        f = selectindex(M.labels0[M.iF] :== substr(tok[k], pos + 1, .))
        if (!length(f)) _cge_fail("factortax(): " + substr(tok[k], pos + 1, .) + " is not one of the factors", 198)
        if (anyof(M.iFT, a[1])) _cge_fail("factortax(): " + M.labels0[a[1]] + " is given twice", 198)
        M.iFT = M.iFT \ a[1]
        M.ftf = M.ftf \ f[1]
    }
    M.iFY = 0
    if (fytax != "") {
        a = _cge_lookup(M, fytax, "factor income tax")
        if (rows(a) > 1) _cge_fail("factorincometax() takes one account", 198)
        M.iFY = a[1]
    }
}

void _cge_map_rewrites(struct cge_model scalar M)
{
    string rowvector what, account
    real scalar k
    what = ("Exports recorded as sales by activities, moved to the paired commodities",
            "Direct taxes paid to government, routed through account _dirtax",
            "Sales taxes paid to government, routed through account _saltax",
            "Import taxes paid to government, routed through account _imptax",
            "Export taxes paid to government, routed through account _exptax",
            "Activity taxes paid to government, routed through account _acttax")
    account = ("", "_dirtax", "_saltax", "_imptax", "_exptax", "_acttax")
    if (cols(M.rewritten) >= 12) {
        if (_cge_find(M.labels, "_vattax")) {
            printf("{txt}VAT paid to government, routed through account _vattax: {res}%g\n", M.rewritten[11])
        }
        if (_cge_find(M.labels, "_vatshare")) {
            printf("{txt}VAT within the sales tax, moved to account _vatshare: {res}%g\n", M.rewritten[12])
        }
        st_numscalar("r(vat_moved)", M.rewritten[12])
    }
    if (M.rewritten[1] != 0) printf("{txt}%s: {res}%g\n", what[1], M.rewritten[1])
    if (rows(M.imargins)) {
        printf("{txt}Margins netted out of %s, moved to their output: {res}%g\n",
               invtokens(M.labels0[M.imargins]'), M.rewritten[7])
    }
    for (k = 2; k <= 6; k++) {
        if (_cge_find(M.labels, account[k])) printf("{txt}%s: {res}%g\n", what[k], M.rewritten[k])
    }
    if (rows(M.istocks)) {
        printf("{txt}Stock-change account(s) %s merged into savings-investment: {res}%g\n",
               invtokens(M.labels0[M.istocks]'), M.rewritten[10])
    }
    if (rows(M.iterritorial)) {
        printf("{txt}Territorial correction %s: purchases abroad by residents, now household payments abroad: {res}%g\n",
               M.labels0[M.iterritorial[1]], M.rewritten[8])
        printf("{txt}Territorial correction %s: purchases by non-residents, now transfers from abroad to households: {res}%g\n",
               M.labels0[M.iterritorial[1]], M.rewritten[9])
    }
    st_numscalar("r(exports_moved)", M.rewritten[1])
    st_numscalar("r(territorial_imports)", M.rewritten[8])
    st_numscalar("r(territorial_exports)", M.rewritten[9])
    st_numscalar("r(margins_moved)", M.rewritten[7])
    st_numscalar("r(stocks_merged)", M.rewritten[10])
    st_numscalar("r(taxes_rerouted)", sum(M.rewritten[(2, 3, 4, 5, 6)]))
}

// Summary of mapping problems, grouped by problem and by the roles of the
// paying and receiving accounts, largest first
void _cge_map_report(struct cge_model scalar M, real matrix issues, real colvector role,
                     string rowvector rolename)
{
    string rowvector problem
    real colvector key, ukey, ord, sel
    real matrix grp
    real scalar g, k, total, cat, rr, rc, i

    problem = ("account has flows but no role", "flow not represented", "secondary production",
               "negative flow", "account not balanced")
    total = sum(abs(M.S))
    key = issues[., 1] :* 10000 + role[issues[., 2]] :* 100 + role[issues[., 3]]
    ukey = uniqrows(key)
    grp = J(rows(ukey), 4, .)
    for (g = 1; g <= rows(ukey); g++) {
        sel = select((1::rows(issues)), key :== ukey[g])
        grp[g, .] = (ukey[g], rows(sel), sum(issues[sel, 4]), sum(abs(issues[sel, 4])))
    }
    ord = order(-grp[., 4], 1)
    grp = grp[ord, .]

    printf("{err}The SAM contains flows that the model does not represent.\n")
    printf("{txt}%f problem(s) in %f group(s); values are SAM units, shares are of the sum of absolute cells.\n",
           rows(issues), rows(grp))
    printf("{txt}For an account with no role the value is its total; its flows are also listed by role.\n")
    printf("{txt}{hline 104}\n")
    printf("{txt}%-30s %-20s %-20s %6s %16s %7s\n", "Problem", "Paid by (column)", "Received by (row)", "Cells", "Value", "Share")
    printf("{txt}{hline 104}\n")
    for (g = 1; g <= rows(grp); g++) {
        cat = floor(grp[g, 1] / 10000)
        rr = floor(mod(grp[g, 1], 10000) / 100)
        rc = mod(grp[g, 1], 100)
        printf("{txt}%-30s %-20s %-20s {res}%6.0f %16.0fc %6.2f%%\n", problem[cat],
               (cat == 1 | cat == 5 ? "" : rolename[rc]), rolename[rr], grp[g, 2], grp[g, 3],
               100 * grp[g, 4] / total)
    }
    printf("{txt}{hline 104}\n")
    // Accounts named in account-level problems
    for (k = 1; k <= rows(issues); k++) {
        if (issues[k, 1] == 1) printf("{txt}  no role: {res}%s\n", M.labels[issues[k, 2]])
    }
    for (k = 1; k <= rows(issues); k++) {
        if (issues[k, 1] == 5) {
            i = issues[k, 2]
            printf("{txt}  not balanced: {res}%s{txt} (row minus column total {res}%g{txt})\n", M.labels[i], issues[k, 4])
        }
    }
    printf("{txt}Use the report() option to save every cell to a file.\n")
}

// Every problem cell, written as a CSV file
void _cge_map_save(struct cge_model scalar M, real matrix issues, real colvector role,
                   string rowvector rolename, string scalar fn, real scalar replace)
{
    string rowvector problem
    real scalar fh, k, i, j
    problem = ("account has flows but no role", "flow not represented", "secondary production",
               "negative flow", "account not balanced")
    if (fileexists(fn)) {
        if (!replace) _cge_fail("file " + fn + " already exists; specify replace", 602)
        unlink(fn)
    }
    fh = fopen(fn, "w")
    fput(fh, "problem,paid_by,paid_by_role,received_by,received_by_role,value")
    for (k = 1; k <= rows(issues); k++) {
        i = issues[k, 2]
        j = issues[k, 3]
        if (issues[k, 1] == 1 | issues[k, 1] == 5) {
            fput(fh, problem[issues[k, 1]] + ",," + "," + M.labels[i] + "," + rolename[role[i]] + "," +
                 strofreal(issues[k, 4], "%21.0g"))
        }
        else {
            fput(fh, problem[issues[k, 1]] + "," + M.labels[j] + "," + rolename[role[j]] + "," +
                 M.labels[i] + "," + rolename[role[i]] + "," + strofreal(issues[k, 4], "%21.0g"))
        }
    }
    fclose(fh)
    printf("{txt}Mapping report saved to {res}%s{txt} (%f row(s))\n", fn, rows(issues))
}

void _cge_assign(struct cge_model scalar M, real colvector role, real colvector idx, real scalar code,
                 string rowvector rolename)
{
    real scalar k
    for (k = 1; k <= rows(idx); k++) {
        if (role[idx[k]] != 0) {
            _cge_fail("account " + M.labels[idx[k]] + " is mapped to both " + rolename[role[idx[k]]] +
                      " and " + rolename[code], 198)
        }
        role[idx[k]] = code
    }
}

// =====================================================================
// Equations (model_spec.md, Section 5)
// =====================================================================

void _cge_put(struct cge_model scalar M, real colvector L, real colvector R, real colvector K,
              real scalar record, string scalar name, real matrix lhs, real matrix rhs, real matrix mask)
{
    if (rows(lhs) != rows(rhs) | cols(lhs) != cols(rhs) | rows(lhs) != rows(mask) | cols(lhs) != cols(mask)) {
        _cge_fail("cge internal error: equation block " + name + " is not conformable", 3200)
    }
    L = L \ colshape(lhs, 1)
    R = R \ colshape(rhs, 1)
    K = K \ colshape(mask, 1)
    if (record) {
        M.ename = M.ename \ name
        M.elen = M.elen \ rows(lhs) * cols(lhs)
    }
}

void _cge_eq(struct cge_model scalar M, struct cge_par scalar p, real colvector x,
             real colvector L, real colvector R, real colvector K, real scalar record)
{
    real matrix PA, PVA, PINTA, PX, PD, PE, PM, PQ, W, EXR, CPI, DPI
    real matrix QA, QVA, QINTA, QF, QINT, QX, QD, QE, QM, QQ, QH, QG, QINV, QFS
    real matrix YF, YIF, YI, EH, YG, EG, GSAV, FSAV, TINS, MPS, TINSADJ, MPSADJ
    real matrix IADJ, GADJ, WFDIST, WALRAS, QT, QER, YSHI, SHIADJ, QSHI, EFF, HS
    real matrix TQADJ, TMADJ, TVADJ, PWE, QHA, LSW, LSM, DW, RM, RE, RA, QNA, PNA, PXAC, QXAC
    real matrix qxac, pxqx
    real rowvector sxac, lxac, rsac
    real matrix qf, rho, cessum, q3, wage, pvaqva, lhs, rhs, yif, z, vint
    real matrix top, nested, qna, MF, MC, qint, nsum, nlog, pnqn, pnf, nsf, pnc, nsc, pe
    real colvector rns, rf, rc, cdf, cdc
    real colvector oneA, oneC, oneF, oneH, oneD, DY, rs, tq, tm, tv, PH, pwe, PDD, unemp, rwage, ub, rent, ul, ur
    real rowvector SN
    real scalar k, nH, nD

    // a standalone model (from version 0.13.0): the constraints and the user
    // equations only
    if (_cge_sa(M)) {
        L = R = K = J(0, 1, .)
        if (record) {
            M.ename = J(0, 1, "")
            M.elen = J(0, 1, .)
        }
        _cge_put(M, L, R, K, record, "B1", _cge_bres(M, p, x), J(rows(M.bY), 1, 0), J(rows(M.bY), 1, 1))
        _cge_u_eval(M, p, x, ul, ur)
        _cge_put(M, L, R, K, record, "U", ul, ur, J(rows(ul), 1, 1))
        if (record) M.erep = J(0, 1, .)
        return
    }

    PA = _cge_v(M, x, 1);     PVA = _cge_v(M, x, 2);    PINTA = _cge_v(M, x, 3)
    PX = _cge_v(M, x, 4);     PD = _cge_v(M, x, 5);     PE = _cge_v(M, x, 6)
    PM = _cge_v(M, x, 7);     PQ = _cge_v(M, x, 8);     W = _cge_v(M, x, 9)
    EXR = _cge_v(M, x, 10);   CPI = _cge_v(M, x, 11);   DPI = _cge_v(M, x, 12)
    QA = _cge_v(M, x, 13);    QVA = _cge_v(M, x, 14);   QINTA = _cge_v(M, x, 15)
    QF = _cge_v(M, x, 16);    QINT = _cge_v(M, x, 17);  QX = _cge_v(M, x, 18)
    QD = _cge_v(M, x, 19);    QE = _cge_v(M, x, 20);    QM = _cge_v(M, x, 21)
    QQ = _cge_v(M, x, 22);    QH = _cge_v(M, x, 23);    QG = _cge_v(M, x, 24)
    QINV = _cge_v(M, x, 25);  QFS = _cge_v(M, x, 26);   YF = _cge_v(M, x, 27)
    YIF = _cge_v(M, x, 28);   YI = _cge_v(M, x, 29);    EH = _cge_v(M, x, 30)
    YG = _cge_v(M, x, 31);    EG = _cge_v(M, x, 32);    GSAV = _cge_v(M, x, 33)
    FSAV = _cge_v(M, x, 34);  TINS = _cge_v(M, x, 35);  MPS = _cge_v(M, x, 36)
    TINSADJ = _cge_v(M, x, 37); MPSADJ = _cge_v(M, x, 38); IADJ = _cge_v(M, x, 39)
    GADJ = _cge_v(M, x, 40);  WFDIST = _cge_v(M, x, 41); WALRAS = _cge_v(M, x, 42)
    QT = _cge_v(M, x, 43);    QER = _cge_v(M, x, 44);   YSHI = _cge_v(M, x, 45)
    SHIADJ = _cge_v(M, x, 46); QSHI = _cge_v(M, x, 47);  EFF = _cge_v(M, x, 48)
    HS = _cge_v(M, x, 49)
    TQADJ = _cge_v(M, x, 50); TMADJ = _cge_v(M, x, 51); TVADJ = _cge_v(M, x, 52)
    PWE = _cge_v(M, x, 53);   QHA = _cge_v(M, x, 54)
    LSW = _cge_v(M, x, 55);   LSM = _cge_v(M, x, 56);   DW = _cge_v(M, x, 57)
    RM = _cge_v(M, x, 58);    RE = _cge_v(M, x, 59);    RA = _cge_v(M, x, 60)
    QNA = _cge_v(M, x, 61);   PNA = _cge_v(M, x, 62)
    PXAC = _cge_v(M, x, 63);  QXAC = _cge_v(M, x, 64)

    L = J(0, 1, .)
    R = J(0, 1, .)
    K = J(0, 1, .)
    if (record) {
        M.ename = J(0, 1, "")
        M.elen = J(0, 1, .)
    }
    oneA = J(M.n, 1, 1)
    oneC = J(M.nC, 1, 1)
    oneF = J(M.nF, 1, 1)
    oneH = J(M.nH, 1, 1)
    oneD = J(M.nD, 1, 1)
    nH = M.nH
    nD = M.nD

    // Rates after scaling (from version 0.3.1); PH is the price paid by final
    // users, including VAT, and vint the VAT activities cannot recover
    tq = p.tq :* TQADJ
    tm = p.tm :* TMADJ
    tv = p.tv :* TVADJ
    PH = PQ :* (1 :+ tv)
    vint = tv * (1 :- p.kappa)'
    // World export prices: a variable where export demand is finite; the price
    // domestic buyers pay for domestic output, with domestic margins (13.2, 13.4)
    pwe = M.ced :* PWE + (1 :- M.ced) :* p.pwe
    PDD = PD + p.icd' * PQ

    // 5.1 Price block; premiums on imports and exports (Section 16.1)
    _cge_put(M, L, R, K, record, "P1", PM, p.pwm :* (1 :+ tm + RM) :* EXR + p.ici' * PQ, M.cm)
    // (in Mata a - b binds more tightly than a :- b, so colon operators are used throughout)
    _cge_put(M, L, R, K, record, "P2", PE, pwe :* (1 :- p.te :- RE) :* EXR - p.ice' * PQ, M.ce)
    // p.icm' * PQ: cost of margin services per unit of composite supply
    _cge_put(M, L, R, K, record, "P3", PQ :* (1 :- tq) :* QQ,
             M.cdo :* PDD :* QD + M.cm :* PM :* QM + (p.icm' * PQ) :* QQ, M.cq)
    _cge_put(M, L, R, K, record, "P4", PX :* QX, M.cdo :* PD :* QD + M.ce :* PE :* QE, M.cx)
    // Output aggregated from several activities (from version 0.5.2, Section
    // 17.3): each activity is paid its own price PXAC
    if (any(M.cac)) {
        _cge_put(M, L, R, K, record, "P5", PA, p.theta * PX + rowsum(p.theta :* M.xac :* (PXAC :- PX')), oneA)
    }
    else _cge_put(M, L, R, K, record, "P5", PA, p.theta * PX, oneA)
    _cge_put(M, L, R, K, record, "P6", PINTA, (p.ica :* (1 :+ vint))' * PQ, oneA)
    _cge_put(M, L, R, K, record, "P7", PA :* (1 :- p.ta :- RA) :* QA, PVA :* QVA + PINTA :* QINTA, oneA)
    _cge_put(M, L, R, K, record, "P8", CPI, p.cwts' * PH, 1)
    _cge_put(M, L, R, K, record, "P9", DPI, p.dwts' * PD, 1)

    // 5.2 Production block
    _cge_put(M, L, R, K, record, "Q1", QVA, p.iva :* QA, M.lt)
    _cge_put(M, L, R, K, record, "Q2", QINTA, p.inta :* QA, M.lt)
    // CES or Cobb-Douglas top nest. Mata gives 0 * missing = missing, so the CES
    // branch uses an exponent of 1 where rho is 0 (Leontief and Cobb-Douglas rows)
    rs = p.rha + (p.rha :== 0)
    _cge_put(M, L, R, K, record, "Q1C", QA,
             M.cda :* (p.aa :* (QVA :^ p.dla) :* (QINTA :^ p.dlac)) +
             (1 :- M.cda) :* (p.aa :* (p.dla :* (QVA :^ (-rs)) + p.dlac :* (QINTA :^ (-rs))) :^ (-1 :/ rs)),
             1 :- M.lt)
    _cge_put(M, L, R, K, record, "Q2C",
             M.cda :* (PVA :* QVA :* p.dlac) + (1 :- M.cda) :* QVA,
             M.cda :* (PINTA :* QINTA :* p.dla) +
             (1 :- M.cda) :* (QINTA :* (((PINTA :/ PVA) :* p.dla :/ p.dlac) :^ (1 :/ (1 :+ p.rha)))),
             1 :- M.lt)
    // Factors in efficiency units (from version 0.1.14), and days worked (0.3.4)
    z = p.af :* EFF :* DW
    qf = M.fa :* (z :* QF) + (1 :- M.fa)
    rho = (M.cd + (1 :- M.cd) :* p.rva)'
    // Nests of value added (from version 0.5.1, Section 17.2): the top of
    // value added combines the factors in no nest and the nests
    top = M.fa :* (M.nestf :== 0)
    cessum = colsum(top :* p.dva :* (qf :^ (-rho)))
    if (M.nN) {
        qna = M.nn :* QNA + (1 :- M.nn)
        cessum = cessum + colsum(M.nn :* p.dvn :* (qna :^ (-rho)))
    }
    q3 = (p.ad' :* (cessum :^ (-1 :/ rho)))'
    for (k = 1; k <= M.n; k++) {
        if (!M.cd[k]) continue
        q3[k] = p.ad[k] * exp(colsum(top[., k] :* p.dva[., k] :* ln(qf[., k])) +
                              (M.nN ? colsum(M.nn[., k] :* p.dvn[., k] :* ln(qna[., k])) : 0))
    }
    _cge_put(M, L, R, K, record, "Q3", QVA, q3, oneA)
    wage = W :* WFDIST
    pvaqva = (PVA :* QVA)'
    // the cost of a factor to the activity, with taxes on its use (from version 0.5.0)
    lhs = wage :* (1 :+ p.tf)
    rhs = (pvaqva :/ cessum) :* p.dva :* (qf :^ (-rho :- 1)) :* z
    for (k = 1; k <= M.n; k++) {
        if (M.cd[k]) {
            lhs[., k] = wage[., k] :* (1 :+ p.tf[., k]) :* QF[., k]
            rhs[., k] = p.dva[., k] :* pvaqva[k]
        }
    }
    if (M.nN) {
        // Within the nests: the exponent and Cobb-Douglas flag of each
        // member's nest (Mata gives 0 * missing = missing, so the CES branch
        // uses an exponent of 1 for Cobb-Douglas nests), and the CES sums of
        // the members, factors in efficiency units and commodities in quantities
        rns = p.rhn + (p.rhn :== 0)
        rf = J(M.nF, 1, 1)
        cdf = J(M.nF, 1, 0)
        MF = J(M.nN, M.nF, 0)
        for (k = 1; k <= M.nF; k++) {
            if (!M.nestf[k]) continue
            rf[k] = rns[M.nestf[k]]
            cdf[k] = M.cdn[M.nestf[k]]
            MF[M.nestf[k], k] = 1
        }
        rc = J(M.nC, 1, 1)
        cdc = J(M.nC, 1, 0)
        MC = J(M.nN, M.nC, 0)
        for (k = 1; k <= M.nC; k++) {
            if (!M.nestc[k]) continue
            rc[k] = rns[M.nestc[k]]
            cdc[k] = M.cdn[M.nestc[k]]
            MC[M.nestc[k], k] = 1
        }
        nested = M.fa :* (M.nestf :> 0)
        qint = M.ecell :* QINT + (1 :- M.ecell)
        nsum = MF * (nested :* p.dva :* (qf :^ (-rf))) + MC * (M.ecell :* p.dce :* (qint :^ (-rc)))
        nlog = MF * (nested :* p.dva :* ln(qf)) + MC * (M.ecell :* p.dce :* ln(qint))
        pnqn = PNA :* QNA
        // factors in a nest: the nest's value in place of value added
        pnf = MF' * pnqn
        nsf = MF' * nsum :+ (M.nestf :== 0)
        lhs = nested :* (cdf :* (wage :* (1 :+ p.tf) :* QF) + (1 :- cdf) :* (wage :* (1 :+ p.tf))) +
              (1 :- nested) :* lhs
        rhs = nested :* (cdf :* (p.dva :* pnf) + (1 :- cdf) :* ((pnf :/ nsf) :* p.dva :* (qf :^ (-rf :- 1)) :* z)) +
              (1 :- nested) :* rhs
    }
    _cge_put(M, L, R, K, record, "Q4", lhs, rhs, M.fa)
    // N1: the quantity of each nest; N2: its price, from the top of value
    // added; N3: the demand for each commodity in a nest (Section 17.2)
    if (M.nN) {
        _cge_put(M, L, R, K, record, "N1", QNA,
                 p.an :* (M.cdn :* exp(nlog) + (1 :- M.cdn) :* (nsum :^ (-1 :/ rns))), M.nn)
        _cge_put(M, L, R, K, record, "N2", M.cd' :* pnqn + (1 :- M.cd') :* PNA,
                 M.cd' :* (p.dvn :* pvaqva) + (1 :- M.cd') :* ((pvaqva :/ cessum) :* p.dvn :* (qna :^ (-rho :- 1))),
                 M.nn)
        pe = PQ :* (1 :+ vint)
        pnc = MC' * pnqn
        nsc = MC' * nsum :+ (M.nestc :== 0)
        _cge_put(M, L, R, K, record, "N3", cdc :* (pe :* QINT) + (1 :- cdc) :* pe,
                 cdc :* (p.dce :* pnc) + (1 :- cdc) :* ((pnc :/ nsc) :* p.dce :* (qint :^ (-rc :- 1))), M.ecell)
    }
    else {
        _cge_put(M, L, R, K, record, "N1", J(0, M.n, 0), J(0, M.n, 0), J(0, M.n, 0))
        _cge_put(M, L, R, K, record, "N2", J(0, M.n, 0), J(0, M.n, 0), J(0, M.n, 0))
        _cge_put(M, L, R, K, record, "N3", J(0, M.n, 0), J(0, M.n, 0), J(0, M.n, 0))
    }
    // Health services and factor efficiency (from version 0.1.14)
    _cge_put(M, L, R, K, record, "H1", HS, sum(M.chs :* (rowsum(QH) + QG + QSHI)), p.hlink)
    _cge_put(M, L, R, K, record, "H2", EFF, (HS / p.hs0) :^ p.etah, p.etah :!= 0)
    // Days lost to illness (Section 15.2)
    _cge_put(M, L, R, K, record, "H3", DW, (1 :- p.sick :* ((HS / p.hs0) :^ p.epss)) :/ (1 :- p.sick0), p.ins)
    // Intermediate inputs and household purchases exist only where the SAM has a flow
    _cge_put(M, L, R, K, record, "Q5", QINT, p.ica :* QINTA', p.ica :!= 0)
    // Marketed output: home consumption does not reach the market (13.1)
    _cge_put(M, L, R, K, record, "Q6", QX, p.theta' * (QA - rowsum(QHA)), M.cx :* (1 :- M.cac))
    // Q6A: commodity output, a CES or Cobb-Douglas aggregate of the outputs of
    // its activities; Q6B: each activity's output of the commodity; P5A: each
    // activity's price (Section 17.3). Mata gives 0 * missing = missing, so
    // the CES branch uses an exponent of 1 for the other commodities.
    if (any(M.cac)) {
        rsac = (M.cac :* (1 :- M.cdac) :* p.rac + (1 :- M.cac :* (1 :- M.cdac)))'
        qxac = M.xac :* QXAC + (1 :- M.xac)
        sxac = colsum(M.xac :* p.dac :* (qxac :^ (-rsac)))
        lxac = colsum(M.xac :* p.dac :* ln(qxac))
        _cge_put(M, L, R, K, record, "Q6A", QX,
                 p.aac :* (M.cdac :* exp(lxac') + (1 :- M.cdac) :* ((sxac + (sxac :== 0)) :^ (-1 :/ rsac))'), M.cac)
        _cge_put(M, L, R, K, record, "Q6B", QXAC, p.theta :* (QA - rowsum(QHA)), M.xac)
        pxqx = (PX :* QX)'
        _cge_put(M, L, R, K, record, "P5A", M.cdac' :* (PXAC :* QXAC) + (1 :- M.cdac') :* PXAC,
                 M.cdac' :* (p.dac :* pxqx) +
                 (1 :- M.cdac') :* ((pxqx :/ (sxac + (sxac :== 0))) :* p.dac :* (qxac :^ (-rsac :- 1))), M.xac)
    }
    else {
        _cge_put(M, L, R, K, record, "Q6A", J(M.nC, 1, 0), J(M.nC, 1, 0), J(M.nC, 1, 0))
        _cge_put(M, L, R, K, record, "Q6B", J(M.n, M.nC, 0), J(M.n, M.nC, 0), J(M.n, M.nC, 0))
        _cge_put(M, L, R, K, record, "P5A", J(M.n, M.nC, 0), J(M.n, M.nC, 0), J(M.n, M.nC, 0))
    }

    // 5.3 Trade block
    _cge_put(M, L, R, K, record, "T1", QX,
             p.at :* (p.dt :* (QE :^ p.rt) + p.dtc :* (QD :^ p.rt)) :^ (1 :/ p.rt), M.ce :* (1 :- M.cxe))
    _cge_put(M, L, R, K, record, "T2", QE,
             QD :* (((PE :/ PD) :* p.dtc :/ p.dt) :^ (1 :/ (p.rt :- 1))), M.ce :* (1 :- M.cxe))
    _cge_put(M, L, R, K, record, "T3", QX, QD, M.cx :* (1 :- M.ce))
    _cge_put(M, L, R, K, record, "T3E", QX, QE, M.cxe)
    _cge_put(M, L, R, K, record, "T4", QQ,
             p.aq :* (p.dq :* (QM :^ (-p.rq)) + p.dqc :* (QD :^ (-p.rq))) :^ (-1 :/ p.rq), M.cm :* M.cdo)
    _cge_put(M, L, R, K, record, "T5", QM,
             QD :* (((PDD :/ PM) :* p.dq :/ p.dqc) :^ (1 :/ (1 :+ p.rq))), M.cm :* M.cdo)
    _cge_put(M, L, R, K, record, "T6", QQ, p.aq :* QD, M.cdo :* (1 :- M.cm))
    _cge_put(M, L, R, K, record, "T7", QQ, p.aq :* QM, M.cm :* (1 :- M.cdo))
    _cge_put(M, L, R, K, record, "T8", QT, p.icm * QQ + p.icd * QD + p.ici * QM + p.ice * QE, M.ct)
    _cge_put(M, L, R, K, record, "T9", QER, p.qer :* ((PQ :/ (EXR :* p.pwe)) :^ (-p.st)), M.cr)
    _cge_put(M, L, R, K, record, "T10", QE, p.qe0 :* ((PWE :/ p.pwe) :^ (-p.etae)), M.ced)

    // 5.4 Institution block. DY is income after direct taxes and savings.
    DY = (1 :- MPS) :* (1 :- TINS) :* YI
    // Rents by recipient: factors, households and enterprises, government,
    // rest of the world (Section 16.1)
    rent = _cge_rentvec(M, p, RM, RE, RA, QM, QE, PA, QA, pwe, EXR)
    _cge_put(M, L, R, K, record, "I1", YF, rowsum(wage :* QF) + p.trfr :* EXR + rent[|1 \ M.nF|], oneF)
    // Health insurance contributions are taken before factor income is distributed
    yif = p.shif :* ((1 :- p.tshi :- p.tfy) :* YF)'
    if (M.ishi) yif[M.nI, .] = (p.tshi :* YF)'
    _cge_put(M, L, R, K, record, "I2", YIF, yif, J(M.nI, M.nF, 1))
    _cge_put(M, L, R, K, record, "I3", YI,
             rowsum(YIF[|1, 1 \ nD, M.nF|]) + p.shii * DY + p.trdg :* CPI + p.trdr :* EXR
             + p.hold :* (p.rd * p.ddebt) + rent[|M.nF + 1 \ M.nF + nD|], oneD)
    _cge_put(M, L, R, K, record, "I4", EH, p.hc :* DY[|1 \ nH|], oneH)
    // Supernumerary spending, counting home goods at PA (13.1)
    SN = EH' - PH' * p.gamma - PA' * p.gammah
    _cge_put(M, L, R, K, record, "I5", PH :* QH, PH :* p.gamma + p.beta :* SN, p.beta :!= 0)
    _cge_put(M, L, R, K, record, "I5H", PA :* QHA, PA :* p.gammah + p.betah :* SN, p.betah :!= 0)
    _cge_put(M, L, R, K, record, "I6", QINV, p.qinv :* IADJ, oneC)
    _cge_put(M, L, R, K, record, "I7", QG, p.qg :* GADJ, oneC)
    _cge_put(M, L, R, K, record, "I8", YG,
             TINS' * YI + sum(tq :* PQ :* QQ) + sum(tm :* p.pwm :* QM) * EXR
             + sum(p.te :* pwe :* QE) * EXR + sum(p.ta :* PA :* QA)
             + sum(tv :* PQ :* (rowsum(QH) + QG + QINV + QSHI + rowsum(QINT :* (1 :- p.kappa)')))
             + sum(YIF[nD + 1, .]) + p.trgr * EXR + p.trgg * CPI + rent[M.nF + nD + 1]
             + sum(p.tf :* wage :* QF) + p.tfy' * YF, 1)
    _cge_put(M, L, R, K, record, "I9", EG,
             PH' * QG + (sum(p.trdg) + p.trgg + p.trshi) * CPI + p.trrg * EXR
             + p.rd * p.ddebt + p.rf * p.fdebt * EXR, 1)
    _cge_put(M, L, R, K, record, "I10", TINS, p.tins0 :* TINSADJ, oneD)
    _cge_put(M, L, R, K, record, "I11", MPS, p.mps0 :* MPSADJ, oneD)
    // Health insurance fund (from version 0.1.13); the last institution
    _cge_put(M, L, R, K, record, "I12", YSHI,
             (M.ishi ? sum(YIF[M.nI, .]) : 0) + p.trshi * CPI + p.trshir * EXR, (M.ishi > 0))
    _cge_put(M, L, R, K, record, "I13", QSHI, p.qshi :* SHIADJ, M.cshi)
    _cge_put(M, L, R, K, record, "I14", PH' * QSHI, (1 - p.sshi) * YSHI, (M.ishi > 0))

    // Labour-market regimes (Section 14): the wage curve (L1) and the smoothed
    // minimum-wage condition (L2), inert unless the closure fixes their slack
    unemp = 1 :- QFS :/ p.qlf
    rwage = W :/ CPI
    _cge_put(M, L, R, K, record, "L1", rwage, p.wref :* ((unemp :/ p.u0) :^ (-p.epsw)) + LSW, p.inlf)
    ub = rwage :/ p.wmin :- 1
    _cge_put(M, L, R, K, record, "L2", unemp + ub - sqrt(unemp :^ 2 + ub :^ 2 :+ 2 * p.mu), LSM, p.inlf)

    // 5.5 System constraints (S6 is imposed through the closure)
    _cge_put(M, L, R, K, record, "S1", rowsum(M.fa :* QF), QFS, oneF)
    _cge_put(M, L, R, K, record, "S2", QQ,
             rowsum(QINT) + rowsum(QH) + QG + QINV + M.ct :* QT + M.cr :* QER + QSHI, M.cq)
    _cge_put(M, L, R, K, record, "S3",
             sum(p.pwm :* QM) + (sum(YIF[nD + 2, .]) + p.shir' * DY) / EXR + p.trrg + p.rf * p.fdebt
             + rent[M.nF + nD + 2] / EXR,
             sum(pwe :* QE) + sum(M.cr :* PQ :* QER) / EXR + sum(p.trdr) + sum(p.trfr) + p.trgr
             + p.trshir + FSAV, 1)
    _cge_put(M, L, R, K, record, "S4", YG, EG + GSAV, 1)
    _cge_put(M, L, R, K, record, "S5", (MPS :* (1 :- TINS))' * YI + GSAV + p.sshi * YSHI + EXR * FSAV,
             PH' * QINV + WALRAS, 1)

    // Bounds and complementarity (Section 16.2): one row per constraint
    _cge_put(M, L, R, K, record, "B1", _cge_bres(M, p, x), J(rows(M.bY), 1, 0), J(rows(M.bY), 1, 1))

    // User equations (Section 19)
    _cge_u_eval(M, p, x, ul, ur)
    _cge_put(M, L, R, K, record, "U", ul, ur, J(rows(ul), 1, 1))
    // built-in equation elements that user equations replace leave the
    // system (from version 0.9.3)
    if (record) M.erep = _cge_u_reprows(M, K)
    if (rows(M.erep)) K[M.erep] = J(rows(M.erep), 1, 0)
}

// The domain of a built-in equation block that a user equation may replace
// (from version 0.9.3), as set codes: "" for a block without an index, "-"
// for a block that cannot be replaced. Blocks with exact derivatives of their
// own (P7, P8, P9, I1, I8, I9, S1, S2, S3, S5), the constraints and the user
// equations cannot be replaced.
string scalar _cge_blockdom(string scalar b)
{
    string scalar set, desc
    if (anyof(("P7", "P8", "P9", "I1", "I8", "I9", "S1", "S2", "S3", "S5", "B1", "U"), b)) return("-")
    // the domains of the blocks, as in the equation labels (from version 0.9.5)
    _cge_eqinfo(b, set, desc)
    return(set == "?" ? "-" : set)
}

// replace(BLOCK) or replace(BLOCK(e1[,e2])) of cge_equation (from version
// 0.9.3), checked against the domain of the equation: an equation with an
// index replaces the elements of the block with the labels of its own; one
// without, the block without an index or the element given. Returns the
// block, with the element when given.
string scalar _cge_u_repcheck(struct cge_model scalar M, string scalar rep, string scalar idx, string scalar set)
{
    string scalar b, dom, s1, s2, u1, u2, els
    string rowvector el, iv
    string colvector lb, lu
    real scalar nb, nu, k, c, r, nidx
    if (!regexm(strtrim(rep), "^([A-Za-z][A-Za-z0-9]*)[ ]*(\((.*)\))?$")) {
        _cge_fail("replace(): give an equation block, as replace(I7) or replace(I7(com_ser))", 198)
    }
    b = strupper(regexs(1))
    els = (strpos(rep, "(") ? strtrim(regexs(3)) : "")
    dom = _cge_blockdom(b)
    if (dom == "-") {
        if (anyof(M.ename, b)) {
            _cge_fail("replace(): equation block " + b + " cannot be replaced: it has exact derivatives of its own, or is a constraint or a user equation", 198)
        }
        _cge_fail("replace(): " + b + " is not an equation block of the model (model_spec.md, Section 5)", 198)
    }
    _cge_setparts(dom, s1, s2)
    nb = (s1 != "") + (s2 != "")
    if (els != "") {
        el = tokens(els, ",")
        el = strtrim(select(el, el :!= ","))
        if (cols(el) != nb) _cge_fail("replace(): block " + b + " has " + strofreal(nb) + " index(es); " + strofreal(cols(el)) + " given", 198)
        // an index of the equation in place of a label (from version 0.11.0),
        // as replace(Q4(lab, a)): its elements, within the block's set
        iv = J(1, 0, "")
        if (idx != "") {
            iv = tokens(idx, ",")
            iv = strtrim(select(iv, iv :!= ","))
        }
        _cge_setparts(set, u1, u2)
        nidx = 0
        for (k = 1; k <= nb; k++) {
            lb = _cge_setlab(M, (k == 1 ? s1 : s2))
            c = 0
            if (cols(iv)) c = _cge_find(iv', el[k])
            if (c) {
                lu = _cge_setlab(M, (c == 1 ? u1 : u2))
                for (r = 1; r <= rows(lu); r++) {
                    if (!anyof(lb, lu[r])) _cge_fail("replace(): " + lu[r] + " is not an element of block " + b + "; the indexes of the equation must run over its sets", 198)
                }
                el[k] = "#" + strofreal(c)
                nidx++
            }
            else if (!anyof(lb, el[k])) _cge_fail("replace(): " + el[k] + " is not an element of block " + b, 111)
        }
        if (cols(iv) & nidx != cols(iv)) {
            _cge_fail("replace(): an equation with an index replaces elements that follow it: write replace(" + b + "), or the index in place of a label, as replace(Q4(lab, a))", 198)
        }
        return(b + "(" + invtokens(el, ",") + ")")
    }
    _cge_setparts(set, u1, u2)
    nu = (u1 != "") + (u2 != "")
    if (nu != nb) {
        if (nu == 0) _cge_fail("replace(): block " + b + " has " + strofreal(nb) + " index(es): give the element, as replace(" + b + "(label)), or an index to the equation", 198)
        _cge_fail("replace(): block " + b + " has " + strofreal(nb) + " index(es); the equation has " + strofreal(nu), 198)
    }
    // the sets of the equation's indexes are within those of the block
    if (nu >= 1) {
        lb = _cge_setlab(M, s1)
        lu = _cge_setlab(M, u1)
        for (k = 1; k <= rows(lu); k++) {
            if (!anyof(lb, lu[k])) _cge_fail("replace(): " + lu[k] + " is not an element of block " + b + "; the indexes of the equation must run over its sets", 198)
        }
    }
    if (nu == 2) {
        lb = _cge_setlab(M, s2)
        lu = _cge_setlab(M, u2)
        for (k = 1; k <= rows(lu); k++) {
            if (!anyof(lb, lu[k])) _cge_fail("replace(): " + lu[k] + " is not an element of block " + b + "; the indexes of the equation must run over its sets", 198)
        }
    }
    return(b)
}

// The built-in element that element (e1, e2) of a user equation replaces
// (from version 0.9.3): block and labels
string rowvector _cge_u_repel(string scalar spec, string scalar e1, string scalar e2)
{
    string rowvector el
    real scalar c, k
    c = strpos(spec, "(")
    if (!c) return((spec, e1, e2))
    el = tokens(substr(spec, c + 1, strlen(spec) - c - 1), ",")
    el = select(el, el :!= ",")
    // an index of the equation (from version 0.11.0): its element
    for (k = 1; k <= cols(el); k++) {
        if (el[k] == "#1") el[k] = e1
        else if (el[k] == "#2") el[k] = e2
    }
    return((substr(spec, 1, c - 1), (cols(el) >= 1 ? el[1] : ""), (cols(el) >= 2 ? el[2] : "")))
}

// Rows of the built-in equation elements that user equations replace (from
// version 0.9.3), from the blocks just recorded; each must be in the model
// (K) and be replaced once
real colvector _cge_u_reprows(struct cge_model scalar M, real colvector K)
{
    real colvector r, bo
    real scalar k, g, i, j, n1, n2
    string scalar dom, s1, s2
    string colvector l1, l2
    if (rows(M.urep) == 0 | cols(M.urep) < 3) return(J(0, 1, .))
    bo = runningsum(M.elen) - M.elen
    r = J(rows(M.urep), 1, .)
    for (k = 1; k <= rows(M.urep); k++) {
        g = _cge_find(M.ename, M.urep[k, 1])
        dom = _cge_blockdom(M.urep[k, 1])
        if (!g | dom == "-") _cge_fail("cge internal error: block " + M.urep[k, 1] + " cannot be replaced", 3498)
        _cge_setparts(dom, s1, s2)
        i = j = n1 = n2 = 1
        if (s1 != "") {
            l1 = _cge_setlab(M, s1)
            n1 = rows(l1)
            i = _cge_find(l1, M.urep[k, 2])
        }
        if (s2 != "") {
            l2 = _cge_setlab(M, s2)
            n2 = rows(l2)
            j = _cge_find(l2, M.urep[k, 3])
        }
        if (M.elen[g] != n1 * n2) _cge_fail("cge internal error: block " + M.urep[k, 1] + " does not have the domain " + dom, 3498)
        if (!i | !j) _cge_fail("replace(): " + M.urep[k, 1] + "(" + M.urep[k, 2] + (M.urep[k, 3] != "" ? "," + M.urep[k, 3] : "") + ") is not an element of the block", 111)
        r[k] = bo[g] + (i - 1) * n2 + j
        if (!K[r[k]]) {
            _cge_fail("replace(): " + M.urep[k, 1] + (M.urep[k, 2] != "" ? "(" + M.urep[k, 2] + (M.urep[k, 3] != "" ? "," + M.urep[k, 3] : "") + ")" : "") +
                      " is not an equation of the model, so it cannot be replaced", 459)
        }
    }
    if (rows(uniqrows(r)) != rows(r)) _cge_fail("replace(): an equation element is replaced by two user equations", 459)
    return(r)
}

// Rents by recipient (Section 16.1): factors, households and enterprises,
// the government and the rest of the world
real colvector _cge_rentvec(struct cge_model scalar M, struct cge_par scalar p, real colvector RM,
                            real colvector RE, real colvector RA, real colvector QM, real colvector QE,
                            real colvector PA, real colvector QA, real colvector pwe, real scalar EXR)
{
    real colvector out, vm, ve, va
    real scalar k
    out = J(M.nF + M.nD + 2, 1, 0)
    vm = RM :* p.pwm :* QM * EXR
    ve = RE :* pwe :* QE * EXR
    va = RA :* PA :* QA
    for (k = 1; k <= M.nC; k++) {
        if (vm[k] != 0) out[p.rrm[k]] = out[p.rrm[k]] + vm[k]
        if (ve[k] != 0) out[p.rre[k]] = out[p.rre[k]] + ve[k]
    }
    for (k = 1; k <= M.n; k++) if (va[k] != 0) out[p.rra[k]] = out[p.rra[k]] + va[k]
    return(out)
}

// Residuals of the constraints (Section 16.2): g = sigma (b - Y) / sY, the
// distance of the limited variable within its bound, and h = delta (X - xbar) /
// sX, the move of the adjusting variable in its direction; smoothed
// Fischer-Burmeister (regime 1), g (binding, 2), h (not binding, 3; or no
// constraint, 0) or, from version 0.14.0, the Fischer-Burmeister function
// itself (4), which the semismooth Newton method solves
real colvector _cge_bres(struct cge_model scalar M, struct cge_par scalar p, real colvector x)
{
    real colvector g, h
    if (rows(M.bY) == 0) return(J(0, 1, .))
    g = M.btype :* (p.bval - x[M.bY]) :/ M.xscale[M.bY]
    h = M.bdir :* (x[M.bX] - p.bxbar) :/ M.xscale[M.bX]
    return((p.bmode :== 1) :* (g + h - sqrt(g :^ 2 + h :^ 2 :+ 2 * p.bmu)) + (p.bmode :== 2) :* g +
           ((p.bmode :== 0) :| (p.bmode :== 3)) :* h + (p.bmode :== 4) :* (g + h - sqrt(g :^ 2 + h :^ 2)))
}

// Scaled residuals of the existing equation elements. Mata's sum functions
// treat missing values as zero, so points with non-positive prices or
// quantities are rejected explicitly.
real colvector _cge_resid(struct cge_model scalar M, struct cge_par scalar p, real colvector x)
{
    real colvector L, R, K
    if (min(x[M.positive]) <= 0 | hasmissing(x)) return(J(M.neq, 1, .))
    _cge_eq(M, p, x, L, R, K, 0)
    return(select((L - R) :/ M.escale, M.emask))
}

real scalar _cge_maxres(struct cge_model scalar M, struct cge_par scalar p, real colvector x)
{
    real colvector r
    r = _cge_resid(M, p, x)
    if (hasmissing(r)) return(.)
    return(max(abs(r)))
}

// The largest scaled residual of the model's own equations, or (user 1) of
// the user equations (from version 0.7.1): a user equation need not hold at
// the base, where it acts as a shock, so benchmark replication leaves them out
real scalar _cge_maxres_part(struct cge_model scalar M, struct cge_par scalar p, real colvector x, real scalar user)
{
    real colvector r, isu, bo, sel
    real scalar g
    r = _cge_resid(M, p, x)
    if (hasmissing(r)) return(.)
    isu = J(rows(M.emask), 1, 0)
    g = _cge_find(M.ename, "U")
    bo = runningsum(M.elen) - M.elen
    if (g & M.elen[g]) isu[|bo[g] + 1 \ bo[g] + M.elen[g]|] = J(M.elen[g], 1, 1)
    sel = _cge_which(select(isu, M.emask) :== user)
    if (rows(sel) == 0) return(0)
    return(max(abs(r[sel])))
}

// =====================================================================
// Calibration (model_spec.md, Section 7)
// =====================================================================

void _cge_calibrate(string scalar s_va, string scalar s_q, string scalar s_t, string scalar fqname,
                    string scalar s_ie, string scalar s_fr, string scalar s_a, string scalar s_hc,
                    string scalar s_hf, string scalar s_he, | string scalar s_vc, string scalar s_debt,
                    string scalar s_int, string scalar s_hold, string scalar s_borrow,
                    string scalar s_xo, string scalar s_ed, string scalar s_un, string scalar s_wc,
                    string scalar s_mw, string scalar s_mu, string scalar s_sick, string scalar s_sickel,
                    string scalar s_mort, string scalar s_mortel, string scalar s_nest, string scalar s_nsig,
                    string scalar s_ac)
{
    struct cge_model scalar M
    struct cge_par scalar p
    real matrix S, VA, QINT0, QF0, QFq, WFD0, dva, YIF0, QH0, w, TR, MAKE0, MG, SV, TF
    real colvector TFY
    real colvector sva, sq, st, QM0, cm, tariffs, tm, exports, ce, etax, te, QE0, pwe
    real colvector cx, ct, MGc, QT0, exported, cr, QER0, QSHI0, iI
    real rowvector spend
    real colvector QA0, ta, QX0, QD0, PM0, stax, QQ0, tq, demand, QINTA0, W0, QVA0
    real colvector cd, rva, ad, rt, dt, dtc, at, rq, dq, dqc, aq, YF0, YI0, tins0, mps0, EH0
    real colvector iD, dtax, dsav, DY0, TROW, cons, gross, safe
    real colvector m, d, x0, L, R, K, mag
    real matrix VINT, VH
    real colvector kappa, vg, vinv, vshi, vat, tv, PINTA0
    real matrix HOME0, share
    real colvector QAM0, cxe, ced, cdo, cq, eqo, netx, EMc, DMc, IMc, MGq, PDD0, etae, sel, cand
    real matrix VE, VN0
    real colvector mc, mn, pr, qq, vv
    real scalar nT, g, eff
    real scalar n, nC, nF, nH, tol, k, r, ratio, total, maxres, YSHI0

    M = _cge_load()
    _cge_need(M, "sam")
    _cge_need(M, "mapped")
    // The options of this calibration, so that cge_sensitivity can repeat it
    // with other elasticities
    M.calargs = (s_va, s_q, s_t, fqname, s_ie, s_fr, s_a, s_hc, s_hf, s_he, s_vc, s_debt, s_int,
                 s_hold, s_borrow, s_xo, s_ed, s_un, s_wc, s_mw, s_mu, s_sick, s_sickel, s_mort, s_mortel,
                 s_nest, s_nsig, s_ac)
    S = M.S
    n = M.n
    nC = M.nC
    nF = M.nF
    nH = M.nH
    tol = 1e-9 * max((1, max(abs(S))))

    sva = _cge_elast(s_va, n, "sigmava")
    sq = _cge_elast(s_q, nC, "sigmaq")
    st = _cge_elast(s_t, nC, "sigmat")

    // 7.2 Taxes and trade
    QM0 = _cge_sub(S, M.irow, M.iC)'
    cm = QM0 :> tol
    tariffs = _cge_sub(S, M.iimptax, M.iC)'
    _cge_fail_if((1 :- cm) :* (abs(tariffs) :> tol), M.labels[M.iC], "import tariff recorded on a commodity without imports", 459)
    tm = cm :* tariffs :/ (cm :* QM0 + (1 :- cm))
    exports = _cge_sub(S, M.iC, M.irow)
    exported = exports :> tol
    etax = _cge_sub(S, M.iexptax, M.iC)'
    _cge_fail_if((1 :- exported) :* (abs(etax) :> tol), M.labels[M.iC], "export tax recorded on a commodity without exports", 459)

    QA0 = colsum(S[., M.iA])'
    _cge_fail_if(QA0 :<= tol, M.labels[M.iA], "every activity needs positive output", 459)
    ta = _cge_sub(S, M.iacttax, M.iA)' :/ QA0
    MAKE0 = _cge_sub(S, M.iA, M.iC)                 // MAKE0[a, c]: output of c by a
    HOME0 = _cge_sub(S, M.iA, M.iH)                 // HOME0[a, h]: home consumption (13.1)
    if (max(abs(rowsum(MAKE0) + rowsum(HOME0) - QA0)) > tol) {
        _cge_fail("activity output does not equal its sales to commodities and home consumption", 459)
    }
    _cge_fail_if(rowsum(HOME0 :< -tol), M.labels[M.iA], "negative home consumption of the output of", 459)
    QAM0 = QA0 - rowsum(HOME0)
    _cge_fail_if(QAM0 :<= tol, M.labels[M.iA], "an activity needs some marketed output; all the output is consumed at home by", 459)
    p.theta = MAKE0 :/ QAM0
    QX0 = colsum(MAKE0)'
    cx = QX0 :> tol
    _cge_fail_if((1 :- cx) :* (1 :- cm), M.labels[M.iC], "a commodity has neither domestic output nor imports", 459)
    // Margins: MG[t, c] paid by commodity c to margin account t, SV[c, t]
    // margin services c bought by t; by market from version 0.3.2 (13.4)
    nT = rows(M.iT)
    if (nT) {
        MG = _cge_sub(S, M.iT, M.iC)
        SV = _cge_sub(S, M.iC, M.iT)
        QT0 = rowsum(SV)
        spend = colsum(SV)
        share = SV :/ (spend :* (spend :> tol) + (spend :<= tol))
    }
    else {
        MG = J(0, nC, 0)
        SV = J(nC, 0, 0)
        QT0 = J(nC, 1, 0)
        spend = J(1, 0, 0)
        share = J(nC, 0, 0)
    }
    if (rows(M.tmkt) != nT) M.tmkt = J(nT, 1, 0)
    MGq = (nT ? colsum(MG :* (M.tmkt :== 0))' : J(nC, 1, 0))
    DMc = (nT ? colsum(MG :* (M.tmkt :== 1))' : J(nC, 1, 0))
    IMc = (nT ? colsum(MG :* (M.tmkt :== 2))' : J(nC, 1, 0))
    EMc = (nT ? colsum(MG :* (M.tmkt :== 3))' : J(nC, 1, 0))
    // Export-only commodities (13.3), chosen with exportonly()
    cxe = J(nC, 1, 0)
    if (s_xo != "") {
        sel = _cge_elements(M.C, s_xo, "commodities")
        cxe[sel] = J(rows(sel), 1, 1)
    }
    netx = exports - etax - EMc
    eqo = exported :* cx :* (abs(QX0 - netx) :<= tol)
    _cge_fail_if(cxe :* (1 :- eqo), M.labels[M.iC],
                 "exportonly(): exports, net of export taxes and margins, must equal domestic output for", 459)
    // Exports at least as large as domestic output are drawn from composite
    // supply (CR, T9); other exports come from domestic output (CE, T1-T2)
    cr = exported :* ((QX0 - (exports - etax)) :<= tol) :* (1 :- cxe)
    _cge_fail_if(cr :* (abs(etax) :> tol), M.labels[M.iC],
                 "export tax recorded on a commodity whose exports are at least its domestic output (give it in exportonly() if all its output is exported)", 459)
    _cge_fail_if(cr :* (abs(EMc) :> tol), M.labels[M.iC],
                 "export margins recorded on a commodity whose exports are drawn from composite supply", 459)
    ce = exported :* (1 :- cr)
    te = ce :* etax :/ (ce :* exports + (1 :- ce))
    QE0 = ce :* netx
    QER0 = cr :* exports
    pwe = ce :* (exports :/ (QE0 + (1 :- ce))) + (1 :- ce) :* (1 :/ (1 :- te))
    cdo = cx :* (1 :- cxe)
    QD0 = cdo :* (QX0 - QE0)
    _cge_fail_if(cdo :* (QD0 :<= tol), M.labels[M.iC],
                 "a commodity with domestic output needs positive domestic sales (unless all its output is exported: see exportonly())", 459)
    _cge_fail_if((abs(DMc) :> tol) :* (QD0 :<= tol), M.labels[M.iC], "margins on domestic sales recorded on a commodity without domestic sales", 459)
    _cge_fail_if((abs(IMc) :> tol) :* (QM0 :<= tol), M.labels[M.iC], "margins on imports recorded on a commodity without imports", 459)
    _cge_fail_if((abs(EMc) :> tol) :* (QE0 :<= tol), M.labels[M.iC], "margins on exports recorded on a commodity without exports", 459)
    if (nT) {
        p.icd = (share * (MG :* (M.tmkt :== 1))) :/ (QD0' + (QD0' :<= tol))
        p.ici = (share * (MG :* (M.tmkt :== 2))) :/ (QM0' + (QM0' :<= tol))
        p.ice = (share * (MG :* (M.tmkt :== 3))) :/ (QE0' + (QE0' :<= tol))
    }
    else {
        p.icd = J(nC, nC, 0)
        p.ici = J(nC, nC, 0)
        p.ice = J(nC, nC, 0)
    }
    PM0 = cm :* (1 :+ tm :+ colsum(p.ici)')
    PDD0 = 1 :+ colsum(p.icd)'
    stax = _cge_sub(S, M.isaltax, M.iC)'
    QQ0 = PDD0 :* QD0 + PM0 :* QM0 + stax + MGq
    cq = cdo :| cm
    tq = cq :* stax :/ (cq :* QQ0 + (1 :- cq))
    ct = QT0 :> tol
    if (nT) p.icm = (share * (MG :* (M.tmkt :== 0))) :/ (cq' :* QQ0' + (1 :- cq'))
    else p.icm = J(nC, nC, 0)
    // Export demand (13.2): finite elasticities for the commodities given
    etae = J(nC, 1, 0)
    if (s_ed != "") {
        if (!strpos(s_ed, ":") & cols(tokens(s_ed)) == 1) etae = ce :* strtoreal(s_ed)
        else {
            sel = J(0, 1, .)
            etae = _cge_values(s_ed, M.C, 0, "exportdemand")
        }
        _cge_fail_if((etae :!= 0) :* (1 :- ce), M.labels[M.iC], "exportdemand(): no exports from domestic output for", 459)
        if (hasmissing(etae) | min(etae) < 0) _cge_fail("exportdemand() elasticities must be positive", 198)
    }
    ced = (etae :> 0)
    // Commodities whose exports equal domestic output, which could be export-only
    cand = eqo :* (1 :- cxe)
    if (any(cand)) {
        printf("{txt}Note: exports equal domestic output for {res}%s{txt}; give exportonly() to export their output directly\n",
               invtokens(select(M.labels[M.iC], cand)'))
    }
    // VAT (model_spec.md, 12.2): rates from the VAT account, then the quantity
    // of each use at PQ = 1
    kappa = _cge_shares(s_vc, M.A, 1, "vatcredit")
    if (s_vc != "" & !(M.ivattax > 0 & M.ivattax < .)) _cge_fail("vatcredit() needs a VAT account: map one with cge_map, vattax() or vatshare()", 198)
    VINT = _cge_sub(S, M.iC, M.iA)
    VH = _cge_sub(S, M.iC, M.iH)
    vg = _cge_sub(S, M.iC, M.igov)
    vinv = _cge_sub(S, M.iC, M.isav)
    vshi = (M.ishi ? _cge_sub(S, M.iC, M.ishi) : J(nC, 1, 0))
    vat = ((M.ivattax > 0 & M.ivattax < .) ? _cge_sub(S, M.ivattax, M.iC)' : J(nC, 1, 0))
    tv = J(nC, 1, 0)
    for (k = 1; k <= nC; k++) {
        if (abs(vat[k]) <= tol) continue
        tv[k] = _cge_vat_rate(vat[k], (VINT[k, .], VH[k, .], vg[k], vinv[k], vshi[k])',
                              ((1 :- kappa)', J(1, nH + 3, 1))', M.labels[M.iC[k]])
    }
    QINT0 = VINT :/ (1 :+ tv * (1 :- kappa)')
    QH0 = VH :/ (1 :+ tv)
    QSHI0 = vshi :/ (1 :+ tv)
    p.qg = vg :/ (1 :+ tv)
    p.qinv = vinv :/ (1 :+ tv)
    demand = rowsum(QINT0) + rowsum(QH0) + p.qg + p.qinv + QT0 + QER0 + QSHI0
    if (max(abs(QQ0 - demand)) > tol) _cge_fail("composite supply does not equal domestic demand for some commodity", 459)

    // 7.3 Production. Commodities in a nest of value added leave
    // intermediate input (from version 0.5.1, Section 17.2)
    _cge_nests(M, p, s_nest, s_nsig)
    M.ecell = (M.nestc :> 0) :* (QINT0 :!= 0)
    QINTA0 = colsum((1 :- M.ecell) :* QINT0)'
    p.ica = ((1 :- M.ecell) :* QINT0) :/ (QINTA0' + (QINTA0' :<= 0))
    PINTA0 = colsum(p.ica :* (1 :+ tv * (1 :- kappa)'))'
    VA = _cge_sub(S, M.iF, M.iA)
    M.fa = VA :> tol
    if (fqname == "") {
        W0 = J(nF, 1, 1)
        WFD0 = J(nF, n, 1)
        QF0 = M.fa :* VA
    }
    else {
        QFq = st_matrix(fqname)
        if (rows(QFq) != nF | cols(QFq) != n) {
            errprintf("matrix %s must have %f rows (factors) and %f columns (activities)\n", fqname, nF, n)
            exit(503)
        }
        if (max(abs((QFq :> 0) - M.fa))) _cge_fail("factor quantities must be positive exactly where factor payments are", 459)
        W0 = rowsum(VA) :/ rowsum(QFq)
        WFD0 = M.fa :* (VA :/ (W0 :* QFq + (1 :- M.fa))) + (1 :- M.fa)
        QF0 = QFq
    }
    // Taxes on factor use (model_spec.md, 17.1; from version 0.5.0): rates on
    // factor payments by activity; value added at factor cost includes them
    TF = J(nF, n, 0)
    for (k = 1; k <= rows(M.iFT); k++) TF[M.ftf[k], .] = TF[M.ftf[k], .] + S[M.iFT[k], M.iA']
    _cge_fail_if(rowsum((abs(TF) :> tol) :* (1 :- M.fa)) :> 0, M.labels[M.iF], "a tax on factor use is recorded where the factor is not used", 459)
    p.tf = M.fa :* TF :/ (VA + (1 :- M.fa))
    // the commodities in nests, at the prices activities pay (PQ = 1)
    VE = M.ecell :* VINT
    QVA0 = colsum(VA + TF)' + colsum(VE)'
    _cge_fail_if(QVA0 :<= tol, M.labels[M.iA], "every activity needs positive value added", 459)
    p.iva = QVA0 :/ QA0
    p.inta = QINTA0 :/ QA0
    _cge_topnest(M, p, s_a, QA0, QVA0, QINTA0, PINTA0)
    _cge_outnest(M, p, s_ac, MAKE0, QX0, tol)

    cd = abs(sva :- 1) :< 1e-12
    rva = (1 :- cd) :* (1 :/ sva :- 1)
    dva = J(nF, n, 0)
    ad = J(n, 1, 0)
    w = W0 :* WFD0
    // Nests (Section 17.2): each is valued at its members' costs, at a price
    // of one; within it, shares follow from the members' prices and
    // quantities as at the top of value added
    VN0 = J(M.nN, n, 0)
    for (k = 1; k <= nF; k++) if (M.nestf[k]) VN0[M.nestf[k], .] = VN0[M.nestf[k], .] + M.fa[k, .] :* (VA[k, .] + TF[k, .])
    for (k = 1; k <= nC; k++) if (M.nestc[k]) VN0[M.nestc[k], .] = VN0[M.nestc[k], .] + VE[k, .]
    M.nn = VN0 :> tol
    if (M.nN) _cge_fail_if(rowsum(M.nn) :== 0, M.N, "a nest of value added is used by no activity", 459)
    p.dvn = J(M.nN, n, 0)
    p.an = J(M.nN, n, 1)
    p.dce = J(nC, n, 0)
    for (k = 1; k <= n; k++) {
        for (g = 1; g <= M.nN; g++) {
            if (!M.nn[g, k]) continue
            m = _cge_which(M.fa[., k] :* (M.nestf :== g))
            mc = _cge_which(M.ecell[., k] :* (M.nestc :== g))
            pr = (w[m, k] :* (1 :+ p.tf[m, k])) \ (1 :+ tv[mc] :* (1 - kappa[k]))
            qq = QF0[m, k] \ QINT0[mc, k]
            vv = (VA[m, k] + TF[m, k]) \ VE[mc, k]
            _cge_ces_shares(pr, qq, vv, VN0[g, k], p.rhn[g], M.cdn[g], d, eff)
            p.an[g, k] = eff
            if (rows(m)) dva[m, k] = d[|1 \ rows(m)|]
            if (rows(mc)) p.dce[mc, k] = d[|rows(m) + 1 \ rows(d)|]
        }
        m = _cge_which(M.fa[., k] :* (M.nestf :== 0))
        mn = (M.nN ? _cge_which(M.nn[., k]) : J(0, 1, .))
        pr = (w[m, k] :* (1 :+ p.tf[m, k])) \ J(rows(mn), 1, 1)
        qq = QF0[m, k] \ (rows(mn) ? VN0[mn, k] : J(0, 1, .))
        vv = (VA[m, k] + TF[m, k]) \ (rows(mn) ? VN0[mn, k] : J(0, 1, .))
        _cge_ces_shares(pr, qq, vv, QVA0[k], rva[k], cd[k], d, eff)
        ad[k] = eff
        if (rows(m)) dva[m, k] = d[|1 \ rows(m)|]
        if (rows(mn)) p.dvn[mn, k] = d[|rows(m) + 1 \ rows(d)|]
    }

    // 7.4 CET and Armington functions (base prices PD = PE = 1)
    rt = 1 :/ st :+ 1
    // 1 - delta is stored (dtc, dqc) rather than computed by subtraction, which
    // loses most significant digits when a share is close to one
    dt = J(nC, 1, 0.5)
    dtc = J(nC, 1, 0.5)
    at = J(nC, 1, 1)
    for (k = 1; k <= nC; k++) {
        if (!ce[k] | cxe[k]) continue
        r = rt[k]
        ratio = (QE0[k] / QD0[k])^(r - 1)
        dt[k] = 1 / (1 + ratio)
        dtc[k] = ratio / (1 + ratio)
        at[k] = QX0[k] / (dt[k] * QE0[k]^r + dtc[k] * QD0[k]^r)^(1 / r)
    }
    if (max(cm :* cdo :* (abs(sq :- 1) :< 1e-12))) _cge_fail("sigmaq must differ from 1 for imported commodities with domestic sales", 198)
    rq = 1 :/ sq :- 1
    dq = J(nC, 1, 0.5)
    dqc = J(nC, 1, 0.5)
    // non-imported commodities (T6) and commodities imported only (T7)
    aq = cdo :* (QQ0 :/ (QD0 + (1 :- cdo))) + (1 :- cdo) :* (cm :* (QQ0 :/ (QM0 + (1 :- cm))) + (1 :- cm))
    for (k = 1; k <= nC; k++) {
        if (!cm[k] | !cdo[k]) continue
        r = rq[k]
        ratio = (PM0[k] / PDD0[k]) * (QM0[k] / QD0[k])^(1 + r)
        dq[k] = ratio / (1 + ratio)
        dqc[k] = 1 / (1 + ratio)
        aq[k] = QQ0[k] / (dq[k] * QM0[k]^(-r) + dqc[k] * QD0[k]^(-r))^(-1 / r)
    }

    // 7.5 Institutions (D = households, then enterprises)
    iD = M.iH \ M.iE
    YF0 = rowsum(S[M.iF, .])
    iI = iD \ M.igov \ M.irow
    if (M.ishi) iI = iI \ M.ishi
    YIF0 = _cge_sub(S, iI, M.iF)
    // Taxes on factor income (from version 0.5.0), taken before distribution
    TFY = ((M.iFY > 0 & M.iFY < .) ? S[M.iFY, M.iF']' : J(nF, 1, 0))
    p.tfy = TFY :/ YF0
    if (max(abs(colsum(YIF0)' + TFY - YF0)) > tol) _cge_fail("factor income paid out does not equal factor income received", 459)
    // Health insurance contributions as a rate on factor income
    if (M.ishi) {
        p.tshi = YIF0[M.nI, .]' :/ (YF0 + (YF0 :== 0))
        if (max(p.tshi + p.tfy) >= 1) _cge_fail("health insurance contributions and taxes take all the income of a factor", 459)
    }
    else p.tshi = J(nF, 1, 0)
    p.shif = YIF0 :/ ((1 :- p.tshi :- p.tfy) :* YF0)'
    if (M.ishi) p.shif[M.nI, .] = J(1, nF, 0)
    p.trfr = _cge_sub(S, M.iF, M.irow)
    YI0 = rowsum(S[iD, .])
    dtax = _cge_sub(S, M.idirtax, iD)'
    dsav = _cge_sub(S, M.isav, iD)'
    tins0 = dtax :/ YI0
    mps0 = dsav :/ ((1 :- tins0) :* YI0)
    DY0 = YI0 - dtax - dsav
    TR = _cge_sub(S, iD, iD)
    TROW = _cge_sub(S, M.irow, iD)'
    EH0 = colsum(VH)' + colsum(HOME0)'
    cons = EH0 \ J(M.nE, 1, 0)
    gross = colsum(abs(TR))' + abs(TROW) + abs(cons)
    if (max((abs(DY0) :<= tol) :* (gross :> tol))) {
        _cge_fail("an institution makes transfers or consumes but has no income after direct taxes and savings", 459)
    }
    if (max(abs(colsum(TR)' + TROW + cons - DY0)) > tol) _cge_fail("institution payments do not equal income", 459)
    safe = DY0 :* (abs(DY0) :> tol) + (abs(DY0) :<= tol)
    p.shii = TR :/ safe'
    p.shir = TROW :/ safe
    p.hc = EH0 :/ safe[|1 \ nH|]
    if (sum(EH0) <= tol) _cge_fail("households have no consumption", 459)
    p.beta = VH :/ (EH0' :* (EH0' :> 0) + (EH0' :<= 0))
    p.betah = HOME0 :/ (EH0' :* (EH0' :> 0) + (EH0' :<= 0))
    p.gammah = J(rows(HOME0), cols(HOME0), 0)
    // Household demand: Cobb-Douglas (gamma = 0), or LES given income
    // elasticities and Frisch parameters (model_spec.md, 7.5)
    p.gamma = J(rows(QH0), cols(QH0), 0)
    if (s_ie != "" | s_fr != "") _cge_les(p, QH0, EH0, s_ie, s_fr, M.nC, nH, 1 :+ tv, HOME0)
    p.trdg = _cge_sub(S, iD, M.igov)
    p.trdr = _cge_sub(S, iD, M.irow)
    p.trgr = S[M.igov, M.irow]
    p.trrg = S[M.irow, M.igov]
    p.trgg = S[M.igov, M.igov]
    // Health insurance fund: purchases, savings rate and transfers received
    p.qshi = QSHI0
    YSHI0 = (M.ishi ? sum(S[M.ishi, .]) : 0)
    if (M.ishi & YSHI0 <= tol) _cge_fail("the health insurance fund has no revenue", 459)
    p.sshi = (M.ishi ? S[M.isav, M.ishi] / YSHI0 : 0)
    p.trshi = (M.ishi ? S[M.ishi, M.igov] : 0)
    p.trshir = (M.ishi ? S[M.ishi, M.irow] : 0)
    M.cshi = (QSHI0 :!= 0)
    _cge_health(M, p, QH0, QSHI0, s_hc, s_hf, s_he, s_sick, s_sickel, s_mort, s_mortel)
    p.cwts = rowsum(VH) :/ sum(VH) :/ (1 :+ tv)
    p.dwts = QD0 :/ sum(QD0)

    p.pwm = J(nC, 1, 1)
    p.qer = QER0
    p.pwe = pwe
    p.tm = tm
    p.te = te
    p.tq = tq
    p.ta = ta
    p.ad = ad
    p.dva = dva
    p.rva = rva
    p.sva = sva
    p.at = at
    p.dt = dt
    p.dtc = dtc
    p.rt = rt
    p.aq = aq
    p.dq = dq
    p.dqc = dqc
    p.rq = rq
    p.sq = sq
    p.st = st
    p.tins0 = tins0
    p.mps0 = mps0
    p.tv = tv
    p.kappa = kappa
    p.etae = etae
    p.qe0 = QE0
    M.cxe = cxe
    M.ced = ced
    M.cdo = cdo
    M.cq = cq
    // Public debt (model_spec.md, 12.3): interest separated from government transfers
    _cge_debt(M, p, s_debt, s_int, s_hold, s_borrow, tol)
    // Labour force, wage curve and minimum wage (model_spec.md, Section 14)
    _cge_labour(M, p, s_un, s_wc, s_mw, s_mu, W0, p.cwts' * (1 :+ tv), rowsum(QF0))
    M.ce = ce
    M.cm = cm
    M.cd = cd
    M.cx = cx
    M.ct = ct
    M.cr = cr
    // Rents go to the government unless a constraint names another recipient;
    // there are no constraints after calibration (Section 16)
    p.rrm = J(nC, 1, M.nF + M.nD + 1)
    p.rre = J(nC, 1, M.nF + M.nD + 1)
    p.rra = J(n, 1, M.nF + M.nD + 1)
    p.bmode = J(0, 1, .)
    p.bval = J(0, 1, .)
    p.bxbar = J(0, 1, .)
    p.bmu = 1e-8
    M.bY = J(0, 1, .)
    M.bX = J(0, 1, .)
    M.btype = J(0, 1, .)
    M.bdir = J(0, 1, .)
    M.swfix = J(0, 1, .)
    M.swfree = J(0, 1, .)
    // user parameters keep their base values (from version 0.7.1)
    p.upval = (rows(M.updef) ? M.p0.upval : J(0, 1, .))
    M.p0 = p
    M.p = p

    // Base values of all variables
    _cge_layout(M)
    k = rows(M.voff)
    total = M.voff[k] + M.vrows[k] * M.vcols[k]
    x0 = J(total, 1, 0)
    _cge_setv(M, x0, "PA", J(n, 1, 1))
    _cge_setv(M, x0, "PVA", J(n, 1, 1))
    _cge_setv(M, x0, "PINTA", PINTA0)
    _cge_setv(M, x0, "PX", J(nC, 1, 1))
    _cge_setv(M, x0, "PD", J(nC, 1, 1))
    _cge_setv(M, x0, "PE", ce)
    _cge_setv(M, x0, "PM", PM0)
    _cge_setv(M, x0, "PQ", J(nC, 1, 1))
    _cge_setv(M, x0, "W", W0)
    _cge_setv(M, x0, "EXR", 1)
    _cge_setv(M, x0, "CPI", p.cwts' * (1 :+ tv))
    _cge_setv(M, x0, "DPI", sum(p.dwts))
    _cge_setv(M, x0, "QA", QA0)
    _cge_setv(M, x0, "QVA", QVA0)
    _cge_setv(M, x0, "QINTA", QINTA0)
    _cge_setv(M, x0, "QF", QF0)
    _cge_setv(M, x0, "QINT", QINT0)
    _cge_setv(M, x0, "QX", QX0)
    _cge_setv(M, x0, "QD", QD0)
    _cge_setv(M, x0, "QE", QE0)
    _cge_setv(M, x0, "QM", cm :* QM0)
    _cge_setv(M, x0, "QQ", QQ0)
    _cge_setv(M, x0, "QH", QH0)
    _cge_setv(M, x0, "QG", p.qg)
    _cge_setv(M, x0, "QINV", p.qinv)
    _cge_setv(M, x0, "QFS", rowsum(QF0))
    _cge_setv(M, x0, "YF", YF0)
    _cge_setv(M, x0, "YIF", YIF0)
    _cge_setv(M, x0, "YI", YI0)
    _cge_setv(M, x0, "EH", EH0)
    _cge_setv(M, x0, "YG", sum(S[M.igov, .]))
    _cge_setv(M, x0, "EG", sum(vg) + sum(_cge_sub(S, iD, M.igov)) + p.trgg + S[M.irow, M.igov] + p.trshi)
    _cge_setv(M, x0, "GSAV", S[M.isav, M.igov])
    _cge_setv(M, x0, "FSAV", S[M.isav, M.irow])
    _cge_setv(M, x0, "TINS", tins0)
    _cge_setv(M, x0, "MPS", mps0)
    _cge_setv(M, x0, "TINSADJ", 1)
    _cge_setv(M, x0, "MPSADJ", 1)
    _cge_setv(M, x0, "IADJ", 1)
    _cge_setv(M, x0, "GADJ", 1)
    _cge_setv(M, x0, "WFDIST", WFD0)
    _cge_setv(M, x0, "WALRAS", 0)
    _cge_setv(M, x0, "QT", QT0)
    _cge_setv(M, x0, "QER", QER0)
    _cge_setv(M, x0, "YSHI", YSHI0)
    _cge_setv(M, x0, "SHIADJ", 1)
    _cge_setv(M, x0, "QSHI", QSHI0)
    _cge_setv(M, x0, "EFF", J(nF, 1, 1))
    _cge_setv(M, x0, "HS", p.hs0)
    _cge_setv(M, x0, "TQADJ", 1)
    _cge_setv(M, x0, "TMADJ", 1)
    _cge_setv(M, x0, "TVADJ", 1)
    _cge_setv(M, x0, "PWE", pwe)
    _cge_setv(M, x0, "QHA", HOME0)
    _cge_setv(M, x0, "LSW", J(nF, 1, 0))
    _cge_setv(M, x0, "LSM", _cge_lsm0(p, rowsum(QF0)))
    _cge_setv(M, x0, "DW", J(nF, 1, 1))
    _cge_setv(M, x0, "RM", J(nC, 1, 0))
    _cge_setv(M, x0, "RE", J(nC, 1, 0))
    _cge_setv(M, x0, "RA", J(n, 1, 0))
    _cge_setv(M, x0, "QNA", M.nn :* VN0)
    _cge_setv(M, x0, "PNA", M.nn)
    _cge_setv(M, x0, "PXAC", M.xac)
    _cge_setv(M, x0, "QXAC", M.xac :* MAKE0)
    M.x0 = x0
    M.xcur = x0
    M.xscale = abs(x0) :* (abs(x0) :> 1e-12) + (abs(x0) :<= 1e-12)

    M.exists = J(total, 1, 1)
    _cge_setv(M, M.exists, "PE", ce)
    _cge_setv(M, M.exists, "QE", ce)
    _cge_setv(M, M.exists, "PM", cm)
    _cge_setv(M, M.exists, "QM", cm)
    _cge_setv(M, M.exists, "QF", M.fa)
    _cge_setv(M, M.exists, "WFDIST", M.fa)
    _cge_setv(M, M.exists, "PX", cx)
    _cge_setv(M, M.exists, "PD", cdo)
    _cge_setv(M, M.exists, "QX", cx)
    _cge_setv(M, M.exists, "QD", cdo)
    _cge_setv(M, M.exists, "PQ", cq)
    _cge_setv(M, M.exists, "QQ", cq)
    _cge_setv(M, M.exists, "PWE", ced)
    _cge_setv(M, M.exists, "QHA", HOME0 :!= 0)
    _cge_setv(M, M.exists, "QT", ct)
    _cge_setv(M, M.exists, "QER", cr)
    _cge_setv(M, M.exists, "QINT", QINT0 :!= 0)
    _cge_setv(M, M.exists, "QH", QH0 :!= 0)
    _cge_setv(M, M.exists, "YSHI", (M.ishi > 0))
    _cge_setv(M, M.exists, "SHIADJ", (M.ishi > 0))
    _cge_setv(M, M.exists, "QSHI", M.cshi)
    _cge_setv(M, M.exists, "EFF", p.etah :!= 0)
    _cge_setv(M, M.exists, "HS", p.hlink)
    _cge_setv(M, M.exists, "DW", p.ins)
    _cge_setv(M, M.exists, "LSW", p.inlf)
    _cge_setv(M, M.exists, "LSM", p.inlf)
    _cge_setv(M, M.exists, "RM", cm)
    _cge_setv(M, M.exists, "RE", ce)
    _cge_setv(M, M.exists, "QNA", M.nn)
    _cge_setv(M, M.exists, "PNA", M.nn)
    _cge_setv(M, M.exists, "PXAC", M.xac)
    _cge_setv(M, M.exists, "QXAC", M.xac)

    M.nominal = J(total, 1, 0)
    for (k = 1; k <= rows(M.vname); k++) {
        if (anyof(("PA","PVA","PINTA","PX","PD","PE","PM","PQ","W","EXR","CPI","DPI",
                   "YF","YIF","YI","EH","YG","EG","GSAV","WALRAS","YSHI","PNA","PXAC"), M.vname[k])) {
            M.nominal[_cge_vpos(M, k)] = J(M.vrows[k] * M.vcols[k], 1, 1)
        }
    }
    M.positive = J(0, 1, .)
    for (k = 1; k <= rows(M.vname); k++) {
        if (anyof(("PA","PVA","PINTA","PX","PD","PE","PM","PQ","W","EXR","CPI","DPI",
                   "QA","QVA","QINTA","QF","QX","QD","QE","QM","QQ","QT","QER","QNA","PNA","PXAC","QXAC"), M.vname[k])) {
            m = _cge_vpos(M, k)
            M.positive = M.positive \ select(m, M.exists[m] :* (x0[m] :> 0))
        }
    }

    // User variables and equations (from version 0.6.1) are kept: compiled
    // again, with base values from the new base
    if (rows(M.uvdef) | rows(M.uedef)) {
        _cge_u_build(M, p, x0)
        for (k = rows(M.vname) - M.nuv + 1; k <= rows(M.vname); k++) {
            m = _cge_vpos(M, k)
            M.xscale[m] = abs(x0[m]) :* (abs(x0[m]) :> 1e-12) + (abs(x0[m]) :<= 1e-12)
            if (M.uvdef[k - rows(M.vname) + M.nuv, 5] == "nominal") M.nominal[m] = J(rows(m), 1, 1)
        }
        M.x0 = x0
        M.xcur = x0
        printf("{txt}User variables and equations kept: {res}%f{txt} variable(s), {res}%f{txt} equation element(s)\n",
               M.nuv, rows(M.uelab))
    }

    // Equation masks and scales, from the base point
    _cge_eq(M, p, x0, L, R, K, 1)
    M.emask = K
    mag = rowmax((abs(L), abs(R)))
    M.escale = mag :* (mag :> 1e-9) + (mag :<= 1e-9)
    M.neq = sum(K)

    _cge_pattern(M, p)
    M.calibrated = 1
    // the attributes of cge_bound, from the new base (from version 0.9.8)
    _cge_bd_sync(M)
    M.simname = J(0, 1, "")
    M.simclosure = J(0, 1, "")
    M.simmethod = J(0, 1, "")
    M.simx = J(total, 0, .)
    M.simp = cge_par(1, 0)
    M.simconv = J(0, 1, .)
    M.simiter = J(0, 1, .)
    M.simres = J(0, 1, .)
    M.simrun = J(0, 1, "")
    M.simper = J(0, 1, .)
    M.simlam = J(0, 1, .)
    M.simcons = J(0, 1, "")
    M.c_fac = J(nF, 1, "mobile")
    _cge_closure_apply(M, "flexexr", "flexgsav", "savings", "cpi", M.c_fac)

    // Benchmark replication (model_spec.md, check 2), over the model's own
    // equations; user equations that do not hold at the base act as shocks
    maxres = _cge_maxres_part(M, p, x0, 0)
    if (maxres > 1e-9 | maxres >= .) {
        errprintf("benchmark replication failed: largest scaled residual %9.3e\n", maxres)
        exit(9)
    }
    if (rows(M.uelab)) {
        if (_cge_maxres_part(M, p, x0, 1) > 1e-9) printf("{txt}Note: user equations do not hold at the base (largest scaled residual {res}%9.3e{txt}); they act as shocks\n", _cge_maxres_part(M, p, x0, 1))
    }
    // the inequalities and bounds of user variables, made again (from version 0.9.0)
    if (_cge_u_cons_sync(M, 0)) _cge_closure_apply(M, "flexexr", "flexgsav", "savings", "cpi", M.c_fac)
    _cge_store(M)

    printf("{txt}Calibrated: {res}%f{txt} equations, {res}%f{txt} free variables\n", M.neq, M.neq)
    printf("{txt}Benchmark replication: largest scaled residual {res}%9.3e\n", maxres)
    if (sum(cr)) {
        printf("{txt}Exports drawn from composite supply (equation T9): {res}%s\n",
               invtokens(select(M.C, cr)'))
    }
    st_numscalar("r(N_equations)", M.neq)
    st_numscalar("r(max_residual)", maxres)
}

// Nests of value added (model_spec.md, 17.2; from version 0.5.1): nests()
// lists each nest and its members, factors or commodities, as in
// "labour: lab_hi lab_lo, ke: cap com_ene"; sigmanest() gives one elasticity
// for every nest, or name:value pairs
void _cge_nests(struct cge_model scalar M, struct cge_par scalar p, string scalar spec, string scalar s_sig)
{
    string rowvector parts, mem
    string scalar name, form
    real scalar k, j, i, f, c
    M.N = J(0, 1, "")
    M.nestf = J(M.nF, 1, 0)
    M.nestc = J(M.nC, 1, 0)
    form = " needs the form name: member member ..."
    parts = (strtrim(spec) == "" ? J(1, 0, "") : _cge_split(spec, ",", ""))
    for (k = 1; k <= cols(parts); k++) {
        if (strtrim(parts[k]) == "") continue
        i = strpos(parts[k], ":")
        if (!i) _cge_fail("nests(): " + strtrim(parts[k]) + form, 198)
        name = strtrim(substr(parts[k], 1, i - 1))
        mem = tokens(substr(parts[k], i + 1, .))
        if (name == "" | cols(mem) == 0) _cge_fail("nests(): " + strtrim(parts[k]) + form, 198)
        if (name != strtoname(name)) _cge_fail("nests(): " + name + " is not a valid name", 198)
        if (_cge_find(M.F, name) | _cge_find(M.C, name) | _cge_find(M.N, name)) {
            _cge_fail("nests(): " + name + " is the name of a factor, a commodity or another nest", 198)
        }
        M.N = M.N \ name
        for (j = 1; j <= cols(mem); j++) {
            f = _cge_find(M.F, mem[j])
            c = _cge_find(M.C, mem[j])
            if (f) {
                if (M.nestf[f]) _cge_fail("nests(): " + mem[j] + " is in two nests", 198)
                M.nestf[f] = rows(M.N)
            }
            else if (c) {
                if (M.nestc[c]) _cge_fail("nests(): " + mem[j] + " is in two nests", 198)
                M.nestc[c] = rows(M.N)
            }
            else _cge_fail("nests(): " + mem[j] + " is not a factor or commodity of the model", 198)
        }
    }
    M.nN = rows(M.N)
    if (!M.nN) {
        if (strtrim(s_sig) != "") _cge_fail("sigmanest() needs nests()", 198)
        p.sgn = J(0, 1, .)
        p.rhn = J(0, 1, .)
        M.cdn = J(0, 1, .)
        return
    }
    if (strtrim(s_sig) == "") _cge_fail("nests() need elasticities: give sigmanest()", 198)
    if (!strpos(s_sig, ":") & cols(tokens(s_sig)) == 1) p.sgn = J(M.nN, 1, strtoreal(s_sig))
    else p.sgn = _cge_values(s_sig, M.N, ., "sigmanest")
    if (hasmissing(p.sgn) | min(p.sgn) <= 0) _cge_fail("sigmanest(): give a positive elasticity for each nest", 198)
    M.cdn = abs(p.sgn :- 1) :< 1e-12
    p.rhn = (1 :- M.cdn) :* (1 :/ p.sgn :- 1)
}

// Output of a commodity from several activities (model_spec.md, 17.3; from
// version 0.5.2): sigmaac() gives commodity:elasticity pairs, or one value
// for every commodity with more than one producing activity; the activities'
// outputs are combined by a CES or Cobb-Douglas function instead of being
// perfect substitutes
void _cge_outnest(struct cge_model scalar M, struct cge_par scalar p, string scalar spec, real matrix MAKE0,
                  real colvector QX0, real scalar tol)
{
    real colvector prod, m, d, v
    real scalar k, eff
    prod = colsum(MAKE0 :> tol)'
    p.sac = J(M.nC, 1, 0)
    if (strtrim(spec) != "") {
        if (!strpos(spec, ":") & cols(tokens(spec)) == 1) {
            p.sac = (prod :>= 2) :* strtoreal(spec)
            if (strtoreal(spec) >= . | strtoreal(spec) <= 0) _cge_fail("sigmaac(): elasticities must be positive", 198)
        }
        else {
            // commodities not listed are missing, then perfect substitutes
            v = _cge_values(spec, M.C, ., "sigmaac")
            if (any((v :< .) :* (v :<= 0))) _cge_fail("sigmaac(): elasticities must be positive", 198)
            p.sac = editmissing(v, 0)
            _cge_fail_if((p.sac :> 0) :* (prod :< 2), M.labels[M.iC], "sigmaac(): produced by one activity only", 459)
        }
    }
    M.cac = (p.sac :> 0)
    M.cdac = M.cac :* (abs(p.sac :- 1) :< 1e-12)
    p.rac = M.cac :* (1 :- M.cdac) :* (1 :/ (p.sac + (p.sac :== 0)) :- 1)
    M.xac = (MAKE0 :> tol) :* M.cac'
    p.dac = J(M.n, M.nC, 0)
    p.aac = J(M.nC, 1, 1)
    for (k = 1; k <= M.nC; k++) {
        if (!M.cac[k]) continue
        m = _cge_which(M.xac[., k])
        _cge_ces_shares(J(rows(m), 1, 1), MAKE0[m, k], MAKE0[m, k], QX0[k], p.rac[k], M.cdac[k], d, eff)
        p.dac[m, k] = d
        p.aac[k] = eff
    }
}

// Shares d and efficiency eff of a CES aggregate (exponent r) or a
// Cobb-Douglas one of inputs with prices pr, quantities q and values v,
// worth total (model_spec.md, 7.3)
void _cge_ces_shares(real colvector pr, real colvector q, real colvector v, real scalar total,
                     real scalar r, real scalar cobb, real colvector d, real scalar eff)
{
    real colvector num
    if (cobb) {
        d = v :/ total
        eff = total / exp(sum(d :* ln(q)))
        return
    }
    num = pr :* (q :^ (1 + r))
    d = num :/ sum(num)
    eff = total / (sum(d :* (q :^ (-r))))^(-1 / r)
}

// Factor efficiency (model_spec.md, 5.2 and 7.3): af = 1 and, given health
// commodities and elasticities, EFF_f = (HS / HS0)^eta_f. Elasticities are one
// value for every factor in healthfac() (all factors by default) or one each.
void _cge_health(struct cge_model scalar M, struct cge_par scalar p, real matrix QH0, real colvector QSHI0,
                 string scalar s_hc, string scalar s_hf, string scalar s_he, | string scalar s_sick,
                 string scalar s_sickel, string scalar s_mort, string scalar s_mortel)
{
    real colvector idx, f, eta, s0, gs, es, ge
    real rowvector v
    real scalar hs0, m0, em
    M.chs = J(M.nC, 1, 0)
    if (s_hc != "") {
        idx = _cge_elements(M.C, s_hc, "commodities")
        M.chs[idx] = J(rows(idx), 1, 1)
    }
    eta = J(M.nF, 1, 0)
    if (s_he != "") {
        if (s_hc == "") _cge_fail("healthelas() needs healthcom(): name the health services", 198)
        if (s_hf == "") f = (1::M.nF)
        else f = _cge_elements(M.F, s_hf, "factors")
        v = strtoreal(tokens(s_he))
        if (cols(v) == 1) v = J(1, rows(f), v)
        if (cols(v) != rows(f)) {
            errprintf("healthelas() needs 1 or %f values\n", rows(f))
            exit(198)
        }
        if (hasmissing(v) | min(v) < 0) _cge_fail("healthelas() values must be zero or positive", 198)
        eta[f] = v'
    }
    else if (s_hf != "") _cge_fail("healthfac() needs healthelas()", 198)
    // Health outcomes (model_spec.md, Section 15): days lost to illness by
    // factor, and the death rate, with elasticities with respect to health
    // services per head
    s0 = _cge_given(s_sick, M.F, "sickdays", gs)
    s0 = gs :* editmissing(s0, 0)
    if (max(gs :* ((s0 :< 0) :| (s0 :>= 1)))) _cge_fail("sickdays() shares must be at least 0 and below 1", 198)
    es = J(M.nF, 1, 0)
    if (s_sickel != "") {
        if (!any(gs)) _cge_fail("sickelas() needs sickdays()", 198)
        if (!strpos(s_sickel, ":") & cols(tokens(s_sickel)) == 1) es = gs :* strtoreal(s_sickel)
        else {
            es = _cge_given(s_sickel, M.F, "sickelas", ge)
            _cge_fail_if(ge :* (1 :- gs), M.F, "sickelas(): no sickdays() given for", 198)
            es = editmissing(es, 0)
        }
        if (hasmissing(es)) _cge_fail("sickelas() needs numbers", 198)
    }
    m0 = 0
    em = 0
    if (s_mort != "") {
        m0 = strtoreal(s_mort)
        if (!(m0 >= 0 & m0 < 1)) _cge_fail("mortality() must be at least 0 and below 1 (deaths per head per period)", 198)
        if (s_mortel != "") em = strtoreal(s_mortel)
        if (em >= .) _cge_fail("mortelas() needs a number", 198)
    }
    else if (s_mortel != "") _cge_fail("mortelas() needs mortality()", 198)
    if ((any(es) | em != 0) & s_hc == "") {
        _cge_fail("health outcomes with non-zero elasticities need healthcom(): name the health services", 198)
    }
    p.hlink = (any(eta) | any(es) | em != 0)
    hs0 = sum(M.chs :* (rowsum(QH0) + p.qg + QSHI0))
    if (p.hlink & hs0 <= 0) {
        _cge_fail("health services have no consumption by households, the government or the health insurance fund", 459)
    }
    p.af = J(M.nF, 1, 1)
    p.etah = eta
    p.hs0 = (p.hlink ? hs0 : 1)
    p.ins = gs
    p.sick0 = s0
    p.sick = s0
    p.epss = es
    p.hasmort = (s_mort != "")
    p.mort0 = m0
    p.mort = m0
    p.epsm = em
    p.pop = 1
    if (any(gs)) printf("{txt}Days lost to illness: {res}%s\n", invtokens((select(M.F, gs) :+ ":" :+ strofreal(select(s0, gs)))'))
    if (p.hasmort) printf("{txt}Death rate: {res}%g{txt} per head; elasticity {res}%g\n", m0, em)
}

// Top nest of production (model_spec.md, 5.2 and 7.3): Leontief (sigmaa 0, the
// default), Cobb-Douglas (1) or CES between value added and intermediates.
// Base prices: PVA = 1 and PINTA = sum of the intermediate shares.
void _cge_topnest(struct cge_model scalar M, struct cge_par scalar p, string scalar s_a, real colvector QA0,
                  real colvector QVA0, real colvector QINTA0, real colvector PINTA0)
{
    real colvector sa, lt, cda, rho, qi, pi, ratio, value
    real scalar n
    n = rows(QA0)
    sa = (s_a == "" ? J(n, 1, 0) : strtoreal(tokens(s_a))')
    if (rows(sa) == 1) sa = J(n, 1, sa)
    if (rows(sa) != n) {
        errprintf("sigmaa() needs 1 or %f values\n", n)
        exit(198)
    }
    if (hasmissing(sa) | min(sa) < 0) _cge_fail("sigmaa() values must be zero (Leontief) or positive", 198)
    lt = (sa :== 0) :| (QINTA0 :<= 0)
    if (max((sa :> 0) :* (QINTA0 :<= 0))) {
        printf("{txt}Note: activities without intermediate inputs keep a Leontief top nest: {res}%s\n",
               invtokens(select(M.A, (sa :> 0) :* (QINTA0 :<= 0))'))
    }
    cda = (1 :- lt) :* (abs(sa :- 1) :< 1e-12)
    rho = (1 :- lt) :* (1 :- cda) :* (1 :/ (sa + (sa :== 0)) :- 1)
    qi = lt :+ (1 :- lt) :* QINTA0
    pi = lt :+ (1 :- lt) :* PINTA0
    ratio = (1 :/ pi) :* ((QVA0 :/ qi) :^ (1 :+ rho))
    p.dla = ratio :/ (1 :+ ratio)
    p.dlac = 1 :/ (1 :+ ratio)
    value = QVA0 + pi :* qi
    p.dla = cda :* (QVA0 :/ value) + (1 :- cda) :* p.dla
    p.dlac = cda :* (pi :* qi :/ value) + (1 :- cda) :* p.dlac
    p.aa = J(n, 1, 1)
    p.aa = lt :+ cda :* (QA0 :/ ((QVA0 :^ p.dla) :* (qi :^ p.dlac))) +
           (1 :- lt) :* (1 :- cda) :* (QA0 :/ ((p.dla :* (QVA0 :^ (-rho)) + p.dlac :* (qi :^ (-rho))) :^
           (-1 :/ (rho + (rho :== 0)))))
    p.rha = rho
    p.sa = sa
    M.lt = lt
    M.cda = cda
}

// Shares by element of a set, as "label:share ..." or one number for all,
// between 0 and 1; dflt for elements not listed
real colvector _cge_shares(string scalar spec, string colvector set, real scalar dflt, string scalar name)
{
    real colvector out
    string rowvector tok
    real scalar k, pos, i, v
    out = J(rows(set), 1, dflt)
    tok = tokens(spec)
    if (cols(tok) == 1 & !strpos(spec, ":")) out = J(rows(set), 1, strtoreal(tok[1]))
    else {
        for (k = 1; k <= cols(tok); k++) {
            pos = strpos(tok[k], ":")
            if (!pos) _cge_fail(name + "() entries take the form label:share, or give one share for all", 198)
            i = _cge_find(set, substr(tok[k], 1, pos - 1))
            if (!i) _cge_fail(name + "(): " + substr(tok[k], 1, pos - 1) + " is not one of the model's accounts of that kind", 111)
            v = strtoreal(substr(tok[k], pos + 1, .))
            out[i] = v
        }
    }
    if (hasmissing(out) | min(out) < 0 | max(out) > 1) _cge_fail(name + "() shares must lie between 0 and 1", 198)
    return(out)
}

// Values by element of a set, as "label:value ..."; dflt for elements not listed
real colvector _cge_values(string scalar spec, string colvector set, real scalar dflt, string scalar name)
{
    real colvector out
    string rowvector tok
    real scalar k, pos, i
    out = J(rows(set), 1, dflt)
    tok = tokens(spec)
    for (k = 1; k <= cols(tok); k++) {
        pos = strpos(tok[k], ":")
        if (!pos) _cge_fail(name + "() entries take the form label:value, or give one value for all", 198)
        i = _cge_find(set, substr(tok[k], 1, pos - 1))
        if (!i) _cge_fail(name + "(): " + substr(tok[k], 1, pos - 1) + " is not one of the model's accounts of that kind", 111)
        out[i] = strtoreal(substr(tok[k], pos + 1, .))
    }
    return(out)
}

// VAT rate tv such that v' (tv liab / (1 + tv liab)) = vat (model_spec.md,
// 12.2), by Newton's method from the first-order value
real scalar _cge_vat_rate(real scalar vat, real colvector v, real colvector liab, string scalar label)
{
    real scalar base, tv, f, df, step, k
    base = v' * liab
    if (base == 0) _cge_fail("VAT is recorded on " + label + " but no use of it bears VAT", 459)
    tv = vat / base
    for (k = 1; k <= 100; k++) {
        f = v' * (tv :* liab :/ (1 :+ tv :* liab)) - vat
        df = v' * (liab :/ (1 :+ tv :* liab):^2)
        step = f / df
        tv = tv - step
        if (abs(step) <= 1e-15 * max((1, abs(tv)))) break
    }
    if (k > 100) _cge_fail("the VAT rate of " + label + " could not be calibrated", 430)
    if (min(1 :+ tv :* liab) <= 0) _cge_fail("the VAT rate of " + label + " is below -100 per cent", 459)
    return(tv)
}

// "domestic:# foreign:#" as (domestic, foreign)
real rowvector _cge_domfor(string scalar spec, string scalar name)
{
    real rowvector out
    string rowvector tok
    string scalar key
    real scalar k, pos
    out = (0, 0)
    tok = tokens(spec)
    for (k = 1; k <= cols(tok); k++) {
        pos = strpos(tok[k], ":")
        if (!pos) _cge_fail(name + "() entries take the form domestic:# and foreign:#", 198)
        key = strlower(substr(tok[k], 1, pos - 1))
        if (key == "domestic") out[1] = strtoreal(substr(tok[k], pos + 1, .))
        else if (key == "foreign") out[2] = strtoreal(substr(tok[k], pos + 1, .))
        else _cge_fail(name + "(): " + key + " is not domestic or foreign", 198)
    }
    if (hasmissing(out)) _cge_fail(name + "() needs numbers", 198)
    return(out)
}

// Public debt and interest (model_spec.md, 12.3): the base transfers from
// government are split into interest on the stated debt and other transfers
void _cge_debt(struct cge_model scalar M, struct cge_par scalar p, string scalar s_debt, string scalar s_int,
               string scalar s_hold, string scalar s_borrow, real scalar tol)
{
    real rowvector dbt, rate
    real colvector pos, hold, trdg, bad
    real scalar dd, df, rd, rf, trrg, phi

    p.debt = 0
    p.ddebt = 0
    p.fdebt = 0
    p.rd = 0
    p.rf = 0
    p.phi = 0
    p.hold = J(M.nD, 1, 0)
    if (s_debt == "" & s_int == "" & s_hold == "" & s_borrow == "") return
    dbt = _cge_domfor(s_debt, "debt")
    rate = _cge_domfor(s_int, "interest")
    dd = dbt[1]
    df = dbt[2]
    rd = rate[1]
    rf = rate[2]
    if (min(dbt) < 0 | min(rate) <= -1) _cge_fail("debt must be non-negative and interest rates above -1", 198)
    if (s_hold == "") {
        pos = p.trdg :* (p.trdg :> 0)
        if (rd * dd != 0 & sum(pos) <= 0) _cge_fail("the government makes no transfers to domestic institutions; give the debt holders with debtholders()", 459)
        hold = (sum(pos) > 0 ? pos :/ sum(pos) : J(M.nD, 1, 0))
    }
    else {
        hold = _cge_shares(s_hold, M.D, 0, "debtholders")
        if (abs(sum(hold) - 1) > 1e-12) _cge_fail("debtholders() shares must sum to one", 198)
    }
    trdg = p.trdg - hold :* (rd * dd)
    trrg = p.trrg - rf * df
    bad = trdg :< -tol
    _cge_fail_if(bad, M.D, "government transfers are smaller than the interest on the stated debt for", 459)
    if (trrg < -tol) _cge_fail("government transfers to the rest of the world are smaller than the interest on the stated foreign debt", 459)
    if (s_borrow == "") phi = (dd + df > 0 ? df / (dd + df) : 0)
    else {
        phi = strtoreal(s_borrow)
        if (phi >= . | phi < 0 | phi > 1) _cge_fail("foreignborrowing() must lie between 0 and 1", 198)
    }
    p.trdg = trdg
    p.trrg = trrg
    p.debt = 1
    p.ddebt = dd
    p.fdebt = df
    p.rd = rd
    p.rf = rf
    p.hold = hold
    p.phi = phi
    printf("{txt}Public debt: {res}%g{txt} at home at {res}%g{txt}, {res}%g{txt} abroad at {res}%g{txt}; interest of {res}%g{txt} separated from government transfers\n",
           dd, rd, df, rf, rd * dd + rf * df)
}

// Values given as "label:value ..." for some elements of a set, and which
// elements are given
real colvector _cge_given(string scalar spec, string colvector set, string scalar name, real colvector given)
{
    real colvector out
    out = _cge_values(spec, set, ., name)
    given = (out :< .)
    if (sum(given) != cols(tokens(spec))) _cge_fail(name + "() needs one number for each factor given", 198)
    return(out)
}

// Labour force, wage curve and minimum wage (model_spec.md, Section 14): the
// labour force from the base unemployment rate; with unemployment in the base
// the floor binds at the base real wage, and with full employment it is a share
// of the base real wage
void _cge_labour(struct cge_model scalar M, struct cge_par scalar p, string scalar s_un, string scalar s_wc,
                 string scalar s_mw, string scalar s_mu, real colvector W0, real scalar CPI0,
                 real colvector QFS0)
{
    real colvector un, wc, mw, gun, gwc, gmw, inlf, wref
    real scalar nF, k, u, r, mu
    string scalar f

    nF = M.nF
    mu = (strtrim(s_mu) == "" ? 1e-10 : strtoreal(s_mu))
    if (mu >= . | mu <= 0) _cge_fail("smoothing() must be positive", 198)
    un = _cge_given(s_un, M.F, "unemployment", gun)
    wc = _cge_given(s_wc, M.F, "wagecurve", gwc)
    mw = _cge_given(s_mw, M.F, "minwage", gmw)
    for (k = 1; k <= nF; k++) {
        if (gwc[k] & !(gun[k] & un[k] > 0)) _cge_fail("wagecurve(): " + M.F[k] + " needs unemployment in the base: give it in unemployment()", 198)
    }
    inlf = gun :| gmw
    wref = W0 :/ CPI0
    p.inlf = inlf
    p.qlf = QFS0
    p.u0 = J(nF, 1, 1)
    p.epsw = J(nF, 1, 0)
    p.wref = wref
    p.wmin = wref
    p.hasmin = J(nF, 1, 0)
    p.mu = mu
    for (k = 1; k <= nF; k++) {
        if (!inlf[k]) continue
        f = M.F[k]
        u = (gun[k] ? un[k] : 0)
        if (!(u >= 0 & u < 1)) _cge_fail("unemployment(): the rate of " + f + " must be at least 0 and below 1", 198)
        if (gmw[k]) {
            r = mw[k]
            p.hasmin[k] = 1
            if (u > 0) {
                if (abs(r - 1) > 1e-12) _cge_fail("minwage(): with unemployment of " + f + " in the base, the floor is the base wage (" + f + ":1)", 198)
                p.wmin[k] = wref[k] / (1 + mu / u)
            }
            else {
                if (!(r > 0 & r < 1)) _cge_fail("minwage(): with full employment of " + f + " in the base, the floor must be below the base wage", 198)
                p.wmin[k] = r * wref[k]
                u = mu / (1 / r - 1)
            }
        }
        else if (u > 0) {
            // by default the floor is the base wage
            p.hasmin[k] = 1
            p.wmin[k] = wref[k] / (1 + mu / u)
        }
        if (gwc[k]) {
            if (!(wc[k] > 0)) _cge_fail("wagecurve(): the elasticity of " + f + " must be positive", 198)
            p.epsw[k] = wc[k]
        }
        if (!(u > 0)) _cge_fail(f + ": a labour force needs unemployment in the base or a minimum wage", 198)
        p.u0[k] = u
        p.qlf[k] = QFS0[k] / (1 - u)
    }
    for (k = 1; k <= nF; k++) {
        if (!inlf[k]) continue
        printf("{txt}Labour force of {res}%s{txt}: {res}%g{txt}; base unemployment rate {res}%g{txt}", M.F[k], p.qlf[k], p.u0[k])
        if (p.epsw[k] > 0) printf("{txt}; wage-curve elasticity {res}%g", p.epsw[k])
        printf("{txt}; real minimum wage {res}%g{txt} (base real wage %g)\n", p.wmin[k], p.wref[k])
    }
}

// Base value of the slack of the minimum-wage condition (L2)
real colvector _cge_lsm0(struct cge_par scalar p, real colvector QFS0)
{
    real colvector a, b
    a = 1 :- QFS0 :/ p.qlf
    b = p.wref :/ p.wmin :- 1
    return(p.inlf :* (a + b - sqrt(a :^ 2 + b :^ 2 :+ 2 * p.mu)))
}

void _cge_les(struct cge_par scalar p, real matrix QH0, real colvector EH0, string scalar s_ie,
              string scalar s_fr, real scalar nC, real scalar nH, real colvector ph0, real matrix QHA0)
{
    real colvector ie, fr
    real rowvector total
    real matrix b, bh
    if (s_fr == "") _cge_fail("incelas() needs frisch(): LES demand needs Frisch parameters", 198)
    ie = (s_ie == "" ? J(nC, 1, 1) : _cge_elast(s_ie, nC, "incelas"))
    fr = strtoreal(tokens(s_fr))'
    if (rows(fr) == 1) fr = J(nH, 1, fr)
    if (rows(fr) != nH) {
        errprintf("frisch() needs 1 or %f values\n", nH)
        exit(198)
    }
    if (hasmissing(fr) | max(fr) >= -1) {
        _cge_fail("frisch() values must be below -1, so that subsistence spending is positive", 198)
    }
    if (min(QH0) < 0) _cge_fail("LES demand needs non-negative household consumption", 459)
    b = ie :* p.beta
    // Home consumption of activity a takes the income elasticity of its paired
    // commodity, the a-th commodity (13.1)
    bh = ie[|1 \ rows(p.betah)|] :* p.betah
    total = colsum(b) + colsum(bh)
    p.beta = b :/ (total + (total :<= 0))
    p.betah = bh :/ (total + (total :<= 0))
    // Subsistence quantities at the prices final users pay (PH, with VAT)
    // (in Mata :/ binds more tightly than :*)
    p.gamma = QH0 + (p.beta :* (EH0' :/ fr')) :/ ph0
    p.gammah = QHA0 + p.betah :* (EH0' :/ fr')
    printf("{txt}Household demand: linear expenditure system\n")
}

// =====================================================================
// Closure (model_spec.md, Section 6)
// =====================================================================

void _cge_fix(struct cge_model scalar M, real colvector fixed, string scalar name, real scalar row)
{
    real scalar k
    real colvector pos
    k = _cge_vidx(M, name)
    pos = _cge_vpos(M, k)
    if (row > 0) pos = M.voff[k] :+ ((row - 1) * M.vcols[k] :+ (1::M.vcols[k]))
    fixed[pos] = J(rows(pos), 1, 1)
}

void _cge_closure_apply(struct cge_model scalar M, string scalar ext, string scalar gov,
                        string scalar si, string scalar num, string colvector fac)
{
    real colvector fixed
    real scalar k, nfree
    string rowvector tok, inst, adj
    string scalar instrument
    real colvector rates

    if (_cge_sa(M)) {
        _cge_closure_apply_sa(M)
        return
    }
    fixed = J(rows(M.x0), 1, 0)
    _cge_fix(M, fixed, "GADJ", 0)
    if (ext == "flexexr") _cge_fix(M, fixed, "FSAV", 0)
    else if (ext == "fixexr") _cge_fix(M, fixed, "EXR", 0)
    else _cge_fail("external() must be flexexr or fixexr", 198)
    // Government (model_spec.md, 12.1): with fixed savings, direct, sales,
    // import or VAT rates adjust; the other tax scaling factors are fixed
    inst = ("direct", "sales", "import", "vat")
    adj = ("TINSADJ", "TQADJ", "TMADJ", "TVADJ")
    tok = tokens(subinstr(gov, ":", " "))
    if (cols(tok) == 0) tok = "flexgsav"
    instrument = ""
    if (tok[1] == "flexgsav" & cols(tok) == 1) instrument = ""
    else if (tok[1] == "fixgsav" & cols(tok) <= 2) {
        instrument = (cols(tok) == 2 ? tok[2] : "direct")
        if (!anyof(inst, instrument)) _cge_fail("government(fixgsav " + instrument + "): the adjusting tax is direct, sales, import or vat", 198)
    }
    else _cge_fail("government() must be flexgsav, or fixgsav with direct, sales, import or vat", 198)
    for (k = 1; k <= 4; k++) if (inst[k] != instrument) _cge_fix(M, fixed, adj[k], 0)
    if (instrument != "") {
        _cge_fix(M, fixed, "GSAV", 0)
        rates = (instrument == "direct" ? M.p0.tins0 : (instrument == "sales" ? M.p0.tq :
                 (instrument == "import" ? M.p0.tm : M.p0.tv)))
        if (!any(rates)) _cge_fail("government(fixgsav " + instrument + "): that tax raises no revenue in the base", 459)
    }
    gov = (instrument == "" ? "flexgsav" : (instrument == "direct" ? "fixgsav" : "fixgsav:" + instrument))
    if (si == "savings") _cge_fix(M, fixed, "MPSADJ", 0)
    else if (si == "investment") _cge_fix(M, fixed, "IADJ", 0)
    else _cge_fail("savinv() must be savings or investment", 198)
    if (num == "cpi") _cge_fix(M, fixed, "CPI", 0)
    else if (num == "dpi") _cge_fix(M, fixed, "DPI", 0)
    else _cge_fail("numeraire() must be cpi or dpi", 198)
    for (k = 1; k <= M.nF; k++) {
        if (fac[k] == "mobile") {
            _cge_fix(M, fixed, "QFS", k)
            _cge_fix(M, fixed, "WFDIST", k)
        }
        else if (fac[k] == "specific") {
            _cge_fix(M, fixed, "W", k)
            _cge_fix(M, fixed, "QF", k)
        }
        else if (fac[k] == "unemployed") {
            _cge_fix(M, fixed, "W", k)
            _cge_fix(M, fixed, "WFDIST", k)
        }
        else if (fac[k] == "wagecurve" | fac[k] == "minwage") {
            // Labour-market regimes (model_spec.md, Section 14)
            if (!M.p0.inlf[k]) _cge_fail(M.F[k] + ": " + fac[k] + " needs a labour force: calibrate with unemployment() or minwage()", 459)
            if (fac[k] == "wagecurve" & !(M.p0.epsw[k] > 0)) _cge_fail(M.F[k] + ": the wage curve needs an elasticity: calibrate with wagecurve()", 459)
            if (fac[k] == "minwage" & !M.p0.hasmin[k]) _cge_fail(M.F[k] + ": give a minimum wage", 459)
            _cge_fix(M, fixed, "WFDIST", k)
            _cge_fix(M, fixed, (fac[k] == "wagecurve" ? "LSW" : "LSM"), k)
        }
        else _cge_fail("factor closure must be mobile, specific, unemployed, wagecurve or minwage", 198)
    }
    // Exogenous user variables (from version 0.9.0)
    _cge_u_fixed(M, fixed)
    // Rents are fixed, at zero in the base, unless a constraint frees them;
    // each constraint needs its adjusting variable fixed and its limited
    // variable free (Section 16.2)
    _cge_fix(M, fixed, "RM", 0)
    _cge_fix(M, fixed, "RE", 0)
    _cge_fix(M, fixed, "RA", 0)
    for (k = 1; k <= rows(M.bY); k++) {
        if (!fixed[M.bX[k]]) _cge_fail("constraint on " + _cge_poslabel(M, M.bY[k]) + ": " + _cge_poslabel(M, M.bX[k]) +
                                       " is not fixed under this closure, so it cannot adjust", 459)
        if (fixed[M.bY[k]]) _cge_fail("constraint on " + _cge_poslabel(M, M.bY[k]) + ": it is fixed under this closure", 459)
    }
    // Swaps (Section 6, from version 0.4.5): one element fixed for each freed
    for (k = 1; k <= rows(M.swfix); k++) {
        if (fixed[M.swfix[k]]) _cge_fail("swap: " + _cge_poslabel(M, M.swfix[k]) + " is already fixed under the closure", 459)
        if (!fixed[M.swfree[k]]) _cge_fail("swap: " + _cge_poslabel(M, M.swfree[k]) + " is not fixed under the closure", 459)
        if (M.derived[M.swfix[k]]) {
            _cge_fail("swap: " + _cge_poslabel(M, M.swfix[k]) + " is computed from its definition and cannot be fixed", 459)
        }
        fixed[M.swfix[k]] = 1
        fixed[M.swfree[k]] = 0
    }
    nfree = sum(M.exists :* (1 :- fixed)) + rows(M.bY)
    if (nfree != M.neq) {
        errprintf("closure is not square: %f free variables, %f equations\n", nfree, M.neq)
        exit(459)
    }
    // A square closure is still singular if an equation has no free variable
    // (from version 0.4.5); swaps can produce one
    _cge_closure_rank(M, fixed)
    M.fixed = fixed
    M.c_ext = ext
    M.c_gov = gov
    M.c_si = si
    M.c_num = num
    M.c_fac = fac
}

// The closure of a standalone model (from version 0.13.0): the user variables
// fixed by their definitions, then the swaps; cge_solve checks that the
// system is square
void _cge_closure_apply_sa(struct cge_model scalar M)
{
    real colvector fixed
    real scalar k
    fixed = J(rows(M.x0), 1, 0)
    _cge_u_fixed(M, fixed)
    for (k = 1; k <= rows(M.bY); k++) {
        if (!fixed[M.bX[k]]) _cge_fail("constraint on " + _cge_poslabel(M, M.bY[k]) + ": " + _cge_poslabel(M, M.bX[k]) +
                                       " is not fixed, so it cannot adjust", 459)
        if (fixed[M.bY[k]]) _cge_fail("constraint on " + _cge_poslabel(M, M.bY[k]) + ": it is fixed", 459)
    }
    for (k = 1; k <= rows(M.swfix); k++) {
        if (fixed[M.swfix[k]]) _cge_fail("swap: " + _cge_poslabel(M, M.swfix[k]) + " is already fixed", 459)
        if (!fixed[M.swfree[k]]) _cge_fail("swap: " + _cge_poslabel(M, M.swfree[k]) + " is not fixed", 459)
        fixed[M.swfix[k]] = 1
        fixed[M.swfree[k]] = 0
    }
    _cge_closure_rank(M, fixed)
    M.fixed = fixed
}

// The closure written in closure text cl applied to M (from version 0.13.0):
// its options, or a standalone model's own
void _cge_closure_cl(struct cge_model scalar M, string rowvector cl)
{
    if (_cge_sa(M)) {
        _cge_closure_apply_sa(M)
        return
    }
    _cge_closure_apply(M, cl[1], subinstr(cl[2], ":", " "), cl[3], cl[4],
                       substr(cl[|5 \ 4 + M.nF|]', strpos(cl[|5 \ 4 + M.nF|]', ":") :+ 1, .))
}

// Fails if an equation of the Jacobian pattern has no free variable: the rows
// with exact derivatives, which depend on many variables, are not in the
// pattern and are not checked
void _cge_closure_rank(struct cge_model scalar M, real colvector fixed)
{
    real colvector isfree, cnt, has, gi
    real matrix bad
    string scalar blk, el, desc
    real scalar k
    if (rows(M.jr) == 0) return
    isfree = M.exists :* (1 :- fixed)
    if (rows(M.bX)) isfree[M.bX] = J(rows(M.bX), 1, 1)
    cnt = J(M.neq, 1, 0)
    has = cnt
    for (k = 1; k <= rows(M.jr); k++) {
        has[M.jr[k]] = 1
        cnt[M.jr[k]] = cnt[M.jr[k]] + isfree[M.jc[k]]
    }
    bad = selectindex(has :& (cnt :== 0))
    if (!length(bad)) return
    gi = selectindex(M.emask)
    _cge_eqlabel(M, gi[bad[1]], blk, el, desc)
    _cge_fail("the closure is singular: equation " + blk + " (" + desc + ")" + (el != "" ? " for " + el : "") +
              " has no free variable" + (length(bad) > 1 ? sprintf(", and %f more equations", length(bad) - 1) : ""), 459)
}

string scalar _cge_closure_text(struct cge_model scalar M)
{
    string scalar s
    real scalar k
    // a standalone model's variables are fixed by their definitions (from
    // version 0.13.0), with the swaps
    if (_cge_sa(M)) s = "standalone"
    else s = M.c_ext + " " + M.c_gov + " " + M.c_si + " " + M.c_num
    for (k = 1; k <= M.nF; k++) s = s + " " + M.F[k] + ":" + M.c_fac[k]
    for (k = 1; k <= rows(M.swfix); k++) s = s + " swap:" + _cge_poslabel(M, M.swfix[k]) + "=" + _cge_poslabel(M, M.swfree[k])
    return(s)
}

// Position of a variable element written NAME, NAME(e1) or NAME(e1,e2)
real scalar _cge_specpos(struct cge_model scalar M, string scalar spec, string scalar what)
{
    string scalar name, el
    real colvector pos
    real scalar b, k
    b = strpos(spec, "(")
    name = (b ? substr(spec, 1, b - 1) : spec)
    el = (b ? subinstr(subinstr(substr(spec, b + 1, .), ")", ""), ",", " ") : "")
    k = _cge_vidx(M, name)
    if (!k) _cge_fail(what + ": " + name + " is not a model variable", 198)
    pos = _cge_cons_pos(M, k, el)
    if (rows(pos) != 1) _cge_fail(what + ": " + spec + " is not one element; write, for example, W(lab)", 198)
    if (!M.exists[pos]) _cge_fail(what + ": " + spec + " does not exist in this model", 459)
    return(pos)
}

// Swaps from "fix free fix free ..." or the swap: tokens of a closure text
void _cge_swap_parse(struct cge_model scalar M, string rowvector tok, real colvector fx, real colvector fr)
{
    real scalar k
    fx = J(0, 1, .)
    fr = J(0, 1, .)
    if (cols(tok) == 0) return
    if (tok[1] == "none") return
    if (mod(cols(tok), 2)) _cge_fail("swap() takes pairs: the variable to fix, then the variable to free", 198)
    for (k = 1; k <= cols(tok); k = k + 2) {
        fx = fx \ _cge_specpos(M, tok[k], "swap")
        fr = fr \ _cge_specpos(M, tok[k + 1], "swap")
    }
    if (rows(uniqrows(fx \ fr)) < rows(fx) + rows(fr)) _cge_fail("swap(): each variable element may appear once", 198)
}

// The swaps recorded in a closure text, as tokens "fix free ..."
string rowvector _cge_swap_tokens(string rowvector cl)
{
    string rowvector out
    real scalar k, e
    out = J(1, 0, "")
    for (k = 1; k <= cols(cl); k++) {
        if (substr(cl[k], 1, 5) != "swap:") continue
        e = strpos(cl[k], "=")
        out = out, substr(cl[k], 6, e - 6), substr(cl[k], e + 1, .)
    }
    return(out)
}

void _cge_closure(string scalar ext, string scalar gov, string scalar si, string scalar num,
                  string scalar facspec, real scalar facgiven, | string scalar swapspec)
{
    struct cge_model scalar M
    string rowvector tok
    string colvector fac
    string scalar f, mode
    real scalar k, pos, idx
    real colvector fx, fr

    M = _cge_load()
    _cge_need(M, "calibrated")
    // a standalone model (from version 0.13.0): only swaps
    if (_cge_sa(M)) {
        if (ext != "" | gov != "" | si != "" | num != "" | facgiven) {
            _cge_fail("a standalone model has no closure options: fix its variables with cge_variable, fixed, or exchange them with swap()", 198)
        }
        if (args() >= 7 & strtrim(swapspec) != "") {
            _cge_swap_parse(M, tokens(swapspec), fx, fr)
            M.swfix = fx
            M.swfree = fr
        }
        if (M.nuv) {
            _cge_u_cons_drop(M)
            _cge_cons_rebuild(M)
        }
        _cge_closure_apply_sa(M)
        if (_cge_u_cons_sync(M, 0)) _cge_closure_apply_sa(M)
        _cge_store(M)
        _cge_closure_show(M)
        return
    }
    if (ext == "") ext = M.c_ext
    if (gov == "") gov = M.c_gov
    if (si == "") si = M.c_si
    if (num == "") num = M.c_num
    fac = M.c_fac
    if (facgiven) {
        fac = J(M.nF, 1, "mobile")
        tok = tokens(facspec)
        for (k = 1; k <= cols(tok); k++) {
            pos = strpos(tok[k], ":")
            if (pos == 0) _cge_fail("factors() entries take the form factor:mode, with mode mobile, specific, unemployed, wagecurve or minwage", 198)
            f = substr(tok[k], 1, pos - 1)
            mode = substr(tok[k], pos + 1, .)
            idx = _cge_find(M.F, f)
            if (idx == 0) _cge_fail(f + " is not a factor of the model", 111)
            fac[idx] = mode
        }
    }
    // Swaps (from version 0.4.5) replace any earlier ones; swap(none) removes them
    if (args() >= 7 & strtrim(swapspec) != "") {
        _cge_swap_parse(M, tokens(swapspec), fx, fr)
        M.swfix = fx
        M.swfree = fr
    }
    // the inequalities of user equations are made again under the new closure
    // (from version 0.9.0)
    if (M.nuv) {
        _cge_u_cons_drop(M)
        _cge_cons_rebuild(M)
    }
    _cge_closure_apply(M, ext, gov, si, num, fac)
    // the inequalities of user equations, under the new closure (from version 0.9.0)
    if (_cge_u_cons_sync(M, 0)) _cge_closure_apply(M, ext, gov, si, num, fac)
    _cge_store(M)
    _cge_closure_show(M)
}

void _cge_closure_show(struct cge_model scalar M)
{
    real scalar k
    if (_cge_sa(M)) {
        printf("{txt}Closure of a standalone model: {res}%f{txt} fixed and {res}%f{txt} free variable elements\n",
               sum(M.exists :* M.fixed), sum(M.exists :* (1 :- M.fixed)))
        for (k = 1; k <= rows(M.swfix); k++) {
            printf("{txt}  swap                 {res}%s{txt} fixed, {res}%s{txt} free\n", _cge_poslabel(M, M.swfix[k]),
                   _cge_poslabel(M, M.swfree[k]))
        }
        st_numscalar("r(N_swaps)", rows(M.swfix))
        st_global("r(closure)", _cge_closure_text(M))
        return
    }
    printf("{txt}Closure\n")
    printf("{txt}  external account     {res}%s\n", M.c_ext)
    printf("{txt}  government           {res}%s\n", M.c_gov)
    printf("{txt}  savings-investment   {res}%s\n", M.c_si)
    printf("{txt}  numeraire            {res}%s\n", M.c_num)
    for (k = 1; k <= M.nF; k++) printf("{txt}  factor %-13s {res}%s\n", M.F[k], M.c_fac[k])
    for (k = 1; k <= rows(M.swfix); k++) {
        printf("{txt}  swap                 {res}%s{txt} fixed, {res}%s{txt} free\n", _cge_poslabel(M, M.swfix[k]),
               _cge_poslabel(M, M.swfree[k]))
    }
    st_numscalar("r(N_swaps)", rows(M.swfix))
    st_global("r(closure)", _cge_closure_text(M))
}

// =====================================================================
// Shocks
// =====================================================================

real matrix _cge_par_get(struct cge_par scalar p, string scalar name)
{
    if (name == "tm")   return(p.tm)
    if (name == "te")   return(p.te)
    if (name == "tq")   return(p.tq)
    if (name == "ta")   return(p.ta)
    if (name == "pwm")  return(p.pwm)
    if (name == "pwe")  return(p.pwe)
    if (name == "ad")   return(p.ad)
    if (name == "qg")   return(p.qg)
    if (name == "qinv") return(p.qinv)
    if (name == "trdg") return(p.trdg)
    if (name == "trdr") return(p.trdr)
    if (name == "trfr") return(p.trfr)
    if (name == "trgr") return(p.trgr)
    if (name == "trrg") return(p.trrg)
    if (name == "tshi") return(p.tshi)
    if (name == "qshi") return(p.qshi)
    if (name == "trshi") return(p.trshi)
    if (name == "trshir") return(p.trshir)
    if (name == "af") return(p.af)
    if (name == "tv") return(p.tv)
    if (name == "kappa") return(p.kappa)
    if (name == "rd") return(p.rd)
    if (name == "rf") return(p.rf)
    if (name == "ddebt") return(p.ddebt)
    if (name == "fdebt") return(p.fdebt)
    if (name == "qlf") return(p.qlf)
    if (name == "wmin") return(p.wmin)
    if (name == "wref") return(p.wref)
    if (name == "sick") return(p.sick)
    if (name == "mort") return(p.mort)
    if (name == "tf") return(p.tf)
    if (name == "tfy") return(p.tfy)
    // from version 0.5.3, for the periods of dynamic runs
    if (name == "trgg") return(p.trgg)
    if (name == "hs0") return(p.hs0)
    _cge_fail("cge internal error: unknown parameter " + name, 3498)
}

void _cge_par_set(struct cge_par scalar p, string scalar name, real matrix v)
{
    if (name == "tm")        p.tm = v
    else if (name == "te")   p.te = v
    else if (name == "tq")   p.tq = v
    else if (name == "ta")   p.ta = v
    else if (name == "pwm")  p.pwm = v
    else if (name == "pwe")  p.pwe = v
    else if (name == "ad")   p.ad = v
    else if (name == "qg")   p.qg = v
    else if (name == "qinv") p.qinv = v
    else if (name == "trdg") p.trdg = v
    else if (name == "trdr") p.trdr = v
    else if (name == "trfr") p.trfr = v
    else if (name == "trgr") p.trgr = v
    else if (name == "trrg") p.trrg = v
    else if (name == "tshi") p.tshi = v
    else if (name == "qshi") p.qshi = v
    else if (name == "trshi") p.trshi = v
    else if (name == "trshir") p.trshir = v
    else if (name == "af") p.af = v
    else if (name == "tv") p.tv = v
    else if (name == "kappa") p.kappa = v
    else if (name == "rd") p.rd = v
    else if (name == "rf") p.rf = v
    else if (name == "ddebt") p.ddebt = v
    else if (name == "fdebt") p.fdebt = v
    else if (name == "qlf") p.qlf = v
    else if (name == "wmin") p.wmin = v
    else if (name == "wref") p.wref = v
    else if (name == "sick") p.sick = v
    else if (name == "mort") p.mort = v
    else if (name == "tf") p.tf = v
    else if (name == "tfy") p.tfy = v
}

real colvector _cge_elements(string colvector set, string scalar elems, string scalar what)
{
    string rowvector tok
    real colvector idx
    real scalar k
    if (elems == "" | elems == "all") return((1::rows(set)))
    tok = tokens(elems)
    idx = J(cols(tok), 1, 0)
    for (k = 1; k <= cols(tok); k++) {
        idx[k] = _cge_find(set, tok[k])
        if (idx[k] == 0) _cge_fail(tok[k] + " is not one of the " + what + " of the model", 111)
    }
    return(idx)
}

void _cge_shock(string scalar target, string scalar elems, string scalar mode, real scalar value)
{
    struct cge_model scalar M
    struct cge_par scalar q
    real matrix T
    real colvector v, idx, pos
    real scalar k

    M = _cge_load()
    _cge_need(M, "calibrated")

    if (target == "reset") {
        // Constraints and the recipients of rents are kept (Section 16)
        q = M.p
        M.p = M.p0
        _cge_cons_carry(M.p, q)
        M.xcur = M.x0
        _cge_store(M)
        printf("{txt}All shocks removed\n")
        return
    }

    // A user parameter (from version 0.7.1)
    k = _cge_up_find(M, target)
    if (k) {
        pos = _cge_up_elements(M, k, elems)
        v = M.p.upval
        v[pos] = (mode == "scale" ? v[pos] :* value : J(rows(pos), 1, value))
        M.p.upval = v
        _cge_store(M)
        printf("{txt}User parameter {res}%s{txt} changed for %f element(s)\n", target, rows(pos))
        return
    }

    // a standalone model (from version 0.13.0): its user variables
    if (_cge_sa(M)) {
        _cge_shock_var(M, target, elems, mode, value)
        return
    }
    if (anyof(("tshi", "qshi", "trshi", "trshir"), target) & !M.ishi) {
        _cge_fail(target + " needs a health insurance fund: name it with cge_map, insurance()", 459)
    }
    // VAT and public debt (from version 0.3.1)
    if (anyof(("tv", "kappa"), target) & !(M.ivattax > 0 & M.ivattax < .)) {
        _cge_fail(target + " needs a VAT account: map one with cge_map, vattax() or vatshare() (vatshare(0) creates an empty one)", 459)
    }
    if (anyof(("rd", "rf", "ddebt", "fdebt"), target) & M.p0.debt != 1) {
        _cge_fail(target + " needs public debt: calibrate with debt() and interest()", 459)
    }
    // Health outcomes (from version 0.3.4)
    if (target == "sick") {
        idx = _cge_elements(M.F, elems, "factors")
        if (!all(M.p0.ins[idx])) _cge_fail("sick needs days lost to illness: calibrate with sickdays()", 459)
    }
    else if (target == "mort") {
        if (M.p0.hasmort != 1) _cge_fail("mort needs a death rate: calibrate with mortality()", 459)
        if (elems != "" & elems != "all") _cge_fail(target + " has no elements", 198)
        idx = 1
    }
    // Labour-market regimes (from version 0.3.3)
    else if (anyof(("qlf", "wmin", "wref"), target)) {
        idx = _cge_elements(M.F, elems, "factors")
        if (!all(M.p0.inlf[idx])) _cge_fail(target + " needs a labour force: calibrate with unemployment() or minwage()", 459)
        if (mode == "value" & !(value > 0)) _cge_fail(target + " must be positive", 198)
    }
    else if (anyof(("tm", "te", "tq", "pwm", "pwe", "qg", "qinv", "qshi", "tv"), target)) {
        idx = _cge_elements(M.C, elems, "commodities")
    }
    else if (anyof(("ta", "ad", "kappa"), target)) {
        idx = _cge_elements(M.A, elems, "activities")
    }
    else if (anyof(("trdg", "trdr"), target)) {
        idx = _cge_elements(M.D, elems, "households and enterprises")
    }
    // Taxes on factor use (from version 0.5.0): the rates of the factors given,
    // in every activity that uses them
    else if (target == "tf") {
        idx = _cge_elements(M.F, elems, "factors")
        T = M.p.tf
        T[idx, .] = (mode == "scale" ? T[idx, .] :* value : M.fa[idx, .] :* value)
        M.p.tf = T
        _cge_store(M)
        printf("{txt}Parameter {res}tf{txt} changed for %f factor(s)\n", rows(idx))
        return
    }
    else if (anyof(("trfr", "tshi", "af", "tfy"), target)) {
        idx = _cge_elements(M.F, elems, "factors")
    }
    else if (anyof(("trgr", "trrg", "trshi", "trshir", "rd", "rf", "ddebt", "fdebt"), target)) {
        if (elems != "" & elems != "all") _cge_fail(target + " has no elements", 198)
        idx = 1
    }
    else idx = J(0, 1, .)

    if (rows(idx)) {
        v = _cge_par_get(M.p, target)
        v[idx] = (mode == "scale" ? v[idx] :* value : J(rows(idx), 1, value))
        if (target == "kappa" & (min(v) < 0 | max(v) > 1)) _cge_fail("VAT credit shares (kappa) must lie between 0 and 1", 198)
        if (target == "sick" & (min(v) < 0 | max(v) >= 1)) _cge_fail("shares of working time lost (sick) must be at least 0 and below 1", 198)
        if (target == "mort" & (min(v) < 0 | max(v) >= 1)) _cge_fail("the death rate (mort) must be at least 0 and below 1", 198)
        _cge_par_set(M.p, target, v)
        _cge_store(M)
        printf("{txt}Parameter {res}%s{txt} changed for %f element(s)\n", target, rows(idx))
        return
    }

    _cge_shock_var(M, target, elems, mode, value)
}

// A shock to the fixed elements of variable target (from version 0.13.0 a
// function of its own)
void _cge_shock_var(struct cge_model scalar M, string scalar target, string scalar elems, string scalar mode,
                    real scalar value)
{
    real colvector idx, pos, okpos
    real scalar k, i
    string scalar set
    string rowvector tk
    k = _cge_vidx(M, target)
    if (k == 0 & _cge_sa(M)) _cge_fail(target + " is not a user parameter or a variable of the model", 198)
    if (k == 0) {
        _cge_fail(target + " is not a shockable parameter (tm te tq ta tv kappa pwm pwe ad af qg qinv trdg trdr trfr trgr trrg tshi qshi trshi trshir rd rf ddebt fdebt qlf wmin wref sick mort tf tfy) or model variable", 198)
    }
    set = M.vset[k]
    if (set == "") {
        if (elems != "" & elems != "all") _cge_fail(target + " has no elements", 198)
        pos = _cge_vpos(M, k)
    }
    else if (_cge_nidx(set) == 1) {
        // the elements of the variable's set, user variables included (from version 0.6.4)
        idx = _cge_elements(_cge_setlab(M, set), elems, "elements")
        pos = M.voff[k] :+ idx
    }
    else if (set == "FA") {
        idx = _cge_elements(M.F, elems, "factors")
        pos = J(0, 1, .)
        for (i = 1; i <= rows(idx); i++) pos = pos \ (M.voff[k] :+ ((idx[i] - 1) * M.n :+ (1::M.n)))
    }
    else if (strpos(set, "|")) {
        // a user variable with two indexes (from version 0.9.1): elements e1.e2
        if (elems == "" | elems == "all") pos = _cge_vpos(M, k)
        else {
            pos = J(0, 1, .)
            tk = tokens(elems)
            for (i = 1; i <= cols(tk); i++) pos = pos \ _cge_cons_pos(M, k, tk[i])
        }
    }
    else _cge_fail(target + " cannot be shocked", 198)

    okpos = select(pos, M.exists[pos])
    if (min(M.fixed[okpos]) == 0) {
        _cge_fail(target + " is not fixed under the current closure, so it cannot be set", 459)
    }
    M.xcur[okpos] = (mode == "scale" ? M.xcur[okpos] :* value : J(rows(okpos), 1, value))
    _cge_store(M)
    printf("{txt}Variable {res}%s{txt} changed for %f element(s)\n", target, rows(okpos))
}

// =====================================================================
// Solver
// =====================================================================

// =====================================================================
// Sparse LU factorisation (from version 0.10.1)
// =====================================================================
//
// For the Newton steps of large systems. The rows with many entries -- the
// sums of government revenue, the balances, the price indexes -- are set
// apart; on the others, a pivot order is chosen once by Markowitz's rule
// with threshold pivoting, on the values of a first matrix
// (_cge_slu_analyse: right-looking elimination of the pattern). With rows p
// and columns q in that order, the sparse block A11 = A[p1, q1] = L U, by
// columns (_cge_slu_factor: left-looking, with the patterns of L and U from
// the analysis), and the rows set apart and the columns left over form a
// dense block, through its Schur complement S = A22 - A21 inv(A11) A12,
// factorised by dense LU. Each later matrix with the same pattern is
// factorised in the same order, which is chosen again when a pivot falls
// below the threshold.

struct cge_slu {
    real scalar     n, ns, ok, nnzl, nnzu
    real colvector  p, q, pinv, qinv
    // the pattern analysed, as compressed columns: starts and rows
    real colvector  acp, ari
    // L of the sparse block by columns, rows in the permuted order (> k)
    real colvector  ls, ll, lr, lv
    // U of the sparse block by columns, rows (< k), values and diagonal
    real colvector  us, ul, ur, uv, ud
    // the dense block: the entries of A12 (rows, columns of the block,
    // values) and of A21 by rows, with their panels, and the LU of S with
    // its order
    real colvector  r12, c12, v12, r21, c21, v21
    real matrix     i21, SL, SU
    real colvector  sp
}

// Compressed columns of the n x n matrix of entries (r, c, v): column starts
// (n + 1), rows and values, duplicates summed
void _cge_slu_csc(real colvector r, real colvector c, real colvector v, real scalar n, real colvector cp,
                  real colvector ri, real colvector vv)
{
    real colvector o, lin, cnt
    real matrix info
    lin = (c :- 1) :* n :+ r
    o = order(lin, 1)
    lin = lin[o]
    vv = v[o]
    info = panelsetup(lin, 1)
    vv = panelsum(vv, info)
    lin = lin[info[., 1]]
    ri = mod(lin :- 1, n) :+ 1
    cnt = J(n, 1, 0)
    o = floor((lin :- 1) :/ n) :+ 1
    info = panelsetup(o, 1)
    cnt[o[info[., 1]]] = info[., 2] - info[., 1] :+ 1
    cp = 1 \ (runningsum(cnt) :+ 1)
}

// The pivot order of matrix (cp, ri, vv), n x n. The rows with more entries
// than ten times the average, or 50, are set apart; on the others, at each
// step, among a pool of the active columns with the fewest entries (chosen
// again every 16 steps), the columns with the fewest (four at most), the
// entries within the threshold u of the largest in their column, the one with
// the smallest product of its row and column counts less one. A column whose
// active entries are all below 1e-10 of its largest entry in the rows not set
// apart has lost them to rounding in the elimination (rows that cancel), and
// is left over; a row left without a pivot joins those set apart. Fills the
// order and the patterns of L and U in F; F.ok is 0 for a matrix that is
// singular in this sense.
void _cge_slu_analyse(struct cge_slu scalar F, real colvector cp, real colvector ri, real colvector vv,
                      real scalar n, real scalar u)
{
    pointer(real colvector) colvector RC, RV, CR
    real colvector rcnt, ccnt, clen, ract, W, mark, cols, vals, rows_, pc, pv, newc, newv, keep, extra, cand, a, ok
    real colvector lk, li, lm, ukr, ukc, pos, cj, ab, rb, pool, dense, avail, cact, cbad, cs
    real matrix mk, tw
    real scalar i, j, t, best, bc, br, bv, cost, mx, c, r, piv, m, nl, nu, big, cx, age, cmin, tau, ns, nact, nlk, nuk
    F.n = n
    F.ok = 0
    F.acp = cp
    F.ari = ri
    big = 1e300
    // the rows of the active matrix, unsorted, with their values; the
    // columns, the rows they hold (with room to grow, clen in use, rows
    // since eliminated included) and their number of active rows
    RC = RV = CR = J(n, 1, NULL)
    rcnt = ccnt = clen = J(n, 1, 0)
    a = J(rows(ri), 1, .)
    for (j = 1; j <= n; j++) if (cp[j + 1] > cp[j]) a[|cp[j] \ cp[j + 1] - 1|] = J(cp[j + 1] - cp[j], 1, j)
    keep = order((ri, a), (1, 2))
    lk = ri[keep]
    li = a[keep]
    lm = vv[keep]
    for (i = 1; i <= n; i++) {
        RC[i] = &J(0, 1, .)
        RV[i] = &J(0, 1, .)
    }
    if (rows(lk)) {
        mk = panelsetup(lk, 1)
        for (t = 1; t <= rows(mk); t++) {
            i = lk[mk[t, 1]]
            RC[i] = &(li[|mk[t, 1] \ mk[t, 2]|] :+ 0)
            RV[i] = &(lm[|mk[t, 1] \ mk[t, 2]|] :+ 0)
            rcnt[i] = mk[t, 2] - mk[t, 1] + 1
        }
    }
    // the rows set apart
    tau = max((50, 10 * rows(ri) / n))
    dense = (rcnt :> tau)
    ract = !dense
    // the scale of each column: its largest entry in the other rows
    cs = J(n, 1, 0)
    for (j = 1; j <= n; j++) {
        clen[j] = cp[j + 1] - cp[j]
        if (clen[j]) {
            CR[j] = &(ri[|cp[j] \ cp[j + 1] - 1|] \ J(clen[j], 1, .))
            ccnt[j] = sum(ract[ri[|cp[j] \ cp[j + 1] - 1|]])
            cs[j] = max(abs(vv[|cp[j] \ cp[j + 1] - 1|]) :* ract[ri[|cp[j] \ cp[j + 1] - 1|]])
        }
        else CR[j] = &J(4, 1, .)
    }
    cact = J(n, 1, 1)
    cbad = J(n, 1, 0)
    nact = sum(ract)
    W = mark = J(n, 1, 0)
    F.p = F.q = J(n, 1, .)
    // the entries of L (row, step, multiplier) and of U (step, column,
    // value), in vectors with room to grow: appending to a vector copies it
    nlk = nuk = 0
    lk = li = lm = J(rows(ri) + n, 1, .)
    ukr = ukc = J(rows(ri) + n, 1, .)
    F.uv = J(rows(ri) + n, 1, .)
    pool = J(0, 1, .)
    age = 16
    ns = 0
    while (nact) {
        // the columns that can take a pivot: active, with entries in active
        // rows, and not found to be zero there
        if (age >= 16 | !rows(pool)) {
            avail = ccnt :+ big :* ((ccnt :<= 0) :| !cact :| cbad)
            minindex(avail, 64, pool, tw)
            if (rows(pool) > 64) pool = pool[|1 \ 64|]
            age = 0
        }
        age++
        pool = select(pool, cact[pool] :& (ccnt[pool] :> 0) :& !cbad[pool])
        if (!rows(pool) | !cols(pool)) {
            avail = ccnt :+ big :* ((ccnt :<= 0) :| !cact :| cbad)
            minindex(avail, 64, pool, tw)
            if (rows(pool) > 64) pool = pool[|1 \ 64|]
            pool = select(pool, cact[pool] :& (ccnt[pool] :> 0) :& !cbad[pool])
            if (!rows(pool) | !cols(pool)) break
            age = 1
        }
        cmin = min(ccnt[pool])
        cand = select(pool, ccnt[pool] :== cmin)
        if (rows(cand) > 4) cand = cand[|1 \ 4|]
        best = .
        bc = br = 0
        bv = 0
        for (t = 1; t <= rows(cand); t++) {
            c = cand[t]
            cj = (*CR[c])[|1 \ clen[c]|]
            rows_ = select(cj, ract[cj])
            if (!cols(rows_)) continue
            a = J(rows(rows_), 1, 0)
            for (i = 1; i <= rows(rows_); i++) {
                pos = selectindex(*RC[rows_[i]] :== c)
                if (rows(pos)) a[i] = (*RV[rows_[i]])[pos[1]]
            }
            mx = max(abs(a))
            // entries zero, or lost to rounding: the column is left over
            if (mx >= . | mx <= 1e-10 * cs[c]) {
                cbad[c] = 1
                continue
            }
            ok = selectindex(abs(a) :>= u * mx)
            for (i = 1; i <= rows(ok); i++) {
                cost = (rcnt[rows_[ok[i]]] - 1) * (ccnt[c] - 1)
                if (cost < best | (cost == best & abs(a[ok[i]]) > abs(bv))) {
                    best = cost
                    bc = c
                    br = rows_[ok[i]]
                    bv = a[ok[i]]
                    // the column's rows and values, for the multipliers
                    rb = rows_
                    ab = a
                }
            }
        }
        // no pivot in these columns: their values are zero; they go to the
        // dense block
        if (!bc) {
            cbad[cand] = J(rows(cand), 1, 1)
            continue
        }
        r = br
        c = bc
        piv = bv
        ns++
        F.p[ns] = r
        F.q[ns] = c
        pc = *RC[r]
        pv = *RV[r]
        // the pivot row is row ns of U
        if (nuk + rows(pc) > rows(ukr)) {
            ukr = ukr \ J(rows(ukr), 1, .)
            ukc = ukc \ J(rows(ukc), 1, .)
            F.uv = F.uv \ J(rows(F.uv), 1, .)
        }
        if (rows(pc)) {
            ukr[|nuk + 1 \ nuk + rows(pc)|] = J(rows(pc), 1, ns)
            ukc[|nuk + 1 \ nuk + rows(pc)|] = pc
            F.uv[|nuk + 1 \ nuk + rows(pc)|] = pv
            nuk = nuk + rows(pc)
        }
        // the other active rows of the pivot column are updated
        for (i = 1; i <= rows(rb); i++) {
            t = rb[i]
            if (t == r) continue
            cols = *RC[t]
            vals = *RV[t]
            m = ab[i] / piv
            if (nlk == rows(lk)) {
                lk = lk \ J(rows(lk), 1, .)
                li = li \ J(rows(li), 1, .)
                lm = lm \ J(rows(lm), 1, .)
            }
            nlk++
            lk[nlk] = t
            li[nlk] = ns
            lm[nlk] = m
            W[cols] = vals
            mark[cols] = J(rows(cols), 1, 1)
            W[pc] = W[pc] - m :* pv
            // the columns that gain the row
            extra = select(pc, !mark[pc])
            // select() gives 0 x 0 when nothing is selected
            if (!cols(extra)) extra = J(0, 1, .)
            newc = cols \ extra
            newc = select(newc, newc :!= c)
            if (!cols(newc)) newc = J(0, 1, .)
            newv = W[newc]
            W[cols] = J(rows(cols), 1, 0)
            W[pc] = J(rows(pc), 1, 0)
            mark[cols] = J(rows(cols), 1, 0)
            RC[t] = &(newc :+ 0)
            RV[t] = &(newv :+ 0)
            rcnt[t] = rows(newc)
            for (j = 1; j <= rows(extra); j++) {
                cx = extra[j]
                if (clen[cx] == rows(*CR[cx])) CR[cx] = &((*CR[cx]) \ J(clen[cx] + 4, 1, .))
                clen[cx] = clen[cx] + 1
                (*CR[cx])[clen[cx]] = t
                ccnt[cx] = ccnt[cx] + 1
            }
        }
        // the pivot row and column leave the active matrix
        ract[r] = 0
        nact--
        cact[c] = 0
        ccnt[pc] = ccnt[pc] :- 1
        ccnt[c] = 0
    }
    lk = (nlk ? lk[|1 \ nlk|] : J(0, 1, .))
    li = (nlk ? li[|1 \ nlk|] : J(0, 1, .))
    ukr = (nuk ? ukr[|1 \ nuk|] : J(0, 1, .))
    ukc = (nuk ? ukc[|1 \ nuk|] : J(0, 1, .))
    // the rows set apart, and those left without a pivot, then the columns
    // left over, form the dense block
    F.ns = ns
    if (ns < n) {
        keep = J(n, 1, 1)
        if (ns) keep[F.p[|1 \ ns|]] = J(ns, 1, 0)
        F.p[|ns + 1 \ n|] = selectindex(keep)
        keep = J(n, 1, 1)
        if (ns) keep[F.q[|1 \ ns|]] = J(ns, 1, 0)
        F.q[|ns + 1 \ n|] = selectindex(keep)
    }
    F.pinv = invorder(F.p)
    F.qinv = invorder(F.q)
    // L of the sparse block by columns: rows in the permuted order; the rows
    // that end in the dense block keep their entries of A21 instead
    F.lr = F.pinv[lk]
    keep = selectindex(F.lr :<= ns)
    if (!cols(keep)) keep = J(0, 1, .)
    F.lr = F.lr[keep]
    li = li[keep]
    nl = rows(F.lr)
    if (nl) {
        keep = order((li, F.lr), (1, 2))
        li = li[keep]
        F.lr = F.lr[keep]
    }
    F.ls = F.ll = J(n, 1, 0)
    if (nl) {
        mk = panelsetup(li, 1)
        F.ls[li[mk[., 1]]] = mk[., 1]
        F.ll[li[mk[., 1]]] = mk[., 2] - mk[., 1] :+ 1
    }
    F.lv = J(nl, 1, 0)
    // U of the sparse block by columns: the entries of its columns, the
    // diagonal apart; entries in the columns left over belong to A12
    ukc = F.qinv[ukc]
    keep = selectindex((ukc :!= ukr) :& (ukc :<= ns))
    if (!cols(keep)) keep = J(0, 1, .)
    ukr = ukr[keep]
    ukc = ukc[keep]
    nu = rows(ukr)
    if (nu) {
        keep = order((ukc, ukr), (1, 2))
        ukr = ukr[keep]
        ukc = ukc[keep]
    }
    F.ur = ukr
    F.us = F.ul = J(n, 1, 0)
    if (nu) {
        mk = panelsetup(ukc, 1)
        F.us[ukc[mk[., 1]]] = mk[., 1]
        F.ul[ukc[mk[., 1]]] = mk[., 2] - mk[., 1] :+ 1
    }
    F.uv = J(nu, 1, 0)
    F.ud = J(n, 1, 0)
    F.nnzl = nl
    F.nnzu = nu + ns
    F.ok = 1
}

// The values of the factors for matrix (cp, ri, vv), whose pattern F was
// analysed for, in F's order: L and U of the sparse block, column by column,
// then the dense block. Returns 0 if a pivot of the sparse block is below tol
// times the largest entry of its column of L, or at most 1e-10 of the largest
// entry of its column in the sparse block (lost to rounding), or is 0, or if
// the dense block is singular.
real scalar _cge_slu_factor(struct cge_slu scalar F, real colvector cp, real colvector ri, real colvector vv,
                            real scalar tol)
{
    real colvector W, ur, lr, rr, vk, sel, pr, pc, uc
    real matrix S, B, Y
    real scalar k, c, j, jj, a, b, piv, mx, n, ns, nd, c0, nb, j0, j1, g
    n = F.n
    ns = F.ns
    nd = n - ns
    W = J(n, 1, 0)
    for (k = 1; k <= ns; k++) {
        c = F.q[k]
        c0 = 0
        if (cp[c + 1] > cp[c]) {
            rr = F.pinv[ri[|cp[c] \ cp[c + 1] - 1|]]
            vk = vv[|cp[c] \ cp[c + 1] - 1|]
            // the rows of the sparse block; those of the dense one go to A21
            sel = selectindex(rr :<= ns)
            if (cols(sel) & rows(sel)) {
                W[rr[sel]] = vk[sel]
                c0 = max(abs(vk[sel]))
            }
        }
        // the columns of L before k that column k of U needs, in order
        if (F.ul[k]) {
            a = F.us[k]
            b = a + F.ul[k] - 1
            ur = F.ur[|a \ b|]
            for (jj = 1; jj <= rows(ur); jj++) {
                j = ur[jj]
                if (W[j] == 0 | !F.ll[j]) continue
                lr = F.lr[|F.ls[j] \ F.ls[j] + F.ll[j] - 1|]
                W[lr] = W[lr] - F.lv[|F.ls[j] \ F.ls[j] + F.ll[j] - 1|] :* W[j]
            }
            F.uv[|a \ b|] = W[ur]
            W[ur] = J(rows(ur), 1, 0)
        }
        piv = W[k]
        W[k] = 0
        if (abs(piv) <= 1e-10 * c0) return(0)
        if (F.ll[k]) {
            a = F.ls[k]
            b = a + F.ll[k] - 1
            lr = F.lr[|a \ b|]
            mx = max(abs(W[lr]))
            if (piv == 0 | abs(piv) < tol * mx) return(0)
            F.lv[|a \ b|] = W[lr] :/ piv
            W[lr] = J(rows(lr), 1, 0)
        }
        else if (piv == 0) return(0)
        if (piv >= .) return(0)
        F.ud[k] = piv
    }
    F.SL = F.SU = F.i21 = J(0, 0, .)
    F.r12 = F.c12 = F.v12 = F.r21 = F.c21 = F.v21 = F.sp = J(0, 1, .)
    if (!nd) return(1)
    // the blocks of the rows set apart and the columns left over, A12 and A21
    // as entries and A22 dense; the Schur complement by groups of columns of
    // A12, so that inv(A11) A12 is not held whole
    pr = F.pinv[ri]
    pc = F.qinv[floor((_cge_slu_lin(cp, ri, n) :- 1) :/ n) :+ 1]
    sel = selectindex((pr :<= ns) :& (pc :> ns))
    if (rows(sel) & cols(sel)) {
        F.r12 = pr[sel]
        F.c12 = pc[sel] :- ns
        F.v12 = vv[sel]
    }
    sel = selectindex((pr :> ns) :& (pc :<= ns))
    if (rows(sel) & cols(sel)) {
        F.r21 = pr[sel] :- ns
        F.c21 = pc[sel]
        F.v21 = vv[sel]
        sel = order((F.r21, F.c21), (1, 2))
        F.r21 = F.r21[sel]
        F.c21 = F.c21[sel]
        F.v21 = F.v21[sel]
        F.i21 = panelsetup(F.r21, 1)
    }
    S = _cge_slu_block(pr, pc, vv, ns, ns, nd, nd, nd, nd)
    if (ns & rows(F.v12) & rows(F.v21)) {
        nb = max((16, min((nd, floor(2e7 / ns)))))
        for (j0 = 0; j0 < nd; j0 = j0 + nb) {
            j1 = min((nd, j0 + nb))
            sel = selectindex((F.c12 :> j0) :& (F.c12 :<= j1))
            if (!rows(sel) | !cols(sel)) continue
            B = J(ns * (j1 - j0), 1, 0)
            B[(F.c12[sel] :- j0 :- 1) :* ns :+ F.r12[sel]] = F.v12[sel]
            Y = _cge_slu_solve11(F, colshape(B, ns)')
            B = J(0, 0, .)
            for (g = 1; g <= rows(F.i21); g++) {
                a = F.i21[g, 1]
                b = F.i21[g, 2]
                uc = F.c21[|a \ b|]
                j = F.r21[a]
                S[|j, j0 + 1 \ j, j1|] = S[|j, j0 + 1 \ j, j1|] - F.v21[|a \ b|]' * Y[uc, .]
            }
        }
    }
    F.SL = S
    if (hasmissing(F.SL)) return(0)
    _lud(F.SL, F.SU, F.sp)
    F.sp = invorder(F.sp)
    if (any(abs(diagonal(F.SU)) :<= 1e-300) | hasmissing(F.SU)) return(0)
    return(1)
}

// The block of rows r0 + 1 to r0 + nr and columns c0 + 1 to c0 + nc of the
// entries at rows pr and columns pc, with values vv, as a dense matrix
real matrix _cge_slu_block(real colvector pr, real colvector pc, real colvector vv, real scalar r0, real scalar c0,
                           real scalar nr, real scalar nc, real scalar mr, real scalar mc)
{
    real colvector sel, v
    if (!nr | !nc) return(J(nr, nc, 0))
    sel = selectindex((pr :> r0) :& (pr :<= r0 + nr) :& (pc :> c0) :& (pc :<= c0 + nc))
    v = J(nr * nc, 1, 0)
    if (cols(sel) & rows(sel)) v[(pc[sel] :- c0 :- 1) :* nr :+ (pr[sel] :- r0)] = vv[sel]
    return(colshape(v, nr)')
}

// inv(A11) B for the sparse block, B with ns rows, in the permuted order
real matrix _cge_slu_solve11(struct cge_slu scalar F, real matrix B)
{
    real matrix Y
    real colvector lr, ur
    real scalar k, ns
    ns = F.ns
    Y = B
    // rows that are zero are passed over: the columns of B are sparse
    for (k = 1; k <= ns; k++) {
        if (!F.ll[k]) continue
        if (!any(Y[k, .])) continue
        lr = F.lr[|F.ls[k] \ F.ls[k] + F.ll[k] - 1|]
        Y[lr, .] = Y[lr, .] - F.lv[|F.ls[k] \ F.ls[k] + F.ll[k] - 1|] * Y[k, .]
    }
    for (k = ns; k >= 1; k--) {
        if (!any(Y[k, .])) continue
        Y[k, .] = Y[k, .] :/ F.ud[k]
        if (!F.ul[k]) continue
        ur = F.ur[|F.us[k] \ F.us[k] + F.ul[k] - 1|]
        Y[ur, .] = Y[ur, .] - F.uv[|F.us[k] \ F.us[k] + F.ul[k] - 1|] * Y[k, .]
    }
    return(Y)
}

// The solution of A x = b with the factors in F
real colvector _cge_slu_solve(struct cge_slu scalar F, real colvector b)
{
    real colvector y, x, lr, ur, y2, t
    real scalar k, n, ns
    n = F.n
    ns = F.ns
    y = b[F.p]
    // L y1 = b1, column by column
    for (k = 1; k <= ns; k++) {
        if (!F.ll[k] | y[k] == 0) continue
        lr = F.lr[|F.ls[k] \ F.ls[k] + F.ll[k] - 1|]
        y[lr] = y[lr] - F.lv[|F.ls[k] \ F.ls[k] + F.ll[k] - 1|] :* y[k]
    }
    // U z1 = y1, from the last column
    for (k = ns; k >= 1; k--) {
        y[k] = y[k] / F.ud[k]
        if (!F.ul[k] | y[k] == 0) continue
        ur = F.ur[|F.us[k] \ F.us[k] + F.ul[k] - 1|]
        y[ur] = y[ur] - F.uv[|F.us[k] \ F.us[k] + F.ul[k] - 1|] :* y[k]
    }
    // the dense block: x2 = inv(S) (b2 - A21 z1), x1 = z1 - inv(A11) A12 x2
    if (ns < n) {
        t = y[|ns + 1 \ n|]
        if (ns & rows(F.v21)) t = t - _cge_sumby(F.r21, F.v21 :* y[F.c21], n - ns)
        y2 = solveupper(F.SU, solvelower(F.SL, t[F.sp]))
        if (ns & rows(F.v12)) y[|1 \ ns|] = y[|1 \ ns|] - _cge_slu_solve11(F, _cge_sumby(F.r12, F.v12 :* y2[F.c12], ns))
        y[|ns + 1 \ n|] = y2
    }
    x = J(n, 1, .)
    x[F.q] = y
    return(x)
}

// The values of matrix (cp, ri, vv) on the pattern F was analysed for, 0
// where it has no entry; none if it has an entry outside that pattern
real colvector _cge_slu_align(struct cge_slu scalar F, real colvector cp, real colvector ri, real colvector vv)
{
    real colvector la, ln, L, T, V, o, prev, nxt, nz, mk
    real scalar n, N
    n = F.n
    if (rows(ri) == rows(F.ari)) {
        if (cp == F.acp & ri == F.ari) return(vv)
    }
    la = _cge_slu_lin(F.acp, F.ari, n)
    ln = _cge_slu_lin(cp, ri, n)
    L = la \ ln
    T = J(rows(la), 1, 0) \ J(rows(ln), 1, 1)
    V = J(rows(la), 1, 0) \ vv
    o = order((L, T), (1, 2))
    L = L[o]
    T = T[o]
    V = V[o]
    N = rows(L)
    if (N < 2) return(J(0, 1, .))
    prev = 0 \ (L[|2 \ N|] :== L[|1 \ N - 1|])
    if (any(T :& !prev)) return(J(0, 1, .))
    nxt = (L[|1 \ N - 1|] :== L[|2 \ N|]) \ 0
    V = (V[|2 \ N|] \ 0) :* nxt
    return(select(V, !T))
}

// The linear indices, (column - 1) n + row, of compressed columns (cp, ri)
real colvector _cge_slu_lin(real colvector cp, real colvector ri, real scalar n)
{
    real colvector cnt, nz, mk
    if (!rows(ri)) return(J(0, 1, .))
    cnt = cp[|2 \ n + 1|] - cp[|1 \ n|]
    nz = selectindex(cnt)
    mk = J(rows(ri), 1, 0)
    mk[cp[nz]] = J(rows(nz), 1, 1)
    return((nz[runningsum(mk)] :- 1) :* n :+ ri)
}

// The factors of the n x n matrix of entries (r, c, v): in the order of F if
// F was analysed for its pattern and its pivots stay within the threshold,
// otherwise in an order chosen again. Returns 0 for a singular matrix.
real scalar _cge_slu_update(struct cge_slu scalar F, real colvector r, real colvector c, real colvector v,
                            real scalar n, | string scalar ext)
{
    real colvector cp, ri, vv, va
    _cge_slu_csc(r, c, v, n, cp, ri, vv)
    if (hasmissing(vv)) return(0)
    // the same pattern, or part of it: factorised in the order analysed
    if (F.ok & F.n == n) {
        va = _cge_slu_align(F, cp, ri, vv)
        if (rows(va)) {
            if (_cge_slu_factor(F, F.acp, F.ari, va, 1e-8)) return(1)
        }
    }
    _cge_slu_analyse(F, cp, ri, vv, n, 0.1)
    if (!F.ok) return(0)
    if (!_cge_slu_factor(F, cp, ri, vv, 1e-12)) {
        F.ok = 0
        return(0)
    }
    // the order is used again by later solves while the pattern is the same
    if (args() < 6) ext = "cge__slu"
    _cge_slu_keep(F, ext)
    return(1)
}

// The name of the linear solver setting
string scalar _cge_lin_name(struct cge_model scalar M)
{
    if (M.linsolver >= . | M.linsolver == 0) return("dense")
    return(M.linsolver == 1 ? "sparse" : "auto")
}

// cge_options (from version 0.10.1): the settings of the solver, as GAMS's
// option statement; from version 0.14.0 the method for constraints; from
// version 0.16.0 the tolerance, iteration limit and time limit of cge_solve
// and the Jacobian of Newton's method (negative: unchanged; missing: the
// default), and reset, which restores every default
void _cge_options(string scalar lin, | string scalar mcp, real scalar tol, real scalar it, real scalar tlim,
                  string scalar jac, real scalar reset)
{
    struct cge_model scalar M
    real scalar ch
    if (args() < 2) mcp = ""
    if (args() < 3) tol = -1
    if (args() < 4) it = -1
    if (args() < 5) tlim = -1
    if (args() < 6) jac = ""
    if (args() < 7) reset = 0
    M = _cge_load()
    _cge_need(M, "calibrated")
    ch = 0
    if (reset) {
        M.linsolver = M.mcpsolver = M.opttol = M.optit = M.opttime = M.optjac = .
        ch = 1
    }
    if (lin != "") M.linsolver = (lin == "dense" ? 0 : (lin == "sparse" ? 1 : 2))
    if (mcp != "") M.mcpsolver = (mcp == "activeset")
    if (tol > 0 & tol < .) M.opttol = tol
    if (it >= 1 & it < .) M.optit = it
    if (tlim >= 0 & tlim < .) M.opttime = tlim
    if (jac != "") M.optjac = (jac == "differences")
    if (lin != "" | mcp != "" | (tol > 0 & tol < .) | (it >= 1 & it < .) | (tlim >= 0 & tlim < .) | jac != "") ch = 1
    if (ch) _cge_store(M)
    printf("{txt}Linear solver of Newton's steps: {res}%s{txt}%s\n", _cge_lin_name(M),
           (M.linsolver == 2 ? " (the sparse LU from 1,000 equations)" : ""))
    printf("{txt}Method for constraints:          {res}%s\n", _cge_mcp_name(M))
    printf("{txt}Jacobian of Newton's method:     {res}%s\n", (M.optjac == 1 ? "differences" : "exact"))
    printf("{txt}Tolerance of cge_solve:          {res}%s\n", strtrim(sprintf("%9.0g", _cge_opttol(M, -1))))
    printf("{txt}Iteration limit of cge_solve:    {res}%g\n", _cge_optit(M, -1))
    printf("{txt}Time limit of cge_solve:         {res}%s\n", (_cge_opttime(M, -1) >= . ? "none" :
           strtrim(sprintf("%12.0g", _cge_opttime(M, -1))) + " second(s)"))
    st_global("r(linsolver)", _cge_lin_name(M))
    st_global("r(mcp)", _cge_mcp_name(M))
    st_global("r(jacobian)", (M.optjac == 1 ? "differences" : "exact"))
    st_numscalar("r(tolerance)", _cge_opttol(M, -1))
    st_numscalar("r(iterate)", _cge_optit(M, -1))
    st_numscalar("r(timelimit)", _cge_opttime(M, -1))
}

// The tolerance, iteration limit and time limit of a solve (from version
// 0.16.0): those given to the command when not negative, else those of
// cge_options, else the defaults (1e-10, 100 and none)
real scalar _cge_opttol(struct cge_model scalar M, real scalar tol)
{
    if (tol >= 0 & tol < .) return(tol)
    return(M.opttol > 0 & M.opttol < . ? M.opttol : 1e-10)
}

real scalar _cge_optit(struct cge_model scalar M, real scalar it)
{
    if (it >= 0 & it < .) return(it)
    return(M.optit >= 1 & M.optit < . ? M.optit : 100)
}

real scalar _cge_opttime(struct cge_model scalar M, real scalar t)
{
    if (t >= 0 & t < .) return(t)
    return(M.opttime >= 0 & M.opttime < . ? M.opttime : .)
}

// The mode of Newton's method that cge_options sets (from version 0.16.0):
// 0 the exact Jacobian with Broyden's updates, 1 central differences
real scalar _cge_optmode(struct cge_model scalar M)
{
    return(M.optjac == 1)
}

// The clock in milliseconds, to the second
real scalar _cge_now()
{
    return(clock(c("current_date") + " " + c("current_time"), "DMYhms"))
}

// The deadline of a solve (from version 0.16.0), secs from now, or none
// (missing); the reason the last solve stopped short is cleared
void _cge_deadline_set(real scalar secs)
{
    pointer() scalar q
    if ((q = findexternal("cge__deadline")) == NULL) q = crexternal("cge__deadline")
    *q = (secs >= 0 & secs < . ? _cge_now() + 1000 * secs : .)
    _cge_stop_clear()
}

// 1 once the deadline of a solve has passed, which the loops of the solvers
// check at each iteration
real scalar _cge_timeup()
{
    pointer() scalar q
    if ((q = findexternal("cge__deadline")) == NULL) return(0)
    if (*q >= .) return(0)
    if (_cge_now() < *q) return(0)
    _cge_stop_set(3)
    return(1)
}

// Why the last solve stopped short (from version 0.16.0): 0 it did not, 2 an
// iteration limit, 3 the time limit, which outranks the other
void _cge_stop_set(real scalar code)
{
    pointer() scalar q
    if ((q = findexternal("cge__stop")) == NULL) {
        q = crexternal("cge__stop")
        *q = 0
    }
    if (code > *q) *q = code
}

void _cge_stop_clear()
{
    pointer() scalar q
    if ((q = findexternal("cge__stop")) == NULL) q = crexternal("cge__stop")
    *q = 0
}

real scalar _cge_stop()
{
    pointer() scalar q
    if ((q = findexternal("cge__stop")) == NULL) return(0)
    return(*q)
}

// The model status and solver status of stored simulation k (from version
// 0.16.0), in GAMS's codes; missing where unknown
void _cge_simstat(struct cge_model scalar M, real scalar k, real scalar ms, real scalar ss)
{
    ms = ss = .
    if (k > rows(M.simstat) | cols(M.simstat) < 2) return
    ms = M.simstat[k, 1]
    ss = M.simstat[k, 2]
}

void _cge_set_simstat(struct cge_model scalar M, real scalar k, real scalar ms, real scalar ss)
{
    real scalar n
    n = rows(M.simname)
    if (cols(M.simstat) != 2) M.simstat = J(0, 2, .)
    if (rows(M.simstat) < n) M.simstat = M.simstat \ J(n - rows(M.simstat), 2, .)
    if (rows(M.simstat) > n) M.simstat = M.simstat[|1, 1 \ n, 2|]
    M.simstat[k, .] = (ms, ss)
}

// The statuses of a solve from its outcome: conv, whether constraints are in
// the system (cons), whether it is a nonlinear programme (nlp) and, for one
// that stopped short, whether its point satisfies the equations (feas)
void _cge_status(real scalar conv, real scalar cons, real scalar nlp, real scalar feas, real scalar err,
                 real scalar ms, real scalar ss)
{
    real scalar st
    if (conv) {
        ss = 1
        ms = (nlp ? 2 : (cons ? 1 : 16))
        return
    }
    if (err >= .) {
        ms = 13
        ss = 5
        return
    }
    st = _cge_stop()
    ss = (st == 3 ? 3 : (st == 2 ? 2 : 4))
    ms = (nlp & feas ? 7 : (ss == 4 ? 5 : 6))
}

// GAMS's names of the model statuses and solver statuses
string scalar _cge_mstat_name(real scalar ms)
{
    if (ms == 1) return("optimal")
    if (ms == 2) return("locally optimal")
    if (ms == 5) return("locally infeasible")
    if (ms == 6) return("intermediate infeasible")
    if (ms == 7) return("feasible solution")
    if (ms == 8) return("integer solution")
    if (ms == 10) return("integer infeasible")
    if (ms == 14) return("no solution returned")
    if (ms == 13) return("error, no solution")
    if (ms == 16) return("solved")
    return("unknown")
}

string scalar _cge_sstat_name(real scalar ss)
{
    if (ss == 1) return("normal completion")
    if (ss == 2) return("iteration interrupt")
    if (ss == 3) return("resource interrupt")
    if (ss == 4) return("terminated by solver")
    if (ss == 5) return("evaluation error limit")
    return("unknown")
}

// The statuses of a failed solve, displayed (from version 0.16.0)
void _cge_status_show(real scalar ms, real scalar ss)
{
    printf("{txt}Model status {res}%g{txt} (%s); solver status {res}%g{txt} (%s)\n", ms, _cge_mstat_name(ms),
           ss, _cge_sstat_name(ss))
}

// The name of the method for constraints (from version 0.14.0)
string scalar _cge_mcp_name(struct cge_model scalar M)
{
    return(M.mcpsolver == 1 ? "activeset" : "semismooth")
}


// The factors of the sparse LU kept from the last solve: an analysis is used
// again while the pattern of the Jacobian is the same. Runs with foresight
// keep theirs apart (external cge__slu_fs, from version 0.10.2).
void _cge_slu_load(struct cge_slu scalar F, | string scalar ext)
{
    pointer() scalar q
    if (args() < 2) ext = "cge__slu"
    if ((q = findexternal(ext)) != NULL) F = *q
    else F.ok = 0
}

void _cge_slu_keep(struct cge_slu scalar F, | string scalar ext)
{
    pointer() scalar q
    if (args() < 2) ext = "cge__slu"
    if ((q = findexternal(ext)) == NULL) q = crexternal(ext)
    *q = F
}

// H v with H the inverse of the sparse factors times the Broyden factors, as
// _cge_hsolve
real colvector _cge_hsolve_s(struct cge_slu scalar F, real matrix A, real matrix Sm, real scalar ns, real colvector v)
{
    real colvector w
    real scalar j
    w = _cge_slu_solve(F, v)
    for (j = 1; j <= ns; j++) w = w + A[., j] * (Sm[., j]' * w)
    return(w)
}

// The system the solver works on (from version 0.2.0): the free variables,
// the equations (a mask over all equation elements) and the sparsity pattern.
// The full system has every existing equation; the reduced system (the
// default) leaves out explicit definitions -- intermediate and household
// demand, import and export prices, the price of intermediates, output by
// commodity, margin demand, the fund's purchases and factor efficiency --
// whose variables are computed from the others (_cge_derive).
struct cge_sys {
    real colvector free, mask, jr, jc, drow, drow2
    real scalar    neq, reduced
}

// 1 if Newton's steps on system S use the sparse LU (cge_options, linsolver())
real scalar _cge_sparse_on(struct cge_model scalar M, struct cge_sys scalar S)
{
    if (M.linsolver >= . | M.linsolver == 0) return(0)
    if (M.linsolver == 1) return(1)
    return(S.neq >= 1000)
}

struct cge_sys scalar _cge_sys_make(struct cge_model scalar M, real scalar reduced)
{
    struct cge_sys scalar S
    real colvector isx
    S.reduced = reduced
    // The adjusting variables of constraints are solved for (Section 16.2)
    isx = J(rows(M.x0), 1, 0)
    if (rows(M.bX)) isx[M.bX] = J(rows(M.bX), 1, 1)
    if (reduced) {
        S.free = select((1::rows(M.x0)), M.exists :* ((1 :- M.fixed) :| isx) :* (1 :- M.derived))
        S.mask = M.rmask
        S.jr = M.rjr
        S.jc = M.rjc
        S.drow = M.rdrow
        S.drow2 = M.rdrow2
    }
    else {
        S.free = select((1::rows(M.x0)), M.exists :* ((1 :- M.fixed) :| isx))
        S.mask = M.emask
        S.jr = M.jr
        S.jc = M.jc
        S.drow = M.drow
        S.drow2 = M.drow2
    }
    S.neq = sum(S.mask)
    return(S)
}

// Explicit definitions that the reduced system leaves out, as (block, variable),
// in the order of M.dact. None of these variables appears in a row with exact
// derivatives (_cge_dense), and none depends on another of them.
string matrix _cge_dcandidates()
{
    return(("P1", "PM") \ ("P2", "PE") \ ("P6", "PINTA") \ ("Q5", "QINT") \ ("Q6", "QX") \
           ("I5", "QH") \ ("T8", "QT") \ ("I13", "QSHI") \ ("H2", "EFF") \ ("H3", "DW"))
}

// Compute the variables of the active explicit definitions from the others;
// the formulas are those of _cge_eq
void _cge_derive(struct cge_model scalar M, struct cge_par scalar p, real colvector x)
{
    real colvector PQ, EH, PH
    real scalar EXR, TVADJ
    // a standalone model has no definitions left out (from version 0.13.0)
    if (_cge_sa(M)) return
    EXR = _cge_v(M, x, 10)
    PQ = _cge_v(M, x, 8)
    TVADJ = _cge_v(M, x, 52)
    PH = PQ :* (1 :+ p.tv :* TVADJ)
    if (M.dact[1]) {
        _cge_setv(M, x, "PM", M.cm :* (p.pwm :* (1 :+ p.tm :* _cge_v(M, x, 51) + _cge_v(M, x, 58)) :* EXR +
                                       p.ici' * PQ))
    }
    if (M.dact[2]) {
        _cge_setv(M, x, "PE", M.ce :* ((M.ced :* _cge_v(M, x, 53) + (1 :- M.ced) :* p.pwe) :*
                                       (1 :- p.te :- _cge_v(M, x, 59)) :* EXR - p.ice' * PQ))
    }
    if (M.dact[3]) _cge_setv(M, x, "PINTA", (p.ica :* (1 :+ (p.tv :* TVADJ) * (1 :- p.kappa)'))' * PQ)
    if (M.dact[4]) _cge_setv(M, x, "QINT", p.ica :* _cge_v(M, x, 15)')
    if (M.dact[5]) _cge_setv(M, x, "QX", M.cx :* (p.theta' * (_cge_v(M, x, 13) - rowsum(_cge_v(M, x, 54)))))
    if (M.dact[6]) {
        EH = _cge_v(M, x, 30)
        _cge_setv(M, x, "QH", (p.beta :!= 0) :*
                  (PH :* p.gamma + p.beta :* (EH' :- PH' * p.gamma :- _cge_v(M, x, 1)' * p.gammah)) :/ PH)
    }
    if (M.dact[7]) {
        _cge_setv(M, x, "QT", M.ct :* (p.icm * _cge_v(M, x, 22) + p.icd * _cge_v(M, x, 19) +
                                       p.ici * _cge_v(M, x, 21) + p.ice * _cge_v(M, x, 20)))
    }
    if (M.dact[8]) _cge_setv(M, x, "QSHI", p.qshi :* _cge_v(M, x, 46))
    if (M.dact[9]) _cge_setv(M, x, "EFF", (_cge_v(M, x, 49) / p.hs0) :^ p.etah)
    if (M.dact[10]) {
        _cge_setv(M, x, "DW", p.ins :* ((1 :- p.sick :* ((_cge_v(M, x, 49) / p.hs0) :^ p.epss)) :/ (1 :- p.sick0))
                  + (1 :- p.ins))
    }
}

// The reduced system, set up after the full pattern (_cge_pattern): a
// definition is left out when its equation elements are exactly the existing
// elements of its variable. The pattern of the reduced system replaces each
// left-out variable by the variables of its definition.
void _cge_reduce_setup(struct cge_model scalar M, real colvector rowid, real colvector boff)
{
    string matrix cand
    real colvector pos, erow, ex, isder, rowdef, sel, depk, depj, keep, r, j, dj, plain, o, dstart
    real colvector rnew, newr, newc, dpos, drow, cnt, xr, xc
    real scalar k, g, v, a, b, nd

    cand = _cge_dcandidates()
    M.dact = J(rows(cand), 1, 0)
    M.derived = J(rows(M.x0), 1, 0)
    dpos = J(0, 1, .)
    drow = J(0, 1, .)
    for (k = 1; k <= rows(cand); k++) {
        // With VAT, government revenue (I8, exact derivatives) depends on QINT,
        // QH and QSHI, so they and PINTA are kept in the system
        if (M.ivattax > 0 & M.ivattax < . & anyof((3, 4, 6, 8), k)) continue
        g = _cge_find(M.ename, cand[k, 1])
        v = _cge_vidx(M, cand[k, 2])
        if (g == 0 | v == 0) continue
        if (M.elen[g] != M.vrows[v] * M.vcols[v]) continue
        pos = _cge_vpos(M, v)
        erow = rowid[boff[g] :+ (1::M.elen[g])]
        ex = M.exists[pos]
        if (any((erow :> 0) :!= ex)) continue
        M.dact[k] = 1
        sel = select((1::rows(pos)), ex)
        dpos = dpos \ pos[sel]
        drow = drow \ erow[sel]
    }
    M.derived[dpos] = J(rows(dpos), 1, 1)
    nd = rows(dpos)

    // Index of each left-out variable, and of each definition row
    isder = J(rows(M.x0), 1, 0)
    isder[dpos] = (1::nd)
    rowdef = J(M.neq, 1, 0)
    rowdef[drow] = (1::nd)
    // Dependencies of each left-out variable: the other columns of its definition row
    sel = rowdef[M.jr] :> 0
    depk = rowdef[select(M.jr, sel)]
    depj = select(M.jc, sel)
    keep = (isder[depj] :!= depk)
    depk = select(depk, keep)
    depj = select(depj, keep)
    o = order((depk, depj), (1, 2))
    depk = depk[o]
    depj = depj[o]
    dstart = J(nd + 1, 1, 0)
    for (a = 1; a <= rows(depk); a++) dstart[depk[a] + 1] = dstart[depk[a] + 1] + 1
    dstart = runningsum(dstart) :+ 1

    // Pattern of the remaining rows, with left-out variables substituted
    sel = rowdef[M.jr] :== 0
    r = select(M.jr, sel)
    j = select(M.jc, sel)
    dj = isder[j]
    plain = (dj :== 0)
    newr = select(r, plain)
    newc = select(j, plain)
    sel = select((1::rows(r)), 1 :- plain)
    cnt = (rows(sel) ? dstart[dj[sel] :+ 1] - dstart[dj[sel]] : J(0, 1, .))
    xr = J(sum(cnt), 1, .)
    xc = xr
    b = 0
    for (a = 1; a <= rows(sel); a++) {
        if (cnt[a] == 0) continue
        k = dj[sel[a]]
        xr[|b + 1 \ b + cnt[a]|] = J(cnt[a], 1, r[sel[a]])
        xc[|b + 1 \ b + cnt[a]|] = depj[|dstart[k] \ dstart[k + 1] - 1|]
        b = b + cnt[a]
    }
    newr = newr \ xr
    newc = newc \ xc
    // Rows renumbered without the definition rows
    rnew = runningsum(rowdef :== 0) :* (rowdef :== 0)
    M.rmask = M.emask
    M.rmask[select(select((1::rows(M.emask)), M.emask), rowdef :> 0)] = J(nd, 1, 0)
    sel = (M.exists[newc] :* (1 :- M.derived[newc])) :> 0
    o = uniqrows((rnew[select(newr, sel)], select(newc, sel)))
    M.rjr = o[., 1]
    M.rjc = o[., 2]
    M.rdrow = rnew[M.drow]
    M.rdrow2 = rnew[M.drow2]
    if (min(M.rdrow) <= 0) _cge_fail("cge internal error: a row with exact derivatives is left out", 3498)
}

real colvector _cge_F(struct cge_model scalar M, struct cge_par scalar p, real colvector xfix,
                      struct cge_sys scalar S, real colvector z)
{
    real colvector x, L, R, K
    x = xfix
    x[S.free] = z :* M.xscale[S.free]
    if (S.reduced) _cge_derive(M, p, x)
    if (min(x[M.positive]) <= 0 | hasmissing(x)) return(J(S.neq, 1, .))
    // points outside the bounds of cge_bound are rejected (from version 0.9.8)
    if (rows(M.bdlp)) if (any(x[M.bdlp] :< M.bdlv)) return(J(S.neq, 1, .))
    if (rows(M.bdup)) if (any(x[M.bdup] :> M.bduv)) return(J(S.neq, 1, .))
    _cge_eq(M, p, x, L, R, K, 0)
    return(select((L - R) :/ M.escale, S.mask))
}

// Jacobian (Section 4 of docs/design.md). Rows of equations that involve
// many variables -- the price indexes, factor incomes and supplies, government
// revenue and spending, the balance of payments and the savings-investment
// balance -- have exact derivatives (_cge_dense). The other rows are found by
// central differences over groups of columns that share no such row; their
// sparsity pattern follows from the equations (_cge_pattern).
string rowvector _cge_denseblocks()
{
    return(("P8", "P9", "I1", "I8", "I9", "S1", "S3", "S5"))
}

real colvector _cge_vcols(struct cge_model scalar M, string scalar name)
{
    return(_cge_vpos(M, _cge_vidx(M, name)))
}

// Row and column indices (row-major) of the non-zero entries of X
void _cge_nz(real matrix X, real colvector i, real colvector j)
{
    real colvector k
    k = select((1::rows(X) * cols(X)), colshape(X, 1) :!= 0)
    if (rows(k) == 0) {
        i = J(0, 1, .)
        j = J(0, 1, .)
        return
    }
    i = floor((k :- 1) :/ cols(X)) :+ 1
    j = mod(k :- 1, cols(X)) :+ 1
}

// Pattern entries: element e of equation block blk depends on element j of variable var
void _cge_sp(struct cge_model scalar M, real colvector rowid, real colvector boff, real colvector pr,
             real colvector pc, string scalar blk, real colvector e, string scalar var, real colvector j)
{
    real scalar k
    if (rows(e) == 0) return
    k = _cge_find(M.ename, blk)
    pr = pr \ rowid[boff[k] :+ e]
    pc = pc \ (M.voff[_cge_vidx(M, var)] :+ (rows(j) == 1 ? J(rows(e), 1, j) : j))
}

// Each element of block blk depends on the same element of every variable in vars
void _cge_sp_same(struct cge_model scalar M, real colvector rowid, real colvector boff, real colvector pr,
                  real colvector pc, string scalar blk, string rowvector vars)
{
    real colvector e
    real scalar v
    e = (1::M.elen[_cge_find(M.ename, blk)])
    for (v = 1; v <= cols(vars); v++) _cge_sp(M, rowid, boff, pr, pc, blk, e, vars[v], e)
}

// The pattern of a standalone model (from version 0.13.0): the constraints
// and the user equations, with no rows of exact derivatives of their own and
// no definitions left out of the reduced system, which is the full one
void _cge_pattern_sa(struct cge_model scalar M, real colvector rowid, real colvector boff)
{
    real colvector pr, pc, j, keep
    real matrix P, utk
    real scalar g, k
    pr = pc = J(0, 1, .)
    g = _cge_find(M.ename, "B1")
    if (M.elen[g]) {
        pr = pr \ rowid[boff[g] :+ (1::M.elen[g])] \ rowid[boff[g] :+ (1::M.elen[g])]
        pc = pc \ M.bY \ M.bX
    }
    g = _cge_find(M.ename, "U")
    for (k = 1; k <= rows(M.uelab); k++) {
        utk = M.utok[|M.ustart[k], 1 \ M.ustart[k] + M.ulen[k] + M.ulen2[k] - 1, 3|]
        j = _cge_which(utk[., 1] :== 2)
        if (rows(j)) {
            pr = pr \ J(rows(j), 1, rowid[boff[g] + k])
            pc = pc \ utk[j, 2]
        }
    }
    keep = J(0, 1, .)
    if (rows(pr)) keep = (pr :> 0) :& M.exists[pc, 1]
    if (any(keep)) {
        P = uniqrows((select(pr, keep), select(pc, keep)))
        M.jr = P[., 1]
        M.jc = P[., 2]
    }
    else M.jr = M.jc = J(0, 1, .)
    M.drow = M.drow2 = J(0, 1, .)
    M.dact = J(rows(_cge_dcandidates()), 1, 0)
    M.derived = J(rows(M.x0), 1, 0)
    M.rmask = M.emask
    M.rjr = M.jr
    M.rjc = M.jc
    M.rdrow = M.rdrow2 = J(0, 1, .)
}

void _cge_pattern(struct cge_model scalar M, struct cge_par scalar p)
{
    real colvector rowid, boff, pr, pc, cA, cC, cD, e, i, j, keep, ce, gp
    real matrix P, utk
    real scalar nA, nC, nF, nH, nD, nI, f, g, k, bb, nr
    string rowvector dense, blks
    string scalar blk

    rowid = runningsum(M.emask) :* M.emask
    boff = runningsum(M.elen) - M.elen
    // a standalone model (from version 0.13.0)
    if (_cge_sa(M)) {
        _cge_pattern_sa(M, rowid, boff)
        return
    }
    nA = M.n
    nC = M.nC
    nF = M.nF
    nH = M.nH
    nD = M.nD
    nI = M.nI
    cA = (1::nA)
    cC = (1::nC)
    cD = (1::nD)
    pr = J(0, 1, .)
    pc = J(0, 1, .)

    // 5.1 Price block
    _cge_sp_same(M, rowid, boff, pr, pc, "P1", ("PM", "RM"))
    _cge_sp(M, rowid, boff, pr, pc, "P1", cC, "EXR", 1)
    _cge_sp(M, rowid, boff, pr, pc, "P1", cC, "TMADJ", 1)
    _cge_nz(p.ici, i, j)
    _cge_sp(M, rowid, boff, pr, pc, "P1", j, "PQ", i)
    _cge_sp_same(M, rowid, boff, pr, pc, "P2", ("PE", "PWE", "RE"))
    _cge_sp(M, rowid, boff, pr, pc, "P2", cC, "EXR", 1)
    _cge_nz(p.ice, i, j)
    _cge_sp(M, rowid, boff, pr, pc, "P2", j, "PQ", i)
    _cge_sp_same(M, rowid, boff, pr, pc, "P3", ("PQ", "QQ", "PD", "QD", "PM", "QM"))
    _cge_nz(p.icm, i, j)
    _cge_sp(M, rowid, boff, pr, pc, "P3", j, "PQ", i)
    _cge_sp(M, rowid, boff, pr, pc, "P3", cC, "TQADJ", 1)
    _cge_nz(p.icd, i, j)
    _cge_sp(M, rowid, boff, pr, pc, "P3", j, "PQ", i)
    _cge_sp_same(M, rowid, boff, pr, pc, "P4", ("PX", "QX", "PD", "QD", "PE", "QE"))
    _cge_sp_same(M, rowid, boff, pr, pc, "P5", "PA")
    _cge_nz(p.theta, i, j)
    _cge_sp(M, rowid, boff, pr, pc, "P5", i, "PX", j)
    // Output from several activities (Section 17.3)
    _cge_nz(M.xac, i, j)
    _cge_sp(M, rowid, boff, pr, pc, "P5", i, "PXAC", (i :- 1) :* nC :+ j)
    _cge_sp(M, rowid, boff, pr, pc, "Q6A", j, "QX", j)
    _cge_sp(M, rowid, boff, pr, pc, "Q6A", j, "QXAC", (i :- 1) :* nC :+ j)
    e = (i :- 1) :* nC :+ j
    _cge_sp(M, rowid, boff, pr, pc, "Q6B", e, "QXAC", e)
    _cge_sp(M, rowid, boff, pr, pc, "Q6B", e, "QA", i)
    for (k = 1; k <= nH; k++) _cge_sp(M, rowid, boff, pr, pc, "Q6B", e, "QHA", (i :- 1) :* nH :+ k)
    _cge_sp(M, rowid, boff, pr, pc, "P5A", e, "PXAC", e)
    _cge_sp(M, rowid, boff, pr, pc, "P5A", e, "PX", j)
    _cge_sp(M, rowid, boff, pr, pc, "P5A", e, "QX", j)
    for (k = 1; k <= rows(i); k++) {
        gp = _cge_which(M.xac[., j[k]])
        _cge_sp(M, rowid, boff, pr, pc, "P5A", J(rows(gp), 1, e[k]), "QXAC", (gp :- 1) :* nC :+ j[k])
    }
    _cge_sp_same(M, rowid, boff, pr, pc, "P6", "PINTA")
    _cge_nz(p.ica, i, j)
    _cge_sp(M, rowid, boff, pr, pc, "P6", j, "PQ", i)
    _cge_sp(M, rowid, boff, pr, pc, "P6", cA, "TVADJ", 1)
    // P7 has exact derivatives (_cge_dense2)

    // 5.2 Production block
    _cge_sp_same(M, rowid, boff, pr, pc, "Q1", ("QVA", "QA"))
    _cge_sp_same(M, rowid, boff, pr, pc, "Q2", ("QINTA", "QA"))
    _cge_sp_same(M, rowid, boff, pr, pc, "Q1C", ("QA", "QVA", "QINTA"))
    _cge_sp_same(M, rowid, boff, pr, pc, "Q2C", ("QVA", "QINTA", "PVA", "PINTA"))
    _cge_sp_same(M, rowid, boff, pr, pc, "Q3", "QVA")
    _cge_nz(M.fa, i, j)
    _cge_sp(M, rowid, boff, pr, pc, "Q3", j, "QF", (i :- 1) :* nA :+ j)
    _cge_nz(M.fa, i, j)
    _cge_sp(M, rowid, boff, pr, pc, "Q3", j, "EFF", i)
    _cge_sp(M, rowid, boff, pr, pc, "Q3", j, "DW", i)
    _cge_sp_same(M, rowid, boff, pr, pc, "Q4", ("WFDIST", "QF"))
    for (f = 1; f <= nF; f++) {
        e = (f - 1) * nA :+ cA
        _cge_sp(M, rowid, boff, pr, pc, "Q4", e, "W", f)
        _cge_sp(M, rowid, boff, pr, pc, "Q4", e, "PVA", cA)
        _cge_sp(M, rowid, boff, pr, pc, "Q4", e, "QVA", cA)
        for (g = 1; g <= nF; g++) {
            _cge_sp(M, rowid, boff, pr, pc, "Q4", e, "QF", (g - 1) * nA :+ cA)
            _cge_sp(M, rowid, boff, pr, pc, "Q4", e, "EFF", g)
            _cge_sp(M, rowid, boff, pr, pc, "Q4", e, "DW", g)
        }
    }
    // Nests of value added (Section 17.2): Q3 and Q4 depend on the nests of
    // each activity, and N1 to N3 on every member and nest of the activity
    // and on its value added (a few entries of the pattern may be zero)
    if (M.nN) {
        ce = _cge_which(M.nestc :> 0)
        for (k = 1; k <= M.nN; k++) {
            e = (k - 1) * nA :+ cA
            _cge_sp(M, rowid, boff, pr, pc, "Q3", cA, "QNA", e)
            for (f = 1; f <= nF; f++) {
                _cge_sp(M, rowid, boff, pr, pc, "Q4", (f - 1) * nA :+ cA, "PNA", e)
                _cge_sp(M, rowid, boff, pr, pc, "Q4", (f - 1) * nA :+ cA, "QNA", e)
            }
        }
        for (g = 1; g <= rows(ce); g++) {
            for (f = 1; f <= nF; f++) {
                _cge_sp(M, rowid, boff, pr, pc, "Q4", (f - 1) * nA :+ cA, "QINT", (ce[g] - 1) * nA :+ cA)
            }
        }
        blks = ("N1", "N2", "N3")
        for (bb = 1; bb <= 3; bb++) {
            blk = blks[bb]
            nr = (bb < 3 ? M.nN : rows(ce))
            for (k = 1; k <= nr; k++) {
                e = (bb < 3 ? (k - 1) * nA :+ cA : (ce[k] - 1) * nA :+ cA)
                _cge_sp(M, rowid, boff, pr, pc, blk, e, "PVA", cA)
                _cge_sp(M, rowid, boff, pr, pc, blk, e, "QVA", cA)
                for (f = 1; f <= nF; f++) {
                    _cge_sp(M, rowid, boff, pr, pc, blk, e, "QF", (f - 1) * nA :+ cA)
                    _cge_sp(M, rowid, boff, pr, pc, blk, e, "EFF", f)
                    _cge_sp(M, rowid, boff, pr, pc, blk, e, "DW", f)
                }
                for (g = 1; g <= rows(ce); g++) _cge_sp(M, rowid, boff, pr, pc, blk, e, "QINT", (ce[g] - 1) * nA :+ cA)
                for (g = 1; g <= M.nN; g++) {
                    _cge_sp(M, rowid, boff, pr, pc, blk, e, "PNA", (g - 1) * nA :+ cA)
                    _cge_sp(M, rowid, boff, pr, pc, blk, e, "QNA", (g - 1) * nA :+ cA)
                }
                if (bb == 3) {
                    _cge_sp(M, rowid, boff, pr, pc, blk, e, "PQ", ce[k])
                    _cge_sp(M, rowid, boff, pr, pc, blk, e, "TVADJ", 1)
                }
            }
        }
    }
    _cge_sp(M, rowid, boff, pr, pc, "H1", 1, "HS", 1)
    i = select(cC, M.chs)
    for (k = 1; k <= rows(i); k++) {
        _cge_sp(M, rowid, boff, pr, pc, "H1", J(nH, 1, 1), "QH", (i[k] - 1) * nH :+ (1::nH))
        _cge_sp(M, rowid, boff, pr, pc, "H1", 1, "QG", i[k])
        _cge_sp(M, rowid, boff, pr, pc, "H1", 1, "QSHI", i[k])
    }
    _cge_sp_same(M, rowid, boff, pr, pc, "H2", "EFF")
    _cge_sp(M, rowid, boff, pr, pc, "H2", (1::nF), "HS", 1)
    _cge_sp_same(M, rowid, boff, pr, pc, "H3", "DW")
    _cge_sp(M, rowid, boff, pr, pc, "H3", (1::nF), "HS", 1)
    e = (1::nC * nA)
    _cge_sp(M, rowid, boff, pr, pc, "Q5", e, "QINT", e)
    _cge_sp(M, rowid, boff, pr, pc, "Q5", e, "QINTA", mod(e :- 1, nA) :+ 1)
    _cge_sp_same(M, rowid, boff, pr, pc, "Q6", "QX")
    _cge_nz(p.theta, i, j)
    _cge_sp(M, rowid, boff, pr, pc, "Q6", j, "QA", i)
    for (k = 1; k <= nH; k++) _cge_sp(M, rowid, boff, pr, pc, "Q6", j, "QHA", (i :- 1) :* nH :+ k)

    // 5.3 Trade block
    _cge_sp_same(M, rowid, boff, pr, pc, "T1", ("QX", "QE", "QD"))
    _cge_sp_same(M, rowid, boff, pr, pc, "T2", ("QE", "QD", "PE", "PD"))
    _cge_sp_same(M, rowid, boff, pr, pc, "T3", ("QX", "QD"))
    _cge_sp_same(M, rowid, boff, pr, pc, "T3E", ("QX", "QE"))
    _cge_sp_same(M, rowid, boff, pr, pc, "T4", ("QQ", "QM", "QD"))
    _cge_sp_same(M, rowid, boff, pr, pc, "T5", ("QM", "QD", "PD", "PM"))
    _cge_nz(p.icd, i, j)
    _cge_sp(M, rowid, boff, pr, pc, "T5", j, "PQ", i)
    _cge_sp_same(M, rowid, boff, pr, pc, "T6", ("QQ", "QD"))
    _cge_sp_same(M, rowid, boff, pr, pc, "T7", ("QQ", "QM"))
    _cge_sp_same(M, rowid, boff, pr, pc, "T8", "QT")
    _cge_nz(p.icm, i, j)
    _cge_sp(M, rowid, boff, pr, pc, "T8", i, "QQ", j)
    _cge_nz(p.icd, i, j)
    _cge_sp(M, rowid, boff, pr, pc, "T8", i, "QD", j)
    _cge_nz(p.ici, i, j)
    _cge_sp(M, rowid, boff, pr, pc, "T8", i, "QM", j)
    _cge_nz(p.ice, i, j)
    _cge_sp(M, rowid, boff, pr, pc, "T8", i, "QE", j)
    _cge_sp_same(M, rowid, boff, pr, pc, "T9", ("QER", "PQ"))
    _cge_sp(M, rowid, boff, pr, pc, "T9", cC, "EXR", 1)
    _cge_sp_same(M, rowid, boff, pr, pc, "T10", ("QE", "PWE"))

    // 5.4 Institution block
    e = (1::nI * nF)
    _cge_sp(M, rowid, boff, pr, pc, "I2", e, "YIF", e)
    _cge_sp(M, rowid, boff, pr, pc, "I2", e, "YF", mod(e :- 1, nF) :+ 1)
    _cge_sp_same(M, rowid, boff, pr, pc, "I3", "YI")
    for (f = 1; f <= nF; f++) _cge_sp(M, rowid, boff, pr, pc, "I3", cD, "YIF", (cD :- 1) :* nF :+ f)
    for (k = 1; k <= nD; k++) {
        _cge_sp(M, rowid, boff, pr, pc, "I3", cD, "YI", k)
        _cge_sp(M, rowid, boff, pr, pc, "I3", cD, "MPS", k)
        _cge_sp(M, rowid, boff, pr, pc, "I3", cD, "TINS", k)
    }
    _cge_sp(M, rowid, boff, pr, pc, "I3", cD, "CPI", 1)
    _cge_sp(M, rowid, boff, pr, pc, "I3", cD, "EXR", 1)
    // Rents received by households and enterprises (Section 16.1)
    for (k = 1; k <= nC; k++) {
        g = p.rrm[k] - nF
        if (g >= 1 & g <= nD) {
            _cge_sp(M, rowid, boff, pr, pc, "I3", g, "RM", k)
            _cge_sp(M, rowid, boff, pr, pc, "I3", g, "QM", k)
        }
        g = p.rre[k] - nF
        if (g >= 1 & g <= nD) {
            _cge_sp(M, rowid, boff, pr, pc, "I3", g, "RE", k)
            _cge_sp(M, rowid, boff, pr, pc, "I3", g, "QE", k)
            _cge_sp(M, rowid, boff, pr, pc, "I3", g, "PWE", k)
        }
    }
    for (k = 1; k <= nA; k++) {
        g = p.rra[k] - nF
        if (g >= 1 & g <= nD) {
            _cge_sp(M, rowid, boff, pr, pc, "I3", g, "RA", k)
            _cge_sp(M, rowid, boff, pr, pc, "I3", g, "PA", k)
            _cge_sp(M, rowid, boff, pr, pc, "I3", g, "QA", k)
        }
    }
    _cge_sp_same(M, rowid, boff, pr, pc, "I4", "EH")
    _cge_sp(M, rowid, boff, pr, pc, "I4", (1::nH), "MPS", (1::nH))
    _cge_sp(M, rowid, boff, pr, pc, "I4", (1::nH), "TINS", (1::nH))
    _cge_sp(M, rowid, boff, pr, pc, "I4", (1::nH), "YI", (1::nH))
    e = (1::nC * nH)
    _cge_sp(M, rowid, boff, pr, pc, "I5", e, "QH", e)
    _cge_sp(M, rowid, boff, pr, pc, "I5", e, "PQ", floor((e :- 1) :/ nH) :+ 1)
    _cge_sp(M, rowid, boff, pr, pc, "I5", e, "EH", mod(e :- 1, nH) :+ 1)
    _cge_sp(M, rowid, boff, pr, pc, "I5", e, "TVADJ", 1)
    // LES: every purchase of household h depends on the prices of its subsistence quantities
    for (k = 1; k <= nH; k++) {
        i = select(cC, p.gamma[., k] :!= 0)
        for (g = 1; g <= rows(i); g++) _cge_sp(M, rowid, boff, pr, pc, "I5", (cC :- 1) :* nH :+ k, "PQ", i[g])
        i = select(cA, p.gammah[., k] :!= 0)
        for (g = 1; g <= rows(i); g++) _cge_sp(M, rowid, boff, pr, pc, "I5", (cC :- 1) :* nH :+ k, "PA", i[g])
    }
    // Home consumption (13.1): own price, spending, and subsistence prices
    e = (1::nA * nH)
    _cge_sp(M, rowid, boff, pr, pc, "I5H", e, "QHA", e)
    _cge_sp(M, rowid, boff, pr, pc, "I5H", e, "PA", floor((e :- 1) :/ nH) :+ 1)
    _cge_sp(M, rowid, boff, pr, pc, "I5H", e, "EH", mod(e :- 1, nH) :+ 1)
    _cge_sp(M, rowid, boff, pr, pc, "I5H", e, "TVADJ", 1)
    for (k = 1; k <= nH; k++) {
        i = select(cC, p.gamma[., k] :!= 0)
        for (g = 1; g <= rows(i); g++) _cge_sp(M, rowid, boff, pr, pc, "I5H", (cA :- 1) :* nH :+ k, "PQ", i[g])
        i = select(cA, p.gammah[., k] :!= 0)
        for (g = 1; g <= rows(i); g++) _cge_sp(M, rowid, boff, pr, pc, "I5H", (cA :- 1) :* nH :+ k, "PA", i[g])
    }
    _cge_sp_same(M, rowid, boff, pr, pc, "I6", "QINV")
    _cge_sp(M, rowid, boff, pr, pc, "I6", cC, "IADJ", 1)
    _cge_sp_same(M, rowid, boff, pr, pc, "I7", "QG")
    _cge_sp(M, rowid, boff, pr, pc, "I7", cC, "GADJ", 1)
    _cge_sp_same(M, rowid, boff, pr, pc, "I10", "TINS")
    _cge_sp(M, rowid, boff, pr, pc, "I10", cD, "TINSADJ", 1)
    _cge_sp_same(M, rowid, boff, pr, pc, "I11", "MPS")
    _cge_sp(M, rowid, boff, pr, pc, "I11", cD, "MPSADJ", 1)
    _cge_sp(M, rowid, boff, pr, pc, "I12", 1, "YSHI", 1)
    _cge_sp(M, rowid, boff, pr, pc, "I12", J(nF, 1, 1), "YIF", (nI - 1) * nF :+ (1::nF))
    _cge_sp(M, rowid, boff, pr, pc, "I12", 1, "CPI", 1)
    _cge_sp(M, rowid, boff, pr, pc, "I12", 1, "EXR", 1)
    _cge_sp_same(M, rowid, boff, pr, pc, "I13", "QSHI")
    _cge_sp(M, rowid, boff, pr, pc, "I13", cC, "SHIADJ", 1)
    _cge_sp(M, rowid, boff, pr, pc, "I14", J(nC, 1, 1), "PQ", cC)
    _cge_sp(M, rowid, boff, pr, pc, "I14", J(nC, 1, 1), "QSHI", cC)
    _cge_sp(M, rowid, boff, pr, pc, "I14", 1, "YSHI", 1)
    _cge_sp(M, rowid, boff, pr, pc, "I14", 1, "TVADJ", 1)

    // Labour-market regimes (Section 14)
    _cge_sp_same(M, rowid, boff, pr, pc, "L1", ("W", "QFS", "LSW"))
    _cge_sp(M, rowid, boff, pr, pc, "L1", (1::nF), "CPI", 1)
    _cge_sp_same(M, rowid, boff, pr, pc, "L2", ("W", "QFS", "LSM"))
    _cge_sp(M, rowid, boff, pr, pc, "L2", (1::nF), "CPI", 1)

    // 5.5 System constraints
    // S2 has exact derivatives (_cge_dense2)
    _cge_sp(M, rowid, boff, pr, pc, "S4", 1, "YG", 1)
    _cge_sp(M, rowid, boff, pr, pc, "S4", 1, "EG", 1)
    _cge_sp(M, rowid, boff, pr, pc, "S4", 1, "GSAV", 1)

    // Constraints (Section 16.2): the limited and the adjusting variable
    g = _cge_find(M.ename, "B1")
    if (M.elen[g]) {
        pr = pr \ rowid[boff[g] :+ (1::M.elen[g])] \ rowid[boff[g] :+ (1::M.elen[g])]
        pc = pc \ M.bY \ M.bX
    }

    // User equations (Section 19): each element depends on the variables it uses
    g = _cge_find(M.ename, "U")
    for (k = 1; k <= rows(M.uelab); k++) {
        utk = M.utok[|M.ustart[k], 1 \ M.ustart[k] + M.ulen[k] + M.ulen2[k] - 1, 3|]
        j = _cge_which(utk[., 1] :== 2)
        if (rows(j)) {
            pr = pr \ J(rows(j), 1, rowid[boff[g] + k])
            pc = pc \ utk[j, 2]
        }
    }

    // Keep existing equations and variables
    keep = (pr :> 0) :& M.exists[pc]
    P = uniqrows((select(pr, keep), select(pc, keep)))
    M.jr = P[., 1]
    M.jc = P[., 2]

    // Rows with exact derivatives, in the order of _cge_dense
    dense = _cge_denseblocks()
    M.drow = J(0, 1, .)
    for (k = 1; k <= cols(dense); k++) {
        g = _cge_find(M.ename, dense[k])
        M.drow = M.drow \ rowid[boff[g] :+ (1::M.elen[g])]
    }
    if (min(M.drow) <= 0) _cge_fail("cge internal error: an equation with exact derivatives is masked", 3498)
    // Rows of S2 and P7, in the order of _cge_dense2
    // (commodities without composite supply have no S2 row)
    M.drow2 = rowid[boff[_cge_find(M.ename, "S2")] :+ select((1::M.nC), M.cq)] \
              rowid[boff[_cge_find(M.ename, "P7")] :+ (1::M.n)]
    if (min(M.drow2) <= 0) _cge_fail("cge internal error: an equation with exact derivatives is masked", 3498)
    _cge_reduce_setup(M, rowid, boff)
}

// Exact derivatives of the rows of _cge_denseblocks() with respect to every
// stacked variable (unscaled): rows P8, P9, I1 (one per factor), I8, I9, S1 (one
// per factor), S3, S5
real matrix _cge_dense(struct cge_model scalar M, struct cge_par scalar p, real colvector x)
{
    real matrix G, WFD, QF, YIF, QH, QINT
    real colvector PQ, QQ, QM, QE, PA, QA, QG, QINV, QER, YI, TINS, MPS, W, cQF, cWFD, cYIF
    real colvector QSHI, tq, tm, tv, PH, vbase, cQH, cQINT, PWE, pwe, YF
    real scalar EXR, FSAV, nA, nF, nD, nH, f, r, A, B, c, TQADJ, TMADJ, TVADJ

    // a standalone model has no rows of exact derivatives (from version 0.13.0)
    if (_cge_sa(M)) return(J(0, rows(x), 0))
    nA = M.n
    nF = M.nF
    nD = M.nD
    G = J(6 + 2 * nF, rows(x), 0)
    PQ = _cge_v(M, x, 8);    QQ = _cge_v(M, x, 22);   QM = _cge_v(M, x, 21)
    QE = _cge_v(M, x, 20);   PA = _cge_v(M, x, 1);    QA = _cge_v(M, x, 13)
    QG = _cge_v(M, x, 24);   QINV = _cge_v(M, x, 25); QER = _cge_v(M, x, 44)
    YI = _cge_v(M, x, 29);   TINS = _cge_v(M, x, 35); MPS = _cge_v(M, x, 36)
    W = _cge_v(M, x, 9);     WFD = _cge_v(M, x, 41);  QF = _cge_v(M, x, 16)
    YIF = _cge_v(M, x, 28)
    EXR = _cge_v(M, x, 10);  FSAV = _cge_v(M, x, 34)
    QH = _cge_v(M, x, 23);   QINT = _cge_v(M, x, 17); QSHI = _cge_v(M, x, 47)
    TQADJ = _cge_v(M, x, 50); TMADJ = _cge_v(M, x, 51); TVADJ = _cge_v(M, x, 52)
    PWE = _cge_v(M, x, 53)
    pwe = M.ced :* PWE + (1 :- M.ced) :* p.pwe
    nH = M.nH
    tq = p.tq :* TQADJ
    tm = p.tm :* TMADJ
    tv = p.tv :* TVADJ
    PH = PQ :* (1 :+ tv)
    // VAT base by commodity: final demand and the inputs activities cannot recover
    vbase = rowsum(QH) + QG + QINV + QSHI + rowsum(QINT :* (1 :- p.kappa)')
    cQH = _cge_vcols(M, "QH")
    cQINT = _cge_vcols(M, "QINT")
    cQF = _cge_vcols(M, "QF")
    cWFD = _cge_vcols(M, "WFDIST")
    cYIF = _cge_vcols(M, "YIF")

    // P8, P9: price indexes
    G[1, _cge_vcols(M, "CPI")] = 1
    G[1, _cge_vcols(M, "PQ")'] = -(p.cwts :* (1 :+ tv))'
    G[1, _cge_vcols(M, "TVADJ")] = -sum(p.cwts :* PQ :* p.tv)
    G[2, _cge_vcols(M, "DPI")] = 1
    G[2, _cge_vcols(M, "PD")'] = -p.dwts'
    // I1: factor incomes
    for (f = 1; f <= nF; f++) {
        r = 2 + f
        G[r, _cge_vcols(M, "YF")[f]] = 1
        G[r, _cge_vcols(M, "W")[f]] = -(WFD[f, .] * QF[f, .]')
        G[r, cWFD[|(f - 1) * nA + 1 \ f * nA|]'] = -W[f] :* QF[f, .]
        G[r, cQF[|(f - 1) * nA + 1 \ f * nA|]'] = -W[f] :* WFD[f, .]
        G[r, _cge_vcols(M, "EXR")] = -p.trfr[f]
        _cge_rent_grad(M, p, x, f, G, r, -1, 0)
    }
    // I8: government revenue
    r = 3 + nF
    G[r, _cge_vcols(M, "YG")] = 1
    G[r, _cge_vcols(M, "TINS")'] = -YI'
    G[r, _cge_vcols(M, "YI")'] = -TINS'
    G[r, _cge_vcols(M, "PQ")'] = -(tq :* QQ + tv :* vbase)'
    G[r, _cge_vcols(M, "QQ")'] = -(tq :* PQ)'
    G[r, _cge_vcols(M, "QM")'] = -EXR :* (tm :* p.pwm)'
    G[r, _cge_vcols(M, "QE")'] = -EXR :* (p.te :* pwe)'
    G[r, _cge_vcols(M, "PWE")'] = -EXR :* (M.ced :* p.te :* QE)'
    G[r, _cge_vcols(M, "EXR")] = -(sum(tm :* p.pwm :* QM) + sum(p.te :* pwe :* QE) + p.trgr)
    G[r, _cge_vcols(M, "TQADJ")] = -sum(p.tq :* PQ :* QQ)
    G[r, _cge_vcols(M, "TMADJ")] = -EXR * sum(p.tm :* p.pwm :* QM)
    G[r, _cge_vcols(M, "TVADJ")] = -sum(p.tv :* PQ :* vbase)
    // VAT on each use
    G[r, _cge_vcols(M, "QG")'] = -(tv :* PQ)'
    G[r, _cge_vcols(M, "QINV")'] = -(tv :* PQ)'
    G[r, _cge_vcols(M, "QSHI")'] = -(tv :* PQ)'
    for (c = 1; c <= M.nC; c++) {
        if (tv[c] == 0) continue
        G[r, cQH[|(c - 1) * nH + 1 \ c * nH|]'] = J(1, nH, -tv[c] * PQ[c])
        G[r, cQINT[|(c - 1) * nA + 1 \ c * nA|]'] = -tv[c] * PQ[c] :* (1 :- p.kappa)'
    }
    G[r, _cge_vcols(M, "PA")'] = -(p.ta :* QA)'
    G[r, _cge_vcols(M, "QA")'] = -(p.ta :* PA)'
    G[r, cYIF[|nD * nF + 1 \ (nD + 1) * nF|]'] = J(1, nF, -1)
    G[r, _cge_vcols(M, "CPI")] = -p.trgg
    _cge_rent_grad(M, p, x, nF + nD + 1, G, r, -1, 0)
    // taxes on factor use and income (from version 0.5.0)
    YF = _cge_v(M, x, 27)
    for (f = 1; f <= nF; f++) {
        if (!any(p.tf[f, .]) & p.tfy[f] == 0) continue
        c = _cge_vcols(M, "W")[f]
        G[r, c] = G[r, c] - p.tf[f, .] * (WFD[f, .] :* QF[f, .])'
        G[r, cWFD[|(f - 1) * nA + 1 \ f * nA|]'] = G[r, cWFD[|(f - 1) * nA + 1 \ f * nA|]'] - p.tf[f, .] :* W[f] :* QF[f, .]
        G[r, cQF[|(f - 1) * nA + 1 \ f * nA|]'] = G[r, cQF[|(f - 1) * nA + 1 \ f * nA|]'] - p.tf[f, .] :* W[f] :* WFD[f, .]
        c = _cge_vcols(M, "YF")[f]
        G[r, c] = G[r, c] - p.tfy[f]
    }
    // I9: government spending
    r = 4 + nF
    G[r, _cge_vcols(M, "EG")] = 1
    G[r, _cge_vcols(M, "PQ")'] = -((1 :+ tv) :* QG)'
    G[r, _cge_vcols(M, "QG")'] = -PH'
    G[r, _cge_vcols(M, "TVADJ")] = -sum(p.tv :* PQ :* QG)
    G[r, _cge_vcols(M, "CPI")] = -(sum(p.trdg) + p.trgg + p.trshi)
    G[r, _cge_vcols(M, "EXR")] = -(p.trrg + p.rf * p.fdebt)
    // S1: factor markets
    for (f = 1; f <= nF; f++) {
        r = 4 + nF + f
        G[r, cQF[|(f - 1) * nA + 1 \ f * nA|]'] = M.fa[f, .]
        G[r, _cge_vcols(M, "QFS")[f]] = -1
    }
    // S3: balance of payments
    r = 5 + 2 * nF
    A = sum(YIF[nD + 2, .]) + p.shir' * ((1 :- MPS) :* (1 :- TINS) :* YI)
    B = sum(M.cr :* PQ :* QER)
    G[r, _cge_vcols(M, "QM")'] = p.pwm'
    G[r, cYIF[|(nD + 1) * nF + 1 \ (nD + 2) * nF|]'] = J(1, nF, 1 / EXR)
    G[r, _cge_vcols(M, "MPS")'] = -(p.shir :* (1 :- TINS) :* YI)' :/ EXR
    G[r, _cge_vcols(M, "TINS")'] = -(p.shir :* (1 :- MPS) :* YI)' :/ EXR
    G[r, _cge_vcols(M, "YI")'] = (p.shir :* (1 :- MPS) :* (1 :- TINS))' :/ EXR
    G[r, _cge_vcols(M, "EXR")] = (B - A) / EXR^2
    G[r, _cge_vcols(M, "QE")'] = -pwe'
    G[r, _cge_vcols(M, "PWE")'] = -(M.ced :* QE)'
    G[r, _cge_vcols(M, "PQ")'] = -(M.cr :* QER)' :/ EXR
    G[r, _cge_vcols(M, "QER")'] = -(M.cr :* PQ)' :/ EXR
    G[r, _cge_vcols(M, "FSAV")] = -1
    _cge_rent_grad(M, p, x, nF + nD + 2, G, r, 1, 1)
    // S5: savings-investment balance
    r = 6 + 2 * nF
    G[r, _cge_vcols(M, "MPS")'] = ((1 :- TINS) :* YI)'
    G[r, _cge_vcols(M, "TINS")'] = -(MPS :* YI)'
    G[r, _cge_vcols(M, "YI")'] = (MPS :* (1 :- TINS))'
    G[r, _cge_vcols(M, "GSAV")] = 1
    G[r, _cge_vcols(M, "YSHI")] = p.sshi
    G[r, _cge_vcols(M, "EXR")] = FSAV
    G[r, _cge_vcols(M, "FSAV")] = EXR
    G[r, _cge_vcols(M, "PQ")'] = -((1 :+ tv) :* QINV)'
    G[r, _cge_vcols(M, "QINV")'] = -PH'
    G[r, _cge_vcols(M, "TVADJ")] = -sum(p.tv :* PQ :* QINV)
    G[r, _cge_vcols(M, "WALRAS")] = -1
    return(G)
}

// Derivatives of the rents paid to recipient code (Section 16.1), times s,
// added to row r of G; with perexr the rents are divided by EXR (S3)
void _cge_rent_grad(struct cge_model scalar M, struct cge_par scalar p, real colvector x, real scalar code,
                    real matrix G, real scalar r, real scalar s, real scalar perexr)
{
    real colvector RM, RE, RA, QM, QE, PA, QA, pwe, sm, se, sa, cRM, cRE, cRA, cQM, cQE, cPA, cQA, cPWE
    real scalar EXR, e, cEXR
    sm = (p.rrm :== code)
    se = (p.rre :== code)
    sa = (p.rra :== code)
    if (!any(sm) & !any(se) & !any(sa)) return
    RM = _cge_vn(M, x, "RM");  RE = _cge_vn(M, x, "RE");  RA = _cge_vn(M, x, "RA")
    QM = _cge_vn(M, x, "QM");  QE = _cge_vn(M, x, "QE");  PA = _cge_vn(M, x, "PA")
    QA = _cge_vn(M, x, "QA");  EXR = _cge_vn(M, x, "EXR")
    pwe = M.ced :* _cge_vn(M, x, "PWE") + (1 :- M.ced) :* p.pwe
    cRM = _cge_vcols(M, "RM"); cRE = _cge_vcols(M, "RE"); cRA = _cge_vcols(M, "RA")
    cQM = _cge_vcols(M, "QM"); cQE = _cge_vcols(M, "QE"); cPA = _cge_vcols(M, "PA")
    cQA = _cge_vcols(M, "QA"); cPWE = _cge_vcols(M, "PWE"); cEXR = _cge_vcols(M, "EXR")
    // Premiums are in local currency, EXR times a foreign-currency amount
    e = (perexr ? 1 : EXR)
    G[r, cRM'] = G[r, cRM'] + s * e :* (sm :* p.pwm :* QM)'
    G[r, cQM'] = G[r, cQM'] + s * e :* (sm :* RM :* p.pwm)'
    G[r, cRE'] = G[r, cRE'] + s * e :* (se :* pwe :* QE)'
    G[r, cQE'] = G[r, cQE'] + s * e :* (se :* RE :* pwe)'
    G[r, cPWE'] = G[r, cPWE'] + s * e :* (se :* M.ced :* RE :* QE)'
    if (!perexr) G[r, cEXR] = G[r, cEXR] + s * (sum(sm :* RM :* p.pwm :* QM) + sum(se :* RE :* pwe :* QE))
    // Rents on output are in local currency
    e = (perexr ? 1 / EXR : 1)
    G[r, cRA'] = G[r, cRA'] + s * e :* (sa :* PA :* QA)'
    G[r, cPA'] = G[r, cPA'] + s * e :* (sa :* RA :* QA)'
    G[r, cQA'] = G[r, cQA'] + s * e :* (sa :* RA :* PA)'
    if (perexr) G[r, cEXR] = G[r, cEXR] - s * sum(sa :* RA :* PA :* QA) / EXR^2
}

// Exact derivatives of the market-clearing rows S2 (one per commodity) and the
// activity-price rows P7 (one per activity), from version 0.2.0, with respect
// to every stacked variable (unscaled). In the reduced system they are total
// derivatives, through the variables computed from explicit definitions
// (_cge_derive): S2 then depends on intermediate input (QINTA) rather than
// QINT, on household spending and prices rather than QH, and P7 on commodity
// prices rather than PINTA. These rows involve many variables, so computing
// them exactly keeps the groups of the central differences few.
real matrix _cge_dense2(struct cge_model scalar M, struct cge_par scalar p, real colvector x,
                        real scalar reduced)
{
    real matrix G
    real colvector PQ, EH, PA, QA, PVA, QVA, PINTA, QINTA, cQQ, cPQ, cEH, cQINTA, cQINT, cQH, cQT
    real colvector cQSHI, cQG, cQINV, cQER, cPA, cQA, cPVA, cQVA, cPINTA, g, gh, cQD, cQM, cQE, RA, cRA
    real scalar nC, nA, nH, c, a, h, r, sh, cSHIADJ

    if (_cge_sa(M)) return(J(0, rows(x), 0))
    nC = M.nC
    nA = M.n
    nH = M.nH
    G = J(nC + nA, rows(x), 0)
    PQ = _cge_vn(M, x, "PQ");        EH = _cge_vn(M, x, "EH")
    PA = _cge_vn(M, x, "PA");        QA = _cge_vn(M, x, "QA")
    PVA = _cge_vn(M, x, "PVA");      QVA = _cge_vn(M, x, "QVA")
    PINTA = _cge_vn(M, x, "PINTA");  QINTA = _cge_vn(M, x, "QINTA")
    cQQ = _cge_vcols(M, "QQ");       cPQ = _cge_vcols(M, "PQ")
    cEH = _cge_vcols(M, "EH");       cQINTA = _cge_vcols(M, "QINTA")
    cQINT = _cge_vcols(M, "QINT");   cQH = _cge_vcols(M, "QH")
    cQT = _cge_vcols(M, "QT");       cQSHI = _cge_vcols(M, "QSHI")
    cQG = _cge_vcols(M, "QG");       cQINV = _cge_vcols(M, "QINV")
    cQER = _cge_vcols(M, "QER");     cSHIADJ = _cge_vcols(M, "SHIADJ")
    cPA = _cge_vcols(M, "PA");       cQA = _cge_vcols(M, "QA")
    cPVA = _cge_vcols(M, "PVA");     cQVA = _cge_vcols(M, "QVA")
    cPINTA = _cge_vcols(M, "PINTA")
    cQD = _cge_vcols(M, "QD");       cQM = _cge_vcols(M, "QM")
    cQE = _cge_vcols(M, "QE")
    RA = _cge_vn(M, x, "RA");        cRA = _cge_vcols(M, "RA")

    // S2: QQ - (sum_a QINT + sum_h QH + QG + QINV + QT + QER + QSHI)
    for (c = 1; c <= nC; c++) {
        G[c, cQQ[c]] = 1
        G[c, cQG[c]] = -1
        G[c, cQINV[c]] = -1
        G[c, cQER[c]] = -M.cr[c]
        if (reduced & M.dact[4]) G[c, cQINTA'] = -p.ica[c, .]
        else G[c, cQINT[|(c - 1) * nA + 1 \ c * nA|]'] = J(1, nA, -1)
        if (reduced & M.dact[7]) {
            G[c, cQQ'] = G[c, cQQ'] - M.ct[c] :* p.icm[c, .]
            G[c, cQD'] = G[c, cQD'] - M.ct[c] :* p.icd[c, .]
            G[c, cQM'] = G[c, cQM'] - M.ct[c] :* p.ici[c, .]
            G[c, cQE'] = G[c, cQE'] - M.ct[c] :* p.ice[c, .]
        }
        else G[c, cQT[c]] = -M.ct[c]
        if (reduced & M.dact[8]) G[c, cSHIADJ] = -p.qshi[c]
        else G[c, cQSHI[c]] = -1
        if (reduced & M.dact[6]) {
            // QH = gamma + beta (EH - PQ'gamma) / PQ for each household
            for (h = 1; h <= nH; h++) {
                if (p.beta[c, h] == 0) continue
                G[c, cEH[h]] = -p.beta[c, h] / PQ[c]
                g = p.gamma[., h]
                gh = p.gammah[., h]
                if (any(g)) G[c, cPQ'] = G[c, cPQ'] + (p.beta[c, h] / PQ[c]) :* g'
                if (any(gh)) G[c, cPA'] = G[c, cPA'] + (p.beta[c, h] / PQ[c]) :* gh'
                sh = EH[h] - PQ' * g - PA' * gh
                G[c, cPQ[c]] = G[c, cPQ[c]] + p.beta[c, h] * sh / PQ[c]^2
            }
        }
        else G[c, cQH[|(c - 1) * nH + 1 \ c * nH|]'] = J(1, nH, -1)
    }
    // P7: PA (1 - ta - RA) QA - PVA QVA - PINTA QINTA
    for (a = 1; a <= nA; a++) {
        r = nC + a
        G[r, cPA[a]] = (1 - p.ta[a] - RA[a]) * QA[a]
        G[r, cQA[a]] = PA[a] * (1 - p.ta[a] - RA[a])
        G[r, cRA[a]] = -PA[a] * QA[a]
        G[r, cPVA[a]] = -QVA[a]
        G[r, cQVA[a]] = -PVA[a]
        G[r, cQINTA[a]] = -PINTA[a]
        if (reduced & M.dact[3]) G[r, cPQ'] = -QINTA[a] :* p.ica[., a]'
        else G[r, cPINTA[a]] = -QINTA[a]
    }
    // Commodities without composite supply have no S2 row
    return(G[(select((1::nC), M.cq) \ (nC :+ (1::nA))), .])
}

// Groups of free variables for the Jacobian: a greedy colouring, most
// connected columns first, in which the columns of a group share no equation
// (Curtis, Powell and Reid, 1974)
struct cge_jpat scalar _cge_jpat_make(struct cge_model scalar M, struct cge_sys scalar S)
{
    struct cge_jpat scalar G
    real colvector map, keep, r0, c0, o, cs, rs, rcol, ccnt, rcnt, gcnt, rstart, colour, forbid
    real scalar n, nnz, k, s, j, a, b, i, col, nc

    n = rows(S.free)
    map = J(rows(M.x0), 1, 0)
    map[S.free] = (1::n)
    keep = map[S.jc] :> 0
    r0 = select(S.jr, keep)
    c0 = map[select(S.jc, keep)]
    nnz = rows(r0)
    o = order((c0, r0), (1, 2))
    G.crow = r0[o]
    cs = c0[o]
    o = order((r0, c0), (1, 2))
    rcol = c0[o]
    rs = r0[o]
    ccnt = J(n, 1, 0)
    rcnt = J(S.neq, 1, 0)
    for (k = 1; k <= nnz; k++) {
        ccnt[cs[k]] = ccnt[cs[k]] + 1
        rcnt[rs[k]] = rcnt[rs[k]] + 1
    }
    G.cstart = 1 \ (runningsum(ccnt) :+ 1)
    rstart = 1 \ (runningsum(rcnt) :+ 1)

    colour = J(n, 1, 0)
    forbid = J(n, 1, 0)
    nc = 0
    o = order(-ccnt, 1)
    for (s = 1; s <= n; s++) {
        j = o[s]
        for (a = G.cstart[j]; a < G.cstart[j + 1]; a++) {
            i = G.crow[a]
            for (b = rstart[i]; b < rstart[i + 1]; b++) {
                k = rcol[b]
                if (colour[k]) forbid[colour[k]] = j
            }
        }
        col = 1
        while (forbid[col] == j) col++
        colour[j] = col
        if (col > nc) nc = col
    }
    G.gcol = order((colour, (1::n)), (1, 2))
    gcnt = J(nc, 1, 0)
    for (j = 1; j <= n; j++) gcnt[colour[j]] = gcnt[colour[j]] + 1
    G.gstart = 1 \ (runningsum(gcnt) :+ 1)
    G.ncolour = nc
    return(G)
}

// Finite-difference Jacobian by groups of columns: the residuals at one
// perturbed point per group give the derivatives of all its columns. With
// f0, the residuals at z, the differences are one-sided (from version 0.6.3:
// one evaluation per group); without it, central (two per group).
real matrix _cge_jacobian(struct cge_model scalar M, struct cge_par scalar p, real colvector xfix,
                          struct cge_sys scalar S, real colvector z, struct cge_jpat scalar G,
                          | real colvector f0)
{
    real matrix Jac
    real colvector h, zp, zm, d, cols, rr, x, esc
    real matrix D
    real scalar g, k, j, fwd

    fwd = (args() >= 7 ? rows(f0) > 0 : 0)
    Jac = J(S.neq, rows(z), 0)
    h = (fwd ? 1e-7 : 1e-6) :* rowmax((J(rows(z), 1, 1), abs(z)))
    for (g = 1; g <= G.ncolour; g++) {
        cols = G.gcol[|G.gstart[g] \ G.gstart[g + 1] - 1|]
        zp = z
        zp[cols] = z[cols] + h[cols]
        if (fwd) d = _cge_F(M, p, xfix, S, zp) - f0
        else {
            zm = z
            zm[cols] = z[cols] - h[cols]
            d = _cge_F(M, p, xfix, S, zp) - _cge_F(M, p, xfix, S, zm)
        }
        if (hasmissing(d)) return(J(S.neq, rows(z), .))
        for (k = 1; k <= rows(cols); k++) {
            j = cols[k]
            if (G.cstart[j + 1] == G.cstart[j]) continue
            rr = G.crow[|G.cstart[j] \ G.cstart[j + 1] - 1|]
            Jac[rr, j] = d[rr] :/ ((fwd ? 1 : 2) * h[j])
        }
    }
    x = xfix
    x[S.free] = z :* M.xscale[S.free]
    if (S.reduced) _cge_derive(M, p, x)
    esc = select(M.escale, S.mask)
    if (rows(S.drow)) {
        D = _cge_dense(M, p, x)
        Jac[S.drow, .] = (D[., S.free] :* M.xscale[S.free]') :/ esc[S.drow]
    }
    if (rows(S.drow2)) {
        D = _cge_dense2(M, p, x, S.reduced)
        Jac[S.drow2, .] = (D[., S.free] :* M.xscale[S.free]') :/ esc[S.drow2]
    }
    return(Jac)
}

// The Jacobian of _cge_jacobian as entries, rows ri and columns ci of the
// system and values v (from version 0.10.1, for the sparse LU). Returns 0
// at a point where the equations cannot be evaluated.
real scalar _cge_jac_cdtrip(struct cge_model scalar M, struct cge_par scalar p, real colvector xfix,
                            struct cge_sys scalar S, real colvector z, struct cge_jpat scalar G,
                            real colvector ri, real colvector ci, real colvector v, | real colvector f0)
{
    real colvector h, zp, zm, d, cols, rr, x, esc, isd, sel, vr
    real matrix D, Dr, ij
    real scalar g, k, j, fwd, nb, m

    fwd = (args() >= 10 ? rows(f0) > 0 : 0)
    ri = ci = v = J(rows(G.crow) + 1, 1, .)
    nb = 0
    // the rows with exact derivatives are written whole below
    isd = J(S.neq, 1, 0)
    if (rows(S.drow)) isd[S.drow] = J(rows(S.drow), 1, 1)
    if (rows(S.drow2)) isd[S.drow2] = J(rows(S.drow2), 1, 1)
    h = (fwd ? 1e-7 : 1e-6) :* rowmax((J(rows(z), 1, 1), abs(z)))
    for (g = 1; g <= G.ncolour; g++) {
        cols = G.gcol[|G.gstart[g] \ G.gstart[g + 1] - 1|]
        zp = z
        zp[cols] = z[cols] + h[cols]
        if (fwd) d = _cge_F(M, p, xfix, S, zp) - f0
        else {
            zm = z
            zm[cols] = z[cols] - h[cols]
            d = _cge_F(M, p, xfix, S, zp) - _cge_F(M, p, xfix, S, zm)
        }
        if (hasmissing(d)) return(0)
        for (k = 1; k <= rows(cols); k++) {
            j = cols[k]
            if (G.cstart[j + 1] == G.cstart[j]) continue
            rr = G.crow[|G.cstart[j] \ G.cstart[j + 1] - 1|]
            rr = select(rr, !isd[rr])
            if (!rows(rr) | !cols(rr)) continue
            m = rows(rr)
            ri[|nb + 1 \ nb + m|] = rr
            ci[|nb + 1 \ nb + m|] = J(m, 1, j)
            v[|nb + 1 \ nb + m|] = d[rr] :/ ((fwd ? 1 : 2) * h[j])
            nb = nb + m
        }
    }
    ri = (nb ? ri[|1 \ nb|] : J(0, 1, .))
    ci = (nb ? ci[|1 \ nb|] : J(0, 1, .))
    v = (nb ? v[|1 \ nb|] : J(0, 1, .))
    x = xfix
    x[S.free] = z :* M.xscale[S.free]
    if (S.reduced) _cge_derive(M, p, x)
    esc = select(M.escale, S.mask)
    for (k = 1; k <= 2; k++) {
        D = (k == 1 ? _cge_dense(M, p, x) : _cge_dense2(M, p, x, S.reduced))
        vr = (k == 1 ? S.drow : S.drow2)
        if (!rows(vr)) continue
        Dr = (D[., S.free] :* M.xscale[S.free]') :/ esc[vr]
        sel = selectindex(vec(Dr') :!= 0)
        if (!rows(sel) | !cols(sel)) continue
        ij = (floor((sel :- 1) :/ cols(Dr)) :+ 1, mod(sel :- 1, cols(Dr)) :+ 1)
        ri = ri \ vr[ij[., 1]]
        ci = ci \ ij[., 2]
        v = v \ vec(Dr')[sel]
    }
    return(1)
}

// Column-by-column central-difference Jacobian, kept to check the grouped one
real matrix _cge_jacobian_full(struct cge_model scalar M, struct cge_par scalar p, real colvector xfix,
                               struct cge_sys scalar S, real colvector z)
{
    real matrix Jac
    real colvector zp, zm
    real scalar j, h
    Jac = J(S.neq, rows(z), .)
    for (j = 1; j <= rows(z); j++) {
        h = 1e-6 * max((1, abs(z[j])))
        zp = z
        zm = z
        zp[j] = zp[j] + h
        zm[j] = zm[j] - h
        Jac[., j] = (_cge_F(M, p, xfix, S, zp) - _cge_F(M, p, xfix, S, zm)) / (2 * h)
    }
    return(Jac)
}

// =====================================================================
// Exact Jacobian (from version 0.7.0; Reference Manual, Solution)
// =====================================================================
//
// The derivatives of every equation block are written out below as entries
// of d(L - R)/dx, x the stacked variables, in the form of the equations of
// _cge_eq. User equations are differentiated by forward differentiation of
// their postfix rows. In the reduced system, the variables of the explicit
// definitions left out (_cge_derive) are eliminated by the chain rule.

// Entries of a sparse matrix: row, column and value
struct cge_trip {
    real colvector r, c, v
    real scalar    n
}

void _cge_tinit(struct cge_trip scalar T)
{
    T.r = J(4096, 1, .)
    T.c = T.r
    T.v = T.r
    T.n = 0
}

// Append entries, read row by row; an r, c or v with one element is repeated
void _cge_tadd(struct cge_trip scalar T, real matrix r, real matrix c, real matrix v)
{
    real colvector rr, cc, vv
    real scalar k, cap
    if (rows(r) * cols(r) == 0 | rows(c) * cols(c) == 0 | rows(v) * cols(v) == 0) return
    rr = colshape(r, 1)
    cc = colshape(c, 1)
    vv = colshape(v, 1)
    k = max((rows(rr), rows(cc), rows(vv)))
    if (rows(rr) == 1) rr = J(k, 1, rr)
    if (rows(cc) == 1) cc = J(k, 1, cc)
    if (rows(vv) == 1) vv = J(k, 1, vv)
    if (rows(rr) != k | rows(cc) != k | rows(vv) != k) {
        _cge_fail("cge internal error: Jacobian entries are not conformable", 3200)
    }
    if (T.n + k > rows(T.r)) {
        cap = max((2 * rows(T.r), T.n + k))
        T.r = T.r \ J(cap - rows(T.r), 1, .)
        T.c = T.c \ J(cap - rows(T.c), 1, .)
        T.v = T.v \ J(cap - rows(T.v), 1, .)
    }
    T.r[|T.n + 1 \ T.n + k|] = rr
    T.c[|T.n + 1 \ T.n + k|] = cc
    T.v[|T.n + 1 \ T.n + k|] = vv
    T.n = T.n + k
}

// Entries of d(L - R)/dx for elements e of block blk and elements j of
// variable var, with values v; bo holds the offset of each block
void _cge_jd(struct cge_model scalar M, struct cge_trip scalar T, real colvector bo, string scalar blk,
             real matrix e, string scalar var, real matrix j, real matrix v)
{
    real scalar g, k
    g = _cge_find(M.ename, blk)
    k = _cge_vidx(M, var)
    if (g == 0 | k == 0) _cge_fail("cge internal error: unknown block or variable in the Jacobian", 3498)
    if (M.elen[g] == 0 | M.vrows[k] * M.vcols[k] == 0) return
    if (rows(e) * cols(e) == 0 | rows(j) * cols(j) == 0 | rows(v) * cols(v) == 0) return
    _cge_tadd(T, bo[g] :+ e, M.voff[k] :+ j, v)
}

// The rows of a dense matrix of derivatives (rows by stacked variable) as
// entries of rows e of block blk
void _cge_jdense(struct cge_model scalar M, struct cge_trip scalar T, real colvector bo, string scalar blk,
                 real colvector e, real matrix G)
{
    real colvector i, j, v
    _cge_nzv(G, i, j, v)
    if (rows(i) == 0) return
    _cge_tadd(T, bo[_cge_find(M.ename, blk)] :+ e[i], j, v)
}

// Row, column and value of the non-zero entries of X (row-major)
void _cge_nzv(real matrix X, real colvector i, real colvector j, real colvector v)
{
    real colvector k, xv
    i = J(0, 1, .)
    j = i
    v = i
    if (rows(X) * cols(X) == 0) return
    xv = colshape(X, 1)
    k = selectindex(xv :!= 0)
    if (rows(k) * cols(k) == 0) return
    k = colshape(k, 1)
    i = floor((k :- 1) :/ cols(X)) :+ 1
    j = mod(k :- 1, cols(X)) :+ 1
    v = xv[k]
}

// a where cond is not zero, else b, element by element; unlike
// cond :* a + (1 :- cond) :* b, a missing value in the branch not taken
// does not carry over
real matrix _cge_ifel(real matrix cond, real matrix a, real matrix b)
{
    real colvector r, k, av
    if (rows(b) * cols(b) == 0) return(b)
    r = colshape(b, 1)
    k = selectindex(colshape(cond, 1) :!= 0)
    if (rows(k) * cols(k)) {
        av = colshape(a, 1)
        r[k] = av[k]
    }
    return(colshape(r, cols(b)))
}

// Row and column numbers of an nr x nc matrix
real matrix _cge_rowi(real scalar nr, real scalar nc)
{
    if (nr * nc == 0) return(J(nr, nc, 0))
    return((1::nr) * J(1, nc, 1))
}

real matrix _cge_coli(real scalar nr, real scalar nc)
{
    if (nr * nc == 0) return(J(nr, nc, 0))
    return(J(nr, 1, 1) * (1..nc))
}

// Positions of the elements (i, k) of an nr x nc variable or block
real matrix _cge_el(real matrix i, real matrix k, real scalar nc)
{
    return((i :- 1) :* nc :+ k)
}

// The entries of d(L - R)/dx of every equation element at x
void _cge_jtrip(struct cge_model scalar M, struct cge_par scalar p, real colvector x, struct cge_trip scalar T)
{
    real matrix PA, PVA, PINTA, PX, PD, PE, PM, PQ, W, EXR, CPI
    real matrix QA, QVA, QINTA, QF, QINT, QX, QD, QE, QM, QQ, QH, QG, QINV, QFS
    real matrix YF, YI, EH, TINS, MPS, WFDIST, QT, QER, YSHI, EFF, HS
    real matrix TQADJ, TMADJ, TVADJ, PWE, QHA, DW, RM, RE, RA, QNA, PNA, PXAC, QXAC
    real matrix G, vint, IA, IF, IN, IC, eFA, eNA, eCA, eAC, eCH, eAH, eIF
    real matrix qf, rho, top, cessum, qna, Gq, Gn, rhom, cdm, z, wage, ftax, P, Rt, Rn, pnqn, nsum
    real matrix nested, qint, rf, rc, cdf, cdc, MF, MC, Own, Cross, Mem, ef, Ex, val, dq, m1, m2, m3, m4
    real matrix pe, R3, Ns, R2, rsac, qxac, sxac, lxac, R6, R5, coef, outer, tmp, Sc, Rcd, Rces, rs, k2, ratio, Rc
    real colvector bo, cA, cC, cF, cH, cD, cN, i, j, v, tq, tm, tv, PH, pwe, PDD, q3, z1, unemp, rwage, ub, s
    real rowvector rns
    real scalar nA, nC, nF, nH, nD, nI, nN, f, gg, n, c, a, hh, k, ncac, rr

    nA = M.n
    nC = M.nC
    nF = M.nF
    nH = M.nH
    nD = M.nD
    nI = M.nI
    nN = M.nN
    bo = runningsum(M.elen) - M.elen
    // a standalone model (from version 0.13.0): constraints and user equations
    if (_cge_sa(M)) {
        _cge_jtrip_ub(M, p, x, T, bo)
        return
    }
    cA = (nA ? (1::nA) : J(0, 1, .))
    cC = (nC ? (1::nC) : J(0, 1, .))
    cF = (nF ? (1::nF) : J(0, 1, .))
    cH = (nH ? (1::nH) : J(0, 1, .))
    cD = (nD ? (1::nD) : J(0, 1, .))
    cN = (nN ? (1::nN) : J(0, 1, .))

    PA = _cge_v(M, x, 1);     PVA = _cge_v(M, x, 2);    PINTA = _cge_v(M, x, 3)
    PX = _cge_v(M, x, 4);     PD = _cge_v(M, x, 5);     PE = _cge_v(M, x, 6)
    PM = _cge_v(M, x, 7);     PQ = _cge_v(M, x, 8);     W = _cge_v(M, x, 9)
    EXR = _cge_v(M, x, 10);   CPI = _cge_v(M, x, 11)
    QA = _cge_v(M, x, 13);    QVA = _cge_v(M, x, 14);   QINTA = _cge_v(M, x, 15)
    QF = _cge_v(M, x, 16);    QINT = _cge_v(M, x, 17);  QX = _cge_v(M, x, 18)
    QD = _cge_v(M, x, 19);    QE = _cge_v(M, x, 20);    QM = _cge_v(M, x, 21)
    QQ = _cge_v(M, x, 22);    QH = _cge_v(M, x, 23);    QG = _cge_v(M, x, 24)
    QINV = _cge_v(M, x, 25);  QFS = _cge_v(M, x, 26);   YF = _cge_v(M, x, 27)
    YI = _cge_v(M, x, 29);    EH = _cge_v(M, x, 30)
    TINS = _cge_v(M, x, 35);  MPS = _cge_v(M, x, 36)
    WFDIST = _cge_v(M, x, 41)
    QT = _cge_v(M, x, 43);    QER = _cge_v(M, x, 44);   YSHI = _cge_v(M, x, 45)
    EFF = _cge_v(M, x, 48);   HS = _cge_v(M, x, 49)
    TQADJ = _cge_v(M, x, 50); TMADJ = _cge_v(M, x, 51); TVADJ = _cge_v(M, x, 52)
    PWE = _cge_v(M, x, 53);   QHA = _cge_v(M, x, 54)
    DW = _cge_v(M, x, 57)
    RM = _cge_v(M, x, 58);    RE = _cge_v(M, x, 59);    RA = _cge_v(M, x, 60)
    QNA = _cge_v(M, x, 61);   PNA = _cge_v(M, x, 62)
    PXAC = _cge_v(M, x, 63);  QXAC = _cge_v(M, x, 64)

    tq = p.tq :* TQADJ
    tm = p.tm :* TMADJ
    tv = p.tv :* TVADJ
    PH = PQ :* (1 :+ tv)
    vint = tv * (1 :- p.kappa)'
    pwe = M.ced :* PWE + (1 :- M.ced) :* p.pwe
    PDD = PD + p.icd' * PQ

    // Element numbers: IA activity, IF factor of a factor x activity
    // matrix; eFA its elements, and likewise for the other shapes
    IA = _cge_coli(nF, nA)
    IF = _cge_rowi(nF, nA)
    eFA = _cge_el(IF, IA, nA)

    // Rows with exact derivatives in earlier versions: price indexes P8, P9,
    // factor incomes I1, government revenue and spending I8, I9, factor
    // markets S1, balance of payments S3, savings-investment balance S5
    G = _cge_dense(M, p, x)
    _cge_jdense(M, T, bo, "P8", 1, G[1, .])
    _cge_jdense(M, T, bo, "P9", 1, G[2, .])
    _cge_jdense(M, T, bo, "I1", cF, G[|3, 1 \ 2 + nF, cols(G)|])
    _cge_jdense(M, T, bo, "I8", 1, G[3 + nF, .])
    _cge_jdense(M, T, bo, "I9", 1, G[4 + nF, .])
    _cge_jdense(M, T, bo, "S1", cF, G[|5 + nF, 1 \ 4 + 2 * nF, cols(G)|])
    _cge_jdense(M, T, bo, "S3", 1, G[5 + 2 * nF, .])
    _cge_jdense(M, T, bo, "S5", 1, G[6 + 2 * nF, .])
    G = J(0, 0, .)

    // 5.1 Price block
    _cge_jd(M, T, bo, "P1", cC, "PM", cC, 1)
    _cge_jd(M, T, bo, "P1", cC, "TMADJ", 1, -p.pwm :* p.tm :* EXR)
    _cge_jd(M, T, bo, "P1", cC, "RM", cC, -p.pwm :* EXR)
    _cge_jd(M, T, bo, "P1", cC, "EXR", 1, -p.pwm :* (1 :+ tm :+ RM))
    _cge_nzv(p.ici, i, j, v)
    _cge_jd(M, T, bo, "P1", j, "PQ", i, -v)
    _cge_jd(M, T, bo, "P2", cC, "PE", cC, 1)
    _cge_jd(M, T, bo, "P2", cC, "PWE", cC, -M.ced :* (1 :- p.te :- RE) :* EXR)
    _cge_jd(M, T, bo, "P2", cC, "RE", cC, pwe :* EXR)
    _cge_jd(M, T, bo, "P2", cC, "EXR", 1, -pwe :* (1 :- p.te :- RE))
    _cge_nzv(p.ice, i, j, v)
    _cge_jd(M, T, bo, "P2", j, "PQ", i, v)
    _cge_jd(M, T, bo, "P3", cC, "PQ", cC, (1 :- tq) :* QQ)
    _cge_jd(M, T, bo, "P3", cC, "QQ", cC, PQ :* (1 :- tq) :- (p.icm' * PQ))
    _cge_jd(M, T, bo, "P3", cC, "TQADJ", 1, -p.tq :* PQ :* QQ)
    _cge_jd(M, T, bo, "P3", cC, "PD", cC, -M.cdo :* QD)
    _cge_jd(M, T, bo, "P3", cC, "QD", cC, -M.cdo :* PDD)
    _cge_jd(M, T, bo, "P3", cC, "PM", cC, -M.cm :* QM)
    _cge_jd(M, T, bo, "P3", cC, "QM", cC, -M.cm :* PM)
    _cge_nzv(p.icd, i, j, v)
    if (rows(i)) _cge_jd(M, T, bo, "P3", j, "PQ", i, -M.cdo[j] :* QD[j] :* v)
    _cge_nzv(p.icm, i, j, v)
    if (rows(i)) _cge_jd(M, T, bo, "P3", j, "PQ", i, -v :* QQ[j])
    _cge_jd(M, T, bo, "P4", cC, "PX", cC, QX)
    _cge_jd(M, T, bo, "P4", cC, "QX", cC, PX)
    _cge_jd(M, T, bo, "P4", cC, "PD", cC, -M.cdo :* QD)
    _cge_jd(M, T, bo, "P4", cC, "QD", cC, -M.cdo :* PD)
    _cge_jd(M, T, bo, "P4", cC, "PE", cC, -M.ce :* QE)
    _cge_jd(M, T, bo, "P4", cC, "QE", cC, -M.ce :* PE)
    _cge_jd(M, T, bo, "P5", cA, "PA", cA, 1)
    ncac = any(M.cac)
    _cge_nzv(p.theta :* (ncac ? 1 :- M.xac : J(nA, nC, 1)), i, j, v)
    _cge_jd(M, T, bo, "P5", i, "PX", j, -v)
    if (ncac) {
        _cge_nzv(p.theta :* M.xac, i, j, v)
        _cge_jd(M, T, bo, "P5", i, "PXAC", _cge_el(i, j, nC), -v)
    }
    _cge_jd(M, T, bo, "P6", cA, "PINTA", cA, 1)
    _cge_nzv(p.ica :* (1 :+ vint), i, j, v)
    _cge_jd(M, T, bo, "P6", j, "PQ", i, -v)
    _cge_jd(M, T, bo, "P6", cA, "TVADJ", 1, -((p.ica :* (p.tv * (1 :- p.kappa)'))' * PQ))
    _cge_jd(M, T, bo, "P7", cA, "PA", cA, (1 :- p.ta :- RA) :* QA)
    _cge_jd(M, T, bo, "P7", cA, "QA", cA, PA :* (1 :- p.ta :- RA))
    _cge_jd(M, T, bo, "P7", cA, "RA", cA, -PA :* QA)
    _cge_jd(M, T, bo, "P7", cA, "PVA", cA, -QVA)
    _cge_jd(M, T, bo, "P7", cA, "QVA", cA, -PVA)
    _cge_jd(M, T, bo, "P7", cA, "PINTA", cA, -QINTA)
    _cge_jd(M, T, bo, "P7", cA, "QINTA", cA, -PINTA)

    // 5.2 Production block
    _cge_jd(M, T, bo, "Q1", cA, "QVA", cA, 1)
    _cge_jd(M, T, bo, "Q1", cA, "QA", cA, -p.iva)
    _cge_jd(M, T, bo, "Q2", cA, "QINTA", cA, 1)
    _cge_jd(M, T, bo, "Q2", cA, "QA", cA, -p.inta)
    // Top nest, Cobb-Douglas or CES (Leontief rows are masked)
    rs = p.rha + (p.rha :== 0)
    Rcd = p.aa :* (QVA :^ p.dla) :* (QINTA :^ p.dlac)
    Sc = p.dla :* (QVA :^ (-rs)) + p.dlac :* (QINTA :^ (-rs))
    Rces = p.aa :* (Sc :^ (-1 :/ rs))
    _cge_jd(M, T, bo, "Q1C", cA, "QA", cA, 1)
    _cge_jd(M, T, bo, "Q1C", cA, "QVA", cA,
            -_cge_ifel(M.cda, p.dla :* Rcd :/ QVA, (Rces :/ Sc) :* p.dla :* (QVA :^ (-rs :- 1))))
    _cge_jd(M, T, bo, "Q1C", cA, "QINTA", cA,
            -_cge_ifel(M.cda, p.dlac :* Rcd :/ QINTA, (Rces :/ Sc) :* p.dlac :* (QINTA :^ (-rs :- 1))))
    k2 = 1 :/ (1 :+ p.rha)
    ratio = (PINTA :/ PVA) :* (p.dla :/ p.dlac)
    Rc = QINTA :* (ratio :^ k2)
    _cge_jd(M, T, bo, "Q2C", cA, "PVA", cA, _cge_ifel(M.cda, QVA :* p.dlac, k2 :* Rc :/ PVA))
    _cge_jd(M, T, bo, "Q2C", cA, "QVA", cA, _cge_ifel(M.cda, PVA :* p.dlac, J(nA, 1, 1)))
    _cge_jd(M, T, bo, "Q2C", cA, "PINTA", cA, _cge_ifel(M.cda, -QINTA :* p.dla, -k2 :* Rc :/ PINTA))
    _cge_jd(M, T, bo, "Q2C", cA, "QINTA", cA, _cge_ifel(M.cda, -PINTA :* p.dla, -(ratio :^ k2)))

    // Value added (Q3), factor demand (Q4) and the nests (N1 to N3): the
    // factors enter in efficiency units qf = af EFF DW QF
    z1 = p.af :* EFF :* DW
    z = z1 * J(1, nA, 1)
    qf = M.fa :* (z :* QF) + (1 :- M.fa)
    rho = (M.cd + (1 :- M.cd) :* p.rva)'
    rhom = J(nF, 1, 1) * rho
    cdm = J(nF, 1, 1) * M.cd'
    top = M.fa :* (M.nestf :== 0)
    cessum = colsum(top :* p.dva :* (qf :^ (-rhom)))
    if (nN) {
        qna = M.nn :* QNA + (1 :- M.nn)
        cessum = cessum + colsum(M.nn :* p.dvn :* (qna :^ (-(J(nN, 1, 1) * rho))))
    }
    q3 = (p.ad' :* (cessum :^ (-1 :/ rho)))'
    for (a = 1; a <= nA; a++) {
        if (!M.cd[a]) continue
        q3[a] = p.ad[a] * exp(colsum(top[., a] :* p.dva[., a] :* ln(qf[., a])) +
                              (nN ? colsum(M.nn[., a] :* p.dvn[., a] :* ln(qna[., a])) : 0))
    }
    // dq3/dqf and dq3/dqna
    Gq = _cge_ifel(cdm, (J(nF, 1, 1) * q3') :* top :* p.dva :/ qf,
                   (J(nF, 1, 1) * (q3' :/ cessum)) :* top :* p.dva :* (qf :^ (-rhom :- 1)))
    _cge_jd(M, T, bo, "Q3", cA, "QVA", cA, 1)
    _cge_jd(M, T, bo, "Q3", IA, "QF", eFA, -Gq :* M.fa :* z)
    _cge_jd(M, T, bo, "Q3", IA, "EFF", IF, -Gq :* M.fa :* (p.af :* DW) :* QF)
    _cge_jd(M, T, bo, "Q3", IA, "DW", IF, -Gq :* M.fa :* (p.af :* EFF) :* QF)
    if (nN) {
        IN = _cge_rowi(nN, nA)
        eNA = _cge_el(IN, _cge_coli(nN, nA), nA)
        Gn = _cge_ifel(J(nN, 1, 1) * M.cd', (J(nN, 1, 1) * q3') :* M.nn :* p.dvn :/ qna,
                       (J(nN, 1, 1) * (q3' :/ cessum)) :* M.nn :* p.dvn :* (qna :^ (-(J(nN, 1, 1) * rho) :- 1)))
        _cge_jd(M, T, bo, "Q3", _cge_coli(nN, nA), "QNA", eNA, -Gn :* M.nn)
    }

    // Q4. Regimes of each factor and activity: 1 a factor at the top of CES
    // value added, 2 at the top of Cobb-Douglas value added, 3 in a CES
    // nest, 4 in a Cobb-Douglas nest
    wage = W :* WFDIST
    ftax = 1 :+ p.tf
    P = (PVA :* QVA)'
    nested = M.fa :* (M.nestf :> 0)
    rns = (nN ? (p.rhn + (p.rhn :== 0))' : J(1, 0, .))
    rf = J(nF, 1, 1)
    cdf = J(nF, 1, 0)
    for (f = 1; f <= nF; f++) {
        if (!M.nestf[f]) continue
        rf[f] = rns[M.nestf[f]]
        cdf[f] = M.cdn[M.nestf[f]]
    }
    m1 = top :* (1 :- cdm)
    m2 = top :* cdm
    m3 = nested :* (1 :- cdf)
    m4 = nested :* cdf
    Rt = _cge_ifel(m1, (J(nF, 1, 1) * (P :/ cessum)) :* p.dva :* (qf :^ (-rhom :- 1)) :* z, J(nF, nA, 0))
    if (nN) {
        qint = M.ecell :* QINT + (1 :- M.ecell)
        rc = J(nC, 1, 1)
        cdc = J(nC, 1, 0)
        MF = J(nN, nF, 0)
        MC = J(nN, nC, 0)
        for (f = 1; f <= nF; f++) {
            if (M.nestf[f]) MF[M.nestf[f], f] = 1
        }
        for (c = 1; c <= nC; c++) {
            if (!M.nestc[c]) continue
            rc[c] = rns[M.nestc[c]]
            cdc[c] = M.cdn[M.nestc[c]]
            MC[M.nestc[c], c] = 1
        }
        nsum = MF * (nested :* p.dva :* (qf :^ (-(rf * J(1, nA, 1))))) + MC * (M.ecell :* p.dce :* (qint :^ (-(rc * J(1, nA, 1)))))
        pnqn = PNA :* QNA
        Rn = _cge_ifel(m3, ((MF' * pnqn) :/ (MF' * nsum :+ (M.nestf :== 0))) :* p.dva :* (qf :^ (-(rf * J(1, nA, 1)) :- 1)) :* z,
                       J(nF, nA, 0))
    }
    else Rn = J(nF, nA, 0)
    // The left-hand side: wage, with QF in the Cobb-Douglas regimes
    _cge_jd(M, T, bo, "Q4", eFA, "W", IF, _cge_ifel(m2 + m4, WFDIST :* ftax :* QF, WFDIST :* ftax))
    _cge_jd(M, T, bo, "Q4", eFA, "WFDIST", eFA, _cge_ifel(m2 + m4, (W * J(1, nA, 1)) :* ftax :* QF, (W * J(1, nA, 1)) :* ftax))
    _cge_jd(M, T, bo, "Q4", eFA, "QF", eFA, (m2 + m4) :* wage :* ftax)
    // The right-hand side in the Cobb-Douglas regimes
    _cge_jd(M, T, bo, "Q4", eFA, "PVA", IA, -m2 :* p.dva :* (J(nF, 1, 1) * QVA'))
    _cge_jd(M, T, bo, "Q4", eFA, "QVA", IA, -m2 :* p.dva :* (J(nF, 1, 1) * PVA'))
    if (nN) {
        // nest of each factor, as an element of PNA and QNA
        ef = _cge_el((M.nestf :+ (M.nestf :== 0)) * J(1, nA, 1), IA, nA)
        _cge_jd(M, T, bo, "Q4", eFA, "PNA", ef, -m4 :* p.dva :* (MF' * QNA))
        _cge_jd(M, T, bo, "Q4", eFA, "QNA", ef, -m4 :* p.dva :* (MF' * PNA))
        // CES nests: the nest's value
        _cge_jd(M, T, bo, "Q4", eFA, "PNA", ef, -_cge_ifel(m3, Rn :/ (MF' * PNA :+ (M.nestf :== 0)), J(nF, nA, 0)))
        _cge_jd(M, T, bo, "Q4", eFA, "QNA", ef, -_cge_ifel(m3, Rn :/ (MF' * QNA :+ (M.nestf :== 0)), J(nF, nA, 0)))
    }
    // CES value added: value added and its own aggregate
    _cge_jd(M, T, bo, "Q4", eFA, "PVA", IA, -_cge_ifel(m1, Rt :/ (J(nF, 1, 1) * PVA'), J(nF, nA, 0)))
    _cge_jd(M, T, bo, "Q4", eFA, "QVA", IA, -_cge_ifel(m1, Rt :/ (J(nF, 1, 1) * QVA'), J(nF, nA, 0)))
    // Efficiency units: Rt and Rn are proportional to z
    _cge_jd(M, T, bo, "Q4", eFA, "EFF", IF, -_cge_ifel(m1 + m3, (Rt + Rn) :/ (EFF * J(1, nA, 1)), J(nF, nA, 0)))
    _cge_jd(M, T, bo, "Q4", eFA, "DW", IF, -_cge_ifel(m1 + m3, (Rt + Rn) :/ (DW * J(1, nA, 1)), J(nF, nA, 0)))
    // Through qf: row (f, a) depends on qf(g, a) of the members of its aggregate
    for (f = 1; f <= nF; f++) {
        if (!any(m1[f, .]) & !any(m3[f, .])) continue
        // own term and the term through the CES sum, by activity
        if (any(m1[f, .])) {
            Own = _cge_ifel(m1[f, .], Rt[f, .] :* (-rho :- 1) :/ qf[f, .], J(1, nA, 0))
            Cross = _cge_ifel(m1[f, .], Rt[f, .] :* rho :/ cessum, J(1, nA, 0))
            Ex = rho
        }
        else {
            Ns = nsum[M.nestf[f], .]
            Own = _cge_ifel(m3[f, .], Rn[f, .] :* (-rf[f] - 1) :/ qf[f, .], J(1, nA, 0))
            Cross = _cge_ifel(m3[f, .], Rn[f, .] :* rf[f] :/ Ns, J(1, nA, 0))
            Ex = J(1, nA, rf[f])
        }
        for (gg = 1; gg <= nF; gg++) {
            // members of the aggregate of f: the top of value added, or f's nest
            if (any(m1[f, .])) Mem = top[gg, .] :* p.dva[gg, .] :* (qf[gg, .] :^ (-Ex :- 1))
            else Mem = (M.nestf[gg] == M.nestf[f]) :* nested[gg, .] :* p.dva[gg, .] :* (qf[gg, .] :^ (-Ex :- 1))
            dq = (gg == f) :* Own + Cross :* Mem
            if (!any(dq)) continue
            _cge_jd(M, T, bo, "Q4", (f - 1) * nA :+ cA, "QF", (gg - 1) * nA :+ cA, -(dq :* M.fa[gg, .] :* z[gg, .])')
            _cge_jd(M, T, bo, "Q4", (f - 1) * nA :+ cA, "EFF", J(nA, 1, gg), -(dq :* M.fa[gg, .] :* (p.af[gg] * DW[gg]) :* QF[gg, .])')
            _cge_jd(M, T, bo, "Q4", (f - 1) * nA :+ cA, "DW", J(nA, 1, gg), -(dq :* M.fa[gg, .] :* (p.af[gg] * EFF[gg]) :* QF[gg, .])')
        }
        if (nN) {
            if (any(m1[f, .])) {
                // the nests at the top of CES value added
                for (n = 1; n <= nN; n++) {
                    dq = Cross :* M.nn[n, .] :* p.dvn[n, .] :* (qna[n, .] :^ (-rho :- 1))
                    if (any(dq)) _cge_jd(M, T, bo, "Q4", (f - 1) * nA :+ cA, "QNA", (n - 1) * nA :+ cA, -(dq :* M.nn[n, .])')
                }
            }
            else {
                // the commodities in f's nest
                for (c = 1; c <= nC; c++) {
                    if (M.nestc[c] != M.nestf[f]) continue
                    dq = Cross :* M.ecell[c, .] :* p.dce[c, .] :* (qint[c, .] :^ (-rf[f] - 1))
                    if (any(dq)) _cge_jd(M, T, bo, "Q4", (f - 1) * nA :+ cA, "QINT", (c - 1) * nA :+ cA, -(dq :* M.ecell[c, .])')
                }
            }
        }
    }

    // N1: quantity of each nest; N2: its price; N3: demand for each commodity in a nest
    if (nN) {
        for (n = 1; n <= nN; n++) {
            rr = rns[n]
            // N1
            if (M.cdn[n]) R2 = p.an[n, .] :* exp(MF[n, .] * (nested :* p.dva :* ln(qf)) + MC[n, .] * (M.ecell :* p.dce :* ln(qint)))
            else R2 = p.an[n, .] :* (nsum[n, .] :^ (-1 / rr))
            _cge_jd(M, T, bo, "N1", (n - 1) * nA :+ cA, "QNA", (n - 1) * nA :+ cA, 1)
            for (gg = 1; gg <= nF; gg++) {
                if (M.nestf[gg] != n) continue
                if (M.cdn[n]) dq = R2 :* nested[gg, .] :* p.dva[gg, .] :/ qf[gg, .]
                else dq = (R2 :/ nsum[n, .]) :* nested[gg, .] :* p.dva[gg, .] :* (qf[gg, .] :^ (-rr - 1))
                _cge_jd(M, T, bo, "N1", (n - 1) * nA :+ cA, "QF", (gg - 1) * nA :+ cA, -(dq :* M.fa[gg, .] :* z[gg, .])')
                _cge_jd(M, T, bo, "N1", (n - 1) * nA :+ cA, "EFF", J(nA, 1, gg), -(dq :* M.fa[gg, .] :* (p.af[gg] * DW[gg]) :* QF[gg, .])')
                _cge_jd(M, T, bo, "N1", (n - 1) * nA :+ cA, "DW", J(nA, 1, gg), -(dq :* M.fa[gg, .] :* (p.af[gg] * EFF[gg]) :* QF[gg, .])')
            }
            for (c = 1; c <= nC; c++) {
                if (M.nestc[c] != n) continue
                if (M.cdn[n]) dq = R2 :* M.ecell[c, .] :* p.dce[c, .] :/ qint[c, .]
                else dq = (R2 :/ nsum[n, .]) :* M.ecell[c, .] :* p.dce[c, .] :* (qint[c, .] :^ (-rr - 1))
                _cge_jd(M, T, bo, "N1", (n - 1) * nA :+ cA, "QINT", (c - 1) * nA :+ cA, -(dq :* M.ecell[c, .])')
            }
            // N2: Cobb-Douglas value added: PNA QNA = dvn P; CES: PNA = (P / cessum) dvn qna^(-rho - 1)
            R2 = _cge_ifel(1 :- M.cd', (P :/ cessum) :* p.dvn[n, .] :* (qna[n, .] :^ (-rho :- 1)), J(1, nA, 0))
            _cge_jd(M, T, bo, "N2", (n - 1) * nA :+ cA, "PNA", (n - 1) * nA :+ cA, _cge_ifel(M.cd', QNA[n, .], J(1, nA, 1))')
            _cge_jd(M, T, bo, "N2", (n - 1) * nA :+ cA, "QNA", (n - 1) * nA :+ cA, (M.cd' :* PNA[n, .])')
            _cge_jd(M, T, bo, "N2", (n - 1) * nA :+ cA, "PVA", cA, -_cge_ifel(M.cd', p.dvn[n, .] :* QVA', R2 :/ PVA')')
            _cge_jd(M, T, bo, "N2", (n - 1) * nA :+ cA, "QVA", cA, -_cge_ifel(M.cd', p.dvn[n, .] :* PVA', R2 :/ QVA')')
            Cross = R2 :* rho :/ cessum
            for (k = 1; k <= nN; k++) {
                dq = (k == n) :* _cge_ifel(1 :- M.cd', R2 :* (-rho :- 1) :/ qna[n, .], J(1, nA, 0)) +
                     Cross :* M.nn[k, .] :* p.dvn[k, .] :* (qna[k, .] :^ (-rho :- 1))
                if (any(dq)) _cge_jd(M, T, bo, "N2", (n - 1) * nA :+ cA, "QNA", (k - 1) * nA :+ cA, -(dq :* M.nn[k, .])')
            }
            for (gg = 1; gg <= nF; gg++) {
                dq = Cross :* top[gg, .] :* p.dva[gg, .] :* (qf[gg, .] :^ (-rho :- 1))
                if (!any(dq)) continue
                _cge_jd(M, T, bo, "N2", (n - 1) * nA :+ cA, "QF", (gg - 1) * nA :+ cA, -(dq :* M.fa[gg, .] :* z[gg, .])')
                _cge_jd(M, T, bo, "N2", (n - 1) * nA :+ cA, "EFF", J(nA, 1, gg), -(dq :* M.fa[gg, .] :* (p.af[gg] * DW[gg]) :* QF[gg, .])')
                _cge_jd(M, T, bo, "N2", (n - 1) * nA :+ cA, "DW", J(nA, 1, gg), -(dq :* M.fa[gg, .] :* (p.af[gg] * EFF[gg]) :* QF[gg, .])')
            }
        }
        // N3, by commodity in a nest
        pe = PQ :* (1 :+ vint)
        for (c = 1; c <= nC; c++) {
            n = M.nestc[c]
            if (!n) continue
            rr = rns[n]
            Ns = nsum[n, .]
            if (M.cdn[n]) {
                _cge_jd(M, T, bo, "N3", (c - 1) * nA :+ cA, "PQ", c, ((1 :+ vint[c, .]) :* QINT[c, .])')
                _cge_jd(M, T, bo, "N3", (c - 1) * nA :+ cA, "TVADJ", 1, (PQ[c] * p.tv[c] :* (1 :- p.kappa') :* QINT[c, .])')
                _cge_jd(M, T, bo, "N3", (c - 1) * nA :+ cA, "QINT", (c - 1) * nA :+ cA, pe[c, .]')
                _cge_jd(M, T, bo, "N3", (c - 1) * nA :+ cA, "PNA", (n - 1) * nA :+ cA, -(p.dce[c, .] :* QNA[n, .])')
                _cge_jd(M, T, bo, "N3", (c - 1) * nA :+ cA, "QNA", (n - 1) * nA :+ cA, -(p.dce[c, .] :* PNA[n, .])')
                continue
            }
            R3 = (pnqn[n, .] :/ Ns) :* p.dce[c, .] :* (qint[c, .] :^ (-rr - 1))
            _cge_jd(M, T, bo, "N3", (c - 1) * nA :+ cA, "PQ", c, (1 :+ vint[c, .])')
            _cge_jd(M, T, bo, "N3", (c - 1) * nA :+ cA, "TVADJ", 1, (PQ[c] * p.tv[c] :* (1 :- p.kappa'))')
            _cge_jd(M, T, bo, "N3", (c - 1) * nA :+ cA, "PNA", (n - 1) * nA :+ cA, -(R3 :/ PNA[n, .])')
            _cge_jd(M, T, bo, "N3", (c - 1) * nA :+ cA, "QNA", (n - 1) * nA :+ cA, -(R3 :/ QNA[n, .])')
            Cross = R3 :* rr :/ Ns
            for (k = 1; k <= nC; k++) {
                if (M.nestc[k] != n) continue
                dq = (k == c) :* (R3 :* (-rr - 1) :/ qint[c, .]) + Cross :* M.ecell[k, .] :* p.dce[k, .] :* (qint[k, .] :^ (-rr - 1))
                if (any(dq)) _cge_jd(M, T, bo, "N3", (c - 1) * nA :+ cA, "QINT", (k - 1) * nA :+ cA, -(dq :* M.ecell[k, .])')
            }
            for (gg = 1; gg <= nF; gg++) {
                if (M.nestf[gg] != n) continue
                dq = Cross :* nested[gg, .] :* p.dva[gg, .] :* (qf[gg, .] :^ (-rr - 1))
                if (!any(dq)) continue
                _cge_jd(M, T, bo, "N3", (c - 1) * nA :+ cA, "QF", (gg - 1) * nA :+ cA, -(dq :* M.fa[gg, .] :* z[gg, .])')
                _cge_jd(M, T, bo, "N3", (c - 1) * nA :+ cA, "EFF", J(nA, 1, gg), -(dq :* M.fa[gg, .] :* (p.af[gg] * DW[gg]) :* QF[gg, .])')
                _cge_jd(M, T, bo, "N3", (c - 1) * nA :+ cA, "DW", J(nA, 1, gg), -(dq :* M.fa[gg, .] :* (p.af[gg] * EFF[gg]) :* QF[gg, .])')
            }
        }
    }

    // Health services, factor efficiency and days lost to illness
    i = selectindex(M.chs)
    if (rows(i) * cols(i)) {
        i = colshape(i, 1)
        _cge_jd(M, T, bo, "H1", 1, "HS", 1, 1)
        _cge_jd(M, T, bo, "H1", J(rows(i) * nH, 1, 1), "QH", colshape(_cge_el(i * J(1, nH, 1), J(rows(i), 1, 1) * cH', nH), 1), -1)
        _cge_jd(M, T, bo, "H1", J(rows(i), 1, 1), "QG", i, -1)
        _cge_jd(M, T, bo, "H1", J(rows(i), 1, 1), "QSHI", i, -1)
    }
    else _cge_jd(M, T, bo, "H1", 1, "HS", 1, 1)
    _cge_jd(M, T, bo, "H2", cF, "EFF", cF, 1)
    _cge_jd(M, T, bo, "H2", cF, "HS", 1, -p.etah :* ((HS / p.hs0) :^ (p.etah :- 1)) :/ p.hs0)
    _cge_jd(M, T, bo, "H3", cF, "DW", cF, 1)
    _cge_jd(M, T, bo, "H3", cF, "HS", 1, p.sick :* p.epss :* ((HS / p.hs0) :^ (p.epss :- 1)) :/ (p.hs0 :* (1 :- p.sick0)))
    // Intermediate inputs and marketed output
    IC = _cge_rowi(nC, nA)
    eCA = _cge_el(IC, _cge_coli(nC, nA), nA)
    _cge_jd(M, T, bo, "Q5", eCA, "QINT", eCA, 1)
    _cge_jd(M, T, bo, "Q5", eCA, "QINTA", _cge_coli(nC, nA), -p.ica)
    _cge_nzv(p.theta, i, j, v)
    _cge_jd(M, T, bo, "Q6", cC, "QX", cC, 1)
    _cge_jd(M, T, bo, "Q6", j, "QA", i, -v)
    for (hh = 1; hh <= nH; hh++) _cge_jd(M, T, bo, "Q6", j, "QHA", _cge_el(i, hh, nH), v)
    // Output of a commodity from several activities (Q6A, Q6B, P5A)
    if (ncac) {
        eAC = _cge_el(_cge_rowi(nA, nC), _cge_coli(nA, nC), nC)
        rsac = (M.cac :* (1 :- M.cdac) :* p.rac + (1 :- M.cac :* (1 :- M.cdac)))'
        qxac = M.xac :* QXAC + (1 :- M.xac)
        sxac = colsum(M.xac :* p.dac :* (qxac :^ (-(J(nA, 1, 1) * rsac))))
        lxac = colsum(M.xac :* p.dac :* ln(qxac))
        R6 = p.aac :* (M.cdac :* exp(lxac') + (1 :- M.cdac) :* ((sxac + (sxac :== 0)) :^ (-1 :/ rsac))')
        tmp = _cge_ifel(J(nA, 1, 1) * M.cdac', (J(nA, 1, 1) * R6') :* p.dac :/ qxac,
                        (J(nA, 1, 1) * (R6' :/ (sxac + (sxac :== 0)))) :* p.dac :* (qxac :^ (-(J(nA, 1, 1) * rsac) :- 1)))
        _cge_jd(M, T, bo, "Q6A", cC, "QX", cC, 1)
        _cge_jd(M, T, bo, "Q6A", _cge_coli(nA, nC), "QXAC", eAC, -tmp :* M.xac)
        _cge_jd(M, T, bo, "Q6B", eAC, "QXAC", eAC, 1)
        _cge_jd(M, T, bo, "Q6B", eAC, "QA", _cge_rowi(nA, nC), -p.theta)
        for (hh = 1; hh <= nH; hh++) _cge_jd(M, T, bo, "Q6B", eAC, "QHA", _cge_el(_cge_rowi(nA, nC), hh, nH), p.theta)
        for (c = 1; c <= nC; c++) {
            if (!M.cac[c]) continue
            i = selectindex(M.xac[., c])
            if (rows(i) * cols(i) == 0) continue
            i = colshape(i, 1)
            if (M.cdac[c]) {
                _cge_jd(M, T, bo, "P5A", (i :- 1) :* nC :+ c, "PXAC", (i :- 1) :* nC :+ c, QXAC[i, c])
                _cge_jd(M, T, bo, "P5A", (i :- 1) :* nC :+ c, "QXAC", (i :- 1) :* nC :+ c, PXAC[i, c])
                _cge_jd(M, T, bo, "P5A", (i :- 1) :* nC :+ c, "PX", c, -p.dac[i, c] :* QX[c])
                _cge_jd(M, T, bo, "P5A", (i :- 1) :* nC :+ c, "QX", c, -p.dac[i, c] :* PX[c])
                continue
            }
            rr = rsac[c]
            R5 = (PX[c] * QX[c] / sxac[c]) :* p.dac[i, c] :* (qxac[i, c] :^ (-rr - 1))
            _cge_jd(M, T, bo, "P5A", (i :- 1) :* nC :+ c, "PXAC", (i :- 1) :* nC :+ c, 1)
            _cge_jd(M, T, bo, "P5A", (i :- 1) :* nC :+ c, "PX", c, -R5 :/ PX[c])
            _cge_jd(M, T, bo, "P5A", (i :- 1) :* nC :+ c, "QX", c, -R5 :/ QX[c])
            for (k = 1; k <= rows(i); k++) {
                dq = (i :== i[k]) :* (R5 :* (-rr - 1) :/ qxac[i[k], c]) +
                     R5 :* (rr * p.dac[i[k], c] * qxac[i[k], c]^(-rr - 1) / sxac[c])
                _cge_jd(M, T, bo, "P5A", (i :- 1) :* nC :+ c, "QXAC", (i[k] - 1) * nC + c, -dq)
            }
        }
    }

    // 5.3 Trade block
    Sc = p.dt :* (QE :^ p.rt) + p.dtc :* (QD :^ p.rt)
    tmp = p.at :* (Sc :^ (1 :/ p.rt))
    _cge_jd(M, T, bo, "T1", cC, "QX", cC, 1)
    _cge_jd(M, T, bo, "T1", cC, "QE", cC, -(tmp :/ Sc) :* p.dt :* (QE :^ (p.rt :- 1)))
    _cge_jd(M, T, bo, "T1", cC, "QD", cC, -(tmp :/ Sc) :* p.dtc :* (QD :^ (p.rt :- 1)))
    k2 = 1 :/ (p.rt :- 1)
    ratio = (PE :/ PD) :* (p.dtc :/ p.dt)
    tmp = QD :* (ratio :^ k2)
    _cge_jd(M, T, bo, "T2", cC, "QE", cC, 1)
    _cge_jd(M, T, bo, "T2", cC, "QD", cC, -(ratio :^ k2))
    _cge_jd(M, T, bo, "T2", cC, "PE", cC, -k2 :* tmp :/ PE)
    _cge_jd(M, T, bo, "T2", cC, "PD", cC, k2 :* tmp :/ PD)
    _cge_jd(M, T, bo, "T3", cC, "QX", cC, 1)
    _cge_jd(M, T, bo, "T3", cC, "QD", cC, -1)
    _cge_jd(M, T, bo, "T3E", cC, "QX", cC, 1)
    _cge_jd(M, T, bo, "T3E", cC, "QE", cC, -1)
    Sc = p.dq :* (QM :^ (-p.rq)) + p.dqc :* (QD :^ (-p.rq))
    tmp = p.aq :* (Sc :^ (-1 :/ p.rq))
    _cge_jd(M, T, bo, "T4", cC, "QQ", cC, 1)
    _cge_jd(M, T, bo, "T4", cC, "QM", cC, -(tmp :/ Sc) :* p.dq :* (QM :^ (-p.rq :- 1)))
    _cge_jd(M, T, bo, "T4", cC, "QD", cC, -(tmp :/ Sc) :* p.dqc :* (QD :^ (-p.rq :- 1)))
    k2 = 1 :/ (1 :+ p.rq)
    ratio = (PDD :/ PM) :* (p.dq :/ p.dqc)
    tmp = QD :* (ratio :^ k2)
    _cge_jd(M, T, bo, "T5", cC, "QM", cC, 1)
    _cge_jd(M, T, bo, "T5", cC, "QD", cC, -(ratio :^ k2))
    _cge_jd(M, T, bo, "T5", cC, "PM", cC, k2 :* tmp :/ PM)
    _cge_jd(M, T, bo, "T5", cC, "PD", cC, -k2 :* tmp :/ PDD)
    _cge_nzv(p.icd, i, j, v)
    if (rows(i)) _cge_jd(M, T, bo, "T5", j, "PQ", i, -k2[j] :* tmp[j] :/ PDD[j] :* v)
    _cge_jd(M, T, bo, "T6", cC, "QQ", cC, 1)
    _cge_jd(M, T, bo, "T6", cC, "QD", cC, -p.aq)
    _cge_jd(M, T, bo, "T7", cC, "QQ", cC, 1)
    _cge_jd(M, T, bo, "T7", cC, "QM", cC, -p.aq)
    _cge_jd(M, T, bo, "T8", cC, "QT", cC, 1)
    _cge_nzv(p.icm, i, j, v)
    _cge_jd(M, T, bo, "T8", i, "QQ", j, -v)
    _cge_nzv(p.icd, i, j, v)
    _cge_jd(M, T, bo, "T8", i, "QD", j, -v)
    _cge_nzv(p.ici, i, j, v)
    _cge_jd(M, T, bo, "T8", i, "QM", j, -v)
    _cge_nzv(p.ice, i, j, v)
    _cge_jd(M, T, bo, "T8", i, "QE", j, -v)
    tmp = p.qer :* ((PQ :/ (EXR :* p.pwe)) :^ (-p.st))
    _cge_jd(M, T, bo, "T9", cC, "QER", cC, 1)
    _cge_jd(M, T, bo, "T9", cC, "PQ", cC, p.st :* tmp :/ PQ)
    _cge_jd(M, T, bo, "T9", cC, "EXR", 1, -p.st :* tmp :/ EXR)
    tmp = p.qe0 :* ((PWE :/ p.pwe) :^ (-p.etae))
    _cge_jd(M, T, bo, "T10", cC, "QE", cC, 1)
    _cge_jd(M, T, bo, "T10", cC, "PWE", cC, p.etae :* tmp :/ PWE)

    // 5.4 Institution block
    eIF = _cge_el(_cge_rowi(nI, nF), _cge_coli(nI, nF), nF)
    coef = p.shif :* (J(nI, 1, 1) * (1 :- p.tshi :- p.tfy)')
    if (M.ishi) coef[nI, .] = p.tshi'
    _cge_jd(M, T, bo, "I2", eIF, "YIF", eIF, 1)
    _cge_jd(M, T, bo, "I2", eIF, "YF", _cge_coli(nI, nF), -coef)
    tmp = I(nD) - p.shii :* (J(nD, 1, 1) * ((1 :- MPS) :* (1 :- TINS))')
    _cge_nzv(tmp, i, j, v)
    _cge_jd(M, T, bo, "I3", i, "YI", j, v)
    _cge_nzv(p.shii :* (J(nD, 1, 1) * ((1 :- TINS) :* YI)'), i, j, v)
    _cge_jd(M, T, bo, "I3", i, "MPS", j, v)
    _cge_nzv(p.shii :* (J(nD, 1, 1) * ((1 :- MPS) :* YI)'), i, j, v)
    _cge_jd(M, T, bo, "I3", i, "TINS", j, v)
    _cge_jd(M, T, bo, "I3", _cge_rowi(nD, nF), "YIF", _cge_el(_cge_rowi(nD, nF), _cge_coli(nD, nF), nF), -1)
    _cge_jd(M, T, bo, "I3", cD, "CPI", 1, -p.trdg)
    _cge_jd(M, T, bo, "I3", cD, "EXR", 1, -p.trdr)
    for (k = 1; k <= nD; k++) {
        if (!any(p.rrm :== nF + k) & !any(p.rre :== nF + k) & !any(p.rra :== nF + k)) continue
        G = J(1, rows(x), 0)
        _cge_rent_grad(M, p, x, nF + k, G, 1, -1, 0)
        _cge_jdense(M, T, bo, "I3", k, G)
    }
    G = J(0, 0, .)
    _cge_jd(M, T, bo, "I4", cH, "EH", cH, 1)
    _cge_jd(M, T, bo, "I4", cH, "YI", cH, -p.hc :* (1 :- MPS[cH]) :* (1 :- TINS[cH]))
    _cge_jd(M, T, bo, "I4", cH, "MPS", cH, p.hc :* (1 :- TINS[cH]) :* YI[cH])
    _cge_jd(M, T, bo, "I4", cH, "TINS", cH, p.hc :* (1 :- MPS[cH]) :* YI[cH])
    // Household purchases (I5) and home consumption (I5H), LES
    eCH = _cge_el(_cge_rowi(nC, nH), _cge_coli(nC, nH), nH)
    eAH = _cge_el(_cge_rowi(nA, nH), _cge_coli(nA, nH), nH)
    _cge_jd(M, T, bo, "I5", eCH, "QH", eCH, PH * J(1, nH, 1))
    _cge_jd(M, T, bo, "I5", eCH, "PQ", _cge_rowi(nC, nH), (1 :+ tv) :* (QH - p.gamma))
    _cge_jd(M, T, bo, "I5", eCH, "EH", _cge_coli(nC, nH), -p.beta)
    _cge_jd(M, T, bo, "I5", eCH, "TVADJ", 1,
            (p.tv :* PQ) :* (QH - p.gamma) + p.beta :* (J(nC, 1, 1) * ((p.tv :* PQ)' * p.gamma)))
    _cge_jd(M, T, bo, "I5H", eAH, "QHA", eAH, PA * J(1, nH, 1))
    _cge_jd(M, T, bo, "I5H", eAH, "PA", _cge_rowi(nA, nH), QHA - p.gammah)
    _cge_jd(M, T, bo, "I5H", eAH, "EH", _cge_coli(nA, nH), -p.betah)
    _cge_jd(M, T, bo, "I5H", eAH, "TVADJ", 1, p.betah :* (J(nA, 1, 1) * ((p.tv :* PQ)' * p.gamma)))
    for (hh = 1; hh <= nH; hh++) {
        // supernumerary spending depends on the prices of the subsistence quantities
        if (any(p.gamma[., hh])) {
            outer = p.beta[., hh] * ((1 :+ tv) :* p.gamma[., hh])'
            _cge_nzv(outer, i, j, v)
            _cge_jd(M, T, bo, "I5", _cge_el(i, hh, nH), "PQ", j, v)
            outer = p.betah[., hh] * ((1 :+ tv) :* p.gamma[., hh])'
            _cge_nzv(outer, i, j, v)
            _cge_jd(M, T, bo, "I5H", _cge_el(i, hh, nH), "PQ", j, v)
        }
        if (any(p.gammah[., hh])) {
            outer = p.beta[., hh] * p.gammah[., hh]'
            _cge_nzv(outer, i, j, v)
            _cge_jd(M, T, bo, "I5", _cge_el(i, hh, nH), "PA", j, v)
            outer = p.betah[., hh] * p.gammah[., hh]'
            _cge_nzv(outer, i, j, v)
            _cge_jd(M, T, bo, "I5H", _cge_el(i, hh, nH), "PA", j, v)
        }
    }
    _cge_jd(M, T, bo, "I6", cC, "QINV", cC, 1)
    _cge_jd(M, T, bo, "I6", cC, "IADJ", 1, -p.qinv)
    _cge_jd(M, T, bo, "I7", cC, "QG", cC, 1)
    _cge_jd(M, T, bo, "I7", cC, "GADJ", 1, -p.qg)
    _cge_jd(M, T, bo, "I10", cD, "TINS", cD, 1)
    _cge_jd(M, T, bo, "I10", cD, "TINSADJ", 1, -p.tins0)
    _cge_jd(M, T, bo, "I11", cD, "MPS", cD, 1)
    _cge_jd(M, T, bo, "I11", cD, "MPSADJ", 1, -p.mps0)
    _cge_jd(M, T, bo, "I12", 1, "YSHI", 1, 1)
    if (M.ishi) _cge_jd(M, T, bo, "I12", J(nF, 1, 1), "YIF", (nI - 1) * nF :+ cF, -1)
    _cge_jd(M, T, bo, "I12", 1, "CPI", 1, -p.trshi)
    _cge_jd(M, T, bo, "I12", 1, "EXR", 1, -p.trshir)
    _cge_jd(M, T, bo, "I13", cC, "QSHI", cC, 1)
    _cge_jd(M, T, bo, "I13", cC, "SHIADJ", 1, -p.qshi)
    _cge_jd(M, T, bo, "I14", J(nC, 1, 1), "PQ", cC, (1 :+ tv) :* _cge_v(M, x, 47))
    _cge_jd(M, T, bo, "I14", 1, "TVADJ", 1, sum(p.tv :* PQ :* _cge_v(M, x, 47)))
    _cge_jd(M, T, bo, "I14", J(nC, 1, 1), "QSHI", cC, PH)
    _cge_jd(M, T, bo, "I14", 1, "YSHI", 1, -(1 - p.sshi))

    // Labour-market regimes
    unemp = 1 :- QFS :/ p.qlf
    rwage = W :/ CPI
    _cge_jd(M, T, bo, "L1", cF, "W", cF, J(nF, 1, 1 / CPI))
    _cge_jd(M, T, bo, "L1", cF, "CPI", 1, -W :/ (CPI^2))
    _cge_jd(M, T, bo, "L1", cF, "QFS", cF, -p.wref :* p.epsw :* ((unemp :/ p.u0) :^ (-p.epsw :- 1)) :/ (p.u0 :* p.qlf))
    _cge_jd(M, T, bo, "L1", cF, "LSW", cF, -1)
    ub = rwage :/ p.wmin :- 1
    s = sqrt(unemp :^ 2 + ub :^ 2 :+ 2 * p.mu)
    _cge_jd(M, T, bo, "L2", cF, "QFS", cF, -(1 :- unemp :/ s) :/ p.qlf)
    _cge_jd(M, T, bo, "L2", cF, "W", cF, (1 :- ub :/ s) :/ (CPI :* p.wmin))
    _cge_jd(M, T, bo, "L2", cF, "CPI", 1, -(1 :- ub :/ s) :* W :/ ((CPI^2) :* p.wmin))
    _cge_jd(M, T, bo, "L2", cF, "LSM", cF, -1)

    // 5.5 System constraints: market clearing (S2) and the government balance (S4)
    _cge_jd(M, T, bo, "S2", cC, "QQ", cC, 1)
    _cge_jd(M, T, bo, "S2", IC, "QINT", eCA, -1)
    _cge_jd(M, T, bo, "S2", _cge_rowi(nC, nH), "QH", eCH, -1)
    _cge_jd(M, T, bo, "S2", cC, "QG", cC, -1)
    _cge_jd(M, T, bo, "S2", cC, "QINV", cC, -1)
    _cge_jd(M, T, bo, "S2", cC, "QT", cC, -M.ct)
    _cge_jd(M, T, bo, "S2", cC, "QER", cC, -M.cr)
    _cge_jd(M, T, bo, "S2", cC, "QSHI", cC, -1)
    _cge_jd(M, T, bo, "S4", 1, "YG", 1, 1)
    _cge_jd(M, T, bo, "S4", 1, "EG", 1, -1)
    _cge_jd(M, T, bo, "S4", 1, "GSAV", 1, -1)
    _cge_jtrip_ub(M, p, x, T, bo)
}

// The entries of the constraints and of the user equations (from version
// 0.13.0 a function of their own, for standalone models too)
void _cge_jtrip_ub(struct cge_model scalar M, struct cge_par scalar p, real colvector x, struct cge_trip scalar T,
                   real colvector bo)
{
    real colvector g, h, sb, bm, vpos, r4, q, ag, ah
    real matrix utk, tk1, tk2
    real rowvector gl, gr
    real scalar kb, k

    // Constraints (Section 16.2)
    kb = _cge_find(M.ename, "B1")
    if (rows(M.bY)) {
        g = M.btype :* (p.bval - x[M.bY]) :/ M.xscale[M.bY]
        h = M.bdir :* (x[M.bX] - p.bxbar) :/ M.xscale[M.bX]
        sb = sqrt(g :^ 2 + h :^ 2 :+ 2 * p.bmu)
        bm = p.bmode
        // the Fischer-Burmeister function (from version 0.14.0): at g = h =
        // 0, an element of its generalised Jacobian, (1 - 1/sqrt(2), 1 -
        // 1/sqrt(2))
        r4 = sqrt(g :^ 2 + h :^ 2)
        q = (r4 :> 0)
        ag = q :* (g :/ (r4 + (1 :- q))) + (1 :- q) :* sqrt(0.5)
        ah = q :* (h :/ (r4 + (1 :- q))) + (1 :- q) :* sqrt(0.5)
        _cge_tadd(T, bo[kb] :+ (1::rows(M.bY)), M.bY,
                  ((bm :== 1) :* (1 :- g :/ sb) + (bm :== 2) + (bm :== 4) :* (1 :- ag)) :* (-M.btype :/ M.xscale[M.bY]))
        _cge_tadd(T, bo[kb] :+ (1::rows(M.bY)), M.bX,
                  ((bm :== 1) :* (1 :- h :/ sb) + (bm :== 0) + (bm :== 3) + (bm :== 4) :* (1 :- ah)) :* (M.bdir :/ M.xscale[M.bX]))
    }

    // User equations (Section 19): forward differentiation of both sides
    kb = _cge_find(M.ename, "U")
    for (k = 1; k <= rows(M.uelab); k++) {
        tk1 = M.utok[|M.ustart[k], 1 \ M.ustart[k] + M.ulen[k] - 1, 3|]
        tk2 = M.utok[|M.ustart[k] + M.ulen[k], 1 \ M.ustart[k] + M.ulen[k] + M.ulen2[k] - 1, 3|]
        utk = tk1 \ tk2
        vpos = select(utk[., 2], utk[., 1] :== 2)
        if (rows(vpos) == 0) continue
        vpos = uniqrows(vpos)
        (void) _cge_u_dvalue(M, p, x, tk1, vpos, gl)
        (void) _cge_u_dvalue(M, p, x, tk2, vpos, gr)
        _cge_tadd(T, bo[kb] + k, vpos, (gl - gr)')
    }
}

// The value of the postfix rows tok at x and, in grad, its derivatives with
// respect to the variables at positions vpos of x (forward differentiation)
real scalar _cge_u_dvalue(struct cge_model scalar M, struct cge_par scalar p, real colvector x, real matrix tok,
                          real colvector vpos, real rowvector grad)
{
    real colvector st
    real matrix G, v
    real rowvector ga, gb
    real scalar i, sp, a, b, c, nv, op, val, na, j
    real colvector av
    nv = rows(vpos)
    st = J(rows(tok), 1, .)
    G = J(rows(tok), nv, 0)
    sp = 0
    for (i = 1; i <= rows(tok); i++) {
        c = tok[i, 1]
        if (c == 1) {
            sp = sp + 1
            st[sp] = tok[i, 2]
            G[sp, .] = J(1, nv, 0)
        }
        else if (c == 2) {
            sp = sp + 1
            st[sp] = x[tok[i, 2]]
            G[sp, .] = (vpos' :== tok[i, 2])
        }
        else if (c == 3) {
            v = _cge_par_get(p, M.upar[tok[i, 2]])
            sp = sp + 1
            st[sp] = _cge_u_parel(v, tok[i, 3])
            G[sp, .] = J(1, nv, 0)
        }
        else if (c == 7) {
            sp = sp + 1
            st[sp] = p.upval[tok[i, 2]]
            G[sp, .] = J(1, nv, 0)
        }
        // a lagged value (from version 0.9.2), given within the period; in a
        // run with foresight (from version 0.10.2), vpos may hold the codes
        // pos + k rows(x) of the values k periods before, and pos + (4 + k)
        // rows(x) of those k periods after, for the derivatives across periods
        else if (c == 9) {
            sp = sp + 1
            st[sp] = _cge_u_lagval(M, p, tok[i, 2], tok[i, 3])
            G[sp, .] = (vpos' :== tok[i, 2] + tok[i, 3] * rows(x))
        }
        else if (c == 11) {
            sp = sp + 1
            st[sp] = _cge_u_leadval(M, p, tok[i, 2], tok[i, 3])
            G[sp, .] = (vpos' :== tok[i, 2] + (4 + tok[i, 3]) * rows(x))
        }
        // the period (from version 0.10.2)
        else if (c == 12) {
            sp = sp + 1
            st[sp] = _cge_u_tval(p, tok[i, 2])
            G[sp, .] = J(1, nv, 0)
        }
        else if (c == 4) {
            b = st[sp]
            gb = G[sp, .]
            sp = sp - 1
            a = st[sp]
            ga = G[sp, .]
            op = tok[i, 2]
            if (op == 1) {
                st[sp] = a + b
                G[sp, .] = ga + gb
            }
            else if (op == 2) {
                st[sp] = a - b
                G[sp, .] = ga - gb
            }
            else if (op == 3) {
                st[sp] = a * b
                G[sp, .] = b :* ga + a :* gb
            }
            else if (op == 4) {
                st[sp] = a / b
                G[sp, .] = ga :/ b - (a / b^2) :* gb
            }
            else if (op >= 6) {
                // comparisons and & |: no derivative
                st[sp] = _cge_u_cmp(op, a, b)
                G[sp, .] = J(1, nv, 0)
            }
            else {
                val = a ^ b
                st[sp] = val
                // a constant exponent needs no logarithm of the base
                if (!any(gb)) G[sp, .] = (b == 0 ? J(1, nv, 0) : (b * a ^ (b - 1)) :* ga)
                else G[sp, .] = val :* ((b / a) :* ga + ln(a) :* gb)
            }
        }
        else if (c == 5) {
            st[sp] = -st[sp]
            G[sp, .] = -G[sp, .]
        }
        else if (c == 8) {
            st[sp] = (st[sp] >= . ? . : st[sp] == 0)
            G[sp, .] = J(1, nv, 0)
        }
        // a function of several arguments (from version 0.9.7): the
        // derivative of the argument that min(), max() or ifthen() takes
        else if (c == 10) {
            na = tok[i, 3]
            op = tok[i, 2]
            sp = sp - na + 1
            av = st[|sp \ sp + na - 1|]
            st[sp] = _cge_u_fn(op, av)
            if (op <= 2 | op == 6) {
                j = _cge_u_fnarg(op, av)
                G[sp, .] = (j ? G[sp + j - 1, .] : J(1, nv, 0))
            }
            else if (op == 3) G[sp, .] = sign(av[1]) :* G[sp, .]
            else if (op == 4) G[sp, .] = (2 * av[1]) :* G[sp, .]
            else G[sp, .] = G[sp, .] :/ (av[1] * ln(10))
        }
        else {
            a = st[sp]
            op = tok[i, 2]
            if (op == 1) {
                st[sp] = exp(a)
                G[sp, .] = st[sp] :* G[sp, .]
            }
            else if (op == 2) {
                st[sp] = ln(a)
                G[sp, .] = G[sp, .] :/ a
            }
            else {
                st[sp] = sqrt(a)
                G[sp, .] = G[sp, .] :/ (2 * st[sp])
            }
        }
    }
    grad = G[1, .]
    return(st[1])
}

// The variables of the explicit definitions left out of the reduced system
// (positions in x) and their definition rows (positions in the stacked equations)
void _cge_dvars(struct cge_model scalar M, real colvector dpos, real colvector drow)
{
    string matrix cand
    real colvector bo, pos, sel
    real scalar k, g, v
    cand = _cge_dcandidates()
    bo = runningsum(M.elen) - M.elen
    dpos = J(0, 1, .)
    drow = J(0, 1, .)
    for (k = 1; k <= rows(cand); k++) {
        if (!M.dact[k]) continue
        g = _cge_find(M.ename, cand[k, 1])
        v = _cge_vidx(M, cand[k, 2])
        pos = _cge_vpos(M, v)
        sel = _cge_which(M.exists[pos])
        dpos = dpos \ pos[sel]
        drow = drow \ (bo[g] :+ sel)
    }
}

// Sums of v by index k = 1..n
real colvector _cge_sumby(real colvector k, real colvector v, real scalar n)
{
    real colvector o, ks, out
    real matrix info
    out = J(n, 1, 0)
    if (rows(k) == 0) return(out)
    o = order(k, 1)
    ks = k[o]
    info = panelsetup(ks, 1)
    out[ks[info[., 1]]] = panelsum(v[o], info)
    return(out)
}

// The exact Jacobian of system S at z, scaled as _cge_F (rows by the scale
// of the equations, columns by the scale of the variables). In the reduced
// system each variable of a left-out definition d - g(y) = 0 is replaced by
// its dependencies, with dd/dy = -(dD/dy) / (dD/dd) from the definition row D.
real matrix _cge_jacobian_exact(struct cge_model scalar M, struct cge_par scalar p, real colvector xfix,
                                struct cge_sys scalar S, real colvector z)
{
    real colvector ri, ci, v
    real matrix Jac, info
    real scalar k, a, b, n, nfree
    nfree = rows(z)
    if (!_cge_jac_trip(M, p, xfix, S, z, ri, ci, v)) return(J(S.neq, nfree, .))
    Jac = J(S.neq, nfree, 0)
    if (!rows(v)) return(Jac)
    info = panelsetup(ri, 1)
    n = rows(info)
    for (k = 1; k <= n; k++) {
        a = info[k, 1]
        b = info[k, 2]
        Jac[ri[a], ci[|a \ b|]'] = v[|a \ b|]'
    }
    return(Jac)
}

// The entries of the exact Jacobian of system S at z (from version 0.10.1,
// for the sparse LU; before, part of _cge_jacobian_exact): rows ri and
// columns ci of the system, row by row, and values v, scaled. The variables
// at positions xcols, fixed, take further columns after the free ones (from
// version 0.10.2, for the capital stocks of runs with foresight). Returns 0
// at a point where the equations cannot be evaluated.
real scalar _cge_jac_trip(struct cge_model scalar M, struct cge_par scalar p, real colvector xfix,
                          struct cge_sys scalar S, real colvector z, real colvector ri, real colvector ci,
                          real colvector v, | real colvector xcols)
{
    struct cge_trip scalar T
    real colvector x, r, c, keep, dpos, drow, isdef, dnum, indef, piv, sel, dk, dc, dv, o
    real colvector hasd, kt, vt, rt, nt, first, tt, within, src, start, len, rowsys, colmap, lin
    real matrix info
    real scalar nd, pass, N, nfree, ncol

    nfree = rows(z)
    ri = ci = v = J(0, 1, .)
    x = xfix
    x[S.free] = z :* M.xscale[S.free]
    if (S.reduced) _cge_derive(M, p, x)
    if (min(x[M.positive]) <= 0 | hasmissing(x)) return(0)
    _cge_tinit(T)
    _cge_jtrip(M, p, x, T)
    if (T.n == 0) return(1)
    r = T.r[|1 \ T.n|]
    c = T.c[|1 \ T.n|]
    v = T.v[|1 \ T.n|]
    // existing equations and variables; [., 1] because a 1 x 1 vector
    // subscripted by a column gives a row (a model of one equation)
    keep = selectindex(M.emask[r, 1] :& M.exists[c, 1])
    r = r[keep]
    c = c[keep]
    v = v[keep]

    if (S.reduced) {
        _cge_dvars(M, dpos, drow)
        nd = rows(dpos)
        if (nd) {
            isdef = J(rows(M.emask), 1, 0)
            isdef[drow] = (1::nd)
            dnum = J(rows(x), 1, 0)
            dnum[dpos] = (1::nd)
            indef = (isdef[r] :> 0)
            // pivots: each definition row's derivative with respect to its own variable
            sel = selectindex(indef :& (dnum[c] :== isdef[r]))
            piv = _cge_sumby(isdef[r[sel]], v[sel], nd)
            // dd/dy for the other entries of the definition rows, sorted by definition
            sel = selectindex(indef :& (dnum[c] :!= isdef[r]))
            dk = isdef[r[sel]]
            dc = c[sel]
            dv = -v[sel] :/ piv[dk]
            o = order((dk, dc), (1, 2))
            dk = dk[o]
            dc = dc[o]
            dv = dv[o]
            start = J(nd, 1, 0)
            len = J(nd, 1, 0)
            if (rows(dk)) {
                info = panelsetup(dk, 1)
                start[dk[info[., 1]]] = info[., 1]
                len[dk[info[., 1]]] = info[., 2] - info[., 1] :+ 1
            }
            // the other rows; definitions depend on no other left-out variable,
            // but substitution is repeated in case one does
            sel = selectindex(!indef)
            r = r[sel]
            c = c[sel]
            v = v[sel]
            for (pass = 1; pass <= 5; pass++) {
                hasd = (dnum[c] :> 0)
                if (!any(hasd)) break
                sel = selectindex(hasd)
                kt = dnum[c[sel]]
                vt = v[sel]
                rt = r[sel]
                sel = selectindex(!hasd)
                r = r[sel]
                c = c[sel]
                v = v[sel]
                nt = len[kt]
                sel = selectindex(nt :> 0)
                if (rows(sel) * cols(sel) == 0) continue
                kt = kt[sel]
                vt = vt[sel]
                rt = rt[sel]
                nt = nt[sel]
                N = sum(nt)
                first = runningsum(nt) - nt :+ 1
                tt = J(N, 1, 0)
                tt[first] = J(rows(first), 1, 1)
                tt = runningsum(tt)
                within = (1::N) - first[tt]
                src = start[kt[tt]] + within
                r = r \ rt[tt]
                c = c \ dc[src]
                v = v \ vt[tt] :* dv[src]
            }
            if (pass > 5) _cge_fail("cge internal error: left-out variables remain in the Jacobian", 3498)
        }
    }

    // rows of the system and free columns, scaled
    rowsys = runningsum(S.mask) :* S.mask
    colmap = J(rows(x), 1, 0)
    colmap[S.free] = (1::nfree)
    ncol = nfree
    if (args() >= 9) {
        if (rows(xcols)) {
            colmap[xcols] = nfree :+ (1::rows(xcols))
            ncol = nfree + rows(xcols)
        }
    }
    keep = selectindex((rowsys[r, 1] :> 0) :& (colmap[c, 1] :> 0))
    if (rows(keep) * cols(keep) == 0) return(1)
    r = r[keep]
    c = c[keep]
    v = v[keep] :* M.xscale[c, 1] :/ M.escale[r, 1]
    if (hasmissing(v)) {
        v = J(0, 1, .)
        return(0)
    }
    ri = rowsys[r, 1]
    ci = colmap[c, 1]
    // duplicates summed, row by row
    lin = (ri :- 1) :* ncol :+ ci
    o = order(lin, 1)
    lin = lin[o]
    v = v[o]
    info = panelsetup(lin, 1)
    v = panelsum(v, info)
    lin = lin[info[., 1]]
    ri = floor((lin :- 1) :/ ncol) :+ 1
    ci = lin - (ri :- 1) :* ncol
    return(1)
}

// Test hook (from version 0.7.0): the exact Jacobian against column-by-column
// central differences at the current point, for the reduced system (the
// default) or the full one; r(maxdiff), and the block of the largest difference
void _cge_jexcheck(| real scalar full, string scalar sim, real scalar perturb)
{
    struct cge_model scalar M
    struct cge_par scalar p
    struct cge_sys scalar S
    real colvector z, rowpre, bo, rw, o, x
    real matrix A, B, D
    real scalar k, i, j, g
    string scalar blk

    if (args() == 0) full = 0
    if (args() < 2) sim = ""
    if (args() < 3) perturb = 0
    M = _cge_load()
    _cge_need(M, "calibrated")
    S = _cge_sys_make(M, !full)
    // at the solution of a simulation, with its parameters, or at the
    // current point; free variables optionally perturbed by up to +-perturb
    p = M.p
    x = M.xcur
    if (sim != "") {
        k = _cge_sim_index(M, sim)
        p = M.simp[k]
        x = M.simx[., k]
    }
    z = x[S.free] :/ M.xscale[S.free]
    if (perturb > 0) z = z :* (1 :+ perturb :* (2 :* runiform(rows(z), 1) :- 1))
    A = _cge_jacobian_exact(M, p, x, S, z)
    B = _cge_jacobian_full(M, p, x, S, z)
    D = abs(A - B)
    // the equation block of each row of the system
    rowpre = selectindex(S.mask)
    bo = runningsum(M.elen) - M.elen
    k = 0
    i = 1
    j = 1
    if (rows(D) * cols(D)) {
        rw = rowmax(D)
        o = order(-rw, 1)
        i = o[1]
        o = order(-D[i, .]', 1)
        j = o[1]
    }
    blk = ""
    if (rows(rowpre) * cols(rowpre)) {
        g = max(selectindex(bo :< rowpre[i]))
        blk = M.ename[g] + "(" + strofreal(rowpre[i] - bo[g]) + ")"
    }
    // the variable of that column
    g = max(selectindex(M.voff :< S.free[j]))
    st_numscalar("r(maxdiff)", (rows(D) * cols(D) ? max(D) : 0))
    st_global("r(block)", blk)
    st_global("r(variable)", M.vname[g] + "(" + strofreal(S.free[j] - M.voff[g]) + ")")
    st_numscalar("r(columns)", rows(z))
    printf("{txt}Exact Jacobian (%s system): {res}%f{txt} columns; largest difference from central differences {res}%9.3e{txt} in row {res}%s{txt}, column {res}%s\n",
           (full ? "full" : "reduced"), rows(z), st_numscalar("r(maxdiff)"), blk, st_global("r(variable)"))
}

// Test hook (from version 0.7.0): _cge_jexcheck for the reduced and the full
// system, at the current point and with the free variables perturbed by up to
// perturb (default 0.03); r(maxdiff) is the largest difference
void _cge_jexall(| real scalar perturb)
{
    real scalar m
    if (args() == 0) perturb = 0.03
    _cge_jexcheck(0)
    m = st_numscalar("r(maxdiff)")
    _cge_jexcheck(1)
    m = max((m, st_numscalar("r(maxdiff)")))
    _cge_jexcheck(0, "", perturb)
    m = max((m, st_numscalar("r(maxdiff)")))
    _cge_jexcheck(1, "", perturb)
    m = max((m, st_numscalar("r(maxdiff)")))
    st_numscalar("r(maxdiff)", m)
}

// Test hook: the grouped and column-by-column Jacobians at the current point,
// with the current shocks and closure, for the reduced system (the default)
// or the full one
void _cge_jaccheck(| real scalar full, real scalar forward)
{
    struct cge_model scalar M
    struct cge_jpat scalar G
    struct cge_sys scalar S
    real colvector z
    real matrix A, B

    if (args() == 0) full = 0
    if (args() < 2) forward = 0
    M = _cge_load()
    _cge_need(M, "calibrated")
    S = _cge_sys_make(M, !full)
    z = M.xcur[S.free] :/ M.xscale[S.free]
    G = _cge_jpat_make(M, S)
    if (forward) A = _cge_jacobian(M, M.p, M.xcur, S, z, G, _cge_F(M, M.p, M.xcur, S, z))
    else A = _cge_jacobian(M, M.p, M.xcur, S, z, G)
    B = _cge_jacobian_full(M, M.p, M.xcur, S, z)
    st_numscalar("r(maxdiff)", max(abs(A - B)))
    st_numscalar("r(groups)", G.ncolour)
    st_numscalar("r(columns)", rows(z))
    printf("{txt}Jacobian (%s system, %s differences): {res}%f{txt} columns in {res}%f{txt} groups; largest difference from column-by-column {res}%9.3e\n",
           (full ? "full" : "reduced"), (forward ? "one-sided" : "central"), rows(z), G.ncolour, max(abs(A - B)))
}

// Test hook (from version 0.6.3; from 0.7.0 the exact Jacobian): the current
// shocks and closure solved from the base by Newton with the reduced system,
// with mode m1 (default 0, the exact Jacobian with Broyden's updates) and with
// mode m2 (default 1, central differences), and the largest relative
// difference between the two solutions
void _cge_newtoncheck(| real scalar m1, real scalar m2)
{
    struct cge_model scalar M
    struct cge_sys scalar S
    real colvector z1, z2
    real scalar c1, c2, i1, i2, e1, e2, j1, j2, b1

    if (args() < 1) m1 = 0
    if (args() < 2) m2 = 1
    M = _cge_load()
    _cge_need(M, "calibrated")
    S = _cge_sys_make(M, 1)
    z1 = M.x0[S.free] :/ M.xscale[S.free]
    z2 = z1
    c1 = _cge_newton(M, M.p, M.xcur, S, z1, 1e-10, 100, 0, i1, e1, m1)
    j1 = st_numscalar("r(jacobians)")
    b1 = st_numscalar("r(broyden)")
    c2 = _cge_newton(M, M.p, M.xcur, S, z2, 1e-10, 100, 0, i2, e2, m2)
    j2 = st_numscalar("r(jacobians)")
    st_numscalar("r(converged1)", c1)
    st_numscalar("r(converged2)", c2)
    st_numscalar("r(iterations1)", i1)
    st_numscalar("r(iterations2)", i2)
    st_numscalar("r(jacobians1)", j1)
    st_numscalar("r(jacobians2)", j2)
    st_numscalar("r(broyden1)", b1)
    st_numscalar("r(maxdiff)", max(abs(z1 - z2) :/ rowmax((J(rows(z2), 1, 1), abs(z2)))))
    printf("{txt}Newton, mode %f: converged {res}%f{txt}, {res}%f{txt} iterations, {res}%f{txt} Jacobian(s), {res}%f{txt} Broyden update(s)\n", m1, c1, i1, j1, b1)
    printf("{txt}Newton, mode %f: converged {res}%f{txt}, {res}%f{txt} iterations, {res}%f{txt} Jacobian(s)\n", m2, c2, i2, j2)
    printf("{txt}Largest relative difference between the solutions {res}%9.3e\n", st_numscalar("r(maxdiff)"))
}

// Newton's method with a backtracking line search; returns 1 on convergence.
// The Jacobian is exact (modes 0 and 3, from version 0.7.0), or found by
// central (mode 1) or one-sided (mode 2) differences.
//
// Mode 0 (the default) continues after each Newton step, full or shortened by
// the line search, with Broyden's good method (Broyden 1965): the inverse of
// the Jacobian is updated after each step s, with y the change in F, as
// H+ = (I + a s') H, a = (s - H y) / (s' H y), so that H is the LU factors of
// the last Jacobian times the stored factors (I + a s'). The next direction
// is -H+ F+; as H F = -d for the last direction d, H y = H F+ + d needs one
// solve with the LU factors. A Broyden step is taken with a line search of
// at most two halvings; a new Jacobian is computed when that fails, after a
// step that reduces the residual norm by less than a tenth, or after 30
// updates. Modes 1 to 3 reuse the LU factors of a Jacobian, without updates,
// after a full step while each step at least halves the residual norm (the
// method before version 0.7.0, a chord method).
//
// Once the tolerance is met, up to three more steps with the last factors
// (no new Jacobian) are taken while each halves the residual, toward a
// thousandth of the tolerance: a solution far inside the tolerance varies
// smoothly with the shocks, as cge_optimize and cge_sensitivity need.
real scalar _cge_newton(struct cge_model scalar M, struct cge_par scalar p, real colvector xfix,
                        struct cge_sys scalar S, real colvector z, real scalar tol, real scalar maxit,
                        real scalar trace, real scalar iter, real scalar err, | real scalar mode)
{
    struct cge_jpat scalar G
    struct cge_slu scalar SF
    real colvector f, fn, dz, zn, perm, d, s, g, Hy, a, jr, jc, jv
    real matrix LU, U, A, Sm
    real scalar norm0, step, it, have, njac, nbro, ns, npol, den, ok, smin, j, sp

    if (args() < 11) mode = 0
    // the sparse LU (from version 0.10.1), with the exact Jacobian or, in
    // modes 1 and 2, central or one-sided differences as entries
    sp = _cge_sparse_on(M, S)
    if (sp) _cge_slu_load(SF)
    f = _cge_F(M, p, xfix, S, z)
    iter = 0
    err = .
    if (hasmissing(f)) return(0)
    if (mode == 1 | mode == 2) G = _cge_jpat_make(M, S)
    have = 0
    njac = 0
    nbro = 0
    ns = 0
    npol = 0
    for (it = 0; it <= maxit + 3; it++) {
        err = max(abs(f))
        if (!npol) {
            iter = it
            if (trace) printf("{txt}Iteration %f: largest scaled residual = {res}%9.3e{txt} (%f Jacobian(s), %f Broyden update(s))\n",
                              it, err, njac, nbro)
        }
        if (err < tol) {
            if (!have | npol >= 3 | err <= 1e-3 * tol) {
                st_numscalar("r(jacobians)", njac)
                st_numscalar("r(broyden)", nbro)
                return(1)
            }
            npol++
        }
        // the iteration limit and the time limit (from version 0.16.0)
        else if (it >= maxit) {
            _cge_stop_set(2)
            break
        }
        else if (_cge_timeup()) break
        norm0 = norm(f)
        if (have & mode == 0) {
            // A Broyden step along d: full, or halved at most twice; when
            // polishing, a full step that halves the residual
            ok = 0
            smin = (npol ? 1 : 0.25)
            for (step = 1; step >= smin; step = step / 2) {
                zn = z + step * d
                fn = _cge_F(M, p, xfix, S, zn)
                if (!hasmissing(fn)) {
                    if (norm(fn) <= (npol ? 0.5 : 1 - 1e-4 * step) * norm0) {
                        ok = 1
                        break
                    }
                }
            }
            if (ok) {
                s = step * d
                if (sp) g = _cge_hsolve_s(SF, A, Sm, ns, fn)
                else g = _cge_hsolve(LU, U, perm, A, Sm, ns, fn)
                Hy = g + d
                den = s' * Hy
                z = zn
                f = fn
                nbro++
                have = 0
                if (!hasmissing(g) & abs(den) > 1e-14 * norm(s) * norm(Hy) & ns < 30) {
                    a = (s - Hy) / den
                    A = A, a
                    Sm = Sm, s
                    ns++
                    d = -(g + a * (s' * g))
                    // slow progress: a new Jacobian at the next step
                    have = (norm(fn) <= 0.9 * norm0)
                }
                continue
            }
            have = 0
        }
        else if (have) {
            // A step with the factors of the last Jacobian, without updates
            if (sp) dz = _cge_slu_solve(SF, -f)
            else dz = solveupper(U, solvelower(LU, -f[perm]))
            if (!hasmissing(dz)) {
                zn = z + dz
                fn = _cge_F(M, p, xfix, S, zn)
                if (!hasmissing(fn)) {
                    if (norm(fn) <= 0.5 * norm0) {
                        z = zn
                        f = fn
                        continue
                    }
                }
            }
            have = 0
        }
        // a polishing step that does not help ends the solve, converged
        if (npol) {
            st_numscalar("r(jacobians)", njac)
            st_numscalar("r(broyden)", nbro)
            return(1)
        }
        if (sp) {
            njac++
            if (mode == 1) ok = _cge_jac_cdtrip(M, p, xfix, S, z, G, jr, jc, jv)
            else if (mode == 2) ok = _cge_jac_cdtrip(M, p, xfix, S, z, G, jr, jc, jv, f)
            else ok = _cge_jac_trip(M, p, xfix, S, z, jr, jc, jv)
            if (!ok) break
            if (!_cge_slu_update(SF, jr, jc, jv, rows(z))) break
            dz = _cge_slu_solve(SF, -f)
        }
        else {
            if (mode == 1) LU = _cge_jacobian(M, p, xfix, S, z, G)
            else if (mode == 2) LU = _cge_jacobian(M, p, xfix, S, z, G, f)
            else LU = _cge_jacobian_exact(M, p, xfix, S, z)
            njac++
            if (hasmissing(LU)) break
            // Mata's _lud() gives A = (L*U)[p, .], so A x = b is solved with b[invorder(p)]
            _lud(LU, U, perm)
            perm = invorder(perm)
            dz = solveupper(U, solvelower(LU, -f[perm]))
        }
        if (hasmissing(dz)) break
        step = 1
        while (step >= 1e-8) {
            zn = z + step * dz
            fn = _cge_F(M, p, xfix, S, zn)
            if (!hasmissing(fn)) {
                if (norm(fn) <= (1 - 1e-4 * step) * norm0) break
            }
            step = step / 2
        }
        if (step < 1e-8) break
        if (mode == 0) {
            // the first update, from H0 = J^-1: H0 F = -dz
            A = J(rows(z), 0, .)
            Sm = A
            ns = 0
            s = step * dz
            if (sp) g = _cge_slu_solve(SF, fn)
            else g = solveupper(U, solvelower(LU, fn[perm]))
            Hy = g + dz
            den = s' * Hy
            have = 0
            if (!hasmissing(g) & abs(den) > 1e-14 * norm(s) * norm(Hy)) {
                a = (s - Hy) / den
                A = a
                Sm = s
                ns = 1
                d = -(g + a * (s' * g))
                have = 1
            }
        }
        // after a step shortened by the line search the factors are less
        // likely to help without updates
        else have = (step == 1)
        z = zn
        f = fn
    }
    st_numscalar("r(jacobians)", njac)
    st_numscalar("r(broyden)", nbro)
    return(npol > 0)
}

// H v, with H the inverse of the Jacobian from its LU factors times the
// stored Broyden factors (I + a_j s_j'), applied in the order they were made
real colvector _cge_hsolve(real matrix LU, real matrix U, real colvector perm, real matrix A, real matrix Sm,
                           real scalar ns, real colvector v)
{
    real colvector w
    real scalar j
    w = solveupper(U, solvelower(LU, v[perm]))
    for (j = 1; j <= ns; j++) w = w + A[., j] * (Sm[., j]' * w)
    return(w)
}

// Evaluator for solvenl(), which takes at most three extra arguments in Stata 13:
// xf holds the fixed values (column 1), marks the free variables (column 2)
// and, in column 3, whether the system is the reduced one
void _cge_solvenl_eval(real colvector z, real colvector y, struct cge_model scalar M,
                       struct cge_par scalar p, real matrix xf)
{
    struct cge_sys scalar S
    S.reduced = xf[1, 3]
    S.free = select((1::rows(xf)), xf[., 2])
    S.mask = (S.reduced ? M.rmask : M.emask)
    S.neq = sum(S.mask)
    y = _cge_F(M, p, xf[., 1], S, z)
}

// Solve from `start` with parameters p and fixed values in xfix, using the
// reduced system unless `full` is set. Returns the full solution vector; conv,
// iter, err and method describe the outcome.
real colvector _cge_solve_point(struct cge_model scalar M, struct cge_par scalar p, real colvector xfix,
                                real colvector start, real scalar tol, real scalar maxit,
                                real scalar trace, real scalar conv, real scalar iter,
                                real scalar err, string scalar method, | real scalar full, real scalar mode)
{
    real colvector x, x2, act, g, h, flip
    real scalar it2, r, conv2, err2, iss
    string scalar m2

    if (args() < 12) full = 0
    // the mode of Newton's method (_cge_newton); 0, the default, is the exact
    // Jacobian with Broyden's updates
    if (args() < 13) mode = 0
    if (rows(M.bY)) p.bxbar = xfix[M.bX]
    if (!rows(M.bY)) return(_cge_solve_sys(M, p, xfix, start, tol, maxit, trace, conv, iter, err, method, full, mode))
    act = (p.bmode :> 0)
    if (!any(act)) return(_cge_solve_sys(M, p, xfix, start, tol, maxit, trace, conv, iter, err, method, full, mode))
    // Constraints (Section 16.3). From version 0.14.0, by default, every
    // constraint in Fischer-Burmeister form, solved at once by the semismooth
    // Newton method; the regimes are read from the solution, which is then
    // polished in them where they hold
    iss = 0
    if (M.mcpsolver != 1) {
        p.bmode = 4 :* act
        x = _cge_solve_sys(M, p, xfix, start, tol, maxit, trace, conv, iter, err, method, full, mode)
        if (conv) {
            _cge_bgaps(M, p, x, g, h)
            p.bmode = act :* (2 :* (h :> g) + 3 :* (h :<= g))
            x2 = _cge_polish(M, p, xfix, x, tol / 1000, full, mode, conv2, it2, err2)
            if (conv2) {
                _cge_bgaps(M, p, x2, g, h)
                flip = act :* (((p.bmode :== 3) :& (g :< -1e-9)) :| ((p.bmode :== 2) :& (h :< -1e-9)))
                if (!any(flip)) {
                    x = x2
                    iter = iter + it2
                    err = err2
                }
            }
            return(x)
        }
        // no fallback once the time limit has passed or the iteration limit
        // has been used (from version 0.16.0)
        if (_cge_stop() == 3 | iter >= maxit) return(x)
        if (trace) printf("{txt}The semismooth Newton method did not converge; the active-set method\n")
        iss = iter
    }
    // The active-set method (version 0.4.4). 1. The smoothed conditions find
    // the regimes.
    p.bmode = act
    x = _cge_solve_sys(M, p, xfix, start, tol, maxit, trace, conv, iter, err, method, full, mode)
    if (conv) {
        _cge_bgaps(M, p, x, g, h)
        p.bmode = act :* (2 :* (h :> g) + 3 :* (h :<= g))
    }
    else {
        p.bmode = 3 :* act
        x = start
        iter = 0
    }
    // 2. Exact conditions in those regimes; a constraint whose other condition
    // fails changes regime
    for (r = 1; r <= 10; r++) {
        x = _cge_solve_sys(M, p, xfix, x, tol, maxit, trace, conv, it2, err, m2, full, mode)
        iter = iter + it2
        if (!conv) break
        _cge_bgaps(M, p, x, g, h)
        flip = act :* (((p.bmode :== 3) :& (g :< -1e-9)) :| ((p.bmode :== 2) :& (h :< -1e-9)))
        if (!any(flip)) break
        p.bmode = flip :* (5 :- p.bmode) + (1 :- flip) :* p.bmode
    }
    if (r > 10) conv = 0
    if (conv & m2 != "newton") method = m2
    iter = iter + iss
    return(x)
}

// A solution polished by Newton's method toward tolerance tol, in the regimes
// of p (from version 0.14.0), without the fallbacks of _cge_solve_sys: conv
// 0 leaves x as it was
real colvector _cge_polish(struct cge_model scalar M, struct cge_par scalar p, real colvector xfix,
                           real colvector x, real scalar tol, real scalar full, real scalar mode,
                           real scalar conv, real scalar iter, real scalar err)
{
    struct cge_sys scalar S
    real colvector z, x2
    S = _cge_sys_make(M, !full)
    conv = 0
    iter = 0
    if (rows(S.free) != S.neq) return(x)
    z = x[S.free] :/ M.xscale[S.free]
    conv = _cge_newton(M, p, xfix, S, z, tol, 20, 0, iter, err, mode)
    if (!conv) return(x)
    x2 = xfix
    x2[S.free] = z :* M.xscale[S.free]
    if (S.reduced) _cge_derive(M, p, x2)
    return(x2)
}

// The semismooth Newton method for a system whose constraints are in
// Fischer-Burmeister form (from version 0.14.0; Reference Manual, The
// solution): phi(g, h) = g + h - sqrt(g^2 + h^2) is zero exactly where g >= 0,
// h >= 0 and g h = 0. Each step solves the system of an element of the
// generalised Jacobian, from the exact derivatives, with a line search on the
// merit function f'f / 2; where Newton's step is not a direction of
// sufficient descent of the merit function, or its line search fails, the
// step is the steepest descent of the merit function (De Luca, Facchinei and
// Kanzow, 1996). The line search is non-monotone: a step is accepted against
// the largest merit of the last 10 iterations (Grippo, Lampariello and
// Lucidi, 1986), which the method needs on problems such as Kojima and
// Shindo's. The sparse LU of cge_options serves as for Newton's method.
// Returns 1 when the largest scaled residual falls below tol.
real scalar _cge_ssnewton(struct cge_model scalar M, struct cge_par scalar p, real colvector xfix,
                          struct cge_sys scalar S, real colvector z, real scalar tol, real scalar maxit,
                          real scalar trace, real scalar iter, real scalar err)
{
    struct cge_slu scalar SF
    real colvector f, fn, dz, zn, jr, jc, jv, gr, perm, hist
    real matrix LU, U
    real scalar it, sp, psi, step, ok, slope, ngr, nsd, nnw, pref
    sp = _cge_sparse_on(M, S)
    if (sp) _cge_slu_load(SF)
    f = _cge_F(M, p, xfix, S, z)
    iter = 0
    err = .
    if (hasmissing(f)) return(0)
    nsd = nnw = 0
    hist = J(0, 1, .)
    for (it = 0; it <= maxit; it++) {
        err = max(abs(f))
        iter = it
        if (trace) printf("{txt}Iteration %f: largest scaled residual = {res}%9.3e{txt} (semismooth Newton: %f Newton and %f gradient step(s))\n",
                          it, err, nnw, nsd)
        if (err < tol) {
            st_numscalar("r(jacobians)", it)
            st_numscalar("r(gradient_steps)", nsd)
            return(1)
        }
        if (it == maxit) {
            _cge_stop_set(2)
            break
        }
        if (_cge_timeup()) break
        if (!_cge_jac_trip(M, p, xfix, S, z, jr, jc, jv)) break
        psi = 0.5 * (f' * f)
        // the reference of the non-monotone line search
        hist = hist \ psi
        if (rows(hist) > 10) hist = hist[|rows(hist) - 9 \ rows(hist)|]
        pref = max(hist)
        // the gradient of the merit function, J'f
        gr = _cge_sumby(jc, jv :* f[jr], rows(z))
        dz = J(0, 1, .)
        if (sp) {
            if (_cge_slu_update(SF, jr, jc, jv, rows(z))) dz = _cge_slu_solve(SF, -f)
        }
        else {
            LU = _cge_trip_dense(jr, jc, jv, S.neq, rows(z))
            _lud(LU, U, perm)
            perm = invorder(perm)
            dz = solveupper(U, solvelower(LU, -f[perm]))
        }
        ok = 0
        if (rows(dz)) if (!hasmissing(dz)) {
            slope = gr' * dz
            // a direction of sufficient descent of the merit function
            if (slope <= -1e-8 * norm(dz)^2.1) {
                for (step = 1; step >= 1e-12; step = step / 2) {
                    zn = z + step * dz
                    fn = _cge_F(M, p, xfix, S, zn)
                    if (!hasmissing(fn)) if (0.5 * (fn' * fn) <= pref + 1e-4 * step * slope) {
                        ok = 1
                        break
                    }
                }
            }
        }
        if (ok) nnw++
        else {
            // the steepest descent of the merit function
            ngr = gr' * gr
            if (!(ngr > 0) | ngr >= .) break
            slope = -ngr
            for (step = 1; step >= 1e-14; step = step / 2) {
                zn = z - step * gr
                fn = _cge_F(M, p, xfix, S, zn)
                if (!hasmissing(fn)) if (0.5 * (fn' * fn) <= pref + 1e-4 * step * slope) {
                    ok = 1
                    break
                }
            }
            if (!ok) break
            nsd++
        }
        z = zn
        f = fn
    }
    st_numscalar("r(jacobians)", iter)
    st_numscalar("r(gradient_steps)", nsd)
    return(0)
}

// The dense matrix of entries (r, c, v), sorted by row with each (r, c) once,
// as _cge_jac_trip gives them (from version 0.14.0)
real matrix _cge_trip_dense(real colvector r, real colvector c, real colvector v, real scalar nr, real scalar nc)
{
    real matrix A, info
    real scalar k, a, b
    A = J(nr, nc, 0)
    if (!rows(v)) return(A)
    info = panelsetup(r, 1)
    for (k = 1; k <= rows(info); k++) {
        a = info[k, 1]
        b = info[k, 2]
        A[r[a], c[|a \ b|]'] = v[|a \ b|]'
    }
    return(A)
}

// g and h of every constraint at x (Section 16.2)
void _cge_bgaps(struct cge_model scalar M, struct cge_par scalar p, real colvector x, real colvector g,
                real colvector h)
{
    g = M.btype :* (p.bval - x[M.bY]) :/ M.xscale[M.bY]
    h = M.bdir :* (x[M.bX] - p.bxbar) :/ M.xscale[M.bX]
}

// The system without constraint regimes to choose: Newton, then Powell's
// hybrid method if Newton fails
real colvector _cge_solve_sys(struct cge_model scalar M, struct cge_par scalar p, real colvector xfix,
                              real colvector start, real scalar tol, real scalar maxit,
                              real scalar trace, real scalar conv, real scalar iter,
                              real scalar err, string scalar method, real scalar full, | real scalar mode,
                              real scalar force)
{
    struct cge_sys scalar S
    real colvector z, z2, x, isfree
    transmorphic SV
    real scalar rc, iter2

    S = _cge_sys_make(M, !full)
    // A user variable or equation without its pair leaves the system without a
    // square Jacobian (from version 0.6.4)
    if (rows(S.free) != S.neq) {
        errprintf("the system is not square: %f free variables, %f equations\n", rows(S.free), S.neq)
        errprintf("a variable added with cge_variable, value() needs an equation from cge_equation,\n")
        errprintf("and each user equation needs a free variable\n")
        exit(459)
    }
    z = start[S.free] :/ M.xscale[S.free]
    method = "newton"
    if (args() < 13) mode = 0
    // force: the fallbacks even after the iteration limit (_cge_fallbackcheck)
    if (args() < 14) force = 0
    // constraints in Fischer-Burmeister form (from version 0.14.0): the
    // semismooth Newton method, without the fallbacks for smooth systems
    if (rows(p.bmode)) if (any(p.bmode :== 4)) {
        method = "semismooth"
        conv = _cge_ssnewton(M, p, xfix, S, z, tol, maxit, trace, iter, err)
        x = xfix
        x[S.free] = z :* M.xscale[S.free]
        if (S.reduced) _cge_derive(M, p, x)
        return(x)
    }
    conv = _cge_newton(M, p, xfix, S, z, tol, maxit, trace, iter, err, mode)
    // no fallback once the time limit has passed or Newton has used the
    // iteration limit (from version 0.16.0), as a GAMS solver stops at its
    // limits
    if (!conv & !force & (_cge_stop() == 3 | iter >= maxit)) {
        x = xfix
        x[S.free] = z :* M.xscale[S.free]
        if (S.reduced) _cge_derive(M, p, x)
        return(x)
    }
    if (!conv) {
        // Newton again from the start, with a Jacobian from central
        // differences and without Broyden's updates
        if (trace) printf("{txt}Newton with the exact Jacobian failed; again with central differences\n")
        z = start[S.free] :/ M.xscale[S.free]
        conv = _cge_newton(M, p, xfix, S, z, tol, maxit, trace, iter2, err, 1)
        iter = iter + iter2
    }
    // Powell's method (solvenl) holds the Jacobian dense: with the sparse LU
    // it is left out above 10,000 equations (from version 0.10.1)
    if (!conv & _cge_stop() != 3 & _cge_sparse_on(M, S) & S.neq > 10000) {
        if (trace) printf("{txt}Powell's hybrid method is left out: %f equations, with the sparse LU\n", S.neq)
    }
    else if (!conv & _cge_stop() != 3) {
        // Fallback: Powell's hybrid method, then Newton to polish the result
        method = "broydenpowell"
        SV = solvenl_init()
        solvenl_init_evaluator(SV, &_cge_solvenl_eval())
        solvenl_init_type(SV, "zero")
        solvenl_init_technique(SV, "broydenpowell")
        isfree = J(rows(xfix), 1, 0)
        isfree[S.free] = J(rows(S.free), 1, 1)
        solvenl_init_narguments(SV, 3)
        solvenl_init_argument(SV, 1, M)
        solvenl_init_argument(SV, 2, p)
        solvenl_init_argument(SV, 3, (xfix, isfree, J(rows(xfix), 1, S.reduced)))
        solvenl_init_iter_log(SV, (trace ? "on" : "off"))
        solvenl_init_conv_maxiter(SV, 1000)
        // Tighter than the defaults, so that the result needs little polishing
        solvenl_init_conv_iterchng(SV, 1e-13)
        solvenl_init_conv_nearzero(SV, 1e-20)
        solvenl_init_startingvals(SV, start[S.free] :/ M.xscale[S.free])
        rc = _solvenl_solve(SV)
        if (rc == 0) {
            z2 = solvenl_result_values(SV)
            conv = _cge_newton(M, p, xfix, S, z2, tol, maxit, trace, iter2, err, mode)
            if (conv) z = z2
            iter = iter + iter2
        }
    }
    x = xfix
    x[S.free] = z :* M.xscale[S.free]
    if (S.reduced) _cge_derive(M, p, x)
    return(x)
}

// A test of the fallbacks of _cge_solve_sys (from version 0.16.0): the
// current shocks solved from the base with no Newton iterations, so that
// Powell's hybrid method must find the solution, stored as simulation name;
// r(converged) and r(method)
void _cge_fallbackcheck(string scalar name, real scalar tol)
{
    struct cge_model scalar M
    real colvector x
    real scalar conv, iter, err
    string scalar method
    M = _cge_load()
    _cge_deadline_set(.)
    x = _cge_solve_sys(M, M.p, M.xcur, _cge_bd_start(M, M.xcur), tol, 0, 0, conv, iter, err, method, 0, 0, 1)
    (void) _cge_store_sim(M, name, x, conv, iter, _cge_maxres(M, M.p, x), method)
    _cge_store(M)
    printf("{txt}Fallback solve: converged {res}%f{txt}, method {res}%s{txt}, largest scaled residual {res}%9.3e\n",
           conv, method, _cge_maxres(M, M.p, x))
    st_numscalar("r(converged)", conv)
    st_global("r(method)", method)
}

// Store a solution as a named simulation (replacing one of the same name);
// returns its index
real scalar _cge_store_sim(struct cge_model scalar M, string scalar name, real colvector x, real scalar conv,
                           real scalar iter, real scalar err, string scalar method)
{
    real scalar k
    k = _cge_find(M.simname, name)
    // a model loaded without simulations has them as a 0 x 0 matrix, which a
    // column cannot be joined to
    if (!cols(M.simx)) M.simx = J(rows(x), 0, .)
    if (k == 0) {
        M.simname = M.simname \ name
        M.simclosure = M.simclosure \ _cge_closure_text(M)
        M.simmethod = M.simmethod \ method
        M.simx = M.simx, x
        M.simp = M.simp, M.p
        M.simconv = M.simconv \ conv
        M.simiter = M.simiter \ iter
        M.simres = M.simres \ err
        M.simrun = M.simrun \ ""
        M.simper = M.simper \ .
        M.simlam = M.simlam \ .
        M.simcons = M.simcons \ _cge_cons_text(M, M.p, x)
        _cge_set_simobj(M, rows(M.simname), "")
        _cge_set_simstat(M, rows(M.simname), (conv ? (_cge_cons_on(M) ? 1 : 16) : 5), (conv ? 1 : 4))
        _cge_set_simmodel(M, rows(M.simname), "")
        return(rows(M.simname))
    }
    M.simclosure[k] = _cge_closure_text(M)
    M.simmethod[k] = method
    M.simx[., k] = x
    M.simp[k] = M.p
    M.simconv[k] = conv
    M.simiter[k] = iter
    M.simres[k] = err
    M.simrun[k] = ""
    M.simper[k] = .
    M.simlam[k] = .
    M.simcons[k] = _cge_cons_text(M, M.p, x)
    _cge_set_simobj(M, k, "")
    _cge_set_simstat(M, k, (conv ? (_cge_cons_on(M) ? 1 : 16) : 5), (conv ? 1 : 4))
    _cge_set_simmodel(M, k, "")
    return(k)
}

// The named model that stored simulation k solved (from version 0.17.0):
// empty for the whole model
string scalar _cge_simmodel(struct cge_model scalar M, real scalar k)
{
    if (k > rows(M.simmodel)) return("")
    return(M.simmodel[k])
}

void _cge_set_simmodel(struct cge_model scalar M, real scalar k, string scalar mname)
{
    if (rows(M.simmodel) < rows(M.simname)) M.simmodel = M.simmodel \ J(rows(M.simname) - rows(M.simmodel), 1, "")
    if (rows(M.simmodel) > rows(M.simname)) M.simmodel = M.simmodel[|1 \ rows(M.simname)|]
    M.simmodel[k] = mname
}

// 1 if constraints are in the current system (from version 0.16.0)
real scalar _cge_cons_on(struct cge_model scalar M)
{
    if (!rows(M.bY) | rows(M.p.bmode) != rows(M.bY)) return(0)
    return(any(M.p.bmode :> 0))
}

// The objective of stored simulation k (from version 0.15.0): "" unless it
// was solved as a nonlinear programme
string scalar _cge_simobj(struct cge_model scalar M, real scalar k)
{
    if (k > rows(M.simobj)) return("")
    return(M.simobj[k])
}

void _cge_set_simobj(struct cge_model scalar M, real scalar k, string scalar obj)
{
    if (rows(M.simobj) < rows(M.simname)) M.simobj = M.simobj \ J(rows(M.simname) - rows(M.simobj), 1, "")
    if (rows(M.simobj) > rows(M.simname)) M.simobj = M.simobj[|1 \ rows(M.simname)|]
    M.simobj[k] = obj
}

void _cge_solve(string scalar name, real scalar tol, real scalar maxit, real scalar trace, | real scalar full,
                real scalar steps, real scalar diagnose, string scalar lin, string scalar obj, real scalar tlim,
                string scalar mname, string scalar from, string scalar hold, real scalar nodes, real scalar optcr)
{
    struct cge_model scalar M
    real colvector x, x2, start
    real scalar conv, iter, err, k, walras, nsteps, done, it2, n, keeplin, mode, ms, ss
    string scalar method, m2

    if (args() < 5) full = 0
    if (args() < 6) steps = 0
    if (args() < 7) diagnose = 0
    if (args() < 8) lin = ""
    if (args() < 9) obj = ""
    if (args() < 10) tlim = -1
    if (args() < 11) mname = ""
    if (args() < 12) from = ""
    if (args() < 13) hold = ""
    // branch and bound (from version 0.18.0): the node limit and the relative
    // gap
    if (args() < 14) nodes = -1
    if (args() < 15) optcr = -1
    M = _cge_load()
    _cge_need(M, "calibrated")
    if (obj == "" & _cge_sa(M)) if (rows(_cge_int_pos(M))) {
        _cge_fail("the model has integer variables: solve it with minimize() or maximize(), as a mixed-integer programme", 459)
    }
    // the options of cge_options where the command gives none, and the
    // deadline of the time limit (from version 0.16.0)
    tol = _cge_opttol(M, tol)
    maxit = _cge_optit(M, maxit)
    mode = _cge_optmode(M)
    _cge_deadline_set(_cge_opttime(M, tlim))
    // a nonlinear programme (from version 0.15.0)
    if (obj != "") {
        _cge_nlp_run(M, name, obj, tol, maxit, trace, lin, mname, from, hold, nodes, optcr)
        _cge_deadline_set(.)
        return
    }
    // a named model, a start from a stored simulation or variables held at
    // their levels (from version 0.17.0)
    if (mname != "" | from != "" | hold != "") {
        _cge_solve_named(M, name, mname, from, tol, maxit, trace, mode, lin, hold)
        _cge_deadline_set(.)
        return
    }
    // the linear solver for this solve (from version 0.10.1), in place of
    // that of cge_options
    keeplin = M.linsolver
    if (lin != "") M.linsolver = (lin == "sparse")
    if (name == "") name = "sim" + strofreal(rows(M.simname) + 1)
    // the base with the starting levels of cge_bound (from version 0.9.8)
    start = _cge_bd_start(M, M.xcur)

    // Continuation (from version 0.4.5): steps(n) applies the shock in n
    // steps; by default (steps 0) a failed solve is tried again in 4, then 16
    nsteps = 0
    if (steps > 1) {
        x = _cge_continue(M, steps, tol, maxit, trace, conv, iter, err, method, full, done, mode)
        nsteps = (conv ? steps : done)
    }
    else {
        x = _cge_solve_point(M, M.p, M.xcur, start, tol, maxit, trace, conv, iter, err, method, full, mode)
        // no continuation once the time limit has passed or the iteration
        // limit has been used (from version 0.16.0)
        if (!conv & steps == 0 & _cge_stop() != 3 & iter < maxit) {
            for (k = 1; k <= 2; k++) {
                if (_cge_stop() == 3) break
                n = (k == 1 ? 4 : 16)
                printf("{txt}Not solved directly; trying again in %f steps\n", n)
                x2 = _cge_continue(M, n, tol, maxit, trace, conv, it2, err, m2, full, done, mode)
                iter = iter + it2
                if (conv) {
                    x = x2
                    method = m2
                    nsteps = n
                    break
                }
            }
        }
    }
    // a standalone model has no WALRAS (from version 0.13.0)
    walras = (_cge_sa(M) ? . : x[M.voff[_cge_vidx(M, "WALRAS")] + 1])
    // The largest scaled residual of every equation, the left-out ones included
    err = _cge_maxres(M, M.p, x)
    st_global("r(linsolver)", _cge_lin_name(M))
    M.linsolver = keeplin

    k = _cge_store_sim(M, name, x, conv, iter, err, method)
    // the statuses, in GAMS's codes (from version 0.16.0)
    _cge_status(conv, _cge_cons_on(M), 0, 0, err, ms, ss)
    _cge_set_simstat(M, k, ms, ss)
    _cge_store(M)
    _cge_deadline_set(.)

    if (conv & nsteps > 1) printf("{txt}Simulation {res}%s{txt} solved in {res}%f{txt} steps, {res}%f{txt} iteration(s) ({res}%s{txt})\n",
                                  name, nsteps, iter, method)
    else if (conv) printf("{txt}Simulation {res}%s{txt} solved in {res}%f{txt} iteration(s) ({res}%s{txt})\n", name, iter, method)
    else printf("{err}Simulation %s did not converge (largest scaled residual %9.3e)\n", name, err)
    if (!conv) _cge_status_show(ms, ss)
    if (_cge_sa(M)) printf("{txt}Largest scaled residual {res}%9.3e\n", err)
    else printf("{txt}Largest scaled residual {res}%9.3e{txt}; WALRAS = {res}%9.3e\n", err, walras)
    _cge_bd_note(M, x, conv)
    st_numscalar("r(N_collapsed)", (conv ? _cge_collapsed(M, x, 1) : .))
    // Diagnostics (from version 0.4.5): after a failure, or when asked
    if (!conv | diagnose) _cge_diagnose(M, M.p, x, full, (diagnose ? 10 : 5))
    st_numscalar("r(steps)", nsteps)
    st_numscalar("r(converged)", conv)
    st_numscalar("r(iterations)", iter)
    st_numscalar("r(max_residual)", err)
    st_numscalar("r(walras)", walras)
    st_numscalar("r(modelstat)", ms)
    st_numscalar("r(solvestat)", ss)
    st_numscalar("r(tolerance)", tol)
    st_numscalar("r(iterate)", maxit)
    st_numscalar("r(N_solved)", (full ? M.neq : sum(M.rmask)))
    // Constraints (Section 16): regimes
    if (rows(M.bY)) {
        _cge_cons_show(M, M.p, x)
        st_numscalar("r(N_constraints)", sum(M.p.bmode :> 0))
        st_numscalar("r(N_binding)", sum(M.p.bmode :== 2))
        st_global("r(constraints)", _cge_cons_text(M, M.p, x))
    }
    st_global("r(name)", name)
    st_global("r(method)", method)
    st_global("r(closure)", _cge_closure_text(M))
}

// Values of a solution below one millionth of their positive base value, or
// negative (from version 0.7.0): quantities, prices, incomes and the scaling
// factors of demand. The equations hold at such a point, but it rarely is an
// equilibrium that makes economic sense. With show, the largest falls are listed.
real scalar _cge_collapsed(struct cge_model scalar M, real colvector x, real scalar show)
{
    string colvector names
    real colvector pos, sel, ratio, o
    real scalar k, v, n
    // the user decides what a standalone model's values mean (from version 0.13.0)
    if (_cge_sa(M)) return(0)
    names = ("PA", "PVA", "PINTA", "PX", "PD", "PE", "PM", "PQ", "W", "EXR", "CPI", "DPI",
             "QA", "QVA", "QINTA", "QF", "QINT", "QX", "QD", "QE", "QM", "QQ", "QH", "QG", "QINV", "QFS",
             "YF", "YI", "EH", "YG", "EG", "IADJ", "GADJ", "QT", "QER", "YSHI", "SHIADJ", "QSHI", "HS",
             "PWE", "QHA", "QNA", "PNA", "PXAC", "QXAC")'
    pos = J(0, 1, .)
    for (k = 1; k <= rows(names); k++) {
        v = _cge_vidx(M, names[k])
        if (v) pos = pos \ _cge_vpos(M, v)
    }
    sel = _cge_which(M.exists[pos] :& (M.x0[pos] :> 0))
    if (rows(sel) == 0) return(0)
    pos = pos[sel]
    ratio = x[pos] :/ M.x0[pos]
    sel = _cge_which(ratio :< 1e-6)
    n = rows(sel)
    if (n == 0 | !show) return(n)
    pos = pos[sel]
    ratio = ratio[sel]
    o = order(ratio, 1)
    printf("{txt}Note: {res}%f{txt} value(s) of the solution are negative or below one millionth of their base value:\n", n)
    for (k = 1; k <= min((n, 5)); k++) {
        printf("{txt}  %-28s {res}%14.6g{txt}  (base %g)\n", _cge_poslabel(M, pos[o[k]]), x[pos[o[k]]], M.x0[pos[o[k]]])
    }
    if (n > 5) printf("{txt}  and %f more\n", n - 5)
    printf("{txt}The equations hold, but such a solution rarely makes economic sense.\n")
    return(n)
}

// =====================================================================
// Attributes of variables (from version 0.9.8)
// =====================================================================

// A value given to cge_bound: a number, -1e300 for -inf and 1e300 for inf
// (or +inf); missing when none is given
real scalar _cge_bd_num(string scalar s, string scalar what)
{
    string scalar t
    real scalar v
    t = strlower(strtrim(s))
    if (t == "") return(.)
    if (t == "-inf") return(-1e300)
    if (t == "inf" | t == "+inf") return(1e300)
    v = strtoreal(t)
    if (v >= .) _cge_fail("cge_bound: " + what + "() takes a number, or -inf or inf", 198)
    return(v)
}

// The positions in pos of elements that exist
real colvector _cge_bd_exist(struct cge_model scalar M, real colvector pos)
{
    real colvector k
    if (!rows(pos)) return(J(0, 1, .))
    k = _cge_which(M.exists[pos])
    return(rows(k) ? pos[k] : J(0, 1, .))
}

// Positions of the existing elements of variable k named in elems: every
// existing element when elems is empty, e1.e2 for two indexes. With quiet,
// an element that no longer exists is left out instead of stopping.
real colvector _cge_bd_pos(struct cge_model scalar M, real scalar k, string scalar elems, | real scalar quiet)
{
    string rowvector tok, two
    string colvector l1, l2
    string scalar s1, s2
    real colvector out
    real scalar i, a, b
    if (args() < 4) quiet = 0
    if (strtrim(elems) == "" | strtrim(elems) == "all") return(_cge_bd_exist(M, _cge_vpos(M, k)))
    tok = tokens(elems)
    if (M.vset[k] == "") {
        if (quiet) return(J(0, 1, .))
        _cge_fail("cge_bound: " + M.vname[k] + " has no elements", 198)
    }
    out = J(0, 1, .)
    if (_cge_nidx(M.vset[k]) == 1) {
        l1 = _cge_setlab(M, M.vset[k])
        for (i = 1; i <= cols(tok); i++) {
            a = _cge_find(l1, tok[i])
            if (!a) {
                if (quiet) continue
                _cge_fail("cge_bound: " + tok[i] + " is not an element of " + M.vname[k], 111)
            }
            out = out \ (M.voff[k] + a)
        }
    }
    else {
        _cge_setparts(M.vset[k], s1, s2)
        l1 = _cge_setlab(M, s1)
        l2 = _cge_setlab(M, s2)
        for (i = 1; i <= cols(tok); i++) {
            two = tokens(subinstr(tok[i], ".", " "))
            a = 0
            b = 0
            if (cols(two) == 2) {
                a = _cge_find(l1, two[1])
                b = _cge_find(l2, two[2])
            }
            if (!a | !b) {
                if (quiet) continue
                _cge_fail("cge_bound: " + tok[i] + " is not an element of " + M.vname[k] + "; write e1.e2 for two indexes", 111)
            }
            out = out \ (M.voff[k] + (a - 1) * M.vcols[k] + b)
        }
    }
    if (!quiet) {
        for (i = 1; i <= rows(out); i++) {
            if (!M.exists[out[i]]) _cge_fail("cge_bound: " + _cge_poslabel(M, out[i]) + " does not exist in this model", 459)
        }
    }
    return(_cge_bd_exist(M, out))
}

// The bounds, starting levels and scales that the definitions of cge_bound
// give: applied in order, later ones replacing earlier ones, with -inf and inf
// removing a bound. A scale replaces the automatic one, abs(x0) or 1, which
// returns when the scale is removed. The definitions of user variables since
// removed are dropped.
void _cge_bd_sync(struct cge_model scalar M)
{
    real colvector lo, up, sc, lv, pos, keep, a, au
    real scalar r, k, n, v
    n = rows(M.x0)
    if (rows(M.bdcp)) {
        pos = select(M.bdcp, M.bdcp :<= n)
        if (rows(pos)) M.xscale[pos] = abs(M.x0[pos]) :* (abs(M.x0[pos]) :> 1e-12) + (abs(M.x0[pos]) :<= 1e-12)
    }
    M.bdlp = M.bdlv = M.bdup = M.bduv = M.bdsp = M.bdsv = M.bdcp = J(0, 1, .)
    if (rows(M.bddef) == 0 | cols(M.bddef) < 7 | !n) {
        if (cols(M.bddef) != 7) M.bddef = J(0, 7, "")
        return
    }
    keep = J(rows(M.bddef), 1, 0)
    for (r = 1; r <= rows(M.bddef); r++) keep[r] = (_cge_vidx(M, M.bddef[r, 1]) > 0)
    if (!any(keep)) {
        M.bddef = J(0, 7, "")
        return
    }
    M.bddef = select(M.bddef, keep)
    lo = up = sc = lv = J(n, 1, .)
    for (r = 1; r <= rows(M.bddef); r++) {
        k = _cge_vidx(M, M.bddef[r, 1])
        pos = _cge_bd_pos(M, k, M.bddef[r, 2], 1)
        if (!rows(pos)) continue
        // relative: multiples of the base values, and of the automatic scales
        a = J(rows(pos), 1, 1)
        au = a
        if (M.bddef[r, 7] == "relative") {
            a = M.x0[pos]
            au = abs(a) :* (abs(a) :> 1e-12) + (abs(a) :<= 1e-12)
        }
        v = _cge_bd_num(M.bddef[r, 3], "lower")
        if (v < .) lo[pos] = (v <= -1e299 ? J(rows(pos), 1, .) : v :* a)
        v = _cge_bd_num(M.bddef[r, 4], "upper")
        if (v < .) up[pos] = (v >= 1e299 ? J(rows(pos), 1, .) : v :* a)
        v = _cge_bd_num(M.bddef[r, 5], "scale")
        if (v < .) sc[pos] = v :* au
        v = _cge_bd_num(M.bddef[r, 6], "level")
        if (v < .) lv[pos] = v :* a
    }
    M.bdlp = _cge_which(lo :< .)
    M.bdlv = (rows(M.bdlp) ? lo[M.bdlp] : J(0, 1, .))
    M.bdup = _cge_which(up :< .)
    M.bduv = (rows(M.bdup) ? up[M.bdup] : J(0, 1, .))
    M.bdsp = _cge_which(lv :< .)
    M.bdsv = (rows(M.bdsp) ? lv[M.bdsp] : J(0, 1, .))
    M.bdcp = _cge_which(sc :< .)
    if (rows(M.bdcp)) M.xscale[M.bdcp] = sc[M.bdcp]
}

// The lower and upper bounds of every element, -1e300 and 1e300 where none
void _cge_bd_full(struct cge_model scalar M, real colvector lo, real colvector up)
{
    lo = J(rows(M.x0), 1, -1e300)
    up = J(rows(M.x0), 1, 1e300)
    if (rows(M.bdlp)) lo[M.bdlp] = M.bdlv
    if (rows(M.bdup)) up[M.bdup] = M.bduv
}

// Each lower bound at most its upper bound, and the base values and the
// starting levels within the bounds
void _cge_bd_valid(struct cge_model scalar M)
{
    real colvector lo, up, bad, f
    _cge_bd_full(M, lo, up)
    bad = _cge_which(lo :> up)
    if (rows(bad)) _cge_fail("cge_bound: the lower bound of " + _cge_poslabel(M, bad[1]) + " is above its upper bound", 198)
    bad = _cge_which(M.exists :& ((M.x0 :< lo) :| (M.x0 :> up)))
    // in a standalone model (from version 0.15.0) the base is the start: a
    // free variable starts from the nearest point within its bounds
    if (rows(bad) & _cge_sa(M)) {
        if (!any(M.fixed[bad])) {
            printf("{txt}Note: the starting level of %s is outside its bounds; cge_solve starts it within them\n", _cge_poslabel(M, bad[1]))
            bad = J(0, 1, .)
        }
    }
    if (rows(bad)) {
        _cge_fail("cge_bound: the base value of " + _cge_poslabel(M, bad[1]) + ", " + strtrim(sprintf("%14.8g", M.x0[bad[1]])) +
                  ", lies outside its bounds; the base solution must lie within them", 459)
    }
    if (!rows(M.bdsp)) return
    bad = _cge_which((M.bdsv :< lo[M.bdsp]) :| (M.bdsv :> up[M.bdsp]))
    if (rows(bad)) _cge_fail("cge_bound: the starting level of " + _cge_poslabel(M, M.bdsp[bad[1]]) + " lies outside its bounds", 459)
    f = J(rows(M.x0), 1, 0)
    if (rows(M.positive)) f[M.positive] = J(rows(M.positive), 1, 1)
    bad = _cge_which(f[M.bdsp] :& (M.bdsv :<= 0))
    if (rows(bad)) _cge_fail("cge_bound: the starting level of " + _cge_poslabel(M, M.bdsp[bad[1]]) + " must be positive, as its base value is", 459)
}

// cge_bound: attributes of the elements of a model or user variable, as
// GAMS's .lo, .up, .scale and .l; or, with fix(), the value of an exogenous
// variable, as .fx. With rel, the values are multiples of the base values.
void _cge_bd_add(string scalar name, string scalar elems, string scalar slo, string scalar sup,
                 string scalar ssc, string scalar slv, string scalar sfx, real scalar rel)
{
    struct cge_model scalar M, N
    real colvector pos, fr
    real scalar k, vlo, vup, vsc, vlv, vfx
    string scalar what
    M = _cge_load()
    _cge_need(M, "calibrated")
    k = _cge_vidx(M, name)
    if (!k) _cge_fail("cge_bound: " + name + " is not a model or user variable", 198)
    pos = _cge_bd_pos(M, k, elems)
    if (!rows(pos)) _cge_fail("cge_bound: " + name + " has no element in this model", 459)
    vlo = _cge_bd_num(slo, "lower")
    vup = _cge_bd_num(sup, "upper")
    vsc = _cge_bd_num(ssc, "scale")
    vlv = _cge_bd_num(slv, "level")
    vfx = _cge_bd_num(sfx, "fix")
    if (vlo >= . & vup >= . & vsc >= . & vlv >= . & vfx >= .) _cge_fail("cge_bound: give lower(), upper(), scale(), level() or fix()", 198)
    if (vlo == 1e300 | vup == -1e300) _cge_fail("cge_bound: a lower bound of inf or an upper bound of -inf leaves no value", 198)
    if (vsc < . & !(vsc > 0 & vsc < 1e299)) _cge_fail("cge_bound: scale() takes a positive number", 198)
    if ((vlv < . & abs(vlv) >= 1e299) | (vfx < . & abs(vfx) >= 1e299)) _cge_fail("cge_bound: level() and fix() take a number", 198)
    // fix(): the value of an exogenous variable, as .fx in GAMS
    if (vfx < .) {
        if (vlo < . | vup < . | vsc < . | vlv < .) _cge_fail("cge_bound: give fix() alone", 198)
        fr = _cge_which(M.fixed[pos] :== 0)
        if (rows(fr)) {
            _cge_fail("cge_bound: " + _cge_poslabel(M, pos[fr[1]]) + " is endogenous under the closure, so fixing it would leave more equations " +
                      "than free variables; fix it with cge_closure, swap(), then give its value", 459)
        }
        M.xcur[pos] = (rel ? vfx :* M.x0[pos] : J(rows(pos), 1, vfx))
        _cge_store(M)
        printf("{txt}Variable {res}%s{txt} fixed at %s for %f element(s)\n", name,
               _cge_gnum(vfx) + (rel ? " times the base" : ""), rows(pos))
        st_global("r(name)", name)
        st_numscalar("r(N_elements)", rows(pos))
        return
    }
    if (vlv < .) {
        // from version 0.14.0 also the variables that may move from a bound:
        // those that adjust for constraints and exogenous user variables at
        // a bound, as GAMS's .l of a positive variable
        fr = _cge_which(M.fixed[pos] :& (1 :- _cge_bd_movable(M, pos)))
        if (rows(fr)) {
            _cge_fail("cge_bound: " + _cge_poslabel(M, pos[fr[1]]) + " is fixed under the closure; level() gives the starting level of " +
                      "an endogenous variable, and fix() the value of a fixed one", 459)
        }
    }
    N = M
    if (cols(N.bddef) != 7) N.bddef = J(0, 7, "")
    N.bddef = N.bddef \ (name, strtrim(elems), strtrim(slo), strtrim(sup), strtrim(ssc), strtrim(slv), (rel ? "relative" : ""))
    _cge_bd_sync(N)
    _cge_bd_valid(N)
    _cge_store(N)
    what = ""
    if (vlo < .) what = what + ", lower bound " + (vlo <= -1e299 ? "removed" : _cge_gnum(vlo))
    if (vup < .) what = what + ", upper bound " + (vup >= 1e299 ? "removed" : _cge_gnum(vup))
    if (vsc < .) what = what + ", scale " + _cge_gnum(vsc)
    if (vlv < .) what = what + ", starting level " + _cge_gnum(vlv)
    printf("{txt}Variable {res}%s{txt}: %s%s for %f element(s)\n", name, substr(what, 3, .), (rel ? ", times the base" : ""), rows(pos))
    st_global("r(name)", name)
    st_numscalar("r(N_elements)", rows(pos))
    st_numscalar("r(N_definitions)", rows(N.bddef))
    st_numscalar("r(N_lower)", rows(N.bdlp))
    st_numscalar("r(N_upper)", rows(N.bdup))
    st_numscalar("r(N_scales)", rows(N.bdcp))
    st_numscalar("r(N_levels)", rows(N.bdsp))
}

// The definitions of cge_bound, and the elements they give attributes
void _cge_bd_list()
{
    struct cge_model scalar M
    real scalar n, r
    string scalar rel
    M = _cge_load()
    _cge_need(M, "calibrated")
    n = (cols(M.bddef) == 7 ? rows(M.bddef) : 0)
    st_numscalar("r(N_definitions)", n)
    st_numscalar("r(N_lower)", rows(M.bdlp))
    st_numscalar("r(N_upper)", rows(M.bdup))
    st_numscalar("r(N_scales)", rows(M.bdcp))
    st_numscalar("r(N_levels)", rows(M.bdsp))
    if (!n) {
        printf("{txt}No attributes of variables\n")
        return
    }
    printf("{txt}%-12s %-20s %12s %12s %12s %12s\n{hline 84}\n", "Variable", "Elements", "lower", "upper", "scale", "level")
    for (r = 1; r <= n; r++) {
        rel = (M.bddef[r, 7] == "relative" ? " (relative)" : "")
        printf("{txt}%-12s %-20s {res}%12s %12s %12s %12s{txt}%s\n", M.bddef[r, 1], _cge_trunc((M.bddef[r, 2] == "" ? "all" : M.bddef[r, 2]), 20),
               M.bddef[r, 3], M.bddef[r, 4], M.bddef[r, 5], M.bddef[r, 6], rel)
    }
    printf("{txt}{hline 84}\n")
    printf("{txt}Elements with a lower bound {res}%f{txt}, an upper bound {res}%f{txt}, a scale {res}%f{txt}, a starting level {res}%f\n",
           rows(M.bdlp), rows(M.bdup), rows(M.bdcp), rows(M.bdsp))
}

// Removes the definitions of cge_bound, of variable name or of every variable
void _cge_bd_clear(string scalar name)
{
    struct cge_model scalar M
    real colvector keep
    M = _cge_load()
    _cge_need(M, "calibrated")
    if (cols(M.bddef) != 7) M.bddef = J(0, 7, "")
    if (name == "") M.bddef = J(0, 7, "")
    else if (rows(M.bddef)) {
        if (!_cge_vidx(M, name)) _cge_fail("cge_bound: " + name + " is not a model or user variable", 198)
        keep = (M.bddef[., 1] :!= name)
        M.bddef = (any(keep) ? select(M.bddef, keep) : J(0, 7, ""))
    }
    // the integer and binary types (from version 0.18.0)
    if (cols(M.intdef) != 3) M.intdef = J(0, 3, "")
    if (name == "") M.intdef = J(0, 3, "")
    else if (rows(M.intdef)) {
        keep = (M.intdef[., 1] :!= name)
        M.intdef = (any(keep) ? select(M.intdef, keep) : J(0, 3, ""))
    }
    _cge_bd_sync(M)
    _cge_store(M)
    printf("{txt}Attributes %sremoved\n", (name == "" ? "of variables " : "of " + name + " "))
    st_numscalar("r(N_definitions)", rows(M.bddef))
}

// 1 for each position in pos of a variable that may move from a bound (from
// version 0.14.0): one that adjusts for a constraint, or an exogenous user
// variable at a bound, which an inequality paired with it may move
real colvector _cge_bd_movable(struct cge_model scalar M, real colvector pos)
{
    real colvector out, isx
    real scalar i, k, u
    out = J(rows(pos), 1, 0)
    isx = J(rows(M.x0), 1, 0)
    if (rows(M.bX)) isx[M.bX] = J(rows(M.bX), 1, 1)
    for (i = 1; i <= rows(pos); i++) {
        if (isx[pos[i]]) {
            out[i] = 1
            continue
        }
        for (k = rows(M.voff); k > 1; k--) if (M.voff[k] < pos[i]) break
        u = k - (rows(M.vname) - M.nuv)
        if (u >= 1 & u <= rows(M.uvdef)) {
            if (M.uvdef[u, 6] == "fixed" & M.uvdef[u, 8] + M.uvdef[u, 9] != "") out[i] = 1
        }
    }
    return(out)
}

// The start of cge_solve: the base, with the starting levels of cge_bound for
// the free variables and, from version 0.14.0, for the variables that adjust
// for constraints, which start there while their fixed levels stay the
// bounds they move from; an exogenous element outside its bounds stops the
// solve
real colvector _cge_bd_start(struct cge_model scalar M, real colvector xfix)
{
    real colvector x, k, fr, isx
    x = M.x0
    if (rows(M.bdlp)) {
        k = _cge_which(M.fixed[M.bdlp] :& (xfix[M.bdlp] :< M.bdlv))
        if (rows(k)) _cge_fail(_cge_poslabel(M, M.bdlp[k[1]]) + " is fixed at " + strtrim(sprintf("%14.8g", xfix[M.bdlp[k[1]]])) +
                               ", below its lower bound (cge_bound)", 459)
    }
    if (rows(M.bdup)) {
        k = _cge_which(M.fixed[M.bdup] :& (xfix[M.bdup] :> M.bduv))
        if (rows(k)) _cge_fail(_cge_poslabel(M, M.bdup[k[1]]) + " is fixed at " + strtrim(sprintf("%14.8g", xfix[M.bdup[k[1]]])) +
                               ", above its upper bound (cge_bound)", 459)
    }
    if (rows(M.bdsp)) {
        fr = (M.fixed[M.bdsp] :== 0)
        if (rows(M.bX)) {
            isx = J(rows(M.x0), 1, 0)
            isx[M.bX] = J(rows(M.bX), 1, 1)
            fr = fr :| isx[M.bdsp]
        }
        k = _cge_which(fr)
        if (rows(k)) x[M.bdsp[k]] = M.bdsv[k]
    }
    // a standalone model's free variables start within their bounds (from
    // version 0.15.0)
    if (_cge_sa(M)) {
        if (rows(M.bdlp)) {
            k = _cge_which(M.fixed[M.bdlp] :== 0)
            if (rows(k)) x[M.bdlp[k]] = rowmax((x[M.bdlp[k]], M.bdlv[k]))
        }
        if (rows(M.bdup)) {
            k = _cge_which(M.fixed[M.bdup] :== 0)
            if (rows(k)) x[M.bdup[k]] = rowmin((x[M.bdup[k]], M.bduv[k]))
        }
    }
    return(x)
}

// The free elements of x at a bound of cge_bound, within 1e-9 of their scale
real colvector _cge_bd_active(struct cge_model scalar M, real colvector x)
{
    real colvector a, k
    a = J(0, 1, .)
    if (rows(M.bdlp)) {
        k = _cge_which((M.fixed[M.bdlp] :== 0) :& (abs(x[M.bdlp] - M.bdlv) :<= 1e-9 :* M.xscale[M.bdlp]))
        if (rows(k)) a = a \ M.bdlp[k]
    }
    if (rows(M.bdup)) {
        k = _cge_which((M.fixed[M.bdup] :== 0) :& (abs(x[M.bdup] - M.bduv) :<= 1e-9 :* M.xscale[M.bdup]))
        if (rows(k)) a = a \ M.bdup[k]
    }
    return(a)
}

// After cge_solve: the free elements at a bound, which in a square system is
// not meant to bind, as GAMS warns of in a CNS model; after a failed solve, the
// bounds nearest the last point
void _cge_bd_note(struct cge_model scalar M, real colvector x, real scalar conv)
{
    real colvector a, pos, d, o
    real scalar k
    if (!rows(M.bdlp) & !rows(M.bdup)) {
        st_numscalar("r(N_atbound)", 0)
        return
    }
    a = _cge_bd_active(M, x)
    st_numscalar("r(N_atbound)", rows(a))
    if (conv) {
        if (!rows(a)) return
        printf("{txt}Note: {res}%f{txt} variable element(s) at a bound of cge_bound:", rows(a))
        for (k = 1; k <= min((rows(a), 5)); k++) printf(" {res}%s{txt}", _cge_poslabel(M, a[k]))
        if (rows(a) > 5) printf(" and %f more", rows(a) - 5)
        printf("\n{txt}A bound is not meant to bind in a square system, as in GAMS's CNS models; a limit that binds\n")
        printf("{txt}is a constraint (cge_constraint) or an inequality of cge_equation\n")
        return
    }
    // the distance of each free bounded element from its bound, relative to its scale
    pos = d = J(0, 1, .)
    for (k = 1; k <= rows(M.bdlp); k++) {
        if (M.fixed[M.bdlp[k]]) continue
        pos = pos \ M.bdlp[k]
        d = d \ (x[M.bdlp[k]] - M.bdlv[k]) / M.xscale[M.bdlp[k]]
    }
    for (k = 1; k <= rows(M.bdup); k++) {
        if (M.fixed[M.bdup[k]]) continue
        pos = pos \ M.bdup[k]
        d = d \ (M.bduv[k] - x[M.bdup[k]]) / M.xscale[M.bdup[k]]
    }
    if (!rows(pos)) return
    o = order(abs(d), 1)
    printf("{txt}Bounds of cge_bound nearest the last point, with the distance relative to the scale:\n")
    for (k = 1; k <= min((rows(o), 3)); k++) printf("{txt}  %-28s {res}%9.2e\n", _cge_poslabel(M, pos[o[k]]), d[o[k]])
    printf("{txt}A solution beyond a bound cannot be reached: remove the bound, or make the limit a constraint\n")
}

// The attributes of cge_bound for GAMS (cge_bounds.inc), included after the
// closure, which frees every variable and fixes some: .lo and .up of the
// variables free under the closure, except the adjusting variables of
// constraints, which cge_constraints.inc frees; .scale, with scaleopt; and .l,
// the starting levels of free variables. A mixed complementarity problem
// (mcp) bounds only the variables paired with an equation, so its bounds,
// which do not bind, are left out.
void _cge_gams_bounds(struct cge_model scalar M, real colvector fixed, string scalar fn, | real scalar mcp)
{
    real colvector skip
    string scalar g, idx
    real scalar fh, k
    if (args() < 4) mcp = 0
    fh = _cge_gopen(fn)
    fput(fh, "* Attributes of variables (cge_bound), written by cge_gams")
    skip = J(rows(M.x0), 1, (mcp != 0))
    if (rows(M.bX)) skip[M.bX] = J(rows(M.bX), 1, 1)
    if (mcp & rows(M.bdlp) + rows(M.bdup)) {
        fput(fh, "* The bounds are left out: GAMS's MCP models bound only the variables paired with")
        fput(fh, "* an equation, and in a square system the bounds do not bind")
    }
    for (k = 1; k <= rows(M.bdlp); k++) {
        if (fixed[M.bdlp[k]] | skip[M.bdlp[k]]) continue
        _cge_gams_ref(M, M.bdlp[k], g, idx)
        fput(fh, g + ".lo" + idx + " = " + _cge_gnum(M.bdlv[k]) + ";")
    }
    for (k = 1; k <= rows(M.bdup); k++) {
        if (fixed[M.bdup[k]] | skip[M.bdup[k]]) continue
        _cge_gams_ref(M, M.bdup[k], g, idx)
        fput(fh, g + ".up" + idx + " = " + _cge_gnum(M.bduv[k]) + ";")
    }
    for (k = 1; k <= rows(M.bdcp); k++) {
        _cge_gams_ref(M, M.bdcp[k], g, idx)
        fput(fh, g + ".scale" + idx + " = " + _cge_gnum(M.xscale[M.bdcp[k]]) + ";")
    }
    if (rows(M.bdcp)) fput(fh, "cge.scaleopt = 1;  cgenlp.scaleopt = 1;  cgecon.scaleopt = 1;")
    for (k = 1; k <= rows(M.bdsp); k++) {
        if (fixed[M.bdsp[k]]) continue
        _cge_gams_ref(M, M.bdsp[k], g, idx)
        fput(fh, g + ".l" + idx + " = " + _cge_gnum(M.bdsv[k]) + ";")
    }
    fclose(fh)
}

// The variables fixed under the closure of stored simulation k
real colvector _cge_sim_fixed(struct cge_model scalar M, real scalar k)
{
    struct cge_model scalar M2
    string rowvector cl
    real colvector fx, fr
    cl = tokens(M.simclosure[k])
    M2 = M
    _cge_swap_parse(M2, _cge_swap_tokens(cl), fx, fr)
    M2.swfix = fx
    M2.swfree = fr
    _cge_closure_cl(M2, cl)
    return(M2.fixed)
}

// Short descriptions of the model's variables (model_spec.md, Section 3)
string scalar _cge_vdesc(struct cge_model scalar M, string scalar name)
{
    string matrix T
    real colvector k
    T = ("PA", "activity price") \ ("PVA", "price of value added") \ ("PINTA", "price of aggregate intermediate input") \
        ("PX", "producer price of commodity output") \ ("PD", "price of domestic sales") \ ("PE", "export price") \
        ("PWE", "world export price") \ ("PM", "import price") \ ("PQ", "composite price") \ ("W", "average factor price") \
        ("EXR", "exchange rate") \ ("CPI", "consumer price index") \ ("DPI", "producer price index") \
        ("QA", "level of activity") \ ("QVA", "aggregate value added") \ ("QINTA", "aggregate intermediate input") \
        ("QF", "factor demand") \ ("QINT", "intermediate use") \ ("QX", "commodity output") \ ("QD", "domestic sales") \
        ("QE", "exports") \ ("QM", "imports") \ ("QQ", "composite supply") \ ("QH", "household consumption") \
        ("QHA", "home consumption") \ ("QG", "government consumption") \ ("QINV", "investment demand") \
        ("QT", "margin demand") \ ("QER", "exports from composite supply") \ ("QSHI", "purchases of the insurance fund") \
        ("QFS", "factor supply") \ ("LSW", "slack of the wage curve") \ ("LSM", "slack of the minimum wage") \
        ("YF", "factor income") \ ("YIF", "factor income of institutions") \ ("YI", "income of institutions") \
        ("EH", "household consumption spending") \ ("YG", "government revenue") \ ("EG", "government spending") \
        ("YSHI", "revenue of the insurance fund") \ ("SHIADJ", "scaling factor of the fund's purchases") \
        ("GSAV", "government savings") \ ("FSAV", "foreign savings") \ ("TINS", "direct tax rate") \
        ("MPS", "savings rate") \ ("TINSADJ", "direct tax scaling factor") \ ("TQADJ", "sales tax scaling factor") \
        ("TMADJ", "tariff scaling factor") \ ("TVADJ", "VAT scaling factor") \ ("MPSADJ", "savings rate scaling factor") \
        ("IADJ", "investment scaling factor") \ ("GADJ", "government consumption scaling factor") \
        ("WFDIST", "wage distortion factor") \ ("EFF", "factor efficiency") \ ("DW", "days worked") \
        ("HS", "volume of health services") \ ("WALRAS", "slack of the savings-investment balance") \
        ("RM", "import premium") \ ("RE", "export premium") \ ("RA", "rent on output") \
        ("QNA", "quantity of a nest") \ ("PNA", "price of a nest") \ ("QXAC", "output of a commodity by an activity") \
        ("PXAC", "price of an activity's output")
    k = selectindex(T[., 1] :== name)
    if (length(k)) return(T[k[1], 2])
    if (M.nuv) if (_cge_vidx(M, name) > rows(M.vname) - M.nuv) return("user variable")
    return("")
}

// A value of the solution listing, as GAMS prints it: . for zero, -INF and +INF
string scalar _cge_sol_num(real scalar v)
{
    if (v >= .) return("")
    if (v <= -1e299) return("-INF")
    if (v >= 1e299) return("+INF")
    if (v == 0) return(".")
    return(strtrim(sprintf("%14.7g", v)))
}

void _cge_sol_head(string scalar kind, string scalar name, string scalar desc)
{
    printf("\n{txt}---- %s {res}%s{txt}  %s\n\n", kind, name, desc)
    printf("{txt}  %-24s %14s %14s %14s %14s\n", "", "LOWER", "LEVEL", "UPPER", "MARGINAL")
}

void _cge_sol_row(string scalar el, real scalar lo, real scalar lv, real scalar up, real scalar mg)
{
    printf("{txt}  %-24s {res}%14s %14s %14s %14s\n", _cge_trunc(el, 24), _cge_sol_num(lo), _cge_sol_num(lv), _cge_sol_num(up),
           (mg >= . ? "." : _cge_sol_num(mg)))
}

// The solution listing (from version 0.9.8), as GAMS writes it after a solve:
// for each block of variables and equations asked for, LOWER, LEVEL, UPPER
// and MARGINAL of each element. A variable fixed under the closure has its
// level as both bounds; a free one has the bounds of cge_bound, or -INF and
// +INF. An equation is written with every term on the left: its bounds are 0
// and its level is its residual. The square system has no marginals, as
// GAMS's CNS models have none. A constraint (Section 16, and each inequality
// of cge_equation) is a complementarity pair: its level is the room within its
// bound, sigma (b - Y), and its marginal the move of its adjusting variable,
// delta (X - xbar), as in GAMS's MCP model, where the marginal of a row is the
// level of its column.
void _cge_solution(string scalar sim, real scalar base, real scalar current, string scalar vars,
                   string scalar blocks, real scalar all, real scalar clear)
{
    struct cge_model scalar M
    struct cge_par scalar p
    real colvector x, L, R, K, fixed, lo, up, pos, room, move, act, g, o, ins, cfix, at
    string colvector e1, e2, bl, el
    string rowvector wv, wb
    string scalar what, d, b, e
    real scalar k, i, j, n, nc, nb, kv, nrow, row
    real matrix V
    string matrix S
    M = _cge_load()
    _cge_need(M, "calibrated")
    if ((sim != "") + base + current > 1) _cge_fail("give one of sim(), base and current", 198)
    if (sim == "" & !base & !current) {
        if (rows(M.simname)) sim = M.simname[rows(M.simname)]
        else base = 1
    }
    if (sim != "") {
        k = _cge_sim_index(M, sim)
        if (M.simrun[k] != "") _cge_fail("simulation " + sim + " is a period of dynamic run " + M.simrun[k] + "; give a static simulation", 198)
        p = M.simp[k]
        x = M.simx[., k]
        fixed = _cge_sim_fixed(M, k)
        what = "simulation " + sim
    }
    else if (base) {
        p = M.p0
        x = M.x0
        fixed = M.fixed
        what = "the base"
    }
    else {
        p = M.p
        x = M.xcur
        fixed = M.fixed
        what = "the current point, before it is solved"
    }
    _cge_bd_full(M, lo, up)
    // the constraints: room within the bound and move of the adjusting variable
    nc = 0
    act = room = move = J(0, 1, .)
    if (rows(M.bY) & rows(p.bmode) == rows(M.bY)) {
        act = _cge_which(p.bmode :> 0)
        nc = rows(act)
        if (nc) {
            room = M.btype[act] :* (p.bval[act] - x[M.bY[act]])
            // the fixed levels of the adjusting variables: those of the solve,
            // or the current ones before a solve
            move = M.bdir[act] :* (x[M.bX[act]] - (rows(p.bxbar) == rows(M.bY) ? p.bxbar[act] : x[M.bX[act]]))
        }
    }
    cfix = J(rows(x), 1, 0)
    if (nc) cfix[M.bX[act]] = J(nc, 1, 1)
    // the equations in the system
    _cge_eq(M, p, x, L, R, K, 0)
    ins = _cge_which(M.emask :!= 0)
    bl = el = J(rows(ins), 1, "")
    for (i = 1; i <= rows(ins); i++) {
        _cge_eqlabel(M, ins[i], b, e, d)
        bl[i] = b
        el[i] = e
    }
    at = _cge_bd_active(M, x)
    printf("{txt}Solution listing at %s: {res}%f{txt} variable elements ({res}%f{txt} free), {res}%f{txt} equation elements\n",
           what, sum(M.exists), sum(M.exists :& (fixed :== 0)), rows(ins))
    if (nc) printf("{txt}Constraints: {res}%f{txt}, of which {res}%f{txt} bind\n", nc, sum(abs(room) :<= 1e-9 :* M.xscale[M.bY[act]]))
    if (rows(M.bdlp) + rows(M.bdup)) printf("{txt}Elements at a bound of cge_bound: {res}%f\n", rows(at))
    // the blocks to list
    wv = (all ? M.vname' : tokens(vars))
    wb = (all ? J(1, 0, "") : tokens(strupper(blocks)))
    if (all) {
        for (i = 1; i <= rows(bl); i++) if (!anyof(wb, bl[i]) & bl[i] != "B1") wb = wb, bl[i]
    }
    for (k = 1; k <= cols(wv); k++) if (!_cge_vidx(M, wv[k])) _cge_fail("variables(): " + wv[k] + " is not a model or user variable", 198)
    for (k = 1; k <= cols(wb); k++) if (!anyof(M.ename, wb[k])) _cge_fail("blocks(): " + wb[k] + " is not an equation block (model_spec.md, Section 5)", 198)
    // by default the variables with attributes of cge_bound
    if (!all & !cols(wv) & !cols(wb)) {
        for (k = 1; k <= rows(M.bddef); k++) if (!anyof(wv, M.bddef[k, 1])) wv = wv, M.bddef[k, 1]
    }
    for (k = 1; k <= cols(wv); k++) {
        kv = _cge_vidx(M, wv[k])
        pos = _cge_bd_exist(M, _cge_vpos(M, kv))
        if (!rows(pos)) continue
        _cge_vlabels(M, kv, e1, e2)
        _cge_sol_head("VAR", wv[k], _cge_vdesc(M, wv[k]))
        for (i = 1; i <= rows(pos); i++) {
            j = pos[i] - M.voff[kv]
            if (fixed[pos[i]] & !cfix[pos[i]]) _cge_sol_row((e1[j] == "" ? "" : e1[j] + (e2[j] == "" ? "" : "." + e2[j])), x[pos[i]], x[pos[i]], x[pos[i]], .)
            else _cge_sol_row((e1[j] == "" ? "" : e1[j] + (e2[j] == "" ? "" : "." + e2[j])), lo[pos[i]], x[pos[i]], up[pos[i]], .)
        }
    }
    for (k = 1; k <= cols(wb); k++) {
        // the constraints are listed below
        if (wb[k] == "B1") continue
        o = _cge_which(bl :== wb[k])
        if (!rows(o)) continue
        _cge_eqinfo(wb[k], b, d)
        _cge_sol_head("EQU", wb[k], d)
        for (i = 1; i <= rows(o); i++) _cge_sol_row(el[o[i]], 0, L[ins[o[i]]] - R[ins[o[i]]], 0, .)
    }
    // the constraints, always listed
    if (nc) {
        _cge_sol_head("EQU", "B1", "constraint: room within the bound; marginal, the move of the adjusting variable")
        for (i = 1; i <= nc; i++) _cge_sol_row(_cge_poslabel(M, M.bY[act[i]]), 0, room[i], 1e300, move[i])
    }
    if (!cols(wv) & !cols(wb) & !nc) printf("\n{txt}Give variables(), blocks() or all to list blocks\n")
    // the listing as a dataset: every variable and equation element
    if (clear) {
        nrow = sum(M.exists) + rows(ins) + nc
        S = J(nrow, 3, "")
        V = J(nrow, 4, .)
        row = 0
        for (kv = 1; kv <= rows(M.vname); kv++) {
            pos = _cge_bd_exist(M, _cge_vpos(M, kv))
            if (!rows(pos)) continue
            _cge_vlabels(M, kv, e1, e2)
            for (i = 1; i <= rows(pos); i++) {
                row++
                j = pos[i] - M.voff[kv]
                S[row, .] = ("VAR", M.vname[kv], (e1[j] == "" ? "" : e1[j] + (e2[j] == "" ? "" : "." + e2[j])))
                if (fixed[pos[i]] & !cfix[pos[i]]) V[row, .] = (x[pos[i]], x[pos[i]], x[pos[i]], .)
                else V[row, .] = ((lo[pos[i]] <= -1e299 ? . : lo[pos[i]]), x[pos[i]], (up[pos[i]] >= 1e299 ? . : up[pos[i]]), .)
            }
        }
        for (i = 1; i <= rows(ins); i++) {
            if (bl[i] == "B1") continue
            row++
            S[row, .] = ("EQU", bl[i], el[i])
            V[row, .] = (0, L[ins[i]] - R[ins[i]], 0, .)
        }
        for (i = 1; i <= nc; i++) {
            row++
            S[row, .] = ("EQU", "B1", _cge_poslabel(M, M.bY[act[i]]))
            V[row, .] = (0, room[i], ., move[i])
        }
        S = S[|1, 1 \ row, 3|]
        V = V[|1, 1 \ row, 4|]
        stata("clear")
        st_addobs(row)
        (void) st_addvar("str3", "kind")
        (void) st_addvar("str" + strofreal(max((1, max(strlen(S[., 2]))))), "name")
        (void) st_addvar("str" + strofreal(max((1, max(strlen(S[., 3]))))), "element")
        (void) st_addvar(("double", "double", "double", "double"), ("lower", "level", "upper", "marginal"))
        st_sstore(., ("kind", "name", "element"), S)
        st_store(., ("lower", "level", "upper", "marginal"), V)
    }
    st_numscalar("r(N_variables)", sum(M.exists))
    st_numscalar("r(N_free)", sum(M.exists :& (fixed :== 0)))
    st_numscalar("r(N_equations)", rows(ins))
    st_numscalar("r(N_constraints)", nc)
    st_numscalar("r(N_atbound)", rows(at))
    if (nc) {
        nb = sum(abs(room) :<= 1e-9 :* M.xscale[M.bY[act]])
        st_numscalar("r(N_binding)", nb)
        st_matrix("r(marginals)", move')
        st_matrix("r(room)", room')
    }
    st_global("r(point)", what)
}

// =====================================================================
// Results
// =====================================================================

real scalar _cge_sim_index(struct cge_model scalar M, string scalar sim)
{
    real scalar k
    if (rows(M.simname) == 0) _cge_fail("no simulation has been solved; use cge_solve", 459)
    if (sim == "") return(rows(M.simname))
    k = _cge_find(M.simname, sim)
    if (k == 0) _cge_fail("simulation " + sim + " not found", 111)
    return(k)
}

// Price paid by final users, including VAT (model_spec.md, P8; from version
// 0.3.1): PH = PQ (1 + tv TVADJ)
real colvector _cge_ph(struct cge_model scalar M, struct cge_par scalar p, real colvector x)
{
    return(_cge_v(M, x, 8) :* (1 :+ p.tv :* _cge_v(M, x, 52)))
}

// World export prices: PWE where export demand is finite, else pwe (13.2)
real colvector _cge_pwe(struct cge_model scalar M, struct cge_par scalar p, real colvector x)
{
    return(M.ced :* _cge_v(M, x, 53) + (1 :- M.ced) :* p.pwe)
}

// Net VAT revenue (I8)
real scalar _cge_vat(struct cge_model scalar M, struct cge_par scalar p, real colvector x)
{
    real colvector base
    base = rowsum(_cge_v(M, x, 23)) + _cge_v(M, x, 24) + _cge_v(M, x, 25) + _cge_v(M, x, 47) +
           rowsum(_cge_v(M, x, 17) :* (1 :- p.kappa)')
    return(sum(p.tv :* _cge_v(M, x, 52) :* _cge_v(M, x, 8) :* base))
}

real colvector _cge_ev(struct cge_model scalar M, struct cge_par scalar p, real colvector x)
{
    real matrix PQ0, PQ1, B, G
    real colvector EH0, EH1
    // Prices households pay: with VAT for marketed goods, PA for home goods (13.1)
    PQ0 = _cge_ph(M, M.p0, M.x0) \ _cge_v(M, M.x0, 1)
    PQ1 = _cge_ph(M, p, x) \ _cge_v(M, x, 1)
    B = p.beta \ p.betah
    G = p.gamma \ p.gammah
    EH0 = _cge_v(M, M.x0, _cge_vidx(M, "EH"))
    EH1 = _cge_v(M, x, _cge_vidx(M, "EH"))
    return((PQ0' * G)' + (EH1 - (PQ1' * G)') :* exp(colsum(B :* ln(PQ0 :/ PQ1)))' - EH0)
}

// Spending of each activity on the commodities in its nests of value added,
// at the prices it pays, with the VAT it cannot recover (from version 0.5.1,
// Section 17.2): part of PVA QVA, but not of value added. With base = 1, at
// base prices.
real colvector _cge_nestbuy(struct cge_model scalar M, struct cge_par scalar p, real colvector x,
                            real scalar base)
{
    real colvector PQ
    real scalar TVADJ
    if (!any(M.ecell)) return(J(M.n, 1, 0))
    PQ = _cge_vn(M, (base ? M.x0 : x), "PQ")
    TVADJ = _cge_vn(M, (base ? M.x0 : x), "TVADJ")
    return(colsum(M.ecell :* PQ :* (1 :+ (p.tv :* TVADJ) * (1 :- p.kappa)') :* _cge_vn(M, x, "QINT"))')
}

// Real value added of each activity at base prices: PVA0 QVA less the
// commodities in its nests at base prices (from version 0.5.1)
real colvector _cge_va_real(struct cge_model scalar M, real colvector x)
{
    return(_cge_vn(M, M.x0, "PVA") :* _cge_vn(M, x, "QVA") - _cge_nestbuy(M, M.p0, x, 1))
}

// Expenditure-side GDP minus income-side GDP; zero at any solution
real scalar _cge_gdpgap(struct cge_model scalar M, struct cge_par scalar p, real colvector x)
{
    real matrix PQ, QH, QG, QINV, QE, QM, EXR, PVA, QVA, QQ, PA, QA, QER, QSHI
    real rowvector ab
    real scalar expend, income
    PQ = _cge_v(M, x, 8);    QH = _cge_v(M, x, 23);   QG = _cge_v(M, x, 24)
    QINV = _cge_v(M, x, 25); QE = _cge_v(M, x, 20);   QM = _cge_v(M, x, 21)
    EXR = _cge_v(M, x, 10);  PVA = _cge_v(M, x, 2);   QVA = _cge_v(M, x, 14)
    QQ = _cge_v(M, x, 22);   PA = _cge_v(M, x, 1);    QA = _cge_v(M, x, 13)
    QER = _cge_v(M, x, 44);  QSHI = _cge_v(M, x, 47)
    // Rents (Section 16.1): premiums received at home and every rent on output
    // are income; premiums paid abroad change the value of trade
    ab = _cge_rents_abroad(M, p, x)
    expend = _cge_ph(M, p, x)' * (rowsum(QH) + QG + QINV + QSHI) + PQ' * QER +
             PA' * rowsum(_cge_v(M, x, 54)) + EXR * (_cge_pwe(M, p, x)' * QE) - ab[2] - EXR * (p.pwm' * QM) - ab[1]
    // the commodities in nests of value added are intermediate inputs (from version 0.5.1)
    income = PVA' * QVA - sum(_cge_nestbuy(M, p, x, 0)) + sum(p.tq :* _cge_v(M, x, 50) :* PQ :* QQ) +
             EXR * sum(p.tm :* _cge_v(M, x, 51) :* p.pwm :* QM) +
             EXR * sum(p.te :* _cge_pwe(M, p, x) :* QE) + sum(p.ta :* PA :* QA) + _cge_vat(M, p, x) +
             EXR * sum(_cge_v(M, x, 58) :* p.pwm :* QM) - ab[1] + EXR * sum(_cge_v(M, x, 59) :* _cge_pwe(M, p, x) :* QE) -
             ab[2] + sum(_cge_v(M, x, 60) :* PA :* QA)
    return(expend - income)
}

// Premiums on imports and on exports paid to the rest of the world, in local
// currency (Section 16.1)
real rowvector _cge_rents_abroad(struct cge_model scalar M, struct cge_par scalar p, real colvector x)
{
    real scalar EXR, row
    row = M.nF + M.nD + 2
    EXR = _cge_v(M, x, 10)
    return((EXR * sum((p.rrm :== row) :* _cge_v(M, x, 58) :* p.pwm :* _cge_v(M, x, 21)),
            EXR * sum((p.rre :== row) :* _cge_v(M, x, 59) :* _cge_pwe(M, p, x) :* _cge_v(M, x, 20))))
}

void _cge_results_data(string scalar sim)
{
    struct cge_model scalar M
    string colvector v, e1, e2, l1, l2
    real colvector base, value, pos, keep
    real scalar k, s, N

    M = _cge_load()
    _cge_need(M, "calibrated")
    s = _cge_sim_index(M, sim)
    v = J(0, 1, "")
    e1 = v
    e2 = v
    base = J(0, 1, .)
    value = base
    for (k = 1; k <= rows(M.vname); k++) {
        _cge_vlabels(M, k, l1, l2)
        pos = _cge_vpos(M, k)
        keep = M.exists[pos]
        // select() on a 1 x 1 matrix with a zero mask returns 1 x 0, not 0 x 1
        if (!any(keep)) continue
        v = v \ select(J(rows(pos), 1, M.vname[k]), keep)
        e1 = e1 \ select(l1, keep)
        e2 = e2 \ select(l2, keep)
        base = base \ select(M.x0[pos], keep)
        value = value \ select(M.simx[pos, s], keep)
    }
    N = rows(v)
    st_addobs(N)
    (void) st_addvar("str32", "variable")
    (void) st_addvar("str32", "element1")
    (void) st_addvar("str32", "element2")
    (void) st_addvar("double", "base")
    (void) st_addvar("double", "value")
    st_sstore(., "variable", v)
    st_sstore(., "element1", e1)
    st_sstore(., "element2", e2)
    st_store(., "base", base)
    st_store(., "value", value)
}

void _cge_results_show(string scalar sim)
{
    struct cge_model scalar M
    struct cge_par scalar p
    real colvector x, ev, eh0
    real matrix b, s
    real scalar k, si

    real scalar ms, ss
    M = _cge_load()
    _cge_need(M, "calibrated")
    si = _cge_sim_index(M, sim)
    x = M.simx[., si]
    p = M.simp[si]
    // the statuses (from version 0.16.0) and the named model (from version
    // 0.17.0)
    _cge_simstat(M, si, ms, ss)
    st_numscalar("r(modelstat)", ms)
    st_numscalar("r(solvestat)", ss)
    st_numscalar("r(converged)", M.simconv[si])
    st_global("r(model)", _cge_simmodel(M, si))
    if (_cge_sa(M)) {
        _cge_results_sa(M, si)
        return
    }

    printf("\n{txt}Simulation {res}%s{txt} (closure: %s)\n", M.simname[si], M.simclosure[si])
    printf("{txt}{hline 52}\n")
    printf("{txt}%-34s %8s %8s\n", "", "base", "% change")
    printf("{txt}{hline 52}\n")
    _cge_row(M, x, "Real value added (base prices)", sum(_cge_va_real(M, M.x0)), sum(_cge_va_real(M, x)))
    _cge_row(M, x, "Exchange rate", _cge_v(M, M.x0, 10), _cge_v(M, x, 10))
    _cge_row(M, x, "Consumer price index", _cge_v(M, M.x0, 11), _cge_v(M, x, 11))
    _cge_row(M, x, "Investment volume (IADJ)", _cge_v(M, M.x0, 39), _cge_v(M, x, 39))
    _cge_row(M, x, "Imports (world prices)", p.pwm' * _cge_v(M, M.x0, 21), p.pwm' * _cge_v(M, x, 21))
    _cge_row(M, x, "Exports (world prices)", p.pwe' * (_cge_v(M, M.x0, 20) + _cge_v(M, M.x0, 44)),
             p.pwe' * (_cge_v(M, x, 20) + _cge_v(M, x, 44)))
    _cge_row(M, x, "Government savings", _cge_v(M, M.x0, 33), _cge_v(M, x, 33))
    if (M.ishi) _cge_row(M, x, "Health insurance purchases (SHIADJ)", _cge_v(M, M.x0, 46), _cge_v(M, x, 46))
    b = _cge_v(M, M.x0, 9)
    s = _cge_v(M, x, 9)
    for (k = 1; k <= M.nF; k++) _cge_row(M, x, "Price of " + M.F[k], b[k], s[k])
    b = _cge_v(M, M.x0, 13)
    s = _cge_v(M, x, 13)
    for (k = 1; k <= M.n; k++) _cge_row(M, x, "Output of " + M.A[k], b[k], s[k])
    printf("{txt}{hline 52}\n")
    ev = _cge_ev(M, p, x)
    eh0 = _cge_v(M, M.x0, 30)
    for (k = 1; k <= M.nH; k++) {
        printf("{txt}Equivalent variation, %-12s {res}%9.4g{txt} (%5.2f%% of consumption)\n",
               M.H[k], ev[k], 100 * ev[k] / eh0[k])
    }
    printf("{txt}WALRAS {res}%9.3e{txt}; GDP identity gap {res}%9.3e\n",
           x[M.voff[42] + 1], _cge_gdpgap(M, p, x))
    st_matrix("r(ev)", ev')
    st_global("r(sim)", M.simname[si])
}

// The results of simulation si of a standalone model (from version 0.13.0):
// the elements of its variables, at the start and in the solution
void _cge_results_sa(struct cge_model scalar M, real scalar si)
{
    real colvector pos, x
    real scalar k, i, n, b, s
    x = M.simx[., si]
    // the named model it solved (from version 0.17.0)
    printf("\n{txt}Simulation {res}%s{txt} of %s (%s, %f iteration(s), largest scaled residual %9.3e)\n",
           M.simname[si], (_cge_simmodel(M, si) != "" ? "model " + _cge_simmodel(M, si) + " of a standalone model" :
           "a standalone model"), (M.simconv[si] ? "solved" : "not solved"), M.simiter[si], M.simres[si])
    printf("{txt}{hline 67}\n")
    printf("{txt}%-32s %12s %12s %8s\n", "", "start", "solution", "% change")
    printf("{txt}{hline 67}\n")
    n = 0
    for (k = 1; k <= rows(M.vname); k++) {
        if (substr(M.vname[k], 1, 1) == "_") continue
        pos = _cge_vpos(M, k)
        for (i = 1; i <= rows(pos); i++) {
            if (!M.exists[pos[i]]) continue
            n++
            if (n > 40) continue
            b = M.x0[pos[i]]
            s = x[pos[i]]
            printf("{txt}%-32s {res}%12.6g %12.6g %8.3f\n", _cge_trunc(_cge_poslabel(M, pos[i]), 32), b, s,
                   (b != 0 ? 100 * (s - b) / abs(b) : .))
        }
    }
    printf("{txt}{hline 67}\n")
    if (n > 40) printf("{txt}%f more elements: cge_results, sim(%s) clear lists them all\n", n - 40, M.simname[si])
    st_global("r(sim)", M.simname[si])
}

void _cge_row(struct cge_model scalar M, real colvector x, string scalar label, real scalar b, real scalar s)
{
    // Change relative to the absolute base, so that a fall is negative even
    // when the base is negative (for example government savings)
    printf("{txt}%-34s {res}%8.4g %8.3f\n", label, b, (b != 0 ? 100 * (s - b) / abs(b) : .))
}

// =====================================================================
// Checks (model_spec.md, Section 8)
// =====================================================================

void _cge_check(string scalar sim, real scalar homog, real scalar perturb, real scalar seed)
{
    struct cge_model scalar M
    struct cge_par scalar p
    real colvector x, xfix, start, free, target, rel, unit
    real scalar fails, v, conv, iter, err, si, scale, tol
    string scalar method

    M = _cge_load()
    _cge_need(M, "sam")
    _cge_need(M, "calibrated")
    fails = 0
    scale = max((1, max(abs(M.S))))

    v = max(abs(rowsum(M.S) - colsum(M.S)'))
    fails = fails + _cge_report("SAM balance (largest imbalance)", v, 1e-8 * scale)
    // the model's own equations (from version 0.7.1): user equations need not
    // hold at the base
    v = _cge_maxres_part(M, M.p0, M.x0, 0)
    fails = fails + _cge_report("benchmark replication (largest scaled residual)", v, 1e-9)
    v = abs(sum(M.exists :* (1 :- M.fixed)) + rows(M.bY) - M.neq)
    fails = fails + _cge_report("closure is square (free variables minus equations)", v, 0.5)

    if (rows(M.simname)) {
        si = _cge_sim_index(M, sim)
        x = M.simx[., si]
        p = M.simp[si]
        printf("{txt}Simulation {res}%s{txt}:\n", M.simname[si])
        fails = fails + _cge_report("  solution (largest scaled residual)", M.simres[si], 1e-8)
        fails = fails + _cge_report("  Walras's law (WALRAS)", abs(x[M.voff[42] + 1]), 1e-8 * scale)
        fails = fails + _cge_report("  GDP identity (expenditure minus income)", abs(_cge_gdpgap(M, p, x)), 1e-8 * scale)
    }

    // Deviations are relative to each value, with a floor of one; a variable whose
    // base value is zero (WALRAS) is measured against the largest SAM entry, as in
    // the Walras's-law check, so that the checks do not depend on the SAM's units
    unit = (M.x0 :!= 0) + (M.x0 :== 0) :* scale

    if (homog) {
        // Double every fixed nominal value: nominal variables should double and real ones stay put
        xfix = M.x0 :* (1 :+ M.fixed :* M.nominal)
        x = _cge_solve_point(M, M.p0, xfix, M.x0, 1e-12, 100, 0, conv, iter, err, method)
        target = M.x0 :* (1 :+ M.nominal)
        rel = select(abs(x - target) :/ rowmax((unit, abs(target))), M.exists)
        v = (conv ? max(rel) : .)
        fails = fails + _cge_report("homogeneity (largest relative deviation)", v, 1e-8)
    }

    if (perturb > 0) {
        rseed(seed)
        start = M.x0 :* (1 :+ perturb * (2 * runiform(rows(M.x0), 1) :- 1))
        x = _cge_solve_point(M, M.p0, M.x0, start, 1e-12, 100, 0, conv, iter, err, method)
        rel = select(abs(x - M.x0) :/ rowmax((unit, abs(M.x0))), M.exists)
        v = (conv ? max(rel) : .)
        fails = fails + _cge_report("perturbed start returns the base (largest deviation)", v, 1e-7)
    }

    st_numscalar("r(failures)", fails)
    if (fails) printf("{err}%f check(s) failed\n", fails)
    else printf("{txt}All checks passed\n")
}

real scalar _cge_report(string scalar label, real scalar value, real scalar tol)
{
    real scalar ok
    ok = (value < . & value <= tol)
    printf("{txt}  %s %-52s {res}%9.3e\n", (ok ? "[ok]  " : "{err}[fail]{txt}"), label, value)
    return(!ok)
}


// =====================================================================
// Reporting (model_spec.md, Section 9; from version 0.1.15)
// =====================================================================

real matrix _cge_vn(struct cge_model scalar M, real colvector x, string scalar name)
{
    return(_cge_v(M, x, _cge_vidx(M, name)))
}

// Compensating variation by household: spending after the shock less the
// spending that would give base utility at the new prices (Cobb-Douglas or LES)
real colvector _cge_cv(struct cge_model scalar M, struct cge_par scalar p, real colvector x)
{
    real colvector PQ0, PQ1, EH0, EH1
    real matrix B, G
    PQ0 = _cge_ph(M, M.p0, M.x0) \ _cge_vn(M, M.x0, "PA")
    PQ1 = _cge_ph(M, p, x) \ _cge_vn(M, x, "PA")
    B = p.beta \ p.betah
    G = p.gamma \ p.gammah
    EH0 = _cge_vn(M, M.x0, "EH")
    EH1 = _cge_vn(M, x, "EH")
    return(EH1 - (PQ1' * G)' - (EH0 - (PQ0' * G)') :* exp(colsum(B :* ln(PQ1 :/ PQ0)))')
}

void _cge_radd(string matrix keys, real colvector val, string scalar table, string scalar measure,
               string scalar element, real scalar value)
{
    keys = keys \ (table, measure, element)
    val = val \ value
}

// Report measures at the point x with parameters p, one row per measure.
// Real measures use base prices, and base world prices for trade.
void _cge_measures(struct cge_model scalar M, struct cge_par scalar p, real colvector x,
                   string matrix keys, real colvector val)
{
    struct cge_par scalar p0
    real colvector PQ, PQ0, QG, QINV, QSHI, QER, QE, QM, fin, YI, TINS, MPS, W, YF, QFS, EH
    real colvector QA, PA, va, QQ, QX, QD, EFF, PH, PH0, home, PA0, pwe, DW
    real matrix QH
    real scalar EXR, EXR0, CPI, DPI, gdpn, gdpr, k, gsav, intd, intf, endd, endf, ratio
    real rowvector ab

    p0 = M.p0
    keys = J(0, 3, "")
    val = J(0, 1, .)
    PQ = _cge_vn(M, x, "PQ");        PQ0 = _cge_vn(M, M.x0, "PQ")
    QH = _cge_vn(M, x, "QH");        QG = _cge_vn(M, x, "QG")
    QINV = _cge_vn(M, x, "QINV");    QSHI = _cge_vn(M, x, "QSHI")
    QER = _cge_vn(M, x, "QER");      QE = _cge_vn(M, x, "QE")
    QM = _cge_vn(M, x, "QM");        EXR = _cge_vn(M, x, "EXR")
    EXR0 = _cge_vn(M, M.x0, "EXR");  CPI = _cge_vn(M, x, "CPI")
    DPI = _cge_vn(M, x, "DPI");      YI = _cge_vn(M, x, "YI")
    TINS = _cge_vn(M, x, "TINS");    MPS = _cge_vn(M, x, "MPS")
    W = _cge_vn(M, x, "W");          YF = _cge_vn(M, x, "YF")
    QFS = _cge_vn(M, x, "QFS");      EH = _cge_vn(M, x, "EH")
    QA = _cge_vn(M, x, "QA");        PA = _cge_vn(M, x, "PA")
    va = _cge_va_real(M, x)
    QQ = _cge_vn(M, x, "QQ");        QX = _cge_vn(M, x, "QX")
    QD = _cge_vn(M, x, "QD");        EFF = _cge_vn(M, x, "EFF")

    // Final demand at final-user prices, including VAT; exports from composite
    // supply at PQ (from version 0.3.1)
    PH = _cge_ph(M, p, x)
    PH0 = _cge_ph(M, p0, M.x0)
    fin = rowsum(QH) + QG + QINV + QSHI
    // Home consumption at producer prices, and world export prices (from version 0.3.2)
    home = rowsum(_cge_vn(M, x, "QHA"))
    PA0 = _cge_vn(M, M.x0, "PA")
    pwe = _cge_pwe(M, p, x)
    // Premiums paid abroad change the value of trade (from version 0.4.4)
    ab = _cge_rents_abroad(M, p, x)
    gdpn = PH' * fin + PQ' * QER + PA' * home + EXR * (pwe' * QE) - ab[2] - EXR * (p.pwm' * QM) - ab[1]
    gdpr = PH0' * fin + PQ0' * QER + PA0' * home + EXR0 * (p0.pwe' * QE) - EXR0 * (p0.pwm' * QM)
    _cge_radd(keys, val, "macro", "gdp_nominal", "", gdpn)
    _cge_radd(keys, val, "macro", "gdp_real", "", gdpr)
    _cge_radd(keys, val, "macro", "gdp_deflator", "", gdpn / gdpr)
    _cge_radd(keys, val, "macro", "consumption_real", "", PH0' * rowsum(QH) + PA0' * home)
    if (any(p0.betah)) _cge_radd(keys, val, "macro", "home_consumption_real", "", PA0' * home)
    _cge_radd(keys, val, "macro", "government_real", "", PH0' * QG)
    _cge_radd(keys, val, "macro", "investment_real", "", PH0' * QINV)
    _cge_radd(keys, val, "macro", "insurance_fund_real", "", PH0' * QSHI)
    _cge_radd(keys, val, "macro", "exports_real", "", EXR0 * (p0.pwe' * QE) + PQ0' * QER)
    _cge_radd(keys, val, "macro", "imports_real", "", EXR0 * (p0.pwm' * QM))
    // without the commodities in nests of value added (from version 0.5.1)
    _cge_radd(keys, val, "macro", "value_added_real", "", sum(va))
    _cge_radd(keys, val, "macro", "cpi", "", CPI)
    _cge_radd(keys, val, "macro", "dpi", "", DPI)
    _cge_radd(keys, val, "macro", "exchange_rate", "", EXR)
    _cge_radd(keys, val, "macro", "real_exchange_rate", "", EXR / DPI)
    _cge_radd(keys, val, "macro", "private_savings", "", (MPS :* (1 :- TINS))' * YI)
    _cge_radd(keys, val, "macro", "investment_value", "", PH' * QINV)
    _cge_radd(keys, val, "macro", "foreign_savings", "", _cge_vn(M, x, "FSAV"))

    _cge_radd(keys, val, "government", "revenue", "", _cge_vn(M, x, "YG"))
    _cge_radd(keys, val, "government", "spending", "", _cge_vn(M, x, "EG"))
    _cge_radd(keys, val, "government", "savings", "", _cge_vn(M, x, "GSAV"))
    _cge_radd(keys, val, "government", "tax_direct", "", TINS' * YI)
    _cge_radd(keys, val, "government", "tax_sales", "", sum(p.tq :* _cge_vn(M, x, "TQADJ") :* PQ :* QQ))
    _cge_radd(keys, val, "government", "tax_import", "", EXR * sum(p.tm :* _cge_vn(M, x, "TMADJ") :* p.pwm :* QM))
    _cge_radd(keys, val, "government", "tax_export", "", EXR * sum(p.te :* pwe :* QE))
    _cge_radd(keys, val, "government", "tax_activity", "", sum(p.ta :* PA :* QA))
    _cge_radd(keys, val, "government", "tax_vat", "", _cge_vat(M, p, x))
    // taxes on factor use and on factor income (from version 0.5.0)
    _cge_radd(keys, val, "government", "tax_factor_use", "",
              sum(p.tf :* _cge_vn(M, x, "W") :* _cge_vn(M, x, "WFDIST") :* _cge_vn(M, x, "QF")))
    _cge_radd(keys, val, "government", "tax_factor_income", "", p.tfy' * _cge_vn(M, x, "YF"))

    // Public debt (model_spec.md, 12.3): stocks at the end of the period
    if (p0.debt == 1) {
        gsav = _cge_vn(M, x, "GSAV")
        intd = p.rd * p.ddebt
        intf = p.rf * p.fdebt * EXR
        endd = p.ddebt + (1 - p.phi) * (-gsav)
        endf = p.fdebt + p.phi * (-gsav) / EXR
        _cge_radd(keys, val, "debt", "interest_domestic", "", intd)
        _cge_radd(keys, val, "debt", "interest_foreign", "", intf)
        _cge_radd(keys, val, "debt", "primary_balance", "", gsav + intd + intf)
        _cge_radd(keys, val, "debt", "debt_domestic", "", endd)
        _cge_radd(keys, val, "debt", "debt_foreign", "", endf * EXR)
        _cge_radd(keys, val, "debt", "debt_foreign_fc", "", endf)
        _cge_radd(keys, val, "debt", "debt_total", "", endd + endf * EXR)
        _cge_radd(keys, val, "debt", "debt_gdp", "", 100 * (endd + endf * EXR) / gdpn)
    }

    for (k = 1; k <= M.nD; k++) _cge_radd(keys, val, "institutions", "income", M.D[k], YI[k])
    for (k = 1; k <= M.nH; k++) _cge_radd(keys, val, "institutions", "consumption", M.H[k], EH[k])
    for (k = 1; k <= M.nF; k++) {
        _cge_radd(keys, val, "factors", "wage", M.F[k], W[k])
        _cge_radd(keys, val, "factors", "real_wage", M.F[k], W[k] / CPI)
        _cge_radd(keys, val, "factors", "income", M.F[k], YF[k])
        _cge_radd(keys, val, "factors", "supply", M.F[k], QFS[k])
        if (M.p0.inlf[k]) {
            _cge_radd(keys, val, "factors", "labour_force", M.F[k], p.qlf[k])
            _cge_radd(keys, val, "factors", "unemployment_rate", M.F[k], 100 * (1 - QFS[k] / p.qlf[k]))
        }
    }
    for (k = 1; k <= M.n; k++) {
        _cge_radd(keys, val, "activities", "output", M.A[k], QA[k])
        _cge_radd(keys, val, "activities", "price", M.A[k], PA[k])
        _cge_radd(keys, val, "activities", "value_added", M.A[k], va[k])
    }
    for (k = 1; k <= M.nC; k++) {
        _cge_radd(keys, val, "commodities", "supply", M.C[k], QQ[k])
        _cge_radd(keys, val, "commodities", "price", M.C[k], PQ[k])
        _cge_radd(keys, val, "commodities", "output", M.C[k], QX[k])
        _cge_radd(keys, val, "commodities", "domestic_sales", M.C[k], QD[k])
        _cge_radd(keys, val, "commodities", "exports", M.C[k], QE[k] + QER[k])
        _cge_radd(keys, val, "commodities", "imports", M.C[k], QM[k])
        if (M.ced[k]) _cge_radd(keys, val, "commodities", "world_export_price", M.C[k], pwe[k])
    }
    ratio = _cge_vn(M, x, "HS") / p.hs0
    if (M.p0.hlink) {
        _cge_radd(keys, val, "health", "health_services", "", _cge_vn(M, x, "HS"))
        _cge_radd(keys, val, "health", "services_per_head", "", ratio)
        for (k = 1; k <= M.nF; k++) {
            if (M.p0.etah[k] != 0) _cge_radd(keys, val, "health", "efficiency", M.F[k], EFF[k])
        }
    }
    // Health outcomes (model_spec.md, 15.5)
    DW = _cge_vn(M, x, "DW")
    for (k = 1; k <= M.nF; k++) {
        if (M.p0.ins[k]) {
            _cge_radd(keys, val, "health", "sick_day_share", M.F[k], 100 * p.sick[k] * ratio ^ p.epss[k])
            _cge_radd(keys, val, "health", "days_worked", M.F[k], DW[k])
        }
    }
    if (M.p0.hasmort == 1) {
        _cge_radd(keys, val, "health", "mortality_rate", "", 1000 * p.mort * ratio ^ p.epsm)
        _cge_radd(keys, val, "health", "population", "", p.pop)
    }
    if (M.ishi) {
        _cge_radd(keys, val, "health", "fund_revenue", "", _cge_vn(M, x, "YSHI"))
        _cge_radd(keys, val, "health", "fund_volume", "", _cge_vn(M, x, "SHIADJ"))
    }
}

// Simulation indexes from a list of names: the most recent one when empty,
// every one for _all
real colvector _cge_sim_list(struct cge_model scalar M, string scalar sims)
{
    string rowvector tok
    real colvector s
    real scalar k
    if (sims == "") return(_cge_sim_index(M, ""))
    if (sims == "_all" | sims == "all") {
        if (rows(M.simname) == 0) _cge_fail("no simulation has been solved; use cge_solve", 459)
        return((1::rows(M.simname)))
    }
    tok = tokens(sims)
    s = J(cols(tok), 1, 0)
    for (k = 1; k <= cols(tok); k++) s[k] = _cge_sim_index(M, tok[k])
    return(s)
}

// Report rows for simulations s: keys (table, measure, element), base values,
// simulated values (one column per simulation) and percentage changes. For the
// equivalent and compensating variations, the base is zero and the percentage
// is of base household consumption; for rates (the debt ratio and unemployment
// rates, from version 0.3.3; shares of working time lost and the death rate,
// from 0.3.4) the change is in points.
void _cge_report_rows(struct cge_model scalar M, real colvector s, string matrix keys,
                      real colvector base, real matrix vals, real matrix pct)
{
    string matrix k1
    real colvector v, ev, cv, eh0, rate
    real scalar j, h, nr

    _cge_measures(M, M.p0, M.x0, keys, base)
    nr = rows(base)
    rate = (keys[., 2] :== "debt_gdp") :| (keys[., 2] :== "unemployment_rate") :|
           (keys[., 2] :== "sick_day_share") :| (keys[., 2] :== "mortality_rate")
    eh0 = _cge_vn(M, M.x0, "EH")
    for (h = 1; h <= M.nH; h++) {
        keys = keys \ ("welfare", "equivalent_variation", M.H[h]) \ ("welfare", "compensating_variation", M.H[h])
        base = base \ 0 \ 0
    }
    vals = J(rows(base), rows(s), .)
    pct = vals
    for (j = 1; j <= rows(s); j++) {
        _cge_measures(M, M.simp[s[j]], M.simx[., s[j]], k1, v)
        ev = _cge_ev(M, M.simp[s[j]], M.simx[., s[j]])
        cv = _cge_cv(M, M.simp[s[j]], M.simx[., s[j]])
        for (h = 1; h <= M.nH; h++) v = v \ ev[h] \ cv[h]
        vals[., j] = v
        pct[|1, j \ nr, j|] = 100 :* (v[|1 \ nr|] - base[|1 \ nr|]) :/ abs(base[|1 \ nr|])
        pct[|1, j \ nr, j|] = pct[|1, j \ nr, j|] :/ (base[|1 \ nr|] :!= 0)
        for (h = 1; h <= nr; h++) if (rate[h]) pct[h, j] = v[h] - base[h]
        for (h = 1; h <= M.nH; h++) {
            pct[nr + 2 * h - 1, j] = 100 * ev[h] / eh0[h]
            pct[nr + 2 * h, j] = 100 * cv[h] / eh0[h]
        }
    }
}

// Display the report, and optionally fill the dataset in memory (mode "long":
// one observation per simulation and measure; "wide": one per measure, with
// a value and a percentage change for each simulation)
void _cge_report_run(string scalar sims, string scalar tables, real scalar show, string scalar mode)
{
    struct cge_model scalar M
    string matrix keys
    string rowvector tab, alltab, title
    real colvector s, base, sel
    real matrix vals, pct
    real scalar t, i, j, n, ns, w1

    M = _cge_load()
    _cge_need(M, "sam")
    _cge_need(M, "calibrated")
    s = _cge_sim_list(M, sims)
    ns = rows(s)
    _cge_report_rows(M, s, keys, base, vals, pct)
    alltab = ("macro", "government", "debt", "institutions", "factors", "activities", "commodities", "health", "welfare")
    title = ("Macroeconomic aggregates", "Government", "Public debt", "Institutions", "Factors", "Activities",
             "Commodities", "Health", "Welfare (per cent of base consumption)")
    tab = (tables == "" ? ("macro", "government", "debt", "institutions", "factors", "health", "welfare") :
          (tables == "all" ? alltab : tokens(tables)))
    for (t = 1; t <= cols(tab); t++) {
        if (!anyof(alltab, tab[t])) _cge_fail("tables(): " + tab[t] + " is not a report table (" +
                                              invtokens(alltab) + ")", 198)
    }
    if (show) {
        for (t = 1; t <= cols(tab); t++) {
            sel = select((1::rows(keys)), keys[., 1] :== tab[t])
            if (rows(sel) == 0) continue
            w1 = max((24, max(strlen(keys[sel, 2] :+ " " :+ keys[sel, 3])))) + 1
            printf("\n{txt}%s\n", title[_cge_find(alltab', tab[t])])
            printf("{txt}%s\n", "{hline " + strofreal(w1 + 13 + 11 * min((ns, 6))) + "}")
            printf("{txt}%-" + strofreal(w1) + "s %12s", "", (tab[t] == "welfare" ? "" : "base"))
            for (j = 1; j <= min((ns, 6)); j++) printf(" %10s", abbrev(M.simname[s[j]], 10))
            printf("\n")
            for (i = 1; i <= rows(sel); i++) {
                n = sel[i]
                printf("{txt}%-" + strofreal(w1) + "s ", keys[n, 2] + (keys[n, 3] == "" ? "" : " " + keys[n, 3]))
                if (tab[t] == "welfare") printf("%12s", "")
                else printf("{res}%12.4g", base[n])
                for (j = 1; j <= min((ns, 6)); j++) printf("{res} %10.3f", pct[n, j])
                printf("\n")
            }
            printf("{txt}%s\n", "{hline " + strofreal(w1 + 13 + 11 * min((ns, 6))) + "}")
        }
        printf("{txt}Percentage changes from the base (rates: changes in points)")
        if (ns > 6) printf("; the first 6 of %f simulations are shown", ns)
        printf("\n")
    }
    if (mode == "long") _cge_report_long(M, s, keys, base, vals, pct)
    if (mode == "wide") _cge_report_wide(M, s, keys, base, vals, pct)
    st_numscalar("r(N_measures)", rows(keys))
    st_numscalar("r(N_sims)", ns)
}

void _cge_report_long(struct cge_model scalar M, real colvector s, string matrix keys, real colvector base,
                      real matrix vals, real matrix pct)
{
    real scalar n, ns, j
    string colvector sim
    n = rows(keys)
    ns = rows(s)
    sim = J(0, 1, "")
    for (j = 1; j <= ns; j++) sim = sim \ J(n, 1, M.simname[s[j]])
    st_addobs(n * ns)
    (void) st_addvar("str32", "sim")
    (void) st_addvar("str16", "table")
    (void) st_addvar("str32", "measure")
    (void) st_addvar("str32", "element")
    (void) st_addvar("double", ("base", "value", "pct"))
    st_sstore(., "sim", sim)
    st_sstore(., "table", J(ns, 1, keys[., 1]))
    st_sstore(., "measure", J(ns, 1, keys[., 2]))
    st_sstore(., "element", J(ns, 1, keys[., 3]))
    st_store(., "base", J(ns, 1, base))
    st_store(., "value", colshape(vals', 1))
    st_store(., "pct", colshape(pct', 1))
    st_varlabel("sim", "Simulation")
    st_varlabel("table", "Report table")
    st_varlabel("measure", "Measure")
    st_varlabel("element", "Set element")
    st_varlabel("base", "Base value")
    st_varlabel("value", "Simulated value")
    st_varlabel("pct", "Per cent change (rates: points; welfare: per cent of base consumption)")
}

void _cge_report_wide(struct cge_model scalar M, real colvector s, string matrix keys, real colvector base,
                      real matrix vals, real matrix pct)
{
    real scalar n, j
    n = rows(keys)
    st_addobs(n)
    (void) st_addvar("str16", "table")
    (void) st_addvar("str32", "measure")
    (void) st_addvar("str32", "element")
    (void) st_addvar("double", "base")
    st_sstore(., "table", keys[., 1])
    st_sstore(., "measure", keys[., 2])
    st_sstore(., "element", keys[., 3])
    st_store(., "base", base)
    st_varlabel("table", "Table")
    st_varlabel("measure", "Measure")
    st_varlabel("element", "Element")
    st_varlabel("base", "Base")
    for (j = 1; j <= rows(s); j++) {
        (void) st_addvar("double", ("v" + strofreal(j), "p" + strofreal(j)))
        st_store(., "v" + strofreal(j), vals[., j])
        st_store(., "p" + strofreal(j), pct[., j])
        st_varlabel("v" + strofreal(j), M.simname[s[j]] + ": value")
        st_varlabel("p" + strofreal(j), M.simname[s[j]] + ": % change (rates: points)")
    }
}

// =====================================================================
// Calibrated parameters as a dataset (from version 0.1.15)
// =====================================================================

void _cge_padd(string matrix keys, real colvector val, string scalar name, real matrix X,
               string colvector r, string colvector c)
{
    real colvector i
    real scalar n
    n = rows(X) * cols(X)
    if (n == 0) return
    i = (1::n)
    // colshape(): subscripting a 1 x 1 vector returns a row
    keys = keys \ (J(n, 1, name), colshape(r[floor((i :- 1) :/ cols(X)) :+ 1], 1),
                   (rows(c) ? colshape(c[mod(i :- 1, cols(X)) :+ 1], 1) : J(n, 1, "")))
    val = val \ colshape(X, 1)
}

void _cge_param_data(string scalar sim, real scalar current)
{
    struct cge_model scalar M
    struct cge_par scalar p
    string matrix keys
    real colvector val
    M = _cge_load()
    _cge_need(M, "calibrated")
    if (sim != "") p = M.simp[_cge_sim_index(M, sim)]
    else p = (current ? M.p : M.p0)
    _cge_param_list(M, p, keys, val)
    st_addobs(rows(val))
    (void) st_addvar("str8", "parameter")
    (void) st_addvar("str32", "element1")
    (void) st_addvar("str32", "element2")
    (void) st_addvar("double", "value")
    st_sstore(., "parameter", keys[., 1])
    st_sstore(., "element1", keys[., 2])
    st_sstore(., "element2", keys[., 3])
    st_store(., "value", val)
    st_varlabel("parameter", "Parameter")
    st_varlabel("element1", "First set element")
    st_varlabel("element2", "Second set element")
    st_varlabel("value", "Value")
    st_numscalar("r(N)", rows(val))
}

// The calibrated parameters p, element by element: name, elements, value
// (from version 0.10.0, for cge_parameters and cge_gdx)
void _cge_param_list(struct cge_model scalar M, struct cge_par scalar p, string matrix keys, real colvector val)
{
    string colvector none
    keys = J(0, 3, "")
    val = J(0, 1, .)
    none = J(0, 1, "")
    // a standalone model (from version 0.13.0): its user parameters
    if (_cge_sa(M)) {
        _cge_up_data(M, p, keys, val)
        return
    }
    // commodities
    _cge_padd(keys, val, "pwm", p.pwm, M.C, none);   _cge_padd(keys, val, "pwe", p.pwe, M.C, none)
    _cge_padd(keys, val, "tm", p.tm, M.C, none);     _cge_padd(keys, val, "te", p.te, M.C, none)
    _cge_padd(keys, val, "tq", p.tq, M.C, none);     _cge_padd(keys, val, "at", p.at, M.C, none)
    _cge_padd(keys, val, "dt", p.dt, M.C, none);     _cge_padd(keys, val, "dtc", p.dtc, M.C, none)
    _cge_padd(keys, val, "rt", p.rt, M.C, none);     _cge_padd(keys, val, "st", p.st, M.C, none)
    _cge_padd(keys, val, "aq", p.aq, M.C, none);     _cge_padd(keys, val, "dq", p.dq, M.C, none)
    _cge_padd(keys, val, "dqc", p.dqc, M.C, none);   _cge_padd(keys, val, "rq", p.rq, M.C, none)
    _cge_padd(keys, val, "sq", p.sq, M.C, none);     _cge_padd(keys, val, "qg", p.qg, M.C, none)
    _cge_padd(keys, val, "qinv", p.qinv, M.C, none); _cge_padd(keys, val, "qer", p.qer, M.C, none)
    _cge_padd(keys, val, "cwts", p.cwts, M.C, none); _cge_padd(keys, val, "dwts", p.dwts, M.C, none)
    _cge_padd(keys, val, "qshi", p.qshi, M.C, none); _cge_padd(keys, val, "tv", p.tv, M.C, none)
    _cge_padd(keys, val, "etae", p.etae, M.C, none); _cge_padd(keys, val, "qe0", p.qe0, M.C, none)
    // activities
    _cge_padd(keys, val, "ta", p.ta, M.A, none);     _cge_padd(keys, val, "ad", p.ad, M.A, none)
    _cge_padd(keys, val, "iva", p.iva, M.A, none);   _cge_padd(keys, val, "inta", p.inta, M.A, none)
    _cge_padd(keys, val, "rva", p.rva, M.A, none);   _cge_padd(keys, val, "sva", p.sva, M.A, none)
    _cge_padd(keys, val, "aa", p.aa, M.A, none);     _cge_padd(keys, val, "dla", p.dla, M.A, none)
    _cge_padd(keys, val, "dlac", p.dlac, M.A, none); _cge_padd(keys, val, "rha", p.rha, M.A, none)
    _cge_padd(keys, val, "sa", p.sa, M.A, none);     _cge_padd(keys, val, "kappa", p.kappa, M.A, none)
    // matrices
    _cge_padd(keys, val, "ica", p.ica, M.C, M.A);     _cge_padd(keys, val, "dva", p.dva, M.F, M.A)
    _cge_padd(keys, val, "theta", p.theta, M.A, M.C); _cge_padd(keys, val, "icm", p.icm, M.C, M.C)
    _cge_padd(keys, val, "shif", p.shif, M.I, M.F);   _cge_padd(keys, val, "beta", p.beta, M.C, M.H)
    _cge_padd(keys, val, "gamma", p.gamma, M.C, M.H); _cge_padd(keys, val, "shii", p.shii, M.D, M.D)
    _cge_padd(keys, val, "betah", p.betah, M.A, M.H); _cge_padd(keys, val, "gammah", p.gammah, M.A, M.H)
    _cge_padd(keys, val, "icd", p.icd, M.C, M.C);     _cge_padd(keys, val, "ici", p.ici, M.C, M.C)
    _cge_padd(keys, val, "ice", p.ice, M.C, M.C)
    // taxes on factor use, by factor and activity, and on factor income (from version 0.5.0)
    _cge_padd(keys, val, "tf", p.tf, M.F, M.A);       _cge_padd(keys, val, "tfy", p.tfy, M.F, none)
    // nests of value added (from version 0.5.1)
    if (M.nN) {
        _cge_padd(keys, val, "dvn", p.dvn, M.N, M.A); _cge_padd(keys, val, "an", p.an, M.N, M.A)
        _cge_padd(keys, val, "dce", p.dce, M.C, M.A); _cge_padd(keys, val, "sgn", p.sgn, M.N, none)
        _cge_padd(keys, val, "rhn", p.rhn, M.N, none)
    }
    // output from several activities (from version 0.5.2)
    if (any(M.cac)) {
        _cge_padd(keys, val, "sac", p.sac, M.C, none); _cge_padd(keys, val, "rac", p.rac, M.C, none)
        _cge_padd(keys, val, "aac", p.aac, M.C, none); _cge_padd(keys, val, "dac", p.dac, M.A, M.C)
    }
    // institutions and factors
    _cge_padd(keys, val, "tins0", p.tins0, M.D, none); _cge_padd(keys, val, "mps0", p.mps0, M.D, none)
    _cge_padd(keys, val, "shir", p.shir, M.D, none);   _cge_padd(keys, val, "trdg", p.trdg, M.D, none)
    _cge_padd(keys, val, "trdr", p.trdr, M.D, none);   _cge_padd(keys, val, "hc", p.hc, M.H, none)
    _cge_padd(keys, val, "trfr", p.trfr, M.F, none);   _cge_padd(keys, val, "tshi", p.tshi, M.F, none)
    _cge_padd(keys, val, "af", p.af, M.F, none);       _cge_padd(keys, val, "etah", p.etah, M.F, none)
    _cge_padd(keys, val, "hold", p.hold, M.D, none)
    _cge_padd(keys, val, "inlf", p.inlf, M.F, none);   _cge_padd(keys, val, "qlf", p.qlf, M.F, none)
    _cge_padd(keys, val, "u0", p.u0, M.F, none);       _cge_padd(keys, val, "epsw", p.epsw, M.F, none)
    _cge_padd(keys, val, "wref", p.wref, M.F, none);   _cge_padd(keys, val, "wmin", p.wmin, M.F, none)
    _cge_padd(keys, val, "hasmin", p.hasmin, M.F, none)
    _cge_padd(keys, val, "ins", p.ins, M.F, none);     _cge_padd(keys, val, "sick0", p.sick0, M.F, none)
    _cge_padd(keys, val, "sick", p.sick, M.F, none);   _cge_padd(keys, val, "epss", p.epss, M.F, none)
    // scalars
    _cge_padd(keys, val, "trgr", p.trgr, "", none);    _cge_padd(keys, val, "trrg", p.trrg, "", none)
    _cge_padd(keys, val, "trgg", p.trgg, "", none);    _cge_padd(keys, val, "sshi", p.sshi, "", none)
    _cge_padd(keys, val, "trshi", p.trshi, "", none);  _cge_padd(keys, val, "trshir", p.trshir, "", none)
    _cge_padd(keys, val, "hs0", p.hs0, "", none)
    _cge_padd(keys, val, "debt", p.debt, "", none);    _cge_padd(keys, val, "ddebt", p.ddebt, "", none)
    _cge_padd(keys, val, "fdebt", p.fdebt, "", none);  _cge_padd(keys, val, "rd", p.rd, "", none)
    _cge_padd(keys, val, "rf", p.rf, "", none);        _cge_padd(keys, val, "phi", p.phi, "", none)
    _cge_padd(keys, val, "mu", p.mu, "", none)
    _cge_padd(keys, val, "hlink", p.hlink, "", none);  _cge_padd(keys, val, "hasmort", p.hasmort, "", none)
    _cge_padd(keys, val, "mort0", p.mort0, "", none);  _cge_padd(keys, val, "mort", p.mort, "", none)
    // user parameters (from version 0.7.1)
    _cge_up_data(M, p, keys, val)
    _cge_padd(keys, val, "epsm", p.epsm, "", none);    _cge_padd(keys, val, "pop", p.pop, "", none)
}

// =====================================================================
// Saving and loading a model (from version 0.1.15)
// =====================================================================

void _cge_io_put(real scalar fh, string scalar name, transmorphic matrix v)
{
    fputmatrix(fh, name)
    fputmatrix(fh, v)
}

void _cge_save(string scalar fn, real scalar replace)
{
    struct cge_model scalar M
    real scalar fh
    M = _cge_load()
    if (fileexists(fn)) {
        if (!replace) _cge_fail("file " + fn + " already exists; use replace", 602)
        unlink(fn)
    }
    fh = fopen(fn, "w")
    fputmatrix(fh, "cge-stata model")
    fputmatrix(fh, _cge_version())
    _cge_model_write(fh, M)
    fputmatrix(fh, "__end__")
    fclose(fh)
    printf("{txt}Model saved to {res}%s{txt} (%s, %f simulation(s))\n", fn,
           (M.calibrated == 1 ? "calibrated" : (M.mapped == 1 ? "mapped" : "SAM only")), rows(M.simname))
}

// The bytes that fputmatrix() writes for the identifier of a model file
string scalar _cge_signature()
{
    string scalar tmp, sig
    real scalar fh
    tmp = st_tempfilename()
    fh = fopen(tmp, "w")
    fputmatrix(fh, "cge-stata model")
    fclose(fh)
    fh = fopen(tmp, "r")
    sig = fread(fh, 4096)
    fclose(fh)
    unlink(tmp)
    return(sig)
}

// Defaults of the parameters added in version 0.3.1, for models saved before it
void _cge_par_fill(struct cge_par scalar p, struct cge_model scalar M)
{
    if (M.calibrated != 1 | _cge_sa(M)) return
    if (rows(p.tv) == 0) p.tv = J(M.nC, 1, 0)
    if (rows(p.kappa) == 0) p.kappa = J(M.n, 1, 1)
    if (rows(p.hold) == 0) p.hold = J(M.nD, 1, 0)
    if (p.debt >= .) p.debt = 0
    if (p.ddebt >= .) p.ddebt = 0
    if (p.fdebt >= .) p.fdebt = 0
    if (p.rd >= .) p.rd = 0
    if (p.rf >= .) p.rf = 0
    if (p.phi >= .) p.phi = 0
    if (rows(p.icd) == 0) p.icd = J(M.nC, M.nC, 0)
    if (rows(p.ici) == 0) p.ici = J(M.nC, M.nC, 0)
    if (rows(p.ice) == 0) p.ice = J(M.nC, M.nC, 0)
    if (rows(p.etae) == 0) p.etae = J(M.nC, 1, 0)
    if (rows(p.qe0) == 0) p.qe0 = J(M.nC, 1, 0)
    if (rows(p.betah) == 0) p.betah = J(M.n, M.nH, 0)
    if (rows(p.gammah) == 0) p.gammah = J(M.n, M.nH, 0)
    // 0.3.3: no labour force (the values only fill the masked equations)
    if (rows(p.inlf) == 0) {
        p.inlf = J(M.nF, 1, 0)
        p.qlf = J(M.nF, 1, 1)
        p.u0 = J(M.nF, 1, 1)
        p.epsw = J(M.nF, 1, 0)
        p.wref = J(M.nF, 1, 1)
        p.wmin = J(M.nF, 1, 1)
        p.hasmin = J(M.nF, 1, 0)
    }
    if (p.mu >= .) p.mu = 1e-10
    // 0.3.4: no health outcomes
    if (rows(p.ins) == 0) {
        p.ins = J(M.nF, 1, 0)
        p.sick0 = J(M.nF, 1, 0)
        p.sick = J(M.nF, 1, 0)
        p.epss = J(M.nF, 1, 0)
    }
    if (p.hasmort >= .) p.hasmort = 0
    if (p.mort0 >= .) p.mort0 = 0
    if (p.mort >= .) p.mort = 0
    if (p.epsm >= .) p.epsm = 0
    if (p.pop >= .) p.pop = 1
    if (p.hlink >= .) p.hlink = any(p.etah)
    // 0.5.0: no factor taxes
    if (rows(p.tf) == 0) {
        p.tf = J(M.nF, M.n, 0)
        p.tfy = J(M.nF, 1, 0)
    }
    // 0.5.1: no nests of value added
    if (rows(p.dce) == 0) p.dce = J(M.nC, M.n, 0)
    if (rows(p.dvn) == 0) p.dvn = J(0, M.n, 0)
    if (rows(p.an) == 0) p.an = J(0, M.n, 1)
    if (rows(p.sgn) == 0) p.sgn = J(0, 1, .)
    if (rows(p.rhn) == 0) p.rhn = J(0, 1, .)
    // 0.5.2: output of each commodity from its activities as perfect substitutes
    if (rows(p.sac) == 0) {
        p.sac = J(M.nC, 1, 0)
        p.rac = J(M.nC, 1, 0)
        p.aac = J(M.nC, 1, 1)
        p.dac = J(M.n, M.nC, 0)
    }
    // 0.4.4: rents to the government, no constraints
    if (rows(p.rrm) == 0) {
        p.rrm = J(M.nC, 1, M.nF + M.nD + 1)
        p.rre = J(M.nC, 1, M.nF + M.nD + 1)
        p.rra = J(M.n, 1, M.nF + M.nD + 1)
    }
    if (p.bmu >= .) p.bmu = 1e-8
}

// Variables added after the saved model's version are appended to the layout:
// TQADJ, TMADJ and TVADJ (0.3.1), fixed at one; PWE and QHA (0.3.2), and LSW
// and LSM (0.3.3), which do not exist in older models; DW (0.3.4), one where it
// does not exist; the rents RM, RE and RA (0.4.4), zero; QNA and PNA (0.5.1),
// with no elements without nests; PXAC and QXAC (0.5.2), which do not exist
// in older models. The Jacobian pattern is rebuilt.
void _cge_use_upgrade(struct cge_model scalar M)
{
    real scalar nold, k, v, len
    real colvector val, ex, L, R, K, mag
    string colvector oldnames
    oldnames = M.vname
    nold = rows(M.x0)
    _cge_layout(M)
    for (k = rows(oldnames) + 1; k <= rows(M.vname); k++) {
        len = M.vrows[k] * M.vcols[k]
        if (M.vname[k] == "PWE") {
            val = M.p0.pwe
            ex = J(len, 1, 0)
        }
        else if (anyof(("QHA", "LSW", "LSM", "PXAC", "QXAC"), M.vname[k])) {
            val = J(len, 1, 0)
            ex = J(len, 1, 0)
        }
        else if (M.vname[k] == "DW") {
            val = J(len, 1, 1)
            ex = J(len, 1, 0)
        }
        else if (anyof(("RM", "RE", "RA"), M.vname[k])) {
            val = J(len, 1, 0)
            ex = (M.vname[k] == "RM" ? M.cm : (M.vname[k] == "RE" ? M.ce : J(len, 1, 1)))
        }
        else {
            val = J(len, 1, 1)
            ex = J(len, 1, 1)
        }
        M.x0 = M.x0 \ val
        M.xcur = M.xcur \ val
        M.xscale = M.xscale \ (abs(val) :* (abs(val) :> 1e-12) + (abs(val) :<= 1e-12))
        M.exists = M.exists \ ex
        M.fixed = M.fixed \ J(len, 1, 1)
        M.nominal = M.nominal \ J(len, 1, 0)
        M.simx = M.simx \ J(1, cols(M.simx), val)
    }
    v = M.voff[rows(M.voff)] + M.vrows[rows(M.vrows)] * M.vcols[rows(M.vcols)]
    if (rows(M.x0) != v) _cge_fail("cge internal error: the saved model's variables do not match", 3498)
    // Equation blocks added since are recorded (masked for the old model), with
    // masks and scales from the base point, as at calibration
    _cge_eq(M, M.p0, M.x0, L, R, K, 1)
    M.emask = K
    mag = rowmax((abs(L), abs(R)))
    M.escale = mag :* (mag :> 1e-9) + (mag :<= 1e-9)
    if (sum(K) != M.neq) _cge_fail("cge internal error: the saved model's equations do not match", 3498)
    _cge_pattern(M, M.p0)
}

void _cge_use(string scalar fn)
{
    struct cge_model scalar M
    struct cge_par scalar q0, q1, qs
    struct cge_par rowvector sp
    transmorphic matrix v, hd
    string scalar name, ver, rest, sig, head
    real scalar fh, unknown, ok, cur, d, k
    if (!fileexists(fn)) _cge_fail("file " + fn + " not found", 601)
    // Check the file's identifier before fgetmatrix(), which stops with an
    // error on another kind of file and would leave it open. The header bytes
    // that fputmatrix() writes before the identifier differ between Stata
    // sessions and versions, so the format's opening bytes are compared and
    // the identifier is looked for in the first 512 bytes. The seventh byte
    // gives the format: 0 in files written by Stata 13 and 1 in those written
    // by StataNow 19.5, which Stata 13 cannot read.
    sig = _cge_signature()
    fh = fopen(fn, "r")
    hd = fread(fh, 512)
    head = (rows(hd) * cols(hd) ? hd : "")
    if (substr(head, 1, 5) != substr(sig, 1, 5) | !strpos(head, "cge-stata model")) {
        fclose(fh)
        _cge_fail(fn + " is not a cge-stata model file", 610)
    }
    if (ascii(substr(head, 7, 1)) > ascii(substr(sig, 7, 1))) {
        fclose(fh)
        _cge_fail(fn + " was saved by a later version of Stata, whose model files Stata " +
                  strofreal(floor(c("stata_version"))) + " cannot read; load it in the " +
                  "version of Stata that saved it or a later one", 610)
    }
    fseek(fh, 0, -1)
    v = fgetmatrix(fh)
    ver = fgetmatrix(fh)
    unknown = 0
    // Parameter structures are built in fresh structures and assigned once:
    // in Stata 13, reading an element of a structure vector back, changing it
    // and storing it again can hang Mata. A simulation's parameters are
    // contiguous in the file.
    q0 = cge_par()
    q1 = cge_par()
    qs = cge_par()
    sp = cge_par(1, 0)
    cur = 0
    while (1) {
        name = fgetmatrix(fh)
        if (name == "__end__") break
        v = fgetmatrix(fh)
        if (substr(name, 1, 3) == "p0.") ok = _cge_par_member(q0, substr(name, 4, .), v)
        else if (substr(name, 1, 2) == "p.") ok = _cge_par_member(q1, substr(name, 3, .), v)
        else if (name == "simp.count") {
            sp = cge_par(1, v)
            ok = 1
        }
        else if (substr(name, 1, 5) == "simp.") {
            rest = substr(name, 6, .)
            d = strpos(rest, ".")
            k = strtoreal(substr(rest, 1, d - 1))
            if (k != cur) {
                if (cur) {
                    _cge_par_fill(qs, M)
                    sp[cur] = qs
                }
                qs = cge_par()
                cur = k
            }
            ok = _cge_par_member(qs, substr(rest, d + 1, .), v)
        }
        else ok = _cge_model_member(M, name, v)
        if (!ok) unknown++
    }
    fclose(fh)
    if (cur) {
        _cge_par_fill(qs, M)
        sp[cur] = qs
    }
    _cge_par_fill(q0, M)
    _cge_par_fill(q1, M)
    M.p0 = q0
    M.p = q1
    M.simp = sp
    // Files saved before version 0.3.1 have no VAT account and no tax scaling
    // factors TQADJ, TMADJ and TVADJ: these are added, fixed at one, and the
    // Jacobian pattern is rebuilt
    if (M.ivattax >= .) M.ivattax = 0
    // Files saved before version 0.3.2: no margins by market, export demand,
    // export-only commodities or home consumption; a standalone model (from
    // version 0.13.0) has none of these
    if (M.calibrated == 1 & !_cge_sa(M)) {
        if (rows(M.tmkt) != rows(M.iT)) M.tmkt = J(rows(M.iT), 1, 0)
        if (rows(M.cxe) == 0) M.cxe = J(M.nC, 1, 0)
        if (rows(M.ced) == 0) M.ced = J(M.nC, 1, 0)
        if (rows(M.cdo) == 0) M.cdo = M.cx
        if (rows(M.cq) == 0) M.cq = (M.cx :| M.cm)
        // Files saved before version 0.5.1: no nests of value added
        if (M.nN >= .) {
            M.N = J(0, 1, "")
            M.nN = 0
            M.nestf = J(M.nF, 1, 0)
            M.nestc = J(M.nC, 1, 0)
            M.cdn = J(0, 1, .)
            M.ecell = J(M.nC, M.n, 0)
        }
        if (rows(M.nn) == 0) M.nn = J(0, M.n, 0)
        // Files saved before version 0.5.2: no aggregation of output
        if (rows(M.cac) == 0) {
            M.cac = J(M.nC, 1, 0)
            M.cdac = J(M.nC, 1, 0)
            M.xac = J(M.n, M.nC, 0)
        }
        if (!_cge_vidx(M, "QXAC")) _cge_use_upgrade(M)
        // Files saved before version 0.6.1: no user variables or equations
        if (M.nuv >= .) M.nuv = 0
    }
    // Files saved before version 0.2.0 have no dynamic-run items
    if (rows(M.simrun) != rows(M.simname)) {
        M.simrun = J(rows(M.simname), 1, "")
        M.simper = J(rows(M.simname), 1, .)
        M.simlam = J(rows(M.simname), 1, .)
    }
    // Files saved before version 0.4.4 record no constraints
    if (rows(M.simcons) != rows(M.simname)) M.simcons = J(rows(M.simname), 1, "")
    // the attributes of cge_bound (from version 0.9.8)
    if (M.calibrated == 1) _cge_bd_sync(M)
    _cge_store(M)
    printf("{txt}Model loaded from {res}%s{txt} (saved by cge-stata %s; %s, %f simulation(s))\n", fn, ver,
           (M.calibrated == 1 ? "calibrated" : (M.mapped == 1 ? "mapped" : "SAM only")), rows(M.simname))
    if (unknown) printf("{txt}Note: %f saved item(s) are not used by this version and were ignored\n", unknown)
    st_global("r(saved_by)", ver)
}


// =====================================================================
// Recursive dynamics (model_spec.md, Section 10; from version 0.2.0)
// =====================================================================

// State of a dynamic run while cge_dynamic runs; kept outside the model
struct cge_dyn {
    string scalar         name
    real colvector        periods, prev, capital, delta, rental, fgrowth, tfp, target, lampath
    real scalar           k, sens, gpop, ggov, gfor, mode, tol, maxit
    // deaths at working ages (from version 0.3.4): factors that lose workers,
    // the share of deaths at working ages and the working-age share
    real colvector        dfac
    real scalar           dshare, wage
    struct cge_par scalar psave
    real colvector        xsave
    // the solutions of the last four periods, the latest first, for lags
    // (from version 0.9.2)
    real matrix           prevs
}

struct cge_dyn scalar _cge_dyn_load()
{
    pointer() scalar q
    q = findexternal("cge__dyn")
    if (q == NULL) _cge_fail("cge internal error: no dynamic run in progress", 3498)
    return(*q)
}

void _cge_dyn_store(struct cge_dyn scalar D)
{
    pointer() scalar q
    if ((q = findexternal("cge__dyn")) == NULL) q = crexternal("cge__dyn")
    *q = D
}

// One value, or one per element of a set
real colvector _cge_dyn_values(string scalar s, real scalar n, string scalar what)
{
    real colvector v
    v = strtoreal(tokens(s))'
    if (rows(v) == 1) v = J(n, 1, v)
    if (rows(v) != n | hasmissing(v)) _cge_fail(what + " needs 1 or " + strofreal(n) + " values", 198)
    return(v)
}

void _cge_dyn_start(string scalar name, string scalar periods, string scalar capital,
                    string scalar depreciation, string scalar rental, real scalar sens,
                    string scalar growth, string scalar tfp, string scalar gdpgrowth,
                    string scalar baseline, real scalar gpop, real scalar ggov, real scalar gfor,
                    real scalar tol, real scalar maxit, | string scalar deathfac, real scalar dshare,
                    real scalar wage, real scalar fs)
{
    struct cge_model scalar M
    struct cge_dyn scalar D
    string rowvector tok, pair
    real colvector idx, s
    real scalar j, f, T
    pointer() scalar q

    M = _cge_load()
    _cge_need(M, "sam")
    _cge_need(M, "calibrated")
    // lead() refers to later periods, which only a run with foresight solves
    // (from version 0.10.2)
    if (args() < 19) fs = 0
    if (!fs & _cge_u_haslead(M)) {
        _cge_fail("lead(): user equations refer to later periods; solve the run with perfect foresight, cge_dynamic, foresight", 198)
    }
    D.name = name
    D.periods = strtoreal(tokens(periods))'
    T = rows(D.periods) - 1
    D.k = 1
    D.sens = sens
    D.gpop = gpop
    D.ggov = ggov
    D.gfor = gfor
    D.tol = tol
    D.maxit = maxit
    if (sens < 0) _cge_fail("sensitivity() must be zero or positive", 198)

    // Capital factors, with depreciation and base gross rental rates
    D.capital = J(M.nF, 1, 0)
    D.delta = J(M.nF, 1, 0)
    D.rental = J(M.nF, 1, 0)
    if (capital != "") {
        idx = _cge_elements(M.F, capital, "factors")
        if (depreciation == "" | rental == "") {
            _cge_fail("capital() needs depreciation() and rental(): they set how investment adds to capital", 198)
        }
        D.capital[idx] = J(rows(idx), 1, 1)
        D.delta[idx] = _cge_dyn_values(depreciation, rows(idx), "depreciation()")
        D.rental[idx] = _cge_dyn_values(rental, rows(idx), "rental()")
        for (j = 1; j <= rows(idx); j++) {
            if (anyof(("unemployed", "wagecurve", "minwage"), M.c_fac[idx[j]])) {
                _cge_fail("capital(): " + M.F[idx[j]] + " is " + M.c_fac[idx[j]] + " in the closure; capital must be mobile or specific", 198)
            }
        }
    }
    else if (depreciation != "" | rental != "") _cge_fail("depreciation() and rental() need capital()", 198)

    // Growth of other factors: factor:rate pairs
    D.fgrowth = J(M.nF, 1, 0)
    tok = tokens(growth)
    for (j = 1; j <= cols(tok); j++) {
        pair = tokens(tok[j], ":")
        if (cols(pair) != 3) _cge_fail("growth(): write factor:rate, for example lab:0.02", 198)
        f = _cge_find(M.F, pair[1])
        if (f == 0) _cge_fail("growth(): " + pair[1] + " is not a factor of the model", 111)
        if (D.capital[f]) _cge_fail("growth(): " + pair[1] + " is a capital factor", 198)
        D.fgrowth[f] = strtoreal(pair[3])
        if (missing(D.fgrowth[f])) _cge_fail("growth(): rate for " + pair[1] + " is not a number", 198)
        if (D.fgrowth[f] != 0 & M.c_fac[f] == "unemployed" & !M.p0.inlf[f]) {
            _cge_fail("growth(): " + pair[1] + " is unemployed, so its supply is not fixed", 198)
        }
    }

    // Deaths at working ages (model_spec.md, 15.4)
    if (args() < 16) deathfac = ""
    if (args() < 17) dshare = 0
    if (args() < 18) wage = 1
    D.dfac = J(M.nF, 1, 0)
    D.dshare = dshare
    D.wage = wage
    if (deathfac != "") {
        if (M.p0.hasmort != 1) _cge_fail("deathfactors(): the model has no death rate; calibrate with mortality()", 198)
        if (!(dshare >= 0 & dshare <= 1) | !(wage > 0 & wage <= 1)) {
            _cge_fail("deathshare() must lie between 0 and 1, and workingage() above 0 and at most 1", 198)
        }
        idx = _cge_elements(M.F, deathfac, "factors")
        for (j = 1; j <= rows(idx); j++) {
            f = idx[j]
            if (D.capital[f]) _cge_fail("deathfactors(): " + M.F[f] + " is a capital factor", 198)
            if (M.c_fac[f] == "unemployed" & !M.p0.inlf[f]) {
                _cge_fail("deathfactors(): " + M.F[f] + " is unemployed, so its supply is not fixed", 198)
            }
        }
        D.dfac[idx] = J(rows(idx), 1, 1)
    }
    else if (dshare != 0 | wage != 1) _cge_fail("deathshare() and workingage() need deathfactors()", 198)

    // Efficiency: rates (mode 0), growth targets (1) or a baseline's path (2)
    if ((tfp != "") + (gdpgrowth != "") + (baseline != "") > 1) {
        _cge_fail("choose one of tfp(), gdpgrowth() and baseline()", 198)
    }
    D.mode = 0
    D.tfp = (tfp == "" ? J(M.n, 1, 0) : _cge_dyn_values(tfp, M.n, "tfp()"))
    D.target = J(0, 1, .)
    D.lampath = J(0, 1, .)
    if (gdpgrowth != "") {
        D.mode = 1
        D.target = _cge_dyn_values(gdpgrowth, T, "gdpgrowth()")
    }
    if (baseline != "") {
        D.mode = 2
        D.lampath = J(T, 1, .)
        for (j = 1; j <= T; j++) {
            s = select((1::rows(M.simname)), (M.simrun :== baseline) :* (M.simper :== D.periods[j + 1]))
            if (rows(s) != 1) {
                _cge_fail("baseline(): run " + baseline + " has no period " + strofreal(D.periods[j + 1]), 111)
            }
            D.lampath[j] = M.simlam[s[1]]
            if (missing(D.lampath[j])) {
                _cge_fail("baseline(): run " + baseline + " did not solve for efficiency (use gdpgrowth() there)", 198)
            }
        }
    }

    // The model as it was, restored if the run fails (from version 0.6.4)
    if ((q = findexternal("cge__dyn_model")) == NULL) q = crexternal("cge__dyn_model")
    *q = _cge_load()

    // The run starts from the base; shocks set before it are kept aside, but
    // constraints are kept (from version 0.4.4)
    D.psave = M.p
    D.xsave = M.xcur
    if (M.xcur != M.x0) printf("{txt}Note: the run starts from the base; fixed values set with cge_shock are not used\n")
    M.p = M.p0
    _cge_cons_carry(M.p, D.psave)
    M.xcur = M.x0
    D.prev = M.x0
    D.prevs = J(1, _cge_maxlag(), M.x0)
    _cge_store(M)
    _cge_dyn_store(D)
}

// Population grows at rate gp, government and foreign flows at theirs
// (Section 10, steps 3 and 4)
void _cge_dyn_grow(struct cge_model scalar M, struct cge_dyn scalar D, real scalar gp)
{
    M.p.gamma = M.p.gamma :* (1 + gp)
    M.p.gammah = M.p.gammah :* (1 + gp)
    M.p.hs0 = M.p.hs0 * (1 + gp)
    M.p.pop = M.p.pop * (1 + gp)
    M.p.qg = M.p.qg :* (1 + D.ggov)
    M.p.trdg = M.p.trdg :* (1 + D.ggov)
    M.p.trgg = M.p.trgg * (1 + D.ggov)
    M.p.trshi = M.p.trshi * (1 + D.ggov)
    M.p.trdr = M.p.trdr :* (1 + D.gfor)
    M.p.trfr = M.p.trfr :* (1 + D.gfor)
    M.p.trgr = M.p.trgr * (1 + D.gfor)
    M.p.trrg = M.p.trrg * (1 + D.gfor)
    M.p.trshir = M.p.trshir * (1 + D.gfor)
    if (M.c_ext == "flexexr") _cge_setv(M, M.xcur, "FSAV", _cge_vn(M, M.xcur, "FSAV") * (1 + D.gfor))
}

// Updates before the next period (Section 10, steps 1 to 5), from the solution
// of the previous period
void _cge_dyn_advance()
{
    struct cge_model scalar M
    struct cge_dyn scalar D
    real matrix QF, WFD
    real colvector QFS, W, inv0, YF0, q, s, rent, eta, qlf
    real scalar f, inv, newk, avg, yk, def, excess, gp, g

    M = _cge_load()
    D = _cge_dyn_load()
    QF = _cge_vn(M, D.prev, "QF")
    WFD = _cge_vn(M, D.prev, "WFDIST")
    QFS = _cge_vn(M, D.prev, "QFS")
    W = _cge_vn(M, D.prev, "W")
    inv = _cge_vn(M, M.x0, "PQ")' * _cge_vn(M, D.prev, "QINV")
    YF0 = _cge_vn(M, M.x0, "YF")
    yk = sum(D.capital :* YF0)
    qlf = M.p.qlf
    // Deaths in the previous period relative to the base death rate (15.4),
    // with that period's parameters
    excess = 0
    if (M.p0.hasmort == 1) {
        excess = M.p.mort0 - M.p.mort * (_cge_vn(M, D.prev, "HS") / M.p.hs0) ^ M.p.epsm
    }
    gp = D.gpop + excess
    for (f = 1; f <= M.nF; f++) {
        if (D.capital[f]) {
            // 1. Capital: depreciation plus new capital from real investment
            newk = D.rental[f] * YF0[f] / yk * inv
            if (M.c_fac[f] == "specific") {
                q = M.fa[f, .]' :* QF[f, .]'
                s = q / sum(q)
                rent = W[f] :* WFD[f, .]'
                avg = s' * rent
                eta = M.fa[f, .]' :* s :* (1 :+ D.sens :* (rent :/ avg :- 1))
                eta = eta :* (eta :> 0)
                eta = eta / sum(eta)
                QF[f, .] = ((1 - D.delta[f]) :* q + newk :* eta)'
            }
            else QFS[f] = (1 - D.delta[f]) * QFS[f] + newk
        }
        else {
            // 2. Other factors, less deaths at working ages
            g = D.fgrowth[f] + D.dfac[f] * D.dshare / D.wage * excess
            if (M.c_fac[f] == "specific") QF[f, .] = (1 + g) :* QF[f, .]
            else if (M.c_fac[f] == "mobile") QFS[f] = (1 + g) * QFS[f]
            // The labour force grows at the same rate (model_spec.md, 14.4)
            if (M.p0.inlf[f]) qlf[f] = (1 + g) * qlf[f]
        }
    }
    M.p.qlf = qlf
    _cge_setv(M, M.xcur, "QF", QF)
    _cge_setv(M, M.xcur, "QFS", QFS)
    // 3. Population; 4. government and foreign flows
    _cge_dyn_grow(M, D, gp)
    // 5. Public debt (model_spec.md, 12.3): last period's deficit is borrowed,
    // the share phi abroad; a surplus repays debt in the same shares
    if (M.p.debt == 1) {
        def = -_cge_vn(M, D.prev, "GSAV")
        M.p.ddebt = M.p.ddebt + (1 - M.p.phi) * def
        M.p.fdebt = M.p.fdebt + M.p.phi * def / _cge_vn(M, D.prev, "EXR")
    }
    _cge_store(M)
}

real scalar _cge_dyn_va(struct cge_model scalar M, real colvector x)
{
    return(sum(_cge_va_real(M, x)))
}

// Solve one period (step 6 of Section 10 for t >= 1) and store it as the
// simulation <run><period>
void _cge_dyn_solve(real scalar period, real scalar first)
{
    struct cge_model scalar M
    struct cge_dyn scalar D
    real colvector x, x1, ad
    real scalar conv, iter, err, lam, l0, l1, l2, g0, g1, target, it, t, kk
    string scalar method

    M = _cge_load()
    D = _cge_dyn_load()
    lam = .
    // the values of the periods before, for the lags of user equations (from
    // version 0.9.2); the first period follows the base
    if (_cge_u_haslag(M)) M.p.xlag = D.prevs
    // the period, for tperiod, tfirst and tlast (from version 0.10.2)
    M.p.tinfo = (period, first, period == D.periods[rows(D.periods)])
    if (first) {
        x = _cge_solve_point(M, M.p, M.xcur, M.x0, D.tol, D.maxit, 0, conv, iter, err, method)
    }
    else {
        t = D.k
        ad = M.p.ad
        if (D.mode == 0) {
            M.p.ad = ad :* (1 :+ D.tfp)
            x = _cge_solve_point(M, M.p, M.xcur, D.prev, D.tol, D.maxit, 0, conv, iter, err, method)
        }
        else if (D.mode == 2) {
            lam = D.lampath[t]
            M.p.ad = ad :* lam
            x = _cge_solve_point(M, M.p, M.xcur, D.prev, D.tol, D.maxit, 0, conv, iter, err, method)
        }
        else {
            // Uniform efficiency factor for the growth target (secant iterations)
            target = (1 + D.target[t]) * _cge_dyn_va(M, D.prev)
            l0 = 1
            M.p.ad = ad :* l0
            x = _cge_solve_point(M, M.p, M.xcur, D.prev, D.tol, D.maxit, 0, conv, iter, err, method)
            if (!conv) _cge_fail("period " + strofreal(period) + " did not converge", 430)
            g0 = _cge_dyn_va(M, x) / target - 1
            l1 = 1 + D.target[t]
            M.p.ad = ad :* l1
            x = _cge_solve_point(M, M.p, M.xcur, D.prev, D.tol, D.maxit, 0, conv, iter, err, method)
            if (!conv) _cge_fail("period " + strofreal(period) + " did not converge", 430)
            g1 = _cge_dyn_va(M, x) / target - 1
            for (it = 1; it <= 50; it++) {
                if (abs(g1) < 1e-13) break
                l2 = l1 - g1 * (l1 - l0) / (g1 - g0)
                l0 = l1
                g0 = g1
                l1 = l2
                M.p.ad = ad :* l1
                x = _cge_solve_point(M, M.p, M.xcur, D.prev, D.tol, D.maxit, 0, conv, iter, err, method)
                if (!conv) _cge_fail("period " + strofreal(period) + " did not converge", 430)
                g1 = _cge_dyn_va(M, x) / target - 1
            }
            if (abs(g1) >= 1e-13) _cge_fail("period " + strofreal(period) + ": the growth target was not met", 430)
            lam = l1
        }
        D.k = D.k + 1
    }
    if (!conv) _cge_fail("period " + strofreal(period) + " did not converge", 430)
    err = _cge_maxres(M, M.p, x)
    kk = _cge_store_sim(M, D.name + strofreal(period), x, conv, iter, err, method)
    M.simrun[kk] = D.name
    M.simper[kk] = period
    M.simlam[kk] = lam
    D.prev = x
    D.prevs = (x, D.prevs[|1, 1 \ ., cols(D.prevs) - 1|])
    _cge_store(M)
    _cge_dyn_store(D)
    printf("{txt}Period {res}%f{txt}: solved in {res}%f{txt} iteration(s)", period, iter)
    if (!missing(lam)) printf("{txt}; efficiency factor {res}%12.10f", lam)
    printf("\n")
}

// At the end of a run that solved every period: restore the parameters and
// fixed values the model had before the run, and drop the periods of an
// earlier run of the same name that this run did not solve again
void _cge_dyn_end()
{
    struct cge_model scalar M
    struct cge_dyn scalar D
    pointer() scalar q
    real colvector keep
    real scalar k
    if ((q = findexternal("cge__dyn")) == NULL) return
    D = *q
    M = _cge_load()
    M.p = D.psave
    M.xcur = D.xsave
    keep = J(rows(M.simname), 1, 1)
    for (k = 1; k <= rows(M.simname); k++) {
        if (M.simrun[k] == D.name) keep[k] = anyof(D.periods, M.simper[k])
    }
    if (!all(keep)) _cge_sims_keep(M, select((1::rows(keep)), keep))
    _cge_store(M)
    rmexternal("cge__dyn")
    if (findexternal("cge__dyn_model") != NULL) rmexternal("cge__dyn_model")
    _cge_fs_clear()
}

// When a run fails: the model as it was before the run, so that no period is
// stored and an earlier run of the same name is kept as it was (from version
// 0.6.4)
void _cge_dyn_abort()
{
    pointer() scalar q
    if ((q = findexternal("cge__dyn_model")) != NULL) {
        _cge_store(*q)
        rmexternal("cge__dyn_model")
    }
    if (findexternal("cge__dyn") != NULL) rmexternal("cge__dyn")
    _cge_fs_clear()
}

// =====================================================================
// Perfect foresight (from version 0.10.2; model_spec.md, Section 10.6)
// =====================================================================
//
// cge_dynamic, foresight solves the periods of a run together. The
// exogenous path is set period by period as in a recursive run, before
// anything is solved: the growth of factors, population, government and
// foreign flows and efficiency, and the shocks of each period
// (_cge_fs_advance, _cge_fs_probe, _cge_fs_record). What a recursive run
// carries from the solution of one period to the next -- the capital stocks,
// public debt, the efficiency factor of growth targets and, with a death
// rate, population and the workers of the factors that lose them -- are the
// states of the run: unknowns of the stacked system, with the updates of
// Section 10 as equations. User equations refer to earlier periods with lag()
// and to later ones with lead(); beyond the last period a lead follows the
// terminal condition. The stacked system, the full system of every period
// and the updates of the states, is solved by Newton's method with the exact
// Jacobian and the sparse LU.

struct cge_fs {
    // the number of periods, the terminal condition (1 constant, 2 growth,
    // 3 base) and the start of Newton's method (1 a recursive run, 2 the base)
    real scalar              N, term, start
    // the exogenous fixed values of each period; the parameters are kept in
    // externals of their own (_cge_fs_pset), since an element of a vector of
    // structures read into a variable is, in Stata 13, the element itself
    real matrix              X
    // the states: kind (1 capital stock, 2 domestic debt, 3 foreign debt, 4
    // efficiency, 5 population, 6 workers of a factor), factor, position of a
    // capital stock in x, scale and value in the first period; the effect of
    // the shocks of each period on capital and debt, after = a + b before
    // (state x period)
    real colvector           skind, sfac, spos, sscale, s1
    real matrix              sa, sb
    // the supplies of the factors that lose workers: state and position in x
    real matrix              dmap
    // the regimes of the constraints of each period, once found (missing
    // before)
    real matrix              bm
    // while the shocks of a period are found: the model before them and after
    // their first run, and the states before each run and after the first
    struct cge_model scalar  Mpre, Mpost
    real colvector           pa, pb, qa
}

// A run with foresight in its stacked form: the free values (scaled) and
// states of each period, and the solution and fixed values that follow from
// them. The parameters of a period are made when needed (_cge_fs_par): Stata
// 13 fails on a vector of structures filled in a function and read after it
// returns.
struct cge_fsw {
    real matrix              Z, Sg, X, XF
}

struct cge_fs scalar _cge_fs_load()
{
    pointer() scalar q
    q = findexternal("cge__fs")
    if (q == NULL) _cge_fail("cge internal error: no run with foresight in progress", 3498)
    return(*q)
}

void _cge_fs_store(struct cge_fs scalar FS)
{
    pointer() scalar q
    if ((q = findexternal("cge__fs")) == NULL) q = crexternal("cge__fs")
    *q = FS
}

// The exogenous parameters of period t of the run with foresight in
// progress: kept, and a copy of them
void _cge_fs_pset(real scalar t, struct cge_par scalar p)
{
    pointer() scalar q
    if ((q = findexternal("cge__fsp" + strofreal(t))) == NULL) q = crexternal("cge__fsp" + strofreal(t))
    *q = p
}

struct cge_par scalar _cge_fs_pget(real scalar t)
{
    pointer() scalar q
    q = findexternal("cge__fsp" + strofreal(t))
    if (q == NULL) _cge_fail("cge internal error: no parameters for period " + strofreal(t), 3498)
    return(*q)
}

// The externals of a run with foresight, removed
void _cge_fs_clear()
{
    real scalar t
    if (findexternal("cge__fs") != NULL) rmexternal("cge__fs")
    for (t = 1; findexternal("cge__fsp" + strofreal(t)) != NULL; t++) rmexternal("cge__fsp" + strofreal(t))
}

// The start of a run with foresight, after _cge_dyn_start: the terminal
// condition, the start of Newton's method, the states, and the first period,
// the base
void _cge_fs_start(string scalar term, string scalar start)
{
    struct cge_model scalar M
    struct cge_dyn scalar D
    struct cge_fs scalar FS
    M = _cge_load()
    _cge_need(M, "sam")
    D = _cge_dyn_load()
    _cge_fs_clear()
    FS.N = rows(D.periods)
    FS.term = (term == "" | term == "constant" ? 1 : (term == "growth" ? 2 : (term == "base" ? 3 : .)))
    if (FS.term >= .) _cge_fail("terminal(): give constant, growth or base", 198)
    FS.start = (start == "" | start == "recursive" ? 1 : (start == "base" ? 2 : .))
    if (FS.start >= .) _cge_fail("start(): give recursive or base", 198)
    _cge_fs_states(M, D, FS)
    FS.sa = J(rows(FS.skind), FS.N, 0)
    FS.sb = J(rows(FS.skind), FS.N, 1)
    FS.bm = J(rows(M.p.bmode), FS.N, .)
    _cge_fs_pset(1, M.p)
    FS.X = M.xcur
    _cge_fs_store(FS)
}

// The states of a run with foresight: the capital stocks, by factor and, for
// a specific factor, activity; public debt; the efficiency factor of growth
// targets; and, with a death rate, population and the workers of each factor
// that loses them, relative to the exogenous path
void _cge_fs_states(struct cge_model scalar M, struct cge_dyn scalar D, struct cge_fs scalar FS)
{
    real matrix PF
    real colvector PS, pos
    real scalar f, j, nx
    nx = rows(M.x0)
    PF = _cge_vn(M, (1::nx), "QF")
    PS = _cge_vn(M, (1::nx), "QFS")
    FS.skind = FS.sfac = FS.spos = FS.sscale = FS.s1 = J(0, 1, .)
    FS.dmap = J(0, 2, .)
    for (f = 1; f <= M.nF; f++) {
        if (!D.capital[f]) continue
        if (M.c_fac[f] == "specific") pos = select(PF[f, .]', M.fa[f, .]' :> 0)
        else pos = PS[f]
        for (j = 1; j <= rows(pos); j++) {
            if (!M.fixed[pos[j]]) _cge_fail("foresight: the stock of capital factor " + M.F[f] + " must be fixed in the closure", 198)
        }
        FS.skind = FS.skind \ J(rows(pos), 1, 1)
        FS.sfac = FS.sfac \ J(rows(pos), 1, f)
        FS.spos = FS.spos \ pos
        FS.sscale = FS.sscale \ M.xscale[pos]
        FS.s1 = FS.s1 \ M.xcur[pos]
    }
    if (M.p0.debt == 1) {
        FS.skind = FS.skind \ 2 \ 3
        FS.sfac = FS.sfac \ 0 \ 0
        FS.spos = FS.spos \ 0 \ 0
        FS.sscale = FS.sscale \ max((1, abs(M.p.ddebt))) \ max((1, abs(M.p.fdebt)))
        FS.s1 = FS.s1 \ M.p.ddebt \ M.p.fdebt
    }
    if (D.mode == 1) {
        FS.skind = FS.skind \ 4
        FS.sfac = FS.sfac \ 0
        FS.spos = FS.spos \ 0
        FS.sscale = FS.sscale \ 1
        FS.s1 = FS.s1 \ 1
    }
    if (M.p0.hasmort == 1) {
        FS.skind = FS.skind \ 5
        FS.sfac = FS.sfac \ 0
        FS.spos = FS.spos \ 0
        FS.sscale = FS.sscale \ 1
        FS.s1 = FS.s1 \ 1
        for (f = 1; f <= M.nF; f++) {
            if (!D.dfac[f]) continue
            FS.skind = FS.skind \ 6
            FS.sfac = FS.sfac \ f
            FS.spos = FS.spos \ 0
            FS.sscale = FS.sscale \ 1
            FS.s1 = FS.s1 \ 1
            if (M.c_fac[f] == "specific") pos = select(PF[f, .]', M.fa[f, .]' :> 0)
            else pos = PS[f]
            pos = select(pos, M.fixed[pos] :> 0)
            if (rows(pos) & cols(pos)) FS.dmap = FS.dmap \ (J(rows(pos), 1, rows(FS.skind)), pos)
        }
    }
}

// The updates before a period of a run with foresight that do not depend on
// the solution of the period before (_cge_dyn_advance, steps 2 to 4): factors
// other than capital grow at their rates, population at its own; government
// and foreign flows grow. Capital stocks, debt and the effect of deaths are
// states of the stacked system.
void _cge_fs_advance()
{
    struct cge_model scalar M
    struct cge_dyn scalar D
    real matrix QF
    real colvector QFS, qlf
    real scalar f, g
    M = _cge_load()
    D = _cge_dyn_load()
    QF = _cge_vn(M, M.xcur, "QF")
    QFS = _cge_vn(M, M.xcur, "QFS")
    qlf = M.p.qlf
    for (f = 1; f <= M.nF; f++) {
        if (D.capital[f]) continue
        g = D.fgrowth[f]
        if (M.c_fac[f] == "specific") QF[f, .] = (1 + g) :* QF[f, .]
        else if (M.c_fac[f] == "mobile") QFS[f] = (1 + g) * QFS[f]
        if (M.p0.inlf[f]) qlf[f] = (1 + g) * qlf[f]
    }
    M.p.qlf = qlf
    _cge_setv(M, M.xcur, "QF", QF)
    _cge_setv(M, M.xcur, "QFS", QFS)
    _cge_dyn_grow(M, D, D.gpop)
    _cge_store(M)
}

// The values of the capital and debt states in the model (the other states
// are missing), and setting them
real colvector _cge_fs_sget(struct cge_model scalar M, struct cge_fs scalar FS)
{
    real colvector s
    real scalar j
    s = J(rows(FS.skind), 1, .)
    for (j = 1; j <= rows(s); j++) {
        if (FS.skind[j] == 1) s[j] = M.xcur[FS.spos[j]]
        else if (FS.skind[j] == 2) s[j] = M.p.ddebt
        else if (FS.skind[j] == 3) s[j] = M.p.fdebt
    }
    return(s)
}

void _cge_fs_sset(struct cge_model scalar M, struct cge_fs scalar FS, real colvector s)
{
    real scalar j
    for (j = 1; j <= rows(s); j++) {
        if (FS.skind[j] == 1) M.xcur[FS.spos[j]] = s[j]
        else if (FS.skind[j] == 2) M.p.ddebt = s[j]
        else if (FS.skind[j] == 3) M.p.fdebt = s[j]
    }
}

// The effect of the shocks of a period on the capital and debt states, from
// two runs of the shocks() program: after = a + b before, element by element.
// Step 1 keeps the model before the shocks; step 2, after the first run,
// keeps the model and starts the second run from the model before, with other
// values of the states; step 3, after the second run, finds a and b and puts
// back the model of the first run.
void _cge_fs_probe(real scalar step)
{
    struct cge_model scalar M, M2, E
    struct cge_fs scalar FS
    struct cge_dyn scalar D
    real colvector b1
    real scalar j, k
    M = _cge_load()
    FS = _cge_fs_load()
    if (step == 1) {
        FS.Mpre = M
        FS.pa = _cge_fs_sget(M, FS)
        _cge_fs_store(FS)
        return
    }
    if (step == 2) {
        D = _cge_dyn_load()
        _cge_fs_shockcheck(FS.Mpre, M, D, FS)
        FS.Mpost = M
        FS.qa = _cge_fs_sget(M, FS)
        FS.pb = FS.pa + FS.sscale :* (FS.skind :<= 3)
        M2 = FS.Mpre
        _cge_fs_sset(M2, FS, FS.pb)
        _cge_store(M2)
        _cge_fs_store(FS)
        return
    }
    b1 = _cge_fs_sget(M, FS)
    k = cols(FS.X) + 1
    for (j = 1; j <= rows(FS.skind); j++) {
        if (FS.skind[j] > 3) continue
        FS.sb[j, k] = (b1[j] - FS.qa[j]) / (FS.pb[j] - FS.pa[j])
        FS.sa[j, k] = FS.qa[j] - FS.sb[j, k] * FS.pa[j]
    }
    if (hasmissing(FS.sa[., k]) | hasmissing(FS.sb[., k])) {
        _cge_fail("shocks(): their effect on the capital and debt states could not be found", 459)
    }
    _cge_store(FS.Mpost)
    FS.Mpre = E
    FS.Mpost = E
    _cge_fs_store(FS)
}

// What the shocks of a period may not change in a run with foresight: the
// closure and the constraints; with growth targets, efficiency; with a death
// rate, population and the supply of the factors that lose workers
void _cge_fs_shockcheck(struct cge_model scalar M0, struct cge_model scalar M1, struct cge_dyn scalar D,
                        struct cge_fs scalar FS)
{
    real scalar f
    if (M1.fixed != M0.fixed | rows(M1.bY) != rows(M0.bY)) {
        _cge_fail("shocks(): in a run with foresight the closure and the constraints stay the same in every period", 198)
    }
    if (D.mode == 1 & M1.p.ad != M0.p.ad) {
        _cge_fail("shocks(): with gdpgrowth() and foresight, efficiency (ad) follows the growth targets and may not be shocked", 198)
    }
    if (M0.p0.hasmort != 1) return
    if (M1.p.gamma != M0.p.gamma | M1.p.gammah != M0.p.gammah | M1.p.hs0 != M0.p.hs0 | M1.p.pop != M0.p.pop) {
        _cge_fail("shocks(): with a death rate and foresight, population follows deaths; gamma, gammah, hs0 and pop may not be shocked", 198)
    }
    if (rows(FS.dmap)) {
        if (M1.xcur[FS.dmap[., 2]] != M0.xcur[FS.dmap[., 2]]) {
            _cge_fail("shocks(): with foresight, the supply of a factor in deathfactors() follows deaths and may not be shocked", 198)
        }
    }
    for (f = 1; f <= M0.nF; f++) {
        if (D.dfac[f] & M1.p.qlf[f] != M0.p.qlf[f]) {
            _cge_fail("shocks(): with foresight, the labour force of a factor in deathfactors() follows deaths and may not be shocked", 198)
        }
    }
}

// Records the exogenous parameters and fixed values of a period after its
// updates and shocks; efficiency grows at the rates of tfp() or follows the
// baseline, as in _cge_dyn_solve
void _cge_fs_record()
{
    struct cge_model scalar M
    struct cge_dyn scalar D
    struct cge_fs scalar FS
    M = _cge_load()
    D = _cge_dyn_load()
    FS = _cge_fs_load()
    if (D.mode == 0) M.p.ad = M.p.ad :* (1 :+ D.tfp)
    else if (D.mode == 2) M.p.ad = M.p.ad :* D.lampath[D.k]
    D.k = D.k + 1
    _cge_fs_pset(cols(FS.X) + 1, M.p)
    FS.X = FS.X, M.xcur
    _cge_store(M)
    _cge_dyn_store(D)
    _cge_fs_store(FS)
}

// The regimes of the constraints of period t, and setting them
real colvector _cge_fs_mode(struct cge_fs scalar FS, real scalar t)
{
    struct cge_par scalar p
    if (rows(FS.bm)) if (!hasmissing(FS.bm[., t])) return(FS.bm[., t])
    p = _cge_fs_pget(t)
    return(p.bmode)
}

void _cge_fs_setmode(struct cge_fs scalar FS, real scalar t, real colvector bm)
{
    if (rows(FS.bm)) FS.bm[., t] = bm
}

// The parameters p and fixed values xfix of period t with states s
void _cge_fs_map(struct cge_model scalar M, struct cge_fs scalar FS, real scalar t, real colvector s,
                 struct cge_par scalar p, real colvector xfix)
{
    real scalar j, k, f
    p = _cge_fs_pget(t)
    xfix = FS.X[., t]
    for (j = 1; j <= rows(s); j++) {
        k = FS.skind[j]
        if (k == 1) xfix[FS.spos[j]] = s[j]
        else if (k == 2) p.ddebt = s[j]
        else if (k == 3) p.fdebt = s[j]
        else if (k == 4) p.ad = p.ad :* s[j]
        else if (k == 5) {
            p.gamma = p.gamma :* s[j]
            p.gammah = p.gammah :* s[j]
            p.hs0 = p.hs0 * s[j]
            p.pop = p.pop * s[j]
        }
        else if (k == 6) {
            f = FS.sfac[j]
            if (M.p0.inlf[f]) p.qlf[f] = p.qlf[f] * s[j]
        }
    }
    if (rows(FS.dmap)) xfix[FS.dmap[., 2]] = xfix[FS.dmap[., 2]] :* s[FS.dmap[., 1], 1]
    if (rows(M.bY)) p.bxbar = xfix[M.bX]
    if (rows(FS.bm)) if (!hasmissing(FS.bm[., t])) p.bmode = FS.bm[., t]
}

// Entries (r[i], c[j], V[i, j]) of a matrix, without its zeros
real matrix _cge_fs_ent(real colvector r, real colvector c, real matrix V)
{
    real matrix E
    real colvector k
    if (!rows(r) | !rows(c)) return(J(0, 3, .))
    E = (vec(J(1, rows(c), r)), vec(J(rows(r), 1, c')), vec(V))
    k = selectindex(E[., 3] :!= 0)
    if (!rows(k) | !cols(k)) return(J(0, 3, .))
    return(E[k, .])
}

// The states of period t from the solution x, parameters p and states s of
// period t - 1, before the shocks of period t (Section 10, steps 1 and 5,
// and 15.4), in ph; with wantd, the derivatives of each as entries (state,
// position in x, value) in DX and (state, state of t - 1, value) in DS. The
// efficiency state has no update here: its equation is the growth target.
void _cge_fs_phi(struct cge_model scalar M, struct cge_dyn scalar D, struct cge_fs scalar FS,
                 real colvector s, real colvector x, struct cge_par scalar p, real colvector ph,
                 real matrix DX, real matrix DS, real scalar wantd)
{
    real matrix PF, PW, Dsq, Dtq, Dtf, Deq, Def, Dnq, Dnf, Dg
    real colvector PS, PI, PQ0, YF0, idx, posq, posw, q, sv, wfd, r, rat, e, cnt, eta, g1, Dtw, Dew, Dnw
    real scalar nx, f, j, j5, yk, c, inv, newk, del, m, Q, W, avg, E, posG, posE, gsav, exr, posH, hs, ex
    real scalar dexh, dexr, rho, mu, kap, fg, daw
    nx = rows(M.x0)
    ph = J(rows(s), 1, .)
    DX = J(0, 3, .)
    DS = J(0, 3, .)
    // capital (step 1): depreciation plus new capital from real investment,
    // shared among the activities of a specific factor by their rents
    if (any(FS.skind :== 1)) {
        PI = _cge_vn(M, (1::nx), "QINV")
        PQ0 = _cge_vn(M, M.x0, "PQ")
        inv = PQ0' * x[PI]
        YF0 = _cge_vn(M, M.x0, "YF")
        yk = sum(D.capital :* YF0)
        PW = _cge_vn(M, (1::nx), "WFDIST")
        PS = _cge_vn(M, (1::nx), "W")
        for (f = 1; f <= M.nF; f++) {
            if (!D.capital[f]) continue
            idx = selectindex((FS.skind :== 1) :& (FS.sfac :== f))
            c = D.rental[f] * YF0[f] / yk
            newk = c * inv
            del = D.delta[f]
            if (M.c_fac[f] != "specific") {
                j = idx[1]
                ph[j] = (1 - del) * x[FS.spos[j]] + newk
                if (wantd) DX = DX \ (j, FS.spos[j], 1 - del) \ (J(rows(PI), 1, j), PI, c :* PQ0)
                continue
            }
            m = rows(idx)
            posq = FS.spos[idx, 1]
            q = x[posq]
            Q = sum(q)
            sv = q / Q
            posw = select(PW[f, .]', M.fa[f, .]' :> 0)
            W = x[PS[f]]
            wfd = x[posw]
            r = W :* wfd
            avg = sv' * r
            rat = r :/ avg
            g1 = 1 :+ D.sens :* (rat :- 1)
            e = sv :* g1
            cnt = (e :> 0)
            E = sum(e :* cnt)
            eta = (e :* cnt) / E
            ph[idx] = (1 - del) :* q + newk :* eta
            if (!wantd) continue
            // with respect to the stocks q, the factor price W and the
            // distortions wfd: shares, rents relative to their average,
            // weights and shares of new capital
            Dsq = (I(m) - sv * J(1, m, 1)) / Q
            Dtq = -(rat * (r' * Dsq)) / avg
            daw = sv' * wfd
            Dtw = (wfd - rat * daw) / avg
            Dtf = (W :* I(m) - rat * (W :* sv')) / avg
            Deq = cnt :* (g1 :* Dsq + (sv :* D.sens) :* Dtq)
            Dew = cnt :* ((sv :* D.sens) :* Dtw)
            Def = cnt :* ((sv :* D.sens) :* Dtf)
            Dnq = (Deq - eta * colsum(Deq)) / E
            Dnw = (Dew - eta * colsum(Dew)) / E
            Dnf = (Def - eta * colsum(Def)) / E
            DX = DX \ _cge_fs_ent(idx, posq, (1 - del) :* I(m) + newk :* Dnq)
            DX = DX \ _cge_fs_ent(idx, PS[f], newk :* Dnw)
            DX = DX \ _cge_fs_ent(idx, posw, newk :* Dnf)
            DX = DX \ _cge_fs_ent(idx, PI, (c :* eta) * PQ0')
        }
    }
    // public debt (step 5): last period's deficit is borrowed, the share phi
    // abroad
    if (M.p0.debt == 1) {
        posG = _cge_vpos(M, _cge_vidx(M, "GSAV"))
        posE = _cge_vpos(M, _cge_vidx(M, "EXR"))
        gsav = x[posG]
        exr = x[posE]
        j = selectindex(FS.skind :== 2)
        ph[j] = s[j] - (1 - p.phi) * gsav
        if (wantd) {
            DS = DS \ (j, j, 1)
            DX = DX \ (j, posG, -(1 - p.phi))
        }
        j = selectindex(FS.skind :== 3)
        ph[j] = s[j] - p.phi * gsav / exr
        if (wantd) {
            DS = DS \ (j, j, 1)
            DX = DX \ (j, posG, -p.phi / exr) \ (j, posE, p.phi * gsav / exr^2)
        }
    }
    // population and the workers of the factors that lose them (15.4):
    // deaths in the period before relative to the base death rate; the
    // population state enters the death rate through hs0
    if (M.p0.hasmort == 1) {
        posH = _cge_vpos(M, _cge_vidx(M, "HS"))
        hs = x[posH]
        j5 = selectindex(FS.skind :== 5)
        rho = s[j5]
        ex = p.mort0 - p.mort * (hs / p.hs0) ^ p.epsm
        dexh = -p.mort * p.epsm * (hs / p.hs0) ^ p.epsm / hs
        dexr = p.mort * p.epsm * (hs / p.hs0) ^ p.epsm / rho
        ph[j5] = rho * (1 + D.gpop + ex) / (1 + D.gpop)
        if (wantd) {
            DS = DS \ (j5, j5, (1 + D.gpop + ex + rho * dexr) / (1 + D.gpop))
            DX = DX \ (j5, posH, rho * dexh / (1 + D.gpop))
        }
        kap = D.dshare / D.wage
        for (j = 1; j <= rows(FS.skind); j++) {
            if (FS.skind[j] != 6) continue
            fg = D.fgrowth[FS.sfac[j]]
            mu = s[j]
            ph[j] = mu * (1 + fg + kap * ex) / (1 + fg)
            if (wantd) {
                DS = DS \ (j, j, (1 + fg + kap * ex) / (1 + fg)) \ (j, j5, mu * kap * dexr / (1 + fg))
                DX = DX \ (j, posH, mu * kap * dexh / (1 + fg))
            }
        }
    }
}

// The values of the periods before period t, for lag() (from version 0.9.2):
// the base before the first period
real matrix _cge_fs_lags(struct cge_model scalar M, real matrix X, real scalar t)
{
    real matrix L
    real scalar k
    L = J(rows(X), _cge_maxlag(), .)
    for (k = 1; k <= _cge_maxlag(); k++) L[., k] = (t - k >= 1 ? X[., t - k] : M.x0)
    return(L)
}

// The values of the periods after period t, for lead(); beyond the last
// period the terminal condition: the value of the last period (constant), the
// growth of the last period continued (growth), or the base
real matrix _cge_fs_leads(struct cge_model scalar M, struct cge_fs scalar FS, real matrix X, real scalar t)
{
    real matrix L
    real colvector g
    real scalar k, N
    N = FS.N
    L = J(rows(X), _cge_maxlag(), .)
    g = _cge_fs_growth(X[., N], X[., N - 1])
    for (k = 1; k <= _cge_maxlag(); k++) {
        if (t + k <= N) L[., k] = X[., t + k]
        else if (FS.term == 1) L[., k] = X[., N]
        else if (FS.term == 2) L[., k] = X[., N] :* g :^ (t + k - N)
        else L[., k] = M.x0
    }
    return(L)
}

// The growth factor from a to b, 1 where either is zero or missing
real colvector _cge_fs_growth(real colvector b, real colvector a)
{
    real colvector ok
    ok = (a :!= 0) :& (b :!= 0) :& (a :< .) :& (b :< .)
    return(ok :* (b :/ (a + (1 :- ok))) + (1 :- ok))
}

// The stacked vector u in its periods (W.Z and W.Sg), and back
void _cge_fs_unpack(struct cge_model scalar M, struct cge_fs scalar FS, struct cge_sys scalar S, real colvector u,
                    struct cge_fsw scalar W)
{
    real scalar nf, ns, N
    nf = rows(S.free)
    ns = rows(FS.skind)
    N = FS.N
    W.Z = colshape(u[|1 \ N * nf|], nf)'
    W.Sg = J(ns, N, .)
    if (ns) {
        W.Sg[., 1] = FS.s1
        W.Sg[|1, 2 \ ns, N|] = colshape(u[|N * nf + 1 \ rows(u)|], ns)' :* FS.sscale
    }
}

real colvector _cge_fs_pack(struct cge_fs scalar FS, struct cge_fsw scalar W)
{
    real scalar ns
    ns = rows(FS.skind)
    if (!ns) return(vec(W.Z))
    return(vec(W.Z) \ vec(W.Sg[|1, 2 \ ns, FS.N|] :/ FS.sscale))
}

// The solution and fixed values of every period from W.Z and W.Sg
void _cge_fs_build(struct cge_model scalar M, struct cge_dyn scalar D, struct cge_fs scalar FS,
                   struct cge_sys scalar S, struct cge_fsw scalar W)
{
    struct cge_par scalar p
    real colvector xf, x
    real scalar t, N
    N = FS.N
    W.X = W.XF = J(rows(M.x0), N, .)
    for (t = 1; t <= N; t++) {
        _cge_fs_map(M, FS, t, W.Sg[., t], p, xf)
        x = xf
        x[S.free] = W.Z[., t] :* M.xscale[S.free]
        W.X[., t] = x
        W.XF[., t] = xf
    }
}

// The parameters of period t of the stacked form W (after _cge_fs_build),
// with the values of the periods before and after it and the period
struct cge_par scalar _cge_fs_par(struct cge_model scalar M, struct cge_dyn scalar D, struct cge_fs scalar FS,
                                  struct cge_fsw scalar W, real scalar t)
{
    struct cge_par scalar p
    real colvector xf
    _cge_fs_map(M, FS, t, W.Sg[., t], p, xf)
    if (_cge_u_haslag(M)) p.xlag = _cge_fs_lags(M, W.X, t)
    if (_cge_u_haslead(M)) p.xlead = _cge_fs_leads(M, FS, W.X, t)
    p.tinfo = (D.periods[t], t == 1, t == FS.N)
    return(p)
}

// The residuals of the stacked system at u: the equations of each period,
// scaled, then the updates of the states of each period after the first,
// relative to their scale; the growth target is relative to base value added.
// Missing where an equation cannot be evaluated.
real colvector _cge_fs_resid(struct cge_model scalar M, struct cge_dyn scalar D, struct cge_fs scalar FS,
                             struct cge_sys scalar S, real colvector u)
{
    struct cge_fsw scalar W
    struct cge_par scalar p
    real colvector R, f, ph, r
    real matrix DX, DS
    real scalar t, N, nf, ns, j4
    N = FS.N
    nf = rows(S.free)
    ns = rows(FS.skind)
    _cge_fs_unpack(M, FS, S, u, W)
    _cge_fs_build(M, D, FS, S, W)
    R = J(N * nf + (N - 1) * ns, 1, .)
    for (t = 1; t <= N; t++) {
        p = _cge_fs_par(M, D, FS, W, t)
        f = _cge_F(M, p, W.XF[., t], S, W.Z[., t])
        if (hasmissing(f)) return(R)
        R[|(t - 1) * nf + 1 \ t * nf|] = f
    }
    if (!ns) return(R)
    j4 = selectindex(FS.skind :== 4)
    for (t = 2; t <= N; t++) {
        p = _cge_fs_par(M, D, FS, W, t - 1)
        _cge_fs_phi(M, D, FS, W.Sg[., t - 1], W.X[., t - 1], p, ph, DX, DS, 0)
        r = (W.Sg[., t] - FS.sa[., t] - FS.sb[., t] :* ph) :/ FS.sscale
        if (rows(j4) & cols(j4)) {
            r[j4] = (_cge_dyn_va(M, W.X[., t]) - (1 + D.target[t - 1]) * _cge_dyn_va(M, W.X[., t - 1])) /
                    _cge_dyn_va(M, M.x0)
        }
        R[|N * nf + (t - 2) * ns + 1 \ N * nf + (t - 1) * ns|] = r
    }
    return(R)
}

// The columns of the stacked system for positions pos of x in period t, with
// the derivative of x[pos] with respect to each: free variables, then, from
// the second period, capital stocks and the supplies of the factors that
// lose workers. Adds the entries (rows rr, those columns, values vv times
// the derivatives) to T; positions without a column are left out.
void _cge_fs_cols(struct cge_model scalar M, struct cge_fs scalar FS, real scalar nf, real scalar t,
                  real colvector fidx, real colvector kidx, real colvector didx, real colvector pos,
                  real colvector rr, real colvector vv, struct cge_trip scalar T)
{
    real colvector a, sel
    real scalar ns, so
    if (!rows(pos)) return
    ns = rows(FS.skind)
    a = fidx[pos]
    sel = selectindex(a :> 0)
    if (rows(sel) & cols(sel)) _cge_tadd(T, rr[sel], (t - 1) * nf :+ a[sel], vv[sel] :* M.xscale[pos[sel]])
    if (t < 2) return
    so = FS.N * nf + (t - 2) * ns
    a = kidx[pos] :* (fidx[pos] :== 0)
    sel = selectindex(a :> 0)
    if (rows(sel) & cols(sel)) _cge_tadd(T, rr[sel], so :+ a[sel], vv[sel] :* FS.sscale[a[sel], 1])
    a = didx[pos] :* (fidx[pos] :== 0)
    sel = selectindex(a :> 0)
    if (rows(sel) & cols(sel)) _cge_tadd(T, rr[sel], so :+ a[sel], vv[sel] :* FS.X[pos[sel], t])
}

// The entries of the Jacobian of the stacked system at u, scaled as
// _cge_fs_resid: within each period, the exact Jacobian of its full system,
// with its capital stocks as further columns, and central differences for
// its other states; across periods, the derivatives of user equations with
// respect to the values that lag() and lead() refer to, and those of the
// updates of the states. Returns 0 where the equations cannot be evaluated.
real scalar _cge_fs_jac(struct cge_model scalar M, struct cge_dyn scalar D, struct cge_fs scalar FS,
                        struct cge_sys scalar S, real colvector u, real colvector ri, real colvector ci,
                        real colvector v)
{
    struct cge_fsw scalar W
    struct cge_trip scalar T
    struct cge_par scalar p, pt
    real colvector fidx, kidx, didx, kk, kpos, r, c, w, sel, sg, xf, fp, fm, d, ph, gva, pva, tr, rows_, nr
    real matrix DX, DS, PQI, GQ
    real scalar N, nf, ns, nx, t, j, h, so, to, spo, j4, va0, hl
    N = FS.N
    nf = rows(S.free)
    ns = rows(FS.skind)
    nx = rows(M.x0)
    _cge_fs_unpack(M, FS, S, u, W)
    _cge_fs_build(M, D, FS, S, W)
    fidx = kidx = didx = J(nx, 1, 0)
    fidx[S.free] = (1::nf)
    kk = selectindex(FS.skind :== 1)
    kpos = J(0, 1, .)
    if (rows(kk) & cols(kk)) {
        kidx[FS.spos[kk, 1]] = kk
        kpos = FS.spos[kk, 1]
    }
    else kk = J(0, 1, .)
    if (rows(FS.dmap)) didx[FS.dmap[., 2]] = FS.dmap[., 1]
    hl = (_cge_u_haslag(M) | _cge_u_haslead(M))
    _cge_tinit(T)
    for (t = 1; t <= N; t++) {
        so = N * nf + (t - 2) * ns
        // within the period, with its capital stocks as columns nf + 1, ...
        pt = _cge_fs_par(M, D, FS, W, t)
        if (!_cge_jac_trip(M, pt, W.XF[., t], S, W.Z[., t], r, c, w, kpos)) return(0)
        sel = selectindex(c :<= nf)
        if (rows(sel) & cols(sel)) _cge_tadd(T, (t - 1) * nf :+ r[sel], (t - 1) * nf :+ c[sel], w[sel])
        if (t >= 2) {
            sel = selectindex(c :> nf)
            if (rows(sel) & cols(sel)) _cge_tadd(T, (t - 1) * nf :+ r[sel], so :+ kk[c[sel] :- nf, 1], w[sel])
            // the other states of the period, by central differences
            for (j = 1; j <= ns; j++) {
                if (FS.skind[j] == 1) continue
                h = 1e-6 * max((1, abs(W.Sg[j, t])))
                sg = W.Sg[., t]
                sg[j] = sg[j] + h
                _cge_fs_map(M, FS, t, sg, p, xf)
                p.xlag = pt.xlag
                p.xlead = pt.xlead
                p.tinfo = pt.tinfo
                fp = _cge_F(M, p, xf, S, W.Z[., t])
                sg[j] = W.Sg[j, t] - h
                _cge_fs_map(M, FS, t, sg, p, xf)
                p.xlag = pt.xlag
                p.xlead = pt.xlead
                p.tinfo = pt.tinfo
                fm = _cge_F(M, p, xf, S, W.Z[., t])
                if (hasmissing(fp) | hasmissing(fm)) return(0)
                d = (fp - fm) :* (FS.sscale[j] / (2 * h))
                sel = selectindex(d :!= 0)
                if (rows(sel) & cols(sel)) _cge_tadd(T, (t - 1) * nf :+ sel, J(rows(sel), 1, so + j), d[sel])
            }
        }
        // the values that lag() and lead() refer to
        if (hl) _cge_fs_ucross(M, FS, S, W, pt, t, fidx, kidx, didx, T)
    }
    // the updates of the states
    if (ns) {
        j4 = selectindex(FS.skind :== 4)
        if (rows(j4) & cols(j4)) {
            // value added at base prices is linear in x: PVA0 QVA less the
            // commodities in nests at base prices (_cge_va_real)
            pva = vec(_cge_vn(M, (1::nx), "QVA"))
            gva = vec(_cge_vn(M, M.x0, "PVA"))
            if (any(M.ecell)) {
                PQI = _cge_vn(M, (1::nx), "QINT")
                GQ = -(M.ecell :* _cge_vn(M, M.x0, "PQ") :* (1 :+ (M.p0.tv :* _cge_vn(M, M.x0, "TVADJ")) * (1 :- M.p0.kappa)'))
                pva = pva \ vec(PQI)
                gva = gva \ vec(GQ)
            }
            sel = selectindex(gva :!= 0)
            pva = pva[sel]
            gva = gva[sel]
            va0 = _cge_dyn_va(M, M.x0)
        }
        for (t = 2; t <= N; t++) {
            to = N * nf + (t - 2) * ns
            spo = N * nf + (t - 3) * ns
            // each state's own entry; the growth target is not an update
            nr = selectindex(FS.skind :!= 4)
            if (rows(nr) & cols(nr)) _cge_tadd(T, to :+ nr, to :+ nr, J(rows(nr), 1, 1))
            p = _cge_fs_par(M, D, FS, W, t - 1)
            _cge_fs_phi(M, D, FS, W.Sg[., t - 1], W.X[., t - 1], p, ph, DX, DS, 1)
            if (rows(DX)) {
                tr = DX[., 1]
                _cge_fs_cols(M, FS, nf, t - 1, fidx, kidx, didx, DX[., 2], to :+ tr,
                             -FS.sb[tr, t] :* DX[., 3] :/ FS.sscale[tr, 1], T)
            }
            if (rows(DS) & t >= 3) {
                tr = DS[., 1]
                _cge_tadd(T, to :+ tr, spo :+ DS[., 2], -FS.sb[tr, t] :* DS[., 3] :* FS.sscale[DS[., 2], 1] :/ FS.sscale[tr, 1])
            }
            if (rows(j4) & cols(j4)) {
                rows_ = J(rows(pva), 1, to + j4)
                _cge_fs_cols(M, FS, nf, t, fidx, kidx, didx, pva, rows_, gva / va0, T)
                _cge_fs_cols(M, FS, nf, t - 1, fidx, kidx, didx, pva, rows_, -(1 + D.target[t - 1]) :* gva / va0, T)
            }
        }
    }
    ri = (T.n ? T.r[|1 \ T.n|] : J(0, 1, .))
    ci = (T.n ? T.c[|1 \ T.n|] : J(0, 1, .))
    v = (T.n ? T.v[|1 \ T.n|] : J(0, 1, .))
    return(!hasmissing(v))
}

// The derivatives of the user equations of period t, with parameters p, with
// respect to the values that their lag() and lead() refer to, in the periods
// they refer to; beyond the last period, through the terminal condition
void _cge_fs_ucross(struct cge_model scalar M, struct cge_fs scalar FS, struct cge_sys scalar S,
                    struct cge_fsw scalar W, struct cge_par scalar p, real scalar t, real colvector fidx,
                    real colvector kidx, real colvector didx, struct cge_trip scalar T)
{
    real matrix tk1, tk2, utk
    real colvector bo, rowsys, sel, vcode, pos, ord
    real rowvector gl, gr, g
    real scalar kb, k, nx, nf, N, i, row, rs, tt, jj, xn, xm, gN
    nx = rows(M.x0)
    nf = rows(S.free)
    N = FS.N
    kb = _cge_find(M.ename, "U")
    bo = runningsum(M.elen) - M.elen
    rowsys = runningsum(S.mask) :* S.mask
    for (k = 1; k <= rows(M.uelab); k++) {
        tk1 = M.utok[|M.ustart[k], 1 \ M.ustart[k] + M.ulen[k] - 1, 3|]
        tk2 = M.utok[|M.ustart[k] + M.ulen[k], 1 \ M.ustart[k] + M.ulen[k] + M.ulen2[k] - 1, 3|]
        utk = tk1 \ tk2
        sel = selectindex((utk[., 1] :== 9) :| (utk[., 1] :== 11))
        if (!rows(sel) | !cols(sel)) continue
        row = bo[kb] + k
        rs = rowsys[row]
        if (!rs) continue
        // a lag of order o has the code pos + o nx, a lead pos + (4 + o) nx
        vcode = uniqrows(utk[sel, 2] + ((utk[sel, 1] :== 9) :* utk[sel, 3] + (utk[sel, 1] :== 11) :* (4 :+ utk[sel, 3])) :* nx)
        (void) _cge_u_dvalue(M, p, W.X[., t], tk1, vcode, gl)
        (void) _cge_u_dvalue(M, p, W.X[., t], tk2, vcode, gr)
        g = (gl - gr) :/ M.escale[row]
        pos = mod(vcode :- 1, nx) :+ 1
        ord = floor((vcode :- 1) :/ nx)
        for (i = 1; i <= rows(vcode); i++) {
            if (g[i] == 0) continue
            if (ord[i] <= 4) {
                tt = t - ord[i]
                if (tt >= 1) _cge_fs_cols(M, FS, nf, tt, fidx, kidx, didx, pos[i], (t - 1) * nf + rs, g[i], T)
                continue
            }
            tt = t + ord[i] - 4
            if (tt <= N) {
                _cge_fs_cols(M, FS, nf, tt, fidx, kidx, didx, pos[i], (t - 1) * nf + rs, g[i], T)
                continue
            }
            if (FS.term == 1) _cge_fs_cols(M, FS, nf, N, fidx, kidx, didx, pos[i], (t - 1) * nf + rs, g[i], T)
            else if (FS.term == 2) {
                // x(N) (x(N) / x(N - 1))^j
                jj = tt - N
                xn = W.X[pos[i], N]
                xm = W.X[pos[i], N - 1]
                gN = _cge_fs_growth(xn, xm)
                // where the growth factor is 1 by default, the value of the last period
                if (!(xm != 0 & xn != 0 & xm < . & xn < .)) {
                    _cge_fs_cols(M, FS, nf, N, fidx, kidx, didx, pos[i], (t - 1) * nf + rs, g[i], T)
                }
                else {
                    _cge_fs_cols(M, FS, nf, N, fidx, kidx, didx, pos[i], (t - 1) * nf + rs, g[i] * (jj + 1) * gN^jj, T)
                    _cge_fs_cols(M, FS, nf, N - 1, fidx, kidx, didx, pos[i], (t - 1) * nf + rs, -g[i] * jj * gN^(jj + 1), T)
                }
            }
        }
    }
}

// Newton's method on the stacked system from u, with the exact Jacobian, a
// line search on the residuals and the sparse LU, whose analysis is kept
// apart from that of single periods. Returns 1 when the largest scaled
// residual is below tol.
real scalar _cge_fs_newton(struct cge_model scalar M, struct cge_dyn scalar D, struct cge_fs scalar FS,
                           struct cge_sys scalar S, real colvector u, real scalar tol, real scalar maxit,
                           real scalar iter, real scalar err)
{
    struct cge_slu scalar SF
    real colvector R, Rn, du, un, ri, ci, v
    real scalar it, step, n0
    _cge_slu_load(SF, "cge__slu_fs")
    R = _cge_fs_resid(M, D, FS, S, u)
    iter = 0
    err = .
    if (hasmissing(R)) return(0)
    for (it = 0; it <= maxit; it++) {
        err = max(abs(R))
        iter = it
        printf("{txt}Iteration %f: largest scaled residual = {res}%9.3e\n", it, err)
        displayflush()
        if (err < tol) return(1)
        if (it == maxit) break
        if (!_cge_fs_jac(M, D, FS, S, u, ri, ci, v)) return(0)
        if (!_cge_slu_update(SF, ri, ci, v, rows(u), "cge__slu_fs")) return(0)
        du = _cge_slu_solve(SF, -R)
        if (hasmissing(du)) return(0)
        n0 = norm(R)
        for (step = 1; step >= 1e-8; step = step / 2) {
            un = u + step * du
            Rn = _cge_fs_resid(M, D, FS, S, un)
            if (!hasmissing(Rn)) if (norm(Rn) <= (1 - 1e-4 * step) * n0) break
        }
        if (step < 1e-8) return(0)
        u = un
        R = Rn
    }
    return(0)
}

// The start of Newton's method from a recursive run: each period solved in
// turn from its states, with the values of later periods expected to be
// those of the period before (the base in the first), growth targets met
// approximately, and the states of the next period updated from its
// solution. Returns the number of periods solved; the regimes of constraints
// found are kept in FS.bm.
real scalar _cge_fs_warm(struct cge_model scalar M, struct cge_dyn scalar D, struct cge_fs scalar FS,
                         struct cge_sys scalar S, struct cge_fsw scalar W)
{
    struct cge_par scalar p, pprev
    real colvector xf, x, ph, sg, j4
    real matrix DX, DS
    real scalar t, N, ns, conv, iter, err, nconv, hl, hd
    string scalar method
    N = FS.N
    ns = rows(FS.skind)
    W.Sg = J(ns, N, .)
    W.X = J(rows(M.x0), N, .)
    W.Z = J(rows(S.free), N, .)
    if (ns) W.Sg[., 1] = FS.s1
    j4 = selectindex(FS.skind :== 4)
    hl = _cge_u_haslag(M)
    hd = _cge_u_haslead(M)
    nconv = 0
    for (t = 1; t <= N; t++) {
        if (t >= 2 & ns) {
            _cge_fs_phi(M, D, FS, W.Sg[., t - 1], W.X[., t - 1], pprev, ph, DX, DS, 0)
            sg = FS.sa[., t] + FS.sb[., t] :* ph
            if (rows(j4) & cols(j4)) sg[j4] = W.Sg[j4, t - 1] * (1 + D.target[t - 1])
            W.Sg[., t] = sg
        }
        _cge_fs_map(M, FS, t, (ns ? W.Sg[., t] : J(0, 1, .)), p, xf)
        if (hl) p.xlag = _cge_fs_lags(M, W.X, t)
        if (hd) p.xlead = J(1, _cge_maxlag(), (t >= 2 ? W.X[., t - 1] : M.x0))
        p.tinfo = (D.periods[t], t == 1, t == N)
        x = _cge_solve_point(M, p, xf, (t >= 2 ? W.X[., t - 1] : xf), D.tol, D.maxit, 0, conv, iter, err, method)
        if (conv) nconv++
        else {
            x = xf
            x[S.free] = (t >= 2 ? W.X[S.free, t - 1] : M.x0[S.free])
        }
        if (rows(M.bY)) _cge_fs_setmode(FS, t, p.bmode)
        W.X[., t] = x
        W.Z[., t] = x[S.free] :/ M.xscale[S.free]
        pprev = p
    }
    return(nconv)
}

// Solves the run with foresight and stores each period as the simulation
// <run><period>
void _cge_fs_solve()
{
    struct cge_model scalar M
    struct cge_dyn scalar D
    struct cge_fs scalar FS
    struct cge_sys scalar S
    struct cge_fsw scalar W
    struct cge_par scalar p
    real colvector u, x, g, h, act, flip, bm, j4
    real scalar N, nf, ns, t, conv, iter, it2, err, r, anyact, nflip, kk, lam, nw
    M = _cge_load()
    D = _cge_dyn_load()
    FS = _cge_fs_load()
    N = FS.N
    S = _cge_sys_make(M, 0)
    if (rows(S.free) != S.neq) {
        errprintf("the system is not square: %f free variables, %f equations\n", rows(S.free), S.neq)
        exit(459)
    }
    nf = rows(S.free)
    ns = rows(FS.skind)
    printf("{txt}Perfect foresight: {res}%f{txt} periods of {res}%f{txt} equations and {res}%f{txt} state(s), {res}%f{txt} equations in all\n",
           N, nf, ns, N * nf + (N - 1) * ns)
    anyact = 0
    if (rows(M.bY)) for (t = 1; t <= N; t++) if (any(_cge_fs_mode(FS, t) :> 0)) anyact = 1
    if (FS.start == 1) {
        nw = _cge_fs_warm(M, D, FS, S, W)
        printf("{txt}Start: a recursive run, {res}%f{txt} of {res}%f{txt} period(s) solved\n", nw, N)
    }
    else {
        W.Sg = J(1, N, FS.s1)
        W.Z = J(1, N, M.x0[S.free] :/ M.xscale[S.free])
        printf("{txt}Start: the base in every period\n")
        // constraints: smoothed conditions find the regimes
        if (anyact) {
            for (t = 1; t <= N; t++) _cge_fs_setmode(FS, t, (_cge_fs_mode(FS, t) :> 0))
            u = _cge_fs_pack(FS, W)
            conv = _cge_fs_newton(M, D, FS, S, u, D.tol, D.maxit, it2, err)
            _cge_fs_unpack(M, FS, S, u, W)
            _cge_fs_build(M, D, FS, S, W)
            for (t = 1; t <= N; t++) {
                act = (_cge_fs_mode(FS, t) :> 0)
                if (conv) {
                    _cge_bgaps(M, _cge_fs_par(M, D, FS, W, t), W.X[., t], g, h)
                    _cge_fs_setmode(FS, t, act :* (2 :* (h :> g) + 3 :* (h :<= g)))
                }
                else _cge_fs_setmode(FS, t, 3 :* act)
            }
            if (!conv) {
                W.Sg = J(1, N, FS.s1)
                W.Z = J(1, N, M.x0[S.free] :/ M.xscale[S.free])
            }
        }
    }
    u = _cge_fs_pack(FS, W)
    iter = 0
    // exact conditions in the regimes found; a constraint whose other
    // condition fails changes regime
    for (r = 1; r <= 10; r++) {
        conv = _cge_fs_newton(M, D, FS, S, u, D.tol, D.maxit, it2, err)
        iter = iter + it2
        if (!conv | !anyact) break
        _cge_fs_unpack(M, FS, S, u, W)
        _cge_fs_build(M, D, FS, S, W)
        nflip = 0
        for (t = 1; t <= N; t++) {
            bm = _cge_fs_mode(FS, t)
            act = (bm :> 0)
            _cge_bgaps(M, _cge_fs_par(M, D, FS, W, t), W.X[., t], g, h)
            flip = act :* (((bm :== 3) :& (g :< -1e-9)) :| ((bm :== 2) :& (h :< -1e-9)))
            if (any(flip)) {
                _cge_fs_setmode(FS, t, flip :* (5 :- bm) + (1 :- flip) :* bm)
                nflip++
            }
        }
        if (!nflip) break
    }
    if (!conv) _cge_fail("the run with foresight did not converge (largest scaled residual " + strofreal(err, "%9.3e") + ")", 430)
    if (r > 10) _cge_fail("the run with foresight did not settle the regimes of its constraints", 430)
    // each period stored with the values of the periods around it
    _cge_fs_unpack(M, FS, S, u, W)
    _cge_fs_build(M, D, FS, S, W)
    j4 = selectindex(FS.skind :== 4)
    for (t = 1; t <= N; t++) {
        p = _cge_fs_par(M, D, FS, W, t)
        x = W.X[., t]
        err = _cge_maxres(M, p, x)
        lam = .
        if (t >= 2) {
            if (D.mode == 1) lam = W.Sg[j4, t] / W.Sg[j4, t - 1]
            else if (D.mode == 2) lam = D.lampath[t - 1]
        }
        M.p = p
        kk = _cge_store_sim(M, D.name + strofreal(D.periods[t]), x, 1, iter, err, "foresight")
        M.simrun[kk] = D.name
        M.simper[kk] = D.periods[t]
        M.simlam[kk] = lam
        _cge_store(M)
        M = _cge_load()
        printf("{txt}Period {res}%f{txt}: largest scaled residual {res}%9.2e", D.periods[t], err)
        if (!missing(lam)) printf("{txt}; efficiency factor {res}%12.10f", lam)
        printf("\n")
    }
    _cge_store(M)
    _cge_fs_store(FS)
    printf("{txt}Solved together in {res}%f{txt} iteration(s)\n", iter)
}

// =====================================================================
// Linked regions (from version 0.12.0; model_spec.md, Section 21)
// =====================================================================
//
// cge_region links calibrated single-country models through bilateral
// trade, as multi-region models such as GTAP do. Each region keeps its own
// model, closure and shocks. For a commodity that it trades with other
// regions, its world import price, its average tariff and its world export
// price become unknowns of the linked system: imports are a CES aggregate of
// the routes from the other regions and from the rest of the world, at
// prices that include each route's tariff (elasticity among sources sigma),
// and exports go to the other regions as their demand for them, and to the
// rest of the world along a demand curve (elasticity eta). Base values of the
// routes are in world units, one for every region; each region's SAM unit
// is worth units() of them. The rest of the world closes each region's trade
// at the base.

struct cge_lk {
    // the regions: name and the value in world units of a unit of its SAM;
    // the region whose model is in memory
    string colvector reg
    real colvector   units
    string scalar    cur
    // the routes: exporter and importer (positions in reg, 0 for the rest of
    // the world), commodity, base value at world prices (world units), base
    // and current tariff
    real colvector   rs, rr
    string colvector rc
    real colvector   rv, rt0, rt
    // by commodity: elasticity among sources of imports, elasticity of the
    // rest of the world's demand for exports, the rest of the world's export
    // price and the price shifting its demand for imports (both 1 at the base)
    string colvector ec
    real colvector   es, eta, pwrow, pwrowe
    // solutions: name, and the quantities (world units at base prices),
    // prices and tariffs of the routes
    string colvector sname
    real matrix      sq, sp, st
}

struct cge_lk scalar _cge_lk_load()
{
    pointer() scalar q
    q = findexternal("cge__lk")
    if (q == NULL) _cge_fail("cge_region: no regions; add them with cge_region add", 198)
    return(*q)
}

void _cge_lk_store(struct cge_lk scalar L)
{
    pointer() scalar q
    if ((q = findexternal("cge__lk")) == NULL) q = crexternal("cge__lk")
    *q = L
}

// The model of a region, a copy; and keeping one
struct cge_model scalar _cge_rg_get(string scalar name)
{
    pointer() scalar q
    q = findexternal("cge__rg_" + name)
    if (q == NULL) _cge_fail("cge_region: no region " + name, 111)
    return(*q)
}

void _cge_rg_put(string scalar name, struct cge_model scalar M)
{
    pointer() scalar q
    if ((q = findexternal("cge__rg_" + name)) == NULL) q = crexternal("cge__rg_" + name)
    *q = M
}

// The model in memory kept as the region it belongs to; a model of other
// accounts is not
void _cge_rg_sync()
{
    struct cge_lk scalar L
    struct cge_model scalar M, M0
    if (findexternal("cge__lk") == NULL) return
    L = _cge_lk_load()
    if (L.cur == "") return
    M = _cge_load()
    M0 = _cge_rg_get(L.cur)
    if (M.calibrated != 1 | M.A != M0.A | M.C != M0.C | M.F != M0.F) {
        printf("{txt}Note: the model in memory is not that of region {res}%s{txt}; it is not kept as the region\n", L.cur)
        return
    }
    _cge_rg_put(L.cur, M)
}

// cge_region add: the model in memory, calibrated, as region name
void _cge_region_add(string scalar name, real scalar units, real scalar repl)
{
    struct cge_lk scalar L
    struct cge_model scalar M
    real scalar k
    M = _cge_load()
    _cge_need(M, "sam")
    _cge_need(M, "calibrated")
    if (!regexm(name, "^[A-Za-z][A-Za-z0-9_]*$") | strlen(name) > 16) {
        _cge_fail("cge_region add: a region name has letters, digits and underscores, at most 16 characters, and starts with a letter", 198)
    }
    if (name == "rest") _cge_fail("cge_region add: rest is the rest of the world", 198)
    if (!(units > 0 & units < .)) _cge_fail("cge_region add: units() must be positive", 198)
    if (findexternal("cge__lk") != NULL) L = _cge_lk_load()
    else {
        L.reg = J(0, 1, "")
        L.units = J(0, 1, .)
        L.rs = L.rr = L.rv = L.rt0 = L.rt = J(0, 1, .)
        L.rc = J(0, 1, "")
        L.ec = J(0, 1, "")
        L.es = L.eta = L.pwrow = L.pwrowe = J(0, 1, .)
        L.sname = J(0, 1, "")
        L.sq = L.sp = L.st = J(0, 0, .)
        L.cur = ""
    }
    k = _cge_find(L.reg, name)
    if (k & !repl) _cge_fail("cge_region add: region " + name + " exists; use replace", 110)
    if (rows(L.rs)) _cge_fail("cge_region add: the trade between regions is set; add every region before cge_region trade", 198)
    if (!k) {
        L.reg = L.reg \ name
        L.units = L.units \ units
    }
    else L.units[k] = units
    _cge_rg_put(name, M)
    L.cur = name
    _cge_lk_store(L)
    printf("{txt}Region {res}%s{txt}: %f commodities, a unit of its SAM worth {res}%g{txt} world units; %f region(s)\n",
           name, M.nC, units, rows(L.reg))
}

// cge_region select: the model of region name in memory, the one there kept
void _cge_region_select(string scalar name)
{
    struct cge_lk scalar L
    struct cge_model scalar M
    L = _cge_lk_load()
    if (!_cge_find(L.reg, name)) _cge_fail("cge_region: no region " + name, 111)
    _cge_rg_sync()
    M = _cge_rg_get(name)
    _cge_store(M)
    L.cur = name
    _cge_lk_store(L)
    printf("{txt}Region {res}%s{txt} is in memory\n", name)
}

// cge_region trade: the base routes between regions, from the data in
// memory; the routes from and to the rest of the world close each region's
// imports and exports of the commodity at the base
void _cge_region_trade(string scalar ve, string scalar vi, string scalar vc, string scalar vv, string scalar vt,
                       string scalar sigma, string scalar eta)
{
    struct cge_lk scalar L
    struct cge_model scalar M
    string colvector ex, im, co, comm
    real colvector v, t, sel, QMb, QEb, QERb
    real scalar k, r, s, c, i, nR, base, tm0, mv, tv, rowv, rowt
    L = _cge_lk_load()
    if (rows(L.reg) < 2) _cge_fail("cge_region trade: add at least two regions first", 198)
    _cge_rg_sync()
    ex = strtrim(st_sdata(., ve))
    im = strtrim(st_sdata(., vi))
    co = strtrim(st_sdata(., vc))
    v = st_data(., vv)
    t = (vt != "" ? st_data(., vt) : J(rows(v), 1, .))
    if (hasmissing(v) | any(v :< 0)) _cge_fail("cge_region trade: values must be zero or positive", 459)
    // a missing tariff is the importer's average
    if (vt != "") if (any((t :< 0) :& (t :< .))) _cge_fail("cge_region trade: tariffs must be zero or positive", 459)
    nR = rows(L.reg)
    L.rs = L.rr = L.rv = L.rt0 = J(0, 1, .)
    L.rc = J(0, 1, "")
    for (k = 1; k <= rows(v); k++) {
        s = _cge_find(L.reg, ex[k])
        r = _cge_find(L.reg, im[k])
        if (!s) _cge_fail("cge_region trade: exporter " + ex[k] + " is not a region", 111)
        if (!r) _cge_fail("cge_region trade: importer " + im[k] + " is not a region", 111)
        if (s == r) _cge_fail("cge_region trade: " + ex[k] + " to itself", 198)
        if (v[k] == 0) continue
        L.rs = L.rs \ s
        L.rr = L.rr \ r
        L.rc = L.rc \ co[k]
        L.rv = L.rv \ v[k]
        L.rt0 = L.rt0 \ t[k]
    }
    if (!rows(L.rv)) _cge_fail("cge_region trade: no route has trade", 459)
    if (rows(uniqrows((strofreal(L.rs) :+ " " :+ strofreal(L.rr) :+ " " :+ L.rc))) != rows(L.rs)) {
        _cge_fail("cge_region trade: a route is given twice", 459)
    }
    // each commodity in both regions, imported by the importer and exported
    // by the exporter
    for (k = 1; k <= rows(L.rv); k++) {
        M = _cge_rg_get(L.reg[L.rs[k]])
        c = _cge_find(M.C, L.rc[k])
        if (!c) _cge_fail("cge_region trade: " + L.rc[k] + " is not a commodity of " + L.reg[L.rs[k]], 111)
        if (!M.ce[c] & !M.cr[c]) _cge_fail("cge_region trade: " + L.reg[L.rs[k]] + " does not export " + L.rc[k], 459)
        if (M.ced[c]) _cge_fail("cge_region trade: " + L.reg[L.rs[k]] + " has a demand curve for its exports of " + L.rc[k] + " (exportdemand()); linked exports go to the other regions instead", 198)
        M = _cge_rg_get(L.reg[L.rr[k]])
        c = _cge_find(M.C, L.rc[k])
        if (!c) _cge_fail("cge_region trade: " + L.rc[k] + " is not a commodity of " + L.reg[L.rr[k]], 111)
        if (!M.cm[c]) _cge_fail("cge_region trade: " + L.reg[L.rr[k]] + " does not import " + L.rc[k], 459)
    }
    // the routes of the rest of the world: imports from it, at the tariff that
    // gives the importer's average; exports to it
    comm = uniqrows(L.rc)
    for (r = 1; r <= nR; r++) {
        M = _cge_rg_get(L.reg[r])
        for (i = 1; i <= rows(comm); i++) {
            sel = selectindex((L.rr :== r) :& (L.rc :== comm[i]))
            if (rows(sel) & cols(sel)) {
                c = _cge_find(M.C, comm[i])
                QMb = _cge_vn(M, M.x0, "QM")
                base = M.p0.pwm[c] * QMb[c] * L.units[r]
                tm0 = M.p0.tm[c]
                mv = sum(L.rv[sel])
                rowv = base - mv
                if (rowv < -1e-6 * base) {
                    _cge_fail("cge_region trade: " + L.reg[r] + " imports " + _cge_gnum(base) + " world units of " + comm[i] +
                              ", less than the " + _cge_gnum(mv) + " from the other regions", 459)
                }
                rowv = max((0, rowv))
                // tariffs by route: the importer's average where none is given
                for (k = 1; k <= rows(sel); k++) if (L.rt0[sel[k]] >= .) L.rt0[sel[k]] = tm0
                tv = sum(L.rv[sel] :* L.rt0[sel])
                if (rowv > 1e-9 * base) {
                    rowt = (tm0 * base - tv) / rowv
                    if (rowt < -1e-9) {
                        _cge_fail("cge_region trade: the tariffs of " + L.reg[r] + " on " + comm[i] + " from the other regions exceed its average tariff on all imports", 459)
                    }
                    rowt = max((0, rowt))
                    L.rs = L.rs \ 0
                    L.rr = L.rr \ r
                    L.rc = L.rc \ comm[i]
                    L.rv = L.rv \ rowv
                    L.rt0 = L.rt0 \ rowt
                }
                else if (abs(tm0 * base - tv) > 1e-6 * max((1, base))) {
                    _cge_fail("cge_region trade: " + L.reg[r] + " imports all its " + comm[i] + " from the other regions, but the tariffs by route do not give its average tariff", 459)
                }
            }
            sel = selectindex((L.rs :== r) :& (L.rr :> 0) :& (L.rc :== comm[i]))
            if (rows(sel) & cols(sel)) {
                c = _cge_find(M.C, comm[i])
                QEb = _cge_vn(M, M.x0, "QE")
                QERb = _cge_vn(M, M.x0, "QER")
                base = M.p0.pwe[c] * ((M.ce[c] ? QEb[c] : 0) + (M.cr[c] ? QERb[c] : 0)) * L.units[r]
                mv = sum(L.rv[sel])
                rowv = base - mv
                if (rowv < -1e-6 * base) {
                    _cge_fail("cge_region trade: " + L.reg[r] + " exports " + _cge_gnum(base) + " world units of " + comm[i] +
                              ", less than the " + _cge_gnum(mv) + " to the other regions", 459)
                }
                if (rowv > 1e-9 * base) {
                    L.rs = L.rs \ r
                    L.rr = L.rr \ 0
                    L.rc = L.rc \ comm[i]
                    L.rv = L.rv \ rowv
                    L.rt0 = L.rt0 \ 0
                }
            }
        }
    }
    L.rt = L.rt0
    // elasticities by commodity
    L.ec = comm
    L.es = _cge_rg_values(sigma, comm, "sigma()", 4)
    L.eta = _cge_rg_values(eta, comm, "rowelasticity()", .)
    for (i = 1; i <= rows(comm); i++) if (L.eta[i] >= .) L.eta[i] = L.es[i]
    L.pwrow = L.pwrowe = J(rows(comm), 1, 1)
    L.sname = J(0, 1, "")
    L.sq = L.sp = L.st = J(rows(L.rv), 0, .)
    _cge_lk_store(L)
    printf("{txt}Trade between {res}%f{txt} regions in {res}%f{txt} commodit%s: {res}%f{txt} routes, {res}%f{txt} of them with the rest of the world\n",
           nR, rows(comm), (rows(comm) == 1 ? "y" : "ies"), rows(L.rv), sum((L.rs :== 0) :| (L.rr :== 0)))
}

// Values by commodity from "#" or "c:# c:# ...", with a default
real colvector _cge_rg_values(string scalar spec, string colvector comm, string scalar what, real scalar dflt)
{
    real colvector v
    string rowvector tok, pr
    real scalar k, i, x
    v = J(rows(comm), 1, dflt)
    spec = strtrim(spec)
    if (spec == "") return(v)
    if (strtoreal(spec) < .) {
        x = strtoreal(spec)
        if (x < 0) _cge_fail(what + " must be zero or positive", 198)
        return(J(rows(comm), 1, x))
    }
    tok = tokens(spec)
    for (k = 1; k <= cols(tok); k++) {
        pr = tokens(tok[k], ":")
        if (cols(pr) != 3) _cge_fail(what + ": write a number, or commodity:number", 198)
        i = _cge_find(comm, pr[1])
        if (!i) _cge_fail(what + ": " + pr[1] + " is not a commodity traded between the regions", 111)
        x = strtoreal(pr[3])
        if (x >= . | x < 0) _cge_fail(what + ": " + pr[3] + " is not a number, zero or positive", 198)
        v[i] = x
    }
    return(v)
}

// cge_region tariff: the tariffs of routes, set or scaled
void _cge_region_tariff(string scalar from, string scalar to, string scalar comm, real scalar value, real scalar scale)
{
    struct cge_lk scalar L
    real colvector sf, st, sc, sel
    string rowvector f, t, c
    real scalar k
    L = _cge_lk_load()
    if (!rows(L.rv)) _cge_fail("cge_region tariff: set the trade first, with cge_region trade", 198)
    f = tokens(from)
    t = tokens(to)
    c = tokens(comm)
    sf = (cols(f) == 0 | anyof(f, "all") ? J(rows(L.rs), 1, 1) : J(rows(L.rs), 1, 0))
    for (k = 1; k <= cols(f); k++) {
        if (f[k] == "all") continue
        if (f[k] == "rest") sf = sf :| (L.rs :== 0)
        else {
            if (!_cge_find(L.reg, f[k])) _cge_fail("cge_region tariff: from(): " + f[k] + " is not a region or rest", 111)
            sf = sf :| (L.rs :== _cge_find(L.reg, f[k]))
        }
    }
    st = (cols(t) == 0 | anyof(t, "all") ? J(rows(L.rr), 1, 1) : J(rows(L.rr), 1, 0))
    for (k = 1; k <= cols(t); k++) {
        if (t[k] == "all") continue
        if (!_cge_find(L.reg, t[k])) _cge_fail("cge_region tariff: to(): " + t[k] + " is not a region", 111)
        st = st :| (L.rr :== _cge_find(L.reg, t[k]))
    }
    sc = (cols(c) == 0 ? J(rows(L.rc), 1, 1) : J(rows(L.rc), 1, 0))
    for (k = 1; k <= cols(c); k++) {
        if (!anyof(L.rc, c[k])) _cge_fail("cge_region tariff: commodities(): " + c[k] + " is not traded between the regions", 111)
        sc = sc :| (L.rc :== c[k])
    }
    sel = selectindex(sf :& st :& sc :& (L.rr :> 0))
    if (!rows(sel) | !cols(sel)) _cge_fail("cge_region tariff: no route meets from(), to() and commodities()", 459)
    if (value < .) L.rt[sel] = J(rows(sel), 1, value)
    else L.rt[sel] = L.rt[sel] :* scale
    if (any(L.rt[sel] :< 0)) _cge_fail("cge_region tariff: tariffs must be zero or positive", 198)
    _cge_lk_store(L)
    printf("{txt}Tariffs changed on {res}%f{txt} route(s)\n", rows(sel))
}

// cge_region world: the rest of the world's prices of a commodity, relative
// to the base: its export price, and the price that shifts its demand
void _cge_region_world(string scalar comm, real scalar pim, real scalar pex, real scalar reset)
{
    struct cge_lk scalar L
    string rowvector c
    real colvector sel
    real scalar k
    L = _cge_lk_load()
    if (!rows(L.ec)) _cge_fail("cge_region world: set the trade first, with cge_region trade", 198)
    if (reset) {
        L.pwrow = L.pwrowe = J(rows(L.ec), 1, 1)
        L.rt = L.rt0
        _cge_lk_store(L)
        printf("{txt}Tariffs by route and the prices of the rest of the world at the base\n")
        return
    }
    c = tokens(comm)
    sel = (cols(c) == 0 ? J(rows(L.ec), 1, 1) : J(rows(L.ec), 1, 0))
    for (k = 1; k <= cols(c); k++) {
        if (!anyof(L.ec, c[k])) _cge_fail("cge_region world: " + c[k] + " is not traded between the regions", 111)
        sel = sel :| (L.ec :== c[k])
    }
    if (pim < .) L.pwrow = L.pwrow :* (1 :- sel) + sel :* pim
    if (pex < .) L.pwrowe = L.pwrowe :* (1 :- sel) + sel :* pex
    _cge_lk_store(L)
}

// The linked system: pointers to the models of the regions (their
// externals, which are not copied) and to their full systems; the import and
// export pairs of the regions, each with its link variables; the route of
// each pair
struct cge_lw {
    pointer(struct cge_model scalar) rowvector PM
    pointer(struct cge_sys scalar) rowvector   PS
    real colvector nf, zoff
    // import pairs: region, commodity (in L.ec), its position in the region,
    // link variables pwm and tm, position of QM in x, base value of imports
    // (world units), base average tariff, base imports QM
    real matrix    ip
    // export pairs: region, commodity, position, link variable pwe,
    // positions of QE and QER in x (0 when the region has none), base value
    // of exports, base supply (QE + QER)
    real matrix    xp
    // for each route, its import pair and its export pair (0 for the rest of
    // the world)
    real colvector ki, kx
    real scalar    nz, nu
}

// The linked system of the regions and their trade
void _cge_lk_setup(struct cge_lk scalar L, struct cge_lw scalar W)
{
    struct cge_model scalar M
    real colvector PQM, PQE, PQER, x0M, x0E, x0R
    real scalar R, r, e, c, k, ni, nx, i
    R = rows(L.reg)
    W.PM = J(1, R, NULL)
    W.PS = J(1, R, NULL)
    W.nf = J(R, 1, .)
    for (r = 1; r <= R; r++) {
        W.PM[r] = findexternal("cge__rg_" + L.reg[r])
        if (W.PM[r] == NULL) _cge_fail("cge_region: no model for region " + L.reg[r], 3498)
        W.PS[r] = &(_cge_sys_make(*W.PM[r], 0))
        if (rows(W.PS[r]->free) != W.PS[r]->neq) {
            _cge_fail("cge_region: the system of region " + L.reg[r] + " is not square: " + strofreal(rows(W.PS[r]->free)) +
                      " free variables, " + strofreal(W.PS[r]->neq) + " equations", 459)
        }
        W.nf[r] = rows(W.PS[r]->free)
    }
    W.zoff = runningsum(W.nf) - W.nf
    W.nz = sum(W.nf)
    // import pairs, then export pairs
    W.ip = J(0, 9, .)
    W.xp = J(0, 8, .)
    for (r = 1; r <= R; r++) {
        M = *W.PM[r]
        PQM = _cge_vpos(M, _cge_vidx(M, "QM"))
        PQE = _cge_vpos(M, _cge_vidx(M, "QE"))
        PQER = _cge_vpos(M, _cge_vidx(M, "QER"))
        x0M = _cge_vn(M, M.x0, "QM")
        x0E = _cge_vn(M, M.x0, "QE")
        x0R = _cge_vn(M, M.x0, "QER")
        for (e = 1; e <= rows(L.ec); e++) {
            c = _cge_find(M.C, L.ec[e])
            if (!c) continue
            if (any((L.rr :== r) :& (L.rc :== L.ec[e]))) {
                W.ip = W.ip \ (r, e, c, ., ., PQM[c], M.p0.pwm[c] * x0M[c] * L.units[r], M.p0.tm[c], x0M[c])
            }
            if (any((L.rs :== r) :& (L.rr :> 0) :& (L.rc :== L.ec[e]))) {
                W.xp = W.xp \ (r, e, c, ., (M.ce[c] ? PQE[c] : 0), (M.cr[c] ? PQER[c] : 0),
                               M.p0.pwe[c] * ((M.ce[c] ? x0E[c] : 0) + (M.cr[c] ? x0R[c] : 0)) * L.units[r],
                               (M.ce[c] ? x0E[c] : 0) + (M.cr[c] ? x0R[c] : 0))
            }
        }
    }
    ni = rows(W.ip)
    nx = rows(W.xp)
    if (ni) {
        W.ip[., 4] = (1::ni) :* 2 :- 1
        W.ip[., 5] = (1::ni) :* 2
    }
    if (nx) W.xp[., 4] = 2 * ni :+ (1::nx)
    W.nu = 2 * ni + nx
    // the pairs of each route
    W.ki = W.kx = J(rows(L.rv), 1, 0)
    for (k = 1; k <= rows(L.rv); k++) {
        e = _cge_find(L.ec, L.rc[k])
        for (i = 1; i <= ni; i++) if (W.ip[i, 1] == L.rr[k] & W.ip[i, 2] == e) W.ki[k] = i
        for (i = 1; i <= nx; i++) if (W.xp[i, 1] == L.rs[k] & W.xp[i, 2] == e) W.kx[k] = i
    }
}

// The parameters of region r with the link variables ul: its world prices,
// relative to the base, and average tariffs of the commodities it trades
// with the other regions
struct cge_par scalar _cge_lk_par(struct cge_model scalar M, struct cge_lw scalar W, real scalar r, real colvector ul)
{
    struct cge_par scalar p
    real scalar i, c
    p = M.p
    for (i = 1; i <= rows(W.ip); i++) {
        if (W.ip[i, 1] != r) continue
        c = W.ip[i, 3]
        p.pwm[c] = M.p0.pwm[c] * ul[W.ip[i, 4]]
        p.tm[c] = ul[W.ip[i, 5]]
    }
    for (i = 1; i <= rows(W.xp); i++) {
        if (W.xp[i, 1] != r) continue
        c = W.xp[i, 3]
        p.pwe[c] = M.p0.pwe[c] * ul[W.xp[i, 4]]
    }
    if (rows(M.bY)) p.bxbar = M.xcur[M.bX]
    return(p)
}

// The routes at link variables ul and quantities g (the imports of each
// import pair, then the supply of exports, QE + QER, of each export pair):
// the world price of each route relative to the base (pr) and its quantity
// in world units at base prices (q); the price index of the imports of each
// import pair (P)
void _cge_lk_routes(struct cge_lk scalar L, struct cge_lw scalar W, real colvector ul, real colvector g,
                    real colvector pr, real colvector q, real colvector P)
{
    real colvector sel, x, th
    real scalar k, i, e, s, ni
    ni = rows(W.ip)
    pr = q = J(rows(L.rv), 1, .)
    P = J(ni, 1, .)
    // prices: of a region's exports, or of the rest of the world
    for (k = 1; k <= rows(L.rv); k++) {
        e = _cge_find(L.ec, L.rc[k])
        pr[k] = (W.kx[k] ? ul[W.xp[W.kx[k], 4]] : L.pwrow[e])
    }
    // imports of each pair: a CES of its routes at prices with tariffs
    for (i = 1; i <= ni; i++) {
        sel = selectindex(W.ki :== i)
        e = W.ip[i, 2]
        s = L.es[e]
        x = pr[sel] :* (1 :+ L.rt[sel]) :/ (1 :+ L.rt0[sel])
        th = L.rv[sel] :* (1 :+ L.rt0[sel])
        th = th / sum(th)
        if (s == 1) P[i] = exp(sum(th :* ln(x)))
        else P[i] = sum(th :* x :^ (1 - s)) ^ (1 / (1 - s))
        q[sel] = L.rv[sel] :* (g[i] / W.ip[i, 9]) :* (P[i] :/ x) :^ s
    }
    // exports to the rest of the world, along its demand curve
    for (k = 1; k <= rows(L.rv); k++) {
        if (L.rr[k] != 0) continue
        e = _cge_find(L.ec, L.rc[k])
        q[k] = L.rv[k] * (pr[k] / L.pwrowe[e]) ^ (-L.eta[e])
    }
}

// The link equations, scaled: for each import pair, its world price and
// average tariff against the price index of its routes (L1), and its tariff
// revenue against that of its routes (L2); for each export pair, its supply
// against the routes from it (L3)
real colvector _cge_lk_eqs(struct cge_lk scalar L, struct cge_lw scalar W, real colvector ul, real colvector g)
{
    real colvector pr, q, P, out, sel
    real scalar i, j, ni, nx, pwm, tm, tm0, B, R
    ni = rows(W.ip)
    nx = rows(W.xp)
    _cge_lk_routes(L, W, ul, g, pr, q, P)
    out = J(2 * ni + nx, 1, .)
    for (i = 1; i <= ni; i++) {
        pwm = ul[W.ip[i, 4]]
        tm = ul[W.ip[i, 5]]
        tm0 = W.ip[i, 8]
        B = W.ip[i, 7]
        sel = selectindex(W.ki :== i)
        R = g[i] / W.ip[i, 9]
        out[2 * i - 1] = (pwm * (1 + tm) - (1 + tm0) * P[i]) / (1 + tm0)
        out[2 * i] = (tm * pwm * B * R - sum(L.rt[sel] :* pr[sel] :* q[sel])) / B
    }
    for (j = 1; j <= nx; j++) {
        sel = selectindex(W.kx :== j)
        B = W.xp[j, 7]
        out[2 * ni + j] = (g[ni + j] / W.xp[j, 8] * B - sum(q[sel])) / B
    }
    return(out)
}

// The quantities the link equations take from the solutions of the regions:
// the imports of each import pair, then the supply of exports of each export
// pair
real colvector _cge_lk_g(struct cge_lw scalar W, real colvector u)
{
    real colvector g, x
    real scalar i, j, r, ni, nx
    ni = rows(W.ip)
    nx = rows(W.xp)
    g = J(ni + nx, 1, .)
    for (r = 1; r <= rows(W.nf); r++) {
        x = W.PM[r]->xcur
        x[W.PS[r]->free] = u[|W.zoff[r] + 1 \ W.zoff[r] + W.nf[r]|] :* W.PM[r]->xscale[W.PS[r]->free]
        for (i = 1; i <= ni; i++) if (W.ip[i, 1] == r) g[i] = x[W.ip[i, 6]]
        for (j = 1; j <= nx; j++) {
            if (W.xp[j, 1] != r) continue
            g[ni + j] = (W.xp[j, 5] ? x[W.xp[j, 5]] : 0) + (W.xp[j, 6] ? x[W.xp[j, 6]] : 0)
        }
    }
    return(g)
}

// The residuals of the linked system at u: each region's full system, then
// the link equations
real colvector _cge_lk_resid(struct cge_lk scalar L, struct cge_lw scalar W, real colvector u)
{
    struct cge_par scalar p
    real colvector R, f, ul
    real scalar r
    R = J(W.nz + W.nu, 1, .)
    ul = (W.nu ? u[|W.nz + 1 \ W.nz + W.nu|] : J(0, 1, .))
    for (r = 1; r <= rows(W.nf); r++) {
        p = _cge_lk_par(*W.PM[r], W, r, ul)
        f = _cge_F(*W.PM[r], p, W.PM[r]->xcur, *W.PS[r], u[|W.zoff[r] + 1 \ W.zoff[r] + W.nf[r]|])
        if (hasmissing(f)) return(R)
        R[|W.zoff[r] + 1 \ W.zoff[r] + W.nf[r]|] = f
    }
    if (W.nu) R[|W.nz + 1 \ W.nz + W.nu|] = _cge_lk_eqs(L, W, ul, _cge_lk_g(W, u))
    return(R)
}

// The entries of the Jacobian of the linked system at u: each region's exact
// Jacobian; central differences for the link variables in the regions'
// equations, and for the link equations
real scalar _cge_lk_jac(struct cge_lk scalar L, struct cge_lw scalar W, real colvector u, real colvector ri,
                        real colvector ci, real colvector v)
{
    struct cge_trip scalar T
    struct cge_par scalar p
    real colvector ul, z, r, c, w, fp, fm, d, sel, g, gp, gm, up, um, ks, fidx
    real scalar R, rr, k, h, ni, nx, j, col, pos, nr, m
    R = rows(W.nf)
    ni = rows(W.ip)
    nx = rows(W.xp)
    ul = (W.nu ? u[|W.nz + 1 \ W.nz + W.nu|] : J(0, 1, .))
    _cge_tinit(T)
    for (rr = 1; rr <= R; rr++) {
        z = u[|W.zoff[rr] + 1 \ W.zoff[rr] + W.nf[rr]|]
        p = _cge_lk_par(*W.PM[rr], W, rr, ul)
        if (!_cge_jac_trip(*W.PM[rr], p, W.PM[rr]->xcur, *W.PS[rr], z, r, c, w)) return(0)
        _cge_tadd(T, W.zoff[rr] :+ r, W.zoff[rr] :+ c, w)
        // the link variables of the region
        ks = J(0, 1, .)
        for (k = 1; k <= ni; k++) if (W.ip[k, 1] == rr) ks = ks \ W.ip[k, 4] \ W.ip[k, 5]
        for (k = 1; k <= nx; k++) if (W.xp[k, 1] == rr) ks = ks \ W.xp[k, 4]
        for (k = 1; k <= rows(ks); k++) {
            h = 1e-6 * max((1, abs(ul[ks[k]])))
            up = um = ul
            up[ks[k]] = ul[ks[k]] + h
            um[ks[k]] = ul[ks[k]] - h
            fp = _cge_F(*W.PM[rr], _cge_lk_par(*W.PM[rr], W, rr, up), W.PM[rr]->xcur, *W.PS[rr], z)
            fm = _cge_F(*W.PM[rr], _cge_lk_par(*W.PM[rr], W, rr, um), W.PM[rr]->xcur, *W.PS[rr], z)
            if (hasmissing(fp) | hasmissing(fm)) return(0)
            d = (fp - fm) / (2 * h)
            sel = selectindex(d :!= 0)
            if (rows(sel) & cols(sel)) _cge_tadd(T, W.zoff[rr] :+ sel, J(rows(sel), 1, W.nz + ks[k]), d[sel])
        }
    }
    if (W.nu) {
        g = _cge_lk_g(W, u)
        nr = W.nz
        // with respect to the link variables
        for (k = 1; k <= W.nu; k++) {
            h = 1e-6 * max((1, abs(ul[k])))
            up = um = ul
            up[k] = ul[k] + h
            um[k] = ul[k] - h
            d = (_cge_lk_eqs(L, W, up, g) - _cge_lk_eqs(L, W, um, g)) / (2 * h)
            sel = selectindex(d :!= 0)
            if (rows(sel) & cols(sel)) _cge_tadd(T, nr :+ sel, J(rows(sel), 1, W.nz + k), d[sel])
        }
        // with respect to the quantities from the regions
        for (j = 1; j <= rows(g); j++) {
            h = 1e-6 * max((1, abs(g[j])))
            gp = gm = g
            gp[j] = g[j] + h
            gm[j] = g[j] - h
            d = (_cge_lk_eqs(L, W, ul, gp) - _cge_lk_eqs(L, W, ul, gm)) / (2 * h)
            sel = selectindex(d :!= 0)
            if (!rows(sel) | !cols(sel)) continue
            // the positions in x of quantity j, and their columns
            if (j <= ni) {
                rr = W.ip[j, 1]
                pos = W.ip[j, 6]
            }
            else {
                rr = W.xp[j - ni, 1]
                pos = (W.xp[j - ni, 5], W.xp[j - ni, 6])'
                pos = select(pos, pos :> 0)
            }
            fidx = J(rows(W.PM[rr]->x0), 1, 0)
            fidx[W.PS[rr]->free] = (1::W.nf[rr])
            for (m = 1; m <= rows(pos); m++) {
                col = fidx[pos[m]]
                if (!col) continue
                _cge_tadd(T, nr :+ sel, J(rows(sel), 1, W.zoff[rr] + col), d[sel] :* W.PM[rr]->xscale[pos[m]])
            }
        }
    }
    ri = (T.n ? T.r[|1 \ T.n|] : J(0, 1, .))
    ci = (T.n ? T.c[|1 \ T.n|] : J(0, 1, .))
    v = (T.n ? T.v[|1 \ T.n|] : J(0, 1, .))
    return(!hasmissing(v))
}

// Newton's method on the linked system, with a line search and the sparse LU
real scalar _cge_lk_newton(struct cge_lk scalar L, struct cge_lw scalar W, real colvector u, real scalar tol,
                           real scalar maxit, real scalar iter, real scalar err)
{
    struct cge_slu scalar SF
    real colvector R, Rn, du, un, ri, ci, v
    real scalar it, step, n0
    _cge_slu_load(SF, "cge__slu_reg")
    R = _cge_lk_resid(L, W, u)
    iter = 0
    err = .
    if (hasmissing(R)) return(0)
    for (it = 0; it <= maxit; it++) {
        err = max(abs(R))
        iter = it
        printf("{txt}Iteration %f: largest scaled residual = {res}%9.3e\n", it, err)
        displayflush()
        if (err < tol) return(1)
        if (it == maxit) break
        if (!_cge_lk_jac(L, W, u, ri, ci, v)) return(0)
        if (!_cge_slu_update(SF, ri, ci, v, rows(u), "cge__slu_reg")) return(0)
        du = _cge_slu_solve(SF, -R)
        if (hasmissing(du)) return(0)
        n0 = norm(R)
        for (step = 1; step >= 1e-8; step = step / 2) {
            un = u + step * du
            Rn = _cge_lk_resid(L, W, un)
            if (!hasmissing(Rn)) if (norm(Rn) <= (1 - 1e-4 * step) * n0) break
        }
        if (step < 1e-8) return(0)
        u = un
        R = Rn
    }
    return(0)
}

// cge_region solve: the regions solved together, each stored as simulation
// name in its own model, with the routes in the links
void _cge_region_solve(string scalar name, real scalar tol, real scalar maxit, string scalar start)
{
    struct cge_lk scalar L
    struct cge_lw scalar W
    struct cge_model scalar M
    struct cge_par scalar p, pkeep
    pointer(struct cge_model scalar) scalar pm
    real colvector u, ul, x, pr, q, P, xr
    real scalar r, i, conv, iter, err, it2, e2, kk, R, c, cv, j
    string scalar method
    L = _cge_lk_load()
    if (!rows(L.rv)) _cge_fail("cge_region solve: set the trade first, with cge_region trade", 198)
    if (!anyof(("", "base", "alone"), start)) _cge_fail("cge_region solve: start() is base or alone", 198)
    _cge_rg_sync()
    _cge_lk_setup(L, W)
    R = rows(L.reg)
    // the linked commodities: their world prices and tariffs are set by the
    // links, not shocked in the regions
    for (i = 1; i <= rows(W.ip); i++) {
        pm = W.PM[W.ip[i, 1]]
        c = W.ip[i, 3]
        if (pm->p.pwm[c] != pm->p0.pwm[c] | pm->p.tm[c] != pm->p0.tm[c]) {
            _cge_fail("cge_region solve: in " + L.reg[W.ip[i, 1]] + ", pwm or tm of " + L.ec[W.ip[i, 2]] + " is shocked; the links set them: use cge_region tariff or cge_region world", 198)
        }
    }
    for (i = 1; i <= rows(W.xp); i++) {
        pm = W.PM[W.xp[i, 1]]
        c = W.xp[i, 3]
        if (pm->p.pwe[c] != pm->p0.pwe[c]) {
            _cge_fail("cge_region solve: in " + L.reg[W.xp[i, 1]] + ", pwe of " + L.ec[W.xp[i, 2]] + " is shocked; the links set it: use cge_region world", 198)
        }
    }
    printf("{txt}Linked regions: {res}%f{txt} regions of {res}%s{txt} equations and {res}%f{txt} link variables, {res}%f{txt} equations in all\n",
           R, invtokens(strofreal(W.nf')), W.nu, W.nz + W.nu)
    // the start: the base, or each region solved alone at the base links
    u = J(W.nz + W.nu, 1, .)
    ul = J(W.nu, 1, 1)
    for (i = 1; i <= rows(W.ip); i++) ul[W.ip[i, 5]] = W.ip[i, 8]
    for (r = 1; r <= R; r++) {
        M = *W.PM[r]
        x = M.x0
        if (start == "alone") {
            p = _cge_lk_par(M, W, r, ul)
            xr = _cge_solve_point(M, p, M.xcur, M.x0, tol, maxit, 0, cv, it2, e2, method)
            if (cv) x = xr
        }
        u[|W.zoff[r] + 1 \ W.zoff[r] + W.nf[r]|] = x[W.PS[r]->free] :/ M.xscale[W.PS[r]->free]
    }
    if (W.nu) u[|W.nz + 1 \ W.nz + W.nu|] = ul
    conv = _cge_lk_newton(L, W, u, tol, maxit, iter, err)
    if (!conv) _cge_fail("cge_region solve: the linked regions did not converge (largest scaled residual " + strofreal(err, "%9.3e") + ")", 430)
    // each region's solution, with its link variables, in its own model
    ul = (W.nu ? u[|W.nz + 1 \ W.nz + W.nu|] : J(0, 1, .))
    for (r = 1; r <= R; r++) {
        M = _cge_rg_get(L.reg[r])
        pkeep = M.p
        p = _cge_lk_par(M, W, r, ul)
        x = M.xcur
        x[W.PS[r]->free] = u[|W.zoff[r] + 1 \ W.zoff[r] + W.nf[r]|] :* M.xscale[W.PS[r]->free]
        err = _cge_maxres(M, p, x)
        M.p = p
        kk = _cge_store_sim(M, name, x, 1, iter, err, "linked")
        // the model keeps its own parameters, the simulation those with the
        // link variables: through the external, so that they are not shared
        _cge_rg_put(L.reg[r], M)
        M = _cge_rg_get(L.reg[r])
        M.p = pkeep
        _cge_rg_put(L.reg[r], M)
        printf("{txt}Region {res}%s{txt}: largest scaled residual {res}%9.2e\n", L.reg[r], err)
    }
    // the routes
    _cge_lk_routes(L, W, ul, _cge_lk_g(W, u), pr, q, P)
    j = _cge_find(L.sname, name)
    if (!j) {
        L.sname = L.sname \ name
        L.sq = L.sq, q
        L.sp = L.sp, pr
        L.st = L.st, L.rt
        j = rows(L.sname)
    }
    else {
        L.sq[., j] = q
        L.sp[., j] = pr
        L.st[., j] = L.rt
    }
    _cge_lk_store(L)
    // the region in memory, with the new simulation
    if (L.cur != "") _cge_store(_cge_rg_get(L.cur))
    printf("{txt}Solved together in {res}%f{txt} iteration(s); simulation {res}%s{txt} stored in each region\n", iter, name)
    st_numscalar("r(iterations)", iter)
    st_numscalar("r(N_regions)", R)
    st_numscalar("r(N_links)", W.nu)
    st_global("r(name)", name)
}

// cge_region results: the routes of a linked solution as data: exporter,
// importer ("rest" for the rest of the world), commodity, base value and
// tariff, and the solution's quantity (world units at base prices), world
// price relative to the base, value and tariff
void _cge_region_results(string scalar sim)
{
    struct cge_lk scalar L
    real scalar j, n, k
    string colvector ex, im
    L = _cge_lk_load()
    j = _cge_find(L.sname, sim)
    if (!j) _cge_fail("cge_region results: no linked solution " + sim, 111)
    n = rows(L.rv)
    ex = im = J(n, 1, "")
    for (k = 1; k <= n; k++) {
        ex[k] = (L.rs[k] ? L.reg[L.rs[k]] : "rest")
        im[k] = (L.rr[k] ? L.reg[L.rr[k]] : "rest")
    }
    st_dropvar(.)
    st_addobs(n)
    (void) st_addvar("str16", "exporter")
    (void) st_addvar("str16", "importer")
    (void) st_addvar("str" + strofreal(max((1, max(strlen(L.rc))))), "commodity")
    (void) st_addvar("double", ("base", "tariff_base", "quantity", "price", "value", "tariff"))
    st_sstore(., "exporter", ex)
    st_sstore(., "importer", im)
    st_sstore(., "commodity", L.rc)
    st_store(., ("base", "tariff_base", "quantity", "price", "value", "tariff"),
             (L.rv, L.rt0, L.sq[., j], L.sp[., j], L.sq[., j] :* L.sp[., j], L.st[., j]))
    st_global("r(sim)", sim)
    st_numscalar("r(N_routes)", n)
}

// cge_region list: the regions, the trade between them and the linked
// solutions
void _cge_region_list()
{
    struct cge_lk scalar L
    struct cge_model scalar M
    real scalar r, e
    L = _cge_lk_load()
    _cge_rg_sync()
    printf("{txt}{hline 60}\n")
    printf("{txt}%-16s %12s %12s %12s\n", "Region", "Commodities", "Equations", "Unit (world)")
    for (r = 1; r <= rows(L.reg); r++) {
        M = _cge_rg_get(L.reg[r])
        printf("{res}%-16s {res}%12.0f %12.0f %12.6g%s\n", L.reg[r], M.nC, M.neq, L.units[r], (L.reg[r] == L.cur ? "  (in memory)" : ""))
    }
    printf("{txt}{hline 60}\n")
    if (rows(L.rv)) {
        printf("{txt}%f route(s) in %f commodit%s; elasticities among sources and of the rest of the world's demand:\n",
               rows(L.rv), rows(L.ec), (rows(L.ec) == 1 ? "y" : "ies"))
        for (e = 1; e <= rows(L.ec); e++) printf("{txt}  %-14s {res}%6.3g %6.3g\n", L.ec[e], L.es[e], L.eta[e])
    }
    else printf("{txt}No trade between the regions: cge_region trade\n")
    if (rows(L.sname)) printf("{txt}Linked solutions: {res}%s\n", invtokens(L.sname'))
    st_global("r(regions)", invtokens(L.reg'))
    st_global("r(current)", L.cur)
    st_numscalar("r(N_regions)", rows(L.reg))
    st_numscalar("r(N_routes)", rows(L.rv))
}

// cge_region clear: the regions dropped; the model in memory stays
void _cge_region_clear()
{
    struct cge_lk scalar L
    real scalar r
    if (findexternal("cge__lk") == NULL) return
    L = _cge_lk_load()
    for (r = 1; r <= rows(L.reg); r++) if (findexternal("cge__rg_" + L.reg[r]) != NULL) rmexternal("cge__rg_" + L.reg[r])
    rmexternal("cge__lk")
    if (findexternal("cge__slu_reg") != NULL) rmexternal("cge__slu_reg")
    printf("{txt}Regions cleared; the model in memory stays\n")
}

// Keep only the stored simulations s, in that order (from version 0.6.4)
void _cge_sims_keep(struct cge_model scalar M, real colvector s)
{
    struct cge_par rowvector sp
    real scalar j
    sp = cge_par(1, rows(s))
    for (j = 1; j <= rows(s); j++) sp[j] = M.simp[s[j]]
    M.simp = sp
    if (rows(s) == 0) {
        M.simname = M.simclosure = M.simmethod = M.simrun = M.simcons = M.simobj = J(0, 1, "")
        M.simconv = M.simiter = M.simres = M.simper = M.simlam = J(0, 1, .)
        M.simx = J(rows(M.simx), 0, .)
        M.simstat = J(0, 2, .)
        M.simmodel = J(0, 1, "")
        return
    }
    M.simname = M.simname[s]
    M.simclosure = M.simclosure[s]
    M.simmethod = M.simmethod[s]
    M.simx = M.simx[., s']
    M.simconv = M.simconv[s]
    M.simiter = M.simiter[s]
    M.simres = M.simres[s]
    M.simrun = M.simrun[s]
    M.simper = M.simper[s]
    M.simlam = M.simlam[s]
    M.simcons = M.simcons[s]
    // the objectives of nonlinear programmes (from version 0.15.0)
    if (rows(M.simobj) < max(s)) M.simobj = M.simobj \ J(max(s) - rows(M.simobj), 1, "")
    M.simobj = M.simobj[s]
    // the statuses (from version 0.16.0)
    if (cols(M.simstat) != 2) M.simstat = J(0, 2, .)
    if (rows(M.simstat) < max(s)) M.simstat = M.simstat \ J(max(s) - rows(M.simstat), 2, .)
    M.simstat = M.simstat[s, .]
    // the named models (from version 0.17.0)
    if (rows(M.simmodel) < max(s)) M.simmodel = M.simmodel \ J(max(s) - rows(M.simmodel), 1, "")
    M.simmodel = M.simmodel[s]
}

// Names of the simulations of a dynamic run, in period order
string colvector _cge_run_sims(struct cge_model scalar M, string scalar run)
{
    real colvector s
    s = select((1::rows(M.simname)), M.simrun :== run)
    if (rows(s) == 0) _cge_fail("no dynamic run named " + run, 111)
    s = s[order(M.simper[s], 1)]
    return(M.simname[s])
}

void _cge_run_sims_local(string scalar run, string scalar lname, | real scalar isloop)
{
    struct cge_model scalar M
    M = _cge_load()
    // the scenarios of loop run (from version 0.9.9)
    if (args() > 2) if (isloop) {
        st_local(lname, invtokens(M.simname[_cge_gams_periods(M, run, 1)]'))
        return
    }
    st_local(lname, invtokens(_cge_run_sims(M, run)'))
}

// The results of a dynamic run as a dataset: one observation per period and
// variable element, with the base, the value and, given a baseline run, the
// baseline's value in the same period and the per cent difference from it
void _cge_dyn_data(string scalar run, string scalar baseline)
{
    struct cge_model scalar M
    string colvector sims, bsims, v, e1, e2, l1, l2
    real colvector per, base, value, bval, pos, keep, s, b
    real scalar j, k, n
    M = _cge_load()
    _cge_need(M, "sam")
    sims = _cge_run_sims(M, run)
    if (baseline != "") bsims = _cge_run_sims(M, baseline)
    v = J(0, 1, "")
    e1 = v
    e2 = v
    per = J(0, 1, .)
    base = per
    value = per
    bval = per
    for (j = 1; j <= rows(sims); j++) {
        s = _cge_sim_index(M, sims[j])
        b = .
        if (baseline != "") {
            b = select((1::rows(M.simname)), (M.simrun :== baseline) :* (M.simper :== M.simper[s]))
            if (rows(b) != 1) _cge_fail("baseline(): run " + baseline + " has no period " + strofreal(M.simper[s]), 111)
        }
        for (k = 1; k <= rows(M.vname); k++) {
            _cge_vlabels(M, k, l1, l2)
            pos = _cge_vpos(M, k)
            keep = M.exists[pos]
            if (!any(keep)) continue
            n = sum(keep)
            v = v \ J(n, 1, M.vname[k])
            e1 = e1 \ select(l1, keep)
            e2 = e2 \ select(l2, keep)
            per = per \ J(n, 1, M.simper[s])
            base = base \ select(M.x0[pos], keep)
            value = value \ select(M.simx[pos, s], keep)
            if (baseline != "") bval = bval \ select(M.simx[pos, b], keep)
        }
    }
    st_addobs(rows(v))
    (void) st_addvar("double", "period")
    (void) st_addvar("str32", "variable")
    (void) st_addvar("str32", "element1")
    (void) st_addvar("str32", "element2")
    (void) st_addvar("double", ("base", "value"))
    st_store(., "period", per)
    st_sstore(., "variable", v)
    st_sstore(., "element1", e1)
    st_sstore(., "element2", e2)
    st_store(., "base", base)
    st_store(., "value", value)
    st_varlabel("period", "Period")
    st_varlabel("variable", "Model variable")
    st_varlabel("element1", "First set element")
    st_varlabel("element2", "Second set element")
    st_varlabel("base", "Base value (calibrated SAM)")
    st_varlabel("value", "Value in the period")
    if (baseline != "") {
        (void) st_addvar("double", ("baseline", "dev_pct"))
        st_store(., "baseline", bval)
        st_store(., "dev_pct", 100 :* (value - bval) :/ abs(bval) :/ (bval :!= 0))
        st_varlabel("baseline", "Baseline value in the period")
        st_varlabel("dev_pct", "Per cent difference from the baseline")
    }
}

// =====================================================================
// Sensitivity analysis (from version 0.2.1)
// =====================================================================

// State of a sensitivity analysis while cge_sensitivity runs
struct cge_sens {
    string rowvector calargs, vary
    string scalar    ext, gov, si, num
    string colvector fac
    real colvector   cva, cq, ct, ca
    real matrix      dva, dq, dt, da, pct, val
    real colvector   conv
    string matrix    keys
    real colvector   base
    // the draws kept as simulations (from version 0.8.3)
    string scalar    keep
    real matrix      kx
    real colvector   kd
    pointer(struct cge_par scalar) rowvector kp
}

// A pointer to a copy of a parameter structure
pointer(struct cge_par scalar) scalar _cge_par_ptr(struct cge_par scalar q)
{
    struct cge_par scalar c
    c = q
    return(&c)
}

struct cge_sens scalar _cge_sens_load()
{
    pointer() scalar q
    q = findexternal("cge__sens")
    if (q == NULL) _cge_fail("cge internal error: no sensitivity analysis in progress", 3498)
    return(*q)
}

void _cge_sens_store(struct cge_sens scalar G)
{
    pointer() scalar q
    if ((q = findexternal("cge__sens")) == NULL) q = crexternal("cge__sens")
    *q = G
}

// Multiplicative factors around one: uniform on [1 - s, 1 + s], or symmetric
// triangular on the same interval; one column per draw. With `common`, the
// same factor applies to every element.
real matrix _cge_sens_factors(real scalar n, real scalar draws, real scalar s, string scalar dist,
                              real scalar common)
{
    real scalar m
    real matrix u
    m = (common ? 1 : n)
    if (dist == "triangular") u = runiform(m, draws) + runiform(m, draws) :- 1
    else u = 2 :* runiform(m, draws) :- 1
    u = 1 :+ s :* u
    if (common) return(J(n, 1, 1) * u)
    return(u)
}

void _cge_sens_init(real scalar draws, real scalar seed, real scalar spread, string scalar dist,
                    string scalar vary, real scalar common, | string scalar keep)
{
    struct cge_model scalar M
    struct cge_sens scalar G
    string rowvector v
    real scalar k

    M = _cge_load()
    _cge_need(M, "sam")
    _cge_need(M, "calibrated")
    if (cols(M.calargs) < 10) _cge_fail("calibrate the model again: this model does not record its calibration", 459)
    if (spread < 0 | spread >= 1) _cge_fail("spread() must be at least 0 and less than 1", 198)
    if (dist != "uniform" & dist != "triangular") _cge_fail("distribution() must be uniform or triangular", 198)
    v = (vary == "" ? ("va", "q", "t") : tokens(vary))
    for (k = 1; k <= cols(v); k++) {
        if (!anyof(("va", "q", "t", "a"), v[k])) _cge_fail("vary(): " + v[k] + " is not one of va, q, t and a", 198)
    }
    G.vary = v
    G.calargs = M.calargs
    G.ext = M.c_ext
    G.gov = M.c_gov
    G.si = M.c_si
    G.num = M.c_num
    G.fac = M.c_fac
    G.cva = M.p0.sva
    G.cq = M.p0.sq
    G.ct = M.p0.st
    G.ca = M.p0.sa
    rseed(seed)
    // Draws in a fixed order (va, q, t, a), so a seed gives the same draws
    // whatever is varied
    G.dva = _cge_sens_factors(M.n, draws, spread, dist, common)
    G.dq = _cge_sens_factors(M.nC, draws, spread, dist, common)
    G.dt = _cge_sens_factors(M.nC, draws, spread, dist, common)
    G.da = _cge_sens_factors(M.n, draws, spread, dist, common)
    if (!anyof(v, "va")) G.dva = J(M.n, draws, 1)
    if (!anyof(v, "q")) G.dq = J(M.nC, draws, 1)
    if (!anyof(v, "t")) G.dt = J(M.nC, draws, 1)
    if (!anyof(v, "a")) G.da = J(M.n, draws, 1)
    G.conv = J(draws + 1, 1, 0)
    G.keys = J(0, 3, "")
    G.keep = (args() < 7 ? "" : keep)
    G.kx = J(rows(M.x0), 0, .)
    G.kd = J(0, 1, .)
    G.kp = J(1, 0, NULL)
    _cge_sens_store(G)
}

string scalar _cge_numlist(real colvector v)
{
    return(invtokens(strofreal(v', "%21.17g")))
}

// Elasticities of draw d (0: the central values)
void _cge_sens_values(struct cge_sens scalar G, real scalar d, real colvector va, real colvector q,
                      real colvector t, real colvector a)
{
    va = G.cva
    q = G.cq
    t = G.ct
    a = G.ca
    if (d > 0) {
        va = va :* G.dva[., d]
        q = q :* G.dq[., d]
        t = t :* G.dt[., d]
        a = a :* G.da[., d]
    }
}

// Calibrate with the elasticities of draw d, then restore the closure
void _cge_sens_calibrate(real scalar d)
{
    struct cge_model scalar M, Mold
    struct cge_sens scalar G
    real colvector va, q, t, a
    string rowvector c

    G = _cge_sens_load()
    Mold = _cge_load()
    _cge_sens_values(G, d, va, q, t, a)
    // Options of the last calibration; models calibrated before version 0.3.1
    // stored ten of them, before 0.3.3 seventeen, before 0.3.4 twenty-one,
    // before 0.5.1 twenty-five and before 0.5.2 twenty-seven
    c = G.calargs
    if (cols(c) < 28) c = c, J(1, 28 - cols(c), "")
    _cge_calibrate(_cge_numlist(va), _cge_numlist(q), _cge_numlist(t), c[4], c[5], c[6],
                   (c[7] == "" & !anyof(G.vary, "a") ? "" : _cge_numlist(a)), c[8], c[9], c[10],
                   c[11], c[12], c[13], c[14], c[15], c[16], c[17], c[18], c[19], c[20], c[21],
                   c[22], c[23], c[24], c[25], c[26], c[27], c[28])
    M = _cge_load()
    // Swaps (version 0.4.5) are kept
    M.swfix = Mold.swfix
    M.swfree = Mold.swfree
    _cge_closure_apply(M, G.ext, G.gov, G.si, G.num, G.fac)
    // Constraints (version 0.4.4) are kept: the layout does not depend on the
    // elasticities
    if (rows(Mold.bY)) {
        M.bY = Mold.bY
        M.bX = Mold.bX
        M.btype = Mold.btype
        M.bdir = Mold.bdir
        M.p.bmode = Mold.p.bmode
        M.p.bval = Mold.p.bval
        M.p.bxbar = Mold.p.bxbar
        M.p.rrm = Mold.p.rrm
        M.p.rre = Mold.p.rre
        M.p.rra = Mold.p.rra
        M.p0.bmode = Mold.p0.bmode
        M.p0.bval = Mold.p0.bval
        M.p0.bxbar = Mold.p0.bxbar
        _cge_cons_rebuild(M)
        _cge_closure_apply(M, G.ext, G.gov, G.si, G.num, G.fac)
    }
    _cge_store(M)
}

// Record the report measures of the simulation just solved, for draw d
void _cge_sens_collect(real scalar d, real scalar conv)
{
    struct cge_model scalar M
    struct cge_sens scalar G
    string matrix keys
    real colvector base, s
    real matrix vals, pct

    M = _cge_load()
    G = _cge_sens_load()
    G.conv[d + 1] = conv
    if (conv) {
        s = _cge_sim_index(M, "_sens")
        _cge_report_rows(M, s, keys, base, vals, pct)
        if (rows(G.keys) == 0) {
            G.keys = keys
            G.base = base
            G.pct = J(rows(keys), rows(G.conv), .)
            G.val = G.pct
        }
        G.pct[., d + 1] = pct
        G.val[., d + 1] = vals
        if (G.keep != "") {
            G.kx = G.kx, M.simx[., s]
            G.kd = G.kd \ d
            G.kp = G.kp, _cge_par_ptr(M.simp[s])
        }
    }
    _cge_sens_store(G)
}

// Display the summary and, if asked, fill the dataset in memory
void _cge_sens_finish(string scalar tables, real scalar show, real scalar fill)
{
    struct cge_model scalar M
    struct cge_sens scalar G
    string rowvector tab
    string colvector lab, d1, d2, d3
    real colvector ok, sel, x, q, nd, dv, va, qq, tt, aa
    real matrix P
    real scalar i, n, nk, j, D, w1, k

    M = _cge_load()
    G = _cge_sens_load()
    D = rows(G.conv) - 1
    if (rows(G.keys) == 0 | !G.conv[1]) _cge_fail("the scenario did not converge with the central elasticities", 430)
    ok = select((2::(D + 1)), G.conv[|2 \ D + 1|])
    n = rows(ok)
    P = G.pct[., ok]
    if (show) {
        tab = (tables == "" ? ("macro", "welfare") : (tables == "all" ?
               ("macro", "government", "debt", "institutions", "factors", "activities", "commodities", "health", "welfare") :
               tokens(tables)))
        printf("\n{txt}Sensitivity of the scenario to the elasticities: {res}%f{txt} of {res}%f{txt} draws converged\n", n, D)
        printf("{txt}Per cent changes from the base (welfare: per cent of base consumption)\n")
        for (k = 1; k <= cols(tab); k++) {
            sel = select((1::rows(G.keys)), G.keys[., 1] :== tab[k])
            if (rows(sel) == 0) continue
            w1 = max((24, max(strlen(G.keys[sel, 2] :+ " " :+ G.keys[sel, 3])))) + 1
            printf("\n{txt}%s\n{hline %f}\n", tab[k], w1 + 55)
            printf("{txt}%-" + strofreal(w1) + "s %10s %10s %10s %10s %10s\n", "", "central", "mean", "sd", "p5", "p95")
            for (i = 1; i <= rows(sel); i++) {
                j = sel[i]
                x = select(P[j, .]', P[j, .]' :< .)
                q = (rows(x) ? sort(x, 1) : J(0, 1, .))
                printf("{txt}%-" + strofreal(w1) + "s {res}%10.3f %10.3f %10.3f %10.3f %10.3f\n",
                       G.keys[j, 2] + (G.keys[j, 3] == "" ? "" : " " + G.keys[j, 3]), G.pct[j, 1],
                       (rows(x) ? mean(x) : .), (rows(x) > 1 ? sqrt(variance(x)) : .),
                       (rows(x) ? q[max((1, ceil(0.05 * rows(x))))] : .), (rows(x) ? q[max((1, ceil(0.95 * rows(x))))] : .))
            }
            printf("{txt}{hline %f}\n", w1 + 55)
        }
    }
    st_numscalar("r(N_draws)", D)
    st_numscalar("r(N_converged)", n)
    if (fill) {
        // Report measures for every draw (draw 0: central elasticities), then the
        // elasticities of every draw
        nk = rows(G.keys)
        nd = J(0, 1, .)
        d1 = J(0, 1, "")
        d2 = d1
        d3 = d1
        dv = J(0, 1, .)
        lab = M.A \ M.C \ M.C \ M.A
        for (j = 0; j <= D; j++) {
            if (!G.conv[j + 1]) continue
            nd = nd \ J(nk, 1, j)
        }
        st_addobs(rows(nd))
        (void) st_addvar("double", "draw")
        (void) st_addvar("str16", "table")
        (void) st_addvar("str32", "measure")
        (void) st_addvar("str32", "element")
        (void) st_addvar("double", ("base", "value", "pct"))
        st_store(., "draw", nd)
        st_sstore(., "table", J(rows(nd) / nk, 1, G.keys[., 1]))
        st_sstore(., "measure", J(rows(nd) / nk, 1, G.keys[., 2]))
        st_sstore(., "element", J(rows(nd) / nk, 1, G.keys[., 3]))
        st_store(., "base", J(rows(nd) / nk, 1, G.base))
        sel = select((1::(D + 1)), G.conv)
        st_store(., "value", colshape(G.val[., sel]', 1))
        st_store(., "pct", colshape(G.pct[., sel]', 1))
        for (j = 0; j <= D; j++) {
            _cge_sens_values(G, j, va, qq, tt, aa)
            nd = J(rows(lab), 1, j)
            k = st_nobs()
            st_addobs(rows(lab))
            st_store(((k + 1)::(k + rows(lab))), "draw", nd)
            st_sstore(((k + 1)::(k + rows(lab))), "table", J(rows(lab), 1, "elasticity"))
            st_sstore(((k + 1)::(k + rows(lab))), "measure", J(M.n, 1, "sigmava") \ J(M.nC, 1, "sigmaq") \
                      J(M.nC, 1, "sigmat") \ J(M.n, 1, "sigmaa"))
            st_sstore(((k + 1)::(k + rows(lab))), "element", lab)
            st_store(((k + 1)::(k + rows(lab))), "value", va \ qq \ tt \ aa)
        }
        st_varlabel("draw", "Draw (0: central elasticities)")
        st_varlabel("table", "Report table, or elasticity")
        st_varlabel("measure", "Measure, or elasticity")
        st_varlabel("element", "Set element")
        st_varlabel("base", "Base value")
        st_varlabel("value", "Value in the draw")
        st_varlabel("pct", "Per cent change (rates: points; welfare: per cent of base consumption)")
    }
}

void _cge_sens_end()
{
    if (findexternal("cge__sens") != NULL) rmexternal("cge__sens")
}

// =====================================================================
// Link to household surveys (model_spec.md, Section 11; from version 0.2.2)
// =====================================================================

// Ratio of the new to the base value of income source src for household group h
real scalar _cge_ms_ratio(struct cge_model scalar M, struct cge_par scalar p, real colvector x,
                          real scalar h, string scalar src)
{
    real matrix YIF, YIF0
    real colvector YF, YF0, DY, DY0, MPS, TINS, YI, MPS0, TINS0, YI0
    real scalar f, a, b, cpi, cpi0, exr, exr0

    cpi = _cge_vn(M, x, "CPI")
    cpi0 = _cge_vn(M, M.x0, "CPI")
    if (src == "fixed") return(1)
    if (src == "cpi") return(cpi / cpi0)
    if (src == "gov") {
        a = M.p0.trdg[h] * cpi0
        b = p.trdg[h] * cpi
        return(a == 0 ? cpi / cpi0 : b / a)
    }
    if (src == "row") {
        exr = _cge_vn(M, x, "EXR")
        exr0 = _cge_vn(M, M.x0, "EXR")
        a = M.p0.trdr[h] * exr0
        b = p.trdr[h] * exr
        return(a == 0 ? exr / exr0 : b / a)
    }
    if (src == "dom") {
        MPS = _cge_vn(M, x, "MPS");      TINS = _cge_vn(M, x, "TINS");      YI = _cge_vn(M, x, "YI")
        MPS0 = _cge_vn(M, M.x0, "MPS");  TINS0 = _cge_vn(M, M.x0, "TINS");  YI0 = _cge_vn(M, M.x0, "YI")
        DY = (1 :- MPS) :* (1 :- TINS) :* YI
        DY0 = (1 :- MPS0) :* (1 :- TINS0) :* YI0
        a = M.p0.shii[h, .] * DY0
        b = p.shii[h, .] * DY
        return(a == 0 ? cpi / cpi0 : b / a)
    }
    f = _cge_find(M.F, src)
    YIF = _cge_vn(M, x, "YIF")
    YIF0 = _cge_vn(M, M.x0, "YIF")
    if (YIF0[h, f] == 0) {
        YF = _cge_vn(M, x, "YF")
        YF0 = _cge_vn(M, M.x0, "YF")
        return(YF[f] / YF0[f])
    }
    return(YIF[h, f] / YIF0[h, f])
}

// Weighted Fosters-Greer-Thorbecke index of order a for poverty line z: a
// number or (from version 0.8.0) a line for each observation
real scalar _cge_fgt(real colvector r, real colvector w, real colvector z, real scalar a)
{
    real colvector poor, gap
    poor = (r :< z)
    gap = poor :* (z :- r) :/ z
    return(sum(w :* poor :* (a == 0 ? J(rows(r), 1, 1) : gap :^ a)) / sum(w))
}

// Weighted Gini coefficient
real scalar _cge_gini(real colvector r, real colvector w)
{
    real colvector o, rs, ws, cw, L, cw1, L1
    if (rows(r) < 2) return(.)
    o = order(r, 1)
    rs = r[o]
    ws = w[o]
    cw = runningsum(ws) / sum(ws)
    L = runningsum(rs :* ws) / sum(rs :* ws)
    cw1 = 0 \ cw[|1 \ rows(cw) - 1|]
    L1 = 0 \ L[|1 \ rows(L) - 1|]
    return(1 - sum((cw - cw1) :* (L + L1)))
}

// Weighted percentiles pv (between 0 and 100) of r, as _pctile and xtile
// compute them: with the values sorted, W(i) their cumulative weight and
// P = W(n) p / 100, the value of the first i with W(i) > P, or the mean of the
// values i - 1 and i when W(i - 1) = P (from version 0.8.0)
real colvector _cge_wpct(real colvector r, real colvector w, real colvector pv)
{
    real colvector o, xs, W, out
    real scalar n, P, i, k
    n = rows(r)
    o = order(r, 1)
    xs = r[o]
    W = runningsum(w[o])
    out = J(rows(pv), 1, .)
    for (k = 1; k <= rows(pv); k++) {
        P = W[n] * pv[k] / 100
        i = sum(W :<= P) + 1
        if (i > n) i = n
        out[k] = xs[i]
        if (i > 1) {
            if (W[i - 1] == P) out[k] = (xs[i - 1] + xs[i]) / 2
        }
    }
    return(out)
}

// Quantile groups 1 to nq of r over weights w, as xtile forms them: group k
// holds the values above the cut point k - 1 and up to cut point k (from
// version 0.8.0)
real colvector _cge_wxtile(real colvector r, real colvector w, real scalar nq)
{
    real colvector c, q
    real scalar k
    c = _cge_wpct(r, w, 100 :* (1::(nq - 1)) :/ nq)
    q = J(rows(r), 1, 1)
    for (k = 1; k < nq; k++) q = q + (r :> c[k])
    return(q)
}

// The Lorenz curve of r over weights w at population shares pv, linear
// between observations (from version 0.8.0)
real colvector _cge_lorenzv(real colvector r, real colvector w, real colvector pv)
{
    real colvector o, F, L, out
    real scalar k, i, F1, L1
    o = order(r, 1)
    F = runningsum(w[o]) / sum(w)
    L = runningsum(r[o] :* w[o]) / sum(r :* w)
    out = J(rows(pv), 1, .)
    for (k = 1; k <= rows(pv); k++) {
        i = sum(F :< pv[k]) + 1
        if (i > rows(F)) i = rows(F)
        F1 = 0
        L1 = 0
        if (i > 1) {
            F1 = F[i - 1]
            L1 = L[i - 1]
        }
        out[k] = L1 + (pv[k] - F1) / (F[i] - F1) * (L[i] - L1)
    }
    return(out)
}

// Generalised entropy GE(a) of r over weights w: a = 0 is the mean log
// deviation, a = 1 the Theil index; missing when a logarithm needs a value
// that is not positive (from version 0.8.0)
real scalar _cge_ge(real colvector r, real colvector w, real scalar a)
{
    real colvector s
    real scalar W
    W = sum(w)
    s = r :/ (sum(w :* r) / W)
    if (a == 0) {
        if (min(r) <= 0) return(.)
        return(-sum(w :* ln(s)) / W)
    }
    if (a == 1) {
        if (min(r) < 0) return(.)
        return(sum(w :* s :* ln(s + (s :<= 0))) / W)
    }
    return(sum(w :* (s :^ a :- 1)) / (W * a * (a - 1)))
}

// Atkinson index of r over weights w, with inequality aversion e (from
// version 0.8.0)
real scalar _cge_atk(real colvector r, real colvector w, real scalar e)
{
    real scalar W, mu
    if (min(r) < 0) return(.)
    if (e >= 1 & min(r) <= 0) return(.)
    W = sum(w)
    mu = sum(w :* r) / W
    if (e == 1) return(1 - exp(sum(w :* ln(r)) / W) / mu)
    return(1 - (sum(w :* r :^ (1 - e)) / W) ^ (1 / (1 - e)) / mu)
}

// The inequality measures of cge_microsim, over persons v with positive
// weight: Gini, Theil, mean log deviation, GE(2), Atkinson with aversion
// 0.5, 1 and 2, and the Palma and S80/S20 ratios (from version 0.8.0)
string rowvector _cge_ms_ineqnames()
{
    return(("gini", "theil", "mld", "ge2", "atkinson_05", "atkinson_1", "atkinson_2", "palma", "s80s20"))
}

real rowvector _cge_ms_ineq(real colvector r, real colvector v)
{
    real colvector k, L
    k = selectindex(v :> 0)
    if (rows(k) < 2) return(J(1, 9, .))
    L = _cge_lorenzv(r[k], v[k], (0.2 \ 0.4 \ 0.8 \ 0.9))
    return((_cge_gini(r[k], v[k]), _cge_ge(r[k], v[k], 1), _cge_ge(r[k], v[k], 0), _cge_ge(r[k], v[k], 2),
            _cge_atk(r[k], v[k], 0.5), _cge_atk(r[k], v[k], 1), _cge_atk(r[k], v[k], 2),
            (1 - L[4]) / L[2], (1 - L[3]) / L[1]))
}

// FGT0, FGT1 and FGT2 for line z, and the number of poor persons in units of
// the weights (from version 0.8.0)
real rowvector _cge_ms_pov(real colvector r, real colvector v, real colvector z)
{
    return((_cge_fgt(r, v, z, 0), _cge_fgt(r, v, z, 1), _cge_fgt(r, v, z, 2), sum(v :* (r :< z))))
}

// =====================================================================
// Fiscal incidence (CEQ) in cge_microsim (from version 0.8.2)
// =====================================================================

// Concentration coefficient of t over weights v, with the observations
// ranked by x: 2 sum(v t (F - 1/2)) / sum(v t), F the mid-point of each
// observation's share of the weights, tied values of x sharing their
// mid-point. With t = x it is the Gini coefficient.
real scalar _cge_conc(real colvector t, real colvector x, real colvector v)
{
    real colvector o, xs, vs, ts, gid, gw, gs, F
    real matrix info
    real scalar n
    n = rows(x)
    if (n < 2) return(.)
    o = order(x, 1)
    xs = x[o]
    vs = v[o]
    ts = t[o]
    gid = runningsum(1 \ (xs[|2 \ n|] :!= xs[|1 \ n - 1|]))
    info = panelsetup(gid, 1)
    gw = panelsum(vs, info)
    gs = runningsum(gw) - gw
    F = (gs[gid] + gw[gid] :/ 2) :/ sum(vs)
    return(2 * sum(vs :* ts :* (F :- 0.5)) / sum(vs :* ts))
}

// The fiscal measures of one scenario (from version 0.8.2). Household totals:
// market income ym and the instruments, in the columns of X with types ty
// (1 direct taxes, 2 direct transfers, 3 indirect taxes, 4 indirect
// subsidies, 5 in-kind benefits); n persons and person weights v; lines Z;
// quantile groups qg of base market income per person. Out: CC, by income
// concept (market, net market, disposable, consumable, final), the mean
// per person, Gini, concentration coefficient in market income, and FGT0,
// FGT1, FGT2 and the number of poor for each line; II, by instrument, the
// total, per cent of market income, concentration coefficient, Kakwani
// index, coverage, coverage of the poor in market income, and marginal
// contributions to the Gini and the headcount of final income; RD, the
// redistributive effect, Reynolds-Smolensky index, reranking and fiscal
// impoverishment; QS and QP, by quantile and instrument, the share of the
// instrument and its per cent of the quantile's market income
void _cge_ms_fisc(real colvector ym, real matrix X, real rowvector ty, real colvector nsz, real colvector v,
                  real matrix Z, real colvector qg, real scalar nq, real matrix CC, real matrix II,
                  real colvector RD, real matrix QS, real matrix QP, real matrix Yout)
{
    real matrix Y, ypc
    real colvector tx, tpc, wo, poor, sel
    real scalar n, k, j, l, nz, gm, nk, tax
    n = rows(ym)
    nz = cols(Z)
    nk = cols(X)
    tx = J(n, 5, 0)
    for (k = 1; k <= 5; k++) {
        sel = selectindex(ty :== k)'
        if (cols(sel)) tx[., k] = rowsum(X[., sel])
    }
    // concepts: market, net market, disposable, consumable, final
    Y = J(n, 5, .)
    Y[., 1] = ym
    Y[., 2] = Y[., 1] - tx[., 1]
    Y[., 3] = Y[., 2] + tx[., 2]
    Y[., 4] = Y[., 3] - tx[., 3] + tx[., 4]
    Y[., 5] = Y[., 4] + tx[., 5]
    Yout = Y
    ypc = Y :/ nsz
    CC = J(5, 3 + 4 * nz, .)
    for (k = 1; k <= 5; k++) {
        CC[k, 1] = sum(v :* ypc[., k]) / sum(v)
        CC[k, 2] = _cge_gini(ypc[., k], v)
        CC[k, 3] = _cge_conc(ypc[., k], ypc[., 1], v)
        for (l = 1; l <= nz; l++) CC[k, (4 + 4 * (l - 1))..(3 + 4 * l)] = _cge_ms_pov(ypc[., k], v, Z[., l])
    }
    gm = CC[1, 2]
    II = J(nk, 8, .)
    QS = J(nq, nk, .)
    QP = J(nq, nk, .)
    poor = (nz ? (ypc[., 1] :< Z[., 1]) : J(n, 1, 0))
    for (j = 1; j <= nk; j++) {
        tpc = X[., j] :/ nsz
        tax = (ty[j] == 1 | ty[j] == 3)
        II[j, 1] = sum(v :* tpc)
        II[j, 2] = 100 * II[j, 1] / sum(v :* ypc[., 1])
        II[j, 3] = _cge_conc(tpc, ypc[., 1], v)
        II[j, 4] = (tax ? II[j, 3] - gm : gm - II[j, 3])
        II[j, 5] = sum(v :* (X[., j] :> 0)) / sum(v)
        if (nz) II[j, 6] = sum(v :* (X[., j] :> 0) :* poor) / sum(v :* poor)
        // final income without the instrument
        wo = ypc[., 5] + (tax ? tpc : -tpc)
        II[j, 7] = _cge_gini(wo, v) - CC[5, 2]
        if (nz) II[j, 8] = _cge_fgt(wo, v, Z[., 1], 0) - CC[5, 4]
        for (k = 1; k <= nq; k++) {
            sel = selectindex(qg :== k)
            if (!rows(sel)) continue
            QS[k, j] = sum(v[sel] :* tpc[sel]) / II[j, 1]
            QP[k, j] = 100 * sum(v[sel] :* tpc[sel]) / sum(v[sel] :* ypc[sel, 1])
        }
    }
    RD = J(4, 1, .)
    RD[1] = gm - CC[5, 2]
    RD[2] = gm - CC[5, 3]
    RD[3] = CC[5, 2] - CC[5, 3]
    if (nz) RD[4] = sum(v :* (Y[., 4] :< Y[., 1]) :* (ypc[., 4] :< Z[., 1])) / sum(v)
}

// The changes of the instruments in a simulation, as ratios to the base for
// each household, before deflation (from version 0.8.2): direct taxes with
// market income and the group's direct tax rate; direct transfers as the
// group's transfers from the government; indirect taxes with nominal spending
// and the household's tax wedge, the share of sales tax and VAT in the price
// it pays; subsidies with nominal spending; in-kind benefits as the model's
// spending on their commodity, or on the health insurance fund's purchases
real matrix _cge_ms_fratio(struct cge_model scalar M, struct cge_par scalar p, real colvector x, real colvector hi,
                           real rowvector ty, string rowvector tgt, real colvector mr, real colvector C0,
                           real colvector C1, real colvector pr, real colvector P, real matrix B, real colvector ci,
                           real colvector tot, real matrix wg, real colvector Pg)
{
    real matrix RT
    real colvector TINS, TINS0, tr, gr, cr, w0, w1, t0, t1, PQ, PQ0, QG, QG0, QS, QS0
    real scalar nH, h, j, c, a, b
    nH = M.nH
    RT = J(rows(C0), cols(ty), 1)
    TINS = _cge_vn(M, x, "TINS")
    TINS0 = _cge_vn(M, M.x0, "TINS")
    tr = (TINS0[|1 \ nH|] :> 0) :* (TINS[|1 \ nH|] :/ (TINS0[|1 \ nH|] + (TINS0[|1 \ nH|] :== 0))) + (TINS0[|1 \ nH|] :<= 0)
    gr = J(nH, 1, .)
    for (h = 1; h <= nH; h++) gr[h] = _cge_ms_ratio(M, p, x, h, "gov")
    cr = (C0 :> 0) :* (C1 :/ (C0 + (C0 :== 0))) + (C0 :<= 0)
    // tax wedges of commodities (sales tax and VAT), 0 for home consumption
    w0 = (1 :- (1 :- M.p0.tq :* _cge_vn(M, M.x0, "TQADJ")) :/ (1 :+ M.p0.tv :* _cge_vn(M, M.x0, "TVADJ"))) \ J(M.n, 1, 0)
    w1 = (1 :- (1 :- p.tq :* _cge_vn(M, x, "TQADJ")) :/ (1 :+ p.tv :* _cge_vn(M, x, "TVADJ"))) \ J(M.n, 1, 0)
    t0 = (wg' * w0)[hi, 1]
    t1 = ((wg' * (pr :* w1)) :/ Pg)[hi, 1]
    if (cols(B)) {
        t0 = (tot :> 0) :* ((B * w0[ci]) :/ (tot + (tot :== 0))) + (tot :<= 0) :* t0
        t1 = (tot :> 0) :* ((B * (pr[ci] :* w1[ci])) :/ (tot + (tot :== 0)) :/ P) + (tot :<= 0) :* t1
    }
    PQ = _cge_vn(M, x, "PQ")
    PQ0 = _cge_vn(M, M.x0, "PQ")
    QG = _cge_vn(M, x, "QG")
    QG0 = _cge_vn(M, M.x0, "QG")
    QS = _cge_vn(M, x, "QSHI")
    QS0 = _cge_vn(M, M.x0, "QSHI")
    for (j = 1; j <= cols(ty); j++) {
        if (ty[j] == 1) RT[., j] = mr :* tr[hi, 1]
        else if (ty[j] == 2) RT[., j] = gr[hi, 1]
        else if (ty[j] == 3) RT[., j] = cr :* ((t0 :> 0) :* (t1 :/ (t0 + (t0 :== 0))) + (t0 :<= 0))
        else if (ty[j] == 4) RT[., j] = cr
        else {
            if (tgt[j] == "shi") {
                a = sum(PQ0 :* QS0)
                b = sum(PQ :* QS)
            }
            else {
                c = _cge_find(M.C, tgt[j])
                a = PQ0[c] * QG0[c]
                b = PQ[c] * QG[c]
            }
            RT[., j] = J(rows(C0), 1, (a > 0 ? b / a : 1))
        }
    }
    return(RT)
}

// The table of fiscal incidence, base -> simulated (from version 0.8.2)
void _cge_ms_showfisc(string rowvector inst, real rowvector ty, real matrix CB, real matrix CS, real matrix IB,
                      real matrix IS, real colvector RB, real colvector RS, real scalar nz, string scalar zl)
{
    string rowvector cl, tl
    real scalar k
    cl = ("market", "net market", "disposable", "consumable", "final")
    tl = ("direct tax", "transfer", "indirect tax", "subsidy", "in kind")
    printf("\n{txt}Fiscal incidence: income concepts per person, persons ranked by market income per person\n")
    printf("{txt}{hline 98}\n")
    printf("{txt}%-12s %24s %22s %22s %15s\n", "income", "mean, base -> simulated", "Gini", "concentration",
           (nz ? "headcount (%)" : ""))
    printf("{txt}{hline 98}\n")
    for (k = 1; k <= 5; k++) {
        printf("{txt}%-12s {res}%10.4g -> %10.4g %9.4f -> %9.4f %9.4f -> %9.4f", cl[k], CB[k, 1], CS[k, 1], CB[k, 2],
               CS[k, 2], CB[k, 3], CS[k, 3])
        if (nz) printf("{res} %6.2f -> %6.2f\n", 100 * CB[k, 4], 100 * CS[k, 4])
        else printf("\n")
    }
    printf("{txt}{hline 98}\n")
    printf("{txt}%-12s %-12s %22s %22s %13s %13s\n", "instrument", "", "% of market income", "Kakwani", "coverage (%)",
           "MC to Gini")
    printf("{txt}{hline 98}\n")
    for (k = 1; k <= cols(inst); k++) {
        printf("{txt}%-12s %-12s {res}%9.3f -> %9.3f %9.4f -> %9.4f %13.2f %13.5f\n", abbrev(inst[k], 12), tl[ty[k]],
               IB[k, 2], IS[k, 2], IB[k, 4], IS[k, 4], 100 * IB[k, 5], IB[k, 7])
    }
    printf("{txt}{hline 98}\n")
    printf("{txt}Redistributive effect {res}%7.4f{txt} -> {res}%7.4f{txt}; Reynolds-Smolensky {res}%7.4f{txt} -> {res}%7.4f{txt}; reranking {res}%7.4f{txt} -> {res}%7.4f\n",
           RB[1], RS[1], RB[2], RS[2], RB[3], RS[3])
    if (nz) printf("{txt}Fiscal impoverishment at line {res}%s{txt}: {res}%6.2f{txt} -> {res}%6.2f{txt} per cent of persons\n",
                   zl, 100 * RB[4], 100 * RS[4])
    printf("{txt}Kakwani: positive when progressive. MC: Gini of final income without the instrument less with it, base\n")
}

// =====================================================================
// Reweighting, survey-design variances and bands in cge_microsim (from
// version 0.8.3)
// =====================================================================

// Weights w1 = w0 exp(X lambda) closest to w0 in relative entropy (the
// Kullback-Leibler divergence of w1 from w0) such that X' w1 = T: Newton's
// method on lambda, with the step halved while it does not reduce the
// largest relative deviation. Returns w1; it and dev give the iterations and
// the largest relative deviation from the targets.
real colvector _cge_ms_rwsolve(real matrix X, real colvector w0, real colvector T, real scalar it,
                               real scalar dev)
{
    real colvector lam, w1, g, step, lnew, wn
    real matrix H
    real scalar k, dn, h
    lam = J(cols(X), 1, 0)
    w1 = w0
    g = X' * w1 - T
    dev = max(abs(g) :/ abs(T))
    for (it = 0; it < 100 & dev > 1e-12; it++) {
        H = X' * (w1 :* X)
        step = lusolve(H, g)
        if (hasmissing(step)) break
        h = 1
        for (k = 1; k <= 30; k++) {
            lnew = lam - h :* step
            wn = w0 :* exp(X * lnew)
            dn = max(abs(X' * wn - T) :/ abs(T))
            if (dn < dev) break
            h = h / 2
        }
        if (!(dn < dev)) break
        lam = lnew
        w1 = wn
        g = X' * w1 - T
        dev = dn
    }
    return(w1)
}

// Linearised variance of totals of the columns of Z (weighted linearised
// values) in a stratified cluster sample, with replacement at the first
// stage: sum over strata h of n_h / (n_h - 1) times the sum of squared
// deviations of the cluster totals from their mean; missing when a stratum
// has a single cluster (from version 0.8.3)
real rowvector _cge_ms_svyvar(real matrix Z, real colvector st, real colvector su)
{
    real colvector o, gid, hs, sst, ssu
    real matrix info, zc, hinfo, zh
    real rowvector v
    real scalar n, h, nh
    n = rows(Z)
    o = order((st, su), (1, 2))
    sst = st[o]
    ssu = su[o]
    // cluster totals, in strata order
    gid = runningsum(1 \ ((sst[|2 \ n|] :!= sst[|1 \ n - 1|]) :| (ssu[|2 \ n|] :!= ssu[|1 \ n - 1|])))
    info = panelsetup(gid, 1)
    zc = panelsum(Z[o, .], info)
    hs = sst[info[., 1]]
    hinfo = panelsetup(hs, 1)
    v = J(1, cols(Z), 0)
    for (h = 1; h <= rows(hinfo); h++) {
        zh = panelsubmatrix(zc, h, hinfo)
        nh = rows(zh)
        if (nh < 2) return(J(1, cols(Z), .))
        v = v + (nh / (nh - 1)) :* colsum((zh :- mean(zh)) :^ 2)
    }
    return(v)
}

// The weighted linearised values of the ratio sum(w y d) / sum(w x d) over
// the observations with d = 1, a domain (0 elsewhere)
real colvector _cge_ms_ratioz(real colvector y, real colvector x, real colvector d, real colvector w)
{
    real scalar X, R
    X = sum(w :* x :* d)
    R = sum(w :* y :* d) / X
    return(w :* d :* (y - R :* x) :/ X)
}

// The draws of a sensitivity analysis kept as simulations name0, name1, ...
// (from version 0.8.3): each with its own solution and parameters, those of
// the scenario at the draw's elasticities
void _cge_sens_keep(string scalar name)
{
    struct cge_model scalar M
    struct cge_sens scalar G
    struct cge_par rowvector sp
    real colvector keep
    real scalar j, k, n0
    string scalar nm
    M = _cge_load()
    G = _cge_sens_load()
    if (!rows(G.kd)) return
    // simulations of the same names are replaced
    keep = J(rows(M.simname), 1, 1)
    for (j = 1; j <= rows(M.simname); j++) {
        if (regexm(M.simname[j], "^" + name + "[0-9]+$")) keep[j] = 0
    }
    _cge_sims_keep(M, select((1::rows(M.simname)), keep))
    n0 = rows(M.simname)
    sp = cge_par(1, n0 + rows(G.kd))
    for (j = 1; j <= n0; j++) sp[j] = M.simp[j]
    for (k = 1; k <= rows(G.kd); k++) {
        nm = name + strofreal(G.kd[k])
        sp[n0 + k] = *(G.kp[k])
        M.simname = M.simname \ nm
        M.simclosure = M.simclosure \ _cge_closure_text(M)
        M.simmethod = M.simmethod \ "sensitivity"
        M.simconv = M.simconv \ 1
        M.simiter = M.simiter \ .
        M.simres = M.simres \ .
        M.simrun = M.simrun \ ""
        M.simper = M.simper \ .
        M.simlam = M.simlam \ .
        M.simcons = M.simcons \ ""
    }
    M.simx = M.simx, G.kx
    M.simp = sp
    _cge_store(M)
    printf("{txt}Kept {res}%f{txt} draws as simulations {res}%s%f{txt} to {res}%s%f\n", rows(G.kd), name, G.kd[1],
           name, G.kd[rows(G.kd)])
}

// The measures of a distribution r over persons v, as decomposed: the mean;
// FGT0, FGT1, FGT2 and the number of poor for each line; the nine inequality
// measures (from version 0.8.1)
real rowvector _cge_ms_all(real colvector r, real colvector v, real matrix Z)
{
    real rowvector m
    real scalar l
    m = sum(v :* r) / sum(v)
    for (l = 1; l <= cols(Z); l++) m = m, _cge_ms_pov(r, v, Z[., l])
    return((m, _cge_ms_ineq(r, v)))
}

// 1 if channel j (from 1) is switched on in subset s, channel j as bit j - 1
real scalar _cge_ms_on(real scalar s, real scalar j)
{
    return(mod(floor(s / 2^(j - 1)), 2))
}

// Shapley values of K channels (Shorrocks 2013) from the measures of every
// subset s of channels, in IM[1 + s, .]: the change that each channel makes
// when it is switched on, averaged over the orders of the channels, with
// weight |S|! (K - |S| - 1)! / K! for each subset S without it. The values
// add up to IM[2^K, .] - IM[1, .] (from version 0.8.1)
real matrix _cge_ms_shapley(real matrix IM, real scalar K)
{
    real matrix PH
    real scalar j, s, nb, u
    PH = J(K, cols(IM), 0)
    for (j = 1; j <= K; j++) {
        for (s = 0; s < 2^K; s++) {
            if (_cge_ms_on(s, j)) continue
            nb = 0
            for (u = 1; u <= K; u++) nb = nb + _cge_ms_on(s, u)
            PH[j, .] = PH[j, .] + (factorial(nb) * factorial(K - nb - 1) / factorial(K)) :*
                       (IM[1 + s + 2^(j - 1), .] - IM[1 + s, .])
        }
    }
    return(PH)
}

// Equivalent and compensating variations of each household at base prices
// (from version 0.8.1): the LES of its group (Cobb-Douglas when the
// subsistence quantities are 0), with the subsistence quantities scaled by
// the household's base consumption relative to its group's; for a household
// with budget items, Cobb-Douglas in its own budget shares
void _cge_ms_evcv(struct cge_model scalar M, struct cge_par scalar p, real colvector x, real colvector hi,
                  real colvector C0, real colvector C1, real colvector pr, real matrix B, real colvector ci,
                  real colvector tot, real colvector ev, real colvector cv)
{
    real colvector PQ0, PQ1, EH0, pg0, pg1, bex, lam, G
    real matrix BB, GG
    PQ0 = _cge_ph(M, M.p0, M.x0) \ _cge_vn(M, M.x0, "PA")
    PQ1 = _cge_ph(M, p, x) \ _cge_vn(M, x, "PA")
    BB = p.beta \ p.betah
    GG = p.gamma \ p.gammah
    EH0 = _cge_vn(M, M.x0, "EH")
    pg0 = (PQ0' * GG)'
    pg1 = (PQ1' * GG)'
    bex = exp(colsum(BB :* ln(PQ0 :/ PQ1)))'
    lam = C0 :/ EH0[hi, 1]
    ev = lam :* pg0[hi, 1] + (C1 - lam :* pg1[hi, 1]) :* bex[hi, 1] - C0
    cv = C1 - lam :* pg1[hi, 1] - (C0 - lam :* pg0[hi, 1]) :/ bex[hi, 1]
    if (cols(B)) {
        G = exp((B :/ (tot + (tot :== 0))) * ln(pr[ci]))
        ev = (tot :> 0) :* (C1 :/ G - C0) + (tot :<= 0) :* ev
        cv = (tot :> 0) :* (C1 - C0 :* G) + (tot :<= 0) :* cv
    }
}

// Rows of the results dataset: q, base, value and the per cent change
real matrix _cge_ms_rows(real colvector q, real colvector b, real colvector v)
{
    return((q, b, v, 100 :* (v :/ b :- 1)))
}

// "var:target" pairs
void _cge_ms_pairs(string scalar spec, string scalar what, string rowvector vars, string rowvector targets)
{
    string rowvector tok, pair
    real scalar k
    tok = tokens(spec)
    vars = J(1, cols(tok), "")
    targets = vars
    for (k = 1; k <= cols(tok); k++) {
        pair = tokens(tok[k], ":")
        if (cols(pair) != 3) _cge_fail(what + "(): write variable:" + (what == "income" ? "source" : "commodity") +
                                       ", for example " + (what == "income" ? "wages:lab" : "food:com_agr"), 198)
        vars[k] = pair[1]
        targets[k] = pair[3]
    }
}

// A matrix in r() with row and column names
void _cge_ms_rmat(string scalar name, real matrix X, string colvector req, string colvector rn, string colvector cn)
{
    st_matrix(name, X)
    st_matrixrowstripe(name, (req, rn))
    st_matrixcolstripe(name, (J(rows(cn), 1, ""), cn))
}

void _cge_microsim(string scalar sims, string scalar touse, string scalar gvar, string scalar cvar,
                   string scalar wvar, string scalar svar, string scalar income, string scalar budget,
                   string scalar lines, real scalar nq, string scalar gen, real scalar show,
                   real scalar detail, real scalar decomp, string scalar market, string scalar dtax,
                   string scalar transfers, string scalar itax, string scalar subsidies, string scalar inkind,
                   string scalar reweight, real scalar svy, string scalar stvar, string scalar suvar,
                   string scalar bands)
{
    struct cge_model scalar M
    struct cge_par scalar p
    string colvector g, ug, rlab, cn
    string rowvector ivars, isrc, bvars, bcom, simv, ltok, ineqn, povn, nm, chn, alln
    string colvector alll, req
    string rowvector inst, tgt, iv, itg, fcl, fin, rwv, rwt, allv, bn
    string scalar sfx, sname, zl1
    string matrix S
    real colvector x, C0, w, nsz, hi, EH, EH0, MPS, TINS, MPS0, TINS0, kappa, grp, ratio, C1, PQ, PQ0
    real colvector pr, Pg, P, R, r0, r1, pw, Y0, Y1, tot, ci, sel, present, qg, pv, q0, q1
    real colvector ev, cv, rS, fn, Ys, kap, gi, ym0, ym1, qf, mr, YI, YI0, yig, FRB, FRS
    real colvector ws, pws, pS, rwT0, rwr, st, su, dd, y0, y1, z0, z1
    real rowvector a, b, cc, mm, P00, P11, P10, P01, ty, tl
    real matrix Y, rho, QH0, wg, B, T, Z, V, IB, IS, PT, QT, GT, RH, IM, PH, GR, WT
    real matrix XF, XS, RT, FCB, FCS, FIB, FIS, FQSB, FQSS, FQPB, FQPS, FYB, FYS
    real matrix XR, RWT, QF, QF0, SEI, SEA, BM, BT
    real rowvector CM, BB, vse
    real scalar s, n, k, h, j, nH, row, nz, ns, l, si, hasline, zv, d, nr, K, ktax, kgrp, mk, mu0, mu1, hasf, c
    real scalar hasrw, kpr, kwt, rwit, rwdev, nb, f, aa

    M = _cge_load()
    _cge_need(M, "sam")
    _cge_need(M, "calibrated")
    simv = tokens(sims)
    ns = cols(simv)
    if (ns == 0) _cge_fail("sim(): give a simulation", 198)
    for (k = 1; k <= ns; k++) (void) _cge_sim_index(M, simv[k])
    nH = M.nH
    g = st_sdata(., gvar, touse)
    C0 = st_data(., cvar, touse)
    n = rows(C0)
    if (n == 0) _cge_fail("no observations", 2000)
    w = (wvar == "" ? J(n, 1, 1) : st_data(., wvar, touse))
    nsz = (svar == "" ? J(n, 1, 1) : st_data(., svar, touse))
    if (min(w) < 0 | min(nsz) <= 0) _cge_fail("weights must be non-negative and household sizes positive", 459)

    // Household groups
    hi = J(n, 1, 0)
    ug = uniqrows(g)
    for (k = 1; k <= rows(ug); k++) {
        h = _cge_find(M.H, ug[k])
        if (h == 0) _cge_fail("group(): " + ug[k] + " is not a household of the model (" + invtokens(M.H') + ")", 111)
        hi = hi + h :* (g :== ug[k])
    }

    // Poverty lines per person: numbers, or variables that give each
    // household its line (from version 0.8.0)
    ltok = tokens(lines)
    nz = cols(ltok)
    Z = J(n, nz, .)
    for (l = 1; l <= nz; l++) {
        zv = strtoreal(ltok[l])
        if (zv < .) Z[., l] = J(n, 1, zv)
        else {
            Z[., l] = st_data(., ltok[l], touse)
            if (min(Z[., l]) <= 0) _cge_fail("line(): the poverty lines in " + ltok[l] + " must be positive", 459)
        }
    }
    hasline = (nz > 0)

    // Income components and budget items
    if (income != "") {
        _cge_ms_pairs(income, "income", ivars, isrc)
        for (k = 1; k <= cols(isrc); k++) {
            if (!anyof(("gov", "row", "dom", "cpi", "fixed"), isrc[k]) & !_cge_find(M.F, isrc[k])) {
                _cge_fail("income(): " + isrc[k] + " is not a factor of the model or one of gov, row, dom, cpi and fixed", 198)
            }
        }
        Y = st_data(., ivars, touse)
        Y0 = rowsum(Y)
    }
    if (budget != "") {
        _cge_ms_pairs(budget, "budget", bvars, bcom)
        ci = J(cols(bcom), 1, 0)
        for (k = 1; k <= cols(bcom); k++) {
            ci[k] = _cge_find(M.C, bcom[k])
            // an activity: home consumption of its output, at its price
            if (ci[k] == 0 & _cge_find(M.A, bcom[k])) ci[k] = M.nC + _cge_find(M.A, bcom[k])
            if (ci[k] == 0) _cge_fail("budget(): " + bcom[k] + " is not a commodity or activity of the model", 111)
        }
        B = st_data(., bvars, touse)
        if (min(B) < 0) _cge_fail("budget(): spending on an item cannot be negative", 459)
        tot = rowsum(B)
    }

    // Base consumption per person, person weights, and the quantile groups of
    // the base (from version 0.8.0)
    r0 = C0 :/ nsz
    pw = w :* nsz
    qg = _cge_wxtile(r0, pw, nq)
    pv = (1::99)
    present = uniqrows(hi)
    rlab = "all" \ M.H[present]
    nr = rows(rlab)
    ineqn = _cge_ms_ineqnames()
    povn = ("fgt0", "fgt1", "fgt2", "npoor")
    if (budget == "") {
        B = J(n, 0, .)
        ci = J(0, 1, .)
        tot = J(n, 1, 0)
    }
    // Fiscal instruments (from version 0.8.2): direct taxes, direct
    // transfers, indirect taxes, indirect subsidies and in-kind benefits,
    // amounts paid or received by the household
    hasf = (market != "")
    if (hasf) {
        ym0 = st_data(., market, touse)
        inst = J(1, 0, "")
        ty = J(1, 0, .)
        tgt = J(1, 0, "")
        tl = (1, 2, 3, 4)
        for (k = 1; k <= 4; k++) {
            iv = tokens((dtax, transfers, itax, subsidies)[k])
            inst = inst, iv
            ty = ty, J(1, cols(iv), k)
            tgt = tgt, J(1, cols(iv), "")
        }
        if (inkind != "") {
            _cge_ms_pairs(inkind, "inkind", iv, itg)
            for (k = 1; k <= cols(itg); k++) {
                if (itg[k] == "shi") {
                    if (sum(_cge_vn(M, M.x0, "QSHI")) <= 0) _cge_fail("inkind(): the model has no health insurance fund (shi)", 459)
                }
                else if (!_cge_find(M.C, itg[k])) _cge_fail("inkind(): " + itg[k] + " is not a commodity of the model or shi", 111)
            }
            inst = inst, iv
            ty = ty, J(1, cols(iv), 5)
            tgt = tgt, itg
        }
        if (!cols(inst)) _cge_fail("market(): give the fiscal instruments, in dtax(), transfers(), itax(), subsidies() or inkind()", 198)
        if (cols(uniqrows(inst')') < cols(inst)) _cge_fail("a variable is given as more than one fiscal instrument", 198)
        XF = st_data(., inst, touse)
        if (min(XF) < 0) _cge_fail("fiscal instruments are amounts paid or received and cannot be negative", 459)
        qf = _cge_wxtile(ym0 :/ nsz, w :* nsz, nq)
        fcl = ("market", "net_market", "disposable", "consumable", "final")
        fin = ("total", "pct_market", "conc", "kakwani", "coverage", "coverage_poor", "mc_gini", "mc_fgt0")
        zl1 = (nz ? ltok[1] : "")
    }
    // Reweighting (from version 0.8.3): household characteristics whose
    // weighted totals follow the model, a factor's employment, a factor's
    // employment in an activity (f.a), or a given ratio
    hasrw = (reweight != "")
    if (hasrw) {
        _cge_ms_pairs(reweight, "reweight", rwv, rwt)
        for (k = 1; k <= cols(rwt); k++) {
            if (strtoreal(rwt[k]) < .) {
                if (strtoreal(rwt[k]) <= 0) _cge_fail("reweight(): a ratio must be positive", 198)
            }
            else if (regexm(rwt[k], "^(.+)[.](.+)$")) {
                if (!_cge_find(M.F, regexs(1)) | !_cge_find(M.A, regexs(2))) {
                    _cge_fail("reweight(): " + rwt[k] + " is not factor.activity of the model", 111)
                }
            }
            else if (!_cge_find(M.F, rwt[k])) _cge_fail("reweight(): " + rwt[k] + " is not a factor of the model, factor.activity or a ratio", 111)
        }
        XR = st_data(., rwv, touse)
        if (min(XR) < 0) _cge_fail("reweight(): the characteristics must not be negative", 459)
        rwT0 = (XR' * w)
        if (min(rwT0) <= 0) _cge_fail("reweight(): every characteristic needs a positive weighted total", 459)
    }
    // Survey design (from version 0.8.3): strata and clusters, as svyset
    if (svy) {
        st = (stvar == "" ? J(n, 1, 1) : st_data(., stvar, touse))
        su = (suvar == "" ? (1::n) : st_data(., suvar, touse))
    }
    SEI = J(0, 4, .)
    // Bands across the draws of a sensitivity analysis (from version 0.8.3)
    bn = J(1, 0, "")
    if (bands != "") {
        for (k = 1; k <= rows(M.simname); k++) {
            if (regexm(M.simname[k], "^" + bands + "([0-9]+)$")) {
                if (strtoreal(regexs(1)) >= 1) bn = bn, M.simname[k]
            }
        }
        if (!cols(bn)) _cge_fail("bands(): no simulations " + bands + "1, " + bands + "2, ...; keep the draws with cge_sensitivity, keep()", 111)
    }
    nb = cols(bn)
    allv = simv, bn
    // the measures of the decomposition, and their lines
    alln = "mean"
    alll = ""
    for (l = 1; l <= nz; l++) {
        alln = alln, povn
        alll = alll \ J(4, 1, ltok[l])
    }
    alln = alln, ineqn
    alll = alll \ J(9, 1, "")
    // the channels of the decomposition (from version 0.8.1): each source of
    // income, direct tax and savings rates, the households that follow their
    // group, and prices; without income(), income and prices
    ktax = 0
    kgrp = 0
    if (income != "") {
        chn = J(1, 0, "")
        cc = J(1, cols(isrc), 0)
        for (k = 1; k <= cols(isrc); k++) {
            if (isrc[k] == "fixed") continue
            if (!anyof(chn, isrc[k])) chn = chn, isrc[k]
            cc[k] = _cge_find(chn', isrc[k])
        }
        chn = chn, "taxsav"
        ktax = cols(chn)
        if (any(Y0 :== 0)) {
            chn = chn, "group"
            kgrp = cols(chn)
        }
    }
    else chn = "income"
    chn = chn, "prices"
    kpr = cols(chn)
    // with reweighting, the weights are a channel
    kwt = 0
    if (hasrw) {
        chn = chn, "weights"
        kwt = cols(chn)
    }
    K = cols(chn)
    if (decomp & K > 12) _cge_fail("decompose: at most 12 channels; map fewer sources of income", 198)
    // the results dataset: sim, table, group, measure, line, channel; q,
    // base, value, per cent change
    S = J(0, 6, "")
    V = J(0, 4, .)

    for (si = 1; si <= ns + nb; si++) {
        sname = allv[si]
        s = _cge_sim_index(M, sname)
        x = M.simx[., s]
        p = M.simp[s]

        // Nominal consumption
        EH = _cge_vn(M, x, "EH")
        EH0 = _cge_vn(M, M.x0, "EH")
        MPS = _cge_vn(M, x, "MPS");      TINS = _cge_vn(M, x, "TINS")
        MPS0 = _cge_vn(M, M.x0, "MPS");  TINS0 = _cge_vn(M, M.x0, "TINS")
        kappa = ((1 :- MPS[|1 \ nH|]) :* (1 :- TINS[|1 \ nH|])) :/ ((1 :- MPS0[|1 \ nH|]) :* (1 :- TINS0[|1 \ nH|]))
        grp = EH :/ EH0
        if (income == "") ratio = grp[hi, 1]
        else {
            rho = J(nH, cols(isrc), .)
            for (h = 1; h <= nH; h++) {
                for (k = 1; k <= cols(isrc); k++) rho[h, k] = _cge_ms_ratio(M, p, x, h, isrc[k])
            }
            Y1 = rowsum(Y :* rho[hi, .])
            ratio = (Y0 :!= 0) :* (Y1 :/ (Y0 + (Y0 :== 0))) :* kappa[hi, 1] + (Y0 :== 0) :* grp[hi, 1]
        }
        // (indexes like grp[hi, 1] keep a column when there is one household group)
        C1 = C0 :* ratio

        // Prices households pay (including VAT): the household's budget
        // shares, or its group's (home consumption, from version 0.3.2, at
        // the activity price)
        PQ = _cge_ph(M, p, x) \ _cge_vn(M, x, "PA")
        PQ0 = _cge_ph(M, M.p0, M.x0) \ _cge_vn(M, M.x0, "PA")
        pr = PQ :/ PQ0
        QH0 = _cge_vn(M, M.x0, "QH") \ _cge_vn(M, M.x0, "QHA")
        wg = (PQ0 :* QH0) :/ (EH0' + (EH0' :== 0))
        Pg = wg' * pr
        if (budget == "") P = Pg[hi, 1]
        else P = (tot :> 0) :* ((B * pr[ci]) :/ (tot + (tot :== 0))) + (tot :<= 0) :* Pg[hi, 1]
        R = C1 :/ P
        r1 = R :/ nsz

        // Weights of the simulation (from version 0.8.3): the survey's, or
        // reweighted to the model's targets
        ws = w
        if (hasrw) {
            QF = _cge_vn(M, x, "QF")
            QF0 = _cge_vn(M, M.x0, "QF")
            rwr = J(cols(rwt), 1, .)
            for (k = 1; k <= cols(rwt); k++) {
                if (strtoreal(rwt[k]) < .) rwr[k] = strtoreal(rwt[k])
                else if (regexm(rwt[k], "^(.+)[.](.+)$")) {
                    f = _cge_find(M.F, regexs(1))
                    aa = _cge_find(M.A, regexs(2))
                    rwr[k] = QF[f, aa] / QF0[f, aa]
                }
                else {
                    f = _cge_find(M.F, rwt[k])
                    rwr[k] = sum(QF[f, .]) / sum(QF0[f, .])
                }
            }
            if (hasmissing(rwr) | min(rwr) <= 0) _cge_fail("reweight(): a target of simulation " + sname + " is not positive", 459)
            ws = _cge_ms_rwsolve(XR, w, rwT0 :* rwr, rwit, rwdev)
            if (rwdev > 1e-9) _cge_fail("reweight(): the targets of simulation " + sname + " cannot be met with positive weights", 430)
            RWT = (rwT0, rwT0 :* rwr, XR' * ws, rwr)
        }
        pws = ws :* nsz

        // Equivalent and compensating variations (from version 0.8.1)
        _cge_ms_evcv(M, p, x, hi, C0, C1, pr, B, ci, tot, ev, cv)

        // A draw for the bands: its measures for all households only
        if (si > ns) {
            if (si == ns + 1) BM = J(nb, cols(alln) + 2, .)
            BM[si - ns, .] = (_cge_ms_all(r1, pws, Z), sum(ws :* ev) / sum(pws), sum(ws :* cv) / sum(pws))
            continue
        }
        if (si == 1 & nb) CM = (_cge_ms_all(r1, pws, Z), sum(ws :* ev) / sum(pws), sum(ws :* cv) / sum(pws))

        // Fiscal incidence, base and simulated (from version 0.8.2): market
        // income with the household's income components (or its group's
        // income), the instruments as _cge_ms_fratio() says, all at base
        // prices
        if (hasf) {
            YI = _cge_vn(M, x, "YI")
            YI0 = _cge_vn(M, M.x0, "YI")
            yig = YI[|1 \ nH|] :/ YI0[|1 \ nH|]
            if (income != "") mr = (Y0 :!= 0) :* (Y1 :/ (Y0 + (Y0 :== 0))) + (Y0 :== 0) :* yig[hi, 1]
            else mr = yig[hi, 1]
            RT = _cge_ms_fratio(M, p, x, hi, ty, tgt, mr, C0, C1, pr, P, B, ci, tot, wg, Pg)
            ym1 = ym0 :* mr :/ P
            XS = XF :* RT :/ P
            _cge_ms_fisc(ym0, XF, ty, nsz, pw, Z, qf, nq, FCB, FIB, FRB, FQSB, FQPB, FYB)
            _cge_ms_fisc(ym1, XS, ty, nsz, pws, Z, qf, nq, FCS, FIS, FRS, FQSS, FQPS, FYS)
            for (k = 1; k <= 5; k++) {
                S = S \ (J(3, 1, (sname, "fiscal", "all")), ("mean" \ "gini" \ "conc"), J(3, 1, ("", fcl[k])))
                V = V \ _cge_ms_rows(J(3, 1, .), FCB[k, (1..3)]', FCS[k, (1..3)]')
                for (l = 1; l <= nz; l++) {
                    S = S \ (J(4, 1, (sname, "fiscal", "all")), povn', J(4, 1, (ltok[l], fcl[k])))
                    V = V \ _cge_ms_rows(J(4, 1, .), FCB[k, (4 * l)..(3 + 4 * l)]', FCS[k, (4 * l)..(3 + 4 * l)]')
                }
            }
            for (j = 1; j <= cols(inst); j++) {
                S = S \ (J(8, 1, (sname, "fiscal", "all")), fin', ("" \ "" \ "" \ "" \ "" \ zl1 \ "" \ zl1), J(8, 1, inst[j]))
                V = V \ _cge_ms_rows(J(8, 1, .), FIB[j, .]', FIS[j, .]')
                for (k = 1; k <= nq; k++) {
                    S = S \ (J(2, 1, (sname, "fiscalq", "all")), ("share" \ "pct_market"), J(2, 1, ("", inst[j])))
                    V = V \ _cge_ms_rows((k \ k), (FQSB[k, j] \ FQPB[k, j]), (FQSS[k, j] \ FQPS[k, j]))
                }
            }
            S = S \ (J(4, 1, (sname, "fiscal", "all")), ("re" \ "rs" \ "rerank" \ "fi"), ("" \ "" \ "" \ zl1), J(4, 1, ""))
            V = V \ _cge_ms_rows(J(4, 1, .), FRB, FRS)
        }

        if (hasrw) {
            S = S \ (J(rows(RWT), 1, (sname, "reweight", "all", "total", "")), rwv')
            V = V \ _cge_ms_rows(J(rows(RWT), 1, .), RWT[., 1], RWT[., 3])
        }

        // Means, poverty and inequality: all households, then each group present
        T = J(nr, 11, .)
        IB = J(nr, 9, .)
        IS = J(nr, 9, .)
        PT = J(nz * nr, 8, .)
        for (row = 1; row <= nr; row++) {
            if (row == 1) sel = (1::n)
            else sel = select((1::n), hi :== present[row - 1])
            T[row, 1] = sum(pw[sel] :* r0[sel]) / sum(pw[sel])
            T[row, 2] = sum(pws[sel] :* r1[sel]) / sum(pws[sel])
            T[row, 3] = 100 * (T[row, 2] / T[row, 1] - 1)
            S = S \ (sname, "summary", rlab[row], "mean", "", "")
            V = V \ _cge_ms_rows(., T[row, 1], T[row, 2])
            // standard errors of the mean and of poverty, the group as a
            // subpopulation (from version 0.8.3)
            if (svy) {
                dd = J(n, 1, 0)
                dd[sel] = J(rows(sel), 1, 1)
                z0 = _cge_ms_ratioz(nsz :* r0, nsz, dd, w)
                z1 = _cge_ms_ratioz(nsz :* r1, nsz, dd, ws)
                SEI = SEI \ (rows(V), sqrt(_cge_ms_svyvar((z0, z1, z1 - z0), st, su)))
            }
            // welfare per person, and as per cent of base consumption
            S = S \ (sname, "summary", rlab[row], "ev", "", "") \ (sname, "summary", rlab[row], "cv", "", "")
            V = V \ (., 0, sum(ws[sel] :* ev[sel]) / sum(pws[sel]), 100 * sum(ws[sel] :* ev[sel]) / sum(ws[sel] :* C0[sel])) \
                    (., 0, sum(ws[sel] :* cv[sel]) / sum(pws[sel]), 100 * sum(ws[sel] :* cv[sel]) / sum(ws[sel] :* C0[sel]))
            for (l = 1; l <= nz; l++) {
                a = _cge_ms_pov(r0[sel], pw[sel], Z[sel, l])
                b = _cge_ms_pov(r1[sel], pws[sel], Z[sel, l])
                PT[(l - 1) * nr + row, .] = (a[1], b[1], a[2], b[2], a[3], b[3], a[4], b[4])
                if (l == 1) T[row, (4..9)] = (a[1], b[1], a[2], b[2], a[3], b[3])
                S = S \ (J(4, 1, (sname, "summary", rlab[row])), povn', J(4, 1, (ltok[l], "")))
                V = V \ _cge_ms_rows(J(4, 1, .), a', b')
                if (svy) {
                    for (j = 0; j <= 2; j++) {
                        y0 = (r0 :< Z[., l]) :* (j == 0 ? J(n, 1, 1) : (((Z[., l] - r0) :/ Z[., l]) :^ j))
                        y1 = (r1 :< Z[., l]) :* (j == 0 ? J(n, 1, 1) : (((Z[., l] - r1) :/ Z[., l]) :^ j))
                        z0 = _cge_ms_ratioz(nsz :* y0, nsz, dd, w)
                        z1 = _cge_ms_ratioz(nsz :* y1, nsz, dd, ws)
                        SEI = SEI \ (rows(V) - 3 + j, sqrt(_cge_ms_svyvar((z0, z1, z1 - z0), st, su)))
                    }
                }
            }
            IB[row, .] = _cge_ms_ineq(r0[sel], pw[sel])
            IS[row, .] = _cge_ms_ineq(r1[sel], pws[sel])
            T[row, 10] = IB[row, 1]
            T[row, 11] = IS[row, 1]
            S = S \ (J(9, 1, (sname, "summary", rlab[row])), ineqn', J(9, 2, ""))
            V = V \ _cge_ms_rows(J(9, 1, .), IB[row, .]', IS[row, .]')
        }

        // Incidence by quantile group of base consumption per person: the
        // same persons before and after (from version 0.8.0)
        QT = J(nq, 10, .)
        d = sum(pws :* r1 - pw :* r0)
        for (k = 1; k <= nq; k++) {
            sel = select((1::n), qg :== k)
            QT[k, 1] = (rows(sel) ? sum(pw[sel]) : 0) / sum(pw)
            QT[k, 10] = (rows(sel) ? sum(pws[sel]) : 0) / sum(pws)
            if (!rows(sel)) continue
            QT[k, 2] = sum(pw[sel] :* r0[sel]) / sum(pw[sel])
            QT[k, 3] = sum(pws[sel] :* r1[sel]) / sum(pws[sel])
            QT[k, 4] = 100 * (QT[k, 3] / QT[k, 2] - 1)
            QT[k, 5] = sum(pw[sel] :* r0[sel]) / sum(pw :* r0)
            QT[k, 6] = sum(pws[sel] :* r1[sel]) / sum(pws :* r1)
            if (d != 0) QT[k, 7] = sum(pws[sel] :* r1[sel] - pw[sel] :* r0[sel]) / d
            // the equivalent variation per person, and as per cent of base consumption
            QT[k, 8] = sum(ws[sel] :* ev[sel]) / sum(pws[sel])
            QT[k, 9] = 100 * sum(ws[sel] :* ev[sel]) / sum(ws[sel] :* C0[sel])
        }
        for (k = 1; k <= nq; k++) {
            S = S \ (J(5, 1, (sname, "quantile", "all")), ("popshare" \ "mean" \ "share" \ "inc_abs" \ "ev"), J(5, 2, ""))
            V = V \ _cge_ms_rows(J(4, 1, k), (QT[k, 1] \ QT[k, 2] \ QT[k, 5] \ .), (QT[k, 10] \ QT[k, 3] \ QT[k, 6] \ QT[k, 7])) \
                    (k, 0, QT[k, 8], QT[k, 9])
        }

        // Growth incidence curve: the growth of each percentile of the
        // distribution of persons, from the base to the simulation
        q0 = _cge_wpct(r0, pw, pv)
        q1 = _cge_wpct(r1, pws, pv)
        GT = (q0, q1, 100 :* (q1 :/ q0 :- 1))
        S = S \ (J(99, 1, (sname, "gic", "all", "quantile")), J(99, 2, ""))
        V = V \ _cge_ms_rows(pv, q0, q1)

        // Decomposition of the changes, all households (from version 0.8.1):
        // Shapley values of the channels, from the distributions with every
        // subset of channels switched on, and the growth and redistribution
        // components of poverty (Datt and Ravallion 1992, Shapley form)
        if (decomp) {
            if (income != "") RH = rho[hi, .]
            kap = kappa[hi, 1]
            gi = grp[hi, 1]
            IM = J(2^K, cols(alln), .)
            for (mk = 0; mk < 2^K; mk++) {
                pS = pw
                if (kwt) pS = (_cge_ms_on(mk, kwt) ? pws : pw)
                if (mk == 0) rS = r0
                else if (mk == 2^K - 1) rS = r1
                else {
                    if (income == "") fn = (_cge_ms_on(mk, 1) ? gi : J(n, 1, 1))
                    else {
                        mm = J(1, cols(isrc), 0)
                        for (k = 1; k <= cols(isrc); k++) if (cc[k]) mm[k] = _cge_ms_on(mk, cc[k])
                        Ys = rowsum(Y :* (RH :^ mm))
                        fn = (Y0 :!= 0) :* (Ys :/ (Y0 + (Y0 :== 0))) :* (_cge_ms_on(mk, ktax) ? kap : J(n, 1, 1))
                        if (kgrp) fn = fn + (Y0 :== 0) :* (_cge_ms_on(mk, kgrp) ? gi : J(n, 1, 1))
                        else fn = fn + (Y0 :== 0)
                    }
                    rS = r0 :* fn :/ (_cge_ms_on(mk, kpr) ? P : J(n, 1, 1))
                }
                IM[mk + 1, .] = _cge_ms_all(rS, pS, Z)
            }
            PH = _cge_ms_shapley(IM, K)
            for (j = 1; j <= cols(alln); j++) {
                S = S \ (J(K, 1, (sname, "shapley", "all", alln[j], alll[j])), chn')
                V = V \ _cge_ms_rows(J(K, 1, .), J(K, 1, IM[1, j]), IM[1, j] :+ PH[., j])
            }
            GR = J(4 * nz, 4, .)
            mu0 = sum(pw :* r0) / sum(pw)
            mu1 = sum(pws :* r1) / sum(pws)
            for (l = 1; l <= nz; l++) {
                P00 = _cge_ms_pov(r0, pw, Z[., l])
                P11 = _cge_ms_pov(r1, pws, Z[., l])
                P10 = _cge_ms_pov(r0 :* (mu1 / mu0), pw, Z[., l])
                P01 = _cge_ms_pov(r1 :* (mu0 / mu1), pws, Z[., l])
                k = 4 * (l - 1)
                GR[(k + 1)::(k + 4), .] = (P00', ((P10 - P00) + (P11 - P01))' / 2, ((P01 - P00) + (P11 - P10))' / 2, P11')
                S = S \ (J(8, 1, (sname, "growthred", "all")), (povn' \ povn'), J(8, 1, ltok[l]), (J(4, 1, "growth") \ J(4, 1, "redistribution")))
                V = V \ _cge_ms_rows(J(8, 1, .), (P00' \ P00'), ((P00' + GR[(k + 1)::(k + 4), 2]) \ (P00' + GR[(k + 1)::(k + 4), 3])))
            }
        }

        if (show) {
            printf("\n{txt}Household survey results of simulation {res}%s{txt}: {res}%f{txt} households\n", sname, n)
            printf("{txt}Real consumption per person (base prices); poverty and inequality over persons\n")
            printf("{txt}{hline 98}\n")
            printf("{txt}%-14s %11s %11s %8s %18s %18s %18s\n", "", "base", "simulated", "% chg",
                   (hasline ? "headcount (%)" : ""), (hasline ? "poverty gap (%)" : ""), "Gini (%)")
            printf("{txt}{hline 98}\n")
            for (row = 1; row <= nr; row++) {
                printf("{txt}%-14s {res}%11.4g %11.4g %8.3f", abbrev(rlab[row], 14), T[row, 1], T[row, 2], T[row, 3])
                if (hasline) printf("{res}  %7.2f -> %7.2f  %7.2f -> %7.2f", 100 * T[row, 4], 100 * T[row, 5],
                                    100 * T[row, 6], 100 * T[row, 7])
                else printf("%38s", "")
                printf("{res}  %7.2f -> %7.2f\n", 100 * T[row, 10], 100 * T[row, 11])
            }
            printf("{txt}{hline 98}\n")
            if (hasline) printf("{txt}Poverty line {res}%s{txt} per person; severity (FGT2) is in r(table)%s\n",
                                ltok[1], (nz > 1 ? ", the other lines in r(poverty)" : ""))
            if (hasrw) printf("{txt}Weights reweighted to {res}%f{txt} targets in {res}%f{txt} iterations (largest relative deviation %8.2e)\n",
                              rows(RWT), rwit, rwdev)
            if (svy) printf("{txt}Standard errors from the survey design are in r(se)\n")
            if (detail) _cge_ms_detail(rlab, ltok, PT, IB, IS, QT, nq, V, S, sname)
            if (decomp) _cge_ms_showdec(chn, alln, alll, IM, PH, GR, ltok)
            if (hasf) _cge_ms_showfisc(inst, ty, FCB, FCS, FIB, FIS, FRB, FRS, nz, zl1)
        }

        if (gen != "") {
            // with several simulations, the variables of each are numbered
            sfx = (ns > 1 ? strofreal(si) : "")
            nm = (gen + "_nom", gen + "_price", gen + "_real", gen + "_pc", gen + "_ev", gen + "_cv") :+ sfx
            (void) st_addvar("double", nm)
            st_store(., nm, touse, (C1, P, R, r1, ev, cv))
            st_varlabel(nm[1], "Nominal consumption, simulation " + sname)
            st_varlabel(nm[2], "Household price index, simulation " + sname)
            st_varlabel(nm[3], "Real consumption (base prices), simulation " + sname)
            st_varlabel(nm[4], "Real consumption per person, simulation " + sname)
            st_varlabel(nm[5], "Equivalent variation (base prices), simulation " + sname)
            st_varlabel(nm[6], "Compensating variation, simulation " + sname)
            if (hasrw) {
                (void) st_addvar("double", gen + "_w" + sfx)
                st_store(., gen + "_w" + sfx, touse, ws)
                st_varlabel(gen + "_w" + sfx, "Household weight reweighted to the targets of simulation " + sname)
            }
            if (hasf) {
                nm = (gen + "_ym", gen + "_yn", gen + "_yd", gen + "_yc", gen + "_yf") :+ sfx
                (void) st_addvar("double", nm)
                st_store(., nm, touse, FYS)
                for (k = 1; k <= 5; k++) {
                    st_varlabel(nm[k], ("Market", "Net market", "Disposable", "Consumable", "Final")[k] +
                                " income (base prices), simulation " + sname)
                }
            }
            if (si == 1) {
                (void) st_addvar("double", gen + "_q")
                st_store(., gen + "_q", touse, qg)
                st_varlabel(gen + "_q", "Quantile group of base consumption per person, 1 to " + strofreal(nq))
            }
        }

        // r(): the first simulation
        if (si == 1) {
            st_matrix("r(table)", T)
            st_matrixrowstripe("r(table)", (J(nr, 1, ""), rlab))
            st_matrixcolstripe("r(table)", (J(11, 1, ""), ("mean_base" \ "mean_sim" \ "mean_pct" \ "fgt0_base" \
                               "fgt0_sim" \ "fgt1_base" \ "fgt1_sim" \ "fgt2_base" \ "fgt2_sim" \ "gini_base" \ "gini_sim")))
            if (nz) {
                cn = ("fgt0_base" \ "fgt0_sim" \ "fgt1_base" \ "fgt1_sim" \ "fgt2_base" \ "fgt2_sim" \ "npoor_base" \ "npoor_sim")
                _cge_ms_rmat("r(poverty)", PT, ("line" :+ strofreal(ceil((1::(nz * nr)) :/ nr))), J(nz, 1, rlab), cn)
            }
            cn = vec((ineqn :+ "_base") \ (ineqn :+ "_sim"))
            _cge_ms_rmat("r(inequality)", _cge_ms_interleave(IB, IS), J(nr, 1, ""), rlab, cn)
            _cge_ms_rmat("r(quantiles)", QT, J(nq, 1, ""), "q" :+ strofreal(1::nq),
                         ("popshare" \ "mean_base" \ "mean_sim" \ "mean_pct" \ "share_base" \ "share_sim" \ "inc_abs" \
                          "ev" \ "ev_pct" \ "popshare_sim"))
            if (hasrw) {
                _cge_ms_rmat("r(reweight)", RWT, J(rows(RWT), 1, ""), rwv', ("base" \ "target" \ "achieved" \ "ratio"))
                st_numscalar("r(rw_iterations)", rwit)
                st_numscalar("r(rw_deviation)", rwdev)
            }
            if (svy) {
                // the rows of all households: the mean and FGT0 to FGT2 for each line
                SEA = SEI[|1, 2 \ 1 + 3 * nz, 4|]
                req = "" \ (nz ? ("line" :+ strofreal(ceil((1::(3 * nz)) :/ 3))) : J(0, 1, ""))
                _cge_ms_rmat("r(se)", SEA, req, ("mean" \ (nz ? J(nz, 1, ("fgt0" \ "fgt1" \ "fgt2")) : J(0, 1, ""))),
                             ("se_base" \ "se_sim" \ "se_change"))
            }
            WT = J(nr, 4, .)
            for (row = 1; row <= nr; row++) {
                if (row == 1) sel = (1::n)
                else sel = select((1::n), hi :== present[row - 1])
                WT[row, .] = (sum(w[sel] :* ev[sel]) / sum(pw[sel]), 100 * sum(w[sel] :* ev[sel]) / sum(w[sel] :* C0[sel]),
                              sum(w[sel] :* cv[sel]) / sum(pw[sel]), 100 * sum(w[sel] :* cv[sel]) / sum(w[sel] :* C0[sel]))
            }
            _cge_ms_rmat("r(welfare)", WT, J(nr, 1, ""), rlab, ("ev" \ "ev_pct" \ "cv" \ "cv_pct"))
            if (hasf) {
                cn = ("mean" \ "gini" \ "conc") \ (nz ? ("fgt0" \ "fgt1" \ "fgt2" \ "npoor") : J(0, 1, ""))
                cn = vec((cn' :+ "_base") \ (cn' :+ "_sim"))
                _cge_ms_rmat("r(concepts)", _cge_ms_interleave(FCB[., (1..(3 + 4 * (nz > 0)))], FCS[., (1..(3 + 4 * (nz > 0)))]),
                             J(5, 1, ""), fcl', cn)
                cn = vec((fin :+ "_base") \ (fin :+ "_sim"))
                _cge_ms_rmat("r(instruments)", _cge_ms_interleave(FIB, FIS), J(cols(inst), 1, ""), inst', cn)
                _cge_ms_rmat("r(redistribution)", (FRB, FRS), J(4, 1, ""), ("re" \ "rs" \ "rerank" \ "fi"), ("base" \ "sim"))
                _cge_ms_rmat("r(fshare)", FQSB, J(nq, 1, ""), "q" :+ strofreal(1::nq), inst')
                st_global("r(instlist)", invtokens(inst))
            }
            if (decomp) {
                req = J(rows(alll), 1, "")
                for (j = 1; j <= rows(alll); j++) if (alll[j] != "") req[j] = "line" + strofreal(_cge_find(ltok', alll[j]))
                _cge_ms_rmat("r(shapley)", (IM[1, .]', PH', IM[2^K, .]'), req, alln', ("base" \ chn' \ "sim"))
                if (nz) _cge_ms_rmat("r(growthred)", GR, "line" :+ strofreal(ceil((1::(4 * nz)) :/ 4)), J(nz, 1, povn'),
                                     ("base" \ "growth" \ "redistribution" \ "sim"))
                st_global("r(channels)", invtokens(chn))
            }
            _cge_ms_rmat("r(gic)", GT, J(99, 1, ""), "p" :+ strofreal(pv), ("base" \ "sim" \ "pct"))
            st_numscalar("r(N)", n)
            st_numscalar("r(fgt0_base)", T[1, 4])
            st_numscalar("r(fgt0_sim)", T[1, 5])
            st_numscalar("r(gini_base)", T[1, 10])
            st_numscalar("r(gini_sim)", T[1, 11])
            st_numscalar("r(N_sims)", ns)
            st_numscalar("r(N_lines)", nz)
            st_numscalar("r(N_quantiles)", nq)
            st_global("r(sims)", invtokens(simv))
            st_global("r(lines)", invtokens(ltok))
        }
    }
    // Bands: percentiles 5, 50 and 95 of each measure for all households
    // across the draws, with their standard deviation (from version 0.8.3)
    if (nb) {
        BB = (_cge_ms_all(r0, pw, Z), 0, 0)
        BT = J(cols(BB), 6, .)
        for (j = 1; j <= cols(BB); j++) {
            BT[j, .] = (BB[j], CM[j], _cge_wpct(BM[., j], J(nb, 1, 1), (5 \ 50 \ 95))', (nb > 1 ? sqrt(variance(BM[., j])) : .))
            S = S \ (J(4, 1, (simv[1], "bands", "all", (alln, "ev", "cv")[j], (alll \ "" \ "")[j])), ("p5" \ "p50" \ "p95" \ "sd"))
            V = V \ _cge_ms_rows(J(4, 1, .), J(4, 1, BB[j]), BT[j, (3..6)]')
        }
        req = J(rows(alll) + 2, 1, "")
        for (j = 1; j <= rows(alll); j++) if (alll[j] != "") req[j] = "line" + strofreal(_cge_find(ltok', alll[j]))
        _cge_ms_rmat("r(bands)", BT, req, (alln, "ev", "cv")', ("base" \ "central" \ "p5" \ "p50" \ "p95" \ "sd"))
        st_numscalar("r(N_draws)", nb)
        if (show) _cge_ms_showbands(simv[1], nb, alln, alll, BT, ltok)
    }
    _cge_ms_keep(S, V, SEI)
}

// The bands of option bands() (from version 0.8.3)
void _cge_ms_showbands(string scalar sname, real scalar nb, string rowvector alln, string colvector alll,
                       real matrix BT, string rowvector ltok)
{
    string rowvector lab
    real colvector k
    real scalar j, i
    printf("\n{txt}Bands across {res}%f{txt} draws of the elasticities, simulation {res}%s{txt}, all households\n", nb, sname)
    printf("{txt}{hline 82}\n")
    printf("{txt}%-26s %10s %10s %10s %10s %10s\n", "", "base", "central", "5th", "median", "95th")
    printf("{txt}{hline 82}\n")
    k = 1
    lab = "mean consumption"
    if (cols(ltok)) {
        k = k \ 2 \ 3
        lab = lab, "headcount, line " + ltok[1], "poverty gap, line " + ltok[1]
    }
    k = k \ _cge_find(alln', "gini") \ _cge_find(alln', "theil") \ cols(alln) + 1
    lab = lab, "Gini", "Theil", "EV per person"
    for (i = 1; i <= rows(k); i++) {
        j = k[i]
        printf("{txt}%-26s {res}%10.4g %10.4g %10.4g %10.4g %10.4g\n", abbrev(lab[i], 26), BT[j, 1], BT[j, 2], BT[j, 3],
               BT[j, 4], BT[j, 5])
    }
    printf("{txt}{hline 82}\n")
    printf("{txt}Every measure is in r(bands), with the standard deviation across the draws\n")
}

// The decomposition of option decompose: the contribution of each channel to
// the change in the mean, the poverty measures at the first line and the Gini
// coefficient, and growth and redistribution (from version 0.8.1)
void _cge_ms_showdec(string rowvector chn, string rowvector alln, string colvector alll, real matrix IM,
                     real matrix PH, real matrix GR, string rowvector ltok)
{
    real scalar k, K, jg, j0, j1, j2
    K = cols(chn)
    jg = _cge_find(alln', "gini")
    j0 = (cols(ltok) ? 2 : 0)
    j1 = j0 + 1
    j2 = j0 + 2
    printf("\n{txt}Contributions to the changes, all households (Shapley decomposition by channel)\n")
    printf("{txt}{hline 78}\n")
    printf("{txt}%-16s %14s %16s %16s %12s\n", "channel", "mean (% chg)", (j0 ? "headcount (pts)" : ""),
           (j0 ? "pov. gap (pts)" : ""), "Gini (pts)")
    printf("{txt}{hline 78}\n")
    for (k = 1; k <= K + 1; k++) {
        printf("{txt}%-16s ", (k <= K ? abbrev(chn[k], 16) : "total"))
        printf("{res}%14.4f ", 100 * (k <= K ? PH[k, 1] : IM[2^K, 1] - IM[1, 1]) / IM[1, 1])
        if (j0) printf("{res}%16.4f %16.4f ", 100 * (k <= K ? PH[k, j0] : IM[2^K, j0] - IM[1, j0]),
                       100 * (k <= K ? PH[k, j1] : IM[2^K, j1] - IM[1, j1]))
        else printf("%34s", "")
        printf("{res}%12.4f\n", 100 * (k <= K ? PH[k, jg] : IM[2^K, jg] - IM[1, jg]))
    }
    printf("{txt}{hline 78}\n")
    if (cols(ltok)) {
        printf("{txt}Poverty at line {res}%s{txt}: growth {res}%7.4f{txt} and redistribution {res}%7.4f{txt} points of the headcount\n",
               ltok[1], 100 * GR[1, 2], 100 * GR[1, 3])
    }
    printf("{txt}Every measure and line is in r(shapley) and r(growthred)\n")
}

// Columns of A and B side by side: a1 b1 a2 b2 ...
real matrix _cge_ms_interleave(real matrix A, real matrix B)
{
    real matrix X
    real scalar k
    X = J(rows(A), 2 * cols(A), .)
    for (k = 1; k <= cols(A); k++) {
        X[., 2 * k - 1] = A[., k]
        X[., 2 * k] = B[., k]
    }
    return(X)
}

// The tables of option detail: poverty for every line, inequality and
// incidence by quantile (from version 0.8.0)
void _cge_ms_detail(string colvector rlab, string rowvector ltok, real matrix PT, real matrix IB,
                    real matrix IS, real matrix QT, real scalar nq, real matrix V, string matrix S, string scalar sname)
{
    real colvector kk
    string rowvector lab
    real scalar l, row, k, nr
    nr = rows(rlab)
    if (cols(ltok)) {
        printf("\n{txt}Poverty by line, base -> simulated: headcount, poverty gap and severity in per cent of persons;\n")
        printf("{txt}number of poor persons in units of the weights\n")
        printf("{txt}{hline 98}\n")
        printf("{txt}%-18s %16s  %16s  %16s  %24s\n", "line", "headcount", "poverty gap", "severity", "number poor")
        printf("{txt}{hline 98}\n")
        for (l = 1; l <= cols(ltok); l++) {
            for (row = 1; row <= nr; row++) {
                k = (l - 1) * nr + row
                printf("{txt}%-8s %-9s {res}%6.2f -> %6.2f  %6.2f -> %6.2f  %6.2f -> %6.2f  %10.0fc -> %10.0fc\n",
                       (row == 1 ? abbrev(ltok[l], 8) : ""), abbrev(rlab[row], 9), 100 * PT[k, 1], 100 * PT[k, 2],
                       100 * PT[k, 3], 100 * PT[k, 4], 100 * PT[k, 5], 100 * PT[k, 6], PT[k, 7], PT[k, 8])
            }
        }
        printf("{txt}{hline 98}\n")
    }
    lab = ("Gini", "Theil, GE(1)", "Mean log deviation", "GE(2)", "Atkinson, e = 0.5", "Atkinson, e = 1",
           "Atkinson, e = 2", "Palma", "S80/S20")
    printf("\n{txt}Inequality of consumption per person over persons, all households\n")
    printf("{txt}{hline 56}\n")
    printf("{txt}%-22s %10s %10s %10s\n", "", "base", "simulated", "change")
    printf("{txt}{hline 56}\n")
    for (k = 1; k <= 9; k++) {
        printf("{txt}%-22s {res}%10.5f %10.5f %10.5f\n", lab[k], IB[1, k], IS[1, k], IS[1, k] - IB[1, k])
    }
    printf("{txt}{hline 56}\n")
    // welfare by group, from the rows of the results dataset (from version 0.8.1)
    printf("\n{txt}Equivalent and compensating variations at base prices: per person, and per cent of base consumption\n")
    printf("{txt}{hline 66}\n")
    printf("{txt}%-14s %12s %12s %12s %12s\n", "", "EV", "EV (%)", "CV", "CV (%)")
    printf("{txt}{hline 66}\n")
    for (row = 1; row <= nr; row++) {
        kk = selectindex((S[., 1] :== sname) :& (S[., 2] :== "summary") :& (S[., 3] :== rlab[row]) :&
                         ((S[., 4] :== "ev") :| (S[., 4] :== "cv")))
        printf("{txt}%-14s {res}%12.4g %12.4f %12.4g %12.4f\n", abbrev(rlab[row], 14), V[kk[1], 3], V[kk[1], 4],
               V[kk[2], 3], V[kk[2], 4])
    }
    printf("{txt}{hline 66}\n")
    printf("\n{txt}Incidence by quantile of base consumption per person (same persons before and after)\n")
    printf("{txt}{hline 98}\n")
    printf("{txt}%-9s %9s %12s %12s %8s %22s %14s\n", "quantile", "persons", "mean base", "simulated", "% chg",
           "share of consumption", "share of gain")
    printf("{txt}{hline 98}\n")
    for (k = 1; k <= nq; k++) {
        printf("{txt}%-9s {res}%8.2f%% %12.4g %12.4g %8.3f %9.2f%% -> %7.2f%% %13.2f%%\n", strofreal(k), 100 * QT[k, 1],
               QT[k, 2], QT[k, 3], QT[k, 4], 100 * QT[k, 5], 100 * QT[k, 6], 100 * QT[k, 7])
    }
    printf("{txt}{hline 98}\n")
}

// The results of the last call, for option saving() or clear
void _cge_ms_keep(string matrix S, real matrix V, real matrix SEI)
{
    pointer(string matrix) scalar ps
    pointer(real matrix) scalar pv, pe
    if ((ps = findexternal("cge__mss")) == NULL) ps = crexternal("cge__mss")
    if ((pv = findexternal("cge__msv")) == NULL) pv = crexternal("cge__msv")
    if ((pe = findexternal("cge__mse")) == NULL) pe = crexternal("cge__mse")
    *ps = S
    *pv = V
    *pe = SEI
}

void _cge_ms_drop()
{
    if (findexternal("cge__mss") != NULL) rmexternal("cge__mss")
    if (findexternal("cge__msv") != NULL) rmexternal("cge__msv")
    if (findexternal("cge__mse") != NULL) rmexternal("cge__mse")
}

// The results as a dataset, in the empty dataset in memory: one observation
// per simulation, table, group, measure, line and quantile (from version 0.8.0)
void _cge_ms_post()
{
    pointer(string matrix) scalar ps
    pointer(real matrix) scalar pv, pe
    string matrix S
    string rowvector sv
    real matrix V, E
    real colvector ch, pc
    real scalar k, wd
    ps = findexternal("cge__mss")
    pv = findexternal("cge__msv")
    if (ps == NULL | pv == NULL) _cge_fail("no results of cge_microsim to save", 459)
    S = *ps
    V = *pv
    sv = ("sim", "table", "group", "measure", "line", "channel")
    for (k = 1; k <= 6; k++) {
        wd = max((1, max(strlen(S[., k]))))
        (void) st_addvar("str" + strofreal(wd), sv[k])
    }
    (void) st_addvar("double", ("q", "base", "value", "change", "pct"))
    st_addobs(rows(S))
    st_sstore(., sv, S)
    ch = V[., 3] - V[., 2]
    pc = V[., 4]
    st_store(., ("q", "base", "value", "change", "pct"), (V[., (1..3)], ch, pc))
    // standard errors, from version 0.8.3: of the base, the simulated value
    // and the change
    pe = findexternal("cge__mse")
    if (pe != NULL) {
        E = *pe
        if (rows(E)) {
            (void) st_addvar("double", ("se_base", "se_value", "se_change"))
            st_store(E[., 1], ("se_base", "se_value", "se_change"), E[., (2..4)])
            st_varlabel("se_base", "Standard error of the base value (survey design)")
            st_varlabel("se_value", "Standard error of the simulated value")
            st_varlabel("se_change", "Standard error of the change")
        }
    }
    st_varlabel("sim", "Simulation")
    st_varlabel("table", "Table: summary, quantile, gic, shapley, growthred, fiscal, fiscalq, reweight or bands")
    st_varlabel("group", "Household group (all: every household)")
    st_varlabel("measure", "Measure")
    st_varlabel("line", "Poverty line")
    st_varlabel("channel", "Channel, component, income concept or fiscal instrument")
    st_varlabel("q", "Quantile group (quantile) or percentile (gic)")
    st_varlabel("base", "Base value")
    st_varlabel("value", "Value in the simulation")
    st_varlabel("change", "Change, simulated minus base")
    st_varlabel("pct", "Per cent change (ev, cv: per cent of base consumption)")
    _cge_ms_drop()
}

// =====================================================================
// Elasticity library (from version 0.3.5; docs/elasticities.md)
// =====================================================================

string rowvector _cge_elas_fields()
{
    return(("id", "parameter", "country", "country_name", "category", "value", "se", "lower", "upper",
            "published", "definition", "method", "observations", "period", "source", "location", "check",
            "notes"))
}

string rowvector _cge_elas_srcfields()
{
    return(("source", "authors", "year", "title", "publication", "url", "version"))
}

// A CSV file as a string matrix with the columns cols, in that order. The
// columns in req must be present; the others are empty when missing. Empty
// fields, which the fast path of _cge_split() returns as ".", are empty.
string matrix _cge_csv_table(string scalar fn, string rowvector cols, string rowvector req)
{
    string colvector lines
    string rowvector head, f
    string matrix out
    real rowvector pos
    real scalar i, k
    lines = _cge_split(_cge_readfile(fn), char(10), "")'
    lines = select(lines, strtrim(lines) :!= "")
    if (rows(lines) == 0) _cge_fail(fn + " is empty", 459)
    head = strlower(_cge_unquote(_cge_split(lines[1], ",", `""""')))
    pos = J(1, cols(cols), 0)
    for (i = 1; i <= cols(cols); i++) {
        for (k = 1; k <= cols(head); k++) if (head[k] == cols[i]) pos[i] = k
    }
    for (i = 1; i <= cols(req); i++) {
        if (!anyof(head, req[i])) _cge_fail(fn + " has no column " + req[i], 459)
    }
    out = J(rows(lines) - 1, cols(cols), "")
    for (k = 2; k <= rows(lines); k++) {
        f = _cge_unquote(_cge_split(lines[k], ",", `""""'))
        if (cols(f) != cols(head)) {
            _cge_fail("line " + strofreal(k) + " of " + fn + " has " + strofreal(cols(f)) + " fields; the header has " +
                      strofreal(cols(head)), 459)
        }
        for (i = 1; i <= cols(cols); i++) if (pos[i]) out[k - 1, i] = (f[pos[i]] == "." ? "" : f[pos[i]])
    }
    return(out)
}

// The library: the package's entries and, if given, a user's file
string matrix _cge_elas_load(string scalar libfn, string scalar userfn)
{
    string matrix E, U
    string rowvector req
    string colvector ids
    real scalar k
    req = ("id", "parameter", "country", "category", "value", "source")
    E = _cge_csv_table(libfn, _cge_elas_fields(), req)
    if (userfn != "") {
        U = _cge_csv_table(userfn, _cge_elas_fields(), req)
        if (rows(U) == 0) _cge_fail(userfn + " has no entries", 459)
        E = E \ U
    }
    E[., 2] = strlower(E[., 2])
    E[., 3] = strupper(E[., 3])
    E[., 5] = strlower(E[., 5])
    ids = sort(E[., 1], 1)
    for (k = 2; k <= rows(ids); k++) {
        if (ids[k] == ids[k - 1]) _cge_fail("elasticity library: entry " + ids[k] + " appears more than once", 459)
    }
    if (hasmissing(strtoreal(E[., 6]))) _cge_fail("elasticity library: every entry needs a numeric value", 459)
    return(E)
}

// Entries that match every filter given (a list of values for each column)
real colvector _cge_elas_match(string matrix E, string scalar par, string scalar ctry, string scalar cat,
                               string scalar src, string scalar ids)
{
    real colvector keep
    keep = J(rows(E), 1, 1)
    if (par != "") keep = keep :& (E[., 2] :== strlower(par))
    if (ctry != "") keep = keep :& _cge_elas_in(E[., 3], strupper(ctry))
    if (cat != "") keep = keep :& _cge_elas_in(E[., 5], strlower(cat))
    if (src != "") keep = keep :& _cge_elas_in(strupper(E[., 15]), strupper(src))
    if (ids != "") keep = keep :& _cge_elas_in(strupper(E[., 1]), strupper(ids))
    return(keep)
}

// Text cut to n characters (abbrev() is for names and treats periods specially)
string scalar _cge_trunc(string scalar s, real scalar n)
{
    return(strlen(s) <= n ? s : substr(s, 1, n - 2) + "..")
}

real colvector _cge_elas_in(string colvector v, string scalar list)
{
    string rowvector tok
    real colvector out
    real scalar k
    tok = tokens(list)
    out = J(rows(v), 1, 0)
    for (k = 1; k <= cols(tok); k++) out = out :| (v :== tok[k])
    return(out)
}

// List, load or turn into option values the entries of the library that
// match the filters (cge_elasticities)
void _cge_elas(string scalar par, string scalar ctry, string scalar cat, string scalar src, string scalar ids,
               string scalar libfn, string scalar srcfn, string scalar userfn, real scalar load,
               real scalar values, string scalar map, string scalar others)
{
    string matrix E, S, D
    real colvector keep, sel, si
    string rowvector names, loc
    real scalar k, n, j, w

    E = _cge_elas_load(libfn, userfn)
    S = _cge_csv_table(srcfn, _cge_elas_srcfields(), ("source", "authors", "year", "title"))
    keep = _cge_elas_match(E, par, ctry, cat, src, ids)
    sel = selectindex(keep)
    if (rows(sel) == 0) _cge_fail("no entry of the elasticity library matches", 111)
    if (values) {
        _cge_elas_values(E, S, sel, par, map, others)
        return
    }
    n = rows(sel)
    st_numscalar("r(N)", n)
    st_global("r(ids)", invtokens(E[sel, 1]'))
    if (load) {
        // Entries with the details of their sources
        names = _cge_elas_fields(), ("authors", "year", "title", "publication", "url")
        D = J(n, cols(names), "")
        D[., (1..18)] = E[sel, .]
        for (k = 1; k <= n; k++) {
            si = selectindex(S[., 1] :== E[sel[k], 15])
            if (rows(si)) D[k, (19..23)] = S[si[1], (2..6)]
        }
        st_addobs(n)
        for (j = 1; j <= cols(names); j++) {
            if (anyof(("value", "se", "lower", "upper"), names[j])) {
                (void) st_addvar("double", names[j])
                st_store(., names[j], strtoreal(D[., j]))
            }
            else {
                w = max((1, max(strlen(D[., j]))))
                (void) st_addvar((w > 244 ? "strL" : "str" + strofreal(w)), names[j])
                st_sstore(., names[j], D[., j])
            }
        }
        st_varlabel("id", "Library entry")
        st_varlabel("parameter", "Parameter (cge_calibrate option)")
        st_varlabel("country", "Country (ISO 3166 alpha-3) or group")
        st_varlabel("value", "Value, in the package's convention")
        st_varlabel("published", "Value as published")
        st_varlabel("location", "Location in the source")
        printf("{txt}%f entr%s of the elasticity library loaded\n", n, (n == 1 ? "y" : "ies"))
        return
    }
    // Entries, with the location up to its first semicolon
    w = min((32, max(strlen(E[sel, 1])))) + 1
    printf("\n{txt}%-" + strofreal(w) + "s %-9s %-4s %-12s %8s %7s  %s\n", "Entry", "Parameter", "Ctry",
           "Category", "Value", "S.e.", "Source, location")
    printf("{txt}{hline " + strofreal(w + 92) + "}\n")
    for (k = 1; k <= min((n, 60)); k++) {
        j = sel[k]
        loc = tokens(E[j, 16], ";")
        printf("{res}%-" + strofreal(w) + "s {txt}%-9s %-4s %-12s {res}%8s %7s  {txt}%s, %s\n", E[j, 1], E[j, 2],
               E[j, 3], _cge_trunc(E[j, 5], 12), E[j, 6], E[j, 7], E[j, 15], (cols(loc) ? _cge_trunc(loc[1], 48) : ""))
    }
    printf("{txt}{hline " + strofreal(w + 92) + "}\n")
    if (n > 60) printf("{txt}The first 60 of %f entries are shown; {cmd:clear} loads them all\n", n)
    printf("{txt}{cmd:clear} loads the entries with their definitions, notes and sources\n")
}

// Values for cge_calibrate: one per commodity (sigmaq, sigmat, incelas), one
// per activity (sigmava), or one number (frisch, wagecurve, mortelas,
// sickelas). Commodities and activities take the single matching entry, or
// the entry of the category that map() or others() gives them.
void _cge_elas_values(string matrix E, string matrix S, real colvector sel, string scalar par,
                      string scalar map, string scalar others)
{
    struct cge_model scalar M
    string colvector elem, cat, used, id
    string rowvector tok
    string scalar p, out, kind
    real colvector hit, s1
    real scalar k, pos, i, n

    p = strlower(par)
    if (p == "") _cge_fail("values needs a parameter, for example cge_elasticities sigmaq, values", 198)
    if (anyof(("sigmaq", "sigmat", "incelas"), p)) kind = "commodities"
    else if (p == "sigmava") kind = "activities"
    else if (anyof(("frisch", "wagecurve", "mortelas", "sickelas"), p)) kind = ""
    else _cge_fail(par + " is not a parameter that values can set (sigmaq sigmat incelas sigmava frisch wagecurve mortelas sickelas)", 198)
    if (kind == "") {
        if (map != "" | others != "") _cge_fail("map() and others() apply to sigmaq, sigmat, incelas and sigmava", 198)
        if (rows(sel) != 1) {
            _cge_fail(strofreal(rows(sel)) + " entries match; choose one with id(), country() or category(): " +
                      invtokens(E[sel, 1]'), 459)
        }
        out = E[sel[1], 6]
        id = E[sel[1], 1]
    }
    else {
        M = _cge_load()
        _cge_need(M, "mapped")
        elem = (kind == "commodities" ? M.C : M.A)
        n = rows(elem)
        cat = J(n, 1, strlower(others))
        tok = tokens(map)
        for (k = 1; k <= cols(tok); k++) {
            pos = strpos(tok[k], ":")
            if (!pos) _cge_fail("map() entries take the form " + (kind == "commodities" ? "commodity" : "activity") + ":category", 198)
            i = _cge_find(elem, substr(tok[k], 1, pos - 1))
            if (!i) _cge_fail("map(): " + substr(tok[k], 1, pos - 1) + " is not one of the model's " + kind, 111)
            cat[i] = strlower(substr(tok[k], pos + 1, .))
        }
        id = J(n, 1, "")
        out = ""
        for (k = 1; k <= n; k++) {
            hit = sel
            if (cat[k] != "") hit = select(sel, E[sel, 5] :== cat[k])
            if (rows(hit) == 0) {
                _cge_fail(elem[k] + ": no matching entry" + (cat[k] != "" ? " in category " + cat[k] : "") +
                          (map == "" & others == "" ? "" : "; give its category in map() or others()"), 111)
            }
            if (rows(hit) > 1) {
                _cge_fail(elem[k] + ": " + strofreal(rows(hit)) + " entries match (" + invtokens(E[hit, 1]') +
                          "); narrow the choice with country(), category(), map() or others()", 459)
            }
            id[k] = E[hit[1], 1]
            out = out + (k > 1 ? " " : "") + E[hit[1], 6]
        }
    }
    // What was chosen, with the definitions and notes of the entries used
    used = uniqrows(id)
    printf("{txt}%s: {res}%s\n", p, out)
    for (k = 1; k <= rows(used); k++) {
        hit = selectindex(E[., 1] :== used[k])
        i = hit[1]
        s1 = selectindex(S[., 1] :== E[i, 15])
        printf("{txt}  {res}%s{txt} (%s): %s\n", E[i, 1], E[i, 3], E[i, 11])
        printf("{txt}    %s%s, %s\n", E[i, 15], (rows(s1) ? " (" + S[s1[1], 2] + " " + S[s1[1], 3] + ")" : ""), E[i, 16])
        if (E[i, 18] != "") printf("{txt}    Note: %s\n", E[i, 18])
    }
    st_global("r(values)", out)
    st_global("r(ids)", invtokens(id'))
    st_global("r(parameter)", p)
    st_numscalar("r(N)", rows(id))
}

// =====================================================================
// SAM multipliers (from version 0.4.1; docs/sam_tools.md, Section 6)
// =====================================================================

// Endogenous accounts (positions in the mapped SAM) and their blocks: 1
// production (activities, commodities, margin accounts), 2 factors, 3
// institutions (households, enterprises and the accounts in endogenous())
void _cge_mult_accounts(struct cge_model scalar M, string scalar s_endo, string scalar s_exo,
                        real colvector idx, real colvector blk)
{
    string rowvector tok
    real colvector keep
    real scalar k, a
    idx = M.iA \ M.iC \ M.iT \ M.iF \ M.iH \ M.iE
    blk = J(rows(M.iA) + rows(M.iC) + rows(M.iT), 1, 1) \ J(rows(M.iF), 1, 2) \ J(rows(M.iH) + rows(M.iE), 1, 3)
    tok = tokens(s_exo)
    for (k = 1; k <= cols(tok); k++) {
        a = _cge_find(M.labels, tok[k])
        if (!a) _cge_fail("exogenous(): " + tok[k] + " is not an account of the SAM", 111)
        if (!anyof(idx, a)) _cge_fail("exogenous(): " + tok[k] + " is not an endogenous account", 198)
        keep = (idx :!= a)
        idx = select(idx, keep)
        blk = select(blk, keep)
    }
    tok = tokens(s_endo)
    for (k = 1; k <= cols(tok); k++) {
        a = _cge_find(M.labels, tok[k])
        if (!a) _cge_fail("endogenous(): " + tok[k] + " is not an account of the SAM", 111)
        if (anyof(idx, a)) _cge_fail("endogenous(): " + tok[k] + " is already endogenous", 198)
        idx = idx \ a
        blk = blk \ 3
    }
    if (rows(idx) == 0) _cge_fail("no endogenous accounts", 198)
}

// 1 where an endogenous account is in the set of positions set
real colvector _cge_mult_mask(real colvector idx, real colvector set)
{
    real colvector out
    real scalar k
    out = J(rows(idx), 1, 0)
    for (k = 1; k <= rows(idx); k++) out[k] = anyof(set, idx[k])
    return(out)
}

void _cge_mult(string scalar s_endo, string scalar s_exo, string scalar s_inj, real scalar decomp,
               string scalar s_acc, real scalar load)
{
    struct cge_model scalar M
    real colvector idx, blk, t, x, dy, mA, mF, mH, show, tot, outp, va, hh, rr, cc, vv
    real matrix A, Ma, In, B1, B2, same, circ, off, At, As, M1, M2, M3, T, O, C
    string colvector L, bname, names3
    string rowvector tok
    real scalar n, k, i, j, pos, w, nshow, nbad
    string scalar lab

    M = _cge_load()
    _cge_need(M, "sam")
    _cge_need(M, "mapped")
    _cge_mult_accounts(M, s_endo, s_exo, idx, blk)
    n = rows(idx)
    L = M.labels[idx]
    names3 = ("production" \ "factors" \ "institutions")
    bname = names3[blk]
    t = colsum(M.S)'
    t = t[idx]
    // Average expenditure propensities; an account without payments has none
    A = M.S[idx, idx] :/ (t' + (t' :== 0))
    In = I(n)
    Ma = luinv(In - A)
    if (hasmissing(Ma)) {
        _cge_fail("I - A is singular: some payments among the endogenous accounts never leak to an exogenous account; make one of them exogenous", 459)
    }
    // The effects of injections are shown without the decomposition, which
    // therefore does not need the circular structure (from version 0.6.4)
    if (s_inj != "") decomp = 0
    if (decomp) {
        B1 = blk * J(1, n, 1)
        B2 = J(n, 1, 1) * blk'
        same = (B1 :== B2)
        circ = ((B1 :== 2) :& (B2 :== 1)) :| ((B1 :== 3) :& (B2 :== 2)) :| ((B1 :== 1) :& (B2 :== 3))
        off = (1 :- same) :* (1 :- circ) :* (abs(A) :> 1e-12)
        if (any(off)) {
            errprintf("decompose: the SAM has flows outside the circular structure production -> factors -> institutions -> production:\n")
            nbad = 0
            for (j = 1; j <= n; j++) {
                for (i = 1; i <= n; i++) {
                    if (off[i, j] & nbad < 10) {
                        errprintf("  %s (%s) pays %s (%s): %g\n", L[j], bname[j], L[i], bname[i], M.S[idx[i], idx[j]])
                        nbad++
                    }
                }
            }
            exit(459)
        }
        At = A :* same
        M1 = luinv(In - At)
        As = M1 * (A - At)
        M2 = In + As + As * As
        M3 = luinv(In - As * As * As)
        T = M1 - In
        O = (M2 - In) * M1
        C = (M3 - In) * M2 * M1
    }
    mA = _cge_mult_mask(idx, M.iA)
    mF = _cge_mult_mask(idx, M.iF)
    mH = _cge_mult_mask(idx, M.iH)
    st_numscalar("r(N_endogenous)", n)
    st_global("r(endogenous)", invtokens(L'))

    // Injections
    if (s_inj != "") {
        x = J(n, 1, 0)
        tok = tokens(s_inj)
        for (k = 1; k <= cols(tok); k++) {
            pos = strpos(tok[k], ":")
            if (!pos) _cge_fail("inject() entries take the form account:value", 198)
            lab = substr(tok[k], 1, pos - 1)
            i = _cge_find(L, lab)
            if (!i) _cge_fail("inject(): " + lab + " is not an endogenous account", 198)
            x[i] = x[i] + strtoreal(substr(tok[k], pos + 1, .))
            if (hasmissing(x)) _cge_fail("inject(): " + tok[k] + " needs a number", 198)
        }
        dy = Ma * x
        w = max((12, max(strlen(L)))) + 1
        printf("\n{txt}Effects of the injection (fixed prices)\n")
        printf("{txt}%-" + strofreal(w) + "s %-13s %12s %12s %9s\n", "Account", "Block", "Base income", "Change", "% change")
        printf("{txt}{hline " + strofreal(w + 50) + "}\n")
        for (k = 1; k <= n; k++) {
            printf("{txt}%-" + strofreal(w) + "s %-13s {res}%12.4g %12.4g %9.3f\n", L[k], bname[k], t[k], dy[k],
                   (t[k] != 0 ? 100 * dy[k] / abs(t[k]) : .))
        }
        printf("{txt}{hline " + strofreal(w + 50) + "}\n")
        printf("{txt}Injection {res}%g{txt}; gross output {res}%g{txt}; value added {res}%g{txt}; household income {res}%g\n",
               sum(x), mA' * dy, mF' * dy, mH' * dy)
        st_numscalar("r(injection)", sum(x))
        st_numscalar("r(output)", mA' * dy)
        st_numscalar("r(value_added)", mF' * dy)
        st_numscalar("r(household_income)", mH' * dy)
        st_numscalar("r(total)", sum(dy))
        if (load) {
            st_addobs(n)
            (void) st_addvar("str32", "account")
            (void) st_addvar("str12", "block")
            (void) st_addvar("double", ("base", "change", "pct"))
            st_sstore(., "account", L)
            st_sstore(., "block", bname)
            st_store(., "base", t)
            st_store(., "change", dy)
            st_store(., "pct", 100 :* dy :/ abs(t) :/ (t :!= 0))
            st_varlabel("base", "Income in the SAM (column total)")
            st_varlabel("change", "Change from the injection")
            st_varlabel("pct", "Per cent change")
        }
        return
    }

    // Multipliers by injected account
    tot = colsum(Ma)'
    outp = (mA' * Ma)'
    va = (mF' * Ma)'
    hh = (mH' * Ma)'
    show = J(n, 1, 0)
    if (s_acc != "") {
        tok = tokens(s_acc)
        for (k = 1; k <= cols(tok); k++) {
            i = _cge_find(L, tok[k])
            if (!i) _cge_fail("accounts(): " + tok[k] + " is not an endogenous account", 198)
            show[i] = 1
        }
    }
    else if (n <= 40) show = J(n, 1, 1)
    else show = _cge_mult_mask(idx, M.iC) :| mH
    nshow = sum(show)
    w = max((12, max(strlen(select(L, show))))) + 1
    printf("\n{txt}Accounting multipliers: effects of a unit injection into each account (fixed prices)\n")
    printf("{txt}%-" + strofreal(w) + "s %-13s %9s %9s %9s %9s", "Injection", "Block", "Total", "Output", "Value add.", "Hh income")
    if (decomp) printf("{txt} %9s %9s %9s", "Transfer", "Open loop", "Closed")
    printf("\n{txt}{hline " + strofreal(w + 54 + 30 * decomp) + "}\n")
    if (decomp) {
        rr = colsum(T)'
        cc = colsum(O)'
        vv = colsum(C)'
    }
    for (k = 1; k <= n; k++) {
        if (!show[k]) continue
        printf("{txt}%-" + strofreal(w) + "s %-13s {res}%9.3f %9.3f %9.3f %9.3f", L[k], bname[k], tot[k], outp[k], va[k], hh[k])
        if (decomp) printf("{res} %9.3f %9.3f %9.3f", rr[k], cc[k], vv[k])
        printf("\n")
    }
    printf("{txt}{hline " + strofreal(w + 54 + 30 * decomp) + "}\n")
    printf("{txt}Total: all endogenous accounts; output: activities; value added: factors; household income: households\n")
    if (decomp) printf("{txt}Total = 1 + transfer + open loop + closed loop (Pyatt and Round 1979)\n")
    if (nshow < n) printf("{txt}%f of %f injections shown; {cmd:accounts()} chooses them and {cmd:clear} loads the matrix\n", nshow, n)

    if (load) {
        st_addobs(n * n)
        (void) st_addvar("str32", ("row", "column"))
        (void) st_addvar("str12", ("row_block", "column_block"))
        (void) st_addvar("double", "multiplier")
        st_sstore(., "row", J(n, 1, L))
        st_sstore(., "column", colshape(J(1, n, L), 1))
        st_sstore(., "row_block", J(n, 1, bname))
        st_sstore(., "column_block", colshape(J(1, n, bname), 1))
        st_store(., "multiplier", vec(Ma))
        if (decomp) {
            (void) st_addvar("double", ("transfer", "open_loop", "closed_loop"))
            st_store(., "transfer", vec(T))
            st_store(., "open_loop", vec(O))
            st_store(., "closed_loop", vec(C))
        }
        st_varlabel("row", "Account whose income changes")
        st_varlabel("column", "Account injected")
        st_varlabel("multiplier", "Change in income of row per unit injected into column")
    }
}

// =====================================================================
// Structural path analysis (from version 0.4.2; docs/sam_tools.md, Section 7)
// =====================================================================

// Elementary paths from the last pole of path to pole j, depth first: each
// found path is a row of P (its poles, padded with zeros) with its direct
// influence in D. A path is dropped, with its extensions, once its direct
// influence falls below floor in absolute value; paths have at most maxlen
// arcs. Mata passes P and D by address, so the calls add to them.
void _cge_spa_extend(real matrix A, real scalar j, real rowvector path, real scalar d, real scalar floor,
                     real scalar maxlen, real matrix P, real colvector D)
{
    real scalar c, k, a, dk
    c = path[cols(path)]
    for (k = 1; k <= rows(A); k++) {
        a = A[k, c]
        if (a == 0) continue
        if (anyof(path, k)) continue
        dk = d * a
        if (abs(dk) < floor) continue
        if (k == j) {
            P = P \ (path, k, J(1, maxlen - cols(path), 0))
            D = D \ dk
            if (rows(D) > 100000) {
                _cge_fail("more than 100,000 paths: raise threshold() or lower maxlength()", 459)
            }
        }
        else if (cols(path) <= maxlen - 1) _cge_spa_extend(A, j, (path, k), dk, floor, maxlen, P, D)
    }
}

void _cge_spa(string scalar from, string scalar to, real scalar maxlen, real scalar threshold, real scalar top,
              string scalar s_endo, string scalar s_exo, real scalar load)
{
    struct cge_model scalar M
    real colvector idx, blk, t, D, Mp, T, o, poles
    real matrix A, Ma, P
    string colvector L, ps
    real scalar n, i, j, glob, k, np, expl
    string scalar s

    M = _cge_load()
    _cge_need(M, "sam")
    _cge_need(M, "mapped")
    _cge_mult_accounts(M, s_endo, s_exo, idx, blk)
    n = rows(idx)
    L = M.labels[idx]
    t = colsum(M.S)'
    t = t[idx]
    A = M.S[idx, idx] :/ (t' + (t' :== 0))
    Ma = luinv(I(n) - A)
    if (hasmissing(Ma)) {
        _cge_fail("I - A is singular: some payments among the endogenous accounts never leak to an exogenous account; make one of them exogenous", 459)
    }
    i = _cge_find(L, from)
    j = _cge_find(L, to)
    if (!i) _cge_fail("from(): " + from + " is not an endogenous account", 198)
    if (!j) _cge_fail("to(): " + to + " is not an endogenous account", 198)
    if (i == j) _cge_fail("from() and to() must differ", 198)
    glob = Ma[j, i]
    P = J(0, maxlen + 1, 0)
    D = J(0, 1, .)
    _cge_spa_extend(A, j, i, 1, threshold * abs(glob), maxlen, P, D)
    np = rows(D)
    Mp = J(np, 1, .)
    ps = J(np, 1, "")
    for (k = 1; k <= np; k++) {
        poles = select(P[k, .], P[k, .] :!= 0)'
        Mp[k] = det(Ma[poles, poles])
        ps[k] = invtokens(L[poles]', " > ")
    }
    T = D :* Mp
    expl = sum(T)
    o = order((-abs(T), (1::np)), (1, 2))

    printf("\n{txt}Structural paths from {res}%s{txt} to {res}%s{txt} (Defourny and Thorbecke 1984)\n", from, to)
    printf("{txt}Global influence (the multiplier): {res}%9.4g\n", glob)
    printf("{txt}%f path%s with at most %f arcs and a direct influence of at least %g times the global influence\n",
           np, (np == 1 ? "" : "s"), maxlen, threshold)
    if (np) {
        printf("{txt}{hline 78}\n")
        printf("{txt}%10s %10s %10s %8s  %s\n", "Total", "Direct", "Path mult.", "% global", "Path")
        printf("{txt}{hline 78}\n")
        for (k = 1; k <= min((np, top)); k++) {
            s = ps[o[k]]
            printf("{res}%10.4g %10.4g %10.4f %8.2f  {txt}%s\n", T[o[k]], D[o[k]], Mp[o[k]],
                   (glob != 0 ? 100 * T[o[k]] / glob : .), s)
        }
        printf("{txt}{hline 78}\n")
        if (np > top) printf("{txt}The %f largest of %f paths are shown; {cmd:clear} loads them all\n", top, np)
        printf("{txt}The %f paths explain {res}%6.2f{txt} per cent of the global influence\n", np,
               (glob != 0 ? 100 * expl / glob : .))
    }
    st_numscalar("r(global)", glob)
    st_numscalar("r(N_paths)", np)
    st_numscalar("r(explained)", expl)
    st_numscalar("r(share)", (glob != 0 ? 100 * expl / glob : .))
    if (np) {
        st_global("r(path1)", ps[o[1]])
        st_numscalar("r(total1)", T[o[1]])
    }
    if (load) {
        if (np) st_addobs(np)
        k = (np ? max(strlen(ps)) : 1)
        (void) st_addvar((k > 244 ? "strL" : "str" + strofreal(k)), "path")
        (void) st_addvar("double", ("length", "direct", "multiplier", "total", "share"))
        if (np) {
            st_sstore(., "path", ps[o])
            st_store(., "length", rowsum(P[o, .] :!= 0) :- 1)
            st_store(., "direct", D[o])
            st_store(., "multiplier", Mp[o])
            st_store(., "total", T[o])
            st_store(., "share", 100 :* T[o] :/ glob)
        }
        st_varlabel("path", "Path from " + from + " to " + to)
        st_varlabel("length", "Number of arcs")
        st_varlabel("direct", "Direct influence")
        st_varlabel("multiplier", "Path multiplier")
        st_varlabel("total", "Total influence")
        st_varlabel("share", "Per cent of the global influence")
    }
}

// =====================================================================
// Bounds and complementarity (from version 0.4.4; model_spec.md, Section 16)
// =====================================================================

// Labels of the elements of index set s
string colvector _cge_setlab(struct cge_model scalar M, string scalar s)
{
    real scalar k
    if (substr(s, 1, 1) == "~") {
        k = _cge_us_find(M, substr(s, 2, .))
        if (!k) _cge_fail("user set " + substr(s, 2, .) + " is not defined", 111)
        return(_cge_us_labels(M, k))
    }
    if (s == "A") return(M.A)
    if (s == "C") return(M.C)
    if (s == "F") return(M.F)
    if (s == "H") return(M.H)
    if (s == "D") return(M.D)
    if (s == "N") return(M.N)
    return(M.I)
}

// A variable element by its position in the stacked vector, as NAME(e1,e2)
string scalar _cge_poslabel(struct cge_model scalar M, real scalar pos)
{
    string colvector e1, e2
    real scalar k, i
    for (k = rows(M.voff); k > 1; k--) if (M.voff[k] < pos) break
    i = pos - M.voff[k]
    _cge_vlabels(M, k, e1, e2)
    if (e1[i] == "") return(M.vname[k])
    return(M.vname[k] + "(" + e1[i] + (e2[i] == "" ? "" : "," + e2[i]) + ")")
}

// Positions of the elements of variable k given in elems: all existing
// elements of a variable with one index when elems is empty
real colvector _cge_cons_pos(struct cge_model scalar M, real scalar k, string scalar elems)
{
    string scalar set, s1, s2
    string rowvector tok
    real colvector pos, idx
    real scalar i, j
    set = M.vset[k]
    tok = tokens(elems)
    if (set == "") {
        if (cols(tok)) _cge_fail(M.vname[k] + " has no elements", 198)
        return(M.voff[k] + 1)
    }
    if (_cge_nidx(set) == 1) {
        if (!cols(tok)) {
            pos = _cge_vpos(M, k)
            return(select(pos, M.exists[pos]))
        }
        idx = _cge_elements(_cge_setlab(M, set), elems, "elements of " + M.vname[k])
        return(M.voff[k] :+ idx)
    }
    if (cols(tok) == 1) tok = tokens(subinstr(tok[1], ".", " "))
    if (cols(tok) != 2) _cge_fail(M.vname[k] + " has two indexes: give one element of each", 198)
    _cge_setparts(set, s1, s2)
    i = _cge_find(_cge_setlab(M, s1), tok[1])
    j = _cge_find(_cge_setlab(M, s2), tok[2])
    if (!i | !j) _cge_fail(tok[1] + " " + tok[2] + " is not an element of " + M.vname[k], 111)
    return(M.voff[k] + (i - 1) * M.vcols[k] + j)
}

// Names of the recipients of rents, in the order of the codes
string colvector _cge_recipients(struct cge_model scalar M)
{
    if (_cge_sa(M)) return(J(0, 1, ""))
    return(M.F \ M.D \ M.labels[M.igov] \ M.labels[M.irow])
}

// Code of the recipient of the rent at position pos, or 0 for other variables
real scalar _cge_rentcode(struct cge_model scalar M, struct cge_par scalar p, real scalar pos)
{
    real scalar k, i
    if (_cge_sa(M)) return(0)
    for (k = rows(M.voff); k > 1; k--) if (M.voff[k] < pos) break
    i = pos - M.voff[k]
    if (M.vname[k] == "RM") return(p.rrm[i])
    if (M.vname[k] == "RE") return(p.rre[i])
    if (M.vname[k] == "RA") return(p.rra[i])
    return(0)
}

// One constraint, as text: bound, adjusting variable and, after a solve, the
// regime
string scalar _cge_cons_one(struct cge_model scalar M, struct cge_par scalar p, real colvector x, real scalar k)
{
    string scalar s, ly, lx
    string colvector rec
    real scalar code
    s = _cge_poslabel(M, M.bY[k]) + (M.btype[k] == 1 ? " <= " : " >= ") + strtrim(sprintf("%12.0g", p.bval[k])) +
        ", " + _cge_poslabel(M, M.bX[k]) + (M.bdir[k] == 1 ? " up" : " down")
    // user inequalities and bounds of user variables (from version 0.9.0)
    ly = _cge_poslabel(M, M.bY[k])
    lx = _cge_poslabel(M, M.bX[k])
    if (substr(ly, 1, 3) == "_S_") s = "inequality " + substr(ly, 4, .) + ", " + lx + (M.bdir[k] == 1 ? " up" : " down")
    else if (substr(lx, 1, 3) == "_L_" | substr(lx, 1, 3) == "_U_") {
        s = ly + (M.btype[k] == 1 ? " <= " : " >= ") + strtrim(sprintf("%12.0g", p.bval[k])) + ", bound of a user variable"
    }
    code = _cge_rentcode(M, p, M.bX[k])
    rec = _cge_recipients(M)
    if (code) s = s + ", rents to " + rec[code]
    if (p.bmode[k] == 2) s = s + ": binding"
    else if (p.bmode[k] == 3) s = s + ": not binding"
    else if (p.bmode[k] == 1) s = s + ": not solved"
    return(s)
}

// The active constraints of a solution, as text ("" if none)
string scalar _cge_cons_text(struct cge_model scalar M, struct cge_par scalar p, real colvector x)
{
    string scalar s
    real scalar k
    s = ""
    for (k = 1; k <= rows(M.bY); k++) {
        if (rows(p.bmode) < k) break
        if (p.bmode[k] <= 0) continue
        s = s + (s == "" ? "" : "; ") + _cge_cons_one(M, p, x, k)
    }
    return(s)
}

// The constraints of a solution, with the values of their variables
void _cge_cons_show(struct cge_model scalar M, struct cge_par scalar p, real colvector x)
{
    real scalar k
    if (!any(p.bmode :> 0)) return
    printf("{txt}Constraints\n")
    for (k = 1; k <= rows(M.bY); k++) {
        if (p.bmode[k] <= 0) continue
        printf("{txt}  %s\n", _cge_cons_one(M, p, x, k))
        printf("{txt}      %s = {res}%12.0g{txt};  %s = {res}%12.0g\n", _cge_poslabel(M, M.bY[k]), x[M.bY[k]],
               _cge_poslabel(M, M.bX[k]), x[M.bX[k]])
    }
}

// The constraints and the recipients of rents of parameters q, copied to p
void _cge_cons_carry(struct cge_par scalar p, struct cge_par scalar q)
{
    p.bmode = q.bmode
    p.bval = q.bval
    p.bxbar = q.bxbar
    p.rrm = q.rrm
    p.rre = q.rre
    p.rra = q.rra
}

// Equation masks, scales and the Jacobian pattern after a change of the
// constraints; the closure is checked by the caller
void _cge_cons_rebuild(struct cge_model scalar M)
{
    real colvector L, R, K, mag
    _cge_eq(M, M.p0, M.x0, L, R, K, 1)
    M.emask = K
    mag = rowmax((abs(L), abs(R)))
    M.escale = mag :* (mag :> 1e-9) + (mag :<= 1e-9)
    M.neq = sum(K)
    _cge_pattern(M, M.p)
}

// cge_constraint: a bound on elements of variable yname, each paired with an
// adjusting variable (Section 16.2). Bounds are levels, or multiples of the
// base values with scale. A constraint on the same element with the same
// type of bound is replaced.
void _cge_constraint(string scalar yname, string scalar elems, string scalar s_up, string scalar s_lo,
                     real scalar scale, string scalar adjust, string scalar dir, string scalar rents)
{
    struct cge_model scalar M
    string rowvector at
    string colvector rec
    string scalar xname
    real colvector ypos, xpos
    real scalar ky, kx, typ, b, d, code, isrent, i, slot, bi, j, el

    M = _cge_load()
    _cge_need(M, "calibrated")
    ky = _cge_vidx(M, yname)
    if (!ky) _cge_fail(yname + " is not a model variable", 198)
    if ((s_up == "") == (s_lo == "")) _cge_fail("give one bound: upper() or lower()", 198)
    typ = (s_up != "" ? 1 : -1)
    b = strtoreal(typ == 1 ? s_up : s_lo)
    if (b >= .) _cge_fail("the bound must be a number", 198)
    ypos = _cge_cons_pos(M, ky, elems)
    if (!rows(ypos)) _cge_fail(yname + " has no elements in this model", 459)

    // The adjusting variable: the rent of QM, QE and QA by default
    at = tokens(adjust)
    if (!cols(at)) {
        xname = (yname == "QM" ? "RM" : (yname == "QE" ? "RE" : (yname == "QA" ? "RA" : "")))
        if (xname == "") _cge_fail("give the adjusting variable, for example adjust(EXR) up", 198)
        at = xname
    }
    xname = at[1]
    kx = _cge_vidx(M, xname)
    if (!kx) _cge_fail("adjust(): " + xname + " is not a model variable", 198)
    if (cols(at) > 1) {
        if (rows(ypos) > 1) _cge_fail("adjust(): one adjusting element cannot serve several constraints; give one element of " + yname, 198)
        xpos = _cge_cons_pos(M, kx, invtokens(at[|2 \ cols(at)|]))
    }
    else if (M.vset[kx] == "") {
        if (rows(ypos) > 1) _cge_fail("adjust(): " + xname + " cannot serve several constraints; give one element of " + yname, 198)
        xpos = M.voff[kx] + 1
    }
    else {
        // the adjusting variable takes the element of the limited one
        if (M.vset[kx] != M.vset[ky]) _cge_fail("adjust(): give the element of " + xname, 198)
        xpos = ypos :- M.voff[ky] :+ M.voff[kx]
    }
    isrent = anyof(("RM", "RE", "RA"), xname)
    d = (dir == "" ? (isrent ? 1 : 0) : (dir == "up" ? 1 : -1))
    if (d == 0) _cge_fail("give the direction in which " + xname + " may move: up or down", 198)
    if (rents != "" & !isrent) _cge_fail("rents(): only for the rent variables RM, RE and RA", 198)
    rec = _cge_recipients(M)
    code = M.nF + M.nD + 1
    if (rents != "") {
        code = _cge_find(rec, rents)
        if (!code) _cge_fail("rents(): " + rents + " is not a factor, household, enterprise, the government or the rest of the world", 111)
    }

    for (i = 1; i <= rows(ypos); i++) {
        if (!M.exists[ypos[i]]) _cge_fail(_cge_poslabel(M, ypos[i]) + " does not exist in this model", 459)
        if (!M.exists[xpos[i]]) _cge_fail(_cge_poslabel(M, xpos[i]) + " does not exist in this model", 459)
        if (M.fixed[ypos[i]]) _cge_fail(_cge_poslabel(M, ypos[i]) + " is fixed under the current closure, so it cannot be bounded", 459)
        if (!M.fixed[xpos[i]]) _cge_fail(_cge_poslabel(M, xpos[i]) + " is not fixed under the current closure, so it cannot adjust", 459)
        bi = (scale ? b * M.x0[ypos[i]] : b)
        if (scale & M.x0[ypos[i]] == 0) _cge_fail("scale: the base value of " + _cge_poslabel(M, ypos[i]) + " is zero; give the bound as a level", 198)
        slot = 0
        for (j = 1; j <= rows(M.bY); j++) if (M.bY[j] == ypos[i] & M.btype[j] == typ) slot = j
        for (j = 1; j <= rows(M.bY); j++) {
            if (j != slot & M.bX[j] == xpos[i]) {
                _cge_fail(_cge_poslabel(M, xpos[i]) + " already adjusts for the constraint on " + _cge_poslabel(M, M.bY[j]), 459)
            }
        }
        if (!slot) {
            M.bY = M.bY \ ypos[i]
            M.bX = M.bX \ xpos[i]
            M.btype = M.btype \ typ
            M.bdir = M.bdir \ d
            M.p.bmode = M.p.bmode \ 1
            M.p.bval = M.p.bval \ bi
            M.p.bxbar = M.p.bxbar \ M.xcur[xpos[i]]
            M.p0.bmode = M.p0.bmode \ 0
            M.p0.bval = M.p0.bval \ bi
            M.p0.bxbar = M.p0.bxbar \ M.x0[xpos[i]]
            slot = rows(M.bY)
        }
        else {
            M.bX[slot] = xpos[i]
            M.bdir[slot] = d
            M.p.bmode[slot] = 1
            M.p.bval[slot] = bi
            M.p.bxbar[slot] = M.xcur[xpos[i]]
            M.p0.bval[slot] = bi
            M.p0.bxbar[slot] = M.x0[xpos[i]]
        }
        if (isrent) {
            el = xpos[i] - M.voff[kx]
            if (xname == "RM") M.p.rrm[el] = code
            else if (xname == "RE") M.p.rre[el] = code
            else M.p.rra[el] = code
        }
    }
    _cge_cons_rebuild(M)
    _cge_closure_apply(M, M.c_ext, M.c_gov, M.c_si, M.c_num, M.c_fac)
    _cge_store(M)
    for (i = 1; i <= rows(M.bY); i++) {
        if (anyof(ypos, M.bY[i]) & M.btype[i] == typ) printf("{txt}Constraint {res}%s\n", _cge_cons_one(M, M.p, M.xcur, i))
    }
    st_numscalar("r(N_constraints)", rows(M.bY))
}

// cge_constraint, list
void _cge_cons_list()
{
    struct cge_model scalar M
    real scalar k
    M = _cge_load()
    _cge_need(M, "calibrated")
    if (!rows(M.bY)) {
        printf("{txt}No constraints\n")
        st_numscalar("r(N_constraints)", 0)
        return
    }
    printf("{txt}Constraints (regime in the last solution)\n")
    for (k = 1; k <= rows(M.bY); k++) printf("{txt}  %f. %s\n", k, _cge_cons_one(M, M.p, M.xcur, k))
    st_numscalar("r(N_constraints)", rows(M.bY))
    st_numscalar("r(N_binding)", sum(M.p.bmode :== 2))
}

// cge_constraint, clear: no constraints, and every rent to the government
void _cge_cons_clear()
{
    struct cge_model scalar M
    M = _cge_load()
    _cge_need(M, "calibrated")
    M.bY = J(0, 1, .)
    M.bX = J(0, 1, .)
    M.btype = J(0, 1, .)
    M.bdir = J(0, 1, .)
    M.p.bmode = J(0, 1, .)
    M.p.bval = J(0, 1, .)
    M.p.bxbar = J(0, 1, .)
    M.p0.bmode = J(0, 1, .)
    M.p0.bval = J(0, 1, .)
    M.p0.bxbar = J(0, 1, .)
    M.p.rrm = M.p0.rrm
    M.p.rre = M.p0.rre
    M.p.rra = M.p0.rra
    // the inequalities and bounds of user variables stay (from version 0.9.0)
    (void) _cge_u_cons_sync(M, 0)
    _cge_cons_rebuild(M)
    _cge_closure_apply(M, M.c_ext, M.c_gov, M.c_si, M.c_num, M.c_fac)
    _cge_store(M)
    printf("{txt}All constraints removed%s\n", (rows(M.bY) ? " (the inequalities of user equations stay)" : ""))
    st_numscalar("r(N_constraints)", rows(M.bY))
}

// =====================================================================
// Diagnostics and continuation (from version 0.4.5)
// =====================================================================

// Index set and description of an equation block
void _cge_eqinfo(string scalar blk, string scalar set, string scalar desc)
{
    string matrix T
    real colvector k
    T = ("P1", "C", "import price") \ ("P2", "C", "export price") \ ("P3", "C", "composite supply price") \
        ("P4", "C", "producer price of output") \ ("P5", "A", "activity price") \
        ("P6", "A", "price of intermediate input") \ ("P7", "A", "zero profit") \
        ("P8", "", "consumer price index") \ ("P9", "", "producer price index") \
        ("Q1", "A", "value added (Leontief)") \ ("Q2", "A", "intermediate input (Leontief)") \
        ("Q1C", "A", "output (top nest)") \ ("Q2C", "A", "value added and intermediates (top nest)") \
        ("Q3", "A", "value added") \ ("Q4", "FA", "factor demand") \ ("N1", "NA", "quantity of a nest") \
        ("N2", "NA", "price of a nest") \ ("N3", "CA", "demand for a commodity in a nest") \
        ("H1", "", "health services") \
        ("H2", "F", "factor efficiency") \ ("H3", "F", "days worked") \ ("Q5", "CA", "intermediate demand") \
        ("Q6", "C", "commodity output") \ ("Q6A", "C", "output aggregated from activities") \
        ("Q6B", "AC", "output of a commodity by an activity") \ ("P5A", "AC", "price of an activity's output") \
        ("T1", "C", "CET transformation") \ ("T2", "C", "export supply") \
        ("T3", "C", "output without exports") \ ("T3E", "C", "export-only output") \
        ("T4", "C", "Armington aggregation") \ ("T5", "C", "import demand") \ ("T6", "C", "supply without imports") \
        ("T7", "C", "supply from imports only") \ ("T8", "C", "margin demand") \
        ("T9", "C", "exports from composite supply") \ ("T10", "C", "export demand") \
        ("I1", "F", "factor income") \ ("I2", "IF", "factor income of institutions") \
        ("I3", "D", "income of households and enterprises") \ ("I4", "H", "consumption spending") \
        ("I5", "CH", "household demand") \ ("I5H", "AH", "home consumption") \ ("I6", "C", "investment demand") \
        ("I7", "C", "government demand") \ ("I8", "", "government revenue") \ ("I9", "", "government spending") \
        ("I10", "D", "direct tax rate") \ ("I11", "D", "savings rate") \ ("I12", "", "insurance fund revenue") \
        ("I13", "C", "insurance fund purchases") \ ("I14", "", "insurance fund budget") \
        ("L1", "F", "wage curve") \ ("L2", "F", "minimum wage") \ ("S1", "F", "factor market") \
        ("S2", "C", "commodity market") \ ("S3", "", "balance of payments") \ ("S4", "", "government budget") \
        ("S5", "", "savings-investment balance") \ ("B1", "B", "constraint") \
        ("U", "U", "user equation")
    k = selectindex(T[., 1] :== blk)
    if (!length(k)) {
        set = "?"
        desc = ""
        return
    }
    set = T[k[1], 2]
    desc = T[k[1], 3]
}

// Block and element of equation element g (an index over all elements)
void _cge_eqlabel(struct cge_model scalar M, real scalar g, string scalar blk, string scalar el,
                  string scalar desc)
{
    string colvector s1, s2
    string scalar set
    real scalar k, off, i, j, e, n2
    off = 0
    for (k = 1; k <= rows(M.ename); k++) {
        if (g <= off + M.elen[k]) break
        off = off + M.elen[k]
    }
    blk = M.ename[k]
    e = g - off
    _cge_eqinfo(blk, set, desc)
    if (set == "") el = ""
    else if (set == "B") el = _cge_poslabel(M, M.bY[e])
    else if (set == "U") el = M.uelab[e]
    else if (strlen(set) == 1) {
        s1 = _cge_setlab(M, set)
        el = (e <= rows(s1) ? s1[e] : strofreal(e))
    }
    else {
        s1 = _cge_setlab(M, substr(set, 1, 1))
        s2 = _cge_setlab(M, substr(set, 2, 1))
        n2 = rows(s2)
        i = floor((e - 1) / n2) + 1
        j = mod(e - 1, n2) + 1
        el = s1[i] + "," + s2[j]
    }
}

// The equation listing and infeasibility report (from version 0.9.5): every
// element of the model's equations at a point, with its block, element,
// left and right sides, residual and scaled residual, whether it is in the
// system solved and whether a user equation replaces it. The point is a
// stored simulation, the base, or the current point (the shocks and fixed
// values that the next solve starts from); by default the last simulation.
void _cge_listing(string scalar sim, real scalar base, real scalar current, string scalar blocks, real scalar top,
                  real scalar tol, real scalar all, real scalar clear)
{
    struct cge_model scalar M
    struct cge_par scalar p
    real colvector x, L, R, K, res, sc, ins, rp, keep, g, o, inf, lst, nb, mb
    string colvector bl, el, ds, ub
    string rowvector want
    string scalar what, b, e, d, wb, we
    real scalar k, n, i, j, mx, kb, ninf, nl, idx
    M = _cge_load()
    _cge_need(M, "calibrated")
    if ((sim != "") + base + current > 1) _cge_fail("give one of sim(), base and current", 198)
    if (sim == "" & !base & !current) {
        if (rows(M.simname)) sim = M.simname[rows(M.simname)]
        else base = 1
    }
    if (sim != "") {
        k = _cge_sim_index(M, sim)
        p = M.simp[k]
        x = M.simx[., k]
        what = "simulation " + sim
    }
    else if (base) {
        p = M.p0
        x = M.x0
        what = "the base"
    }
    else {
        p = M.p
        x = M.xcur
        what = "the current point, before it is solved"
    }
    _cge_eq(M, p, x, L, R, K, 0)
    n = rows(L)
    rp = J(n, 1, 0)
    if (rows(M.erep)) rp[M.erep] = J(rows(M.erep), 1, 1)
    ins = M.emask :!= 0
    // the elements of the model: those solved and those that user equations replace
    g = selectindex(ins :| rp)
    res = L - R
    sc = res :/ M.escale
    bl = el = ds = J(rows(g), 1, "")
    for (i = 1; i <= rows(g); i++) {
        _cge_eqlabel(M, g[i], b, e, d)
        bl[i] = b
        el[i] = e
        ds[i] = d
    }
    inf = ins[g] :& (editmissing(abs(sc[g]), 1e300) :> tol)
    ninf = sum(inf)
    // the blocks to list element by element
    want = (all ? uniqrows(bl)' : tokens(strupper(blocks)))
    for (k = 1; k <= cols(want); k++) {
        if (!anyof(M.ename, want[k])) _cge_fail("blocks(): " + want[k] + " is not an equation block (model_spec.md, Section 5)", 198)
    }
    if (clear) {
        stata("clear")
        st_addobs(rows(g))
        (void) st_addvar("str8", "block")
        (void) st_addvar("str" + strofreal(max((1, max(strlen(el))))), "element")
        (void) st_addvar("str" + strofreal(max((1, max(strlen(ds))))), "description")
        (void) st_addvar(("double", "double", "double", "double", "byte", "byte", "byte"),
                         ("lhs", "rhs", "residual", "scaled", "insystem", "replaced", "infeasible"))
        st_sstore(., ("block", "element", "description"), (bl, el, ds))
        st_store(., ("lhs", "rhs", "residual", "scaled", "insystem", "replaced", "infeasible"),
                 (L[g], R[g], res[g], sc[g], ins[g], rp[g], inf))
    }
    // the block summary
    ub = J(0, 1, "")
    for (i = 1; i <= rows(bl); i++) if (!anyof(ub, bl[i])) ub = ub \ bl[i]
    nb = mb = J(rows(ub), 1, 0)
    printf("{txt}Equations at %s: {res}%f{txt} in the system", what, sum(ins[g]))
    if (sum(rp[g])) printf("{txt}, {res}%f{txt} replaced by user equations", sum(rp[g]))
    printf("\n\n{txt}%-5s %-36s %9s %12s  %-20s %10s\n", "Block", "", "Elements", "Largest", "at", "Infeasible")
    printf("{txt}{hline 98}\n")
    mx = 0
    wb = we = ""
    for (k = 1; k <= rows(ub); k++) {
        o = selectindex((bl :== ub[k]) :& ins[g])
        if (!rows(o)) {
            printf("{txt}%-5s %-36s %9s %12s  %-20s %10s\n", ub[k], _cge_trunc(ds[selectindex(bl :== ub[k])[1]], 36), "0", "", "(replaced)", "")
            continue
        }
        j = o[order(-editmissing(abs(sc[g[o]]), 1e300), 1)[1]]
        printf("{txt}%-5s %-36s {res}%9.0f %12.3e{txt}  %-20s {res}%10.0f\n", ub[k], _cge_trunc(ds[j], 36), rows(o),
               abs(sc[g[j]]), _cge_trunc(el[j], 20), sum(inf[o]))
        if (editmissing(abs(sc[g[j]]), 1e300) > mx | wb == "") {
            mx = editmissing(abs(sc[g[j]]), 1e300)
            wb = ub[k]
            we = el[j]
        }
    }
    printf("{txt}{hline 98}\n")
    // the infeasibility report: elements above the tolerance, largest first
    if (ninf) {
        o = selectindex(inf)
        o = o[order(-editmissing(abs(sc[g[o]]), 1e300), 1)]
        printf("\n{txt}Infeasible equation elements, with a scaled residual above %9.2e: {res}%f{txt}%s\n",
               tol, ninf, (ninf > top ? sprintf(" (the largest %f shown)", top) : ""))
        _cge_listing_head()
        for (i = 1; i <= min((top, rows(o))); i++) _cge_listing_row(bl[o[i]], el[o[i]], L[g[o[i]]], R[g[o[i]]], sc[g[o[i]]], "INFES")
    }
    else printf("\n{txt}No equation element is infeasible: every scaled residual is at most %9.2e\n", tol)
    // the listing of the blocks asked for
    nl = 0
    for (k = 1; k <= cols(want); k++) {
        o = selectindex(bl :== want[k])
        if (!rows(o)) continue
        _cge_eqinfo(want[k], b, d)
        printf("\n{txt}Block {res}%s{txt}: %s\n", want[k], d)
        _cge_listing_head()
        for (i = 1; i <= rows(o); i++) {
            idx = o[i]
            _cge_listing_row(bl[idx], el[idx], L[g[idx]], R[g[idx]], sc[g[idx]], (rp[g[idx]] ? "replaced" : (inf[idx] ? "INFES" : "")))
            nl++
        }
    }
    st_numscalar("r(N_equations)", sum(ins[g]))
    st_numscalar("r(N_replaced)", sum(rp[g]))
    st_numscalar("r(N_infeasible)", ninf)
    st_numscalar("r(N_listed)", nl)
    st_numscalar("r(max_residual)", mx)
    st_numscalar("r(tolerance)", tol)
    st_global("r(block)", wb)
    st_global("r(element)", we)
    st_global("r(point)", what)
}

void _cge_listing_head()
{
    printf("{txt}  %-5s %-24s %16s %16s %12s\n", "Block", "Element", "Left side", "Right side", "Scaled")
}

void _cge_listing_row(string scalar b, string scalar e, real scalar l, real scalar r, real scalar s, string scalar flag)
{
    printf("{txt}  %-5s %-24s {res}%16.8g %16.8g %12.3e{txt} %s\n", b, _cge_trunc(e, 24), l, r, s, flag)
}

// Why a solve fails: the largest residuals at point x by equation and
// element; equations with no free variable and free variables in no
// equation; and the smallest pivot of the Jacobian of the system solved
void _cge_diagnose(struct cge_model scalar M, struct cge_par scalar p, real colvector x, real scalar full,
                   real scalar top)
{
    struct cge_sys scalar S
    struct cge_jpat scalar G
    real colvector L, R, K, gi, r, v, o, z, rows_g, perm, d, jj
    real matrix Jac, U, rz, cz
    string scalar blk, el, desc, wb, we
    real scalar k, n, j, ratio, nz

    printf("{txt}Diagnostics\n")
    _cge_eq(M, p, x, L, R, K, 0)
    gi = selectindex(M.emask)
    r = ((L - R) :/ M.escale)[gi]
    v = editmissing(abs(r), 1e300)
    o = order(-v, 1)
    n = min((top, rows(o)))
    printf("{txt}  Largest scaled residuals\n")
    wb = ""
    we = ""
    for (k = 1; k <= n; k++) {
        _cge_eqlabel(M, gi[o[k]], blk, el, desc)
        if (k == 1) {
            wb = blk
            we = el
        }
        printf("{txt}    %-4s %-38s %-22s {res}%10.3e\n", blk, _cge_trunc(desc, 38), _cge_trunc(el, 22), r[o[k]])
    }
    // the listing of every element (from version 0.9.5)
    printf("{txt}  (cge_listing, sim() lists every equation element at this point)\n")
    st_global("r(diag_block)", wb)
    st_global("r(diag_element)", we)
    st_numscalar("r(diag_residual)", r[o[1]])

    // The system solved and its Jacobian at x
    S = _cge_sys_make(M, !full)
    rows_g = selectindex(S.mask)
    z = x[S.free] :/ M.xscale[S.free]
    if (S.reduced) _cge_derive(M, p, x)
    Jac = _cge_jacobian_exact(M, p, x, S, z)
    if (hasmissing(Jac)) {
        printf("{txt}  The Jacobian cannot be evaluated here: a price or quantity is not positive\n")
        st_numscalar("r(diag_singular)", .)
        return
    }
    rz = selectindex(rowsum(abs(Jac)) :== 0)
    cz = selectindex(colsum(abs(Jac)) :== 0)
    nz = length(rz)
    if (nz) {
        printf("{txt}  Equations with no free variable (check the closure and swaps):\n")
        for (k = 1; k <= min((nz, 10)); k++) {
            _cge_eqlabel(M, rows_g[rz[k]], blk, el, desc)
            printf("{txt}    %-4s %-38s %s\n", blk, _cge_trunc(desc, 38), el)
        }
    }
    if (length(cz)) {
        printf("{txt}  Free variables in no equation:\n")
        for (k = 1; k <= min((length(cz), 10)); k++) printf("{txt}    %s\n", _cge_poslabel(M, S.free[cz[k]]))
    }
    st_numscalar("r(diag_N_empty_rows)", nz)
    st_numscalar("r(diag_N_empty_cols)", length(cz))
    if (nz | length(cz)) {
        st_numscalar("r(diag_singular)", 1)
        printf("{txt}  The Jacobian is singular\n")
        return
    }
    // Partial pivoting permutes rows only: column j of U belongs to variable j
    _lud(Jac, U, perm)
    d = abs(diagonal(U))
    ratio = min(d) / max(d)
    jj = selectindex(d :== min(d))
    j = jj[1]
    st_numscalar("r(diag_pivot_ratio)", ratio)
    st_numscalar("r(diag_singular)", (ratio < 1e-12))
    printf("{txt}  Smallest pivot of the Jacobian, relative to the largest: {res}%9.3e{txt} (%s)\n", ratio,
           _cge_poslabel(M, S.free[j]))
    if (ratio < 1e-12) printf("{txt}  The Jacobian is singular or nearly so: %s may not be determined by the equations\n",
                              _cge_poslabel(M, S.free[j]))
}

// Shocked parameters a share lam of the way from p0 to p
struct cge_par scalar _cge_par_interp(struct cge_par scalar p0, struct cge_par scalar p, real scalar lam)
{
    struct cge_par scalar q
    string matrix P
    real scalar k
    q = p
    P = _cge_gams_params() \ ("mort", "mort", "") \ ("tf", "tf", "FA")
    for (k = 1; k <= rows(P); k++) {
        _cge_par_set(q, P[k, 1], _cge_par_get(p0, P[k, 1]) + lam :* (_cge_par_get(p, P[k, 1]) - _cge_par_get(p0, P[k, 1])))
    }
    // user parameters (from version 0.7.1)
    if (rows(p.upval) & rows(p0.upval) == rows(p.upval)) q.upval = p0.upval + lam :* (p.upval - p0.upval)
    return(q)
}

// Continuation: the shock applied in n equal steps, parameters and fixed
// values moving from the base, each solution the start of the next; done is
// the number of steps solved
real colvector _cge_continue(struct cge_model scalar M, real scalar n, real scalar tol, real scalar maxit,
                             real scalar trace, real scalar conv, real scalar iter, real scalar err,
                             string scalar method, real scalar full, real scalar done, | real scalar mode)
{
    struct cge_par scalar q
    real colvector x, xf
    real scalar k, it, lam
    string scalar m
    if (args() < 12) mode = 0
    x = M.x0
    iter = 0
    done = 0
    m = "newton"
    for (k = 1; k <= n; k++) {
        if (trace) printf("{txt}Continuation: step %f of %f\n", k, n)
        if (k < n) {
            lam = k / n
            q = _cge_par_interp(M.p0, M.p, lam)
            xf = M.x0 + lam :* (M.xcur - M.x0)
            x = _cge_solve_point(M, q, xf, x, tol, maxit, trace, conv, it, err, m, full, mode)
        }
        else x = _cge_solve_point(M, M.p, M.xcur, x, tol, maxit, trace, conv, it, err, m, full, mode)
        iter = iter + it
        if (!conv) return(x)
        done = k
    }
    method = m
    return(x)
}

// =====================================================================
// GAMS export (from version 0.4.3; docs/gams.md)
// =====================================================================

// A number in a form GAMS reads: the shortest of 15, 16 or 17 significant
// digits that gives back the same double
string scalar _cge_gnum(real scalar x)
{
    string scalar s
    if (x == 0) return("0")
    s = strtrim(sprintf("%25.15g", x))
    if (strtoreal(s) != x) s = strtrim(sprintf("%25.16g", x))
    if (strtoreal(s) != x) s = strtrim(sprintf("%25.17g", x))
    // with a leading zero (Stata writes .5)
    if (substr(s, 1, 1) == ".") s = "0" + s
    else if (substr(s, 1, 2) == "-.") s = "-0" + substr(s, 2, .)
    return(s)
}

real scalar _cge_gopen(string scalar fn)
{
    if (fileexists(fn)) unlink(fn)
    return(fopen(fn, "w"))
}

// A subset of the accounts, one label to a line
void _cge_gset(real scalar fh, string scalar name, string colvector labels)
{
    real scalar k
    if (rows(labels) == 0) {
        fput(fh, "set " + name + "(AC) / /;")
        return
    }
    fput(fh, "set " + name + "(AC) /")
    for (k = 1; k <= rows(labels); k++) fput(fh, "    '" + labels[k] + "'" + (k < rows(labels) ? "," : ""))
    fput(fh, "/;")
}

// A parameter over accounts: its non-zero values
void _cge_gpar(real scalar fh, string scalar name, string colvector labels, real colvector v)
{
    real colvector sel
    real scalar k
    sel = select((1::rows(v)), v :!= 0)
    if (rows(sel) == 0) {
        fput(fh, "parameter " + name + "(AC) / /;")
        return
    }
    fput(fh, "parameter " + name + "(AC) /")
    for (k = 1; k <= rows(sel); k++) {
        fput(fh, "    '" + labels[sel[k]] + "' " + _cge_gnum(v[sel[k]]) + (k < rows(sel) ? "," : ""))
    }
    fput(fh, "/;")
}

// A parameter over pairs of accounts: its non-zero values
void _cge_gpar2(real scalar fh, string scalar name, string colvector r, string colvector c, real matrix X)
{
    real scalar i, j, n, k
    n = sum(X :!= 0)
    if (n == 0) {
        fput(fh, "parameter " + name + "(AC, AC) / /;")
        return
    }
    fput(fh, "parameter " + name + "(AC, AC) /")
    k = 0
    for (i = 1; i <= rows(X); i++) {
        for (j = 1; j <= cols(X); j++) {
            if (X[i, j] == 0) continue
            k++
            fput(fh, "    '" + r[i] + "'.'" + c[j] + "' " + _cge_gnum(X[i, j]) + (k < n ? "," : ""))
        }
    }
    fput(fh, "/;")
}

void _cge_gscalar(real scalar fh, string scalar name, real scalar v)
{
    fput(fh, "scalar " + name + " / " + _cge_gnum(v) + " /;")
}

// Creates a folder and any of its parents that do not exist
void _cge_mkdirs(string scalar dir)
{
    string scalar d
    real scalar k
    d = subinstr(dir, char(92), "/")
    for (k = 2; k <= strlen(d); k++) {
        if (substr(d, k, 1) != "/" | substr(d, k - 1, 1) == ":") continue
        if (!direxists(substr(d, 1, k - 1))) {
            if (_mkdir(substr(d, 1, k - 1))) _cge_fail("cannot create folder " + substr(d, 1, k - 1), 603)
        }
    }
    if (!direxists(d)) {
        if (_mkdir(d)) _cge_fail("cannot create folder " + d, 603)
    }
}

// The label of a mapped account, or none
string colvector _cge_gacc(struct cge_model scalar M, real scalar i)
{
    if (i > 0 & i < .) return(M.labels[i])
    return(J(0, 1, ""))
}

// The data of the model for cge_model.gms: the SAM after the layout rewrites,
// the roles of its accounts and the settings given at calibration. GAMS
// calibrates every parameter itself.
void _cge_gams_data(struct cge_model scalar M, string scalar fn)
{
    struct cge_par scalar p
    string rowvector c
    string colvector mT
    real colvector ie, fr, un, gun, wc, gwc, mw, gmw
    real matrix ftm
    real scalar fh, k, les
    string scalar s

    p = M.p0
    c = M.calargs
    if (cols(c) < 25) c = c, J(1, 25 - cols(c), "")
    mT = (rows(M.iT) ? M.labels[M.iT] : J(0, 1, ""))
    fh = _cge_gopen(fn)
    fput(fh, "* Data for cge_model.gms, written by cge_gams (cge-stata " + _cge_version() + ")")
    fput(fh, "* The SAM after the layout rewrites of docs/model_spec.md (Section 7.0), the")
    fput(fh, "* roles of its accounts and the settings given at calibration; GAMS")
    fput(fh, "* calibrates every parameter itself")
    fput(fh, "set AC 'accounts' /")
    for (k = 1; k <= rows(M.labels); k++) fput(fh, "    '" + M.labels[k] + "'" + (k < rows(M.labels) ? "," : ""))
    fput(fh, "/;")
    _cge_gset(fh, "A", M.A)
    _cge_gset(fh, "C", M.C)
    _cge_gset(fh, "F", M.F)
    _cge_gset(fh, "H", M.H)
    _cge_gset(fh, "E", M.E)
    _cge_gset(fh, "T", select(mT, M.tmkt :== 0))
    _cge_gset(fh, "TD", select(mT, M.tmkt :== 1))
    _cge_gset(fh, "TIM", select(mT, M.tmkt :== 2))
    _cge_gset(fh, "TEX", select(mT, M.tmkt :== 3))
    _cge_gset(fh, "XO", select(M.C, M.cxe))
    _cge_gset(fh, "GOVS", M.labels[M.igov])
    _cge_gset(fh, "ROWS", M.labels[M.irow])
    _cge_gset(fh, "SAVS", M.labels[M.isav])
    _cge_gset(fh, "SHIS", _cge_gacc(M, M.ishi))
    _cge_gset(fh, "DTAXS", _cge_gacc(M, M.idirtax))
    _cge_gset(fh, "STAXS", _cge_gacc(M, M.isaltax))
    _cge_gset(fh, "MTAXS", _cge_gacc(M, M.iimptax))
    _cge_gset(fh, "ETAXS", _cge_gacc(M, M.iexptax))
    _cge_gset(fh, "ATAXS", _cge_gacc(M, M.iacttax))
    _cge_gset(fh, "VTAXS", _cge_gacc(M, M.ivattax))
    _cge_gset(fh, "HCOM", select(M.C, M.chs))
    // Taxes on factor use and income (from version 0.5.0): the accounts, and
    // the factor whose use each taxes
    _cge_gset(fh, "FTAXS", (rows(M.iFT) ? M.labels[M.iFT] : J(0, 1, "")))
    _cge_gset(fh, "FYTAXS", _cge_gacc(M, M.iFY))
    ftm = J(rows(M.iFT), M.nF, 0)
    for (k = 1; k <= rows(M.iFT); k++) ftm[k, M.ftf[k]] = 1
    _cge_gpar2(fh, "ftfac", (rows(M.iFT) ? M.labels[M.iFT] : J(0, 1, "")), M.F, ftm)
    // Nests of value added (from version 0.5.1): the nests, their members and
    // their elasticities
    s = ""
    for (k = 1; k <= M.nN; k++) s = s + (k > 1 ? ", " : "") + "'" + M.N[k] + "'"
    fput(fh, "set NST(*) 'nests of value added' / " + s + " /;")
    s = ""
    for (k = 1; k <= M.nF; k++) if (M.nestf[k]) s = s + (s != "" ? ", " : "") + "'" + M.N[M.nestf[k]] + "'.'" + M.F[k] + "'"
    for (k = 1; k <= M.nC; k++) if (M.nestc[k]) s = s + (s != "" ? ", " : "") + "'" + M.N[M.nestc[k]] + "'.'" + M.C[k] + "'"
    fput(fh, "set NSTF(NST, AC) / " + s + " /;")
    s = ""
    for (k = 1; k <= M.nN; k++) s = s + (k > 1 ? ", " : "") + "'" + M.N[k] + "' " + _cge_gnum(p.sgn[k])
    fput(fh, "parameter signest(NST) / " + s + " /;")
    _cge_gpar2(fh, "SAM", M.labels, M.labels, M.S)
    // Elasticities
    _cge_gpar(fh, "sigva", M.A, p.sva)
    _cge_gpar(fh, "sigq", M.C, p.sq)
    _cge_gpar(fh, "sigt", M.C, p.st)
    _cge_gpar(fh, "siga", M.A, p.sa)
    // output from several activities (from version 0.5.2): 0 for perfect substitutes
    _cge_gpar(fh, "sigac", M.C, p.sac)
    _cge_gpar(fh, "eta", M.F, p.etah)
    // LES: income elasticities by commodity, Frisch parameters by household;
    // home goods take the elasticity of the activity's paired commodity
    les = (c[5] != "" | c[6] != "")
    if (les) {
        ie = (c[5] == "" ? J(M.nC, 1, 1) : _cge_elast(c[5], M.nC, "incelas"))
        fr = strtoreal(tokens(c[6]))'
        if (rows(fr) == 1) fr = J(M.nH, 1, fr)
        _cge_gpar(fh, "incel", M.C, ie)
        _cge_gpar(fh, "frisch", M.H, fr)
        _cge_gscalar(fh, "les", 1)
        _cge_gpar(fh, "incelh", M.A, ie[|1 \ M.n|])
    }
    else {
        _cge_gpar(fh, "incel", M.C, J(M.nC, 1, 0))
        _cge_gpar(fh, "frisch", M.H, J(M.nH, 1, 0))
        _cge_gscalar(fh, "les", 0)
        _cge_gpar(fh, "incelh", M.A, J(M.n, 1, 0))
    }
    _cge_gpar(fh, "etae", M.C, p.etae)
    _cge_gpar(fh, "kappain", M.A, p.kappa)
    // Public debt: the holders and the foreign share of borrowing as calibrated
    _cge_gscalar(fh, "debtin", p.debt)
    _cge_gscalar(fh, "ddebtin", p.ddebt)
    _cge_gscalar(fh, "fdebtin", p.fdebt)
    _cge_gscalar(fh, "rdin", p.rd)
    _cge_gscalar(fh, "rfin", p.rf)
    _cge_gscalar(fh, "holdgiven", 1)
    _cge_gpar(fh, "holdin", M.D, p.hold)
    _cge_gscalar(fh, "phigiven", 1)
    _cge_gscalar(fh, "phiin", p.phi)
    // Labour-market regimes (Section 14), as given at calibration
    un = _cge_given(c[18], M.F, "unemployment", gun)
    wc = _cge_given(c[19], M.F, "wagecurve", gwc)
    mw = _cge_given(c[20], M.F, "minwage", gmw)
    _cge_gpar(fh, "unin", M.F, editmissing(un, 0))
    _cge_gpar(fh, "ungiven", M.F, gun)
    _cge_gpar(fh, "wcin", M.F, editmissing(wc, 0))
    _cge_gpar(fh, "mwin", M.F, editmissing(mw, 0))
    _cge_gpar(fh, "mwgiven", M.F, gmw)
    _cge_gscalar(fh, "muin", p.mu)
    // Health outcomes (Section 15); the death rate does not enter the equations
    _cge_gpar(fh, "sickin", M.F, p.sick0)
    _cge_gpar(fh, "sickgiven", M.F, p.ins)
    _cge_gpar(fh, "sickelin", M.F, p.epss)
    _cge_gscalar(fh, "mortelin", p.epsm)
    // Factor quantities, when given at calibration
    _cge_gscalar(fh, "fqgiven", (c[4] != ""))
    if (c[4] != "") _cge_gpar2(fh, "fqin", M.F, M.A, _cge_v(M, M.x0, _cge_vidx(M, "QF")))
    else fput(fh, "parameter fqin(AC, AC) / /;")
    fclose(fh)
}

// Shockable parameters: Stata name, GAMS name, and index set ("" for scalars)
string matrix _cge_gams_params()
{
    return(("tm", "tm", "C") \ ("te", "te", "C") \ ("tq", "tq", "C") \ ("ta", "ta", "A") \
           ("tv", "tv", "C") \ ("kappa", "kappa", "A") \ ("pwm", "pwm", "C") \ ("pwe", "pwe", "C") \
           ("ad", "ad", "A") \ ("af", "af", "F") \ ("qg", "qgbar", "C") \ ("qinv", "qinvbar", "C") \
           ("trdg", "trdg", "D") \ ("trdr", "trdr", "D") \ ("trfr", "trfr", "F") \ ("trgr", "trgr", "") \
           ("trrg", "trrg", "") \ ("tshi", "tshi", "F") \ ("qshi", "qshibar", "C") \ ("trshi", "trshi", "") \
           ("trshir", "trshir", "") \ ("rd", "rd", "") \ ("rf", "rf", "") \ ("ddebt", "ddebt", "") \
           ("fdebt", "fdebt", "") \ ("qlf", "qlf", "F") \ ("wmin", "wmin", "F") \ ("wref", "wref", "F") \
           ("sick", "sick", "F") \ ("tfy", "tfy", "F") \ ("trgg", "trgg", "") \ ("hs0", "hs0", ""))
}

string colvector _cge_gams_setlabels(struct cge_model scalar M, string scalar s)
{
    if (s == "A") return(M.A)
    if (s == "C") return(M.C)
    if (s == "F") return(M.F)
    if (s == "D") return(M.D)
    return("")
}

// GAMS name of a model variable, and of one of its elements
string scalar _cge_gams_vname(string scalar v)
{
    return(v == "PWE" ? "PWEV" : v)
}

string scalar _cge_gams_elem(string scalar e1, string scalar e2)
{
    if (e1 == "") return("")
    if (e2 == "") return("('" + e1 + "')")
    return("('" + e1 + "', '" + e2 + "')")
}

// The scenario as GAMS statements: parameter changes and the closure (fpar),
// then changes to fixed variables (fvar). Changes are ratios to the base where
// the base is not zero, so that GAMS applies them to its own calibrated values.
// Returns the number of changes.
real scalar _cge_gams_scenario(struct cge_model scalar M, struct cge_par scalar p, real colvector x,
                               real colvector fixed, string rowvector cl, string scalar fpar, string scalar fvar,
                               struct cge_par scalar p0, real colvector x0)
{
    string matrix P
    string colvector lab, e1, e2
    string scalar target, g, mode, gov, idx
    real colvector v0, v1, pos, fx, fr, xf, act
    real matrix G0, G1, LG
    real scalar lv
    string colvector rl, cl2
    real scalar fh, k, i, j, n, code, m

    // Changes are relative to p0 and x0: the base for a static scenario, the
    // previous period for a period of a dynamic run (from version 0.5.3)
    P = _cge_gams_params()
    n = 0
    fh = _cge_gopen(fpar)
    fput(fh, "* Parameter changes and the closure, written by cge_gams")
    // user equations hold exactly in a scenario (from version 0.7.1)
    if (rows(M.uelab)) fput(fh, "UBASE = 0;")
    for (k = 1; k <= rows(P); k++) {
        v0 = _cge_par_get(p0, P[k, 1])
        v1 = _cge_par_get(p, P[k, 1])
        lab = _cge_gams_setlabels(M, P[k, 3])
        for (i = 1; i <= rows(v0); i++) {
            if (v1[i] == v0[i]) continue
            target = P[k, 2] + (P[k, 3] == "" ? "" : "('" + lab[i] + "')")
            fput(fh, target + " = " + (v0[i] != 0 ? _cge_gnum(v1[i] / v0[i]) + " * " + target : _cge_gnum(v1[i])) + ";")
            n++
        }
    }
    if (p.mort != p0.mort & x0 == M.x0) printf("{txt}Note: the death rate (mort) enters only dynamic runs; its change is not exported\n")
    // user parameters (from version 0.7.1)
    for (k = 1; k <= rows(M.updef); k++) {
        pos = _cge_up_pos(M, k)
        if (max(pos) > rows(p.upval) | max(pos) > rows(p0.upval)) continue
        _cge_up_labels(M, k, e1, e2)
        for (i = 1; i <= rows(pos); i++) {
            if (p.upval[pos[i]] == p0.upval[pos[i]]) continue
            target = "UP_" + M.updef[k, 1] + _cge_gams_elem(e1[i], e2[i])
            fput(fh, target + " = " + (p0.upval[pos[i]] != 0 ? _cge_gnum(p.upval[pos[i]] / p0.upval[pos[i]]) + " * " + target : _cge_gnum(p.upval[pos[i]])) + ";")
            n++
        }
    }
    // lagged values (from version 0.9.2): those of the period, where they
    // differ from those of the period before
    LG = _cge_u_lags(M)
    for (i = 1; i <= rows(LG); i++) {
        lv = _cge_u_lagval(M, p, LG[i, 1], LG[i, 2])
        if (lv == _cge_u_lagval(M, p0, LG[i, 1], LG[i, 2])) continue
        _cge_gams_ref(M, LG[i, 1], g, idx)
        fput(fh, "LAG" + strofreal(LG[i, 2]) + "_" + g + idx + " = " + _cge_gnum(lv) + ";")
        n++
    }
    // values of later periods and the period (from version 0.10.2)
    LG = _cge_u_leads(M)
    for (i = 1; i <= rows(LG); i++) {
        lv = _cge_u_leadval(M, p, LG[i, 1], LG[i, 2])
        if (lv == _cge_u_leadval(M, p0, LG[i, 1], LG[i, 2])) continue
        _cge_gams_ref(M, LG[i, 1], g, idx)
        fput(fh, "LEAD" + strofreal(LG[i, 2]) + "_" + g + idx + " = " + _cge_gnum(lv) + ";")
        n++
    }
    if (_cge_u_hastime(M)) {
        for (i = 1; i <= 3; i++) {
            lv = _cge_u_tval(p, i)
            if (lv == _cge_u_tval(p0, i)) continue
            fput(fh, (i == 1 ? "TPERIOD" : (i == 2 ? "TFIRST" : "TLAST")) + " = " + _cge_gnum(lv) + ";")
            n++
        }
    }
    // Parameters by pair of elements: taxes on factor use (from version 0.5.0),
    // and subsistence quantities, which grow with population in dynamic runs
    // (from version 0.5.3)
    for (m = 1; m <= 3; m++) {
        if (m == 1) {
            G0 = p0.tf
            G1 = p.tf
            rl = M.F
            cl2 = M.A
            g = "tf"
        }
        else if (m == 2) {
            G0 = p0.gamma
            G1 = p.gamma
            rl = M.C
            cl2 = M.H
            g = "gamma"
        }
        else {
            G0 = p0.gammah
            G1 = p.gammah
            rl = M.A
            cl2 = M.H
            g = "gammah"
        }
        for (i = 1; i <= rows(G0); i++) {
            for (j = 1; j <= cols(G0); j++) {
                if (G1[i, j] == G0[i, j]) continue
                target = g + "('" + rl[i] + "', '" + cl2[j] + "')"
                fput(fh, target + " = " + (G0[i, j] != 0 ? _cge_gnum(G1[i, j] / G0[i, j]) + " * " + target :
                     _cge_gnum(G1[i, j])) + ";")
                n++
            }
        }
    }
    // Closure: 1 is the default of each block (cge_model.gms); a standalone
    // model has none (from version 0.13.0)
    if (!_cge_sa(M)) {
        fput(fh, "clext = " + (cl[1] == "flexexr" ? "1" : "2") + ";")
        gov = cl[2]
        code = (gov == "flexgsav" ? 1 : (gov == "fixgsav" ? 2 : (gov == "fixgsav:sales" ? 3 :
               (gov == "fixgsav:import" ? 4 : 5))))
        fput(fh, "clgov = " + strofreal(code) + ";")
        fput(fh, "clsi = " + (cl[3] == "savings" ? "1" : "2") + ";")
        fput(fh, "clnum = " + (cl[4] == "cpi" ? "1" : "2") + ";")
        for (k = 1; k <= M.nF; k++) {
            mode = cl[4 + k]
            mode = substr(mode, strpos(mode, ":") + 1, .)
            code = (mode == "mobile" ? 1 : (mode == "specific" ? 2 : (mode == "unemployed" ? 3 :
                   (mode == "wagecurve" ? 4 : 5))))
            fput(fh, "fclo('" + M.F[k] + "') = " + strofreal(code) + ";")
        }
    }
    fclose(fh)

    fh = _cge_gopen(fvar)
    // Swaps (from version 0.4.5): fixed at their current levels, or freed
    _cge_swap_parse(M, _cge_swap_tokens(cl), fx, fr)
    if (rows(fx)) fput(fh, "* Closure swaps, written by cge_gams")
    for (k = 1; k <= rows(fx); k++) {
        _cge_gams_ref(M, fx[k], g, idx)
        fput(fh, g + ".fx" + idx + " = " + g + ".l" + idx + ";")
        _cge_gams_ref(M, fr[k], g, idx)
        fput(fh, g + ".lo" + idx + " = -inf;")
        fput(fh, g + ".up" + idx + " = inf;")
    }
    fput(fh, "* Changes to fixed variables, written by cge_gams")
    // the adjusting variables of constraints at their fixed levels, from which
    // GAMS moves them itself (from version 0.9.8; before, at the solution)
    xf = x
    if (rows(M.bY) & rows(p.bmode) == rows(M.bY) & rows(p.bxbar) == rows(M.bY)) {
        act = _cge_which(p.bmode :> 0)
        if (rows(act)) xf[M.bX[act]] = p.bxbar[act]
    }
    for (k = 1; k <= rows(M.vname); k++) {
        pos = _cge_vpos(M, k)
        if (!any(M.exists[pos] :* fixed[pos] :* (xf[pos] :!= x0[pos]))) continue
        _cge_vlabels(M, k, e1, e2)
        g = _cge_u_gname(M, k)
        for (i = 1; i <= rows(pos); i++) {
            if (!M.exists[pos[i]] | !fixed[pos[i]] | xf[pos[i]] == x0[pos[i]]) continue
            target = g + ".fx" + _cge_gams_elem(e1[i], e2[i])
            fput(fh, target + " = " + (x0[pos[i]] != 0 ? _cge_gnum(xf[pos[i]] / x0[pos[i]]) + " * " + g + ".l" +
                 _cge_gams_elem(e1[i], e2[i]) : _cge_gnum(xf[pos[i]])) + ";")
            n++
        }
    }
    fclose(fh)
    return(n)
}

// A variable element in GAMS: name, index, reference and level
void _cge_gams_ref(struct cge_model scalar M, real scalar pos, string scalar g, string scalar idx)
{
    string colvector e1, e2
    real scalar k, i
    for (k = rows(M.voff); k > 1; k--) if (M.voff[k] < pos) break
    i = pos - M.voff[k]
    _cge_vlabels(M, k, e1, e2)
    g = _cge_u_gname(M, k)
    idx = _cge_gams_elem(e1[i], e2[i])
}

// Constraints (Section 16) as a mixed complementarity problem: for each, a
// slack SLK >= 0 paired with the bound, sigma (b - Y) / sY >= 0, and the
// adjusting variable freed and linked to its fixed level, X = xbar + delta sX
// SLK; the recipients of rents; and model cgecon. Returns the number of
// constraints.
real scalar _cge_gams_cons(struct cge_model scalar M, struct cge_par scalar p, string scalar fn)
{
    string colvector rec, e1, e2
    string scalar gy, iy, gx, ix, pairs, r, tab
    real scalar fh, k, n, code, kx, el, fw
    fh = _cge_gopen(fn)
    fput(fh, "* Constraints (model_spec.md, Section 16), written by cge_gams")
    // the room within each bound and its marginal as GAMS reports them, the
    // slack of BND (its level less its lower bound, the constant GAMS moves
    // to the right) and its marginal, the level of SLK, in the units of the
    // limited and adjusting variables (from version 0.9.8), for cge_gams,
    // compare; batincluded after the scenario's results with the file and
    // the scenario
    fw = _cge_gopen(substr(fn, 1, strlen(fn) - strlen("cge_constraints.inc")) + "cge_cons_write.inc")
    fput(fw, "* Room within each constraint's bound and its marginal (cge_gams, from version 0.9.8)")
    fput(fw, "%1.ap = 1;")
    fput(fw, "put %1;")
    rec = _cge_recipients(M)
    pairs = ""
    n = 0
    for (k = 1; k <= rows(M.bY); k++) {
        if (p.bmode[k] <= 0) continue
        n++
        r = strofreal(n)
        _cge_gams_ref(M, M.bY[k], gy, iy)
        _cge_gams_ref(M, M.bX[k], gx, ix)
        fput(fh, "* " + _cge_poslabel(M, M.bY[k]) + (M.btype[k] == 1 ? " <= " : " >= ") + _cge_gnum(p.bval[k]) +
             ", " + _cge_poslabel(M, M.bX[k]) + (M.bdir[k] == 1 ? " up" : " down"))
        fput(fh, "positive variable SLK" + r + ";")
        fput(fh, "equations BND" + r + ", LNK" + r + ";")
        fput(fh, "scalar xbar" + r + ";")
        fput(fh, "xbar" + r + " = " + gx + ".l" + ix + ";")
        fput(fh, "BND" + r + "..  (" + _cge_gnum(M.btype[k]) + ") * ((" + _cge_gnum(p.bval[k]) + ") - " + gy + iy +
             ") / " + _cge_gnum(M.xscale[M.bY[k]]) + " =g= 0;")
        fput(fh, "LNK" + r + "..  " + gx + ix + " =e= xbar" + r + " + (" + _cge_gnum(M.bdir[k]) + ") * " +
             _cge_gnum(M.xscale[M.bX[k]]) + " * SLK" + r + ";")
        fput(fh, gx + ".lo" + ix + " = -inf;")
        fput(fh, gx + ".up" + ix + " = inf;")
        code = _cge_rentcode(M, p, M.bX[k])
        if (code) {
            tab = (gx == "RM" ? "rmto" : (gx == "RE" ? "reto" : "rato"))
            fput(fh, tab + "(AC, " + substr(ix, 2, strlen(ix) - 2) + ") = 0;")
            fput(fh, tab + "('" + rec[code] + "', " + substr(ix, 2, strlen(ix) - 2) + ") = 1;")
        }
        pairs = pairs + ", LNK" + r + ", BND" + r + ".SLK" + r
        fput(fw, "put '%2', '_BROOM', '" + r + "', '', ((BND" + r + ".l - BND" + r + ".lo) * " + _cge_gnum(M.xscale[M.bY[k]]) + ") /;")
        fput(fw, "put '%2', '_BMARG', '" + r + "', '', (BND" + r + ".m * " + _cge_gnum(M.xscale[M.bX[k]]) + ") /;")
    }
    fput(fh, "model cgecon / cge" + pairs + " /;")
    fput(fh, "cgecon.optfile = cge.optfile;")
    fclose(fh)
    fput(fw, "putclose %1;")
    fclose(fw)
    return(n)
}

// The driver: base, then the scenario, each written as scenario, variable,
// element1, element2, value
void _cge_gams_driver(string scalar fn, string scalar name, string scalar solver, string scalar type)
{
    real scalar fh
    fh = _cge_gopen(fn)
    fput(fh, char(36) + "title cge-stata model exported by cge_gams: " + name)
    fput(fh, char(36) + "ontext")
    fput(fh, "Written by cge_gams (cge-stata " + _cge_version() + "). GAMS calibrates the model from the")
    fput(fh, "SAM and settings in cge_data.inc, solves the base and then scenario " + name + ",")
    fput(fh, "whose parameter changes and closure are in cge_shock_par.inc and whose")
    fput(fh, "changes to fixed variables are in cge_shock_var.inc. The equations are in")
    fput(fh, "cge_model.gms (docs/model_spec.md). To run it:")
    fput(fh, "  gams cge_run.gms                                    " + solver + ", as " +
         (type == "nlp" ? "a nonlinear programme" : (type == "mcp" ? "a mixed complementarity problem" :
         "a constrained nonlinear system")))
    if (type == "mcp") {
        fput(fh, "The scenario has constraints (cge_constraints.inc), so it is solved as a")
        fput(fh, "mixed complementarity problem, with PATH or another MCP solver.")
    }
    else {
        fput(fh, "  gams cge_run.gms --cgesolver=conopt                 CONOPT (or KNITRO, PATH)")
        fput(fh, "  gams cge_run.gms --cgesolver=ipopt --cgetype=nlp    an NLP solver")
    }
    fput(fh, "Results: cge_base.csv and cge_" + name + ".csv, as scenario, variable, element1,")
    fput(fh, "element2, value; the first row holds the model status.")
    fput(fh, char(36) + "offtext")
    fput(fh, char(36) + "if not set cgesolver " + char(36) + "setglobal cgesolver " + solver)
    fput(fh, char(36) + "if not set cgetype " + char(36) + "setglobal cgetype " + type)
    fput(fh, char(36) + "setglobal data cge_data.inc")
    fput(fh, char(36) + "setglobal out cge_base.csv")
    fput(fh, char(36) + "include cge_model.gms")
    fput(fh, "")
    fput(fh, "* Scenario " + name + ": parameter changes and the closure, then fixed variables")
    fput(fh, char(36) + "include cge_shock_par.inc")
    fput(fh, char(36) + "include cge_closure.gms")
    fput(fh, char(36) + "include cge_shock_var.inc")
    fput(fh, char(36) + "include cge_constraints.inc")
    fput(fh, char(36) + "include cge_bounds.inc")
    fput(fh, char(36) + "batinclude cge_solve.gms cgecon")
    fput(fh, "file rescen / 'cge_" + name + ".csv' /;")
    fput(fh, char(36) + "batinclude cge_write.gms rescen " + name)
    fput(fh, char(36) + "batinclude cge_cons_write.inc rescen " + name)
    fclose(fh)
}

// Writes the data, the scenario and the driver to folder dir, for the current
// shocks and closure or for stored simulation sim
void _cge_gams_export(string scalar dir, string scalar sim, string scalar solver, string scalar type)
{
    struct cge_model scalar M, M2
    struct cge_par scalar p
    real colvector x, fixed, fx, fr
    string rowvector cl
    string scalar name
    real scalar k, n, nc

    M = _cge_load()
    _cge_need(M, "calibrated")
    // a standalone model (from version 0.13.0)
    if (_cge_sa(M)) {
        _cge_gams_export_sa(M, dir, sim, solver, type)
        return
    }
    if (sim == "") {
        name = "current"
        p = M.p
        x = M.xcur
        fixed = M.fixed
        cl = tokens(_cge_closure_text(M))
    }
    else {
        k = _cge_sim_index(M, sim)
        if (M.simrun[k] != "") _cge_fail("simulation " + sim + " is a period of dynamic run " + M.simrun[k] +
                                         "; export the run with cge_gams ..., dynamic(" + M.simrun[k] + ")", 198)
        name = sim
        p = M.simp[k]
        x = M.simx[., k]
        cl = tokens(M.simclosure[k])
        M2 = M
        _cge_swap_parse(M2, _cge_swap_tokens(cl), fx, fr)
        M2.swfix = fx
        M2.swfree = fr
        _cge_closure_cl(M2, cl)
        fixed = M2.fixed
    }
    // Constraints (from version 0.4.4) need a mixed complementarity problem
    if (rows(p.bmode) != rows(M.bY)) _cge_fail("the constraints have changed since simulation " + sim + " was solved; solve it again", 459)
    nc = (rows(M.bY) ? sum(p.bmode :> 0) : 0)
    if (nc & type != "mcp") _cge_fail("the scenario has constraints: they are solved as a mixed complementarity problem, type(mcp), with PATH", 198)
    _cge_gams_data(M, dir + "/cge_data.inc")
    n = _cge_gams_scenario(M, p, x, fixed, cl, dir + "/cge_shock_par.inc", dir + "/cge_shock_var.inc", M.p0, M.x0)
    (void) _cge_gams_cons(M, p, dir + "/cge_constraints.inc")
    _cge_gams_bounds(M, fixed, dir + "/cge_bounds.inc", (type == "mcp"))
    _cge_gams_user(M, dir + "/cge_user.inc", dir + "/cge_user_write.inc")
    _cge_gams_driver(dir + "/cge_run.gms", name, solver, type)
    st_numscalar("r(N_constraints)", nc)
    st_global("r(name)", name)
    st_global("r(closure)", invtokens(cl))
    st_numscalar("r(N_changes)", n)
    st_numscalar("r(N_accounts)", rows(M.labels))
    printf("{txt}Wrote the model ({res}%f{txt} accounts) and scenario {res}%s{txt} ({res}%f{txt} change(s) from the base) to {res}%s\n",
           rows(M.labels), name, n, dir)
}

// A standalone model for GAMS (from version 0.13.0): its labels as set AC
// (cge_data.inc), its user parameters, variables and equations
// (cge_user.inc), the changes of the scenario (cge_shock_par.inc,
// cge_shock_var.inc), constraints and attributes, and a driver that solves
// the base and then the scenario, writing each as cge_write.gms does
void _cge_gams_export_sa(struct cge_model scalar M, string scalar dir, string scalar sim, string scalar solver,
                         string scalar type)
{
    struct cge_model scalar M2, M3
    struct cge_par scalar p
    real colvector x, fixed, fx, fr, usel, idx
    string colvector lab, fxl
    string rowvector cl
    string scalar name, gobj, subeqs, gn, gi
    real scalar k, n, nc, fh, big, sgn, j
    if (!rows(M.uelab)) _cge_fail("the model has no equations to export", 459)
    gobj = ""
    sgn = 1
    subeqs = ""
    fxl = J(0, 1, "")
    if (sim == "") {
        name = "current"
        p = M.p
        x = M.xcur
        fixed = M.fixed
        cl = tokens(_cge_closure_text(M))
    }
    else {
        k = _cge_sim_index(M, sim)
        if (M.simrun[k] != "") _cge_fail("simulation " + sim + " is a period of a dynamic run", 198)
        name = sim
        p = M.simp[k]
        x = M.simx[., k]
        cl = tokens(M.simclosure[k])
        M2 = M
        _cge_swap_parse(M2, _cge_swap_tokens(cl), fx, fr)
        M2.swfix = fx
        M2.swfree = fr
        _cge_closure_cl(M2, cl)
        fixed = M2.fixed
    }
    if (rows(p.bmode) != rows(M.bY)) _cge_fail("the constraints have changed since simulation " + sim + " was solved; solve it again", 459)
    nc = (rows(M.bY) ? sum(p.bmode :> 0) : 0)
    if (nc & type != "mcp") _cge_fail("the scenario has constraints: they are solved as a mixed complementarity problem, type(mcp), with PATH", 198)
    // a nonlinear programme (from version 0.15.0): its objective in GAMS
    if (sim != "") if (M.simmethod[k] == "nlp" | M.simmethod[k] == "minlp") {
        if (M.simmethod[k] == "nlp" & type != "nlp") _cge_fail("simulation " + sim + " is a nonlinear programme: export it with type(nlp) and an NLP solver", 198)
        // a mixed-integer programme (from version 0.18.0)
        if (M.simmethod[k] == "minlp" & type != "minlp" & type != "mip") {
            _cge_fail("simulation " + sim + " has integer variables: export it with type(minlp) or type(mip) and a MINLP or MIP solver", 198)
        }
        (void) _cge_nlp_tok(M, _cge_simobj(M, k), sgn, gobj)
    }
    // a simulation of a named model (from version 0.17.0): the model's
    // equations, with the other free variables fixed at their levels
    if (sim != "") if (_cge_simmodel(M, k) != "") {
        if (type == "mcp") _cge_fail("simulation " + sim + " solved named model " + _cge_simmodel(M, k) + ": export it as cns or nlp", 198)
        _cge_submodel(M, _cge_simmodel(M, k), M3, usel)
        if (rows(M3.bY)) _cge_fail("simulation " + sim + " solved a named model with inequalities; cge_gams exports such a model whole", 198)
        idx = _cge_which(usel)
        subeqs = invtokens(("UE" :+ strofreal(idx))', ", ")
        fr = _cge_which(M.exists :& (fixed :== 0) :& (M3.fixed :== 1))
        for (j = 1; j <= rows(fr); j++) {
            _cge_gams_ref(M, fr[j], gn, gi)
            fxl = fxl \ (gn + ".fx" + gi + " = " + _cge_gnum(x[fr[j]]) + ";")
        }
    }
    lab = _cge_us_alllabels(M)
    fh = _cge_gopen(dir + "/cge_data.inc")
    fput(fh, "* The labels of a standalone model (cge_model new), written by cge_gams")
    // a model without sets has an empty set of labels, which GAMS reads only
    // with its domain (from version 0.18.0)
    fput(fh, "set AC" + (rows(lab) ? "" : "(*)") + " 'labels of the model' /")
    for (k = 1; k <= rows(lab); k++) fput(fh, "    '" + lab[k] + "'" + (k < rows(lab) ? "," : ""))
    fput(fh, "/;")
    fput(fh, "alias (AC, ACP);")
    fclose(fh)
    n = _cge_gams_scenario(M, p, x, fixed, cl, dir + "/cge_shock_par.inc", dir + "/cge_shock_var.inc", M.p0, M.x0)
    (void) _cge_gams_cons(M, p, dir + "/cge_constraints.inc")
    _cge_gams_bounds(M, fixed, dir + "/cge_bounds.inc", (type == "mcp"))
    _cge_gams_user(M, dir + "/cge_user.inc", dir + "/cge_user_write.inc")
    big = (rows(M.x0) ? max((1, max(abs(select(M.x0, M.exists))))) : 1)
    _cge_gams_driver_sa(dir, name, solver, type, big, gobj, sgn, subeqs, fxl)
    st_numscalar("r(standalone)", 1)
    st_global("r(model)", (sim != "" ? _cge_simmodel(M, k) : ""))
    st_numscalar("r(nlp)", (gobj != ""))
    st_numscalar("r(N_constraints)", nc)
    st_global("r(name)", name)
    st_global("r(closure)", invtokens(cl))
    st_numscalar("r(N_changes)", n)
    st_numscalar("r(N_accounts)", 0)
    printf("{txt}Wrote the standalone model ({res}%f{txt} equation elements) and scenario {res}%s{txt} ({res}%f{txt} change(s) from the base) to {res}%s\n",
           rows(M.uelab), name, n, dir)
}

// The driver of a standalone model (from version 0.13.0), and the include
// that writes its results; tolerances are scaled by the largest level, big.
// A nonlinear programme (from version 0.15.0) has the GAMS text of its
// objective in gobj, minimised (sgn 1) or maximised (-1); its base is the
// starting levels, which GAMS does not solve
void _cge_gams_driver_sa(string scalar dir, string scalar name, string scalar solver, string scalar type, real scalar big,
                         | string scalar gobj, real scalar sgn, string scalar subeqs, string colvector fxl)
{
    real scalar fh, isnlp, j
    string scalar d
    d = char(36)
    if (args() < 6) gobj = ""
    // a named model (from version 0.17.0): its equations as a GAMS list, and
    // the levels of the free variables outside it
    if (args() < 8) subeqs = ""
    if (args() < 9) fxl = J(0, 1, "")
    isnlp = (gobj != "")
    fh = _cge_gopen(dir + "/cge_sa_write.inc")
    fput(fh, "* Results of a standalone model: scenario, variable, element1, element2, value")
    fput(fh, "* " + d + "batinclude cge_sa_write.inc <put file> <scenario name>, written by cge_gams")
    fput(fh, "%1.pc = 5;")
    fput(fh, "%1.nz = 0;")
    fput(fh, "%1.nd = 15;")
    fput(fh, "%1.nr = 2;")
    fput(fh, "%1.nw = 24;")
    fput(fh, "put %1;")
    fput(fh, "put 'scenario', 'variable', 'element1', 'element2', 'value' /;")
    fput(fh, "put '%2', '__status__', '', '', mstat /;")
    if (isnlp) fput(fh, "put '%2', '__objective__', '', '', OBJV.l /;")
    fput(fh, d + "batinclude cge_user_write.inc %1 %2")
    fput(fh, "putclose %1;")
    fclose(fh)
    fh = _cge_gopen(dir + "/cge_run.gms")
    fput(fh, d + "title cge-stata standalone model exported by cge_gams: " + name)
    fput(fh, d + "ontext")
    fput(fh, "Written by cge_gams (cge-stata " + _cge_version() + "). The model was written in the user")
    fput(fh, "language of cge-stata (cge_model new): its labels are in cge_data.inc and its")
    fput(fh, "parameters, variables and equations in cge_user.inc. " + (isnlp ? "GAMS writes the base, the" : "GAMS solves the base, the"))
    fput(fh, "starting levels, then " + (isnlp ? "solves the nonlinear programme " : "scenario ") + name + ", whose parameter changes are in")
    fput(fh, "cge_shock_par.inc and whose changes to fixed variables are in cge_shock_var.inc.")
    if (isnlp) fput(fh, (sgn < 0 ? "It maximises " : "It minimises ") + "OBJV, defined by equation EOBJV.")
    fput(fh, "To run it:")
    fput(fh, "  gams cge_run.gms                                    " + solver + ", as " +
         (type == "nlp" ? "a nonlinear programme" : (type == "mcp" ? "a mixed complementarity problem" :
         "a constrained nonlinear system")))
    fput(fh, "Results: cge_base.csv and cge_" + name + ".csv, as scenario, variable, element1,")
    fput(fh, "element2, value; the first row holds the model status.")
    fput(fh, d + "offtext")
    fput(fh, d + "if not set cgesolver " + d + "setglobal cgesolver " + solver)
    fput(fh, d + "if not set cgetype " + d + "setglobal cgetype " + type)
    fput(fh, d + "onempty")
    fput(fh, d + "include cge_data.inc")
    fput(fh, d + "include cge_user.inc")
    fput(fh, "model cge / all /;")
    fput(fh, "variable OBJ " + char(34) + "constant objective" + char(34) + ";")
    fput(fh, "equation EOBJ;")
    fput(fh, "EOBJ..  OBJ =e= 0;")
    fput(fh, "model cgenlp / cge, EOBJ /;")
    fput(fh, "model cgebase / cge /;")
    fput(fh, "scalar mstat " + char(34) + "model status of the last solve" + char(34) + ";")
    fput(fh, "* Convergence tolerances are absolute: scaled to the largest level")
    fput(fh, "scalar ptol;")
    fput(fh, "ptol = max(1e-11, 1e-13 * " + _cge_gnum(big) + ");")
    fput(fh, "file optf / %cgesolver%.opt /;")
    fput(fh, "optf.nz = 0;")
    fput(fh, "optf.nr = 2;")
    fput(fh, "optf.nd = 3;")
    fput(fh, d + "ifi %cgesolver% == path   putclose optf 'convergence_tolerance ', ptol:0:3 /;")
    fput(fh, d + "ifi %cgesolver% == conopt putclose optf 'rtnwma ', (ptol / " + _cge_gnum(big) + "):0:3 /;")
    // variables at their bounds stay there in a nonlinear programme (IPOPT
    // otherwise relaxes the bounds by 1e-8)
    fput(fh, d + "ifi %cgesolver% == ipopt  putclose optf 'tol 1e-12' / 'constr_viol_tol ', ptol:0:3 /" +
         (isnlp ? " 'bound_relax_factor 0' /" : "") + ";")
    fput(fh, d + "ifi %cgesolver% == knitro putclose optf 'feastol_abs ', ptol:0:3 / 'feastol 1e-12' /;")
    fput(fh, "cge.optfile = 0;")
    fput(fh, d + "ifi %cgesolver% == path   cge.optfile = 1;")
    fput(fh, d + "ifi %cgesolver% == conopt cge.optfile = 1;")
    fput(fh, d + "ifi %cgesolver% == ipopt  cge.optfile = 1;")
    fput(fh, d + "ifi %cgesolver% == knitro cge.optfile = 1;")
    fput(fh, "cgenlp.optfile = cge.optfile;")
    fput(fh, "cgebase.optfile = cge.optfile;")
    fput(fh, "option limrow = 0, limcol = 0, solprint = off;")
    if (isnlp) {
        fput(fh, "variable OBJV " + char(34) + "objective of the nonlinear programme" + char(34) + ";")
        fput(fh, "equation EOBJV;")
        fput(fh, "EOBJV..  OBJV =e= " + gobj + ";")
        fput(fh, "model cgeprog / " + (subeqs != "" ? subeqs : "cge") + ", EOBJV /;")
        fput(fh, "cgeprog.optfile = cge.optfile;")
        fput(fh, "* The base: the starting levels, not solved (model status 0)")
        fput(fh, "mstat = 0;")
        fput(fh, "OBJV.l = 0;")
    }
    else fput(fh, d + "batinclude cge_solve.gms cgebase")
    fput(fh, "file res / 'cge_base.csv' /;")
    fput(fh, d + "batinclude cge_sa_write.inc res __base__")
    fput(fh, "")
    fput(fh, "* Scenario " + name + ": parameter changes, then fixed variables")
    fput(fh, d + "include cge_shock_par.inc")
    fput(fh, d + "include cge_shock_var.inc")
    fput(fh, d + "include cge_constraints.inc")
    fput(fh, d + "include cge_bounds.inc")
    if (subeqs != "") {
        fput(fh, "* A named model: its equations; the free variables outside it at their levels")
        for (j = 1; j <= rows(fxl); j++) fput(fh, fxl[j])
    }
    if (isnlp) {
        // a mixed-integer programme (from version 0.18.0), solved to a zero gap
        if (type == "minlp" | type == "mip") fput(fh, "option " + type + " = %cgesolver%, optcr = 0, optca = 0;")
        else fput(fh, "option nlp = %cgesolver%;")
        fput(fh, "solve cgeprog using " + (type == "minlp" | type == "mip" ? type : "nlp") + " " +
             (sgn < 0 ? "maximizing" : "minimizing") + " OBJV;")
        fput(fh, "mstat = cgeprog.modelstat;")
    }
    else if (subeqs != "") {
        fput(fh, "model cgesub / " + subeqs + " /;")
        fput(fh, "model cgesubn / " + subeqs + ", EOBJ /;")
        fput(fh, "cgesub.optfile = cge.optfile;")
        fput(fh, "cgesubn.optfile = cge.optfile;")
        fput(fh, d + "ifthen.cgetype %cgetype% == nlp")
        fput(fh, "option nlp = %cgesolver%;")
        fput(fh, "solve cgesubn using nlp minimizing OBJ;")
        fput(fh, "mstat = cgesubn.modelstat;")
        fput(fh, d + "else.cgetype")
        fput(fh, "option cns = %cgesolver%;")
        fput(fh, "solve cgesub using cns;")
        fput(fh, "mstat = cgesub.modelstat;")
        fput(fh, d + "endif.cgetype")
    }
    else fput(fh, d + "batinclude cge_solve.gms cgecon")
    fput(fh, "file rescen / 'cge_" + name + ".csv' /;")
    fput(fh, d + "batinclude cge_sa_write.inc rescen " + name)
    fput(fh, d + "batinclude cge_cons_write.inc rescen " + name)
    fclose(fh)
}

// The periods of dynamic run run, in order (from version 0.5.3)
real colvector _cge_gams_periods(struct cge_model scalar M, string scalar run, | real scalar isloop)
{
    // the scenarios of loop run, in order (from version 0.9.9)
    if (args() > 2) if (isloop) {
        if (!rows(_cge_loop_sims(M, run))) _cge_fail("loop " + run + " not found", 111)
        return(_cge_loop_sims(M, run))
    }
    real colvector s
    s = _cge_which(M.simrun :== run)
    if (!rows(s)) _cge_fail("dynamic run " + run + " not found", 111)
    return(s[order(M.simper[s], 1)])
}

// A dynamic run (from version 0.5.3): the data, then for each period its
// changes from the period before, which GAMS solves in order, each period
// from the solution of the one before
void _cge_gams_export_dyn(string scalar dir, string scalar run, string scalar solver, string scalar type,
                          | real scalar isloop)
{
    struct cge_model scalar M, M2
    struct cge_par scalar p, pprev
    real colvector s, x, xprev, fixed, fx, fr
    string rowvector cl
    string colvector sims
    real scalar k, n, j

    if (args() < 5) isloop = 0
    M = _cge_load()
    _cge_need(M, "calibrated")
    if (_cge_sa(M)) _cge_fail("cge_gams exports the simulations of a standalone model one at a time, with sim()", 198)
    // the scenarios of a loop (from version 0.9.9) are exported as the periods
    // of a run: each from the solution of the one before
    s = _cge_gams_periods(M, run, isloop)
    cl = tokens(M.simclosure[s[1]])
    for (j = 1; j <= rows(s); j++) {
        if (M.simclosure[s[j]] != M.simclosure[s[1]]) _cge_fail("the " + (isloop ? "scenarios" : "periods") + " of " + run + " have different closures", 459)
        p = M.simp[s[j]]
        if (rows(M.bY) & rows(p.bmode) == rows(M.bY)) {
            if (any(p.bmode :> 0)) _cge_fail((isloop ? "loop " : "dynamic run ") + run + " has constraints; cge_gams exports " +
                                             (isloop ? "loops" : "dynamic runs") + " without them", 198)
        }
        if (isloop & !M.simconv[s[j]]) _cge_fail("scenario " + M.simname[s[j]] + " of loop " + run + " did not converge", 459)
    }
    M2 = M
    _cge_swap_parse(M2, _cge_swap_tokens(cl), fx, fr)
    M2.swfix = fx
    M2.swfree = fr
    _cge_closure_cl(M2, cl)
    fixed = M2.fixed
    _cge_gams_data(M, dir + "/cge_data.inc")
    // no constraints: the scenario model is the base model
    (void) _cge_gams_cons(M, M.simp[s[1]], dir + "/cge_constraints.inc")
    _cge_gams_bounds(M, fixed, dir + "/cge_bounds.inc", (type == "mcp"))
    _cge_gams_user(M, dir + "/cge_user.inc", dir + "/cge_user_write.inc")
    pprev = M.p0
    xprev = M.x0
    n = 0
    sims = M.simname[s]
    for (j = 1; j <= rows(s); j++) {
        p = M.simp[s[j]]
        x = M.simx[., s[j]]
        n = n + _cge_gams_scenario(M, p, x, fixed, cl, dir + "/cge_" + sims[j] + "_par.inc",
                                   dir + "/cge_" + sims[j] + "_var.inc", pprev, xprev)
        pprev = p
        xprev = x
    }
    _cge_gams_driver_dyn(dir + "/cge_run.gms", run, sims, solver, type, isloop)
    st_numscalar("r(N_constraints)", 0)
    st_global("r(name)", run)
    st_global("r(sims)", invtokens(sims'))
    st_global("r(closure)", invtokens(cl))
    st_numscalar("r(N_changes)", n)
    st_numscalar("r(N_periods)", rows(s))
    st_numscalar("r(N_accounts)", rows(M.labels))
    printf("{txt}Wrote the model ({res}%f{txt} accounts) and the {res}%f{txt} %s {res}%s{txt} ({res}%f{txt} change(s) in all) to {res}%s\n",
           rows(M.labels), rows(s), (isloop ? "scenarios of loop" : "periods of dynamic run"), run, n, dir)
}

// The driver of a dynamic run: the base, then each period in order; GAMS
// starts each period from the solution of the one before
void _cge_gams_driver_dyn(string scalar fn, string scalar run, string colvector sims, string scalar solver,
                          string scalar type, | real scalar isloop)
{
    real scalar fh, j
    string scalar what
    if (args() < 6) isloop = 0
    // a loop (from version 0.9.9): its scenarios in order, as GAMS's loop
    what = (isloop ? "scenario" : "period")
    fh = _cge_gopen(fn)
    fput(fh, char(36) + "title cge-stata " + (isloop ? "loop" : "dynamic run") + " exported by cge_gams: " + run)
    fput(fh, char(36) + "ontext")
    fput(fh, "Written by cge_gams (cge-stata " + _cge_version() + "). GAMS calibrates the model from the")
    fput(fh, "SAM and settings in cge_data.inc and solves the base, then the " + strofreal(rows(sims)) + " " + what + "s of")
    fput(fh, (isloop ? "loop " : "dynamic run ") + run + " in order. The changes of each " + what + " from the one before,")
    fput(fh, "parameters and closure then fixed variables, are in cge_<" + what + ">_par.inc and")
    fput(fh, "cge_<" + what + ">_var.inc; each " + what + " is solved from the solution of the one")
    fput(fh, "before. The equations are in cge_model.gms (docs/model_spec.md). To run it:")
    fput(fh, "  gams cge_run.gms                                    " + solver + ", as " +
         (type == "nlp" ? "a nonlinear programme" : (type == "mcp" ? "a mixed complementarity problem" :
         "a constrained nonlinear system")))
    fput(fh, "Results: cge_base.csv and cge_<period>.csv for each period, as scenario,")
    fput(fh, "variable, element1, element2, value; the first row holds the model status.")
    fput(fh, char(36) + "offtext")
    fput(fh, char(36) + "if not set cgesolver " + char(36) + "setglobal cgesolver " + solver)
    fput(fh, char(36) + "if not set cgetype " + char(36) + "setglobal cgetype " + type)
    fput(fh, char(36) + "setglobal data cge_data.inc")
    fput(fh, char(36) + "setglobal out cge_base.csv")
    fput(fh, char(36) + "include cge_model.gms")
    fput(fh, char(36) + "include cge_constraints.inc")
    for (j = 1; j <= rows(sims); j++) {
        fput(fh, "")
        fput(fh, "* " + (isloop ? "Scenario " : "Period ") + sims[j] + ": changes from the " + what + " before, then the closure and fixed variables")
        fput(fh, char(36) + "include cge_" + sims[j] + "_par.inc")
        fput(fh, char(36) + "include cge_closure.gms")
        fput(fh, char(36) + "include cge_" + sims[j] + "_var.inc")
        fput(fh, char(36) + "include cge_bounds.inc")
        fput(fh, char(36) + "batinclude cge_solve.gms cgecon")
        fput(fh, "file res" + strofreal(j) + " / 'cge_" + sims[j] + ".csv' /;")
        fput(fh, char(36) + "batinclude cge_write.gms res" + strofreal(j) + " " + sims[j])
    }
    fclose(fh)
}

// Compares every period of dynamic run run with the GAMS results in dir
void _cge_gams_compare_dyn(string scalar dir, string scalar run, | real scalar isloop)
{
    struct cge_model scalar M
    transmorphic A
    string colvector key, e1, e2
    real colvector val, pos, s
    string scalar vb, vs, worstp
    real scalar k, i, j, status, bstatus, db, ds, nb, ns, worst, worststat, nall, walras, wmax

    if (args() < 3) isloop = 0
    M = _cge_load()
    A = asarray_create()
    for (k = 1; k <= rows(M.vname); k++) {
        _cge_vlabels(M, k, e1, e2)
        pos = _cge_vpos(M, k)
        for (i = 1; i <= rows(pos); i++) asarray(A, M.vname[k] + "|" + e1[i] + "|" + e2[i], pos[i])
    }
    s = _cge_gams_periods(M, run, isloop)
    _cge_gams_read(dir + "/cge_base.csv", key, val, bstatus)
    db = _cge_gams_diff(M, A, key, val, M.x0, vb, nb)
    printf("{txt}GAMS model status: base {res}%g{txt}; base: {res}%f{txt} values compared, largest relative difference {res}%9.2e\n",
           bstatus, nb, db)
    worst = 0
    worststat = 1
    worstp = ""
    nall = 0
    wmax = 0
    for (j = 1; j <= rows(s); j++) {
        _cge_gams_read(dir + "/cge_" + M.simname[s[j]] + ".csv", key, val, status)
        ds = _cge_gams_diff(M, A, key, val, M.simx[., s[j]], vs, ns)
        walras = .
        for (i = 1; i <= rows(key); i++) if (key[i] == "WALRAS||") walras = val[i]
        printf("{txt}%s {res}%s{txt}: model status {res}%g{txt}, {res}%f{txt} values compared, largest relative difference {res}%9.2e{txt}%s\n",
               (isloop ? "Scenario" : "Period"), M.simname[s[j]], status, ns, ds, (vs != "" ? " (" + vs + ")" : ""))
        if (ds >= . | ds > worst) {
            worst = ds
            worstp = M.simname[s[j]]
        }
        if (!anyof((1, 2, 15, 16), status)) worststat = status
        if (abs(walras) > wmax | walras >= .) wmax = abs(walras)
        nall = nall + ns
    }
    st_numscalar("r(modelstat)", (worststat == 1 ? status : worststat))
    st_numscalar("r(base_modelstat)", bstatus)
    st_numscalar("r(base_maxdiff)", db)
    st_numscalar("r(maxdiff)", worst)
    st_numscalar("r(N_compared)", nall)
    st_numscalar("r(N_periods)", rows(s))
    st_numscalar("r(walras)", wmax)
    st_global("r(worst_period)", worstp)
    st_global("r(compared_with)", run)
}

// 1 if the scenario (current, or stored simulation sim) has constraints
// 1 if simulation sim is a mixed-integer programme (from version 0.18.0)
real scalar _cge_gams_isint(string scalar sim)
{
    struct cge_model scalar M
    real scalar k
    if (sim == "") return(0)
    M = _cge_load()
    k = _cge_find(M.simname, sim)
    if (!k) return(0)
    return(M.simmethod[k] == "minlp")
}

// 1 if simulation sim is a nonlinear programme (from version 0.15.0)
real scalar _cge_gams_isnlp(string scalar sim)
{
    struct cge_model scalar M
    real scalar k
    if (sim == "") return(0)
    M = _cge_load()
    k = _cge_find(M.simname, sim)
    if (!k) return(0)
    return(M.simmethod[k] == "nlp" | M.simmethod[k] == "minlp")
}

real scalar _cge_gams_hascons(string scalar sim)
{
    struct cge_model scalar M
    struct cge_par scalar p
    M = _cge_load()
    if (M.calibrated != 1 | !rows(M.bY)) return(0)
    if (sim == "") p = M.p
    else {
        if (!_cge_find(M.simname, sim)) return(0)
        p = M.simp[_cge_find(M.simname, sim)]
    }
    if (rows(p.bmode) != rows(M.bY)) return(0)
    return(any(p.bmode :> 0))
}

// Results written by cge_write.gms: keys "variable|element1|element2", values,
// and the model status
void _cge_gams_read(string scalar fn, string colvector key, real colvector val, real scalar status)
{
    string colvector lines
    string rowvector f
    real scalar k, m

    if (!fileexists(fn)) _cge_fail("GAMS did not write " + fn + "; see cge_run.lst in the folder", 601)
    lines = cat(fn)
    key = J(rows(lines), 1, "")
    val = J(rows(lines), 1, .)
    status = .
    m = 0
    for (k = 2; k <= rows(lines); k++) {
        f = _cge_unquote(_cge_split(subinstr(lines[k], char(13), ""), ",", `""""'))
        if (cols(f) < 5) continue
        if (f[2] == "__status__") {
            status = strtoreal(f[5])
            continue
        }
        m++
        key[m] = f[2] + "|" + f[3] + "|" + f[4]
        val[m] = strtoreal(f[5])
    }
    key = (m ? key[|1 \ m|] : J(0, 1, ""))
    val = (m ? val[|1 \ m|] : J(0, 1, .))
}

// Largest relative difference, max(|g - s| / max(1, |s|)), between GAMS
// results and a Stata solution, over the elements that exist in the model;
// the variable where it occurs in vworst
real scalar _cge_gams_diff(struct cge_model scalar M, transmorphic A, string colvector key, real colvector val,
                           real colvector x, string scalar vworst, real scalar nmatch)
{
    real scalar k, pos, d, worst
    worst = 0
    vworst = ""
    nmatch = 0
    for (k = 1; k <= rows(key); k++) {
        if (!asarray_contains(A, key[k])) continue
        pos = asarray(A, key[k])
        if (!M.exists[pos]) continue
        if (substr(key[k], 1, 7) == "WALRAS|") continue
        nmatch++
        d = abs(val[k] - x[pos]) / max((1, abs(x[pos])))
        if (d >= . | d > worst) {
            worst = d
            vworst = substr(key[k], 1, strpos(key[k], "|") - 1)
            if (d >= .) return(.)
        }
    }
    return(worst)
}

// The largest difference between the room within each active constraint's
// bound and its marginal, the move of its adjusting variable, at solution x
// with parameters p, and those GAMS reports (_BROOM and _BMARG, from version
// 0.9.8); nm, the number compared
real scalar _cge_gams_margdiff(struct cge_model scalar M, struct cge_par scalar p, real colvector x,
                               string colvector key, real colvector val, real scalar nm)
{
    real colvector act
    real scalar j, i, room, mv, worst, d, kr, km
    nm = 0
    worst = 0
    if (!rows(M.bY) | rows(p.bmode) != rows(M.bY)) return(0)
    act = _cge_which(p.bmode :> 0)
    for (j = 1; j <= rows(act); j++) {
        i = act[j]
        room = M.btype[i] * (p.bval[i] - x[M.bY[i]])
        mv = M.bdir[i] * (x[M.bX[i]] - (rows(p.bxbar) == rows(M.bY) ? p.bxbar[i] : x[M.bX[i]]))
        kr = _cge_find(key, "_BROOM|" + strofreal(j) + "|")
        km = _cge_find(key, "_BMARG|" + strofreal(j) + "|")
        if (!kr | !km) continue
        d = max((abs(val[kr] - room) / max((1, abs(room))), abs(val[km] - mv) / max((1, abs(mv)))))
        if (d >= .) return(.)
        worst = max((worst, d))
        nm = nm + 2
    }
    return(worst)
}

// Compares the GAMS base and scenario in dir with the Stata base and the
// current solution or stored simulation sim
void _cge_gams_compare(string scalar dir, string scalar sim)
{
    struct cge_model scalar M
    transmorphic A
    string colvector key, e1, e2
    real colvector val, x, pos
    string scalar name, vb, vs
    real scalar k, i, status, bstatus, db, ds, nb, ns, walras, dm, nm, ms, ss

    M = _cge_load()
    A = asarray_create()
    for (k = 1; k <= rows(M.vname); k++) {
        _cge_vlabels(M, k, e1, e2)
        pos = _cge_vpos(M, k)
        for (i = 1; i <= rows(pos); i++) asarray(A, M.vname[k] + "|" + e1[i] + "|" + e2[i], pos[i])
    }
    if (sim == "") {
        name = "current"
        if (!rows(M.simname)) _cge_fail("compare needs a solution: solve the model with cge_solve first, or give sim()", 459)
        k = rows(M.simname)
        sim = M.simname[k]
    }
    else name = sim
    k = _cge_sim_index(M, sim)
    x = M.simx[., k]
    _cge_gams_read(dir + "/cge_base.csv", key, val, bstatus)
    db = _cge_gams_diff(M, A, key, val, M.x0, vb, nb)
    _cge_gams_read(dir + "/cge_" + name + ".csv", key, val, status)
    ds = _cge_gams_diff(M, A, key, val, x, vs, ns)
    // the room within each constraint's bound and its marginal (from version
    // 0.9.8), as the solution listing gives them
    dm = _cge_gams_margdiff(M, M.simp[k], x, key, val, nm)
    if (nm) {
        if (dm >= . | dm > ds) vs = "constraint marginals"
        ds = (dm >= . ? . : max((ds, dm)))
        ns = ns + nm
    }
    walras = .
    for (i = 1; i <= rows(key); i++) if (key[i] == "WALRAS||") walras = val[i]
    if (M.simmethod[k] == "nlp" | M.simmethod[k] == "minlp") printf("{txt}GAMS model status: base not solved (the starting levels of a nonlinear programme), scenario {res}%g{txt} (1 or 2: optimal)\n", status)
    else printf("{txt}GAMS model status: base {res}%g{txt}, scenario {res}%g{txt} (1, 2, 15 or 16: solved)\n", bstatus, status)
    printf("{txt}Base: {res}%f{txt} values compared; largest relative difference {res}%9.2e{txt}%s\n", nb, db,
           (vb != "" ? " (" + vb + ")" : ""))
    printf("{txt}Scenario {res}%s{txt} against simulation {res}%s{txt}: {res}%f{txt} values compared; largest relative difference {res}%9.2e{txt}%s\n",
           name, sim, ns, ds, (vs != "" ? " (" + vs + ")" : ""))
    st_numscalar("r(modelstat)", status)
    st_numscalar("r(base_modelstat)", bstatus)
    st_numscalar("r(base_maxdiff)", db)
    st_numscalar("r(maxdiff)", ds)
    st_numscalar("r(N_compared)", ns)
    st_numscalar("r(walras)", walras)
    // the statuses of the Stata solution (from version 0.16.0), in the same
    // codes
    _cge_simstat(M, k, ms, ss)
    st_numscalar("r(stata_modelstat)", ms)
    st_numscalar("r(stata_solvestat)", ss)
    st_global("r(compared_with)", sim)
}

// =====================================================================
// GDX files (from version 0.10.0), through GAMS and gdxdump
// =====================================================================

// The GAMS program that writes a GDX file (cge_gdx write): the accounts and
// their roles, the SAM, the levels of the variables at the base and at the
// simulations sims, and the calibrated parameters. LEVEL(sim, variable, e1,
// e2) and CAL(name, e1, e2) hold every variable and parameter, with '-' for an
// index a symbol does not have; GAMS does not store zeros.
void _cge_gdx_write(string scalar fgms, string scalar gdxname, string scalar s_sims)
{
    struct cge_model scalar M
    string matrix keys
    string colvector e1, e2, sn, rec, lab
    string rowvector tok
    real colvector val, s, pos, x
    real scalar fh, k, i, j, n
    M = _cge_load()
    _cge_need(M, "calibrated")
    tok = tokens(s_sims)
    if (cols(tok) == 1) if (tok[1] == "_all") tok = (rows(M.simname) ? M.simname' : J(1, 0, ""))
    s = J(cols(tok), 1, .)
    for (k = 1; k <= cols(tok); k++) s[k] = _cge_sim_index(M, tok[k])
    sn = "base" \ (rows(s) ? M.simname[s] : J(0, 1, ""))
    for (k = 2; k <= rows(sn); k++) if (sn[k] == "base") _cge_fail("cge_gdx: a simulation named base cannot be written; base is the base", 198)
    fh = _cge_gopen(fgms)
    if (_cge_sa(M)) {
        fput(fh, "* Written by cge_gdx (cge-stata " + _cge_version() + "): the labels of a standalone model,")
        fput(fh, "* its user parameters (CAL) and the levels of the variables (LEVEL) at the")
    }
    else {
        fput(fh, "* Written by cge_gdx (cge-stata " + _cge_version() + "): the accounts and their roles, the SAM,")
        fput(fh, "* the calibrated parameters (CAL) and the levels of the variables (LEVEL) at the")
    }
    fput(fh, "* base and the simulations, written to " + gdxname + " by GAMS")
    fput(fh, char(36) + "onempty")
    // a standalone model (from version 0.13.0): its labels, without the roles
    // of accounts or a SAM
    if (_cge_sa(M)) {
        lab = _cge_us_alllabels(M)
        fput(fh, "set AC" + (rows(lab) ? "" : "(*)") + " 'labels of the model' /")
        for (k = 1; k <= rows(lab); k++) fput(fh, "    '" + lab[k] + "'" + (k < rows(lab) ? "," : ""))
        fput(fh, "/;")
        fput(fh, "alias (AC, ACP);")
    }
    else {
        fput(fh, "set AC 'accounts' /")
        for (k = 1; k <= rows(M.labels); k++) fput(fh, "    '" + M.labels[k] + "'" + (k < rows(M.labels) ? "," : ""))
        fput(fh, "/;")
        fput(fh, "alias (AC, ACP);")
        _cge_gset(fh, "A", M.A)
        _cge_gset(fh, "C", M.C)
        _cge_gset(fh, "F", M.F)
        _cge_gset(fh, "H", M.H)
        _cge_gset(fh, "E", M.E)
        fput(fh, "parameter SAM(AC, AC) 'social accounting matrix' /")
        n = sum(M.S :!= 0)
        j = 0
        for (i = 1; i <= rows(M.S); i++) {
            for (k = 1; k <= cols(M.S); k++) {
                if (M.S[i, k] == 0) continue
                j++
                fput(fh, "    '" + M.labels[i] + "'.'" + M.labels[k] + "' " + _cge_gnum17(M.S[i, k]) + (j < n ? "," : ""))
            }
        }
        fput(fh, "/;")
    }
    // the levels of the variables
    fput(fh, "set sim 'the base and the simulations' /")
    for (k = 1; k <= rows(sn); k++) fput(fh, "    '" + sn[k] + "'" + (k < rows(sn) ? "," : ""))
    fput(fh, "/;")
    fput(fh, "parameter LEVEL(sim, *, *, *) 'levels of the variables: simulation, variable, element, element' /")
    rec = J(0, 1, "")
    for (j = 1; j <= rows(sn); j++) {
        x = (j == 1 ? M.x0 : M.simx[., s[j - 1]])
        for (k = 1; k <= rows(M.vname); k++) {
            pos = _cge_vpos(M, k)
            if (!rows(pos)) continue
            _cge_vlabels(M, k, e1, e2)
            for (i = 1; i <= rows(pos); i++) {
                if (!M.exists[pos[i]] | x[pos[i]] == 0 | x[pos[i]] >= .) continue
                rec = rec \ ("    '" + sn[j] + "'.'" + M.vname[k] + "'.'" + (e1[i] == "" ? "-" : e1[i]) + "'.'" +
                             (e2[i] == "" ? "-" : e2[i]) + "' " + _cge_gnum17(x[pos[i]]))
            }
        }
    }
    for (i = 1; i <= rows(rec); i++) fput(fh, rec[i] + (i < rows(rec) ? "," : ""))
    fput(fh, "/;")
    // after the levels: GAMS's labels ignore case and keep the case they are
    // first written in, so that variables such as QG keep theirs and a
    // parameter of the same name, qg, shares the label
    // the calibrated parameters, at the base
    keys = J(0, 3, "")
    val = J(0, 1, .)
    _cge_param_list(M, M.p0, keys, val)
    n = sum(val :!= 0 :& val :< .)
    fput(fh, "parameter CAL(*, *, *) 'calibrated parameters: name, element, element' /")
    j = 0
    for (i = 1; i <= rows(val); i++) {
        if (val[i] == 0 | val[i] >= .) continue
        j++
        fput(fh, "    '" + keys[i, 1] + "'.'" + (keys[i, 2] == "" ? "-" : keys[i, 2]) + "'.'" + (keys[i, 3] == "" ? "-" : keys[i, 3]) + "' " +
                 _cge_gnum17(val[i]) + (j < n ? "," : ""))
    }
    fput(fh, "/;")
    if (_cge_sa(M)) fput(fh, "execute_unload '" + gdxname + "', AC, CAL, sim, LEVEL;")
    else fput(fh, "execute_unload '" + gdxname + "', AC, A, C, F, H, E, SAM, CAL, sim, LEVEL;")
    fclose(fh)
    st_numscalar("r(N_sims)", rows(sn) - 1)
    st_numscalar("r(N_levels)", rows(rec))
    st_numscalar("r(N_parameters)", sum(val :!= 0 :& val :< .))
    st_global("r(sims)", invtokens(sn'))
}

// A number for the GAMS program of a GDX file: 17 significant digits, which
// a correctly rounded parser, as GAMS's, reads as the same double. Fewer
// digits, as _cge_gnum chooses, may not be: Stata's own reading of decimals,
// by which it checks them, is not always correctly rounded.
string scalar _cge_gnum17(real scalar x)
{
    string scalar s
    if (x == 0) return("0")
    s = strtrim(sprintf("%25.17g", x))
    if (substr(s, 1, 1) == ".") s = "0" + s
    else if (substr(s, 1, 2) == "-.") s = "-0" + substr(s, 2, .)
    return(s)
}

// A number written by gdxdump: a decimal or, with dFormat=hexponential, a
// hexadecimal float such as 0x1.5555555555555p-2, read exactly; Eps is 0, and
// +Inf, -Inf, NA and Undf are missing
real scalar _cge_hexf(string scalar s0)
{
    string scalar s, h, f
    real scalar sg, p, k, m, e, i, d
    s = strtrim(s0)
    if (s == "") return(.)
    if (strlower(s) == "eps") return(0)
    if (anyof(("+inf", "-inf", "inf", "na", "undf"), strlower(s))) return(.)
    sg = 1
    if (substr(s, 1, 1) == "-") {
        sg = -1
        s = substr(s, 2, .)
    }
    else if (substr(s, 1, 1) == "+") s = substr(s, 2, .)
    if (strlower(substr(s, 1, 2)) != "0x") return(strtoreal(s0))
    s = strlower(substr(s, 3, .))
    p = strpos(s, "p")
    if (!p) return(.)
    e = strtoreal(substr(s, p + 1, .))
    h = substr(s, 1, p - 1)
    k = strpos(h, ".")
    f = (k ? substr(h, k + 1, .) : "")
    h = (k ? substr(h, 1, k - 1) : h)
    // the digits as an integer, exact in a double up to 53 bits
    m = 0
    for (i = 1; i <= strlen(h); i++) {
        d = strpos("0123456789abcdef", substr(h, i, 1)) - 1
        if (d < 0) return(.)
        m = m * 16 + d
    }
    for (i = 1; i <= strlen(f); i++) {
        d = strpos("0123456789abcdef", substr(f, i, 1)) - 1
        if (d < 0) return(.)
        m = m * 16 + d
    }
    return(sg * m * _cge_pow2(e - 4 * strlen(f)))
}

// 2^k, exactly, for k from -1074 to 1023 (Mata's 2^k is not always exact): a
// table made by doubling and halving, which are exact, kept for later calls
real scalar _cge_pow2(real scalar k)
{
    pointer() scalar q
    real colvector P
    real scalar j
    if (k < -1074 | k > 1023 | k != floor(k)) return(.)
    if ((q = findexternal("cge__pow2")) == NULL) {
        P = J(2098, 1, .)
        P[1075] = 1
        for (j = 1; j <= 1023; j++) P[1075 + j] = P[1074 + j] * 2
        for (j = 1; j <= 1074; j++) P[1075 - j] = P[1076 - j] / 2
        q = crexternal("cge__pow2")
        *q = P
    }
    return((*q)[1075 + k])
}

// The CSV file that gdxdump writes for a symbol, as the data in memory: one
// observation per record, a string variable per index named from the
// header (dim1, dim2, ... for indexes without a domain), and value, or for
// a variable or an equation level, marginal, lower, upper and scale, or for
// a set its text
void _cge_gdx_csv(string scalar fn, string scalar symbol)
{
    string colvector lines, nm, T
    string rowvector f, hd
    string matrix L
    real matrix V
    real scalar k, i, nd, nv, n, j
    string scalar kind
    if (!fileexists(fn)) _cge_fail("cge_gdx: gdxdump wrote no " + fn, 601)
    lines = cat(fn)
    lines = select(lines, strtrim(subinstr(lines, char(13), "")) :!= "")
    if (!rows(lines)) _cge_fail("cge_gdx: " + fn + " is empty: the symbol " + symbol + " is not in the GDX file", 459)
    hd = _cge_unquote(_cge_split(subinstr(lines[1], char(13), ""), ",", `""""'))
    // the fields after the indexes: Val, or Val Marginal Lower Upper Scale, or Text
    nv = 1
    kind = "parameter"
    if (anyof(hd, "Marginal")) {
        nv = 5
        kind = "variable"
    }
    else if (hd[cols(hd)] == "Text") kind = "set"
    nd = cols(hd) - nv
    nm = J(nd, 1, "")
    for (k = 1; k <= nd; k++) {
        nm[k] = strtoname(strlower(hd[k]))
        if (regexm(nm[k], "^dim[0-9]+$") | nm[k] == "" | anyof(("value", "level", "marginal", "lower", "upper", "scale", "text"), nm[k])) {
            nm[k] = "dim" + strofreal(k)
        }
        for (j = 1; j < k; j++) if (nm[j] == nm[k]) nm[k] = nm[k] + "_" + strofreal(k)
    }
    n = rows(lines) - 1
    L = J(n, nd, "")
    V = J(n, nv, .)
    T = J(n, 1, "")
    for (i = 1; i <= n; i++) {
        f = _cge_unquote(_cge_split(subinstr(lines[i + 1], char(13), ""), ",", `""""'))
        if (cols(f) < nd) _cge_fail("cge_gdx: line " + strofreal(i + 1) + " of " + fn + " has too few fields", 459)
        if (nd) L[i, .] = f[|1 \ nd|]
        if (kind == "set") T[i] = (cols(f) > nd ? f[nd + 1] : "")
        else for (k = 1; k <= nv; k++) V[i, k] = (cols(f) >= nd + k ? _cge_hexf(f[nd + k]) : .)
    }
    stata("clear")
    st_addobs(n)
    for (k = 1; k <= nd; k++) {
        (void) st_addvar("str" + strofreal(max((1, max(strlen(L[., k]))))), nm[k])
        st_sstore(., nm[k], L[., k])
        st_varlabel(nm[k], hd[k])
    }
    if (kind == "set") {
        (void) st_addvar("str" + strofreal(max((1, max(strlen(T))))), "text")
        st_sstore(., "text", T)
    }
    else if (kind == "variable") {
        (void) st_addvar(("double", "double", "double", "double", "double"), ("level", "marginal", "lower", "upper", "scale"))
        st_store(., ("level", "marginal", "lower", "upper", "scale"), V)
    }
    else {
        (void) st_addvar("double", "value")
        st_store(., "value", V[., 1])
    }
    st_numscalar("r(N)", n)
    st_numscalar("r(dim)", nd)
    st_global("r(kind)", kind)
    st_global("r(indexes)", invtokens(nm'))
    st_global("r(symbol)", symbol)
}

// The list of symbols that gdxdump writes (symbols): their name, dimension,
// type, number of records and text
void _cge_gdx_symbols(string scalar fn, real scalar clear)
{
    string colvector lines, nm, ty, tx
    string rowvector t
    real colvector dm, nr
    real scalar k, n, i, p
    if (!fileexists(fn)) _cge_fail("cge_gdx: gdxdump wrote no " + fn, 601)
    lines = cat(fn)
    nm = ty = tx = J(0, 1, "")
    dm = nr = J(0, 1, .)
    for (k = 1; k <= rows(lines); k++) {
        t = tokens(subinstr(lines[k], char(13), ""))
        if (cols(t) < 5) continue
        if (strtoreal(t[1]) >= . | strtoreal(t[3]) >= . | strtoreal(t[5]) >= .) continue
        nm = nm \ t[2]
        dm = dm \ strtoreal(t[3])
        ty = ty \ t[4]
        nr = nr \ strtoreal(t[5])
        tx = tx \ (cols(t) > 5 ? invtokens(t[|6 \ cols(t)|]) : "")
    }
    n = rows(nm)
    printf("{txt}%-20s %4s %-6s %9s  %s\n{hline 72}\n", "Symbol", "Dim", "Type", "Records", "Text")
    for (i = 1; i <= n; i++) printf("{res}%-20s {txt}%4.0f %-6s %9.0f  %s\n", nm[i], dm[i], ty[i], nr[i], _cge_trunc(tx[i], 28))
    printf("{txt}{hline 72}\n")
    if (clear) {
        stata("clear")
        st_addobs(n)
        (void) st_addvar("str" + strofreal(max((1, max(strlen(nm))))), "symbol")
        (void) st_addvar("byte", "dim")
        (void) st_addvar("str" + strofreal(max((1, max(strlen(ty))))), "type")
        (void) st_addvar("double", "records")
        (void) st_addvar("str" + strofreal(max((1, max(strlen(tx))))), "text")
        if (n) {
            st_sstore(., "symbol", nm)
            st_store(., "dim", dm)
            st_sstore(., "type", ty)
            st_store(., "records", nr)
            st_sstore(., "text", tx)
        }
    }
    st_numscalar("r(N_symbols)", n)
    st_global("r(symbols)", invtokens(nm'))
}

// =====================================================================
// User variables and equations (model_spec.md, Section 19; from version 0.6.1)
// =====================================================================

// =====================================================================
// User sets and parameters (from version 0.7.1; Reference Manual, User
// variables and equations)
// =====================================================================
//
// A user set is an ordered list of element labels (M.usdef: name, labels).
// Its code in the set fields of variables and parameters is "~" followed by
// its name; model sets keep their letters (A, C, F, H, D, I, N). A user
// parameter (M.updef: name, set of the first index, set of the second) has
// its values, row by row, in p.upval, after those of the parameters before it.

// Number of indexes of a set code: "" none, "~name" one, else its letters
real scalar _cge_nidx(string scalar set)
{
    if (set == "") return(0)
    if (strpos(set, "|")) return(2)
    if (substr(set, 1, 1) == "~") return(1)
    return(strlen(set))
}

// Index of user set name, 0 if none
real scalar _cge_us_find(struct cge_model scalar M, string scalar name)
{
    if (rows(M.usdef) == 0 | cols(M.usdef) < 2) return(0)
    return(_cge_find(M.usdef[., 1], name))
}

// Labels of user set k
string colvector _cge_us_labels(struct cge_model scalar M, real scalar k)
{
    return(tokens(M.usdef[k, 2])')
}

// Index of user parameter name, 0 if none
real scalar _cge_up_find(struct cge_model scalar M, string scalar name)
{
    if (rows(M.updef) == 0 | cols(M.updef) != 3) return(0)
    return(_cge_find(M.updef[., 1], name))
}

// Number of values of user parameter k
real scalar _cge_up_len(struct cge_model scalar M, real scalar k)
{
    return((M.updef[k, 2] == "" ? 1 : _cge_setsize(M, M.updef[k, 2])) *
           (M.updef[k, 3] == "" ? 1 : _cge_setsize(M, M.updef[k, 3])))
}

// Positions in p.upval of the values of user parameter k
real colvector _cge_up_pos(struct cge_model scalar M, real scalar k)
{
    real scalar off, j
    off = 0
    for (j = 1; j < k; j++) off = off + _cge_up_len(M, j)
    return(off :+ (1::_cge_up_len(M, k)))
}

// Labels of the elements of user parameter k, in storage order
void _cge_up_labels(struct cge_model scalar M, real scalar k, string colvector e1, string colvector e2)
{
    string colvector s1, s2
    real scalar i
    if (M.updef[k, 2] == "") {
        e1 = ""
        e2 = ""
        return
    }
    s1 = _cge_setlab(M, M.updef[k, 2])
    if (M.updef[k, 3] == "") {
        e1 = s1
        e2 = J(rows(s1), 1, "")
        return
    }
    s2 = _cge_setlab(M, M.updef[k, 3])
    e1 = J(rows(s1) * rows(s2), 1, "")
    e2 = e1
    for (i = 1; i <= rows(s1); i++) {
        e1[|(i - 1) * rows(s2) + 1 \ i * rows(s2)|] = J(rows(s2), 1, s1[i])
        e2[|(i - 1) * rows(s2) + 1 \ i * rows(s2)|] = s2
    }
}

// The labels of every model set together
string colvector _cge_alllabels(struct cge_model scalar M)
{
    // a standalone model (from version 0.13.0): the labels of its sets
    if (_cge_sa(M)) return(_cge_us_alllabels(M))
    return(M.A \ M.C \ M.F \ M.H \ M.D \ M.I \ M.N)
}

// The labels of the user sets of one index, each once, in the order they
// were defined (from version 0.13.0)
string colvector _cge_us_alllabels(struct cge_model scalar M)
{
    string colvector out
    string rowvector tk
    transmorphic A
    real scalar k, j
    out = J(0, 1, "")
    if (!rows(M.usdef)) return(out)
    A = asarray_create()
    for (k = 1; k <= rows(M.usdef); k++) {
        if (_cge_us_pairs(M, k)) continue
        tk = tokens(M.usdef[k, 2])
        for (j = 1; j <= cols(tk); j++) {
            if (asarray_contains(A, tk[j])) continue
            asarray(A, tk[j], 1)
            out = out \ tk[j]
        }
    }
    return(out)
}

// A new label of a standalone model's set (from version 0.13.0): letters,
// digits and underscores, at most 32 characters, and not a name the
// language reads otherwise
string scalar _cge_us_newlabel(struct cge_model scalar M, string scalar s)
{
    if (!regexm(s, "^[A-Za-z0-9_]+$") | strlen(s) > 32) {
        _cge_fail("cge_set: " + s + ": a label has letters, digits and underscores, at most 32 characters", 198)
    }
    if (anyof(_cge_u_reserved(), s)) _cge_fail("cge_set: " + s + " is a reserved word", 198)
    if (_cge_us_find(M, s)) _cge_fail("cge_set: " + s + " is the name of a user set", 110)
    if (_cge_up_find(M, s)) _cge_fail("cge_set: " + s + " is the name of a user parameter", 110)
    if (_cge_vidx(M, s)) _cge_fail("cge_set: " + s + " is the name of a variable", 110)
    return(s)
}

// The reserved words of the user language
string rowvector _cge_u_reserved()
{
    return(("sum", "base", "exp", "ln", "log", "sqrt", "all", "ord", "sameas", "lag", "lead", "prod", "smax", "smin", "card",
            "min", "max", "abs", "sqr", "log10", "ifthen", "tperiod", "tfirst", "tlast"))
}

// Names that a user set or parameter may not take
void _cge_u_newname(struct cge_model scalar M, string scalar name, string scalar what)
{
    if (!regexm(name, "^[A-Za-z_][A-Za-z_0-9]*$") | strlen(name) > 24) {
        _cge_fail(what + " " + name + ": a name has letters, digits and underscores, at most 24 characters, and starts with a letter", 198)
    }
    if (anyof(("sum", "base", "exp", "ln", "log", "sqrt", "all", "ord", "sameas", "lag", "lead", "prod", "smax", "smin", "card",
               "min", "max", "abs", "sqr", "log10", "ifthen", "tperiod", "tfirst", "tlast"), name)) {
        _cge_fail(name + " is a reserved word", 198)
    }
    if (_cge_um_find(M, name)) _cge_fail(name + " is the name of a macro", 110)
    // a standalone model has no model sets or parameters (from version 0.13.0)
    if (!_cge_sa(M) & regexm(name, "^[acfhdin][0-9]*$")) _cge_fail(name + " is the index of a model set", 198)
    if (_cge_vidx(M, name)) _cge_fail(name + " is the name of a variable", 110)
    if (!_cge_sa(M) & (_cge_find(_cge_gams_params()[., 1], name) | anyof(("mort", "tf"), name))) _cge_fail(name + " is the name of a model parameter", 110)
    if (_cge_us_find(M, name)) _cge_fail(name + " is the name of a user set", 110)
    if (_cge_up_find(M, name)) _cge_fail(name + " is the name of a user parameter", 110)
    if (anyof(_cge_alllabels(M), name)) _cge_fail(name + " is the label of an element of the model", 110)
    if (rows(M.uedef)) {
        if (anyof(M.uedef[., 1], name)) _cge_fail(name + " is the name of a user equation", 110)
    }
}

// The set code of an index: a model set letter, with digits if needed (c,
// c2), or the name of a user set, with digits if needed (hc, hc2)
string scalar _cge_u_set(struct cge_model scalar M, string scalar idx)
{
    string scalar base
    if (_cge_us_find(M, idx)) {
        if (_cge_us_pairs(M, _cge_us_find(M, idx))) {
            _cge_fail(idx + " is a set of pairs: use it in a condition, " + idx + "(i,j), or a sum, sum(" + idx + "(i,j), ...)", 198)
        }
        return("~" + idx)
    }
    if (!_cge_sa(M) & regexm(idx, "^[acfhdin][0-9]*$")) return(strupper(substr(idx, 1, 1)))
    if (regexm(idx, "^(.*[^0-9])[0-9]+$")) {
        base = regexs(1)
        if (_cge_us_find(M, base)) return("~" + base)
    }
    if (_cge_sa(M)) _cge_fail("index " + idx + " is not a user set (cge_set), or a user set with digits after it", 198)
    _cge_fail("index " + idx + " is neither a model set (a, c, f, h, d, i, n) nor a user set", 198)
}

// 1 if s has the form of an index: a model set letter or a user set, with digits
real scalar _cge_u_isindex(struct cge_model scalar M, string scalar s)
{
    if (!_cge_sa(M) & regexm(s, "^[acfhdin][0-9]*$")) return(1)
    if (_cge_us_find(M, s)) return(1)
    if (regexm(s, "^(.*[^0-9])[0-9]+$")) return(_cge_us_find(M, regexs(1)) > 0)
    return(0)
}

// cge_set name = elements [, except(elements)]: elements are labels, model
// set letters (a c f h d i n) or user sets, written out
void _cge_us_add(string scalar spec)
{
    struct cge_model scalar M
    string scalar head, expr, opts, name, ex, fv
    string rowvector t, ot, so
    string colvector lab, all, drop, raw
    real scalar k, j
    M = _cge_load()
    _cge_need(M, "calibrated")
    _cge_u_split(spec, head, expr, opts)
    name = strtrim(head)
    // a set of pairs (from version 0.9.1): cge_set map(a,c) = e1.e2 ...
    if (regexm(name, "^([A-Za-z_][A-Za-z_0-9]*)[ ]*\([ ]*([A-Za-z_][A-Za-z_0-9]*)[ ]*,[ ]*([A-Za-z_][A-Za-z_0-9]*)[ ]*\)$")) {
        _cge_us_addpairs(M, regexs(1), regexs(2), regexs(3), expr, opts)
        return
    }
    // the elements from a string variable in memory (from version 0.13.0),
    // with from(); except() leaves some out
    so = _cge_u_opts(opts, ("except", "from"), (6, 4), "cge_set")
    ex = so[1]
    fv = so[2]
    if ((expr == "") == (fv == "")) _cge_fail("cge_set: write cge_set name = elements, or cge_set name, from(varname)", 198)
    _cge_u_newname(M, name, "set")
    all = _cge_alllabels(M)
    lab = J(0, 1, "")
    if (fv != "") {
        if (_st_varindex(fv) >= .) _cge_fail("cge_set: from(): variable " + fv + " not found", 111)
        if (!st_isstrvar(fv)) _cge_fail("cge_set: from(): " + fv + " is not a string variable", 109)
        raw = st_sdata(., fv)
        t = J(1, 0, "")
        for (k = 1; k <= rows(raw); k++) if (strtrim(raw[k]) != "") t = t, strtrim(raw[k])
        if (!cols(t)) _cge_fail("cge_set: from(): " + fv + " has no labels", 459)
    }
    else t = tokens(expr)
    for (k = 1; k <= cols(t); k++) {
        if (fv == "" & !_cge_sa(M) & regexm(t[k], "^[acfhdin]$")) lab = lab \ _cge_setlab(M, strupper(t[k]))
        else if (fv == "" & _cge_us_find(M, t[k])) lab = lab \ _cge_us_labels(M, _cge_us_find(M, t[k]))
        else if (anyof(all, t[k])) lab = lab \ t[k]
        // a new label of a standalone model (from version 0.13.0)
        else if (_cge_sa(M)) lab = lab \ _cge_us_newlabel(M, t[k])
        else _cge_fail("cge_set: " + t[k] + " is not an element, a model set (a c f h d i n) or a user set", 111)
    }
    drop = J(0, 1, "")
    t = tokens(ex)
    for (k = 1; k <= cols(t); k++) {
        if (!_cge_sa(M) & regexm(t[k], "^[acfhdin]$")) drop = drop \ _cge_setlab(M, strupper(t[k]))
        else if (_cge_us_find(M, t[k])) drop = drop \ _cge_us_labels(M, _cge_us_find(M, t[k]))
        else if (anyof(all, t[k])) drop = drop \ t[k]
        else _cge_fail("cge_set: except(): " + t[k] + " is not an element, a model set or a user set", 111)
    }
    // each element once, in the order given, less the exceptions
    ot = J(1, 0, "")
    for (k = 1; k <= rows(lab); k++) {
        if (anyof(drop, lab[k])) continue
        j = 0
        if (cols(ot)) j = anyof(ot, lab[k])
        if (!j) ot = ot, lab[k]
    }
    if (cols(ot) == 0) _cge_fail("cge_set: the set " + name + " has no elements", 198)
    _cge_us_widen(M)
    M.usdef = M.usdef \ (name, invtokens(ot), "")
    _cge_store(M)
    printf("{txt}User set {res}%s{txt}: %f element(s): {res}%s\n", name, cols(ot), invtokens(ot[|1 \ min((cols(ot), 8))|]) + (cols(ot) > 8 ? " ..." : ""))
    st_global("r(name)", name)
    st_global("r(elements)", invtokens(ot))
    st_numscalar("r(N_elements)", cols(ot))
}

// The user sets with the column of the sets of pairs (from version 0.9.1)
void _cge_us_widen(struct cge_model scalar M)
{
    if (rows(M.usdef) == 0 & cols(M.usdef) != 3) M.usdef = J(0, 3, "")
    if (cols(M.usdef) == 2) M.usdef = M.usdef, J(rows(M.usdef), 1, "")
}

// cge_set name(i,j) = e1.e2 ...: a set of pairs of elements of the sets of
// indexes i and j (from version 0.9.1)
void _cge_us_addpairs(struct cge_model scalar M, string scalar name, string scalar i, string scalar j,
                      string scalar expr, string scalar opts)
{
    string colvector l1, l2
    string rowvector t, pr, ot
    string scalar s1, s2
    real scalar k
    _cge_u_newname(M, name, "set")
    if (opts != "") _cge_fail("cge_set: a set of pairs takes no options", 198)
    if (i == j) _cge_fail("cge_set: give two different indexes, as (c,c2)", 198)
    s1 = _cge_u_set(M, i)
    s2 = _cge_u_set(M, j)
    l1 = _cge_setlab(M, s1)
    l2 = _cge_setlab(M, s2)
    t = tokens(expr)
    ot = J(1, 0, "")
    for (k = 1; k <= cols(t); k++) {
        pr = tokens(t[k], ".")
        pr = select(pr, pr :!= ".")
        if (cols(pr) != 2) _cge_fail("cge_set: write the pairs as e1.e2, for example act_agr.com_agr", 198)
        if (!anyof(l1, pr[1])) _cge_fail("cge_set: " + pr[1] + " is not an element of the set of " + i, 111)
        if (!anyof(l2, pr[2])) _cge_fail("cge_set: " + pr[2] + " is not an element of the set of " + j, 111)
        if (cols(ot)) {
            if (anyof(ot, pr[1] + "." + pr[2])) continue
        }
        ot = ot, pr[1] + "." + pr[2]
    }
    if (!cols(ot)) _cge_fail("cge_set: the set " + name + " has no pairs", 198)
    _cge_us_widen(M)
    M.usdef = M.usdef \ (name, invtokens(ot), s1 + "|" + s2)
    _cge_store(M)
    printf("{txt}User set {res}%s(%s,%s){txt}: %f pair(s): {res}%s\n", name, i, j, cols(ot),
           invtokens(ot[|1 \ min((cols(ot), 6))|]) + (cols(ot) > 6 ? " ..." : ""))
    st_global("r(name)", name)
    st_global("r(elements)", invtokens(ot))
    st_numscalar("r(N_elements)", cols(ot))
}

// 1 if user set name is used by a user variable, equation or parameter
real scalar _cge_us_used(struct cge_model scalar M, string scalar name)
{
    real scalar k
    string scalar code
    code = "~" + name
    for (k = 1; k <= rows(M.uvdef); k++) if (M.uvdef[k, 2] == code) return(1)
    for (k = 1; k <= rows(M.uedef); k++) if (M.uedef[k, 3] == code) return(1)
    for (k = 1; k <= rows(M.updef); k++) if (M.updef[k, 2] == code | M.updef[k, 3] == code) return(1)
    // sums and other references in user expressions
    for (k = 1; k <= rows(M.uvdef); k++) if (anyof(_cge_u_tokens(M.uvdef[k, 3]), name)) return(1)
    for (k = 1; k <= rows(M.uedef); k++) {
        if (anyof(_cge_u_tokens(M.uedef[k, 4]), name) | anyof(_cge_u_tokens(M.uedef[k, 5]), name)) return(1)
    }
    // conditions (from version 0.7.2)
    if (cols(M.uvdef) >= 7) for (k = 1; k <= rows(M.uvdef); k++) if (anyof(_cge_u_tokens(M.uvdef[k, 7]), name)) return(1)
    if (cols(M.uedef) >= 6) for (k = 1; k <= rows(M.uedef); k++) if (anyof(_cge_u_tokens(M.uedef[k, 6]), name)) return(1)
    // macros (from version 0.9.7)
    if (rows(M.umac) & cols(M.umac) >= 3) for (k = 1; k <= rows(M.umac); k++) if (anyof(_cge_u_tokens(M.umac[k, 3]), name)) return(1)
    return(0)
}

void _cge_us_list()
{
    struct cge_model scalar M
    real scalar k
    string scalar s1, s2
    M = _cge_load()
    st_numscalar("r(N_sets)", rows(M.usdef))
    if (!rows(M.usdef)) {
        printf("{txt}No user sets\n")
        return
    }
    for (k = 1; k <= rows(M.usdef); k++) {
        if (_cge_us_pairs(M, k)) {
            _cge_setparts(M.usdef[k, 3], s1, s2)
            printf("{txt}set {res}%s(%s,%s){txt} (%f pairs): %s\n", M.usdef[k, 1], _cge_us_index(s1), _cge_us_index(s2),
                   cols(tokens(M.usdef[k, 2])), M.usdef[k, 2])
        }
        else printf("{txt}set {res}%s{txt} (%f): %s\n", M.usdef[k, 1], cols(tokens(M.usdef[k, 2])), M.usdef[k, 2])
    }
}

// The index written for a set code: a for A, name for ~name (from version 0.9.1)
string scalar _cge_us_index(string scalar code)
{
    if (substr(code, 1, 1) == "~") return(substr(code, 2, .))
    return(strlower(code))
}

// Removes every user set; sets that user variables, equations or parameters
// use must be removed with them first
void _cge_us_clear()
{
    struct cge_model scalar M
    real scalar k
    M = _cge_load()
    for (k = 1; k <= rows(M.usdef); k++) {
        if (_cge_us_used(M, M.usdef[k, 1])) _cge_fail("set " + M.usdef[k, 1] + " is used by user variables, equations or parameters: remove them first", 459)
    }
    M.usdef = J(0, 3, "")
    _cge_store(M)
    printf("{txt}User sets removed\n")
}

// The contents of the options in opts, name(contents) separated by spaces,
// for each option of names; an option may be abbreviated to the length in
// minlen. A missing option is "".
string rowvector _cge_u_opts(string scalar opts, string rowvector names, real rowvector minlen, string scalar cmd)
{
    string rowvector out
    string scalar s, nm, ch
    real scalar k, d, j, start, hit, i
    out = J(1, cols(names), "")
    s = strtrim(opts)
    k = 1
    while (k <= strlen(s)) {
        if (substr(s, k, 1) == " ") {
            k++
            continue
        }
        start = k
        while (k <= strlen(s) & substr(s, k, 1) != "(" & substr(s, k, 1) != " ") k++
        nm = substr(s, start, k - start)
        if (k > strlen(s) | substr(s, k, 1) != "(") _cge_fail(cmd + ": option " + nm + " needs its value in parentheses", 198)
        d = 0
        j = k
        for (; j <= strlen(s); j++) {
            ch = substr(s, j, 1)
            if (ch == "(") d++
            else if (ch == ")") {
                d--
                if (!d) break
            }
        }
        if (d) _cge_fail(cmd + ": a parenthesis is not closed", 198)
        hit = 0
        for (i = 1; i <= cols(names); i++) {
            if (strlen(nm) >= minlen[i] & strlen(nm) <= strlen(names[i]) & substr(names[i], 1, strlen(nm)) == nm) {
                out[i] = strtrim(substr(s, k + 1, j - k - 1))
                hit = 1
            }
        }
        if (!hit) _cge_fail(cmd + ": unknown option " + nm, 198)
        k = j + 1
    }
    return(out)
}

// cge_parameter name[(i[,j])][$(condition)] = expression | , values(spec)
// default(#) | , from(varlist) labels(varlist): a user parameter (from version
// 0.7.1). From version 0.13.0 the value is an expression of numbers,
// parameters and base values, evaluated element by element over the elements
// that meet the condition, as GAMS's assignments, and a parameter that exists
// is assigned again if no user variable, equation or macro uses it; from()
// takes data in long form, one observation per element, or for a parameter
// with two indexes in wide form, one variable for each element of the second
// index, named as it, with labels() giving the first.
void _cge_up_add(string scalar spec)
{
    struct cge_model scalar M
    struct cge_par scalar q
    struct cge_par rowvector sp
    string scalar head, expr, opts, name, idx, set, i1, i2, s1, s2, el, values, fromvar, labvars, cond
    string rowvector tok, lv, fv, pair, ab, ov
    string colvector e1, e2, d1, d2, l1, l2
    real colvector v, o1, o2, pos, old
    real matrix X
    real scalar k, n, j, c, dflt, again, kk, r1, r2
    M = _cge_load()
    _cge_need(M, "calibrated")
    _cge_u_split(spec, head, expr, opts)
    ov = _cge_u_opts(opts, ("values", "default", "from", "labels"), (3, 3, 4, 3), "cge_parameter")
    values = ov[1]
    dflt = (ov[2] == "" ? 0 : strtoreal(ov[2]))
    if (dflt >= .) _cge_fail("cge_parameter: default() must be a number", 198)
    fromvar = ov[3]
    labvars = ov[4]
    if ((fromvar != "") != (labvars != "")) _cge_fail("cge_parameter: from() and labels() go together", 198)
    // the name, its indexes and a condition on the elements assigned
    if (!regexm(strtrim(head), "^[A-Za-z_][A-Za-z_0-9]*[ ]*([(].*)?([$].*)?$")) {
        _cge_fail("cge_parameter: write NAME, NAME(i) or NAME(i,j), with indexes of model or user sets", 198)
    }
    _cge_u_head(M, head, name, idx, set, cond)
    _cge_setparts(set, s1, s2)
    i1 = i2 = ""
    if (idx != "") {
        c = strpos(idx, ",")
        i1 = (c ? substr(idx, 1, c - 1) : idx)
        i2 = (c ? substr(idx, c + 1, .) : "")
    }
    c = (expr != "") + (values != "") + (fromvar != "")
    if (c != 1) _cge_fail("cge_parameter: give one of = expression, values() and from()", 198)
    if (cond != "" & expr == "") _cge_fail("cge_parameter: a condition goes with an assignment: NAME(i)" + char(36) + "(condition) = expression", 198)
    kk = _cge_up_find(M, name)
    again = (kk > 0)
    if (again) {
        if (expr == "") _cge_fail("cge_parameter: " + name + " is already a user parameter; assign it again with = expression", 110)
        if (M.updef[kk, 2] != s1 | M.updef[kk, 3] != s2) {
            _cge_fail("cge_parameter: " + name + " is defined over other sets; write it with indexes of its own sets", 198)
        }
        if (_cge_up_used(M, name)) _cge_fail("cge_parameter: " + name + " is used by user variables, equations or macros; change it with cge_shock", 459)
    }
    else _cge_u_newname(M, name, "parameter")
    // the elements, in the order they are stored
    _cge_u_els(M, set, e1, e2, o1, o2)
    n = rows(e1)
    v = (again ? M.p0.upval[_cge_up_pos(M, kk)] : J(n, 1, dflt))
    if (expr != "") v = _cge_up_assign(M, name, expr, idx, set, cond, e1, e2, o1, o2, v)
    else if (values != "") {
        if (s1 == "") _cge_fail("cge_parameter: values() is for a parameter with indexes; write NAME = #", 198)
        tok = tokens(values)
        for (j = 1; j <= cols(tok); j++) {
            pair = tokens(tok[j], ":")
            if (cols(pair) != 3) _cge_fail("cge_parameter: values(): write element:value pairs, as com_hlt:0.2" + (s2 != "" ? " or com_hlt.hhd:0.2" : ""), 198)
            el = pair[1]
            if (strtoreal(pair[3]) >= .) _cge_fail("cge_parameter: values(): " + pair[3] + " is not a number", 198)
            if (s2 == "") k = _cge_find(e1, el)
            else {
                ab = tokens(el, ".")
                if (cols(ab) != 3) _cge_fail("cge_parameter: values(): give the two elements as e1.e2:value", 198)
                k = 0
                for (c = 1; c <= n; c++) if (e1[c] == ab[1] & e2[c] == ab[3]) k = c
            }
            if (!k) _cge_fail("cge_parameter: values(): " + el + " is not an element of " + name, 111)
            v[k] = strtoreal(pair[3])
        }
    }
    else {
        if (s1 == "") _cge_fail("cge_parameter: from() needs a parameter with indexes", 198)
        lv = tokens(labvars)
        fv = _cge_unab(fromvar, "cge_parameter: from()")
        if (s2 != "" & cols(lv) == 1) {
            // wide data (from version 0.13.0): rows labelled by the first
            // index, one variable for each element of the second, named as it
            l1 = _cge_setlab(M, s1)
            l2 = _cge_setlab(M, s2)
            d1 = st_sdata(., lv[1])
            for (c = 1; c <= cols(fv); c++) {
                r2 = _cge_find(l2, fv[c])
                if (!r2) _cge_fail("cge_parameter: from(): variable " + fv[c] + " is not named as an element of the set of " + i2, 111)
                X = st_data(., fv[c])
                for (j = 1; j <= rows(X); j++) {
                    if (d1[j] == "" | X[j] >= .) continue
                    r1 = _cge_find(l1, d1[j])
                    if (!r1) _cge_fail("cge_parameter: from(): " + d1[j] + " is not an element of the set of " + i1, 111)
                    v[(r1 - 1) * rows(l2) + r2] = X[j]
                }
            }
        }
        else {
            // long data: one observation per element, the labels in labels()
            if (cols(lv) != _cge_nidx(s1) + _cge_nidx(s2) | cols(fv) != 1) {
                _cge_fail("cge_parameter: from() takes one variable and labels() one string variable per index; for two indexes, " +
                          "from() may instead list one variable for each element of the second index, with labels() giving the first", 198)
            }
            X = st_data(., fv[1])
            d1 = st_sdata(., lv[1])
            d2 = (cols(lv) == 2 ? st_sdata(., lv[2]) : J(rows(d1), 1, ""))
            for (j = 1; j <= rows(X); j++) {
                if (d1[j] == "" | X[j] >= .) continue
                k = 0
                for (c = 1; c <= n; c++) if (e1[c] == d1[j] & e2[c] == d2[j]) k = c
                if (!k) _cge_fail("cge_parameter: from(): " + d1[j] + (d2[j] != "" ? "." + d2[j] : "") + " is not an element of " + name, 111)
                v[k] = X[j]
            }
        }
    }
    if (hasmissing(v)) _cge_fail("cge_parameter: " + name + " has missing values; give default()", 198)
    if (rows(M.p0.upval) * cols(M.p0.upval) == 0) {
        M.p0.upval = J(0, 1, .)
        M.p.upval = J(0, 1, .)
    }
    if (again) {
        // a parameter assigned again: its base and current values; stored
        // simulations keep the values they were solved with
        pos = _cge_up_pos(M, kk)
        old = M.p0.upval
        old[pos] = v
        M.p0.upval = old
        old = M.p.upval
        old[pos] = v
        M.p.upval = old
    }
    else {
        if (cols(M.updef) != 3) M.updef = J(0, 3, "")
        M.updef = M.updef \ (name, s1, s2)
        M.p0.upval = M.p0.upval \ v
        M.p.upval = M.p.upval \ v
        // the stored simulations get the base values; structures in a vector
        // are replaced whole (Stata 13 hangs on changing a member in place)
        if (cols(M.simp)) {
            sp = cge_par(1, cols(M.simp))
            for (j = 1; j <= cols(M.simp); j++) {
                q = M.simp[j]
                if (rows(q.upval) * cols(q.upval) == 0) q.upval = J(0, 1, .)
                q.upval = q.upval \ v
                sp[j] = q
            }
            M.simp = sp
        }
    }
    _cge_store(M)
    printf("{txt}User parameter {res}%s%s{txt}%s: %f value(s)", name, (idx == "" ? "" : "(" + idx + ")"),
           (again ? ", assigned again" : ""), n)
    printf("{txt}, from {res}%g{txt} to {res}%g\n", min(v), max(v))
    st_global("r(name)", name)
    st_numscalar("r(N_elements)", n)
}

// The values of an assignment NAME(i)$(condition) = expression (from version
// 0.13.0): for each element of the set that meets the condition at the base,
// the expression with the indexes written out, evaluated at the base, where
// it may use numbers, parameters and base values of variables (base(X)); the
// other elements keep their values v
real colvector _cge_up_assign(struct cge_model scalar M, string scalar name, string scalar expr, string scalar idx,
                              string scalar set, string scalar cond, string colvector e1, string colvector e2,
                              real colvector o1, real colvector o2, real colvector v)
{
    struct cge_par scalar pb
    string rowvector tk, tl
    string colvector keep
    string scalar g
    real colvector dom, out
    real matrix tok
    real scalar j, r, val
    keep = M.upar
    pb = M.p0
    pb.xlag = J(1, _cge_maxlag(), M.x0)
    pb.xlead = pb.xlag
    out = v
    dom = (idx == "" ? 1 : _cge_u_domain(M, pb, M.x0, idx, set, cond))
    tk = _cge_u_pre(M, _cge_u_tokens(expr))
    for (j = 1; j <= rows(e1); j++) {
        if (!dom[j]) continue
        tl = tk
        if (idx != "") tl = _cge_u_subst2(("(", tl, ")"), idx, e1[j], e2[j], o1[j], o2[j])
        tok = _cge_u_compile(M, _cge_u_written(M, pb, M.x0, tl), M.x0, g)
        for (r = 1; r <= rows(tok); r++) {
            if (anyof((2, 9, 11, 12), tok[r, 1])) {
                _cge_fail("cge_parameter: " + name + ": a parameter's value may use numbers, parameters and the base values of variables, base(X), not the variables themselves", 198)
            }
        }
        val = _cge_u_value(M, pb, M.x0, tok)
        if (val >= .) {
            _cge_fail("cge_parameter: " + name + (e1[j] != "" ? "(" + e1[j] + (e2[j] != "" ? "," + e2[j] : "") + ")" : "") +
                      " is missing: the expression cannot be evaluated there", 459)
        }
        out[j] = val
    }
    M.upar = keep
    return(out)
}

// The variables of varlist vl in memory, abbreviations and ranges written
// out (from version 0.13.0)
string rowvector _cge_unab(string scalar vl, string scalar what)
{
    if (_stata("unab __cge_unab : " + vl, 1)) _cge_fail(what + ": variables " + vl + " not found", 111)
    return(tokens(st_local("__cge_unab")))
}

// 1 if user parameter name is used by a user variable or equation
real scalar _cge_up_used(struct cge_model scalar M, string scalar name)
{
    real scalar k
    for (k = 1; k <= rows(M.uvdef); k++) if (anyof(_cge_u_tokens(M.uvdef[k, 3]), name)) return(1)
    for (k = 1; k <= rows(M.uedef); k++) {
        if (anyof(_cge_u_tokens(M.uedef[k, 4]), name) | anyof(_cge_u_tokens(M.uedef[k, 5]), name)) return(1)
    }
    if (cols(M.uvdef) >= 7) for (k = 1; k <= rows(M.uvdef); k++) if (anyof(_cge_u_tokens(M.uvdef[k, 7]), name)) return(1)
    if (cols(M.uedef) >= 6) for (k = 1; k <= rows(M.uedef); k++) if (anyof(_cge_u_tokens(M.uedef[k, 6]), name)) return(1)
    // macros (from version 0.9.7)
    if (rows(M.umac) & cols(M.umac) >= 3) for (k = 1; k <= rows(M.umac); k++) if (anyof(_cge_u_tokens(M.umac[k, 3]), name)) return(1)
    return(0)
}

void _cge_up_list()
{
    struct cge_model scalar M
    string colvector e1, e2
    real colvector pos
    real scalar k
    M = _cge_load()
    st_numscalar("r(N_parameters)", rows(M.updef))
    if (!rows(M.updef)) {
        printf("{txt}No user parameters\n")
        return
    }
    for (k = 1; k <= rows(M.updef); k++) {
        pos = _cge_up_pos(M, k)
        _cge_up_labels(M, k, e1, e2)
        printf("{txt}parameter {res}%s{txt}%s: %f value(s), current from {res}%g{txt} to {res}%g{txt} (base from %g to %g)\n",
               M.updef[k, 1], (M.updef[k, 2] == "" ? "" : "(" + _cge_u_setname(M.updef[k, 2]) +
               (M.updef[k, 3] == "" ? "" : "," + _cge_u_setname(M.updef[k, 3])) + ")"), rows(pos),
               min(M.p.upval[pos]), max(M.p.upval[pos]), min(M.p0.upval[pos]), max(M.p0.upval[pos]))
    }
}

// The name of a set code for display: the index letter or the user set's name
string scalar _cge_u_setname(string scalar code)
{
    if (substr(code, 1, 1) == "~") return(substr(code, 2, .))
    return(strlower(code))
}

// Removes every user parameter; parameters that user equations use must be
// removed with them first
void _cge_up_clear()
{
    struct cge_model scalar M
    struct cge_par scalar q
    struct cge_par rowvector sp
    real scalar k
    M = _cge_load()
    for (k = 1; k <= rows(M.updef); k++) {
        if (_cge_up_used(M, M.updef[k, 1])) _cge_fail("parameter " + M.updef[k, 1] + " is used by user variables or equations: remove them first with cge_equation, clear", 459)
    }
    M.updef = J(0, 3, "")
    M.p0.upval = J(0, 1, .)
    M.p.upval = J(0, 1, .)
    if (cols(M.simp)) {
        sp = cge_par(1, cols(M.simp))
        for (k = 1; k <= cols(M.simp); k++) {
            q = M.simp[k]
            q.upval = J(0, 1, .)
            sp[k] = q
        }
        M.simp = sp
    }
    _cge_store(M)
    printf("{txt}User parameters removed\n")
}

// Positions in p.upval of the elements of user parameter k given in elems:
// labels of the first index (every element of the second), e1.e2 pairs, or
// all of them
real colvector _cge_up_elements(struct cge_model scalar M, real scalar k, string scalar elems)
{
    string colvector e1, e2
    string rowvector t, ab
    real colvector pos, out
    real scalar i, j, hit
    pos = _cge_up_pos(M, k)
    t = tokens(elems)
    if (!cols(t) | elems == "all") return(pos)
    if (M.updef[k, 2] == "") _cge_fail(M.updef[k, 1] + " has no elements", 198)
    _cge_up_labels(M, k, e1, e2)
    out = J(0, 1, .)
    for (i = 1; i <= cols(t); i++) {
        hit = 0
        if (strpos(t[i], ".")) {
            ab = tokens(t[i], ".")
            if (cols(ab) != 3) _cge_fail(t[i] + ": give two elements as e1.e2", 198)
            for (j = 1; j <= rows(pos); j++) if (e1[j] == ab[1] & e2[j] == ab[3]) {
                out = out \ pos[j]
                hit = 1
            }
        }
        else {
            for (j = 1; j <= rows(pos); j++) if (e1[j] == t[i]) {
                out = out \ pos[j]
                hit = 1
            }
        }
        if (!hit) _cge_fail(t[i] + " is not an element of " + M.updef[k, 1], 111)
    }
    return(out)
}

// The user parameters as rows of the dataset of cge_parameters
void _cge_up_data(struct cge_model scalar M, struct cge_par scalar p, string matrix keys, real colvector val)
{
    string colvector e1, e2
    real colvector pos
    real scalar k
    for (k = 1; k <= rows(M.updef); k++) {
        pos = _cge_up_pos(M, k)
        if (max(pos) > rows(p.upval)) continue
        _cge_up_labels(M, k, e1, e2)
        keys = keys \ (J(rows(pos), 1, M.updef[k, 1]), e1, e2)
        val = val \ p.upval[pos]
    }
}

// The tokens of an expression: numbers, names, operators and parentheses
string rowvector _cge_u_tokens(string scalar s)
{
    string rowvector out
    string scalar ch, rest
    real scalar i, n
    out = J(1, 0, "")
    i = 1
    n = strlen(s)
    while (i <= n) {
        ch = substr(s, i, 1)
        if (ch == " " | ch == char(9)) {
            i++
            continue
        }
        // two-character operators of conditions (from version 0.7.2)
        if (anyof((">=", "<=", "==", "!=", "<>"), substr(s, i, 2))) {
            out = out, (substr(s, i, 2) == "<>" ? "!=" : substr(s, i, 2))
            i = i + 2
            continue
        }
        if (strpos("+-*/^(),=<>&|!$", ch)) {
            out = out, ch
            i++
            continue
        }
        rest = substr(s, i, .)
        if (regexm(rest, "^([0-9]*[.]?[0-9]+([eE][-+]?[0-9]+)?)")) {
            out = out, regexs(1)
            i = i + strlen(regexs(1))
            continue
        }
        if (regexm(rest, "^([A-Za-z_][A-Za-z_0-9]*)")) {
            out = out, regexs(1)
            i = i + strlen(regexs(1))
            continue
        }
        _cge_fail("cannot read the expression from: " + substr(rest, 1, 30), 198)
    }
    return(out)
}


// Position of the parenthesis that closes the one at k
real scalar _cge_u_close(string rowvector t, real scalar k)
{
    real scalar d, j
    d = 0
    for (j = k; j <= cols(t); j++) {
        if (t[j] == "(") d++
        else if (t[j] == ")") {
            d--
            if (!d) return(j)
        }
    }
    _cge_fail("a parenthesis is not closed in the expression", 198)
}

// Tokens with index idx replaced by element el where it is an argument of a
// reference, between "(" or "," and ")" or ","; with ordv, ord(idx) becomes
// ordv, the position of el in the set (from version 0.7.2)
string rowvector _cge_u_subst(string rowvector t, string scalar idx, string scalar el, | real scalar ordv)
{
    string rowvector out
    real scalar k
    // a copy: Mata passes arguments by reference
    out = t
    for (k = 2; k < cols(t); k++) {
        if (t[k] == idx & (t[k - 1] == "(" | t[k - 1] == ",") & (t[k + 1] == ")" | t[k + 1] == ",")) {
            out[k] = el
            if (args() > 3 & k > 2) {
                if (t[k - 2] == "ord" & t[k - 1] == "(" & t[k + 1] == ")") {
                    out[k - 2] = ""
                    out[k - 1] = ""
                    out[k] = strofreal(ordv)
                    out[k + 1] = ""
                }
            }
        }
    }
    return(select(out, out :!= ""))
}

// Sums written out: sum(i, body) becomes (body_1 + body_2 + ...) over the
// elements of the set of i; sums within sums are written out first. With a
// condition, sum(i$cond, body), only the elements for which cond holds at
// the base (p, x0) are written out (from version 0.7.2).
string rowvector _cge_u_expand(struct cge_model scalar M, struct cge_par scalar p, real colvector x0,
                               string rowvector t)
{
    string rowvector out, body, els, cond, terms, piece
    string scalar idx, fn
    real scalar k, e, j, c, d, n, m, inner
    out = J(1, 0, "")
    k = 1
    while (k <= cols(t)) {
        // sum(), and from version 0.9.7 prod(), smax() and smin(): the terms
        // joined by +, by *, or as the arguments of max() or min()
        if (anyof(("sum", "prod", "smax", "smin", "smax#", "smin#"), t[k]) & k < cols(t)) {
            if (t[k + 1] == "(") {
                // smax# and smin#: the inner maximum or minimum of one over
                // two indexes, empty for an element of the outer index that
                // has no pair
                inner = (t[k] == "smax#" | t[k] == "smin#")
                fn = subinstr(t[k], "#", "")
                e = _cge_u_close(t, k + 1)
                if (e < k + 5 | (t[k + 3] != "," & t[k + 3] != "$")) _cge_fail(fn + "(): write " + fn + "(i, expression), with i the index of a set", 198)
                idx = t[k + 2]
                // an index the domain controls is written out before the sum
                // (from version 0.13.0, a message of its own: GAMS's "set
                // already under control")
                if (_cge_u_islabel(M, idx) & !_cge_u_isindex(M, idx)) {
                    _cge_fail(fn + "(): the index of the " + fn + " is an index of the domain too, written out here as " + idx +
                              "; sum over another index of the same set, such as the index with a digit (f2 for f)", 198)
                }
                els = _cge_setlab(M, _cge_u_set(M, idx))'
                cond = J(1, 0, "")
                c = k + 3
                if (t[k + 3] == "$") {
                    // the condition runs to the comma that ends the domain
                    d = 0
                    for (c = k + 4; c < e; c++) {
                        if (t[c] == "(") d++
                        else if (t[c] == ")") d--
                        else if (t[c] == "," & d == 0) break
                    }
                    if (c >= e | c == k + 4) _cge_fail(fn + "(): write " + fn + "(i" + char(36) + "(condition), expression)", 198)
                    cond = t[|k + 4 \ c - 1|]
                }
                if (c + 1 > e - 1) _cge_fail(fn + "(): write " + fn + "(i, expression), with i the index of a set", 198)
                body = t[|c + 1 \ e - 1|]
                terms = J(1, 0, "")
                n = 0
                for (j = 1; j <= cols(els); j++) {
                    if (cols(cond)) {
                        if (!_cge_u_condval(M, p, x0, _cge_u_subst(("(", cond, ")"), idx, els[j], j))) continue
                    }
                    // the element first, then the sums within: their
                    // conditions may use this index
                    piece = _cge_u_expand(M, p, x0, _cge_u_subst(body, idx, els[j], j))
                    if (piece == "#empty") continue
                    if (n) terms = terms, (fn == "sum" ? "+" : (fn == "prod" ? "*" : ","))
                    terms = terms, "(", piece, ")"
                    n++
                }
                if (!n & inner) {
                    out = out, "#empty"
                    k = e + 1
                    continue
                }
                if (!n) {
                    if (fn == "smax" | fn == "smin") _cge_fail(fn + "(): no element of the set meets the condition", 459)
                    terms = (fn == "prod" ? "1" : "0")
                }
                // one term is the term itself: GAMS's max() needs two
                if ((fn == "smax" | fn == "smin") & n > 1) out = out, (fn == "smax" ? "max" : "min"), "(", terms, ")"
                else out = out, "(", terms, ")"
                k = e + 1
                continue
            }
        }
        out = out, t[k]
        k++
    }
    return(out)
}

// An expression written out: sums, then conditional terms, every index
// replaced by an element (from version 0.7.2)
string rowvector _cge_u_written(struct cge_model scalar M, struct cge_par scalar p, real colvector x0,
                                string rowvector t)
{
    return(_cge_u_done(M, _cge_u_rdollar(M, p, x0, _cge_u_expand(M, p, x0, _cge_u_sumpairs(M, _cge_u_pre(M, t))))))
}

// Conditional terms written out: expr$cond is expr where cond holds at the
// base and 0 elsewhere (from version 0.7.2). expr is a number, a name, a
// reference such as PQ(com_agr), a function or a parenthesised expression;
// cond a parenthesised condition, a name or a reference.
string rowvector _cge_u_rdollar(struct cge_model scalar M, struct cge_par scalar p, real colvector x0,
                                string rowvector t)
{
    string rowvector out, left, cond
    real scalar k, a, b, d, j
    out = t
    while (1) {
        k = 0
        for (j = 1; j <= cols(out); j++) {
            if (out[j] == "$") {
                k = j
                break
            }
        }
        if (!k) break
        if (k == 1 | k == cols(out)) _cge_fail("$: write expression$(condition)", 198)
        // the operand on the left
        a = k - 1
        if (out[a] == ")") {
            d = 0
            for (; a >= 1; a--) {
                if (out[a] == ")") d++
                else if (out[a] == "(") {
                    d--
                    if (!d) break
                }
            }
            if (a < 1) _cge_fail("$: a parenthesis is not opened", 198)
            if (a > 1) {
                if (regexm(out[a - 1], "^[A-Za-z_][A-Za-z_0-9]*$")) a--
            }
        }
        else if (!regexm(out[a], "^[A-Za-z_0-9.]+$")) _cge_fail("$: write expression$(condition)", 198)
        // the condition on the right
        b = k + 1
        if (out[b] == "(") b = _cge_u_close(out, b)
        else if (regexm(out[b], "^[A-Za-z_][A-Za-z_0-9]*$")) {
            if (b < cols(out)) {
                if (out[b + 1] == "(") b = _cge_u_close(out, b + 1)
            }
        }
        else _cge_fail("$: write expression$(condition)", 198)
        left = out[|a \ k - 1|]
        cond = out[|k + 1 \ b|]
        out = (a > 1 ? out[|1 \ a - 1|] : J(1, 0, "")), (_cge_u_condval(M, p, x0, cond) ? ("(", left, ")") : "0"),
              (b < cols(out) ? out[|b + 1 \ cols(out)|] : J(1, 0, ""))
    }
    return(out)
}

// The value of condition t (tokens with the indexes written out) at the base:
// 1 when it holds, else 0. Conditions use comparisons, & | !, set membership
// (goods(com_agr)), parameters and variables at the base (from version 0.7.2).
real scalar _cge_u_condval(struct cge_model scalar M, struct cge_par scalar p, real colvector x0, string rowvector t)
{
    real matrix tok
    real scalar v
    string scalar g
    tok = _cge_u_compile(M, _cge_u_written(M, p, x0, t), x0, g, 1)
    // the period changes from period to period (from version 0.10.2)
    if (any(tok[., 1] :== 12)) {
        _cge_fail("tperiod, tfirst and tlast change by period, but a condition ($) holds in every period; write ifthen(tlast, a, b)", 198)
    }
    v = _cge_u_value(M, p, x0, tok)
    if (v >= .) _cge_fail("a condition is missing at the base: " + invtokens(t, " "), 459)
    return(v != 0)
}

// The elements of the set of index idx for which condition cond holds at the
// base, as a 0/1 column (all of them without a condition)
real colvector _cge_u_domain(struct cge_model scalar M, struct cge_par scalar p, real colvector x0,
                             string scalar idx, string scalar set, string scalar cond)
{
    string colvector e1, e2
    real colvector m, o1, o2
    real scalar j
    string rowvector tc
    _cge_u_els(M, set, e1, e2, o1, o2)
    m = J(rows(e1), 1, 1)
    if (cond == "") return(m)
    tc = _cge_u_pre(M, _cge_u_tokens(cond))
    for (j = 1; j <= rows(e1); j++) m[j] = _cge_u_condval(M, p, x0, _cge_u_subst2(("(", tc, ")"), idx, e1[j], e2[j], o1[j], o2[j]))
    return(m)
}

// The elements of set code set, as pairs e1, e2 (e2 empty with one index),
// with their positions o1, o2 in each set; one empty element without a set
// (from version 0.9.1)
void _cge_u_els(struct cge_model scalar M, string scalar set, string colvector e1, string colvector e2,
                real colvector o1, real colvector o2)
{
    string scalar s1, s2
    string colvector l1, l2
    real scalar n1, n2, i, j
    if (set == "") {
        e1 = ""
        e2 = ""
        o1 = 1
        o2 = 1
        return
    }
    _cge_setparts(set, s1, s2)
    l1 = _cge_setlab(M, s1)
    n1 = rows(l1)
    if (s2 == "") {
        e1 = l1
        e2 = J(n1, 1, "")
        o1 = (1::n1)
        o2 = J(n1, 1, 1)
        return
    }
    l2 = _cge_setlab(M, s2)
    n2 = rows(l2)
    e1 = J(n1 * n2, 1, "")
    e2 = e1
    o1 = J(n1 * n2, 1, .)
    o2 = o1
    for (i = 1; i <= n1; i++) {
        for (j = 1; j <= n2; j++) {
            e1[(i - 1) * n2 + j] = l1[i]
            e2[(i - 1) * n2 + j] = l2[j]
            o1[(i - 1) * n2 + j] = i
            o2[(i - 1) * n2 + j] = j
        }
    }
}

// Tokens with the indexes idx ("i" or "i,j") replaced by the elements e1 and
// e2, at positions o1 and o2 for ord() (from version 0.9.1)
string rowvector _cge_u_subst2(string rowvector t, string scalar idx, string scalar e1, string scalar e2,
                               real scalar o1, real scalar o2)
{
    real scalar k
    k = strpos(idx, ",")
    if (!k) return(_cge_u_subst(t, idx, e1, o1))
    return(_cge_u_subst(_cge_u_subst(t, substr(idx, 1, k - 1), e1, o1), substr(idx, k + 1, .), e2, o2))
}

// 1 if user set k is a set of pairs (from version 0.9.1)
real scalar _cge_us_pairs(struct cge_model scalar M, real scalar k)
{
    if (cols(M.usdef) < 3) return(0)
    return(M.usdef[k, 3] != "")
}

// Sums over two indexes and over a set of pairs, written as sums over one
// index (from version 0.9.1): sum((i,j)$(cond), e) is sum(i, sum(j$(cond),
// e)), and sum(map(i,j)$(cond), e) is sum(i, sum(j$(map(i,j) & (cond)), e))
string rowvector _cge_u_sumpairs(struct cge_model scalar M, string rowvector t)
{
    string rowvector out, cond, body, rest
    string scalar i, j
    real scalar k, e, c, d, pair, dom
    out = J(1, 0, "")
    k = 1
    while (k <= cols(t)) {
        pair = 0
        if (anyof(("sum", "prod", "smax", "smin"), t[k]) & k + 8 <= cols(t)) {
            if (t[k + 1] == "(" & t[k + 2] == "(" & t[k + 4] == "," & t[k + 6] == ")") {
                pair = 1
                i = t[k + 3]
                j = t[k + 5]
                dom = k + 7
            }
            else if (t[k + 1] == "(" & t[k + 3] == "(" & t[k + 5] == "," & t[k + 7] == ")" & _cge_us_find(M, t[k + 2])) {
                if (_cge_us_pairs(M, _cge_us_find(M, t[k + 2]))) {
                    pair = 2
                    i = t[k + 4]
                    j = t[k + 6]
                    dom = k + 8
                }
            }
        }
        if (!pair) {
            out = out, t[k]
            k++
            continue
        }
        e = _cge_u_close(t, k + 1)
        // a condition, to the comma that ends the domain
        cond = J(1, 0, "")
        c = dom
        if (t[dom] == char(36)) {
            d = 0
            for (c = dom + 1; c < e; c++) {
                if (t[c] == "(") d++
                else if (t[c] == ")") d--
                else if (t[c] == "," & d == 0) break
            }
            cond = t[|dom + 1 \ c - 1|]
        }
        if (t[c] != "," | c + 1 > e - 1) _cge_fail("sum(): write sum((i,j), expression) or sum(set(i,j), expression)", 198)
        body = _cge_u_sumpairs(M, t[|c + 1 \ e - 1|])
        if (pair == 2) {
            cond = (cols(cond) ? (t[k + 2], "(", i, ",", j, ")", "&", "(", cond, ")") : (t[k + 2], "(", i, ",", j, ")"))
        }
        out = out, t[k], "(", i, ",", t[k] + ((t[k] == "smax" | t[k] == "smin") ? "#" : ""), "(", j
        if (cols(cond)) out = out, char(36), "(", cond, ")"
        out = out, ",", body, ")", ")"
        k = e + 1
    }
    return(out)
}

// The definitions of user variables and equations with their columns for
// conditions (from version 0.7.2): files saved before have one column fewer
void _cge_u_widen(struct cge_model scalar M)
{
    if (rows(M.uvdef) == 0 & cols(M.uvdef) != 9) M.uvdef = J(0, 9, "")
    if (rows(M.uedef) == 0 & cols(M.uedef) != 8) M.uedef = J(0, 8, "")
    if (cols(M.uvdef) == 6) M.uvdef = M.uvdef, J(rows(M.uvdef), 1, "")
    if (cols(M.uedef) == 5) M.uedef = M.uedef, J(rows(M.uedef), 1, "")
    // bounds of user variables, and the relation and paired variable of user
    // equations (from version 0.9.0)
    if (cols(M.uvdef) == 7) M.uvdef = M.uvdef, J(rows(M.uvdef), 2, "")
    if (cols(M.uedef) == 6) M.uedef = M.uedef, J(rows(M.uedef), 1, "="), J(rows(M.uedef), 1, "")
}

// Tokens written out: an index left over was not the index of a sum or of
// the equation
string rowvector _cge_u_done(struct cge_model scalar M, string rowvector out)
{
    real scalar m
    for (m = 2; m < cols(out); m++) {
        if (_cge_u_isindex(M, out[m]) & (out[m - 1] == "(" | out[m - 1] == ",") & (out[m + 1] == ")" | out[m + 1] == ",")) {
            if (!_cge_u_islabel(M, out[m])) _cge_fail("index " + out[m] + " is not the index of a sum or of the equation", 198)
        }
    }
    return(out)
}

// 1 if s is the label of an element of a set
real scalar _cge_u_islabel(struct cge_model scalar M, string scalar s)
{
    return(anyof(_cge_alllabels(M), s))
}

// Index of user variable or model variable name, 0 if none
real scalar _cge_u_var(struct cge_model scalar M, string scalar name)
{
    return(_cge_vidx(M, name))
}

// Position of reference name(args) in the stacked vector of variables, or 0
real scalar _cge_u_varpos(struct cge_model scalar M, string scalar name, string rowvector args)
{
    string colvector e1, e2
    real colvector pos
    real scalar k, i
    k = _cge_vidx(M, name)
    if (!k) return(0)
    _cge_vlabels(M, k, e1, e2)
    pos = _cge_vpos(M, k)
    if (cols(args) != _cge_nidx(M.vset[k])) {
        _cge_fail("variable " + name + " has " + strofreal(_cge_nidx(M.vset[k])) + " index(es); " + strofreal(cols(args)) + " given", 198)
    }
    for (i = 1; i <= rows(pos); i++) {
        if (cols(args) == 0) return(pos[i])
        if (e1[i] == args[1] & (cols(args) == 1 | e2[i] == args[cols(args)])) return(pos[i])
    }
    _cge_fail(name + "(" + invtokens(args, ", ") + ") is not an element of " + name, 111)
}

// Compiles one side of a scalar equation (tokens written out) to postfix
// rows (type, value, element): 1 number, 2 variable at a position, 3
// parameter (index in M.upar, element), 4 operator (1 + 2 - 3 * 4 / 5 ^), 5
// negation, 6 function (1 exp, 2 ln, 3 sqrt); and writes the GAMS text
real matrix _cge_u_compile(struct cge_model scalar M, string rowvector t, real colvector x0, string scalar gams,
                           | real scalar condmode)
{
    string matrix P
    string rowvector ops, args, gtok
    string colvector lab
    string scalar tk, nm, g
    real matrix out, opst
    real scalar k, e, prev, pos, pi, el, j, pr, code, n, lk, na, pv
    real colvector a1, a2
    real matrix sub
    string rowvector gp
    if (args() < 5) condmode = 0
    P = _cge_gams_params()
    out = J(0, 3, .)
    // operator stack: (kind, code); kind 1 operator, 2 function, 3 "(", 4
    // negation, 6 logical not (conditions)
    opst = J(0, 2, .)
    gtok = J(1, 0, "")
    prev = 0                   // 0 start or after an operator, 1 after an operand
    k = 1
    while (k <= cols(t)) {
        tk = t[k]
        if (regexm(tk, "^[0-9.]")) {
            if (prev) _cge_fail("two operands in a row at " + tk, 198)
            out = out \ (1, strtoreal(tk), .)
            gtok = gtok, tk
            prev = 1
            k++
            continue
        }
        if (regexm(tk, "^[A-Za-z_]")) {
            if (prev) _cge_fail("two operands in a row at " + tk, 198)
            nm = tk
            args = J(1, 0, "")
            e = k
            // in a condition (from version 0.7.2), sameas(e1, e2) and set
            // membership, goods(com_agr): 1 or 0
            if (nm == "sameas") {
                if (!condmode) _cge_fail("sameas() is allowed only in conditions ($)", 198)
                if (k + 5 > cols(t)) _cge_fail("sameas(): write sameas(i, label)", 198)
                if (t[k + 1] != "(" | t[k + 3] != "," | t[k + 5] != ")") _cge_fail("sameas(): write sameas(i, label)", 198)
                for (j = 2; j <= 4; j = j + 2) {
                    if (!anyof(_cge_alllabels(M), t[k + j])) {
                        if (_cge_u_isindex(M, t[k + j])) _cge_fail("sameas(): index " + t[k + j] + " is not the index of a sum or of the domain", 198)
                        _cge_fail("sameas(): " + t[k + j] + " is not the label of an element of the model", 111)
                    }
                }
                out = out \ (1, t[k + 2] == t[k + 4], .)
                gtok = gtok, strofreal(t[k + 2] == t[k + 4])
                prev = 1
                k = k + 6
                continue
            }
            if (nm == "ord") _cge_fail("ord(): write ord(i), with i the index of a sum or of the domain", 198)
            // membership of a pair in a set of pairs (from version 0.9.1)
            if (condmode & k + 5 <= cols(t) & _cge_us_find(M, nm)) {
                if (_cge_us_pairs(M, _cge_us_find(M, nm)) & t[k + 1] == "(" & t[k + 3] == "," & t[k + 5] == ")") {
                    out = out \ (1, anyof(_cge_us_labels(M, _cge_us_find(M, nm)), t[k + 2] + "." + t[k + 4]), .)
                    gtok = gtok, strofreal(out[rows(out), 2])
                    prev = 1
                    k = k + 6
                    continue
                }
            }
            if (condmode & k + 3 <= cols(t)) {
                if (t[k + 1] == "(" & t[k + 3] == ")" & !_cge_vidx(M, nm) & !_cge_up_find(M, nm) & _cge_u_isindex(M, nm)) {
                    lab = _cge_setlab(M, _cge_u_set(M, nm))
                    if (!anyof(_cge_alllabels(M), t[k + 2])) {
                        if (_cge_u_isindex(M, t[k + 2])) _cge_fail(nm + "(" + t[k + 2] + "): index " + t[k + 2] + " is not the index of a sum or of the domain", 198)
                        _cge_fail(nm + "(" + t[k + 2] + "): " + t[k + 2] + " is not the label of an element of the model", 111)
                    }
                    out = out \ (1, anyof(lab, t[k + 2]), .)
                    gtok = gtok, strofreal(out[rows(out), 2])
                    prev = 1
                    k = k + 4
                    continue
                }
            }
            if (k < cols(t)) {
                if (t[k + 1] == "(") {
                    // min(), max(), abs(), sqr(), log10() and ifthen() (from
                    // version 0.9.7): each argument compiled, then the
                    // function of their values
                    if (anyof(("min", "max", "abs", "sqr", "log10", "ifthen"), nm)) {
                        e = _cge_u_close(t, k + 1)
                        _cge_u_args(t, k + 1, e, a1, a2)
                        na = rows(a1)
                        code = _cge_find(("min", "max", "abs", "sqr", "log10", "ifthen")', nm)
                        if (code <= 2 & na < 1) _cge_fail(nm + "(): give one argument or more", 198)
                        if (code >= 3 & code <= 5 & na != 1) _cge_fail(nm + "(): give one argument", 198)
                        if (code == 6 & na != 3) _cge_fail("ifthen(): write ifthen(condition, value if true, value if false)", 198)
                        gp = J(1, 0, "")
                        for (j = 1; j <= na; j++) {
                            sub = _cge_u_compile(M, t[|a1[j] \ a2[j]|], x0, g, (code == 6 & j == 1 ? 1 : condmode))
                            // a condition of parameters, which the GAMS models
                            // of type CNS and MCP accept
                            if (code == 6 & j == 1) {
                                if (any(sub[., 1] :== 2)) _cge_fail("ifthen(): the condition may use parameters, lags and numbers, not variables; use an inequality for a switch on variables", 198)
                            }
                            out = out \ sub
                            gp = gp, g
                        }
                        out = out \ (10, code, na)
                        gtok = gtok, nm + "(" + invtokens(gp, ", ") + ")"
                        prev = 1
                        k = e + 1
                        continue
                    }
                    // a function: its argument follows as an expression
                    if (anyof(("exp", "ln", "log", "sqrt"), nm)) {
                        code = (nm == "exp" ? 1 : (nm == "sqrt" ? 3 : 2))
                        opst = opst \ (2, code) \ (3, 0)
                        gtok = gtok, (nm == "exp" ? "exp" : (nm == "sqrt" ? "sqrt" : "log")), "("
                        k = k + 2
                        prev = 0
                        continue
                    }
                    e = _cge_u_close(t, k + 1)
                    // lag(reference[, k]): the value k periods before, given
                    // within a period (from version 0.9.2); lead(reference[,
                    // k]): the value k periods after (from version 0.10.2)
                    if (nm == "lag" | nm == "lead") {
                        _cge_u_lag(M, (e > k + 2 ? t[|k + 2 \ e - 1|] : J(1, 0, "")), pos, lk, g, nm)
                        out = out \ ((nm == "lag" ? 9 : 11), pos, lk)
                        gtok = gtok, g
                        prev = 1
                        k = e + 1
                        continue
                    }
                    if (nm == "base") {
                        // base(reference): the base value, a number; of a
                        // variable, or from version 0.11.0 of a parameter
                        if (e < k + 3) _cge_fail("base(): give a variable or a parameter, as base(GSAV) or base(ad(act_agr))", 198)
                        nm = t[k + 2]
                        args = (e > k + 3 ? t[|k + 4 \ e - 2|] : J(1, 0, ""))
                        if (e > k + 3 & (t[k + 3] != "(" | t[e - 1] != ")")) _cge_fail("base(): give a variable or a parameter, as base(GSAV) or base(ad(act_agr))", 198)
                        args = select(args, args :!= ",")
                        pos = _cge_u_varpos(M, nm, args)
                        if (!pos) {
                            pv = _cge_u_parbase(M, nm, args)
                            out = out \ (1, pv, .)
                            gtok = gtok, "(" + _cge_gnum(pv) + ")"
                            prev = 1
                            k = e + 1
                            continue
                        }
                        out = out \ (1, x0[pos], .)
                        gtok = gtok, "(" + _cge_gnum(x0[pos]) + ")"
                        prev = 1
                        k = e + 1
                        continue
                    }
                    args = (e > k + 2 ? t[|k + 2 \ e - 1|] : J(1, 0, ""))
                    for (j = 1; j <= cols(args); j++) {
                        if (mod(j, 2) == 0 & args[j] != ",") _cge_fail("the elements of " + nm + " must be labels separated by commas", 198)
                        if (mod(j, 2) == 1 & !regexm(args[j], "^[A-Za-z_0-9]")) _cge_fail("the elements of " + nm + " must be labels separated by commas", 198)
                    }
                    args = select(args, args :!= ",")
                }
            }
            // the period (from version 0.10.2): its number, and 1 in the first
            // and the last period of a dynamic run
            if (anyof(("tperiod", "tfirst", "tlast"), nm) & !cols(args)) {
                out = out \ (12, _cge_find(("tperiod", "tfirst", "tlast")', nm), .)
                gtok = gtok, strupper(nm)
                prev = 1
                k = e + 1
                continue
            }
            pos = _cge_u_varpos(M, nm, args)
            // a user parameter (from version 0.7.1): its value in p.upval
            if (!pos & _cge_up_find(M, nm)) {
                pi = _cge_up_find(M, nm)
                if (cols(args) != _cge_nidx(M.updef[pi, 2]) + _cge_nidx(M.updef[pi, 3])) {
                    _cge_fail("parameter " + nm + " has " + strofreal(_cge_nidx(M.updef[pi, 2]) + _cge_nidx(M.updef[pi, 3])) +
                              " index(es); " + strofreal(cols(args)) + " given", 198)
                }
                el = 1
                if (cols(args)) {
                    lab = _cge_setlab(M, M.updef[pi, 2])
                    el = _cge_find(lab, args[1])
                    if (!el) _cge_fail(args[1] + " is not an element of parameter " + nm, 111)
                    if (cols(args) == 2) {
                        lab = _cge_setlab(M, M.updef[pi, 3])
                        j = _cge_find(lab, args[2])
                        if (!j) _cge_fail(args[2] + " is not an element of parameter " + nm, 111)
                        el = (el - 1) * rows(lab) + j
                    }
                }
                out = out \ (7, _cge_up_pos(M, pi)[el], .)
                gtok = gtok, "UP_" + nm + (cols(args) ? "('" + invtokens(args, "', '") + "')" : "")
                prev = 1
                k = e + 1
                continue
            }
            if (pos) {
                out = out \ (2, pos, .)
                g = _cge_u_gname(M, _cge_vidx(M, nm))
                gtok = gtok, g + (cols(args) ? "('" + invtokens(args, "', '") + "')" : "")
            }
            else {
                // the tax on factor use by factor and activity (from version
                // 0.11.0), tf(f, a)
                if (nm == "tf" & !_cge_sa(M)) {
                    if (cols(args) != 2) _cge_fail("parameter tf needs a factor and an activity, as tf(lab, act_agr)", 198)
                    el = _cge_find(M.F, args[1])
                    j = _cge_find(M.A, args[2])
                    if (!el | !j) _cge_fail("tf(" + args[1] + ", " + args[2] + "): give a factor and an activity", 111)
                    if (!_cge_find(M.upar, nm)) M.upar = M.upar \ nm
                    out = out \ (3, _cge_find(M.upar, nm), (el - 1) * rows(M.A) + j)
                    gtok = gtok, "tf('" + args[1] + "', '" + args[2] + "')"
                    prev = 1
                    k = e + 1
                    continue
                }
                // a standalone model has no model parameters (from version 0.13.0)
                pi = (_cge_sa(M) ? 0 : _cge_find(P[., 1], nm))
                if (!pi & condmode & _cge_u_isindex(M, nm)) {
                    _cge_fail("index " + nm + " in a condition: compare elements with sameas(" + nm + ", label) or positions with ord(" + nm + ")", 198)
                }
                if (!pi & _cge_sa(M)) _cge_fail(nm + " is not a variable or a user parameter of the model", 111)
                if (!pi) _cge_fail(nm + " is not a model variable, a user variable, a user parameter or a parameter that cge_shock changes", 111)
                if (P[pi, 3] == "") {
                    if (cols(args)) _cge_fail("parameter " + nm + " has no elements", 198)
                    el = 1
                }
                else {
                    if (cols(args) != 1) _cge_fail("parameter " + nm + " needs one element", 198)
                    lab = _cge_gams_setlabels(M, P[pi, 3])
                    el = _cge_find(lab, args[1])
                    if (!el) _cge_fail(args[1] + " is not an element of parameter " + nm, 111)
                }
                if (!_cge_find(M.upar, nm)) M.upar = M.upar \ nm
                out = out \ (3, _cge_find(M.upar, nm), el)
                gtok = gtok, P[pi, 2] + (cols(args) ? "('" + args[1] + "')" : "")
            }
            prev = 1
            k = e + 1
            continue
        }
        if (tk == "(") {
            if (prev) _cge_fail("an operator is missing before (", 198)
            opst = opst \ (3, 0)
            gtok = gtok, "("
            k++
            continue
        }
        if (tk == ")") {
            if (!prev) _cge_fail("an operand is missing before )", 198)
            while (rows(opst)) {
                if (opst[rows(opst), 1] == 3) break
                out = out \ _cge_u_pop(opst)
            }
            if (!rows(opst)) _cge_fail("a parenthesis is closed but not opened", 198)
            opst = (rows(opst) > 1 ? opst[|1, 1 \ rows(opst) - 1, 2|] : J(0, 2, .))
            // a function whose argument this closes
            if (rows(opst)) {
                if (opst[rows(opst), 1] == 2) out = out \ _cge_u_pop(opst)
            }
            gtok = gtok, ")"
            prev = 1
            k++
            continue
        }
        // logical not, in conditions (from version 0.7.2)
        if (tk == "!") {
            if (!condmode) _cge_fail("! and comparisons are allowed only in conditions ($)", 198)
            if (prev) _cge_fail("! must come before an operand", 198)
            opst = opst \ (6, 0)
            gtok = gtok, "not"
            k++
            continue
        }
        if (anyof((">", "<", ">=", "<=", "==", "!=", "&", "|"), tk)) {
            if (!condmode) _cge_fail("comparisons and & | are allowed only in conditions ($)", 198)
            if (!prev) _cge_fail("an operand is missing before " + tk, 198)
            code = 5 + _cge_find((">", "<", ">=", "<=", "==", "!=", "&", "|")', tk)
            pr = _cge_u_prec(code)
            while (rows(opst)) {
                if (opst[rows(opst), 1] == 3) break
                if (opst[rows(opst), 1] == 1) {
                    if (!(_cge_u_prec(opst[rows(opst), 2]) >= pr)) break
                }
                else if (opst[rows(opst), 1] == 6) {
                    if (pr > 0.5) break
                }
                out = out \ _cge_u_pop(opst)
            }
            opst = opst \ (1, code)
            // as GAMS writes them (from version 0.9.7, for ifthen())
            gtok = gtok, (tk == "==" ? "eq" : (tk == "!=" ? "ne" : (tk == "&" ? "and" : (tk == "|" ? "or" : tk))))
            prev = 0
            k++
            continue
        }
        if (strpos("+-*/^", tk)) {
            if (!prev) {
                if (tk == "-") {
                    opst = opst \ (4, 0)
                    gtok = gtok, "-"
                    k++
                    continue
                }
                if (tk == "+") {
                    k++
                    continue
                }
                _cge_fail("an operand is missing before " + tk, 198)
            }
            code = strpos("+-*/^", tk)
            pr = _cge_u_prec(code)
            // left-associative except ^; negation binds less tightly than ^
            while (rows(opst)) {
                if (opst[rows(opst), 1] == 3) break
                if (opst[rows(opst), 1] == 1) {
                    if (!(_cge_u_prec(opst[rows(opst), 2]) > pr | (_cge_u_prec(opst[rows(opst), 2]) == pr & code != 5))) break
                }
                else if (opst[rows(opst), 1] == 4) {
                    if (code == 5) break
                }
                // logical not binds less tightly than arithmetic
                else if (opst[rows(opst), 1] == 6) break
                out = out \ _cge_u_pop(opst)
            }
            opst = opst \ (1, code)
            gtok = gtok, (tk == "^" ? "**" : tk)
            prev = 0
            k++
            continue
        }
        _cge_fail("cannot read " + tk + " in the expression", 198)
    }
    if (!prev) _cge_fail("the expression ends with an operator", 198)
    while (rows(opst)) {
        if (opst[rows(opst), 1] == 3) _cge_fail("a parenthesis is opened but not closed", 198)
        out = out \ _cge_u_pop(opst)
    }
    gams = invtokens(_cge_gams_pow(gtok), " ")
    n = rows(out)
    if (!n) _cge_fail("an empty expression", 198)
    return(out)
}

// GAMS's x ** y is defined for x > 0 only: an integer constant exponent is
// written power(x, n), which takes any x (from version 0.18.0). The left
// operand is one token or a group in parentheses with its function's name
string rowvector _cge_gams_pow(string rowvector g)
{
    real scalar k, a, depth, n
    k = 2
    while (k < cols(g)) {
        n = (g[k] == "**" ? strtoreal(g[k + 1]) : .)
        if (n < . & n == round(n) & abs(n) <= 1000) {
            a = k - 1
            if (g[a] == ")") {
                depth = 0
                // a power() written for an inner exponent opens a group too
                for (; a >= 1; a--) {
                    if (g[a] == ")") depth++
                    else if (g[a] == "(" | g[a] == "power(") depth--
                    if (depth == 0) break
                }
                if (a < 1) return(g)
                if (a > 1 & g[a] == "(") {
                    if (regexm(g[a - 1], "^[a-zA-Z_][a-zA-Z0-9_]*$") & !anyof(("and", "or", "not", "eq", "ne"), g[a - 1])) a--
                }
            }
            g = (a > 1 ? g[|1 \ a - 1|] : J(1, 0, "")), "power(", g[|a \ k - 1|], ",", g[k + 1], ")",
                (k + 2 <= cols(g) ? g[|k + 2 \ cols(g)|] : J(1, 0, ""))
            k = k + 4
            continue
        }
        k++
    }
    return(g)
}

// The base value of element args of a parameter (from version 0.11.0): a user
// parameter, or one that cge_shock changes
real scalar _cge_u_parbase(struct cge_model scalar M, string scalar nm, string rowvector args)
{
    string matrix P
    string colvector lab
    real matrix v
    real scalar pi, el, j
    pi = _cge_up_find(M, nm)
    if (pi) {
        if (cols(args) != _cge_nidx(M.updef[pi, 2]) + _cge_nidx(M.updef[pi, 3])) {
            _cge_fail("base(): parameter " + nm + " has " + strofreal(_cge_nidx(M.updef[pi, 2]) + _cge_nidx(M.updef[pi, 3])) +
                      " index(es); " + strofreal(cols(args)) + " given", 198)
        }
        el = 1
        if (cols(args)) {
            lab = _cge_setlab(M, M.updef[pi, 2])
            el = _cge_find(lab, args[1])
            if (!el) _cge_fail("base(): " + args[1] + " is not an element of parameter " + nm, 111)
            if (cols(args) == 2) {
                lab = _cge_setlab(M, M.updef[pi, 3])
                j = _cge_find(lab, args[2])
                if (!j) _cge_fail("base(): " + args[2] + " is not an element of parameter " + nm, 111)
                el = (el - 1) * rows(lab) + j
            }
        }
        return(M.p0.upval[_cge_up_pos(M, pi)[el]])
    }
    if (nm == "tf") {
        if (cols(args) != 2) _cge_fail("base(): parameter tf needs a factor and an activity", 198)
        el = _cge_find(M.F, args[1])
        j = _cge_find(M.A, args[2])
        if (!el | !j) _cge_fail("base(): tf(" + args[1] + ", " + args[2] + ") is not an element of tf", 111)
        return(M.p0.tf[el, j])
    }
    P = _cge_gams_params()
    pi = _cge_find(P[., 1], nm)
    if (!pi) _cge_fail("base(): " + nm + " is not a variable or a parameter", 111)
    el = 1
    if (P[pi, 3] == "") {
        if (cols(args)) _cge_fail("base(): parameter " + nm + " has no elements", 198)
    }
    else {
        if (cols(args) != 1) _cge_fail("base(): parameter " + nm + " needs one element", 198)
        lab = _cge_gams_setlabels(M, P[pi, 3])
        el = _cge_find(lab, args[1])
        if (!el) _cge_fail("base(): " + args[1] + " is not an element of parameter " + nm, 111)
    }
    v = _cge_par_get(M.p0, nm)
    return(v[el])
}

// Element el of a parameter's values: of a vector, or row by row of a matrix
// (tf, from version 0.11.0)
real scalar _cge_u_parel(real matrix v, real scalar el)
{
    // a model without taxes on factor use may hold tf empty
    if (rows(v) * cols(v) == 0) return(0)
    if (rows(v) > 1 & cols(v) > 1) return(v[ceil(el / cols(v)), mod(el - 1, cols(v)) + 1])
    return(v[el])
}

// The longest lag (from version 0.9.2)
real scalar _cge_maxlag()
{
    return(4)
}

// lag(reference[, k]) in an expression (from version 0.9.2), and lead() (fn,
// from version 0.10.2): the position of the element of the variable referred
// to, the order k, from 1 to 4, and the GAMS parameter that holds its value
void _cge_u_lag(struct cge_model scalar M, string rowvector a, real scalar pos, real scalar k, string scalar g,
                | string scalar fn)
{
    string rowvector args
    string scalar nm, eg
    real scalar e, c
    if (args() < 6) fn = "lag"
    eg = "as " + fn + "(GL) or " + fn + "(QA(act_agr), 2)"
    if (cols(a) == 0) _cge_fail(fn + "(): give a variable, " + eg, 198)
    nm = a[1]
    if (!regexm(nm, "^[A-Za-z_]")) _cge_fail(fn + "(): give a variable, " + eg, 198)
    if (!_cge_vidx(M, nm)) _cge_fail(fn + "(): " + nm + " is not a variable; " + fn + "() takes a variable, " + eg, 198)
    c = 2
    args = J(1, 0, "")
    if (cols(a) >= 2) {
        if (a[2] == "(") {
            e = _cge_u_close(a, 2)
            args = (e > 3 ? a[|3 \ e - 1|] : J(1, 0, ""))
            args = select(args, args :!= ",")
            c = e + 1
        }
    }
    k = 1
    if (c <= cols(a)) {
        if (a[c] != "," | c + 1 != cols(a)) _cge_fail(fn + "(): write " + fn + "(VAR), " + fn + "(VAR(e)) or " + fn + "(VAR(e), k)", 198)
        k = strtoreal(a[c + 1])
        if (k >= . | k != floor(k) | k < 1 | k > _cge_maxlag()) {
            _cge_fail(fn + "(): the order is a whole number from 1 to " + strofreal(_cge_maxlag()), 198)
        }
    }
    pos = _cge_u_varpos(M, nm, args)
    if (!pos) _cge_fail(fn + "(): " + nm + (cols(args) ? "(" + invtokens(args, ",") + ")" : "") + " is not an element of a variable", 111)
    g = strupper(fn) + strofreal(k) + "_" + _cge_u_gname(M, _cge_vidx(M, nm)) + (cols(args) ? "('" + invtokens(args, "', '") + "')" : "")
}

// The value k periods before of the variable at pos (from version 0.9.2): in
// a period of a dynamic run, from the solutions before it; otherwise, and
// before the first period, the base
real scalar _cge_u_lagval(struct cge_model scalar M, struct cge_par scalar p, real scalar pos, real scalar k)
{
    if (k <= cols(p.xlag) & pos <= rows(p.xlag)) return(p.xlag[pos, k])
    return(M.x0[pos])
}

// The value k periods after of the variable at pos (from version 0.10.2): in a
// period of a run with foresight, from the solutions after it, by the terminal
// condition beyond the last period; otherwise the base
real scalar _cge_u_leadval(struct cge_model scalar M, struct cge_par scalar p, real scalar pos, real scalar k)
{
    if (k <= cols(p.xlead) & pos <= rows(p.xlead)) return(p.xlead[pos, k])
    return(M.x0[pos])
}

// The period (from version 0.10.2): tperiod (code 1), its number, and tfirst
// (2) and tlast (3), 1 in the first and in the last period of a dynamic run;
// 0 in a static simulation
real scalar _cge_u_tval(struct cge_par scalar p, real scalar code)
{
    if (cols(p.tinfo) < 3) return(0)
    return(p.tinfo[code])
}

// 1 if a user equation refers to a later period, or to the period (from
// version 0.10.2)
real scalar _cge_u_haslead(struct cge_model scalar M)
{
    if (!rows(M.utok)) return(0)
    return(any(M.utok[., 1] :== 11))
}

real scalar _cge_u_hastime(struct cge_model scalar M)
{
    if (!rows(M.utok)) return(0)
    return(any(M.utok[., 1] :== 12))
}

// The values of later periods that user equations refer to, as rows of the
// position of the variable and the order (from version 0.10.2)
real matrix _cge_u_leads(struct cge_model scalar M)
{
    if (!_cge_u_haslead(M)) return(J(0, 2, .))
    return(uniqrows(select(M.utok[., 2..3], M.utok[., 1] :== 11)))
}

// 1 if a user equation refers to a lagged value (from version 0.9.2)
real scalar _cge_u_haslag(struct cge_model scalar M)
{
    if (!rows(M.utok)) return(0)
    return(any(M.utok[., 1] :== 9))
}

// The lagged values that user equations refer to, as rows of the position
// of the variable and the order (from version 0.9.2)
real matrix _cge_u_lags(struct cge_model scalar M)
{
    if (!_cge_u_haslag(M)) return(J(0, 2, .))
    return(uniqrows(select(M.utok[., 2..3], M.utok[., 1] :== 9)))
}

real scalar _cge_u_prec(real scalar code)
{
    // + - 1, * / 2, ^ 4; in conditions (from version 0.7.2) comparisons 0.6,
    // & 0.4 and | 0.2, with logical not at 0.5
    if (code <= 2) return(1)
    if (code <= 4) return(2)
    if (code == 5) return(4)
    if (code <= 11) return(0.6)
    if (code == 12) return(0.4)
    return(0.2)
}

// The top of the operator stack as a postfix row, removed from the stack
real rowvector _cge_u_pop(real matrix opst)
{
    real rowvector r
    r = opst[rows(opst), .]
    opst = (rows(opst) > 1 ? opst[|1, 1 \ rows(opst) - 1, 2|] : J(0, 2, .))
    if (r[1] == 1) return((4, r[2], .))
    if (r[1] == 2) return((6, r[2], .))
    if (r[1] == 6) return((8, 0, .))
    return((5, 0, .))
}

// GAMS name of variable k: user variables take the prefix U_
string scalar _cge_u_gname(struct cge_model scalar M, real scalar k)
{
    if (k > rows(M.vname) - M.nuv) return("U_" + M.vname[k])
    return(_cge_gams_vname(M.vname[k]))
}

// Evaluates the postfix rows tok (rows of one side) at x with parameters p
real scalar _cge_u_value(struct cge_model scalar M, struct cge_par scalar p, real colvector x, real matrix tok)
{
    real colvector st
    real matrix v
    real scalar i, sp, a, b, c
    st = J(rows(tok), 1, .)
    sp = 0
    for (i = 1; i <= rows(tok); i++) {
        c = tok[i, 1]
        if (c == 1) {
            sp = sp + 1
            st[sp] = tok[i, 2]
        }
        else if (c == 2) {
            sp = sp + 1
            st[sp] = x[tok[i, 2]]
        }
        else if (c == 3) {
            v = _cge_par_get(p, M.upar[tok[i, 2]])
            sp = sp + 1
            st[sp] = _cge_u_parel(v, tok[i, 3])
        }
        else if (c == 7) {
            sp = sp + 1
            st[sp] = p.upval[tok[i, 2]]
        }
        else if (c == 9) {
            sp = sp + 1
            st[sp] = _cge_u_lagval(M, p, tok[i, 2], tok[i, 3])
        }
        // a value of a later period, and the period (from version 0.10.2)
        else if (c == 11) {
            sp = sp + 1
            st[sp] = _cge_u_leadval(M, p, tok[i, 2], tok[i, 3])
        }
        else if (c == 12) {
            sp = sp + 1
            st[sp] = _cge_u_tval(p, tok[i, 2])
        }
        // a function of several arguments (from version 0.9.7)
        else if (c == 10) {
            sp = sp - tok[i, 3] + 1
            st[sp] = _cge_u_fn(tok[i, 2], st[|sp \ sp + tok[i, 3] - 1|])
        }
        else if (c == 4) {
            b = st[sp]
            sp = sp - 1
            a = st[sp]
            if (tok[i, 2] <= 5) {
                st[sp] = (tok[i, 2] == 1 ? a + b : (tok[i, 2] == 2 ? a - b : (tok[i, 2] == 3 ? a * b :
                         (tok[i, 2] == 4 ? a / b : a ^ b))))
            }
            else st[sp] = _cge_u_cmp(tok[i, 2], a, b)
        }
        else if (c == 5) st[sp] = -st[sp]
        else if (c == 8) st[sp] = (st[sp] >= . ? . : st[sp] == 0)
        else st[sp] = (tok[i, 2] == 1 ? exp(st[sp]) : (tok[i, 2] == 2 ? ln(st[sp]) : sqrt(st[sp])))
    }
    return(st[1])
}

// min() (1), max() (2), abs() (3), sqr() (4), log10() (5) and ifthen() (6) of
// the values a (from version 0.9.7); missing when an argument is, except the
// branch that ifthen() does not take
real scalar _cge_u_fn(real scalar code, real colvector a)
{
    if (code == 6) {
        if (a[1] >= .) return(.)
        return(a[1] != 0 ? a[2] : a[3])
    }
    if (hasmissing(a)) return(.)
    if (code == 1) return(min(a))
    if (code == 2) return(max(a))
    if (code == 3) return(abs(a[1]))
    if (code == 4) return(a[1]^2)
    return(log10(a[1]))
}

// The argument whose value min(), max() or ifthen() takes, 0 if none (from
// version 0.9.7): the first of equal ones
real scalar _cge_u_fnarg(real scalar code, real colvector a)
{
    real scalar j, v
    if (code == 6) return(a[1] >= . ? 0 : (a[1] != 0 ? 2 : 3))
    if (hasmissing(a)) return(0)
    v = (code == 1 ? min(a) : max(a))
    for (j = 1; j <= rows(a); j++) if (a[j] == v) return(j)
    return(0)
}

// The arguments of a function or macro whose parenthesis opens at k and
// closes at e, as their first and last positions (from version 0.9.7)
void _cge_u_args(string rowvector t, real scalar k, real scalar e, real colvector a1, real colvector a2)
{
    real scalar j, d, s
    a1 = J(0, 1, .)
    a2 = J(0, 1, .)
    if (e == k + 1) return
    d = 0
    s = k + 1
    for (j = k + 1; j < e; j++) {
        if (t[j] == "(") d++
        else if (t[j] == ")") d--
        else if (t[j] == "," & d == 0) {
            if (j == s) _cge_fail("an argument is missing before a comma", 198)
            a1 = a1 \ s
            a2 = a2 \ (j - 1)
            s = j + 1
        }
    }
    if (s > e - 1) _cge_fail("an argument is missing after a comma", 198)
    a1 = a1 \ s
    a2 = a2 \ (e - 1)
}

// Macros and card() replaced in tokens t, before the indexes are written out
// (from version 0.9.7)
string rowvector _cge_u_pre(struct cge_model scalar M, string rowvector t)
{
    return(_cge_u_card(M, _cge_u_macros(M, t)))
}

// card(i): the number of elements of the set of index i, or of pairs of a
// set of pairs (from version 0.9.7)
string rowvector _cge_u_card(struct cge_model scalar M, string rowvector t)
{
    string rowvector out
    real scalar k, ks
    if (!anyof(t, "card")) return(t)
    out = J(1, 0, "")
    k = 1
    while (k <= cols(t)) {
        if (t[k] == "card") {
            if (k + 3 > cols(t)) _cge_fail("card(): write card(i), with i a set or an index", 198)
            if (t[k + 1] != "(" | t[k + 3] != ")") _cge_fail("card(): write card(i), with i a set or an index", 198)
            ks = _cge_us_find(M, t[k + 2])
            if (ks) {
                if (_cge_us_pairs(M, ks)) {
                    out = out, strofreal(cols(tokens(M.usdef[ks, 2])))
                    k = k + 4
                    continue
                }
            }
            out = out, strofreal(_cge_setsize(M, _cge_u_set(M, t[k + 2])))
            k = k + 4
            continue
        }
        out = out, t[k]
        k++
    }
    return(out)
}

// Macros (from version 0.9.7), as GAMS's $macro: name(x, y) is replaced by
// the macro's expression in parentheses, each parameter replaced by its
// argument (in parentheses unless it is a single name or number); macros may
// use macros
string rowvector _cge_u_macros(struct cge_model scalar M, string rowvector t)
{
    string rowvector out, body, par, nb
    real colvector a1, a2
    real scalar k, e, m, pass, j, s, changed
    if (rows(M.umac) == 0 | cols(M.umac) < 3) return(t)
    for (pass = 1; pass <= 30; pass++) {
        out = J(1, 0, "")
        changed = 0
        k = 1
        while (k <= cols(t)) {
            m = _cge_um_find(M, t[k])
            if (!m) {
                out = out, t[k]
                k++
                continue
            }
            par = tokens(M.umac[m, 2])
            body = _cge_u_tokens(M.umac[m, 3])
            if (!cols(par)) {
                out = out, "(", body, ")"
                k++
                changed = 1
                continue
            }
            if (k == cols(t)) _cge_fail("macro " + t[k] + " needs its arguments, as " + t[k] + "(" + invtokens(par, ", ") + ")", 198)
            if (t[k + 1] != "(") _cge_fail("macro " + t[k] + " needs its arguments, as " + t[k] + "(" + invtokens(par, ", ") + ")", 198)
            e = _cge_u_close(t, k + 1)
            _cge_u_args(t, k + 1, e, a1, a2)
            if (rows(a1) != cols(par)) {
                _cge_fail("macro " + t[k] + " takes " + strofreal(cols(par)) + " argument(s); " + strofreal(rows(a1)) + " given", 198)
            }
            nb = J(1, 0, "")
            for (j = 1; j <= cols(body); j++) {
                s = _cge_find(par', body[j])
                if (!s) nb = nb, body[j]
                else if (a1[s] == a2[s]) nb = nb, t[a1[s]]
                else nb = nb, "(", t[|a1[s] \ a2[s]|], ")"
            }
            out = out, "(", nb, ")"
            k = e + 1
            changed = 1
        }
        t = out
        if (!changed) return(t)
    }
    _cge_fail("macros use each other without end", 198)
}

// The row of macro name, 0 if none (from version 0.9.7)
real scalar _cge_um_find(struct cge_model scalar M, string scalar name)
{
    real scalar k
    if (rows(M.umac) == 0 | cols(M.umac) < 3) return(0)
    for (k = 1; k <= rows(M.umac); k++) if (M.umac[k, 1] == name) return(k)
    return(0)
}

// 1 if user variables, equations or other macros use macro name (from version
// 0.9.7)
real scalar _cge_um_used(struct cge_model scalar M, string scalar name)
{
    real scalar k
    for (k = 1; k <= rows(M.uvdef); k++) {
        if (anyof(_cge_u_tokens(M.uvdef[k, 3]), name)) return(1)
        if (cols(M.uvdef) >= 7) if (anyof(_cge_u_tokens(M.uvdef[k, 7]), name)) return(1)
    }
    for (k = 1; k <= rows(M.uedef); k++) {
        if (anyof(_cge_u_tokens(M.uedef[k, 4]), name) | anyof(_cge_u_tokens(M.uedef[k, 5]), name)) return(1)
        if (cols(M.uedef) >= 6) if (anyof(_cge_u_tokens(M.uedef[k, 6]), name)) return(1)
    }
    if (rows(M.umac) & cols(M.umac) >= 3) {
        for (k = 1; k <= rows(M.umac); k++) {
            if (M.umac[k, 1] != name & anyof(_cge_u_tokens(M.umac[k, 3]), name)) return(1)
        }
    }
    return(0)
}

// cge_macro name[(a, b, ...)] = expression (from version 0.9.7)
void _cge_um_add(string scalar spec)
{
    struct cge_model scalar M
    string scalar head, body, name, pars, rest, one
    string rowvector par, bt
    real scalar c, d, j, k
    M = _cge_load()
    _cge_need(M, "calibrated")
    // the = outside parentheses, not part of == <= >= !=
    d = 0
    c = 0
    for (k = 1; k <= strlen(spec); k++) {
        if (substr(spec, k, 1) == "(") d++
        else if (substr(spec, k, 1) == ")") d--
        else if (substr(spec, k, 1) == "=" & d == 0) {
            if (substr(spec, k + 1, 1) != "=" & !(k > 1 & strpos("=<>!", substr(spec, k - 1, 1)))) {
                c = k
                break
            }
        }
    }
    if (!c) _cge_fail("cge_macro: write cge_macro name(a, b) = expression", 198)
    head = strtrim(substr(spec, 1, c - 1))
    body = strtrim(substr(spec, c + 1, .))
    if (body == "") _cge_fail("cge_macro: the expression is missing", 198)
    if (!regexm(head, "^([A-Za-z_][A-Za-z_0-9]*)[ ]*(\((.*)\))?$")) _cge_fail("cge_macro: write cge_macro name(a, b) = expression", 198)
    name = regexs(1)
    pars = (strpos(head, "(") ? strtrim(regexs(3)) : "")
    _cge_u_newname(M, name, "macro")
    par = J(1, 0, "")
    if (strpos(head, "(")) {
        if (pars == "") _cge_fail("cge_macro: give the parameters, or leave out the parentheses", 198)
        // the parameters, separated by commas
        rest = pars + ","
        while (strlen(rest)) {
            k = strpos(rest, ",")
            one = strtrim(substr(rest, 1, k - 1))
            if (one == "") _cge_fail("cge_macro: a parameter is missing", 198)
            par = par, one
            rest = substr(rest, k + 1, .)
        }
        for (j = 1; j <= cols(par); j++) {
            if (!regexm(par[j], "^[A-Za-z_][A-Za-z_0-9]*$")) _cge_fail("cge_macro: " + par[j] + " is not a name for a parameter", 198)
            if (j > 1) if (anyof(par[|1 \ j - 1|], par[j])) _cge_fail("cge_macro: parameter " + par[j] + " is given twice", 198)
        }
    }
    bt = _cge_u_tokens(body)
    d = 0
    for (k = 1; k <= cols(bt); k++) {
        if (bt[k] == "(") d++
        else if (bt[k] == ")") d--
        if (d < 0) break
    }
    if (d != 0) _cge_fail("cge_macro: the parentheses of the expression do not match", 198)
    if (anyof(bt, name)) _cge_fail("cge_macro: macro " + name + " uses itself", 198)
    if (rows(M.umac) == 0 | cols(M.umac) < 3) M.umac = J(0, 3, "")
    M.umac = M.umac \ (name, invtokens(par), body)
    _cge_store(M)
    printf("{txt}Macro {res}%s%s{txt} = %s\n", name, (cols(par) ? "(" + invtokens(par, ", ") + ")" : ""), body)
    st_global("r(name)", name)
    st_numscalar("r(N_macros)", rows(M.umac))
}

void _cge_um_list()
{
    struct cge_model scalar M
    real scalar k, n
    M = _cge_load()
    n = (cols(M.umac) >= 3 ? rows(M.umac) : 0)
    st_numscalar("r(N_macros)", n)
    if (!n) {
        printf("{txt}No macros\n")
        return
    }
    for (k = 1; k <= n; k++) {
        printf("{txt}macro {res}%s%s{txt} = %s\n", M.umac[k, 1],
               (M.umac[k, 2] != "" ? "(" + invtokens(tokens(M.umac[k, 2]), ", ") + ")" : ""), M.umac[k, 3])
    }
}

// Removes every macro; macros that user variables or equations use must be
// removed with them first
void _cge_um_clear()
{
    struct cge_model scalar M
    real scalar k
    M = _cge_load()
    if (cols(M.umac) >= 3) {
        for (k = 1; k <= rows(M.umac); k++) {
            if (_cge_um_used(M, M.umac[k, 1]) & !_cge_um_onlymacros(M, M.umac[k, 1])) {
                _cge_fail("macro " + M.umac[k, 1] + " is used by user variables or equations: remove them first", 459)
            }
        }
    }
    M.umac = J(0, 3, "")
    _cge_store(M)
    printf("{txt}Macros removed\n")
}

// 1 if only other macros use macro name (from version 0.9.7)
real scalar _cge_um_onlymacros(struct cge_model scalar M, string scalar name)
{
    struct cge_model scalar N
    N = M
    N.umac = J(0, 3, "")
    return(!_cge_um_used(N, name))
}

// Comparisons and & | of conditions (codes 6 to 13): 1 or 0, missing when
// an operand is missing
real scalar _cge_u_cmp(real scalar code, real scalar a, real scalar b)
{
    if (a >= . | b >= .) return(.)
    if (code == 6) return(a > b)
    if (code == 7) return(a < b)
    if (code == 8) return(a >= b)
    if (code == 9) return(a <= b)
    if (code == 10) return(a == b)
    if (code == 11) return(a != b)
    if (code == 12) return(a != 0 & b != 0)
    return(a != 0 | b != 0)
}

// Both sides of every user equation element at x
void _cge_u_eval(struct cge_model scalar M, struct cge_par scalar p, real colvector x, real colvector lhs,
                 real colvector rhs)
{
    real scalar k, n
    n = rows(M.uelab)
    lhs = J(n, 1, .)
    rhs = J(n, 1, .)
    for (k = 1; k <= n; k++) {
        lhs[k] = _cge_u_value(M, p, x, M.utok[|M.ustart[k], 1 \ M.ustart[k] + M.ulen[k] - 1, 3|])
        rhs[k] = _cge_u_value(M, p, x, M.utok[|M.ustart[k] + M.ulen[k], 1 \ M.ustart[k] + M.ulen[k] + M.ulen2[k] - 1, 3|])
    }
}

// The name and index of a definition "NAME" or "NAME(i)": the index and its set
void _cge_u_head(struct cge_model scalar M, string scalar head, string scalar name, string scalar idx,
                 string scalar set, | string scalar cond)
{
    string scalar i1, i2
    head = strtrim(head)
    idx = ""
    set = ""
    cond = ""
    // two indexes (from version 0.9.1): NAME(i,j), with or without a condition
    if (regexm(head, "^([A-Za-z_][A-Za-z_0-9]*)[ ]*\([ ]*([A-Za-z_][A-Za-z_0-9]*)[ ]*,[ ]*([A-Za-z_][A-Za-z_0-9]*)[ ]*\)[ ]*(.*)$")) {
        // the groups are read before _cge_u_set, which matches other patterns
        name = regexs(1)
        i1 = regexs(2)
        i2 = regexs(3)
        cond = strtrim(regexs(4))
        idx = i1 + "," + i2
        if (i1 == i2) _cge_fail("give two different indexes, as (c,c2)", 198)
        set = _cge_u_set(M, i1) + "|" + _cge_u_set(M, i2)
        if (cond != "") {
            if (substr(cond, 1, 1) != char(36)) _cge_fail("write the name as NAME(i,j) or NAME(i,j)" + char(36) + "(condition)", 198)
            cond = strtrim(substr(cond, 2, .))
            if (args() < 6) _cge_fail("a condition is not allowed here", 198)
        }
        if (strlen(name) > 24) _cge_fail(name + ": names have at most 24 characters", 198)
        return
    }
    // a condition on the domain (from version 0.7.2): NAME(i)$cond
    if (regexm(head, "^([A-Za-z_][A-Za-z_0-9]*)[ ]*\(([A-Za-z_][A-Za-z_0-9]*)\)[ ]*[$](.+)$")) {
        name = regexs(1)
        idx = regexs(2)
        cond = strtrim(regexs(3))
        set = _cge_u_set(M, idx)
        if (args() < 6) _cge_fail("a condition is not allowed here", 198)
    }
    else if (regexm(head, "^([A-Za-z_][A-Za-z_0-9]*)[ ]*[$]")) _cge_fail("a condition needs an index: NAME(i)" + char(36) + "(condition)", 198)
    else if (regexm(head, "^([A-Za-z_][A-Za-z_0-9]*)[ ]*\(([A-Za-z_][A-Za-z_0-9]*)\)$")) {
        name = regexs(1)
        idx = regexs(2)
        set = _cge_u_set(M, idx)
    }
    else if (regexm(head, "^([A-Za-z_][A-Za-z_0-9]*)$")) name = regexs(1)
    else _cge_fail("write the name as NAME or NAME(i), with i the index of a model set (a, c, f, h, d, i or n) or of a user set", 198)
    if (strlen(name) > 24) _cge_fail(name + ": names have at most 24 characters", 198)
}

// All user equations compiled against the current model; base values of the
// user variables from their definitions, in order
void _cge_u_build(struct cge_model scalar M, struct cge_par scalar p, real colvector x0)
{
    string rowvector tl, tr, els
    string colvector lab, gl, e1, e2
    real colvector o1, o2
    string scalar name, idx, set, gtl, gtr
    real matrix tok, L, R
    real colvector pos, st, ln1, ln2, dom
    real scalar k, j, kv, v, r
    struct cge_par scalar pb
    _cge_u_widen(M)
    M.upar = J(0, 1, "")
    // at the base, a lagged value is the base value (from version 0.9.2), and
    // so is a value of a later period (from version 0.10.2)
    pb = p
    pb.xlag = J(1, _cge_maxlag(), x0)
    pb.xlead = pb.xlag
    // user variables: base values from their expressions
    for (k = 1; k <= rows(M.uvdef); k++) {
        kv = rows(M.vname) - M.nuv + k
        pos = _cge_vpos(M, kv)
        idx = M.uvdef[k, 4]
        _cge_u_els(M, M.uvdef[k, 2], e1, e2, o1, o2)
        // the elements in its domain exist (from version 0.7.2)
        dom = (idx == "" ? 1 : _cge_u_domain(M, pb, x0, idx, M.uvdef[k, 2], M.uvdef[k, 7]))
        M.exists[pos] = dom
        for (j = 1; j <= rows(pos); j++) {
            if (!dom[j]) {
                x0[pos[j]] = 0
                pb.xlag[pos[j], .] = J(1, _cge_maxlag(), 0)
                pb.xlead[pos[j], .] = J(1, _cge_maxlag(), 0)
                continue
            }
            tl = _cge_u_pre(M, _cge_u_tokens(M.uvdef[k, 3]))
            if (idx != "") tl = _cge_u_subst2(("(", tl, ")"), idx, e1[j], e2[j], o1[j], o2[j])
            tl = _cge_u_written(M, pb, x0, tl)
            tok = _cge_u_compile(M, tl, x0, gtl)
            // a definition cannot give the base value from its own lag or lead
            for (r = 1; r <= rows(tok); r++) {
                if ((tok[r, 1] == 9 | tok[r, 1] == 11) & anyof(pos, tok[r, 2])) {
                    _cge_fail("user variable " + M.uvdef[k, 1] + " refers to its own " + (tok[r, 1] == 9 ? "lag" : "lead") +
                              ": give it a value() and an equation (cge_equation)", 198)
                }
            }
            v = _cge_u_value(M, pb, x0, tok)
            if (v >= .) _cge_fail("user variable " + M.uvdef[k, 1] + ": its base value is missing", 459)
            x0[pos[j]] = v
            pb.xlag[pos[j], .] = J(1, _cge_maxlag(), v)
            pb.xlead[pos[j], .] = J(1, _cge_maxlag(), v)
        }
    }
    // equations, one element per member of the set they are written over
    tok = J(0, 3, .)
    lab = J(0, 1, "")
    gl = J(0, 2, "")
    st = J(0, 1, .)
    ln1 = J(0, 1, .)
    ln2 = J(0, 1, .)
    M.urep = J(0, 3, "")
    for (k = 1; k <= rows(M.uedef); k++) {
        // an inequality is the bound of its slack variable (from version 0.9.0)
        if (M.uedef[k, 7] == "<=" | M.uedef[k, 7] == ">=") continue
        idx = M.uedef[k, 2]
        set = M.uedef[k, 3]
        _cge_u_els(M, set, e1, e2, o1, o2)
        dom = (idx == "" ? 1 : _cge_u_domain(M, pb, x0, idx, set, M.uedef[k, 6]))
        for (j = 1; j <= rows(e1); j++) {
            if (!dom[j]) continue
            tl = _cge_u_pre(M, _cge_u_tokens(M.uedef[k, 4]))
            tr = _cge_u_pre(M, _cge_u_tokens(M.uedef[k, 5]))
            if (idx != "") {
                tl = _cge_u_subst2(("(", tl, ")"), idx, e1[j], e2[j], o1[j], o2[j])
                tr = _cge_u_subst2(("(", tr, ")"), idx, e1[j], e2[j], o1[j], o2[j])
            }
            L = _cge_u_compile(M, _cge_u_written(M, pb, x0, tl), x0, gtl)
            R = _cge_u_compile(M, _cge_u_written(M, pb, x0, tr), x0, gtr)
            st = st \ (rows(tok) + 1)
            ln1 = ln1 \ rows(L)
            ln2 = ln2 \ rows(R)
            tok = tok \ L \ R
            lab = lab \ (M.uedef[k, 1] + (idx != "" ? "(" + e1[j] + (e2[j] != "" ? "," + e2[j] : "") + ")" : ""))
            gl = gl \ (gtl, gtr)
            // the built-in element it replaces (from version 0.9.3)
            if (substr(M.uedef[k, 8], 1, 8) == "replace:") {
                M.urep = M.urep \ _cge_u_repel(substr(M.uedef[k, 8], 9, .), (idx != "" ? e1[j] : ""), (idx != "" ? e2[j] : ""))
            }
        }
    }
    M.utok = tok
    M.uelab = lab
    M.uegams = gl
    M.ustart = st
    M.ulen = ln1
    M.ulen2 = ln2
}

// Position of the first colon outside parentheses, 0 if none
real scalar _cge_u_colon(string scalar s)
{
    real scalar k, d
    string scalar ch
    d = 0
    for (k = 1; k <= strlen(s); k++) {
        ch = substr(s, k, 1)
        if (ch == "(") d++
        else if (ch == ")") d--
        else if (ch == ":" & d == 0) return(k)
    }
    _cge_fail("cge_equation: write NAME: expression = expression", 198)
}

// Splits "head = expression , options" at the first "=" and the last comma
// outside parentheses
void _cge_u_split(string scalar s, string scalar head, string scalar expr, string scalar opts,
                  | string scalar rel)
{
    real scalar k, d, eq, cm, wl
    string scalar ch, t
    t = s
    d = 0
    eq = 0
    cm = 0
    wl = 1
    rel = ""
    for (k = 1; k <= strlen(t); k++) {
        ch = substr(t, k, 1)
        if (ch == "(") d++
        else if (ch == ")") d--
        else if (d == 0 & !eq & (substr(t, k, 3) == "=l=" | substr(t, k, 3) == "=g=" | substr(t, k, 3) == "=e=")) {
            // the relations of GAMS (from version 0.9.0)
            eq = k
            wl = 3
            rel = (substr(t, k, 3) == "=l=" ? "<=" : (substr(t, k, 3) == "=g=" ? ">=" : "="))
            k = k + 2
        }
        else if (d == 0 & !eq & (substr(t, k, 2) == "<=" | substr(t, k, 2) == ">=")) {
            // an inequality (from version 0.9.0)
            eq = k
            wl = 2
            rel = substr(t, k, 2)
            k++
        }
        else if (ch == "=" & d == 0 & !eq) {
            // a single = (from version 0.7.2, conditions use == >= <= !=)
            if (!(k > 1 & strpos("=<>!", substr(t, k - 1, 1))) & substr(t, k + 1, 1) != "=") {
                eq = k
                rel = "="
            }
        }
        else if (ch == "," & d == 0) cm = k
    }
    opts = (cm ? strtrim(substr(t, cm + 1, .)) : "")
    if (cm) t = substr(t, 1, cm - 1)
    head = strtrim(eq ? substr(t, 1, eq - 1) : t)
    expr = strtrim(eq ? substr(t, eq + wl, .) : "")
}

// cge_variable NAME[(i)] = expression [, nominal]: a variable and the
// equation that defines it; or cge_variable NAME[(i)], value(#) [nominal]: a
// variable that user equations determine
void _cge_u_addvar(string scalar spec)
{
    struct cge_model scalar M
    string scalar head, expr, opts, name, idx, set, value, cond, lo, up, status, rel, dexpr, ix
    string rowvector ot
    real colvector x0, pos
    real scalar k, len, nom, fx, nb
    M = _cge_load()
    _cge_need(M, "calibrated")
    _cge_u_split(spec, head, expr, opts, rel)
    if (rel != "" & rel != "=") _cge_fail("cge_variable: write NAME = expression; inequalities are user equations (cge_equation)", 198)
    _cge_u_head(M, head, name, idx, set, cond)
    if (substr(name, 1, 1) == "_") _cge_fail(name + ": names that begin with _ are kept for the package", 198)
    // the options; value() may hold an expression (from version 0.13.0)
    _cge_u_varopts(opts, nom, fx, value, lo, up)
    // a variable without a definition at a bound is exogenous there, and may
    // move away from it as the paired variable of an inequality (from
    // version 0.9.0)
    if (expr == "" & lo != "" & up != "") _cge_fail("cge_variable: a variable without a definition takes lower() or upper(), not both", 198)
    if (expr == "" & (lo != "" | up != "")) {
        if (value != "" & strtoreal(value) != strtoreal(lo + up)) _cge_fail("cge_variable: value() must equal the bound", 198)
        value = lo + up
        fx = 1
    }
    if (expr == "" & value == "") _cge_fail("cge_variable: give the definition, NAME = expression, or a base value, value(#)", 198)
    if (expr != "" & value != "") _cge_fail("cge_variable: give a definition or value(#), not both", 198)
    if (expr != "" & fx) _cge_fail("cge_variable: a defined variable cannot be fixed; swap it with cge_closure, swap()", 198)
    if (lo != "" & up != "") {
        if (strtoreal(lo) > strtoreal(up)) _cge_fail("cge_variable: lower() cannot exceed upper()", 198)
    }
    if (_cge_vidx(M, name)) _cge_fail(name + " is already a variable of the model", 110)
    if (anyof(("sum", "base", "exp", "ln", "log", "sqrt", "ord", "sameas", "lag", "lead", "prod", "smax", "smin", "card", "min",
               "max", "abs", "sqr", "log10", "ifthen", "tperiod", "tfirst", "tlast"), name)) {
        _cge_fail(name + " is a reserved word", 198)
    }
    if (_cge_um_find(M, name)) _cge_fail(name + " is the name of a macro", 110)
    if (!_cge_sa(M) & _cge_find(_cge_gams_params()[., 1], name)) _cge_fail(name + " is the name of a parameter", 110)
    if (_cge_up_find(M, name) | _cge_us_find(M, name)) _cge_fail(name + " is the name of a user parameter or set", 110)
    if (_cge_sa(M) & anyof(_cge_alllabels(M), name)) _cge_fail(name + " is the label of an element of the model", 110)
    if (rows(M.uedef) & expr != "") {
        if (anyof(M.uedef[., 1], name)) _cge_fail("an equation is already named " + name, 110)
    }
    _cge_u_widen(M)
    status = (expr != "" ? "defined" : (fx ? "fixed" : "value"))
    ix = (idx != "" ? "(" + idx + ")" : "")
    // a defined variable with bounds: its definition gains adjusters fixed at
    // zero, which the bounds free (from version 0.9.0), so that it is the
    // expression held within the bounds
    dexpr = expr
    nb = 0
    if (expr != "" & lo != "") {
        (void) _cge_u_newrow(M, ("_L_" + name, set, "0", idx, "", "fixed", cond, "0", ""), nom)
        dexpr = "(" + dexpr + ") + _L_" + name + ix
        nb++
    }
    if (expr != "" & up != "") {
        (void) _cge_u_newrow(M, ("_U_" + name, set, "0", idx, "", "fixed", cond, "0", ""), nom)
        dexpr = (nb ? dexpr : "(" + dexpr + ")") + " - _U_" + name + ix
    }
    if (expr != "") M.uedef = M.uedef \ (name, idx, set, name + ix, dexpr, cond, "=", "")
    pos = _cge_u_newrow(M, (name, set, (expr != "" ? expr : value), idx, (nom ? "nominal" : ""), status, cond, lo, up), nom)
    x0 = M.x0
    // the elements in the domain (from version 0.7.2)
    pos = select(pos, M.exists[pos])
    len = rows(pos)
    if (!len) _cge_fail("user variable " + name + ": no element meets the condition", 459)
    _cge_u_refresh(M)
    if (expr != "" & (lo != "" | up != "")) (void) _cge_u_cons_sync(M, 1)
    _cge_store(M)
    printf("{txt}User variable {res}%s%s{txt}: %f element(s), base value%s {res}%s\n", name,
           (idx != "" ? "(" + idx + ")" + (cond != "" ? "$" + cond : "") : ""), len, (len > 1 ? "s" : ""),
           invtokens(strtrim(strofreal(x0[pos[|1 \ min((len, 5))|]]', "%12.6g"))) + (len > 5 ? " ..." : ""))
    if (expr != "") printf("{txt}and its definition, equation {res}%s%s\n", name,
                           (lo + up != "" ? ", held within its bounds" : ""))
    else if (status == "fixed") printf("{txt}It is exogenous%s\n", (lo + up != "" ? ": the paired variable of an inequality may move it from its bound" : ""))
    else printf("{txt}Add the equations that determine it with cge_equation\n")
    st_global("r(name)", name)
    st_numscalar("r(N_elements)", len)
}

// The options of cge_variable (from version 0.13.0, in place of a reading of
// tokens): nominal and fixed, and value(), lower() and upper(), whose
// parentheses may hold others; value() holds an expression, which gives the
// base value of each element as a definition does, and lower() and upper()
// numbers
void _cge_u_varopts(string scalar opts, real scalar nom, real scalar fx, string scalar value, string scalar lo,
                    string scalar up)
{
    string scalar s, w, inner
    real scalar e, d
    nom = fx = 0
    value = lo = up = ""
    s = strtrim(opts)
    while (s != "") {
        if (!regexm(s, "^([A-Za-z]+)")) _cge_fail("cge_variable: cannot read the options from " + s, 198)
        w = regexs(1)
        s = strtrim(substr(s, strlen(w) + 1, .))
        if (w == "nominal") {
            nom = 1
            continue
        }
        if (w == "fixed") {
            fx = 1
            continue
        }
        if (!anyof(("value", "lower", "upper"), w)) {
            _cge_fail("cge_variable: unknown option " + w + "; the options are nominal, value(), fixed, lower(#) and upper(#)", 198)
        }
        if (substr(s, 1, 1) != "(") _cge_fail("cge_variable: write " + w + "(" + (w == "value" ? "expression" : "#") + ")", 198)
        d = 0
        for (e = 1; e <= strlen(s); e++) {
            if (substr(s, e, 1) == "(") d++
            else if (substr(s, e, 1) == ")") {
                d--
                if (!d) break
            }
        }
        if (d) _cge_fail("cge_variable: a parenthesis is not closed in " + w + "()", 198)
        inner = strtrim(substr(s, 2, e - 2))
        s = strtrim(substr(s, e + 1, .))
        if (inner == "") _cge_fail("cge_variable: " + w + "() is empty", 198)
        if (w != "value" & strtoreal(inner) >= .) _cge_fail("cge_variable: " + w + "() must be a number", 198)
        if (w == "value") value = inner
        else if (w == "lower") lo = inner
        else up = inner
    }
}

// A row of the user variables: definition r (name, set, expression or value,
// index, nominal, status, condition, lower, upper), its variable added to the
// model with its base value; returns its positions (from version 0.9.0)
real colvector _cge_u_newrow(struct cge_model scalar M, string rowvector r, real scalar nom)
{
    real colvector x0, pos
    real scalar len
    _cge_u_widen(M)
    M.uvdef = M.uvdef \ r
    _cge_layout(M)
    len = rows(_cge_vpos(M, rows(M.vname)))
    M.x0 = M.x0 \ J(len, 1, 0)
    M.xcur = M.xcur \ J(len, 1, 0)
    M.xscale = M.xscale \ J(len, 1, 1)
    M.exists = M.exists \ J(len, 1, 1)
    M.fixed = M.fixed \ J(len, 1, (r[6] == "fixed"))
    M.nominal = M.nominal \ J(len, 1, nom)
    M.simx = M.simx \ J(len, cols(M.simx), 0)
    x0 = M.x0
    _cge_u_build(M, M.p0, x0)
    pos = _cge_vpos(M, rows(M.vname))
    M.x0[pos] = x0[pos]
    M.xcur[pos] = x0[pos]
    M.xscale[pos] = abs(x0[pos]) :* (abs(x0[pos]) :> 1e-12) + (abs(x0[pos]) :<= 1e-12)
    if (cols(M.simx)) M.simx[pos, .] = J(1, cols(M.simx), x0[pos])
    // exogenous elements outside the domain stay fixed at zero
    M.fixed[pos] = J(len, 1, (r[6] == "fixed"))
    return(pos)
}

// The exogenous user variables in the closure (from version 0.9.0)
void _cge_u_fixed(struct cge_model scalar M, real colvector fixed)
{
    real colvector pos
    real scalar k, kv
    if (!M.nuv) return
    _cge_u_widen(M)
    for (k = 1; k <= rows(M.uvdef); k++) {
        if (M.uvdef[k, 6] != "fixed") continue
        kv = rows(M.vname) - M.nuv + k
        pos = _cge_vpos(M, kv)
        fixed[pos] = J(rows(pos), 1, 1)
    }
}

// The position of user variable name, element el ("" without an index,
// "e1.e2" with two), or 0
real scalar _cge_u_vpos(struct cge_model scalar M, string scalar name, string scalar el)
{
    string colvector e1, e2
    real colvector pos, sel
    real scalar k, i, d
    k = _cge_vidx(M, name)
    if (!k) return(0)
    pos = _cge_vpos(M, k)
    if (el == "") return(rows(pos) == 1 ? pos[1] : 0)
    _cge_vlabels(M, k, e1, e2)
    d = strpos(el, ".")
    if (d & e2[1] != "") {
        sel = _cge_which((e1 :== substr(el, 1, d - 1)) :& (e2 :== substr(el, d + 1, .)))
        return(rows(sel) ? pos[sel[1]] : 0)
    }
    i = _cge_find(e1, el)
    return(i ? pos[i] : 0)
}

// The variable paired with an inequality, perp(VAR[(e)][, up|down]): its
// name, its element (the equation's index, a label or none) and direction
void _cge_u_perp(struct cge_model scalar M, string scalar opts, string scalar idx, string scalar vname,
                 string scalar vel, real scalar dir)
{
    string scalar s, d
    real scalar k, c, kv
    s = strtrim(opts)
    if (!regexm(s, "^perp[ ]*\((.*)\)$")) _cge_fail("cge_equation: an inequality needs perp(VAR), the variable paired with it", 198)
    s = strtrim(regexs(1))
    // the direction, after a comma outside parentheses
    d = ""
    c = 0
    k = 0
    for (c = 1; c <= strlen(s); c++) {
        if (substr(s, c, 1) == "(") k++
        else if (substr(s, c, 1) == ")") k--
        else if (substr(s, c, 1) == "," & k == 0) break
    }
    if (c <= strlen(s)) {
        d = strtrim(substr(s, c + 1, .))
        s = strtrim(substr(s, 1, c - 1))
    }
    if (d != "" & d != "up" & d != "down") _cge_fail("perp(): the direction is up or down", 198)
    dir = (d == "down" ? -1 : 1)
    vel = ""
    if (regexm(s, "^([A-Za-z_][A-Za-z_0-9]*)[ ]*\((.*)\)$")) {
        vname = regexs(1)
        vel = strtrim(regexs(2))
    }
    else if (regexm(s, "^[A-Za-z_][A-Za-z_0-9]*$")) vname = s
    else _cge_fail("perp(): give a variable, as perp(RA(a)) or perp(GADJ)", 198)
    kv = _cge_vidx(M, vname)
    if (!kv) _cge_fail("perp(): " + vname + " is not a variable of the model", 111)
    if (vel == "" & M.vset[kv] != "") _cge_fail("perp(): give the element of " + vname + ", or the index of the equation", 198)
    if (vel != "" & M.vset[kv] == "") _cge_fail("perp(): " + vname + " has no elements", 198)
    vel = subinstr(vel, " ", "")
    if (vel != "" & vel != idx & idx != "") {
        c = strpos(vel, ",")
        if (_cge_u_isindex(M, (c ? substr(vel, 1, c - 1) : vel))) _cge_fail("perp(): the indexes of " + vname + " must be those of the equation, " + idx, 198)
    }
}

// The constraints of the user inequalities and of the bounds of defined user
// variables, made again from their definitions (from version 0.9.0): each
// element of an inequality bounds its slack variable _S_name from below at
// zero, adjusted by its paired variable; a bound of a defined variable is
// adjusted by _L_name or _U_name. With strict, a paired variable that is not
// fixed under the closure is an error; otherwise the inequality is left out
// with a note. Returns 1 if there are any.
real scalar _cge_u_cons_sync(struct cge_model scalar M, real scalar strict)
{
    string colvector e1, e2
    string rowvector pr
    string scalar vname, vel, el, lab
    real colvector ypos, xs
    real scalar k, i, ky, kx, n, dir, xp, any
    _cge_u_widen(M)
    _cge_u_cons_drop(M)
    any = 0
    for (k = 1; k <= rows(M.uedef); k++) {
        if (M.uedef[k, 7] != "<=" & M.uedef[k, 7] != ">=") continue
        any = 1
        pr = tokens(M.uedef[k, 8], "|")
        pr = select(pr, pr :!= "|")
        vname = pr[1]
        vel = (cols(pr) >= 2 ? pr[2] : "")
        dir = (cols(pr) >= 3 ? (pr[3] == "down" ? -1 : 1) : 1)
        if (vel == "-") vel = ""
        ky = _cge_vidx(M, "_S_" + M.uedef[k, 1])
        ypos = _cge_vpos(M, ky)
        _cge_vlabels(M, ky, e1, e2)
        for (i = 1; i <= rows(ypos); i++) {
            if (!M.exists[ypos[i]]) continue
            el = (vel == M.uedef[k, 2] & vel != "" ? e1[i] + (e2[i] != "" ? " " + e2[i] : "") : subinstr(vel, ",", " "))
            kx = _cge_vidx(M, vname)
            xp = _cge_cons_pos(M, kx, el)
            if (rows(xp) != 1) _cge_fail("perp(): " + vname + (el != "" ? "(" + el + ")" : "") + " is not one element", 198)
            xp = xp[1]
            lab = M.uedef[k, 1] + (e1[i] != "" ? "(" + e1[i] + ")" : "")
            if (!M.exists[xp]) _cge_fail("inequality " + lab + ": " + _cge_poslabel(M, xp) + " does not exist in this model", 459)
            if (!M.fixed[xp]) {
                if (strict) _cge_fail("inequality " + lab + ": " + _cge_poslabel(M, xp) + " is not fixed under the closure, so it cannot be paired with it", 459)
                printf("{txt}Note: inequality %s is left out: %s is not fixed under this closure\n", lab, _cge_poslabel(M, xp))
                continue
            }
            _cge_u_cons_add(M, ypos[i], xp, -1, 0, dir)
        }
    }
    for (k = 1; k <= rows(M.uvdef); k++) {
        if (M.uvdef[k, 6] != "defined" | M.uvdef[k, 8] + M.uvdef[k, 9] == "") continue
        any = 1
        ky = _cge_vidx(M, M.uvdef[k, 1])
        ypos = _cge_vpos(M, ky)
        if (M.uvdef[k, 8] != "") {
            xs = _cge_vpos(M, _cge_vidx(M, "_L_" + M.uvdef[k, 1]))
            for (i = 1; i <= rows(ypos); i++) if (M.exists[ypos[i]]) _cge_u_cons_add(M, ypos[i], xs[i], -1, strtoreal(M.uvdef[k, 8]), 1)
        }
        if (M.uvdef[k, 9] != "") {
            xs = _cge_vpos(M, _cge_vidx(M, "_U_" + M.uvdef[k, 1]))
            for (i = 1; i <= rows(ypos); i++) if (M.exists[ypos[i]]) _cge_u_cons_add(M, ypos[i], xs[i], 1, strtoreal(M.uvdef[k, 9]), 1)
        }
    }
    _cge_cons_rebuild(M)
    return(any)
}

// One constraint: variable at position y bounded (typ 1 from above, -1 from
// below) at b, adjusted by the variable at x in direction d
void _cge_u_cons_add(struct cge_model scalar M, real scalar y, real scalar x, real scalar typ, real scalar b,
                     real scalar d)
{
    M.bY = M.bY \ y
    M.bX = M.bX \ x
    M.btype = M.btype \ typ
    M.bdir = M.bdir \ d
    M.p.bmode = M.p.bmode \ 1
    M.p.bval = M.p.bval \ b
    M.p.bxbar = M.p.bxbar \ M.xcur[x]
    M.p0.bmode = M.p0.bmode \ 0
    M.p0.bval = M.p0.bval \ b
    M.p0.bxbar = M.p0.bxbar \ M.x0[x]
}

// The constraints of user inequalities and bounds removed: those whose bounded
// or adjusting variable is one of the package's slack variables or adjusters,
// or whose bounded variable has bounds of its own (from version 0.9.0)
void _cge_u_cons_drop(struct cge_model scalar M)
{
    real colvector keep, own
    real scalar k, kv, j
    if (!rows(M.bY) | !M.nuv) return
    own = J(rows(M.x0), 1, 0)
    _cge_u_widen(M)
    for (k = 1; k <= rows(M.uvdef); k++) {
        kv = rows(M.vname) - M.nuv + k
        if (substr(M.uvdef[k, 1], 1, 1) == "_") own[_cge_vpos(M, kv)] = J(rows(_cge_vpos(M, kv)), 1, 1)
    }
    keep = J(rows(M.bY), 1, 1)
    for (j = 1; j <= rows(M.bY); j++) {
        if (M.bY[j] <= rows(own)) if (own[M.bY[j]]) keep[j] = 0
        if (M.bX[j] <= rows(own)) if (own[M.bX[j]]) keep[j] = 0
    }
    if (all(keep)) return
    M.bY = _cge_selcol(M.bY, keep)
    M.bX = _cge_selcol(M.bX, keep)
    M.btype = _cge_selcol(M.btype, keep)
    M.bdir = _cge_selcol(M.bdir, keep)
    M.p.bmode = _cge_selcol(M.p.bmode, keep)
    M.p.bval = _cge_selcol(M.p.bval, keep)
    M.p.bxbar = _cge_selcol(M.p.bxbar, keep)
    M.p0.bmode = _cge_selcol(M.p0.bmode, keep)
    M.p0.bval = _cge_selcol(M.p0.bval, keep)
    M.p0.bxbar = _cge_selcol(M.p0.bxbar, keep)
}

// The paired variable of an inequality as written: ", perp(VAR(e), down)"
string scalar _cge_u_perptext(string scalar spec)
{
    string rowvector pr
    if (spec == "") return("")
    // an equation that replaces built-in elements (from version 0.9.3)
    if (substr(spec, 1, 8) == "replace:") return(", replace(" + substr(spec, 9, .) + ")")
    pr = tokens(spec, "|")
    pr = select(pr, pr :!= "|")
    return(", perp(" + pr[1] + (cols(pr) >= 2 & pr[2] != "-" ? "(" + pr[2] + ")" : "") +
           (cols(pr) >= 3 & pr[3] == "down" ? ", down" : "") + ")")
}

// The built-in elements that the last n elements of the user equations
// replace, as BLOCK(e1,e2): those of the equation just added (from version
// 0.9.3)
string scalar _cge_u_reptext(struct cge_model scalar M, real scalar n)
{
    string rowvector out
    real scalar k
    out = J(1, 0, "")
    for (k = max((1, rows(M.urep) - n + 1)); k <= rows(M.urep); k++) {
        out = out, M.urep[k, 1] + (M.urep[k, 2] != "" ? "(" + M.urep[k, 2] + (M.urep[k, 3] != "" ? "," + M.urep[k, 3] : "") + ")" : "")
    }
    if (cols(out) > 4) return(invtokens(out[|1 \ 4|]) + " and " + strofreal(cols(out) - 4) + " more")
    return(invtokens(out))
}

// The rows of column v that keep selects, as a column (0 x 1 when none)
real colvector _cge_selcol(real colvector v, real colvector keep)
{
    if (!any(keep)) return(J(0, 1, .))
    return(select(v, keep))
}

// cge_equation NAME[(i)]: lhs =l= rhs, perp(VAR) or lhs =g= rhs, perp(VAR):
// the slack, rhs - lhs or lhs - rhs, is a user variable _S_NAME, bounded from
// below at zero and paired with VAR, which stays at its level while the
// slack is positive and moves, up or down, when it is zero (from version
// 0.9.0)
void _cge_u_addineq(struct cge_model scalar M, string scalar name, string scalar idx, string scalar set,
                    string scalar cond, string scalar lhs, string scalar rhs, string scalar rel, string scalar opts)
{
    string scalar vname, vel, sexpr
    real colvector pos
    real scalar dir, len, n0
    _cge_u_perp(M, opts, idx, vname, vel, dir)
    if (rows(M.uedef)) {
        if (anyof(M.uedef[., 1], name) | anyof(M.uedef[., 1], "_S_" + name)) _cge_fail("equation " + name + " is already defined", 110)
    }
    n0 = rows(M.bY)
    sexpr = (rel == "<=" ? "(" + rhs + ") - (" + lhs + ")" : "(" + lhs + ") - (" + rhs + ")")
    _cge_u_widen(M)
    M.uedef = M.uedef \ ("_S_" + name, idx, set, "_S_" + name + (idx != "" ? "(" + idx + ")" : ""), sexpr, cond, "=", "")
    pos = _cge_u_newrow(M, ("_S_" + name, set, sexpr, idx, "", "defined", cond, "", ""), 0)
    pos = select(pos, M.exists[pos])
    len = rows(pos)
    if (!len) _cge_fail("user equation " + name + ": no element meets the condition", 459)
    M.uedef = M.uedef \ (name, idx, set, lhs, rhs, cond, rel, vname + "|" + (vel == "" ? "-" : vel) + "|" + (dir == 1 ? "up" : "down"))
    _cge_u_refresh(M)
    (void) _cge_u_cons_sync(M, 1)
    _cge_store(M)
    printf("{txt}User inequality {res}%s{txt}: %f element(s), %s %s %s, paired with {res}%s%s{txt}, which may move %s\n",
           name, len, lhs, rel, rhs, vname, (vel != "" ? "(" + vel + ")" : ""), (dir == 1 ? "up" : "down"))
    st_global("r(name)", name)
    st_numscalar("r(N_elements)", len)
    st_numscalar("r(N_constraints)", rows(M.bY))
}

// cge_equation NAME[(i)]: expression = expression
void _cge_u_addeq(string scalar spec)
{
    struct cge_model scalar M
    string scalar head, rest, name, idx, set, lhs, rhs, opts, cond, rel, rep
    string rowvector ro
    real colvector L, R
    real scalar k, c, n0, worst
    M = _cge_load()
    _cge_need(M, "calibrated")
    c = strpos(spec, ":")
    if (!c) _cge_fail("cge_equation: write NAME: expression = expression", 198)
    // the colon after the head, outside the parentheses of a condition
    c = _cge_u_colon(spec)
    head = substr(spec, 1, c - 1)
    rest = substr(spec, c + 1, .)
    _cge_u_head(M, head, name, idx, set, cond)
    if (rows(M.uedef)) {
        if (anyof(M.uedef[., 1], name)) _cge_fail("equation " + name + " is already defined", 110)
    }
    if (substr(name, 1, 1) == "_") _cge_fail(name + ": names that begin with _ are kept for the package", 198)
    _cge_u_split(rest, lhs, rhs, opts, rel)
    if (lhs == "" | rhs == "") _cge_fail("cge_equation: write NAME: expression = expression", 198)
    // an inequality, paired with a variable (from version 0.9.0)
    if (rel == "<=" | rel == ">=") {
        if (regexm(opts, "(^|[ ])rep[a-z]*[ ]*\(")) _cge_fail("cge_equation: replace() takes an equation, not an inequality", 198)
        _cge_u_addineq(M, name, idx, set, cond, lhs, rhs, rel, opts)
        return
    }
    // an equation that replaces built-in equation elements (from version 0.9.3)
    rep = ""
    if (opts != "") {
        ro = _cge_u_opts(opts, ("replace", "perp"), (3, 4), "cge_equation")
        if (ro[2] != "") _cge_fail("cge_equation: perp() pairs an inequality, =l= or =g=, with a variable", 198)
        rep = "replace:" + _cge_u_repcheck(M, ro[1], idx, set)
    }
    n0 = rows(M.uelab)
    _cge_u_widen(M)
    M.uedef = M.uedef \ (name, idx, set, lhs, rhs, cond, "=", rep)
    _cge_u_build(M, M.p0, M.x0)
    if (rows(M.uelab) == n0) _cge_fail("user equation " + name + ": no element meets the condition", 459)
    _cge_u_refresh(M)
    // the base need not satisfy a new equation: it then acts as a shock
    _cge_u_eval(M, M.p0, M.x0, L, R)
    worst = 0
    for (k = n0 + 1; k <= rows(L); k++) worst = max((worst, abs(L[k] - R[k]) / max((1, abs(L[k]), abs(R[k])))))
    _cge_store(M)
    printf("{txt}User equation {res}%s{txt}: %f element(s)%s\n", name, rows(L) - n0,
           (rep != "" ? ", replacing " + _cge_u_reptext(M, rows(L) - n0) : ""))
    if (worst > 1e-9 & _cge_sa(M)) printf("{txt}Note: the starting levels do not satisfy it (largest relative gap {res}%9.2e{txt})\n", worst)
    else if (worst > 1e-9) printf("{txt}Note: the base does not satisfy it (largest relative gap {res}%9.2e{txt}); it acts as a shock\n", worst)
    st_global("r(name)", name)
    st_numscalar("r(N_elements)", rows(L) - n0)
}

// Equation masks, scales and the Jacobian pattern after a change to the user
// variables or equations
void _cge_u_refresh(struct cge_model scalar M)
{
    real colvector L, R, K, mag
    _cge_eq(M, M.p0, M.x0, L, R, K, 1)
    M.emask = K
    mag = rowmax((abs(L), abs(R)))
    M.escale = mag :* (mag :> 1e-9) + (mag :<= 1e-9)
    M.neq = sum(K)
    _cge_pattern(M, M.p0)
}

void _cge_u_list()
{
    struct cge_model scalar M
    real scalar k, j
    string scalar rhs
    M = _cge_load()
    st_numscalar("r(N_variables)", rows(M.uvdef))
    st_numscalar("r(N_equations)", rows(M.uelab))
    if (!rows(M.uvdef) & !rows(M.uedef)) {
        printf("{txt}No user variables or equations\n")
        return
    }
    _cge_u_widen(M)
    for (k = 1; k <= rows(M.uvdef); k++) {
        // the package's own slack variables and adjusters (from version 0.9.0)
        if (substr(M.uvdef[k, 1], 1, 1) == "_") continue
        printf("{txt}variable {res}%s%s{txt}: %s%s%s%s%s\n", M.uvdef[k, 1], (M.uvdef[k, 4] != "" ? "(" + M.uvdef[k, 4] + ")" +
               (M.uvdef[k, 7] != "" ? "$" + M.uvdef[k, 7] : "") : ""),
               (M.uvdef[k, 6] == "defined" ? "= " : "value "), M.uvdef[k, 3], (M.uvdef[k, 5] != "" ? ", nominal" : ""),
               (M.uvdef[k, 6] == "fixed" ? ", fixed" : ""),
               (M.uvdef[k, 8] != "" ? ", lower(" + M.uvdef[k, 8] + ")" : "") + (M.uvdef[k, 9] != "" ? ", upper(" + M.uvdef[k, 9] + ")" : ""))
    }
    for (k = 1; k <= rows(M.uedef); k++) {
        if (substr(M.uedef[k, 1], 1, 1) == "_") continue
        // a bounded variable's definition, as the user wrote it
        j = _cge_find(M.uvdef[., 1], M.uedef[k, 1])
        rhs = M.uedef[k, 5]
        if (j) {
            if (M.uvdef[j, 6] == "defined" & M.uvdef[j, 8] + M.uvdef[j, 9] != "") rhs = M.uvdef[j, 3] + ", within its bounds"
        }
        printf("{txt}equation {res}%s%s{txt}: %s %s %s%s\n", M.uedef[k, 1], (M.uedef[k, 2] != "" ? "(" + M.uedef[k, 2] + ")" +
               (M.uedef[k, 6] != "" ? "$" + M.uedef[k, 6] : "") : ""), M.uedef[k, 4], M.uedef[k, 7], rhs,
               _cge_u_perptext(M.uedef[k, 8]))
    }
}

// Removes every user variable and equation
void _cge_u_clear()
{
    struct cge_model scalar M
    real scalar nkeep
    M = _cge_load()
    _cge_need(M, "calibrated")
    if (!rows(M.uvdef) & !rows(M.uedef)) return
    nkeep = (M.nuv ? M.voff[rows(M.vname) - M.nuv + 1] : rows(M.x0))
    if (rows(M.swfix)) {
        if (any(M.swfix :> nkeep) | any(M.swfree :> nkeep)) _cge_fail("swaps involve user variables: remove them first with cge_closure, swap(none)", 459)
    }
    // the constraints of user inequalities and bounds go with them (from version 0.9.0)
    _cge_u_cons_drop(M)
    if (rows(M.bY)) {
        if (any(M.bY :> nkeep) | any(M.bX :> nkeep)) _cge_fail("constraints involve user variables: remove them first with cge_constraint, clear", 459)
    }
    M.uvdef = J(0, 9, "")
    M.uedef = J(0, 8, "")
    M.urep = J(0, 3, "")
    M.utok = J(0, 3, .)
    M.uelab = J(0, 1, "")
    M.uegams = J(0, 2, "")
    M.ustart = J(0, 1, .)
    M.ulen = J(0, 1, .)
    M.ulen2 = J(0, 1, .)
    M.upar = J(0, 1, "")
    _cge_layout(M)
    M.x0 = M.x0[|1 \ nkeep|]
    M.xcur = M.xcur[|1 \ nkeep|]
    M.xscale = M.xscale[|1 \ nkeep|]
    M.exists = M.exists[|1 \ nkeep|]
    M.fixed = M.fixed[|1 \ nkeep|]
    M.nominal = M.nominal[|1 \ nkeep|]
    if (cols(M.simx)) M.simx = M.simx[|1, 1 \ nkeep, cols(M.simx)|]
    else M.simx = J(nkeep, 0, .)
    _cge_u_refresh(M)
    _cge_cons_rebuild(M)
    // the attributes of the user variables go with them (from version 0.9.8)
    _cge_bd_sync(M)
    M.unest = J(0, 2, "")
    _cge_store(M)
    printf("{txt}User variables and equations removed\n")
}

// =====================================================================
// Declared nests of CES and CET functions (from version 0.11.0;
// model_spec.md, Section 20)
// =====================================================================
//
// cge_nest declares a production (cost) or transformation (revenue)
// function as a tree of CES or CET nests over variables of the model, in
// the manner of MPSGE's production blocks: cge_nest begin names the block,
// its output and price and the elasticity at the top; cge_nest nest adds an
// inner nest; cge_nest input (or output) a leaf, a quantity with its price;
// cge_nest end writes the block as user variables and equations in
// calibrated share form, with shares and base values from base(), so that
// the block holds at the base and follows the model when it is calibrated
// again. Each leaf's equation and the top equation, the price of the output
// against the price index of the block, take the place of the built-in
// equations named in replace().

struct cge_nb {
    // the block: name, index and its set, condition, output quantity and
    // price, efficiency, the built-in equation the top equation replaces,
    // and the kind (1 cost, with elasticities of substitution; 2 revenue,
    // with elasticities of transformation)
    string scalar   name, idx, set, cond, outq, outp, eff, orep
    real scalar     kind
    // the nests: name (the block's own first), parent and elasticity
    string colvector nn, np
    real colvector   ns
    // the leaves: quantity, price, units, nest and the equation replaced
    string matrix    lf
    // the declarations, as written
    string colvector text
}

struct cge_nb scalar _cge_nb_load()
{
    pointer() scalar q
    q = findexternal("cge__nb")
    if (q == NULL) _cge_fail("cge_nest: no block is open; start one with cge_nest begin", 198)
    return(*q)
}

void _cge_nb_store(struct cge_nb scalar NB)
{
    pointer() scalar q
    if ((q = findexternal("cge__nb")) == NULL) q = crexternal("cge__nb")
    *q = NB
}

// cge_nest begin: a new block
void _cge_nest_begin(string scalar head, string scalar outq, string scalar outp, string scalar s,
                     string scalar t, string scalar eff, string scalar rep, string scalar line)
{
    struct cge_model scalar M
    struct cge_nb scalar NB, OPEN
    string scalar name, idx, set, cond
    real scalar e
    M = _cge_load()
    _cge_need(M, "sam")
    _cge_need(M, "calibrated")
    if (findexternal("cge__nb") != NULL) {
        OPEN = _cge_nb_load()
        _cge_fail("cge_nest: block " + OPEN.name + " is open; end it with cge_nest end", 198)
    }
    _cge_u_head(M, head, name, idx, set, cond)
    if (substr(name, 1, 1) == "_") _cge_fail(name + ": names that begin with _ are kept for the package", 198)
    if (strlen(name) > 12) _cge_fail("cge_nest: a block name has at most 12 characters, so that the names made from it fit", 198)
    if ((s != "") + (t != "") != 1) _cge_fail("cge_nest begin: give s(#), an elasticity of substitution, or t(#), one of transformation", 198)
    e = strtoreal(s + t)
    if (e >= . | e < 0) _cge_fail("cge_nest begin: the elasticity must be zero or positive", 198)
    if (outq == "" | outp == "") _cge_fail("cge_nest begin: give output() and price()", 198)
    NB.name = name
    NB.idx = idx
    NB.set = set
    NB.cond = cond
    NB.outq = strtrim(outq)
    NB.outp = strtrim(outp)
    NB.eff = (strtrim(eff) == "" ? "1" : strtrim(eff))
    NB.orep = strtrim(rep)
    NB.kind = (s != "" ? 1 : 2)
    NB.nn = name
    NB.np = ""
    NB.ns = e
    NB.lf = J(0, 5, "")
    NB.text = stritrim(line)
    _cge_nb_store(NB)
}

// cge_nest nest: an inner nest of the open block
void _cge_nest_nest(string scalar name, string scalar s, string scalar t, string scalar parent, string scalar line)
{
    struct cge_nb scalar NB
    real scalar e
    NB = _cge_nb_load()
    if (!regexm(name, "^[A-Za-z][A-Za-z0-9]*$")) _cge_fail("cge_nest nest: a nest name has letters and digits and starts with a letter", 198)
    if (anyof(NB.nn, name)) _cge_fail("cge_nest nest: " + name + " is already a nest of block " + NB.name, 110)
    if (strlen(NB.name) + strlen(name) > 20) _cge_fail("cge_nest nest: the names of the block and the nest together have at most 20 characters", 198)
    if ((NB.kind == 1 & (t != "" | s == "")) | (NB.kind == 2 & (s != "" | t == ""))) {
        _cge_fail("cge_nest nest: a nest of a " + (NB.kind == 1 ? "cost block takes s(#)" : "revenue block takes t(#)"), 198)
    }
    e = strtoreal(s + t)
    if (e >= . | e < 0) _cge_fail("cge_nest nest: the elasticity must be zero or positive", 198)
    if (parent == "") parent = NB.name
    if (!anyof(NB.nn, parent)) _cge_fail("cge_nest nest: in(" + parent + ") is not a nest of block " + NB.name, 111)
    NB.nn = NB.nn \ name
    NB.np = NB.np \ parent
    NB.ns = NB.ns \ e
    NB.text = NB.text \ stritrim(line)
    _cge_nb_store(NB)
}

// cge_nest input and cge_nest output: a leaf of the open block, a quantity
// with its price, in units of its own (efficiency units, for example)
void _cge_nest_leaf(real scalar kind, string scalar q, string scalar price, string scalar units, string scalar in,
                    string scalar rep, string scalar line)
{
    struct cge_nb scalar NB
    NB = _cge_nb_load()
    if (kind != NB.kind) {
        _cge_fail("cge_nest: block " + NB.name + " is a " + (NB.kind == 1 ? "cost block; its leaves are cge_nest input" : "revenue block; its leaves are cge_nest output"), 198)
    }
    if (strtrim(q) == "" | strtrim(price) == "") _cge_fail("cge_nest: a leaf needs a quantity and price()", 198)
    if (in == "") in = NB.name
    if (!anyof(NB.nn, in)) _cge_fail("cge_nest: in(" + in + ") is not a nest of block " + NB.name, 111)
    NB.lf = NB.lf \ (strtrim(q), strtrim(price), (strtrim(units) == "" ? "1" : strtrim(units)), in, strtrim(rep))
    NB.text = NB.text \ stritrim(line)
    _cge_nb_store(NB)
}

// The block under construction dropped
void _cge_nest_drop()
{
    if (findexternal("cge__nb") != NULL) rmexternal("cge__nb")
}

// cge_nest end: the block written as user variables and equations. The model
// is restored if any of them fails.
void _cge_nest_end()
{
    struct cge_model scalar M
    struct cge_nb scalar NB
    string colvector vdef, edef
    real scalar k
    pointer() scalar q
    NB = _cge_nb_load()
    M = _cge_load()
    if (!rows(NB.lf)) _cge_fail("cge_nest end: block " + NB.name + " has no leaves", 198)
    _cge_nest_text(NB, vdef, edef)
    if ((q = findexternal("cge__nb_model")) == NULL) q = crexternal("cge__nb_model")
    *q = M
    for (k = 1; k <= rows(vdef); k++) _cge_u_addvar(vdef[k])
    for (k = 1; k <= rows(edef); k++) _cge_u_addeq(edef[k])
    M = _cge_load()
    _cge_un_widen(M)
    M.unest = M.unest \ (NB.name, invtokens(NB.text', char(10)))
    _cge_store(M)
    rmexternal("cge__nb_model")
    _cge_nest_drop()
    printf("{txt}Block {res}%s{txt}: %f nest(s), %f leaf(s), %f user variable(s) and %f equation(s)\n",
           NB.name, rows(NB.nn), rows(NB.lf), rows(vdef), rows(edef))
    st_global("r(name)", NB.name)
    st_numscalar("r(N_variables)", rows(vdef))
    st_numscalar("r(N_equations)", rows(edef))
}

// When cge_nest end fails: the model as it was, the block still open
void _cge_nest_abort()
{
    pointer() scalar q
    if ((q = findexternal("cge__nb_model")) != NULL) {
        _cge_store(*q)
        rmexternal("cge__nb_model")
    }
}

// The definitions of the block's user variables (vdef) and equations (edef),
// as cge_variable and cge_equation would take them. Leaf j has its price per
// unit, NAME_wj, and its quantity in units, NAME_xj; an inner nest m its
// price index NAME_m_P (1 at the base) and quantity NAME_m_Q (its value at
// base prices at the base); the block its price index NAME_P. Each leaf's
// equation, NAME_dj, gives its quantity from the price index and quantity of
// its nest; the top equation, NAME_z, the price of the output.
void _cge_nest_text(struct cge_nb scalar NB, string colvector vdef, string colvector edef)
{
    string scalar N, I, ix, c0, h, lc, rel, bv, sv, P, R, term, dem
    string colvector lcond, lrel, lbase, lval, nval, nrel
    real colvector order_, isleaf, ch
    real scalar j, n, m, s, nl, nn, k
    N = NB.name
    I = (NB.idx != "" ? "(" + NB.idx + ")" : "")
    c0 = NB.cond
    nl = rows(NB.lf)
    nn = rows(NB.nn)
    vdef = edef = J(0, 1, "")
    // the leaves: price per unit and quantity in units, where the leaf exists
    lcond = lrel = lbase = lval = J(nl, 1, "")
    for (j = 1; j <= nl; j++) {
        lcond[j] = "(" + NB.lf[j, 1] + " != 0)" + (c0 != "" ? " & (" + c0 + ")" : "")
        h = N + "_w" + strofreal(j)
        if (strlen(h) > 24) _cge_fail("cge_nest: block name too long", 198)
        vdef = vdef \ (h + I + "$(" + lcond[j] + ") = (" + NB.lf[j, 2] + ") / (" + NB.lf[j, 3] + ")")
        vdef = vdef \ (N + "_x" + strofreal(j) + I + "$(" + lcond[j] + ") = (" + NB.lf[j, 3] + ") * (" + NB.lf[j, 1] + ")")
        lrel[j] = "(" + h + I + " / base(" + h + I + "))"
        lbase[j] = "base(" + N + "_x" + strofreal(j) + I + ")"
        lval[j] = "(base(" + h + I + ") * " + lbase[j] + ")"
    }
    // the value at base prices of each nest: the sum over the leaves within it
    nval = J(nn, 1, "")
    for (n = 1; n <= nn; n++) {
        sv = ""
        for (j = 1; j <= nl; j++) {
            if (_cge_nest_within(NB, NB.lf[j, 4], NB.nn[n])) sv = sv + (sv != "" ? " + " : "") + lval[j] + "$(" + lcond[j] + ")"
        }
        if (sv == "") _cge_fail("cge_nest end: nest " + NB.nn[n] + " has no leaves", 198)
        nval[n] = "(" + sv + ")"
    }
    // price indexes, from the innermost nests out
    nrel = J(nn, 1, "")
    for (n = 1; n <= nn; n++) nrel[n] = (n == 1 ? N + "_P" + I : N + "_" + NB.nn[n] + "_P" + I)
    order_ = _cge_nest_post(NB)
    for (k = 1; k <= rows(order_); k++) {
        n = order_[k]
        s = NB.ns[n]
        sv = ""
        // children: leaves, then nests
        for (j = 1; j <= nl; j++) {
            if (NB.lf[j, 4] != NB.nn[n]) continue
            sv = sv + (sv != "" ? " + " : "") + "(" + lval[j] + " / " + nval[n] + " * " + _cge_nest_pow(lrel[j], s, NB.kind) + ")$(" + lcond[j] + ")"
        }
        for (m = 2; m <= nn; m++) {
            if (NB.np[m] != NB.nn[n]) continue
            sv = sv + (sv != "" ? " + " : "") + "(" + nval[m] + " / " + nval[n] + " * " + _cge_nest_pow(nrel[m], s, NB.kind) + ")"
        }
        P = _cge_nest_index(sv, s, NB.kind)
        vdef = vdef \ ((n == 1 ? N + "_P" : N + "_" + NB.nn[n] + "_P") + I + (c0 != "" ? "$(" + c0 + ")" : "") + " = " + P)
    }
    // quantities of the inner nests, from the top in
    for (k = rows(order_); k >= 1; k--) {
        n = order_[k]
        if (n == 1) continue
        m = _cge_find(NB.nn, NB.np[n])
        dem = _cge_nest_demand(nval[n], _cge_nest_ratio(NB, m, nval[m], I), nrel[m], nrel[n], NB.ns[m], NB.kind)
        vdef = vdef \ (N + "_" + NB.nn[n] + "_Q" + I + (c0 != "" ? "$(" + c0 + ")" : "") + " = " + dem)
    }
    // the leaves' equations
    for (j = 1; j <= nl; j++) {
        m = _cge_find(NB.nn, NB.lf[j, 4])
        dem = _cge_nest_demand(lbase[j], _cge_nest_ratio(NB, m, nval[m], I), nrel[m], lrel[j], NB.ns[m], NB.kind)
        edef = edef \ (N + "_d" + strofreal(j) + I + "$(" + lcond[j] + "): " + N + "_x" + strofreal(j) + I + " = " + dem +
                       (NB.lf[j, 5] != "" ? ", replace(" + NB.lf[j, 5] + ")" : ""))
    }
    // the price of the output: the price index against efficiency
    edef = edef \ (N + "_z" + I + (c0 != "" ? "$(" + c0 + ")" : "") + ": " + NB.outp + " = base(" + NB.outp + ") * " + N + "_P" + I +
                   (NB.kind == 1 ? " / (" : " * (") + NB.eff + ")" + (NB.orep != "" ? ", replace(" + NB.orep + ")" : ""))
}

// 1 if nest a is nest b or within it
real scalar _cge_nest_within(struct cge_nb scalar NB, string scalar a, string scalar b)
{
    real scalar k
    while (a != "") {
        if (a == b) return(1)
        k = _cge_find(NB.nn, a)
        a = NB.np[k]
    }
    return(0)
}

// The nests from the innermost out: each after the nests within it
real colvector _cge_nest_post(struct cge_nb scalar NB)
{
    real colvector depth
    real scalar n
    string scalar a
    depth = J(rows(NB.nn), 1, 0)
    for (n = 1; n <= rows(NB.nn); n++) {
        a = NB.np[n]
        while (a != "") {
            depth[n] = depth[n] + 1
            a = NB.np[_cge_find(NB.nn, a)]
        }
    }
    return(order((-depth, (1::rows(NB.nn))), (1, 2)))
}

// A relative price raised to the exponent of a CES (1 - s) or CET (1 + s)
// index, or, for the limits, as it stands
string scalar _cge_nest_pow(string scalar rel, real scalar s, real scalar kind)
{
    if (kind == 1 & s == 1) return("ln(" + rel + ")")
    if ((kind == 1 & s == 0) | (kind == 2 & s == 0)) return(rel)
    return(rel + "^(" + _cge_gnum(kind == 1 ? 1 - s : 1 + s) + ")")
}

// The price index of a nest from the sum of its share-weighted terms
string scalar _cge_nest_index(string scalar sv, real scalar s, real scalar kind)
{
    if (kind == 1 & s == 1) return("exp(" + sv + ")")
    if (s == 0) return("(" + sv + ")")
    return("(" + sv + ")^(" + _cge_gnum(1 / (kind == 1 ? 1 - s : 1 + s)) + ")")
}

// The quantity ratio of nest m to the base: for the block, the output against
// efficiency; for an inner nest, its quantity against its value
string scalar _cge_nest_ratio(struct cge_nb scalar NB, real scalar m, string scalar val, string scalar I)
{
    if (m == 1) {
        return("(" + NB.outq + " / base(" + NB.outq + ")" + (NB.kind == 1 ? " / (" : " * (") + NB.eff + "))")
    }
    return("(" + NB.name + "_" + NB.nn[m] + "_Q" + I + " / " + val + ")")
}

// The quantity of a child: its base, the ratio of its nest, and its price
// against the nest's index (cost: (P / p)^s; revenue: (p / P)^t)
string scalar _cge_nest_demand(string scalar base, string scalar ratio, string scalar P, string scalar rel,
                               real scalar s, real scalar kind)
{
    if (s == 0) return(base + " * " + ratio)
    if (kind == 1) {
        if (s == 1) return(base + " * " + ratio + " * " + P + " / " + rel)
        return(base + " * " + ratio + " * (" + P + " / " + rel + ")^(" + _cge_gnum(s) + ")")
    }
    return(base + " * " + ratio + " * (" + rel + " / " + P + ")^(" + _cge_gnum(s) + ")")
}

// The text of a declaration split at the first comma outside parentheses:
// the head (a reference with its index and condition) into local h, the
// options, from the comma, into local o
void _cge_nest_split(string scalar text, string scalar h, string scalar o)
{
    real scalar k, d
    string scalar ch
    d = 0
    for (k = 1; k <= strlen(text); k++) {
        ch = substr(text, k, 1)
        if (ch == "(") d++
        else if (ch == ")") d--
        else if (ch == "," & d == 0) {
            st_local(h, strtrim(substr(text, 1, k - 1)))
            st_local(o, substr(text, k, .))
            return
        }
    }
    st_local(h, strtrim(text))
    st_local(o, "")
}

// The declared blocks, listed
void _cge_nest_list()
{
    struct cge_model scalar M
    string rowvector L
    real scalar k, j
    M = _cge_load()
    _cge_un_widen(M)
    if (!rows(M.unest)) {
        printf("{txt}No blocks are declared\n")
        st_numscalar("r(N_blocks)", 0)
        return
    }
    for (k = 1; k <= rows(M.unest); k++) {
        printf("{txt}Block {res}%s{txt}:\n", M.unest[k, 1])
        L = tokens(M.unest[k, 2], char(10))
        for (j = 1; j <= cols(L); j++) {
            if (L[j] != char(10)) printf("{p 4 8 2}{res}%s{p_end}\n", L[j])
        }
    }
    st_numscalar("r(N_blocks)", rows(M.unest))
    st_global("r(blocks)", invtokens(M.unest[., 1]'))
}

// Models saved before version 0.11.0 have no list of blocks
void _cge_un_widen(struct cge_model scalar M)
{
    if (rows(M.unest) == 0 | cols(M.unest) != 2) {
        if (rows(M.unest) == 0) M.unest = J(0, 2, "")
    }
}

// The user variables and equations for GAMS (cge_user.inc), and the lines
// that write the user variables' results (cge_user_write.inc)
void _cge_gams_user(struct cge_model scalar M, string scalar fn, string scalar fw)
{
    string colvector e1, e2, decl
    real colvector pos, ul, ur, ity, tys
    real scalar vty
    real matrix LG
    real scalar fh, fh2, k, kv, i, gap
    string scalar g, dom, ix
    fh = _cge_gopen(fn)
    fh2 = _cge_gopen(fw)
    fput(fh, "* User variables and equations (model_spec.md, Section 19), written by cge_gams")
    fput(fh2, "* Results of the user variables, written by cge_gams")
    // user parameters at their base values (from version 0.7.1); the scenario
    // changes them in cge_shock_par.inc
    for (k = 1; k <= rows(M.updef); k++) {
        g = "UP_" + M.updef[k, 1]
        dom = (M.updef[k, 2] == "" ? "" : (M.updef[k, 3] == "" ? "(*)" : "(*, *)"))
        fput(fh, "parameter " + g + dom + ";")
        _cge_up_labels(M, k, e1, e2)
        pos = _cge_up_pos(M, k)
        for (i = 1; i <= rows(pos); i++) fput(fh, g + _cge_gams_elem(e1[i], e2[i]) + " = " + _cge_gnum(M.p0.upval[pos[i]]) + ";")
    }
    // lagged values (from version 0.9.2) at the base; each period of a
    // dynamic run sets those of the periods before it in its parameter changes
    LG = _cge_u_lags(M)
    decl = J(0, 1, "")
    for (i = 1; i <= rows(LG); i++) {
        _cge_gams_ref(M, LG[i, 1], g, ix)
        g = "LAG" + strofreal(LG[i, 2]) + "_" + g
        if (!anyof(decl, g)) {
            decl = decl \ g
            fput(fh, "parameter " + g + (ix == "" ? "" : (strpos(ix, ",") ? "(*, *)" : "(*)")) + ";")
        }
        fput(fh, g + ix + " = " + _cge_gnum(M.x0[LG[i, 1]]) + ";")
    }
    // values of later periods (from version 0.10.2) at the base, as lags; the
    // period, zero outside a dynamic run
    LG = _cge_u_leads(M)
    for (i = 1; i <= rows(LG); i++) {
        _cge_gams_ref(M, LG[i, 1], g, ix)
        g = "LEAD" + strofreal(LG[i, 2]) + "_" + g
        if (!anyof(decl, g)) {
            decl = decl \ g
            fput(fh, "parameter " + g + (ix == "" ? "" : (strpos(ix, ",") ? "(*, *)" : "(*)")) + ";")
        }
        fput(fh, g + ix + " = " + _cge_gnum(M.x0[LG[i, 1]]) + ";")
    }
    if (_cge_u_hastime(M)) fput(fh, "scalar TPERIOD / 0 /, TFIRST / 0 /, TLAST / 0 /;")
    // built-in equation elements that user equations replace (from version
    // 0.9.3): the equations of cge_model.gms leave out the elements of XRP
    for (i = 1; i <= rows(M.urep); i++) {
        fput(fh, "XRP('" + M.urep[i, 1] + "', '" + (M.urep[i, 2] == "" ? "0" : M.urep[i, 2]) + "', '" +
             (M.urep[i, 3] == "" ? "0" : M.urep[i, 3]) + "') = 1;")
    }
    // the types of the elements (from version 0.18.0): GAMS declares integer
    // and binary variables as such, a whole variable at a time
    ity = _cge_int_type(M)
    for (k = 1; k <= M.nuv; k++) {
        kv = rows(M.vname) - M.nuv + k
        g = "U_" + M.vname[kv]
        dom = (M.vset[kv] == "" ? "" : (_cge_nidx(M.vset[kv]) == 2 ? "(AC, AC)" : "(AC)"))
        _cge_vlabels(M, kv, e1, e2)
        pos = _cge_vpos(M, kv)
        tys = ity[select(pos, M.exists[pos, 1])]
        vty = (rows(tys) ? max(tys) : 0)
        if (rows(tys)) if (min(tys) != vty) {
            _cge_fail("cge_gams: variable " + M.vname[kv] + " has elements of different types (integer, binary, continuous); GAMS declares a variable's type as a whole", 198)
        }
        fput(fh, (vty == 1 ? "integer variable " : (vty == 2 ? "binary variable " : "variable ")) + g + dom + ";")
        for (i = 1; i <= rows(pos); i++) {
            // elements outside a conditional domain do not exist (from
            // version 0.7.2): fixed at 0, as in Stata, where referred to
            if (!M.exists[pos[i]]) {
                fput(fh, g + ".fx" + _cge_gams_elem(e1[i], e2[i]) + " = 0;")
                continue
            }
            // an integer variable has no bounds but those of cge_bound
            if (vty == 1) fput(fh, g + ".lo" + _cge_gams_elem(e1[i], e2[i]) + " = -inf;  " + g + ".up" + _cge_gams_elem(e1[i], e2[i]) + " = inf;")
            // an exogenous user variable (from version 0.9.0)
            if (M.uvdef[k, 6] == "fixed") fput(fh, g + ".fx" + _cge_gams_elem(e1[i], e2[i]) + " = " + _cge_gnum(M.x0[pos[i]]) + ";")
            fput(fh, g + ".l" + _cge_gams_elem(e1[i], e2[i]) + " = " + _cge_gnum(M.x0[pos[i]]) + ";")
            fput(fh2, "put '%2', '" + M.vname[kv] + "', '" + e1[i] + "', '" + e2[i] + "', " + g + ".l" + _cge_gams_elem(e1[i], e2[i]) + " /;")
        }
    }
    if (rows(M.uelab)) {
        // A user equation that does not hold at the base acts as a shock: in
        // the base it holds with its gap at the base point, times UBASE, which
        // the scenario sets to 0 (from version 0.7.1), so that GAMS solves the
        // same base as Stata
        _cge_u_eval(M, M.p0, M.x0, ul, ur)
        fput(fh, "scalar UBASE " + char(34) + "1 in the base, where user equations hold with their base gaps" + char(34) + " / 1 /;")
        fput(fh, "equations " + invtokens(("UE" :+ strofreal((1::rows(M.uelab))))', ", ") + ";")
        for (k = 1; k <= rows(M.uelab); k++) {
            fput(fh, "* " + M.uelab[k])
            gap = ul[k] - ur[k]
            fput(fh, "UE" + strofreal(k) + "..  " + M.uegams[k, 1] + " =e= " + M.uegams[k, 2] +
                 (abs(gap) > 1e-12 * max((1, abs(ul[k]), abs(ur[k]))) ? " + (" + _cge_gnum(gap) + ") * UBASE" : "") + ";")
        }
    }
    fclose(fh)
    fclose(fh2)
}


// =====================================================================
// Policy optimisation (model_spec.md, Section 18; from version 0.6.0)
// =====================================================================

// Position of the last occurrence of character ch in s, 0 if none (Stata 13
// has no strrpos())
real scalar _cge_lastpos(string scalar s, string scalar ch)
{
    real scalar i
    for (i = strlen(s); i >= 1; i--) if (substr(s, i, 1) == ch) return(i)
    return(0)
}

// State of an optimisation while cge_optimize runs, kept outside the model:
// the instruments (kind 1 an element of a parameter, 2 a fixed variable),
// their positions, bounds, starting values and scales; the objective and
// targets (report keys); and the last solution, from which the next trial
// starts
struct cge_opt {
    real colvector   kind, pidx, lo, hi, start, scale
    string colvector pname, label
    string rowvector okey
    real scalar      sense, oscale, hasobj
    string matrix    tkeys
    real colvector   tval, tscale, lam
    real scalar      rho
    real colvector   xlast
    real scalar      nevals, nfail, tol, maxit
    // expressions of the user language as the objective, targets and
    // constraints (from version 0.9.4): the index of each expression, 0 for a
    // report measure; their postfix rows, stacked, and their text
    real scalar      oex
    real colvector   tex, estart, elen
    real matrix      etok
    string colvector etext
    // inequality constraints (from version 0.9.4): measure or expression,
    // relation (1 at most, -1 at least), value, scale and multiplier
    string matrix    ckeys
    real colvector   cex, ctype, cval, cscale, mu
    // right sides of targets and constraints that are expressions, 0 for a
    // number, and the text of each, as given (from version 0.9.4)
    real colvector   trex, crex
    string colvector ttext, ctext
    // derivatives (from version 0.15.0): 0 exact, by the implicit function
    // theorem, 1 differences of solved models
    real scalar      gmode
}

struct cge_opt scalar _cge_opt_load()
{
    pointer() scalar q
    q = findexternal("cge__opt")
    if (q == NULL) _cge_fail("cge internal error: no optimisation in progress", 3498)
    return(*q)
}

void _cge_opt_store(struct cge_opt scalar O)
{
    pointer() scalar q
    if ((q = findexternal("cge__opt")) == NULL) q = crexternal("cge__opt")
    *q = O
}

// The report measures of a point, with the welfare rows
void _cge_opt_rows(struct cge_model scalar M, struct cge_par scalar p, real colvector x, string matrix keys,
                   real colvector val)
{
    real colvector ev, cv
    real scalar h
    // a standalone model has no report measures (from version 0.13.0): its
    // objectives and targets are expressions
    if (_cge_sa(M)) {
        keys = J(0, 3, "")
        val = J(0, 1, .)
        return
    }
    _cge_measures(M, p, x, keys, val)
    ev = _cge_ev(M, p, x)
    cv = _cge_cv(M, p, x)
    for (h = 1; h <= M.nH; h++) {
        keys = keys \ ("welfare", "equivalent_variation", M.H[h]) \ ("welfare", "compensating_variation", M.H[h])
        val = val \ ev[h] \ cv[h]
    }
}

// An objective, target or constraint (from version 0.9.4): a report measure,
// table measure [element], or an expression of the user language, compiled
// into the postfix rows of O. Returns the index of the expression, 0 for a
// measure, whose key is then in key.
real scalar _cge_opt_parse(struct cge_model scalar M, struct cge_opt scalar O, string scalar spec, string scalar what,
                           string rowvector key, string colvector tables)
{
    string rowvector t
    real matrix tok
    string scalar g
    t = tokens(strtrim(spec))
    if (!cols(t)) _cge_fail(what + "(): give a report measure, as table measure [element], or an expression", 198)
    if (cols(t) >= 2 & cols(t) <= 3 & !regexm(spec, "[()+*/^]") & anyof(tables, t[1])) {
        key = (cols(t) == 2 ? (t, "") : t)
        return(0)
    }
    key = J(1, 3, "")
    tok = _cge_u_compile(M, _cge_u_written(M, M.p0, M.x0, _cge_u_tokens(strtrim(spec))), M.x0, g)
    if (rows(O.etok) == 0) O.etok = J(0, 3, .)
    O.estart = O.estart \ (rows(O.etok) + 1)
    O.elen = O.elen \ rows(tok)
    O.etok = O.etok \ tok
    O.etext = O.etext \ strtrim(spec)
    return(rows(O.estart))
}

// The value of an objective, target or constraint at a point (from version
// 0.9.4): its expression, or its report measure
real scalar _cge_opt_item(struct cge_model scalar M, struct cge_opt scalar O, struct cge_par scalar p,
                          real colvector x, string matrix keys, real colvector val, string rowvector key,
                          real scalar ex, real scalar fail)
{
    if (ex) return(_cge_u_value(M, p, x, O.etok[|O.estart[ex], 1 \ O.estart[ex] + O.elen[ex] - 1, 3|]))
    return(_cge_opt_lookup(keys, val, key, fail))
}

// The text of an objective (from version 0.9.4)
string scalar _cge_opt_text(struct cge_opt scalar O, string rowvector key, real scalar ex)
{
    return(ex ? O.etext[ex] : strtrim(invtokens(key)))
}

// The right side of a target or constraint at a point (from version 0.9.4):
// its value v, or its expression rx
real scalar _cge_opt_bound(struct cge_model scalar M, struct cge_opt scalar O, struct cge_par scalar p,
                           real colvector x, real scalar v, real scalar rx)
{
    if (rx) return(_cge_u_value(M, p, x, O.etok[|O.estart[rx], 1 \ O.estart[rx] + O.elen[rx] - 1, 3|]))
    return(v)
}

// The right side of a target or constraint (from version 0.9.4): a number,
// or an expression evaluated at each point. Returns the number (missing for
// an expression), the index of the expression (0 for a number) and the scale
// of the gap, from the number or from the expression at the base.
void _cge_opt_rhs(struct cge_model scalar M, struct cge_opt scalar O, string scalar rhs, string scalar what,
                  string colvector tables, string matrix keys, real colvector val, real scalar f, real scalar rx,
                  real scalar sc)
{
    string rowvector key
    f = strtoreal(rhs)
    rx = 0
    if (f < .) {
        sc = abs(f) * (abs(f) > 1e-12) + (abs(f) <= 1e-12)
        return
    }
    // in parentheses, so that it is read as an expression
    rx = _cge_opt_parse(M, O, "(" + rhs + ")", what, key, tables)
    sc = max((1, abs(_cge_opt_bound(M, O, M.p0, M.x0, ., rx))))
}

// The parts of a list separated by commas outside parentheses (from version
// 0.9.4)
string rowvector _cge_opt_parts(string scalar s)
{
    string rowvector out
    real scalar k, d, st
    out = J(1, 0, "")
    d = 0
    st = 1
    for (k = 1; k <= strlen(s); k++) {
        if (substr(s, k, 1) == "(") d++
        else if (substr(s, k, 1) == ")") d--
        else if (substr(s, k, 1) == "," & d == 0) {
            if (strtrim(substr(s, st, k - st)) != "") out = out, strtrim(substr(s, st, k - st))
            st = k + 1
        }
    }
    if (strtrim(substr(s, st, .)) != "") out = out, strtrim(substr(s, st, .))
    return(out)
}

// The relation of a target or constraint outside parentheses (from version
// 0.9.4): "=", "<=" or ">=" (=l= and =g= as in GAMS), with its two sides
string scalar _cge_opt_rel(string scalar s, string scalar lhs, string scalar rhs)
{
    real scalar k, d, w
    string scalar r
    d = 0
    for (k = 1; k <= strlen(s); k++) {
        if (substr(s, k, 1) == "(") d++
        else if (substr(s, k, 1) == ")") d--
        if (d) continue
        r = ""
        if (substr(s, k, 3) == "=l=" | substr(s, k, 3) == "=g=") {
            r = (substr(s, k, 3) == "=l=" ? "<=" : ">=")
            w = 3
        }
        else if (substr(s, k, 2) == "<=" | substr(s, k, 2) == ">=") {
            r = substr(s, k, 2)
            w = 2
        }
        else if (substr(s, k, 1) == "=" & substr(s, k + 1, 1) != "=" & !(k > 1 & strpos("=<>!", substr(s, k - 1, 1)))) {
            r = "="
            w = 1
        }
        if (r != "") {
            lhs = strtrim(substr(s, 1, k - 1))
            rhs = strtrim(substr(s, k + w, .))
            return(r)
        }
    }
    lhs = strtrim(s)
    rhs = ""
    return("")
}

// The value of report measure key (table, measure, element)
real scalar _cge_opt_lookup(string matrix keys, real colvector val, string rowvector key, real scalar fail)
{
    real colvector k
    k = selectindex((keys[., 1] :== key[1]) :& (keys[., 2] :== key[2]) :& (keys[., 3] :== key[3]))
    if (!length(k)) {
        if (fail) _cge_fail("no report measure " + invtokens(key) + "; see cge_report for the measures", 111)
        return(.)
    }
    return(val[k[1]])
}

// Parameters and fixed values with the instruments at the given values
void _cge_opt_apply(struct cge_model scalar M, struct cge_opt scalar O, real colvector values,
                    struct cge_par scalar p, real colvector xfix)
{
    p = M.p
    xfix = M.xcur
    _cge_opt_set(O, values, p, xfix)
}

// The instruments at the given values set into parameters p and fixed values
// xfix (from version 0.15.0 a function of its own)
void _cge_opt_set(struct cge_opt scalar O, real colvector values, struct cge_par scalar p, real colvector xfix)
{
    real matrix v
    real scalar k
    for (k = 1; k <= rows(values); k++) {
        if (O.kind[k] == 1) {
            v = _cge_par_get(p, O.pname[k])
            v[O.pidx[k]] = values[k]
            _cge_par_set(p, O.pname[k], v)
        }
        // an element of a user parameter (from version 0.7.1)
        else if (O.kind[k] == 3) p.upval[O.pidx[k]] = values[k]
        else xfix[O.pidx[k]] = values[k]
    }
}

// Instruments from the scaled parameters z of the optimiser: start + scale z
real colvector _cge_opt_values(struct cge_opt scalar O, real colvector z)
{
    return(O.start + O.scale :* z)
}

real colvector _cge_opt_z(struct cge_opt scalar O, real colvector v)
{
    return((v - O.start) :/ O.scale)
}

// The bounds of the scaled parameters (+-1e300 where none is given)
void _cge_opt_box(struct cge_opt scalar O, real colvector lo, real colvector hi)
{
    real scalar k
    // element by element: in Mata 0 * missing is missing
    lo = J(rows(O.start), 1, -1e300)
    hi = J(rows(O.start), 1, 1e300)
    for (k = 1; k <= rows(O.start); k++) {
        if (O.lo[k] < .) lo[k] = (O.lo[k] - O.start[k]) / O.scale[k]
        if (O.hi[k] < .) hi[k] = (O.hi[k] - O.start[k]) / O.scale[k]
    }
}

// Solves the model at instrument values v; returns the objective (scaled,
// missing without one) and the target residuals r (scaled)
real scalar _cge_opt_solve(real colvector v, real colvector r, real colvector x)
{
    struct cge_par scalar p
    real colvector xfix
    return(_cge_opt_solvep(v, r, x, p, xfix))
}

// The solve of _cge_opt_solve, with the parameters p, the regimes of any
// constraints included, and the fixed values xfix of the solution (from
// version 0.15.0)
real scalar _cge_opt_solvep(real colvector v, real colvector r, real colvector x, struct cge_par scalar p,
                            real colvector xfix)
{
    struct cge_opt scalar O
    pointer() scalar q
    real scalar conv, iter, err
    string scalar method
    q = findexternal("cge__model")
    O = _cge_opt_load()
    _cge_opt_apply(*q, O, v, p, xfix)
    // Each solve starts from the last solution: Newton's method without
    // Broyden's updates (mode 3), whose steps leave the solution far inside
    // the tolerance, so that it varies smoothly with the instruments
    x = _cge_solve_point(*q, p, xfix, O.xlast, O.tol, O.maxit, 0, conv, iter, err, method, 0, 3)
    O.nevals = O.nevals + 1
    if (!conv) {
        // a failed trial starts the next one from the last solution
        O.nfail = O.nfail + 1
        _cge_opt_store(O)
        r = J(rows(O.tval), 1, .)
        return(.)
    }
    O.xlast = x
    _cge_opt_store(O)
    return(_cge_opt_eval(*q, O, p, x, r))
}

// The objective (scaled, with its sense; missing without one) and the
// residuals r of the targets and the slacks of the constraints (scaled) at
// the point (p, x), as the solve finds them (from version 0.15.0 a function
// of its own, for derivatives along the tangent of the solution); a slack is
// not negative where its constraint holds
real scalar _cge_opt_eval(struct cge_model scalar M, struct cge_opt scalar O, struct cge_par scalar p,
                          real colvector x, real colvector r)
{
    real colvector val
    string matrix keys
    real scalar k
    _cge_opt_rows(M, p, x, keys, val)
    r = J(rows(O.tval) + rows(O.cval), 1, .)
    for (k = 1; k <= rows(O.tval); k++) {
        r[k] = (_cge_opt_item(M, O, p, x, keys, val, O.tkeys[k, .], O.tex[k], 0) -
                _cge_opt_bound(M, O, p, x, O.tval[k], O.trex[k])) / O.tscale[k]
    }
    for (k = 1; k <= rows(O.cval); k++) {
        r[rows(O.tval) + k] = -O.ctype[k] * (_cge_opt_item(M, O, p, x, keys, val, O.ckeys[k, .], O.cex[k], 0) -
                                             _cge_opt_bound(M, O, p, x, O.cval[k], O.crex[k])) / O.cscale[k]
    }
    return(O.hasobj ? O.sense * _cge_opt_item(M, O, p, x, keys, val, O.okey, O.oex, 0) / O.oscale : .)
}

// The derivatives of the objective (g) and of the residuals of the targets
// and constraints (Jr) with respect to the scaled instruments, at the
// solution x of the model at instruments v, with its parameters p and fixed
// values xfix (from version 0.15.0). By the implicit function theorem the
// solution moves with instrument k along dx/du_k = -J^-1 dF/du_k, with J the
// exact Jacobian of the system solved, factorised once, and dF/du_k the
// derivative of its residuals at x, by central differences of the residuals,
// which need no solve; the derivative of the objective and residuals along
// that tangent comes from central differences of their values on it, which
// need no solve either. Returns 0 where they cannot be found.
real scalar _cge_opt_grad(struct cge_model scalar M, struct cge_opt scalar O, real colvector v, struct cge_par scalar p,
                          real colvector xfix, real colvector x, real colvector g, real matrix Jr)
{
    struct cge_sys scalar S
    struct cge_slu scalar SF
    struct cge_par scalar pp, pm
    real colvector zx, jr, jc, jv, b, dz, dx, xp, xm, xfp, xfm, rp, rm, perm, vp, vm
    real matrix LU, U
    real scalar n, k, h, tt, fp, fm, sp, nr
    n = rows(v)
    S = _cge_sys_make(M, 1)
    if (rows(S.free) != S.neq) return(0)
    zx = x[S.free] :/ M.xscale[S.free]
    if (!_cge_jac_trip(M, p, xfix, S, zx, jr, jc, jv)) return(0)
    sp = _cge_sparse_on(M, S)
    if (sp) {
        _cge_slu_load(SF)
        if (!_cge_slu_update(SF, jr, jc, jv, rows(zx))) return(0)
    }
    else {
        LU = _cge_trip_dense(jr, jc, jv, S.neq, rows(zx))
        _lud(LU, U, perm)
        perm = invorder(perm)
    }
    nr = rows(O.tval) + rows(O.cval)
    g = J(n, 1, 0)
    Jr = J(nr, n, 0)
    for (k = 1; k <= n; k++) {
        // the derivative of the system's residuals with respect to u_k, at x
        h = 1e-6 * max((1, abs(v[k])))
        vp = vm = v
        vp[k] = v[k] + h
        vm[k] = v[k] - h
        pp = p
        pm = p
        xfp = xfm = xfix
        _cge_opt_set(O, vp, pp, xfp)
        _cge_opt_set(O, vm, pm, xfm)
        b = (_cge_F(M, pp, xfp, S, zx) - _cge_F(M, pm, xfm, S, zx)) / (2 * h)
        if (hasmissing(b)) return(0)
        if (sp) dz = _cge_slu_solve(SF, -b)
        else dz = solveupper(U, solvelower(LU, -b[perm]))
        if (hasmissing(dz)) return(0)
        dx = dz :* M.xscale[S.free]
        // the objective and the residuals along the tangent (dx/du_k, 1)
        tt = 1e-5 * max((1, abs(v[k])))
        vp = vm = v
        vp[k] = v[k] + tt
        vm[k] = v[k] - tt
        pp = p
        pm = p
        xfp = xfm = xfix
        _cge_opt_set(O, vp, pp, xfp)
        _cge_opt_set(O, vm, pm, xfm)
        xp = xfp
        xm = xfm
        xp[S.free] = x[S.free] + tt :* dx
        xm[S.free] = x[S.free] - tt :* dx
        if (S.reduced) {
            _cge_derive(M, pp, xp)
            _cge_derive(M, pm, xm)
        }
        fp = _cge_opt_eval(M, O, pp, xp, rp)
        fm = _cge_opt_eval(M, O, pm, xm, rm)
        if (O.hasobj) {
            if (fp >= . | fm >= .) return(0)
            g[k] = O.scale[k] * (fp - fm) / (2 * tt)
        }
        if (nr) {
            if (hasmissing(rp) | hasmissing(rm)) return(0)
            Jr[., k] = O.scale[k] :* (rp - rm) :/ (2 * tt)
        }
    }
    return(1)
}

// The model solved at the scaled instruments z, with the objective f, the
// residuals r and their exact derivatives g and Jr (from version 0.15.0);
// 0 if the model does not solve or the derivatives cannot be found
real scalar _cge_opt_point(struct cge_opt scalar O, real colvector z, real scalar f, real colvector r,
                           real colvector g, real matrix Jr)
{
    struct cge_opt scalar Q
    struct cge_par scalar p
    pointer() scalar q
    real colvector v, x, xfix
    q = findexternal("cge__model")
    v = _cge_opt_values(O, z)
    f = _cge_opt_solvep(v, r, x, p, xfix)
    if (hasmissing(r) | (O.hasobj & f >= .)) return(0)
    Q = _cge_opt_load()
    return(_cge_opt_grad(*q, Q, v, p, xfix, x, g, Jr))
}

// The augmented objective of _cge_opt_aug at z and its exact gradient ga
// (from version 0.15.0); missing if the model does not solve
real scalar _cge_opt_augg(struct cge_opt scalar O, real colvector z, real colvector ga)
{
    struct cge_opt scalar Q
    real colvector r, g, re, s, m
    real matrix Jr
    real scalar f, nt, nc
    if (!_cge_opt_point(O, z, f, r, g, Jr)) return(.)
    Q = _cge_opt_load()
    nt = rows(Q.tval)
    nc = rows(Q.cval)
    ga = g
    if (nt) {
        re = r[|1 \ nt|]
        f = f - (Q.lam' * re + 0.5 * Q.rho * (re' * re))
        ga = ga - Jr[|1, 1 \ nt, cols(Jr)|]' * (Q.lam + Q.rho :* re)
    }
    if (nc) {
        s = r[|nt + 1 \ nt + nc|]
        m = rowmax((J(nc, 1, 0), Q.mu - Q.rho :* s))
        f = f - sum(m :^ 2 - Q.mu :^ 2) / (2 * Q.rho)
        ga = ga + Jr[|nt + 1, 1 \ nt + nc, cols(Jr)|]' * m
    }
    return(f)
}

// Targets alone (Section 18): Newton's method on the scaled residuals, with
// the exact Jacobian of _cge_opt_grad (from version 0.15.0) or, with
// gradient(differences), central differences of solved models; steps halved
// until the residuals fall
real colvector _cge_opt_newton(struct cge_opt scalar O, real colvector z0, real scalar trace, real scalar conv,
                               real scalar iter)
{
    real colvector z, r, rt, zt, dz, lo, hi, g
    real matrix Jm
    real scalar it, nr, lam, ls, f
    if (O.gmode == 1) return(_cge_opt_newton_fd(O, z0, trace, conv, iter))
    _cge_opt_box(O, lo, hi)
    z = z0
    conv = 0
    iter = 0
    if (!_cge_opt_point(O, z, f, r, g, Jm)) return(z)
    for (it = 1; it <= 50; it++) {
        nr = max(abs(r))
        if (trace) printf("{txt}Newton iteration %f: largest scaled target gap {res}%9.3e\n", it - 1, nr)
        if (nr < 1e-11) {
            conv = 1
            return(z)
        }
        iter = it
        dz = -lusolve(Jm, r)
        if (hasmissing(dz)) return(z)
        lam = 1
        for (ls = 1; ls <= 30; ls++) {
            zt = rowmax((rowmin((z + lam * dz, hi)), lo))
            if (_cge_opt_point(O, zt, f, rt, g, Jm)) {
                if (max(abs(rt)) < nr) break
            }
            // below 1e-9 the gap is at the precision of the solves: the
            // exact step is so small that the trial's solve, from the solution
            // before, already meets its tolerance, and a shorter one cannot help
            if (nr < 1e-9) {
                conv = 1
                return(z)
            }
            lam = lam / 2
        }
        if (ls > 30) return(z)
        z = zt
        r = rt
    }
    return(z)
}

// The method of _cge_opt_newton with central differences of solved models
// (gradient(differences); before version 0.15.0, the only one)
real colvector _cge_opt_newton_fd(struct cge_opt scalar O, real colvector z0, real scalar trace, real scalar conv,
                                  real scalar iter)
{
    real colvector z, r, rp, rm, rt, zt, dz, x, lo, hi
    real matrix Jm
    real scalar n, it, k, h, nr, lam, ls
    _cge_opt_box(O, lo, hi)
    z = z0
    n = rows(z)
    conv = 0
    iter = 0
    (void) _cge_opt_solve(_cge_opt_values(O, z), r, x)
    for (it = 1; it <= 50; it++) {
        if (hasmissing(r)) return(z)
        nr = max(abs(r))
        if (trace) printf("{txt}Newton iteration %f: largest scaled target gap {res}%9.3e\n", it - 1, nr)
        if (nr < 1e-11) {
            conv = 1
            return(z)
        }
        iter = it
        Jm = J(n, n, .)
        for (k = 1; k <= n; k++) {
            h = 1e-5 * max((1, abs(z[k])))
            zt = z
            zt[k] = z[k] + h
            (void) _cge_opt_solve(_cge_opt_values(O, zt), rp, x)
            zt[k] = z[k] - h
            (void) _cge_opt_solve(_cge_opt_values(O, zt), rm, x)
            if (hasmissing(rp) | hasmissing(rm)) return(z)
            Jm[., k] = (rp - rm) / (2 * h)
        }
        dz = -lusolve(Jm, r)
        if (hasmissing(dz)) return(z)
        lam = 1
        for (ls = 1; ls <= 30; ls++) {
            zt = rowmax((rowmin((z + lam * dz, hi)), lo))
            (void) _cge_opt_solve(_cge_opt_values(O, zt), rt, x)
            if (!hasmissing(rt)) {
                if (max(abs(rt)) < nr) break
            }
            lam = lam / 2
        }
        if (ls > 30) return(z)
        z = zt
        r = rt
    }
    return(z)
}

// The augmented objective at z (instruments start + scale z): the objective
// less lam'r + rho/2 r'r for the targets; missing if the model does not solve
real scalar _cge_opt_aug(struct cge_opt scalar O, real colvector z)
{
    struct cge_opt scalar Q
    real colvector r, x, re, s
    real scalar f, nt
    f = _cge_opt_solve(O.start + O.scale :* z, r, x)
    if (f >= . | hasmissing(r)) return(.)
    Q = _cge_opt_load()
    nt = rows(Q.tval)
    if (nt) {
        re = r[|1 \ nt|]
        f = f - (Q.lam' * re + 0.5 * Q.rho * (re' * re))
    }
    // constraints (from version 0.9.4): the term of Powell, Hestenes and
    // Rockafellar for each slack s >= 0, with multiplier mu
    if (rows(Q.cval)) {
        s = r[|nt + 1 \ rows(r)|]
        f = f - sum(rowmax((J(rows(s), 1, 0), Q.mu - Q.rho :* s)) :^ 2 - Q.mu :^ 2) / (2 * Q.rho)
    }
    return(f)
}

// Maximises the augmented objective within the bounds by Newton's method
// (from version 0.15.0): the exact gradient; the Hessian of the free
// coordinates from central differences of the gradient of the Lagrangian,
// f - lt'r + m's with the multipliers lt = lam + rho r and m = max(0, mu -
// rho s) held at their values, and the penalty's part, -rho J'J over the
// targets and the constraints that bind, from the exact Jacobian of their
// residuals; coordinates held at a bound whose gradient points outwards, and
// steps projected on the bounds and halved until the objective rises; with
// gradient(differences), the method of _cge_opt_max_fd
real colvector _cge_opt_max(struct cge_opt scalar O, real colvector z0, real scalar trace, real scalar conv,
                            real scalar iter)
{
    struct cge_opt scalar Q
    real colvector z, zt, g, gp, gm, gt, r, rp, rm, ga, d, lo, hi, fr, frt, fi, e, lt, m, act, s, re
    real matrix H, Jr, Jp, Jm, Jt, Jc
    real scalar n, it, i, f, fa, ft, hh, lam, ls, gn, ok, nt, nc, fp, fm, nw
    if (O.gmode == 1) return(_cge_opt_max_fd(O, z0, trace, conv, iter))
    n = rows(z0)
    _cge_opt_box(O, lo, hi)
    z = z0
    conv = 0
    iter = 0
    hh = 1e-4
    for (it = 1; it <= 100; it++) {
        if (!_cge_opt_point(O, z, f, r, g, Jr)) return(z)
        Q = _cge_opt_load()
        nt = rows(Q.tval)
        nc = rows(Q.cval)
        // the augmented objective, its gradient and the multipliers
        fa = f
        ga = g
        lt = m = act = J(0, 1, .)
        if (nt) {
            re = r[|1 \ nt|]
            Jt = Jr[|1, 1 \ nt, n|]
            lt = Q.lam + Q.rho :* re
            fa = fa - (Q.lam' * re + 0.5 * Q.rho * (re' * re))
            ga = ga - Jt' * lt
        }
        if (nc) {
            s = r[|nt + 1 \ nt + nc|]
            Jc = Jr[|nt + 1, 1 \ nt + nc, n|]
            m = rowmax((J(nc, 1, 0), Q.mu - Q.rho :* s))
            act = (Q.mu - Q.rho :* s :> 0)
            fa = fa - sum(m :^ 2 - Q.mu :^ 2) / (2 * Q.rho)
            ga = ga + Jc' * m
        }
        // coordinates at a bound whose gradient points outwards are held
        fr = !((z :<= lo :+ 1e-12) :& (ga :< 0)) :& !((z :>= hi :- 1e-12) :& (ga :> 0))
        gn = max(abs(fr :* ga))
        if (trace) printf("{txt}Iteration %f: objective {res}%14.10g{txt}, largest free gradient {res}%9.3e\n", it - 1, fa, gn)
        // the exact gradient allows a tighter test than differences of solves;
        // with targets or active constraints the outer rounds set the
        // accuracy, while constraints that do not bind leave the objective as
        // it is
        if (gn < (nt | (nc ? any(act) : 0) ? 1e-8 : 1e-10)) {
            conv = 1
            return(z)
        }
        iter = it
        fi = _cge_which(fr)
        H = J(rows(fi), rows(fi), .)
        ok = 1
        for (i = 1; i <= rows(fi); i++) {
            e = J(n, 1, 0)
            e[fi[i]] = hh
            if (!_cge_opt_point(O, z + e, fp, rp, gp, Jp) | !_cge_opt_point(O, z - e, fm, rm, gm, Jm)) {
                ok = 0
                break
            }
            if (nt) {
                gp = gp - Jp[|1, 1 \ nt, n|]' * lt
                gm = gm - Jm[|1, 1 \ nt, n|]' * lt
            }
            if (nc) {
                gp = gp + Jp[|nt + 1, 1 \ nt + nc, n|]' * m
                gm = gm + Jm[|nt + 1, 1 \ nt + nc, n|]' * m
            }
            H[., i] = (gp[fi] - gm[fi]) / (2 * hh)
        }
        d = J(n, 1, 0)
        if (ok & !hasmissing(H)) {
            H = (H + H') / 2
            if (nt) H = H - Q.rho :* (Jt[., fi]' * Jt[., fi])
            if (nc) if (any(act)) H = H - Q.rho :* (select(Jc[., fi], act)' * select(Jc[., fi], act))
        }
        // Newton step where the Hessian is negative definite; otherwise a
        // step along the gradient
        nw = 0
        if (!ok | hasmissing(H)) d[fi] = ga[fi] / max((1, max(abs(ga[fi]))))
        else if (max(symeigenvalues(H)) >= 0) d[fi] = ga[fi] / max((1, max(abs(ga[fi]))))
        else {
            d[fi] = -lusolve(H, ga[fi])
            nw = 1
        }
        // near the optimum the objective cannot rise measurably: a Newton step
        // whose predicted rise is below rounding is taken if it reduces the
        // largest free gradient
        if (nw & abs(ga[fi]' * d[fi]) <= 1e-12 * max((1, abs(fa)))) {
            zt = rowmax((rowmin((z + d, hi)), lo))
            if (_cge_opt_augg(O, zt, gt) < .) {
                frt = !((zt :<= lo :+ 1e-12) :& (gt :< 0)) :& !((zt :>= hi :- 1e-12) :& (gt :> 0))
                if (max(abs(frt :* gt)) < gn) {
                    z = zt
                    continue
                }
            }
        }
        lam = 1
        for (ls = 1; ls <= 40; ls++) {
            zt = z + lam * d
            zt = rowmax((rowmin((zt, hi)), lo))
            ft = _cge_opt_aug(O, zt)
            // a rise must exceed rounding (from version 0.20.0): near a flat
            // optimum, rises of rounding size moved the point without end
            if (ft < . & ft > fa + 1e-14 * max((1, abs(fa)))) break
            lam = lam / 2
        }
        if (ls > 40) {
            // no rise along the step: the gradient decides
            conv = (gn < 1e-6)
            return(z)
        }
        if (max(abs(zt - z)) < 1e-13) {
            conv = 1
            return(zt)
        }
        z = zt
    }
    return(z)
}

// The method of _cge_opt_max with central differences of solved models
// (gradient(differences); before version 0.15.0, the only one)
real colvector _cge_opt_max_fd(struct cge_opt scalar O, real colvector z0, real scalar trace, real scalar conv,
                               real scalar iter)
{
    real colvector z, zt, g, d, lo, hi, fr, fi, e
    real matrix H, Hf
    real scalar n, it, i, j, f, ft, hg, hh, lam, ls, gn, a, b, c, dd
    n = rows(z0)
    _cge_opt_box(O, lo, hi)
    z = z0
    conv = 0
    iter = 0
    f = _cge_opt_aug(O, z)
    if (f >= .) return(z)
    hg = 1e-5
    hh = 1e-3
    for (it = 1; it <= 100; it++) {
        // gradient: central differences, one-sided at a bound
        g = J(n, 1, .)
        for (i = 1; i <= n; i++) {
            e = J(n, 1, 0)
            e[i] = hg
            a = (z[i] + hg <= hi[i] ? _cge_opt_aug(O, z + e) : .)
            b = (z[i] - hg >= lo[i] ? _cge_opt_aug(O, z - e) : .)
            if (a < . & b < .) g[i] = (a - b) / (2 * hg)
            else if (a < .) g[i] = (a - f) / hg
            else if (b < .) g[i] = (f - b) / hg
            else return(z)
        }
        // coordinates at a bound whose gradient points outwards are held
        fr = !((z :<= lo :+ 1e-12) :& (g :< 0)) :& !((z :>= hi :- 1e-12) :& (g :> 0))
        gn = max(abs(fr :* g))
        if (trace) printf("{txt}Iteration %f: objective {res}%14.10g{txt}, largest free gradient {res}%9.3e\n", it - 1, f, gn)
        if (gn < 1e-8) {
            conv = 1
            return(z)
        }
        iter = it
        fi = _cge_which(fr)
        // Hessian of the free coordinates, from central second differences
        H = J(rows(fi), rows(fi), 0)
        for (i = 1; i <= rows(fi); i++) {
            for (j = i; j <= rows(fi); j++) {
                e = J(n, 1, 0)
                if (i == j) {
                    e[fi[i]] = hh
                    a = _cge_opt_aug(O, z + e)
                    b = _cge_opt_aug(O, z - e)
                    H[i, i] = (a - 2 * f + b) / hh^2
                }
                else {
                    e[fi[i]] = hh
                    e[fi[j]] = hh
                    a = _cge_opt_aug(O, z + e)
                    b = _cge_opt_aug(O, z - e)
                    e[fi[j]] = -hh
                    c = _cge_opt_aug(O, z + e)
                    dd = _cge_opt_aug(O, z - e)
                    H[i, j] = (a + b - c - dd) / (4 * hh^2)
                    H[j, i] = H[i, j]
                }
            }
        }
        // Newton step where the Hessian is negative definite; otherwise a
        // step along the gradient
        d = J(n, 1, 0)
        Hf = H
        if (hasmissing(Hf) | max(symeigenvalues(Hf)) >= 0) d[fi] = g[fi] / max((1, max(abs(g[fi]))))
        else d[fi] = -lusolve(Hf, g[fi])
        lam = 1
        for (ls = 1; ls <= 40; ls++) {
            zt = z + lam * d
            zt = rowmax((rowmin((zt, hi)), lo))
            ft = _cge_opt_aug(O, zt)
            if (ft < . & ft > f) break
            lam = lam / 2
        }
        if (ls > 40) {
            // no rise along the step: the point is as good as differences allow
            conv = (gn < 1e-6)
            return(z)
        }
        if (max(abs(zt - z)) < 1e-12) {
            conv = 1
            return(zt)
        }
        z = zt
        f = ft
    }
    return(z)
}

// The reduced cost of each instrument at z (from version 0.9.8): the
// derivative of the augmented Lagrangian, which at the optimum is the
// Lagrangian's, in units of the objective per unit of the instrument; central
// differences, one-sided at a bound
real colvector _cge_opt_redcost(struct cge_opt scalar O, real colvector z)
{
    real colvector g, e, lo, hi
    real scalar n, i, a, b, f, h
    // the exact gradient (from version 0.15.0)
    if (O.gmode != 1) {
        if (_cge_opt_augg(O, z, g) < .) return(O.sense * O.oscale :* g :/ O.scale)
    }
    n = rows(z)
    _cge_opt_box(O, lo, hi)
    h = 1e-5
    f = _cge_opt_aug(O, z)
    g = J(n, 1, .)
    for (i = 1; i <= n; i++) {
        e = J(n, 1, 0)
        e[i] = h
        a = (z[i] + h <= hi[i] ? _cge_opt_aug(O, z + e) : .)
        b = (z[i] - h >= lo[i] ? _cge_opt_aug(O, z - e) : .)
        if (a < . & b < .) g[i] = (a - b) / (2 * h)
        else if (a < .) g[i] = (a - f) / h
        else if (b < .) g[i] = (f - b) / h
    }
    return(O.sense * O.oscale :* g :/ O.scale)
}

// An instrument: a parameter that cge_shock changes (one element), or an
// element of a variable the closure fixes, as name or name(element)
void _cge_opt_instrument(struct cge_model scalar M, string scalar spec, real scalar kind, string scalar pname,
                         real scalar pidx, real scalar start)
{
    string matrix P
    string colvector lab
    string scalar nm, el
    real matrix v
    real scalar k, i
    nm = spec
    el = ""
    if (strpos(spec, "(")) {
        nm = substr(spec, 1, strpos(spec, "(") - 1)
        el = subinstr(substr(spec, strpos(spec, "(") + 1, .), ")", "")
    }
    if (_cge_vidx(M, nm)) {
        kind = 2
        pname = nm
        pidx = _cge_specpos(M, spec, "instrument")
        if (!M.fixed[pidx]) _cge_fail("instrument " + spec + " is not fixed under the closure: swap it in with cge_closure, swap()", 459)
        start = M.xcur[pidx]
        return
    }
    // a user parameter (from version 0.7.1): one element
    k = _cge_up_find(M, nm)
    if (k) {
        kind = 3
        pname = nm
        if (el == "" & M.updef[k, 2] != "") _cge_fail("instrument " + spec + ": give one element of " + nm, 198)
        v = _cge_up_elements(M, k, subinstr(el, ",", "."))
        if (rows(v) != 1) _cge_fail("instrument " + spec + ": give one element of " + nm, 198)
        pidx = v[1]
        start = M.p.upval[pidx]
        return
    }
    P = _cge_gams_params()
    k = _cge_find(P[., 1], nm)
    if (!k) _cge_fail("instrument " + spec + ": not a parameter that cge_shock changes, a user parameter or a model variable", 198)
    kind = 1
    pname = nm
    v = _cge_par_get(M.p, nm)
    if (P[k, 3] == "") {
        if (el != "") _cge_fail("instrument " + spec + ": " + nm + " has no elements", 198)
        pidx = 1
    }
    else {
        lab = _cge_gams_setlabels(M, P[k, 3])
        if (el == "") {
            if (rows(lab) != 1) _cge_fail("instrument " + spec + ": give one element, as " + nm + "(" + lab[1] + ")", 198)
            pidx = 1
        }
        else {
            i = _cge_find(lab, el)
            if (!i) _cge_fail("instrument " + spec + ": " + el + " is not an element of " + nm, 111)
            pidx = i
        }
    }
    start = v[pidx]
}

// A report key from "table measure [element]"
string rowvector _cge_opt_key(string scalar spec, string scalar what)
{
    string rowvector t
    t = tokens(spec)
    if (cols(t) < 2 | cols(t) > 3) _cge_fail(what + "(): give a report measure as table measure [element], for example welfare equivalent_variation hhd", 198)
    return(cols(t) == 2 ? (t, "") : t)
}

void _cge_optimize(string scalar s_ins, string scalar s_max, string scalar s_min, string scalar s_tar,
                   string scalar s_lo, string scalar s_up, string scalar name, real scalar tol, real scalar maxit,
                   real scalar trace, | string scalar s_con, string scalar s_grad)
{
    struct cge_model scalar M
    struct cge_opt scalar O
    string rowvector ins, parts, tok, key
    string colvector tables
    string matrix keys
    string scalar spec, rel, lhs, rhs
    real colvector z, v, r, x, val, v0, r0, re, s, cv
    real colvector tsc, csc, tv, cb, tmg, cmg, img
    real scalar n, k, i, j, f, f0, conv, outer, rprev, iter, conv2, kd, pi, st, it2, nt, nc, viol, ex, rx, sc, ms, ss
    string scalar pn
    if (args() < 11) s_con = ""
    if (args() < 12) s_grad = ""

    M = _cge_load()
    _cge_need(M, "calibrated")
    ins = tokens(s_ins)
    n = cols(ins)
    if (!n) _cge_fail("give the instruments in instruments()", 198)
    O.kind = J(n, 1, .)
    O.pidx = J(n, 1, .)
    O.start = J(n, 1, .)
    O.pname = J(n, 1, "")
    O.label = ins'
    for (k = 1; k <= n; k++) {
        // outputs into scalars: Mata passes a subscripted element as a copy
        _cge_opt_instrument(M, ins[k], kd, pn, pi, st)
        O.kind[k] = kd
        O.pname[k] = pn
        O.pidx[k] = pi
        O.start[k] = st
        for (j = 1; j < k; j++) if (O.kind[j] == O.kind[k] & O.pname[j] == O.pname[k] & O.pidx[j] == O.pidx[k]) {
            _cge_fail("instrument " + ins[k] + " is given twice", 198)
        }
    }
    O.scale = abs(O.start) :* (abs(O.start) :> 1e-12) + (abs(O.start) :<= 1e-12)
    // Bounds: instrument:value pairs
    O.lo = J(n, 1, .)
    O.hi = J(n, 1, .)
    for (i = 1; i <= 2; i++) {
        tok = tokens(i == 1 ? s_lo : s_up)
        for (k = 1; k <= cols(tok); k++) {
            j = _cge_lastpos(tok[k], ":")
            if (!j) _cge_fail((i == 1 ? "lower" : "upper") + "(): give instrument:value pairs", 198)
            spec = substr(tok[k], 1, j - 1)
            f = strtoreal(substr(tok[k], j + 1, .))
            j = _cge_find(O.label, spec)
            if (!j | f >= .) _cge_fail((i == 1 ? "lower" : "upper") + "(): " + tok[k] + " does not name an instrument and a value", 198)
            if (i == 1) O.lo[j] = f
            else O.hi[j] = f
        }
    }
    if (any((O.lo :< .) :& (O.hi :< .) :& (O.lo :>= O.hi))) _cge_fail("an instrument's lower bound is not below its upper bound", 198)
    if (any(((O.lo :< .) :& (O.start :<= O.lo)) :| ((O.hi :< .) :& (O.start :>= O.hi)))) {
        _cge_fail("the starting value of each instrument, its current value, must lie strictly within its bounds", 459)
    }
    // Objective, targets and constraints: report measures or, from version
    // 0.9.4, expressions of the user language
    if (s_max != "" & s_min != "") _cge_fail("give maximize() or minimize(), not both", 198)
    _cge_opt_rows(M, M.p, M.x0, keys, val)
    tables = uniqrows(keys[., 1])
    O.estart = O.elen = J(0, 1, .)
    O.etok = J(0, 3, .)
    O.etext = J(0, 1, "")
    O.hasobj = (s_max != "" | s_min != "")
    O.sense = (s_min != "" ? -1 : 1)
    O.okey = J(1, 3, "")
    O.oex = 0
    if (O.hasobj) {
        O.oex = _cge_opt_parse(M, O, (s_max != "" ? s_max : s_min), (s_max != "" ? "maximize" : "minimize"), key, tables)
        O.okey = key
    }
    // a target or constraint: a measure or an expression, related to a
    // number or an expression
    O.tkeys = J(0, 3, "")
    O.tval = O.tex = O.trex = tsc = J(0, 1, .)
    O.ttext = J(0, 1, "")
    parts = _cge_opt_parts(s_tar)
    for (k = 1; k <= cols(parts); k++) {
        rel = _cge_opt_rel(parts[k], lhs, rhs)
        if (rel != "=" | lhs == "" | rhs == "") _cge_fail("targets(): give a measure or an expression = a value, separated by commas", 198)
        ex = _cge_opt_parse(M, O, lhs, "targets", key, tables)
        _cge_opt_rhs(M, O, rhs, "targets", tables, keys, val, f, rx, sc)
        O.tkeys = O.tkeys \ key
        O.tex = O.tex \ ex
        O.tval = O.tval \ f
        O.trex = O.trex \ rx
        O.ttext = O.ttext \ (lhs + " = " + rhs)
        tsc = tsc \ sc
    }
    O.ckeys = J(0, 3, "")
    O.cval = O.cex = O.ctype = O.crex = csc = J(0, 1, .)
    O.ctext = J(0, 1, "")
    parts = _cge_opt_parts(s_con)
    for (k = 1; k <= cols(parts); k++) {
        rel = _cge_opt_rel(parts[k], lhs, rhs)
        if ((rel != "<=" & rel != ">=") | lhs == "" | rhs == "") {
            _cge_fail("constraints(): give a measure or an expression <= or >= a value, separated by commas", 198)
        }
        ex = _cge_opt_parse(M, O, lhs, "constraints", key, tables)
        _cge_opt_rhs(M, O, rhs, "constraints", tables, keys, val, f, rx, sc)
        O.ckeys = O.ckeys \ key
        O.cex = O.cex \ ex
        O.ctype = O.ctype \ (rel == "<=" ? 1 : -1)
        O.cval = O.cval \ f
        O.crex = O.crex \ rx
        O.ctext = O.ctext \ (lhs + " " + rel + " " + rhs)
        csc = csc \ sc
    }
    if (rows(O.cval) & !O.hasobj) _cge_fail("constraints() need an objective, maximize() or minimize()", 198)
    if (!O.hasobj & rows(O.tval) != n) _cge_fail("without an objective, give one target for each instrument", 198)
    if (!O.hasobj & rows(O.tval) == 0) _cge_fail("give maximize(), minimize() or targets()", 198)
    O.tscale = tsc
    O.cscale = csc
    O.lam = J(rows(O.tval), 1, 0)
    O.mu = J(rows(O.cval), 1, 0)
    O.rho = 0
    // expressions may add parameters to the model's list (M.upar), which the
    // solves use
    _cge_store(M)
    O.tol = tol
    O.maxit = maxit
    O.nevals = 0
    O.nfail = 0
    // the derivatives (from version 0.15.0)
    O.gmode = (s_grad == "differences")
    O.oscale = 1
    O.xlast = M.x0
    _cge_opt_store(O)
    // The model solves at the instruments' current values, and the measures exist
    f0 = _cge_opt_solve(O.start, r0, x)
    O = _cge_opt_load()
    if (O.nfail) _cge_fail("the model does not solve at the instruments' current values", 430)
    _cge_opt_rows(M, M.p, x, keys, val)
    if (O.hasobj) O.oscale = max((1, abs(_cge_opt_item(M, O, M.p, x, keys, val, O.okey, O.oex, 1))))
    for (k = 1; k <= rows(O.tval); k++) (void) _cge_opt_item(M, O, M.p, x, keys, val, O.tkeys[k, .], O.tex[k], 1)
    for (k = 1; k <= rows(O.cval); k++) (void) _cge_opt_item(M, O, M.p, x, keys, val, O.ckeys[k, .], O.cex[k], 1)
    _cge_opt_store(O)

    z = _cge_opt_z(O, O.start)
    conv = 0
    iter = 0
    if (!O.hasobj) {
        // Targets alone: as many equations as instruments, solved by Newton's
        // method with a numerical Jacobian
        O = _cge_opt_load()
        z = _cge_opt_newton(O, z, trace, conv, iter)
    }
    else {
        // An objective, with any targets as equality constraints by the
        // augmented Lagrangian method: the maximiser takes the objective less
        // lam'r + rho/2 r'r, and lam moves by rho r after each round
        // Constraints (from version 0.9.4) enter in the same way: mu moves to
        // max(0, mu - rho s) for each slack s
        O = _cge_opt_load()
        nt = rows(O.tval)
        nc = rows(O.cval)
        O.rho = (nt | nc ? 100 : 0)
        _cge_opt_store(O)
        rprev = .
        for (outer = 1; outer <= (nt | nc ? 40 : 1); outer++) {
            O = _cge_opt_load()
            z = _cge_opt_max(O, z, trace, conv2, it2)
            iter = iter + it2
            O = _cge_opt_load()
            f = _cge_opt_solve(_cge_opt_values(O, z), r, x)
            if (!(nt | nc)) {
                conv = conv2
                break
            }
            if (hasmissing(r)) break
            re = (nt ? r[|1 \ nt|] : J(0, 1, .))
            s = (nc ? r[|nt + 1 \ nt + nc|] : J(0, 1, .))
            // gaps in the targets, violations of the constraints and of
            // complementarity
            viol = max((0, (nt ? max(abs(re)) : 0), (nc ? max(abs(rowmin((s, O.mu :/ O.rho)))) : 0)))
            if (viol < 1e-10) {
                conv = conv2
                break
            }
            if (nt) O.lam = O.lam + O.rho * re
            if (nc) O.mu = rowmax((J(nc, 1, 0), O.mu - O.rho :* s))
            if (rprev < . & viol > 0.25 * rprev) O.rho = 10 * O.rho
            rprev = viol
            _cge_opt_store(O)
        }
    }
    O = _cge_opt_load()
    v = _cge_opt_values(O, z)
    f = _cge_opt_solve(v, r, x)
    // Marginals (from version 0.9.8), as those of GAMS's NLP models: the change
    // in the objective per unit of the right side of each target and
    // constraint, from the multipliers of the augmented Lagrangian at the
    // optimum, lam + rho r and max(0, mu - rho s); and the reduced cost of each
    // instrument, the derivative of the Lagrangian, zero within its bounds
    tmg = cmg = img = J(0, 1, .)
    if (O.hasobj & !hasmissing(r)) {
        nt = rows(O.tval)
        nc = rows(O.cval)
        if (nt) tmg = O.sense * O.oscale :* (O.lam + O.rho :* r[|1 \ nt|]) :/ O.tscale
        if (nc) cmg = O.sense * O.oscale :* rowmax((J(nc, 1, 0), O.mu - O.rho :* r[|nt + 1 \ nt + nc|])) :* O.ctype :/ O.cscale
        // an instrument within its bounds has none, as in the KKT conditions
        img = J(n, 1, 0)
        cb = ((O.lo :< .) :& (abs(v - O.lo) :<= 1e-6 :* O.scale)) :| ((O.hi :< .) :& (abs(v - O.hi) :<= 1e-6 :* O.scale))
        if (any(cb)) {
            img = cb :* _cge_opt_redcost(O, z)
            O = _cge_opt_load()
            f = _cge_opt_solve(v, r, x)
            O = _cge_opt_load()
        }
    }
    // The optimum becomes the current shocks and is stored as a simulation
    _cge_opt_apply(M, O, v, M.p, M.xcur)
    k = _cge_store_sim(M, name, x, (conv & !hasmissing(x)), O.nevals, _cge_maxres(M, M.p, x), "newton")
    // the statuses, in GAMS's codes (from version 0.16.0): an optimum is
    // locally optimal; one not reached, at a solution of the model, a feasible
    // solution
    if (conv & !hasmissing(x)) {
        ms = (O.hasobj ? 2 : 16)
        ss = 1
    }
    else {
        ms = (hasmissing(x) ? 6 : (O.hasobj ? 7 : 6))
        ss = 4
    }
    _cge_set_simstat(M, k, ms, ss)
    _cge_store(M)
    _cge_opt_rows(M, M.p, x, keys, val)
    v0 = O.start
    printf("\n{txt}Optimisation {res}%s{txt}: %s after {res}%f{txt} solve(s) of the model\n", name,
           (conv ? "converged" : "{err}did not converge{txt}"), O.nevals)
    if (rows(img)) {
        printf("{txt}{hline 77}\n%-30s %16s %16s %12s\n{hline 77}\n", "Instrument", "start", "optimum", "marginal")
        for (k = 1; k <= n; k++) {
            printf("{txt}%-30s {res}%16.10g %16.10g %12.4g{txt}%s\n", O.label[k], v0[k], v[k], img[k],
                   ((O.lo[k] < . & abs(v[k] - O.lo[k]) <= 1e-6 * O.scale[k]) | (O.hi[k] < . & abs(v[k] - O.hi[k]) <= 1e-6 * O.scale[k]) ?
                    " (at its bound)" : ""))
        }
        printf("{txt}{hline 77}\n")
    }
    else {
        printf("{txt}{hline 64}\n%-30s %16s %16s\n{hline 64}\n", "Instrument", "start", "optimum")
        for (k = 1; k <= n; k++) {
            printf("{txt}%-30s {res}%16.10g %16.10g{txt}%s\n", O.label[k], v0[k], v[k],
                   ((O.lo[k] < . & abs(v[k] - O.lo[k]) <= 1e-6 * O.scale[k]) | (O.hi[k] < . & abs(v[k] - O.hi[k]) <= 1e-6 * O.scale[k]) ?
                    " (at its bound)" : ""))
        }
        printf("{txt}{hline 64}\n")
    }
    if (O.hasobj) printf("{txt}%s %s: {res}%16.10g\n", (O.sense == 1 ? "Maximised" : "Minimised"), _cge_opt_text(O, O.okey, O.oex),
                         _cge_opt_item(M, O, M.p, x, keys, val, O.okey, O.oex, 1))
    for (k = 1; k <= rows(O.tval); k++) {
        printf("{txt}Target %s: {res}%16.10g{txt}%s\n", O.ttext[k], _cge_opt_item(M, O, M.p, x, keys, val, O.tkeys[k, .], O.tex[k], 1),
               (rows(tmg) ? "; marginal {res}" + strtrim(sprintf("%12.6g", tmg[k])) : ""))
    }
    // constraints (from version 0.9.4), and whether they bind
    cv = cb = J(rows(O.cval), 1, .)
    for (k = 1; k <= rows(O.cval); k++) {
        cv[k] = _cge_opt_item(M, O, M.p, x, keys, val, O.ckeys[k, .], O.cex[k], 1)
        cb[k] = _cge_opt_bound(M, O, M.p, x, O.cval[k], O.crex[k])
        printf("{txt}Constraint %s: {res}%16.10g{txt}%s%s\n", O.ctext[k], cv[k],
               (abs(cv[k] - cb[k]) <= 1e-6 * O.cscale[k] ? " (binding)" : ""),
               (rows(cmg) ? "; marginal {res}" + strtrim(sprintf("%12.6g", cmg[k])) : ""))
    }
    st_numscalar("r(converged)", conv)
    st_numscalar("r(modelstat)", ms)
    st_numscalar("r(solvestat)", ss)
    st_numscalar("r(N_evaluations)", O.nevals)
    st_numscalar("r(N_failed)", O.nfail)
    st_numscalar("r(iterations)", iter)
    if (O.hasobj) st_numscalar("r(objective)", _cge_opt_item(M, O, M.p, x, keys, val, O.okey, O.oex, 1))
    if (rows(O.cval)) {
        st_matrix("r(constraints)", cv')
        st_numscalar("r(N_binding)", sum(abs(cv - cb) :<= 1e-6 :* O.cscale))
    }
    st_matrix("r(instruments)", v')
    st_matrixcolstripe("r(instruments)", (J(n, 1, ""), strtoname(subinstr(O.label, ")", ""))))
    // marginals (from version 0.9.8)
    if (rows(img)) {
        st_matrix("r(instrument_marginals)", img')
        st_matrixcolstripe("r(instrument_marginals)", (J(n, 1, ""), strtoname(subinstr(O.label, ")", ""))))
    }
    if (rows(tmg)) st_matrix("r(target_marginals)", tmg')
    if (rows(cmg)) st_matrix("r(constraint_marginals)", cmg')
    st_matrix("r(start)", v0')
    st_matrixcolstripe("r(start)", (J(n, 1, ""), strtoname(subinstr(O.label, ")", ""))))
    // the values of the targets' measures or expressions (from version 0.9.4)
    if (rows(O.tval)) {
        tv = J(rows(O.tval), 1, .)
        for (k = 1; k <= rows(O.tval); k++) tv[k] = _cge_opt_item(M, O, M.p, x, keys, val, O.tkeys[k, .], O.tex[k], 1)
        st_matrix("r(targets)", tv')
    }
    st_global("r(name)", name)
    st_global("r(instruments_list)", invtokens(O.label'))
    st_global("r(gradient)", (O.gmode == 1 ? "differences" : "exact"))
    rmexternal("cge__opt")
}


// =====================================================================
// Scenario loops (from version 0.9.9)
// =====================================================================

// The scenarios of a loop from the long dataset in memory, with the variables
// scenario, target and value: the scenarios and targets in the order they
// first appear, and their values, missing where a scenario leaves a target
// as it is. Kept in externals for _cge_loop.
void _cge_loop_read()
{
    string colvector sc, tg, us, ut
    real colvector v
    real matrix V
    real scalar i, a, b
    pointer() scalar q
    if (st_nobs() == 0) _cge_fail("cge_loop: the dataset of scenarios has no observations", 2000)
    if (st_isstrvar("scenario")) sc = strtrim(st_sdata(., "scenario"))
    else sc = strtrim(strofreal(st_data(., "scenario"), "%18.0g"))
    if (!st_isstrvar("target")) _cge_fail("cge_loop: target must be a string variable, such as tm(com_man)", 109)
    if (st_isstrvar("value")) _cge_fail("cge_loop: value must be numeric", 109)
    tg = subinstr(st_sdata(., "target"), " ", "")
    v = st_data(., "value")
    us = ut = J(0, 1, "")
    for (i = 1; i <= rows(sc); i++) {
        if (sc[i] == "" | sc[i] == ".") _cge_fail("cge_loop: observation " + strofreal(i) + " has no scenario", 198)
        if (tg[i] == "") _cge_fail("cge_loop: observation " + strofreal(i) + " has no target", 198)
        if (!anyof(us, sc[i])) us = us \ sc[i]
        if (!anyof(ut, tg[i])) ut = ut \ tg[i]
    }
    V = J(rows(us), rows(ut), .)
    for (i = 1; i <= rows(sc); i++) {
        a = _cge_find(us, sc[i])
        b = _cge_find(ut, tg[i])
        if (V[a, b] < .) _cge_fail("cge_loop: scenario " + sc[i] + " gives " + tg[i] + " twice", 198)
        if (v[i] >= .) _cge_fail("cge_loop: the value of " + tg[i] + " in scenario " + sc[i] + " is missing", 198)
        V[a, b] = v[i]
    }
    if ((q = findexternal("cge__lps")) == NULL) q = crexternal("cge__lps")
    *q = us
    if ((q = findexternal("cge__lpt")) == NULL) q = crexternal("cge__lpt")
    *q = ut
    if ((q = findexternal("cge__lpv")) == NULL) q = crexternal("cge__lpv")
    *q = V
}

// The scenarios of a loop of values() (target lists separated by |): in
// order, or with grid every combination, the first target varying slowest
real matrix _cge_loop_grid(string scalar s_lists, real scalar T, real scalar grid)
{
    string rowvector parts
    string scalar rest
    real rowvector n
    real matrix V
    pointer(real rowvector) rowvector L
    real scalar k, S, s, r, i
    parts = J(1, 0, "")
    // a copy: Mata passes arguments by reference
    rest = s_lists + "|"
    while (strlen(rest)) {
        k = strpos(rest, "|")
        parts = parts, strtrim(substr(rest, 1, k - 1))
        rest = substr(rest, k + 1, .)
    }
    if (cols(parts) != T) _cge_fail("cge_loop: give a list of values for each target", 198)
    L = J(1, T, NULL)
    n = J(1, T, 0)
    for (k = 1; k <= T; k++) {
        L[k] = &(strtoreal(tokens(parts[k])))
        n[k] = cols(*L[k])
        if (!n[k] | hasmissing(*L[k])) _cge_fail("cge_loop: each target needs one or more numbers", 198)
    }
    if (grid) {
        S = 1
        for (k = 1; k <= T; k++) S = S * n[k]
        V = J(S, T, .)
        for (s = 1; s <= S; s++) {
            r = s - 1
            for (k = T; k >= 1; k--) {
                i = mod(r, n[k]) + 1
                r = floor(r / n[k])
                V[s, k] = (*L[k])[i]
            }
        }
        return(V)
    }
    // in order: lists of one value apply to every scenario
    S = max(n)
    for (k = 1; k <= T; k++) {
        if (n[k] != S & n[k] != 1) _cge_fail("cge_loop: the lists of values differ in length; give lists of the same length, or grid for every combination", 198)
    }
    V = J(S, T, .)
    for (k = 1; k <= T; k++) V[., k] = (n[k] == 1 ? J(S, 1, (*L[k])[1]) : (*L[k])')
    return(V)
}

// cge_loop: solves the model for each scenario of a list of values of
// instruments -- parameters, user parameters and fixed variables, as in
// cge_optimize -- as a GAMS loop over a set of scenarios, or GUSS, does. Each
// scenario takes the shocks in place with its own values, starts from the
// solution of the scenario before (from the base with cold) and is stored as
// a simulation, name1, name2, ...; the measures of each are collected. The
// shocks in place are left as they were.
void _cge_loop(string scalar name, string scalar s_tar, string scalar s_lists, real scalar grid, real scalar scale,
               real scalar cold, real scalar store, string scalar keep, string scalar s_meas, real scalar clear,
               real scalar tol, real scalar maxit, real scalar usedata, | real scalar par, string scalar exe,
               real scalar first)
{
    struct cge_model scalar M
    struct cge_opt scalar O
    struct cge_par scalar p, psave
    string rowvector tg, parts, kv, key
    string colvector snames, tables, simn, e1, e2, cv, ce1, ce2, csc, csim
    string matrix keys, mkeys
    real colvector xsave, xfix, x, xprev, start, v, val, mex, conv_v, it_v, res_v, pos, cpos, cs
    real matrix V, R, X, D
    real scalar T, S, k, j, s, conv, iter, err, nm, kd, pi, st, it2, done, haskey, nr, w, kk
    string scalar method, m2, pn
    pointer() scalar q
    real scalar parrun, kr

    // parallel runs across Stata processes and the number of the first
    // scenario (from version 0.19.0)
    if (args() < 14) par = 1
    if (args() < 15) exe = ""
    if (args() < 16) first = 1
    M = _cge_load()
    _cge_need(M, "calibrated")
    if (!regexm(name, "^[A-Za-z_][A-Za-z_0-9]*$") | strlen(name) > 24) _cge_fail("cge_loop: name() takes a name of at most 24 characters", 198)
    // the targets, read as the instruments of cge_optimize
    if (usedata) tg = (*findexternal("cge__lpt"))'
    else tg = tokens(s_tar)
    T = cols(tg)
    if (!T) _cge_fail("cge_loop: give values() or using", 198)
    O.kind = O.pidx = O.start = J(T, 1, .)
    O.pname = J(T, 1, "")
    O.label = tg'
    for (k = 1; k <= T; k++) {
        _cge_opt_instrument(M, tg[k], kd, pn, pi, st)
        O.kind[k] = kd
        O.pname[k] = pn
        O.pidx[k] = pi
        O.start[k] = st
        for (j = 1; j < k; j++) {
            if (O.kind[j] == O.kind[k] & O.pname[j] == O.pname[k] & O.pidx[j] == O.pidx[k]) _cge_fail("cge_loop: target " + tg[k] + " is given twice", 198)
        }
    }
    // the scenarios, one row of values each; with scale, multiples of the
    // values in place
    if (usedata) {
        V = *findexternal("cge__lpv")
        snames = *findexternal("cge__lps")
        rmexternal("cge__lpv")
        rmexternal("cge__lps")
        rmexternal("cge__lpt")
    }
    else {
        V = _cge_loop_grid(s_lists, T, grid)
        snames = strofreal((first - 1) :+ (1::rows(V)))
    }
    S = rows(V)
    for (k = 1; k <= T; k++) if (scale) V[., k] = V[., k] :* O.start[k]
    // a target that a scenario leaves out keeps its value in place
    for (k = 1; k <= T; k++) {
        for (s = 1; s <= S; s++) if (V[s, k] >= .) V[s, k] = O.start[k]
    }
    // the measures: report measures or expressions of the user language
    O.estart = O.elen = J(0, 1, .)
    O.etok = J(0, 3, .)
    O.etext = J(0, 1, "")
    _cge_opt_rows(M, M.p0, M.x0, keys, val)
    tables = uniqrows(keys[., 1])
    parts = _cge_opt_parts(s_meas)
    nm = cols(parts)
    mkeys = J(nm, 3, "")
    mex = J(nm, 1, 0)
    for (k = 1; k <= nm; k++) {
        mex[k] = _cge_opt_parse(M, O, parts[k], "measures", key, tables)
        mkeys[k, .] = key
        if (!mex[k]) (void) _cge_opt_lookup(keys, val, key, 1)
    }
    haskey = any(mex :== 0)
    // the variables of the dataset
    kv = tokens(keep)
    for (k = 1; k <= cols(kv); k++) if (!_cge_vidx(M, kv[k])) _cge_fail("cge_loop: keep(): " + kv[k] + " is not a model or user variable", 198)
    // the scenarios, in order
    psave = M.p
    xsave = M.xcur
    xprev = _cge_bd_start(M, M.xcur)
    R = J(S, nm, .)
    conv_v = it_v = res_v = J(S, 1, .)
    X = J(rows(M.x0), S, .)
    simn = J(S, 1, "")
    // parallel runs (from version 0.19.0): the scenarios in contiguous
    // groups, each solved by another Stata process in batch mode from the
    // saved model, and their simulations merged back
    parrun = 0
    if (par > 1 & S > 1 & c("os") == "Windows" & c("mode") == "batch") {
        printf("{txt}Note: Stata in batch mode cannot start other Stata processes on Windows; the scenarios are solved in this session\n")
    }
    else if (par > 1 & S > 1) {
        _cge_loop_par(M, name, tg, V, cold, tol, maxit, par, exe, store, first, conv_v, it_v, res_v, X, simn)
        parrun = 1
        psave = M.p
        xsave = M.xcur
        for (s = 1; s <= S; s++) {
            kr = _cge_find(M.simname, name + strofreal(first - 1 + s))
            p = (kr ? M.simp[kr] : M.p)
            if (haskey) _cge_opt_rows(M, p, X[., s], keys, val)
            for (k = 1; k <= nm; k++) R[s, k] = _cge_opt_item(M, O, p, X[., s], keys, val, mkeys[k, .], mex[k], 0)
        }
    }
    for (s = 1; s <= (parrun ? 0 : S); s++) {
        v = V[s, .]'
        // a target that the scenario leaves out keeps its value in place
        for (k = 1; k <= T; k++) if (v[k] >= .) v[k] = O.start[k]
        V[s, .] = v'
        _cge_opt_apply(M, O, v, p, xfix)
        start = (cold ? _cge_bd_start(M, xfix) : xprev)
        x = _cge_solve_point(M, p, xfix, start, tol, maxit, 0, conv, iter, err, method, 0)
        if (!conv & !cold) {
            x = _cge_solve_point(M, p, xfix, _cge_bd_start(M, xfix), tol, maxit, 0, conv, it2, err, method, 0)
            iter = iter + it2
        }
        if (!conv) {
            // continuation from the base, in 4 and then 16 steps
            M.p = p
            M.xcur = xfix
            for (j = 1; j <= 2; j++) {
                x = _cge_continue(M, (j == 1 ? 4 : 16), tol, maxit, 0, conv, it2, err, m2, 0, done)
                iter = iter + it2
                if (conv) {
                    method = m2
                    break
                }
            }
            M.p = psave
            M.xcur = xsave
        }
        err = _cge_maxres(M, p, x)
        conv_v[s] = conv
        it_v[s] = iter
        res_v[s] = err
        X[., s] = x
        if (conv) xprev = x
        if (haskey) _cge_opt_rows(M, p, x, keys, val)
        for (k = 1; k <= nm; k++) R[s, k] = _cge_opt_item(M, O, p, x, keys, val, mkeys[k, .], mex[k], 0)
        if (store) {
            simn[s] = name + strofreal(first - 1 + s)
            M.p = p
            (void) _cge_store_sim(M, simn[s], x, conv, iter, err, method)
            M.p = psave
        }
    }
    M.p = psave
    M.xcur = xsave
    // the loop's record, for cge_gams, loop()
    if (store) {
        if (cols(M.loopdef) != 3) M.loopdef = J(0, 3, "")
        k = (rows(M.loopdef) ? _cge_find(M.loopdef[., 1], name) : 0)
        if (k) M.loopdef[k, .] = (name, invtokens(simn'), invtokens(tg))
        else M.loopdef = M.loopdef \ (name, invtokens(simn'), invtokens(tg))
    }
    _cge_store(M)

    // the display
    w = 10 + 15 * min((T, 4)) + 21
    printf("\n{txt}Loop {res}%s{txt}: {res}%f{txt} scenario(s) over {res}%f{txt} target(s), %s\n", name, S, T,
           (cold ? "each from the base" : "each from the solution before"))
    printf("{txt}{hline %f}\n%-10s", w, "Scenario")
    for (k = 1; k <= min((T, 4)); k++) printf(" %14s", _cge_trunc(tg[k], 14))
    printf(" %9s %10s\n{txt}{hline %f}\n", "converged", "iterations", w)
    for (s = 1; s <= min((S, 50)); s++) {
        printf("{txt}%-10s{res}", _cge_trunc(snames[s], 10))
        for (k = 1; k <= min((T, 4)); k++) printf(" %14.8g", V[s, k])
        printf((conv_v[s] ? " %9s" : "{err} %9s{res}"), (conv_v[s] ? "yes" : "no"))
        printf(" %10.0f\n", it_v[s])
    }
    if (S > 50) printf("{txt}and %f more\n", S - 50)
    printf("{txt}{hline %f}\n", w)
    if (T > 4) printf("{txt}(the first four targets shown)\n")
    if (all(conv_v)) printf("{txt}All scenarios converged, in {res}%f{txt} iterations in all\n", sum(it_v))
    else printf("{err}%f of %f scenario(s) did not converge\n", S - sum(conv_v), S)
    if (store) printf("{txt}Stored as simulations {res}%s{txt} to {res}%s\n", simn[1], simn[S])

    // the dataset: one observation per scenario and element of the variables
    // kept, with the scenario's targets, convergence and measures
    if (clear) {
        cpos = J(0, 1, .)
        cv = ce1 = ce2 = J(0, 1, "")
        for (kk = 1; kk <= rows(M.vname); kk++) {
            if (cols(kv)) if (!anyof(kv, M.vname[kk])) continue
            pos = _cge_bd_exist(M, _cge_vpos(M, kk))
            if (!rows(pos)) continue
            _cge_vlabels(M, kk, e1, e2)
            cpos = cpos \ pos
            cv = cv \ J(rows(pos), 1, M.vname[kk])
            ce1 = ce1 \ e1[pos :- M.voff[kk]]
            ce2 = ce2 \ e2[pos :- M.voff[kk]]
        }
        nr = rows(cpos) * S
        stata("clear")
        st_addobs(nr)
        cs = (1::S) # J(rows(cpos), 1, 1)
        csc = csim = J(nr, 1, "")
        for (s = 1; s <= S; s++) {
            csc[|(s - 1) * rows(cpos) + 1 \ s * rows(cpos)|] = J(rows(cpos), 1, snames[s])
            csim[|(s - 1) * rows(cpos) + 1 \ s * rows(cpos)|] = J(rows(cpos), 1, simn[s])
        }
        (void) st_addvar("int", "s")
        (void) st_addvar("str" + strofreal(max((1, max(strlen(snames))))), "scenario")
        (void) st_addvar("str" + strofreal(max((1, max(strlen(simn))))), "sim")
        (void) st_addvar("byte", "converged")
        D = J(nr, T, .)
        for (k = 1; k <= T; k++) {
            (void) st_addvar("double", "t" + strofreal(k))
            st_varlabel("t" + strofreal(k), tg[k])
            D[., k] = V[., k] # J(rows(cpos), 1, 1)
        }
        for (k = 1; k <= nm; k++) {
            (void) st_addvar("double", "m" + strofreal(k))
            st_varlabel("m" + strofreal(k), _cge_trunc(_cge_opt_text(O, mkeys[k, .], mex[k]), 80))
        }
        (void) st_addvar("str" + strofreal(max((1, max(strlen(cv))))), "variable")
        (void) st_addvar("str" + strofreal(max((1, max(strlen(ce1))))), "element1")
        (void) st_addvar("str" + strofreal(max((1, max(strlen(ce2))))), "element2")
        (void) st_addvar(("double", "double"), ("base", "value"))
        st_store(., "s", cs)
        st_sstore(., "scenario", csc)
        st_sstore(., "sim", csim)
        st_store(., "converged", conv_v # J(rows(cpos), 1, 1))
        for (k = 1; k <= T; k++) st_store(., "t" + strofreal(k), D[., k])
        for (k = 1; k <= nm; k++) st_store(., "m" + strofreal(k), R[., k] # J(rows(cpos), 1, 1))
        st_sstore(., "variable", J(S, 1, cv))
        st_sstore(., "element1", J(S, 1, ce1))
        st_sstore(., "element2", J(S, 1, ce2))
        st_store(., "base", J(S, 1, M.x0[cpos]))
        st_store(., "value", colshape(X[cpos, .]', 1))
    }

    st_numscalar("r(N_scenarios)", S)
    st_numscalar("r(parallel)", (parrun ? min((par, S)) : 1))
    st_numscalar("r(N_converged)", sum(conv_v))
    st_numscalar("r(N_failed)", S - sum(conv_v))
    st_numscalar("r(iterations)", sum(it_v))
    st_matrix("r(values)", V)
    st_matrixcolstripe("r(values)", (J(T, 1, ""), strtoname(subinstr(tg', ")", ""))))
    st_matrix("r(converged)", conv_v)
    if (nm) st_matrix("r(measures)", R)
    st_global("r(name)", name)
    st_global("r(targets)", invtokens(tg))
    if (store) st_global("r(sims)", invtokens(simn'))
}

// The Stata executable that runs the parallel processes of cge_loop (from
// version 0.19.0): exe, or the one of the running edition in Stata's folder
string scalar _cge_stata_exe(string scalar exe)
{
    string rowvector cand
    string scalar d
    real scalar k
    if (exe != "") {
        if (!fileexists(exe)) _cge_fail("cge_loop: stataexe(): " + exe + " not found", 601)
        return(exe)
    }
    d = c("sysdir_stata")
    if (c("os") == "Windows") {
        cand = ("StataMP-64.exe", "StataSE-64.exe", "StataBE-64.exe", "Stata-64.exe", "StataMP.exe", "StataSE.exe", "Stata.exe")
        if (!c("MP")) cand = cand[(2, 3, 4, 1, 6, 7, 5)]
        if (!c("MP") & !c("SE")) cand = ("StataBE-64.exe", "Stata-64.exe", "StataSE-64.exe", "StataMP-64.exe", "Stata.exe")
    }
    else {
        cand = ("stata-mp", "stata-se", "stata-be", "stata")
        if (!c("MP")) cand = cand[(2, 3, 4, 1)]
        if (!c("MP") & !c("SE")) cand = ("stata-be", "stata", "stata-se", "stata-mp")
    }
    for (k = 1; k <= cols(cand); k++) if (fileexists(d + cand[k])) return(d + cand[k])
    _cge_fail("cge_loop: no Stata executable found in " + d + "; give it with stataexe()", 601)
}

// The ado-path of this session with relative folders made absolute, for the
// parallel processes, which run in another folder
string scalar _cge_abs_adopath()
{
    string scalar rest, e, out, pwd
    real scalar k
    pwd = c("pwd")
    if (substr(pwd, -1, 1) != "/" & substr(pwd, -1, 1) != char(92)) pwd = pwd + "/"
    rest = c("adopath") + ";"
    out = ""
    while (strlen(rest)) {
        k = strpos(rest, ";")
        e = strtrim(substr(rest, 1, k - 1))
        rest = substr(rest, k + 1, .)
        // the quotes Stata puts around an entry, compound or not
        e = subinstr(e, char(34), "")
        if (substr(e, 1, 1) == char(96)) e = substr(e, 2, .)
        if (substr(e, -1, 1) == char(39)) e = substr(e, 1, strlen(e) - 1)
        if (e == "") continue
        if (!anyof(("BASE", "SITE", "PERSONAL", "PLUS", "OLDPLACE", "UPDATES"), e)) {
            if (e == ".") e = pwd
            else if (!(substr(e, 2, 1) == ":" | substr(e, 1, 1) == "/" | substr(e, 1, 1) == char(92) | substr(e, 1, 1) == "~")) e = pwd + e
        }
        out = out + (out != "" ? ";" : "") + (strpos(e, " ") ? char(34) + e + char(34) : e)
    }
    return(out)
}

// Parallel runs of cge_loop (from version 0.19.0): the model is saved, the
// scenarios V split into contiguous groups, and each group solved by a Stata
// process in batch mode, which loads the model, runs cge_loop on its group
// with first() numbering the scenarios as in one run, and saves the model
// with its simulations; their simulations are then merged into M (or only
// read, without store), with the solutions, convergence, iterations and
// residuals of each scenario
void _cge_loop_par(struct cge_model scalar M, string scalar name, string rowvector tg, real matrix V,
                   real scalar cold, real scalar tol, real scalar maxit, real scalar par, string scalar exe,
                   real scalar store, real scalar first, real colvector conv_v, real colvector it_v,
                   real colvector res_v, real matrix X, string colvector simn)
{
    struct cge_model scalar R, Ms
    struct cge_par scalar ps
    string scalar pre, dir, base, fm, adop, spec, cwd, q, line, nm
    string colvector fw, fr, fd
    real colvector a, b
    real scalar S, P, T, k, j, fh, t0, done, rc, kr, ks, ms, ss
    q = char(34)
    S = rows(V)
    T = cols(V)
    P = min((par, S))
    exe = _cge_stata_exe(exe)
    // the temporary files, named without periods: Stata names a batch log
    // after the name of its do-file up to the first period
    pre = st_tempfilename()
    pathsplit(pre, dir, base)
    base = "cgepar_" + subinstr(subinstr(base, ".", "_"), "-", "_")
    pre = pathjoin(dir, base)
    fm = pre + "_model.cgem"
    _cge_store(M)
    stata("quietly cge_save using " + q + fm + q + ", replace")
    adop = _cge_abs_adopath()
    a = b = J(P, 1, .)
    fw = fr = fd = J(P, 1, "")
    for (k = 1; k <= P; k++) {
        a[k] = floor((k - 1) * S / P) + 1
        b[k] = floor(k * S / P)
        fw[k] = pre + "_w" + strofreal(k) + ".do"
        fr[k] = pre + "_r" + strofreal(k) + ".cgem"
        fd[k] = pre + "_d" + strofreal(k) + ".txt"
        spec = ""
        for (j = 1; j <= T; j++) {
            spec = spec + (j > 1 ? "; " : "") + tg[j] + " = " + invtokens(strtrim(strofreal(V[|a[k], j \ b[k], j|]', "%21.17g")))
        }
        fh = fopen(fw[k], "w")
        fput(fh, "version 13.0")
        fput(fh, "set more off")
        fput(fh, "global S_ADO " + char(96) + q + adop + q + char(39))
        fput(fh, "capture noisily {")
        fput(fh, "    cge_use using " + q + fm + q)
        fput(fh, "    cge_loop, name(" + name + ") values(" + spec + ") first(" + strofreal(first - 1 + a[k]) + ")" +
             (cold ? " cold" : "") + " tolerance(" + strofreal(tol, "%21.17g") + ") iterate(" + strofreal(maxit) + ")")
        fput(fh, "    cge_save using " + q + fr[k] + q + ", replace")
        fput(fh, "}")
        fput(fh, "local cgeparrc = _rc")
        fput(fh, "file open cgeparfh using " + q + fd[k] + q + ", write replace text")
        // the macro written with char(): the Mata file is compiled through
        // Stata, which would expand it
        fput(fh, "file write cgeparfh " + q + char(96) + "cgeparrc" + char(39) + q)
        fput(fh, "file close cgeparfh")
        fclose(fh)
    }
    // the processes start in the folder of the temporary files, where their
    // logs are written
    cwd = c("pwd")
    stata("quietly cd " + q + dir + q)
    for (k = 1; k <= P; k++) {
        if (c("os") == "Windows") stata("winexec " + q + exe + q + " /e do " + q + fw[k] + q)
        else stata("shell " + q + exe + q + " -b do " + q + fw[k] + q + " &")
    }
    stata("quietly cd " + q + cwd + q)
    printf("{txt}Started {res}%f{txt} Stata process(es) for {res}%f{txt} scenario(s); waiting\n", P, S)
    // wait for every process, at most 10 minutes plus 2 per scenario
    t0 = _cge_now()
    while (1) {
        done = 0
        for (k = 1; k <= P; k++) done = done + fileexists(fd[k])
        if (done == P) break
        if (_cge_now() - t0 > 1000 * (600 + 120 * S)) {
            _cge_fail("cge_loop: the parallel processes did not finish; their files begin with " + pre, 9)
        }
        stata("sleep 200")
    }
    // their simulations, merged
    Ms = M
    for (k = 1; k <= P; k++) {
        fh = fopen(fd[k], "r")
        line = fget(fh)
        fclose(fh)
        if (rows(line) * cols(line) == 0) line = ""
        rc = strtoreal(line)
        if (rc != 0) {
            _cge_fail("cge_loop: parallel process " + strofreal(k) + " stopped with error " + line + "; see " +
                      pathjoin(dir, base + "_w" + strofreal(k) + ".log"), (rc < . & rc > 0 ? rc : 9))
        }
        stata("quietly cge_use using " + q + fr[k] + q)
        R = _cge_load()
        for (j = a[k]; j <= b[k]; j++) {
            nm = name + strofreal(first - 1 + j)
            kr = _cge_find(R.simname, nm)
            if (!kr) _cge_fail("cge_loop: simulation " + nm + " is missing from process " + strofreal(k), 459)
            X[., j] = R.simx[., kr]
            conv_v[j] = R.simconv[kr]
            it_v[j] = R.simiter[kr]
            res_v[j] = R.simres[kr]
            if (store) {
                simn[j] = nm
                ps = Ms.p
                Ms.p = R.simp[kr]
                ks = _cge_store_sim(Ms, nm, X[., j], conv_v[j], it_v[j], res_v[j], R.simmethod[kr])
                Ms.p = ps
                _cge_simstat(R, kr, ms, ss)
                _cge_set_simstat(Ms, ks, ms, ss)
            }
        }
    }
    M = Ms
    _cge_store(M)
    // the temporary files
    unlink(fm)
    for (k = 1; k <= P; k++) {
        unlink(fw[k])
        unlink(fd[k])
        if (fileexists(fr[k])) unlink(fr[k])
        if (fileexists(pathjoin(dir, base + "_w" + strofreal(k) + ".log"))) unlink(pathjoin(dir, base + "_w" + strofreal(k) + ".log"))
    }
    printf("{txt}Solved in {res}%f{txt} parallel Stata process(es)\n", P)
}

// The simulations of loop name, in order; 0 if none
real colvector _cge_loop_sims(struct cge_model scalar M, string scalar name)
{
    string rowvector sims
    real colvector s
    real scalar k, i
    if (cols(M.loopdef) != 3 | !rows(M.loopdef)) return(J(0, 1, .))
    k = _cge_find(M.loopdef[., 1], name)
    if (!k) return(J(0, 1, .))
    sims = tokens(M.loopdef[k, 2])
    s = J(cols(sims), 1, .)
    for (i = 1; i <= cols(sims); i++) {
        s[i] = _cge_find(M.simname, sims[i])
        if (!s[i]) _cge_fail("simulation " + sims[i] + " of loop " + name + " has been dropped; run the loop again", 111)
    }
    return(s)
}

// Imports the GAMS solution of a scenario as a simulation (from version
// 0.6.2): the free variables from GAMS, the fixed ones from Stata, with the
// equations checked in Stata. For a model too large for Stata's solver, the
// scenario can be solved by PATH and its results used in Stata.
void _cge_gams_import(string scalar dir, string scalar sim, string scalar newname)
{
    struct cge_model scalar M, M2
    struct cge_par scalar p, psave
    transmorphic A
    string colvector key, e1, e2
    string rowvector cl
    real colvector val, x, fixed, pos, fx, fr, isfree, got
    string scalar name, closure
    real scalar k, i, status, err, n, nmiss, conv, s

    M = _cge_load()
    _cge_need(M, "sam")
    _cge_need(M, "calibrated")
    if (sim == "") {
        name = "current"
        p = M.p
        x = M.xcur
        fixed = M.fixed
        closure = _cge_closure_text(M)
    }
    else {
        name = sim
        s = _cge_sim_index(M, sim)
        if (M.simrun[s] != "") _cge_fail("simulation " + sim + " is a period of a dynamic run", 198)
        p = M.simp[s]
        x = M.simx[., s]
        closure = M.simclosure[s]
        cl = tokens(closure)
        M2 = M
        _cge_swap_parse(M2, _cge_swap_tokens(cl), fx, fr)
        M2.swfix = fx
        M2.swfree = fr
        _cge_closure_cl(M2, cl)
        fixed = M2.fixed
    }
    A = asarray_create()
    for (k = 1; k <= rows(M.vname); k++) {
        _cge_vlabels(M, k, e1, e2)
        pos = _cge_vpos(M, k)
        for (i = 1; i <= rows(pos); i++) asarray(A, M.vname[k] + "|" + e1[i] + "|" + e2[i], pos[i])
    }
    _cge_gams_read(dir + "/cge_" + name + ".csv", key, val, status)
    // every free variable that exists, and the adjusting variables of
    // constraints, take GAMS's value
    isfree = M.exists :* (1 :- fixed)
    if (rows(M.bX)) isfree[M.bX] = J(rows(M.bX), 1, 1)
    got = J(rows(x), 1, 0)
    n = 0
    for (k = 1; k <= rows(key); k++) {
        if (!asarray_contains(A, key[k])) continue
        i = asarray(A, key[k])
        if (!isfree[i]) continue
        x[i] = val[k]
        got[i] = 1
        n++
    }
    nmiss = sum(isfree :* (1 :- got))
    if (nmiss) {
        pos = select((1::rows(x)), isfree :* (1 :- got))
        _cge_fail("the GAMS results lack " + strofreal(nmiss) + " free variable(s) of the model, such as " +
                  _cge_poslabel(M, pos[1]), 459)
    }
    err = _cge_maxres(M, p, x)
    conv = (anyof((1, 2, 15, 16), status) & err < 1e-8)
    psave = M.p
    M.p = p
    if (newname == "") newname = name + "_gams"
    k = _cge_store_sim(M, newname, x, conv, 0, err, "gams")
    M.simclosure[k] = closure
    M.p = psave
    _cge_store(M)
    printf("{txt}Imported {res}%f{txt} values of scenario {res}%s{txt} from GAMS (model status {res}%g{txt}) as simulation {res}%s\n",
           n, name, status, newname)
    printf("{txt}Largest scaled residual of the model's equations in Stata: {res}%9.3e{txt}%s\n", err,
           (conv ? "" : " {err}(not a solution)"))
    st_numscalar("r(N_imported)", n)
    st_numscalar("r(modelstat)", status)
    st_numscalar("r(max_residual)", err)
    st_numscalar("r(converged)", conv)
    st_global("r(name)", newname)
}

// =====================================================================
// Standalone models (from version 0.13.0; model_spec.md, Section 22)
// =====================================================================

// cge_model new: an empty standalone model in place of the model in memory,
// to be written whole in the user language with cge_set, cge_parameter,
// cge_variable and cge_equation, without a SAM or the built-in equations
void _cge_model_new()
{
    struct cge_model scalar M
    real scalar had
    had = (findexternal("cge__model") != NULL)
    M.standalone = 1
    M.mapped = 1
    M.calibrated = 1
    M.labels0 = M.labels = J(0, 1, "")
    M.S0 = M.S = J(0, 0, .)
    M.rewritten = J(1, 0, .)
    M.A = M.C = M.F = M.H = M.I = M.E = M.D = M.N = J(0, 1, "")
    M.n = M.nC = M.nF = M.nH = M.nE = M.nD = M.nI = M.nN = 0
    M.iA = M.iC = M.iF = M.iH = J(0, 1, .)
    M.igov = M.isav = M.irow = M.idirtax = M.isaltax = M.iimptax = M.iexptax = M.iacttax = 0
    M.ishi = M.ivattax = M.iFY = 0
    M.usdef = J(0, 3, "")
    M.updef = J(0, 3, "")
    M.uvdef = J(0, 9, "")
    M.uedef = J(0, 8, "")
    M.umac = J(0, 3, "")
    M.urep = J(0, 3, "")
    M.unest = J(0, 2, "")
    M.bddef = J(0, 7, "")
    M.loopdef = J(0, 3, "")
    M.upar = M.uelab = J(0, 1, "")
    M.uegams = J(0, 2, "")
    M.utok = J(0, 3, .)
    M.ustart = M.ulen = M.ulen2 = J(0, 1, .)
    M.p0.upval = M.p.upval = J(0, 1, .)
    M.p0.bmode = M.p0.bval = M.p0.bxbar = J(0, 1, .)
    M.p.bmode = M.p.bval = M.p.bxbar = J(0, 1, .)
    M.p0.bmu = M.p.bmu = 1e-8
    M.bY = M.bX = M.btype = M.bdir = M.swfix = M.swfree = J(0, 1, .)
    M.c_ext = M.c_gov = M.c_si = M.c_num = ""
    M.c_fac = J(0, 1, "")
    M.calargs = J(1, 0, "")
    _cge_layout(M)
    M.x0 = M.xcur = M.xscale = M.exists = M.fixed = M.nominal = M.positive = J(0, 1, .)
    M.simname = M.simclosure = M.simmethod = M.simrun = M.simcons = M.simobj = J(0, 1, "")
    M.simstat = J(0, 2, .)
    M.simmodel = J(0, 1, "")
    M.mdef = J(0, 2, "")
    M.intdef = J(0, 3, "")
    M.nashdef = J(0, 6, "")
    M.simx = J(0, 0, .)
    M.simp = cge_par(1, 0)
    M.simconv = M.simiter = M.simres = M.simper = M.simlam = J(0, 1, .)
    _cge_u_refresh(M)
    _cge_store(M)
    printf("{txt}New standalone model%s: write its sets, parameters, variables and equations\n",
           (had ? ", in place of the model in memory" : ""))
    printf("{txt}with cge_set, cge_parameter, cge_variable and cge_equation, and solve it with cge_solve\n")
    st_numscalar("r(standalone)", 1)
}

// cge_model describe: the size of the model in memory, as GAMS's model
// statistics: blocks and single equations and variables, the non-zero
// entries of the Jacobian at the current point, and whether the system that
// cge_solve solves is square
void _cge_model_describe(| string scalar mname)
{
    struct cge_model scalar M, M2
    struct cge_sys scalar S, SR
    real colvector bo, ri, ci, v, z, usel
    real scalar k, nbe, nbv, nse, nsv, nfx, nnz, ok, sq
    if (args() < 1) mname = ""
    M = _cge_load()
    _cge_need(M, "calibrated")
    // a named model (from version 0.17.0): its equations and the variables
    // that appear in them
    if (mname != "") {
        _cge_submodel(M, mname, M2, usel)
        M = M2
    }
    bo = runningsum(M.elen) - M.elen
    // blocks of equations: built-in blocks with elements in the system, user
    // equations by name and the constraints
    nbe = 0
    for (k = 1; k <= rows(M.ename); k++) {
        if (M.ename[k] == "U" | !M.elen[k]) continue
        if (any(M.emask[|bo[k] + 1 \ bo[k] + M.elen[k]|])) nbe++
    }
    if (mname != "") nbe = nbe + rows(_cge_mdef_expand(M, mname))
    else for (k = 1; k <= rows(M.uedef); k++) if (substr(M.uedef[k, 1], 1, 1) != "_") nbe++
    nse = M.neq
    nbv = 0
    for (k = 1; k <= rows(M.vname); k++) {
        if (substr(M.vname[k], 1, 1) == "_" | !rows(_cge_vpos(M, k))) continue
        if (any(M.exists[_cge_vpos(M, k)])) nbv++
    }
    nsv = sum(M.exists)
    S = _cge_sys_make(M, 0)
    nfx = nsv - rows(S.free)
    // the entries of the full Jacobian at the current point
    z = M.xcur[S.free] :/ M.xscale[S.free]
    ok = (rows(S.free) ? _cge_jac_trip(M, M.p, M.xcur, S, z, ri, ci, v) : 1)
    nnz = (ok ? (rows(v) ? sum(v :!= 0) : 0) : .)
    sq = (rows(S.free) == S.neq)
    printf("{txt}Model statistics: %s\n", (mname != "" ? "model " + mname + " of a standalone model" :
           (_cge_sa(M) ? "standalone model" : "model from a SAM of " + strofreal(rows(M.labels)) + " accounts")))
    printf("{txt}  Blocks of equations   {res}%10.0f{txt}     Single equations   {res}%10.0f\n", nbe, nse)
    printf("{txt}  Blocks of variables   {res}%10.0f{txt}     Single variables   {res}%10.0f\n", nbv, nsv)
    printf("{txt}  %-22s %10s{txt}     Fixed              {res}%10.0f\n", "", "", nfx)
    printf("{txt}  Non-zero elements     {res}%10.0f{txt}     Free               {res}%10.0f\n", nnz, rows(S.free))
    printf("{txt}  User sets {res}%f{txt}, user parameters {res}%f{txt}, macros {res}%f{txt}, constraints {res}%f\n",
           rows(M.usdef), rows(M.updef), rows(M.umac), rows(M.bY))
    if (sq) printf("{txt}  The system is square: {res}%f{txt} free variables and {res}%f{txt} equations\n", rows(S.free), S.neq)
    else printf("{txt}  The system is not square: {res}%f{txt} free variables and {res}%f{txt} equations\n", rows(S.free), S.neq)
    if (!_cge_sa(M)) {
        SR = _cge_sys_make(M, 1)
        printf("{txt}  cge_solve solves the reduced system: {res}%f{txt} equations, the definitions of {res}%f{txt} variables left out\n",
               SR.neq, S.neq - SR.neq)
        st_numscalar("r(N_reduced)", SR.neq)
    }
    st_numscalar("r(standalone)", _cge_sa(M))
    st_numscalar("r(N_eq_blocks)", nbe)
    st_numscalar("r(N_equations)", nse)
    st_numscalar("r(N_var_blocks)", nbv)
    st_numscalar("r(N_variables)", nsv)
    st_numscalar("r(N_fixed)", nfx)
    st_numscalar("r(N_free)", rows(S.free))
    st_numscalar("r(N_nonzeros)", nnz)
    st_numscalar("r(N_sets)", rows(M.usdef))
    st_numscalar("r(N_parameters)", rows(M.updef))
    st_numscalar("r(N_constraints)", rows(M.bY))
    st_numscalar("r(square)", sq)
    st_global("r(model)", mname)
    // the named models (from version 0.17.0)
    st_numscalar("r(N_models)", (cols(M.mdef) == 2 ? rows(M.mdef) : 0))
}

// =====================================================================
// Named models (from version 0.17.0; model_spec.md, Section 26)
// =====================================================================

// The row of named model name in M.mdef, or 0
real scalar _cge_mdef_find(struct cge_model scalar M, string scalar name)
{
    if (!rows(M.mdef) | cols(M.mdef) != 2) return(0)
    return(_cge_find(M.mdef[., 1], name))
}

// The name of the equation of element label lab, the text before its index,
// with the prefix of an inequality's slack (_S_) or of the adjusters of a
// bounded variable (_L_, _U_) removed
string scalar _cge_mdef_base(string scalar lab)
{
    string scalar s
    real scalar k
    k = strpos(lab, "(")
    s = (k ? substr(lab, 1, k - 1) : lab)
    if (substr(s, 1, 3) == "_S_" | substr(s, 1, 3) == "_L_" | substr(s, 1, 3) == "_U_") s = substr(s, 4, .)
    return(s)
}

// The index of the variable that holds position pos
real scalar _cge_pos_vidx(struct cge_model scalar M, real scalar pos)
{
    real scalar k
    for (k = rows(M.voff); k > 1; k--) if (M.voff[k] < pos) break
    return(k)
}

// The names a model may list: user equations, defined variables and
// inequalities, in the order of their elements
string colvector _cge_mdef_eqnames(struct cge_model scalar M)
{
    string colvector out
    string scalar nm
    real scalar k
    out = J(0, 1, "")
    for (k = 1; k <= rows(M.uelab); k++) {
        nm = _cge_mdef_base(M.uelab[k])
        if (!anyof(out, nm)) out = out \ nm
    }
    return(out)
}

// The equations of a list of equations, models and all, expanded
string colvector _cge_mdef_expand(struct cge_model scalar M, string scalar list, | real scalar depth)
{
    string rowvector t
    string colvector out, eqs, sub
    real scalar k, j, m
    if (args() < 3) depth = 0
    if (depth > 20) _cge_fail("cge_model: the definitions of the models refer to each other in a cycle", 198)
    eqs = _cge_mdef_eqnames(M)
    t = tokens(subinstr(subinstr(subinstr(list, ",", " "), "/", " "), ";", " "))
    out = J(0, 1, "")
    for (k = 1; k <= cols(t); k++) {
        m = _cge_mdef_find(M, t[k])
        if (t[k] == "all") sub = eqs
        else if (m) sub = _cge_mdef_expand(M, M.mdef[m, 2], depth + 1)
        else if (anyof(eqs, t[k])) sub = t[k]
        else _cge_fail("cge_model: " + t[k] + " is not a user equation, defined variable, inequality or model", 111)
        for (j = 1; j <= rows(sub); j++) if (!anyof(out, sub[j])) out = out \ sub[j]
    }
    return(out)
}

// The system of named model mname (from version 0.17.0): M2, a copy of M with
// the constraints and user equation elements of the model's equations, and
// the free variables that appear in none of them fixed, at their levels in
// the start of the solve; usel marks the elements of block U in the model
void _cge_submodel(struct cge_model scalar M, string scalar mname, struct cge_model scalar M2, real colvector usel)
{
    string colvector names
    real colvector keepc, bo, used, k
    real scalar j, g
    if (!_cge_sa(M)) _cge_fail("named models are models of a standalone model (cge_model new)", 198)
    if (!_cge_mdef_find(M, mname)) _cge_fail("model " + mname + " not found; define it with cge_model define", 111)
    names = _cge_mdef_expand(M, mname)
    M2 = M
    // the constraints of the model's inequalities and bounded variables
    keepc = J(rows(M.bY), 1, 0)
    for (j = 1; j <= rows(M.bY); j++) keepc[j] = anyof(names, _cge_mdef_base(M.vname[_cge_pos_vidx(M, M.bY[j])]))
    k = _cge_which(keepc)
    M2.bY = (rows(k) ? M.bY[k] : J(0, 1, .))
    M2.bX = (rows(k) ? M.bX[k] : J(0, 1, .))
    M2.btype = (rows(k) ? M.btype[k] : J(0, 1, .))
    M2.bdir = (rows(k) ? M.bdir[k] : J(0, 1, .))
    if (rows(M.p.bmode) == rows(M.bY)) {
        M2.p.bmode = (rows(k) ? M.p.bmode[k] : J(0, 1, .))
        M2.p.bval = (rows(k) ? M.p.bval[k] : J(0, 1, .))
        if (rows(M.p.bxbar) == rows(M.bY)) M2.p.bxbar = (rows(k) ? M.p.bxbar[k] : J(0, 1, .))
    }
    if (rows(M.p0.bmode) == rows(M.bY)) {
        M2.p0.bmode = (rows(k) ? M.p0.bmode[k] : J(0, 1, .))
        M2.p0.bval = (rows(k) ? M.p0.bval[k] : J(0, 1, .))
        if (rows(M.p0.bxbar) == rows(M.bY)) M2.p0.bxbar = (rows(k) ? M.p0.bxbar[k] : J(0, 1, .))
    }
    // the elements of the model's user equations
    usel = J(rows(M.uelab), 1, 0)
    for (j = 1; j <= rows(M.uelab); j++) usel[j] = anyof(names, _cge_mdef_base(M.uelab[j]))
    _cge_u_refresh(M2)
    g = _cge_find(M2.ename, "U")
    bo = runningsum(M2.elen) - M2.elen
    if (rows(usel)) M2.emask[bo[g] :+ (1::rows(usel))] = M2.emask[bo[g] :+ (1::rows(usel))] :* usel
    M2.neq = sum(M2.emask)
    _cge_pattern(M2, M2.p0)
    // the variables that appear in the model's equations
    used = J(rows(M.x0), 1, 0)
    if (rows(M2.jc)) used[M2.jc] = J(rows(M2.jc), 1, 1)
    k = _cge_which(M.exists :& (M.fixed :== 0) :& (used :== 0))
    if (rows(k)) M2.fixed[k] = J(rows(k), 1, 1)
}

// Variables held at their levels for one solve (from version 0.17.0), as
// GAMS's x.fx = x.l: hold() lists variables, whole or as NAME(element), with
// e1,e2 for two indexes
void _cge_hold(struct cge_model scalar M2, string scalar hold)
{
    string rowvector t
    string scalar nm, el
    real colvector pos
    real scalar k, a, v
    if (strtrim(hold) == "") return
    t = tokens(hold)
    for (k = 1; k <= cols(t); k++) {
        a = strpos(t[k], "(")
        if (a) {
            nm = substr(t[k], 1, a - 1)
            el = subinstr(subinstr(substr(t[k], a + 1, .), ")", ""), ",", ".")
        }
        else {
            nm = t[k]
            el = ""
        }
        v = _cge_vidx(M2, nm)
        if (!v) _cge_fail("hold(): " + nm + " is not a variable of the model", 111)
        if (el == "") pos = _cge_vpos(M2, v)
        else {
            pos = _cge_u_vpos(M2, nm, el)
            if (!pos) _cge_fail("hold(): " + t[k] + " is not an element of " + nm, 111)
        }
        pos = select(pos, M2.exists[pos, 1])
        if (rows(pos)) M2.fixed[pos] = J(rows(pos), 1, 1)
    }
}

// The start of a solve (from version 0.17.0): the current levels, with the
// free variables at their levels in stored simulation from, if given; the
// variables the closure fixes keep their current values
real colvector _cge_named_start(struct cge_model scalar M, string scalar from)
{
    real colvector xs, fr
    real scalar k
    xs = M.xcur
    if (from == "") return(xs)
    k = _cge_sim_index(M, from)
    fr = _cge_which(M.exists :& (M.fixed :== 0))
    if (rows(fr)) xs[fr] = M.simx[fr, k]
    return(xs)
}

// The starting levels of a solve from the levels xs (from version 0.17.0):
// those of cge_bound, or, with from(), the levels of the simulation for the
// free variables
real colvector _cge_named_from(struct cge_model scalar M2, real colvector xs, string scalar from)
{
    real colvector start, fr
    start = _cge_bd_start(M2, xs)
    if (from == "") return(start)
    fr = _cge_which(M2.exists :& (M2.fixed :== 0))
    if (rows(fr)) start[fr] = xs[fr]
    return(start)
}

// cge_solve, model() or from() (from version 0.17.0): named model mname, or
// the whole model, solved as a system from the current levels or from those
// of simulation from, and stored as simulation name with its model
void _cge_solve_named(struct cge_model scalar M, string scalar name, string scalar mname, string scalar from,
                      real scalar tol, real scalar maxit, real scalar trace, real scalar mode, string scalar lin,
                      | string scalar hold)
{
    struct cge_model scalar M2
    struct cge_sys scalar S
    real colvector xs, start, x, usel
    real scalar conv, iter, err, k, ms, ss, keeplin
    string scalar method
    if (!_cge_sa(M) & mname != "") _cge_fail("model() solves a named model of a standalone model (cge_model new and define)", 198)
    if (!_cge_sa(M)) _cge_fail("from() and hold() apply to standalone models", 198)
    if (args() < 10) hold = ""
    if (name == "") name = "sim" + strofreal(rows(M.simname) + 1)
    xs = _cge_named_start(M, from)
    if (mname != "") _cge_submodel(M, mname, M2, usel)
    else M2 = M
    _cge_hold(M2, hold)
    keeplin = M2.linsolver
    if (lin != "") M2.linsolver = (lin == "sparse")
    S = _cge_sys_make(M2, 0)
    if (rows(S.free) != S.neq) {
        _cge_fail((mname != "" ? "model " + mname : "the model") + " has " + strofreal(S.neq) + " equation(s) and " +
                  strofreal(rows(S.free)) + " free variable(s) that appear in them; solved as a system it must be square" +
                  " (a nonlinear programme, with minimize() or maximize(), may have more variables)", 459)
    }
    start = _cge_named_from(M2, xs, from)
    x = _cge_solve_point(M2, M2.p, xs, start, tol, maxit, trace, conv, iter, err, method, 0, mode)
    err = _cge_maxres(M2, M2.p, x)
    k = _cge_store_sim(M, name, x, conv, iter, err, method)
    _cge_set_simmodel(M, k, mname)
    _cge_status(conv, _cge_cons_on(M2), 0, 0, err, ms, ss)
    _cge_set_simstat(M, k, ms, ss)
    _cge_store(M)
    if (conv) printf("{txt}Simulation {res}%s{txt}%s solved in {res}%f{txt} iteration(s) ({res}%s{txt})\n", name,
                     (mname != "" ? " of model {res}" + mname + "{txt}" : ""), iter, method)
    else {
        printf("{err}Simulation %s%s did not converge (largest scaled residual %9.3e)\n", name,
               (mname != "" ? " of model " + mname : ""), err)
        _cge_status_show(ms, ss)
    }
    printf("{txt}Largest scaled residual {res}%9.3e{txt}; {res}%f{txt} equation(s), {res}%f{txt} free variable(s)%s\n",
           err, S.neq, rows(S.free), (from != "" ? ", from simulation " + from : ""))
    st_numscalar("r(converged)", conv)
    st_numscalar("r(iterations)", iter)
    st_numscalar("r(max_residual)", err)
    st_numscalar("r(modelstat)", ms)
    st_numscalar("r(solvestat)", ss)
    st_numscalar("r(N_solved)", S.neq)
    st_numscalar("r(N_free)", rows(S.free))
    st_numscalar("r(tolerance)", tol)
    st_numscalar("r(iterate)", maxit)
    st_numscalar("r(steps)", 0)
    st_global("r(name)", name)
    st_global("r(method)", method)
    st_global("r(model)", mname)
    st_global("r(from)", from)
    st_global("r(hold)", hold)
    st_global("r(linsolver)", _cge_lin_name(M2))
    st_global("r(closure)", _cge_closure_text(M))
}

// cge_model define (from version 0.17.0): named model name with its list of
// equations, defined variables, inequalities, models or all, as GAMS's model
// statement; a model of the same name is replaced
void _cge_mdef_add(string scalar spec)
{
    struct cge_model scalar M
    string rowvector t
    string colvector names
    string scalar name, list
    real scalar k, rep
    M = _cge_load()
    if (!_cge_sa(M)) _cge_fail("cge_model define: named models are models of a standalone model (cge_model new)", 198)
    spec = strtrim(spec)
    k = strpos(spec, "=")
    if (k) {
        name = strtrim(substr(spec, 1, k - 1))
        list = strtrim(substr(spec, k + 1, .))
    }
    else {
        t = tokens(spec)
        if (!cols(t)) _cge_fail("cge_model define: give a name and its equations, as cge_model define m1 = e1 e2", 198)
        name = t[1]
        list = (cols(t) > 1 ? invtokens(t[|2 \ cols(t)|]) : "")
    }
    if (name == "" | cols(tokens(name)) != 1 | !st_isname(name)) _cge_fail("cge_model define: " + name + " is not a valid name", 198)
    if (strtrim(list) == "") _cge_fail("cge_model define: model " + name + " lists no equations", 198)
    if (name == "all") _cge_fail("cge_model define: all names every equation and cannot name a model", 198)
    if (anyof(_cge_mdef_eqnames(M), name)) _cge_fail("cge_model define: " + name + " is the name of an equation", 110)
    // a model may refer to a model only if it was defined before
    if (cols(M.mdef) != 2) M.mdef = J(0, 2, "")
    rep = _cge_mdef_find(M, name)
    if (anyof(tokens(subinstr(subinstr(list, ",", " "), "/", " ")), name)) _cge_fail("cge_model define: model " + name + " cannot list itself", 198)
    names = _cge_mdef_expand(M, list)
    if (rep) M.mdef[rep, 2] = list
    else M.mdef = M.mdef \ (name, list)
    _cge_store(M)
    printf("{txt}Model {res}%s{txt}%s: {res}%f{txt} equation(s): %s\n", name, (rep ? " (replaced)" : ""), rows(names),
           invtokens(names'))
    st_global("r(name)", name)
    st_global("r(equations)", invtokens(names'))
    st_numscalar("r(N_eq_blocks)", rows(names))
}

// cge_model drop name|_all and cge_model list (from version 0.17.0)
void _cge_mdef_drop(string scalar name)
{
    struct cge_model scalar M
    real scalar k, j
    M = _cge_load()
    if (cols(M.mdef) != 2) M.mdef = J(0, 2, "")
    if (name == "_all") {
        M.mdef = J(0, 2, "")
        _cge_store(M)
        printf("{txt}All named models dropped\n")
        return
    }
    k = _cge_mdef_find(M, name)
    if (!k) _cge_fail("model " + name + " not found", 111)
    // a model that another lists stays
    for (j = 1; j <= rows(M.mdef); j++) {
        if (j != k & anyof(tokens(subinstr(subinstr(M.mdef[j, 2], ",", " "), "/", " ")), name)) {
            _cge_fail("model " + name + " is listed by model " + M.mdef[j, 1] + "; drop that first", 459)
        }
    }
    M.mdef = (rows(M.mdef) > 1 ? select(M.mdef, (1::rows(M.mdef)) :!= k) : J(0, 2, ""))
    _cge_store(M)
    printf("{txt}Model {res}%s{txt} dropped\n", name)
}

void _cge_mdef_list()
{
    struct cge_model scalar M
    string colvector names
    real scalar k
    M = _cge_load()
    if (cols(M.mdef) != 2 | !rows(M.mdef)) {
        printf("{txt}No named models; define one with cge_model define\n")
        st_numscalar("r(N_models)", 0)
        st_global("r(models)", "")
        return
    }
    printf("{txt}Named models\n")
    for (k = 1; k <= rows(M.mdef); k++) {
        names = _cge_mdef_expand(M, M.mdef[k, 2])
        printf("{txt}  {res}%-16s{txt} / %s /: {res}%f{txt} equation(s)\n", M.mdef[k, 1], M.mdef[k, 2], rows(names))
    }
    st_numscalar("r(N_models)", rows(M.mdef))
    st_global("r(models)", invtokens(M.mdef[., 1]'))
}

// =====================================================================
// Nash equilibria and leaders (from version 0.20.0; model_spec.md, Section 29)
// =====================================================================

// cge_nash player: a player with its instruments, objective and bounds, as
// in cge_optimize; a player of the same name is replaced
void _cge_nash_add(string scalar name, string scalar ins, string scalar sense, string scalar obj,
                   string scalar lo, string scalar up)
{
    struct cge_model scalar M
    string rowvector t
    real scalar k, j, kind, pidx, st, rep
    string scalar pn
    M = _cge_load()
    _cge_need(M, "calibrated")
    t = tokens(ins)
    if (!cols(t)) _cge_fail("cge_nash player: give the player's instruments", 198)
    for (k = 1; k <= cols(t); k++) _cge_opt_instrument(M, t[k], kind, pn, pidx, st)
    if (cols(M.nashdef) != 6) M.nashdef = J(0, 6, "")
    // an instrument belongs to one player
    for (j = 1; j <= rows(M.nashdef); j++) {
        if (M.nashdef[j, 1] == name) continue
        for (k = 1; k <= cols(t); k++) {
            if (anyof(tokens(M.nashdef[j, 2]), t[k])) _cge_fail("cge_nash player: " + t[k] + " is an instrument of player " + M.nashdef[j, 1], 198)
        }
    }
    rep = (rows(M.nashdef) ? _cge_find(M.nashdef[., 1], name) : 0)
    if (rep) M.nashdef[rep, .] = (name, invtokens(t), sense, obj, lo, up)
    else M.nashdef = M.nashdef \ (name, invtokens(t), sense, obj, lo, up)
    _cge_store(M)
    printf("{txt}Player {res}%s{txt}%s: %s %s over %s\n", name, (rep ? " (replaced)" : ""), (sense == "maximize" ? "maximises" : "minimises"),
           obj, invtokens(t))
    st_numscalar("r(N_players)", rows(M.nashdef))
}

void _cge_nash_list()
{
    struct cge_model scalar M
    real scalar k
    M = _cge_load()
    if (cols(M.nashdef) != 6 | !rows(M.nashdef)) {
        printf("{txt}No players; define them with cge_nash player\n")
        st_numscalar("r(N_players)", 0)
        st_global("r(players)", "")
        return
    }
    printf("{txt}Players\n")
    for (k = 1; k <= rows(M.nashdef); k++) {
        printf("{txt}  {res}%-12s{txt} %s %s over %s%s%s\n", M.nashdef[k, 1], M.nashdef[k, 3], M.nashdef[k, 4], M.nashdef[k, 2],
               (M.nashdef[k, 5] != "" ? "; lower(" + M.nashdef[k, 5] + ")" : ""), (M.nashdef[k, 6] != "" ? "; upper(" + M.nashdef[k, 6] + ")" : ""))
    }
    st_numscalar("r(N_players)", rows(M.nashdef))
    st_global("r(players)", invtokens(M.nashdef[., 1]'))
}

void _cge_nash_clear(string scalar name)
{
    struct cge_model scalar M
    real colvector keep
    M = _cge_load()
    if (cols(M.nashdef) != 6) M.nashdef = J(0, 6, "")
    if (name == "") M.nashdef = J(0, 6, "")
    else {
        if (!rows(M.nashdef) | !_cge_find(M.nashdef[., 1], name)) _cge_fail("cge_nash: player " + name + " not found", 111)
        keep = (M.nashdef[., 1] :!= name)
        M.nashdef = (any(keep) ? select(M.nashdef, keep) : J(0, 6, ""))
    }
    _cge_store(M)
    printf("{txt}%s\n", (name == "" ? "All players removed" : "Player " + name + " removed"))
}

// The players, but exclude, as locals np, and p#_name, p#_ins, p#_sense,
// p#_obj, p#_lo and p#_up for the ado-file
void _cge_nash_locals(string scalar exclude)
{
    struct cge_model scalar M
    real scalar k, n
    string scalar pf
    M = _cge_load()
    if (cols(M.nashdef) != 6 | !rows(M.nashdef)) _cge_fail("cge_nash solve: define the players with cge_nash player", 459)
    if (exclude != "") if (!_cge_find(M.nashdef[., 1], exclude)) _cge_fail("cge_nash solve: player " + exclude + " not found", 111)
    n = 0
    for (k = 1; k <= rows(M.nashdef); k++) {
        if (M.nashdef[k, 1] == exclude) continue
        n++
        pf = "p" + strofreal(n) + "_"
        st_local(pf + "name", M.nashdef[k, 1])
        st_local(pf + "ins", M.nashdef[k, 2])
        st_local(pf + "sense", M.nashdef[k, 3])
        st_local(pf + "obj", M.nashdef[k, 4])
        st_local(pf + "lo", M.nashdef[k, 5])
        st_local(pf + "up", M.nashdef[k, 6])
    }
    st_local("np", strofreal(n))
}

// The value of a measure or expression, as an objective of cge_optimize, at
// stored simulation sim
real scalar _cge_nash_value(string scalar spec, string scalar sim)
{
    struct cge_model scalar M
    struct cge_opt scalar O
    struct cge_par scalar p
    string matrix keys
    string rowvector key
    string colvector tables
    real colvector val, x
    real scalar k, ex
    M = _cge_load()
    k = _cge_sim_index(M, sim)
    p = M.simp[k]
    x = M.simx[., k]
    O.estart = O.elen = J(0, 1, .)
    O.etok = J(0, 3, .)
    O.etext = J(0, 1, "")
    _cge_opt_rows(M, p, x, keys, val)
    tables = uniqrows(keys[., 1])
    ex = _cge_opt_parse(M, O, spec, "objective", key, tables)
    return(_cge_opt_item(M, O, p, x, keys, val, key, ex, 0))
}

// The current values of instruments ins, as cge_optimize reads them
real colvector _cge_nash_current(string scalar ins)
{
    struct cge_model scalar M
    string rowvector t
    real colvector v
    real scalar k, kind, pidx, st
    string scalar pn
    M = _cge_load()
    t = tokens(ins)
    v = J(cols(t), 1, .)
    for (k = 1; k <= cols(t); k++) {
        _cge_opt_instrument(M, t[k], kind, pn, pidx, st)
        v[k] = st
    }
    return(v)
}

// A leader (from version 0.20.0), as Stackelberg's: the leader's instruments
// maximise (or minimise) its objective at the Nash equilibrium of the other
// players that each choice of them gives, by a projected Newton method with
// central differences of that value (step 1e-3 times the scale of each
// instrument), steps halved until the value improves; each evaluation solves
// the followers' equilibrium by cge_nash solve
void _cge_nash_leader(string scalar leader, string scalar name, real scalar tol, real scalar maxit, real scalar trace)
{
    struct cge_model scalar M
    struct cge_opt scalar O
    string rowvector t
    real colvector u, g, d, lo, hi, sc, e, ut, z
    real matrix H
    real scalar n, k, j, f, ft, fp, fm, fpp, fpm, fmp, fmm, h, it, ls, sgn, lam, conv, gn, nev, kind, pidx, st
    string scalar pn, obj, slo, sup, cmd
    M = _cge_load()
    k = _cge_find(M.nashdef[., 1], leader)
    if (!k) _cge_fail("cge_nash solve: player " + leader + " not found", 111)
    if (rows(M.nashdef) < 2) _cge_fail("cge_nash solve: a leader needs at least one other player", 459)
    t = tokens(M.nashdef[k, 2])
    obj = M.nashdef[k, 4]
    sgn = (M.nashdef[k, 3] == "maximize" ? 1 : -1)
    slo = M.nashdef[k, 5]
    sup = M.nashdef[k, 6]
    n = cols(t)
    O.kind = O.pidx = O.start = J(n, 1, .)
    O.pname = J(n, 1, "")
    for (j = 1; j <= n; j++) {
        _cge_opt_instrument(M, t[j], kind, pn, pidx, st)
        O.kind[j] = kind
        O.pname[j] = pn
        O.pidx[j] = pidx
        O.start[j] = st
    }
    u = O.start
    sc = abs(u) :* (abs(u) :> 1e-12) + (abs(u) :<= 1e-12)
    lo = J(n, 1, -1e300)
    hi = J(n, 1, 1e300)
    _cge_nash_bounds(t, slo, lo)
    _cge_nash_bounds(t, sup, hi)
    nev = 0
    conv = 0
    f = _cge_nash_leval(O, u, leader, obj, sgn, tol, maxit, nev)
    if (f >= .) _cge_fail("cge_nash solve: the followers' equilibrium was not found at the leader's start", 430)
    for (it = 1; it <= 50; it++) {
        g = J(n, 1, .)
        H = J(n, n, .)
        for (j = 1; j <= n; j++) {
            h = 1e-3 * sc[j]
            e = J(n, 1, 0)
            e[j] = h
            fp = _cge_nash_leval(O, u + e, leader, obj, sgn, tol, maxit, nev)
            fm = _cge_nash_leval(O, u - e, leader, obj, sgn, tol, maxit, nev)
            if (fp >= . | fm >= .) _cge_fail("cge_nash solve: the followers' equilibrium was not found near the leader's choice", 430)
            g[j] = (fp - fm) / (2 * h)
            H[j, j] = (fp - 2 * f + fm) / h^2
        }
        for (j = 1; j <= n; j++) {
            for (k = j + 1; k <= n; k++) {
                e = J(n, 1, 0)
                e[j] = 1e-3 * sc[j]
                e[k] = 1e-3 * sc[k]
                fpp = _cge_nash_leval(O, u + e, leader, obj, sgn, tol, maxit, nev)
                fmm = _cge_nash_leval(O, u - e, leader, obj, sgn, tol, maxit, nev)
                e[k] = -e[k]
                fpm = _cge_nash_leval(O, u + e, leader, obj, sgn, tol, maxit, nev)
                fmp = _cge_nash_leval(O, u - e, leader, obj, sgn, tol, maxit, nev)
                H[j, k] = H[k, j] = (fpp - fpm - fmp + fmm) / (4 * 1e-6 * sc[j] * sc[k])
            }
        }
        // held at a bound where the gradient points outwards
        z = !((u :<= lo :+ 1e-12) :& (g :< 0)) :& !((u :>= hi :- 1e-12) :& (g :> 0))
        gn = max(abs(z :* g :* sc)) / max((1, abs(f)))
        if (trace) printf("{txt}Leader iteration %f: objective {res}%14.10g{txt}, largest free gradient {res}%9.3e\n", it - 1, sgn * f, gn)
        if (gn < 1e-6) {
            conv = 1
            break
        }
        d = J(n, 1, 0)
        if (max(symeigenvalues(select(select(H, z), z'))) < 0) d[_cge_which(z)] = -lusolve(select(select(H, z), z'), select(g, z))
        else d[_cge_which(z)] = select(g :* sc :^ 2, z) / max((1, max(abs(select(g :* sc, z)))))
        lam = 1
        for (ls = 1; ls <= 30; ls++) {
            ut = rowmax((rowmin((u + lam * d, hi)), lo))
            ft = _cge_nash_leval(O, ut, leader, obj, sgn, tol, maxit, nev)
            if (ft < . & ft > f - 1e-12 * max((1, abs(f)))) break
            lam = lam / 2
        }
        if (ls > 30) {
            conv = (gn < 1e-4)
            break
        }
        if (max(abs(ut - u) :/ sc) < 1e-10) {
            u = ut
            f = ft
            conv = 1
            break
        }
        u = ut
        f = ft
    }
    // the equilibrium at the leader's choice
    f = _cge_nash_leval(O, u, leader, obj, sgn, tol, maxit, nev)
    st_numscalar("r(leader_converged)", conv)
    st_numscalar("r(leader_objective)", sgn * f)
    st_numscalar("r(N_equilibria)", nev)
    st_matrix("r(leader_instruments)", u')
}

// A player's instruments at a bound moved inside it, as cge_optimize starts
// from within the bounds
void _cge_nash_nudge(string scalar ins, string scalar slo, string scalar sup)
{
    struct cge_model scalar M
    struct cge_opt scalar O
    string rowvector t
    real colvector u, lo, hi
    real scalar n, j, kind, pidx, st, ch, d
    string scalar pn
    M = _cge_load()
    t = tokens(ins)
    n = cols(t)
    O.kind = O.pidx = O.start = J(n, 1, .)
    O.pname = J(n, 1, "")
    for (j = 1; j <= n; j++) {
        _cge_opt_instrument(M, t[j], kind, pn, pidx, st)
        O.kind[j] = kind
        O.pname[j] = pn
        O.pidx[j] = pidx
        O.start[j] = st
    }
    u = O.start
    lo = J(n, 1, -1e300)
    hi = J(n, 1, 1e300)
    _cge_nash_bounds(t, slo, lo)
    _cge_nash_bounds(t, sup, hi)
    ch = 0
    for (j = 1; j <= n; j++) {
        // 5 per cent of a finite range inside, or 1 per cent of the bound's
        // size: cge_optimize scales an instrument by its start, so that a
        // start just inside a bound at 0 would make its steps minute
        d = (lo[j] > -1e299 & hi[j] < 1e299 ? 0.05 * (hi[j] - lo[j]) : 0.01 * max((1, abs(u[j]))))
        if (u[j] <= lo[j]) {
            u[j] = lo[j] + d
            ch = 1
        }
        else if (u[j] >= hi[j]) {
            u[j] = hi[j] - d
            ch = 1
        }
    }
    if (ch) {
        _cge_opt_set(O, u, M.p, M.xcur)
        _cge_store(M)
    }
}

// The bounds of a player's instruments, as cge_optimize's lower() and upper()
// (instrument:value pairs), into b
void _cge_nash_bounds(string rowvector t, string scalar spec, real colvector b)
{
    string rowvector pr
    real scalar k, j, c
    pr = tokens(spec)
    for (k = 1; k <= cols(pr); k++) {
        c = _cge_strrpos(pr[k], ":")
        if (!c) _cge_fail("cge_nash: write bounds as instrument:value", 198)
        j = _cge_find(t', substr(pr[k], 1, c - 1))
        if (!j) _cge_fail("cge_nash: " + substr(pr[k], 1, c - 1) + " is not an instrument of the player", 198)
        b[j] = strtoreal(substr(pr[k], c + 1, .))
    }
}

// The last position of ch in s (Stata 13 has no strrpos)
real scalar _cge_strrpos(string scalar s, string scalar ch)
{
    real scalar k
    for (k = strlen(s); k >= 1; k--) if (substr(s, k, 1) == ch) return(k)
    return(0)
}

// The leader's objective (with its sense, to be maximised) at the followers'
// equilibrium with its instruments at u; missing if it is not found
real scalar _cge_nash_leval(struct cge_opt scalar O, real colvector u, string scalar leader, string scalar obj,
                            real scalar sgn, real scalar tol, real scalar maxit, real scalar nev)
{
    struct cge_model scalar M
    real scalar rc
    M = _cge_load()
    _cge_opt_set(O, u, M.p, M.xcur)
    _cge_store(M)
    nev++
    rc = _stata("quietly cge_nash solve, name(_cgelead) exclude(" + leader + ") tolerance(" + strofreal(tol, "%21.17g") +
                ") iterate(" + strofreal(maxit) + ")", 1)
    if (rc) return(.)
    if (st_numscalar("r(converged)") != 1) return(.)
    return(sgn * _cge_nash_value(obj, "_cgelead"))
}

// The simulations named in names dropped (the temporary ones of cge_nash)
void _cge_sims_drop(string rowvector names)
{
    struct cge_model scalar M
    real colvector keep
    real scalar k
    M = _cge_load()
    if (!rows(M.simname)) return
    keep = J(rows(M.simname), 1, 1)
    for (k = 1; k <= cols(names); k++) keep = keep :& (M.simname :!= names[k])
    if (all(keep)) return
    _cge_sims_keep(M, _cge_which(keep))
    _cge_store(M)
}

// =====================================================================
// Integer variables and branch and bound (from version 0.18.0;
// model_spec.md, Section 27)
// =====================================================================

// cge_bound NAME, integer|binary|continuous: the type of the elements of a
// user variable of a standalone model; binary also bounds them by 0 and 1
void _cge_int_add(string scalar name, string scalar elems, string scalar type)
{
    struct cge_model scalar M
    real colvector pos
    real scalar k
    M = _cge_load()
    _cge_need(M, "calibrated")
    if (!_cge_sa(M)) _cge_fail("cge_bound: integer and binary variables are variables of a standalone model (cge_model new)", 198)
    k = _cge_vidx(M, name)
    if (!k) _cge_fail("cge_bound: " + name + " is not a variable of the model", 198)
    pos = _cge_bd_pos(M, k, elems)
    if (!rows(pos)) _cge_fail("cge_bound: " + name + " has no element in this model", 459)
    if (cols(M.intdef) != 3) M.intdef = J(0, 3, "")
    M.intdef = M.intdef \ (name, strtrim(elems), type)
    if (type == "binary") {
        if (cols(M.bddef) != 7) M.bddef = J(0, 7, "")
        M.bddef = M.bddef \ (name, strtrim(elems), "0", "1", "", "", "")
        _cge_bd_sync(M)
        _cge_bd_valid(M)
    }
    _cge_store(M)
    printf("{txt}Variable {res}%s{txt}: %s for %f element(s)%s\n", name, type, rows(pos),
           (type == "binary" ? ", with bounds 0 and 1" : ""))
    st_global("r(name)", name)
    st_numscalar("r(N_elements)", rows(pos))
    st_numscalar("r(N_integer)", rows(_cge_int_pos(M)))
}

// The positions of the integer and binary elements
real colvector _cge_int_pos(struct cge_model scalar M)
{
    real colvector isint, pos
    real scalar r, k
    if (cols(M.intdef) != 3 | !rows(M.intdef)) return(J(0, 1, .))
    isint = J(rows(M.x0), 1, 0)
    for (r = 1; r <= rows(M.intdef); r++) {
        k = _cge_vidx(M, M.intdef[r, 1])
        if (!k) continue
        pos = _cge_bd_pos(M, k, M.intdef[r, 2], 1)
        if (rows(pos)) isint[pos] = J(rows(pos), 1, (M.intdef[r, 3] != "continuous"))
    }
    return(_cge_which(isint :& M.exists))
}

// The type of each element for GAMS: 0 continuous, 1 integer, 2 binary
real colvector _cge_int_type(struct cge_model scalar M)
{
    real colvector ty, pos
    real scalar r, k
    ty = J(rows(M.x0), 1, 0)
    if (cols(M.intdef) != 3) return(ty)
    for (r = 1; r <= rows(M.intdef); r++) {
        k = _cge_vidx(M, M.intdef[r, 1])
        if (!k) continue
        pos = _cge_bd_pos(M, k, M.intdef[r, 2], 1)
        if (rows(pos)) ty[pos] = J(rows(pos), 1, (M.intdef[r, 3] == "integer" ? 1 : (M.intdef[r, 3] == "binary" ? 2 : 0)))
    }
    return(ty)
}

// A node of branch and bound: the relaxation with the integer variables
// ipos within nlo and nup (the other bounds lo and up), solved from x0;
// those whose bounds meet are fixed. With more free variables than equations
// the interior point solves it, with as many Newton's method and a point
// within the bounds; with none left it is a point. Returns 1 with a solution
// x, its objective f and the multipliers lam
real scalar _cge_bb_node(struct cge_model scalar M, real colvector xfix, real colvector x0, real matrix tok,
                         real scalar sgn, real scalar tol, real scalar maxit, real colvector ipos,
                         real colvector lo, real colvector up, real colvector nlo, real colvector nup,
                         real colvector x, real scalar f, real scalar iter, real colvector lam)
{
    struct cge_model scalar N
    struct cge_sys scalar S
    real colvector lo2, up2, xf, st, fx, fr, sc
    real scalar conv, err, feas
    string scalar method
    iter = 0
    lam = J(0, 1, .)
    f = .
    x = x0
    if (any(nlo :> nup :+ 1e-9)) return(0)
    N = M
    lo2 = lo
    up2 = up
    lo2[ipos] = nlo
    up2[ipos] = nup
    xf = xfix
    st = x0
    fx = _cge_which(N.exists :& (N.fixed :== 0) :& (abs(up2 - lo2) :<= 1e-12 :* rowmax((J(rows(lo2), 1, 1), abs(lo2)))))
    if (rows(fx)) {
        N.fixed[fx] = J(rows(fx), 1, 1)
        xf[fx] = lo2[fx]
        st[fx] = lo2[fx]
    }
    N.bdlp = _cge_which(lo2 :> -1e299)
    N.bdlv = (rows(N.bdlp) ? lo2[N.bdlp] : J(0, 1, .))
    N.bdup = _cge_which(up2 :< 1e299)
    N.bduv = (rows(N.bdup) ? up2[N.bdup] : J(0, 1, .))
    S = _cge_sys_make(N, 0)
    if (rows(S.free) > S.neq) {
        feas = 0
        x = _cge_nlp_solve(N, N.p, xf, st, tok, sgn, tol, maxit, 0, conv, iter, err, f, lam, feas, 1)
        return(conv & f < .)
    }
    if (rows(S.free) == S.neq & S.neq > 0) {
        x = _cge_solve_point(N, N.p, xf, st, tol, maxit, 0, conv, iter, err, method, 0, 0)
        if (!conv) return(0)
    }
    else {
        if (rows(S.free)) return(0)
        x = xf
        if (S.neq) if (!(_cge_maxres(N, N.p, x) < tol)) return(0)
    }
    fr = S.free
    if (rows(fr)) {
        sc = rowmax((J(rows(fr), 1, 1), abs(x[fr])))
        if (any(x[fr] :< lo2[fr] :- 1e-9 :* sc) | any(x[fr] :> up2[fr] :+ 1e-9 :* sc)) return(0)
    }
    f = _cge_u_value(N, N.p, x, tok)
    return(f < .)
}

// Branch and bound (from version 0.18.0) over the integer variables ipos,
// as a GAMS MINLP or MIP solver: depth first, the child nearer the
// relaxation's value first; each node's relaxation solved by _cge_bb_node,
// branching on the most fractional variable, x <= floor(v) and x >= ceil(v);
// a node whose relaxation, or whose parent's, is no better than the
// incumbent less the gap tolerance (the larger of 1e-9 and optcr, relative)
// is pruned. Statuses: 1 (optimal) when the search ends with an integer
// solution, 8 (integer solution) when a limit stops it with one, 10 (integer
// infeasible) when it ends without, 14 (no solution returned) when a limit
// stops it without; nn the nodes solved, bound the best bound
real colvector _cge_bb(struct cge_model scalar M, real colvector xfix, real colvector start, real matrix tok,
                       real scalar sgn, real scalar tol, real scalar maxit, real scalar trace, real colvector ipos,
                       real scalar nodemax, real scalar optcr, real scalar conv, real scalar iter, real scalar err,
                       real scalar fobj, real colvector lam, real scalar nn, real scalar bound, real scalar ms,
                       real scalar ss)
{
    real colvector lo, up, nlo, nup, x, xn, xi, frac, xinc, laminc, lamn, d1, u1, xr
    real matrix SL, SU, SX
    real rowvector pb
    real scalar ni, hinc, h, f, it, j, v, top, stop, hp, gtol, ok, fr
    _cge_bd_full(M, lo, up)
    ni = rows(ipos)
    SL = lo[ipos]
    SU = up[ipos]
    SX = start
    pb = -1e300
    hinc = .
    xinc = laminc = J(0, 1, .)
    iter = nn = stop = 0
    conv = 0
    err = .
    while (cols(SL)) {
        if (nn >= nodemax) {
            stop = 2
            break
        }
        if (_cge_timeup()) {
            stop = 3
            break
        }
        top = cols(SL)
        nlo = SL[., top]
        nup = SU[., top]
        x = SX[., top]
        hp = pb[top]
        if (top > 1) {
            SL = SL[., (1..top - 1)]
            SU = SU[., (1..top - 1)]
            SX = SX[., (1..top - 1)]
            pb = pb[(1..top - 1)]
        }
        else {
            SL = SU = J(ni, 0, .)
            SX = J(rows(start), 0, .)
            pb = J(1, 0, .)
        }
        gtol = (hinc < . ? max((1e-9 * max((1, abs(hinc))), optcr * abs(hinc))) : 0)
        if (hinc < .) if (hp >= hinc - gtol) continue
        nn++
        ok = _cge_bb_node(M, xfix, x, tok, sgn, tol, maxit, ipos, lo, up, nlo, nup, xn, f, it, lamn)
        iter = iter + it
        if (!ok) {
            if (trace) printf("{txt}Node %f: no feasible relaxation\n", nn)
            continue
        }
        h = sgn * f
        if (hinc < .) if (h >= hinc - gtol) {
            if (trace) printf("{txt}Node %f: relaxation {res}%14.8g{txt}, no better than the incumbent\n", nn, f)
            continue
        }
        xi = xn[ipos]
        frac = abs(xi :- round(xi))
        if (max(frac) <= 1e-6) {
            hinc = h
            xinc = xn
            laminc = lamn
            if (trace) printf("{txt}Node %f: integer solution {res}%14.8g\n", nn, f)
            continue
        }
        // the most fractional variable
        j = 1
        for (fr = 2; fr <= ni; fr++) if (frac[fr] > frac[j]) j = fr
        v = xi[j]
        if (trace) printf("{txt}Node %f: relaxation {res}%14.8g{txt}; branch on %s = %g\n", nn, f, _cge_poslabel(M, ipos[j]), v)
        d1 = nup
        d1[j] = floor(v)
        u1 = nlo
        u1[j] = ceil(v)
        // the child nearer v is explored first, so pushed last
        if (v - floor(v) < 0.5) {
            SL = SL, u1, nlo
            SU = SU, nup, d1
        }
        else {
            SL = SL, nlo, u1
            SU = SU, d1, nup
        }
        SX = SX, xn, xn
        pb = pb, h, h
    }
    // the best bound: the incumbent, or the least bound of the nodes left
    if (cols(pb)) bound = min(pb)
    else bound = .
    if (hinc < .) bound = (bound < . ? min((bound, hinc)) : hinc)
    if (bound <= -1e299) bound = .
    bound = (bound < . ? sgn * bound : .)
    if (hinc >= .) {
        fobj = .
        ms = (stop ? 14 : 10)
        ss = (stop ? stop : 1)
        lam = J(0, 1, .)
        return(start)
    }
    // the incumbent polished with its integer values fixed
    xr = xinc
    xr[ipos] = round(xinc[ipos])
    ok = _cge_bb_node(M, xfix, xr, tok, sgn, tol, maxit, ipos, lo, up, round(xinc[ipos]), round(xinc[ipos]), xn, f, it, lamn)
    iter = iter + it
    if (ok) {
        xinc = xn
        laminc = lamn
        hinc = sgn * f
    }
    fobj = sgn * hinc
    if (!stop) bound = fobj
    // the marginals of the equations with the integer values fixed, as GAMS
    // reports them for a MIP
    lam = laminc
    conv = !stop
    ms = (stop ? 8 : 1)
    ss = (stop ? stop : 1)
    // the largest scaled residual of the equations at the solution
    err = _cge_maxres(M, M.p, xinc)
    return(xinc)
}

// =====================================================================
// Nonlinear programmes (from version 0.15.0; model_spec.md, Section 24)
// =====================================================================

// cge_solve, minimize(expression) or maximize(expression) for a standalone
// model with more free variables than equations: the programme
//   min (or max) f(x) subject to the equations c(x) = 0 and the bounds of
//   cge_bound, l <= x <= u,
// solved by the interior-point method of _cge_nlp_solve and stored as a
// simulation, with the multipliers of the equations
void _cge_nlp_run(struct cge_model scalar M, string scalar name, string scalar obj, real scalar tol,
                  real scalar maxit, real scalar trace, string scalar lin, | string scalar mname, string scalar from,
                  string scalar hold, real scalar nodes, real scalar optcr)
{
    struct cge_sys scalar S
    struct cge_model scalar M2
    real matrix tok
    real colvector x, lam, start, xs, usel, ipos
    real scalar sgn, conv, iter, err, fobj, k, keeplin, feas, ms, ss, nn, bnd
    string scalar g
    if (args() < 8) mname = ""
    if (args() < 9) from = ""
    if (args() < 10) hold = ""
    if (args() < 11) nodes = -1
    if (args() < 12) optcr = -1
    if (nodes < 0 | nodes >= .) nodes = 10000
    if (optcr < 0 | optcr >= .) optcr = 0
    if (!_cge_sa(M)) _cge_fail("minimize() and maximize() solve a nonlinear programme of a standalone model (cge_model new); optimise a model from a SAM with cge_optimize", 198)
    if (rows(M.bY)) {
        _cge_fail("constraints and inequalities paired with variables are complementarity conditions; a nonlinear programme takes equations and the bounds of cge_bound: write an inequality as an equation with a slack variable bounded at zero", 459)
    }
    keeplin = M.linsolver
    if (name == "") name = "sim" + strofreal(rows(M.simname) + 1)
    tok = _cge_nlp_tok(M, obj, sgn, g)
    // a named model and a start from a stored simulation (from version
    // 0.17.0): the model's equations, the other free variables at their levels
    xs = _cge_named_start(M, from)
    if (mname != "") _cge_submodel(M, mname, M2, usel)
    else M2 = M
    _cge_hold(M2, hold)
    start = _cge_named_from(M2, xs, from)
    feas = 0
    // integer variables (from version 0.18.0): branch and bound
    ipos = _cge_int_pos(M2)
    nn = 0
    bnd = .
    if (rows(ipos)) {
        x = _cge_bb(M2, xs, start, tok, sgn, tol, maxit, trace, ipos, nodes, optcr, conv, iter, err, fobj, lam, nn, bnd, ms, ss)
    }
    else x = _cge_nlp_solve(M2, M2.p, xs, start, tok, sgn, tol, maxit, trace, conv, iter, err, fobj, lam, feas)
    M.linsolver = keeplin
    k = _cge_store_sim(M, name, x, conv, iter, err, (rows(ipos) ? "minlp" : "nlp"))
    _cge_set_simobj(M, k, obj)
    _cge_set_simmodel(M, k, mname)
    // the statuses, in GAMS's codes (from version 0.16.0)
    if (!rows(ipos)) _cge_status(conv, 0, 1, feas, err, ms, ss)
    _cge_set_simstat(M, k, ms, ss)
    _cge_store(M)
    if (rows(ipos)) {
        if (conv) printf("{txt}Simulation {res}%s{txt} solved by branch and bound: {res}%f{txt} node(s), {res}%f{txt} iteration(s)\n",
                         name, nn, iter)
        else {
            printf("{err}Simulation %s: branch and bound stopped after %f node(s)%s\n", name, nn,
                   (fobj < . ? " with an integer solution" : " without an integer solution"))
            _cge_status_show(ms, ss)
        }
        if (bnd < .) printf("{txt}Best bound {res}%16.10g{txt}; relative gap {res}%9.3e\n", bnd,
                            (fobj < . ? abs(fobj - bnd) / max((1e-10, abs(fobj))) : .))
    }
    else if (conv) printf("{txt}Simulation {res}%s{txt} solved in {res}%f{txt} iteration(s) (interior point)\n", name, iter)
    else {
        printf("{err}Simulation %s did not converge (largest scaled error %9.3e)\n", name, err)
        _cge_status_show(ms, ss)
    }
    printf("{txt}%s %s: {res}%16.10g\n", (sgn < 0 ? "Maximised" : "Minimised"), substr(obj, 5, .), fobj)
    printf("{txt}Largest scaled %s {res}%9.3e\n", (rows(ipos) ? "residual of the equations" : "error of the optimality conditions"), err)
    st_numscalar("r(converged)", conv)
    st_numscalar("r(iterations)", iter)
    st_numscalar("r(max_residual)", err)
    st_numscalar("r(objective)", fobj)
    st_numscalar("r(modelstat)", ms)
    st_numscalar("r(solvestat)", ss)
    S = _cge_sys_make(M2, 0)
    st_numscalar("r(N_dof)", rows(S.free) - S.neq)
    st_global("r(model)", mname)
    // branch and bound (from version 0.18.0)
    st_numscalar("r(N_integer)", rows(ipos))
    if (rows(ipos)) {
        st_numscalar("r(nodes)", nn)
        st_numscalar("r(bestbound)", bnd)
        st_numscalar("r(gap)", (fobj < . & bnd < . ? abs(fobj - bnd) / max((1e-10, abs(fobj))) : .))
    }
    if (rows(lam)) st_matrix("r(marginals)", lam')
    st_global("r(name)", name)
    st_global("r(method)", (rows(ipos) ? "minlp" : "nlp"))
    st_global("r(objective_expr)", substr(obj, 5, .))
}

// The objective of a nonlinear programme compiled to postfix rows, from
// "min:expression" or "max:expression": sgn 1 to minimise, -1 to maximise,
// and its GAMS text in g
real matrix _cge_nlp_tok(struct cge_model scalar M, string scalar spec, real scalar sgn, string scalar g)
{
    sgn = (substr(spec, 1, 4) == "max:" ? -1 : 1)
    return(_cge_u_compile(M, _cge_u_written(M, M.p0, M.x0, _cge_u_tokens(substr(spec, 5, .))), M.x0, g))
}

// The objective at x and its gradient gz with respect to the free variables
// (scaled), by forward differentiation of its postfix rows; map gives the
// position of each variable among the free ones (0 for fixed ones)
real scalar _cge_nlp_f(struct cge_model scalar M, struct cge_par scalar p, real colvector x, real matrix tok,
                       real scalar nfree, real colvector map, real colvector gz)
{
    real colvector vpos, sel
    real rowvector gr
    real scalar v
    vpos = select(tok[., 2], tok[., 1] :== 2)
    gz = J(nfree, 1, 0)
    if (!rows(vpos)) return(_cge_u_value(M, p, x, tok))
    vpos = uniqrows(vpos)
    v = _cge_u_dvalue(M, p, x, tok, vpos, gr)
    sel = selectindex(map[vpos, 1] :> 0)
    if (rows(sel) * cols(sel)) gz[map[vpos[sel], 1]] = colshape(gr[sel], 1) :* M.xscale[vpos[sel], 1]
    return(v)
}

// A point z (the free variables, scaled) of a nonlinear programme: the
// objective f (with its sense, divided by osc), its gradient gf, the scaled
// residuals c of the equations and their exact Jacobian Jm; 0 where they
// cannot be evaluated
real scalar _cge_nlp_eval(struct cge_model scalar M, struct cge_par scalar p, real colvector xfix,
                          struct cge_sys scalar S, real colvector z, real matrix tok, real scalar sgn,
                          real scalar osc, real colvector map, real scalar f, real colvector gf,
                          real colvector c, real matrix Jm)
{
    real colvector x, jr, jc, jv
    x = xfix
    x[S.free] = z :* M.xscale[S.free]
    if (S.reduced) _cge_derive(M, p, x)
    f = _cge_nlp_f(M, p, x, tok, rows(z), map, gf)
    if (f >= . | hasmissing(gf)) return(0)
    f = sgn * f / osc
    gf = sgn :* gf :/ osc
    c = J(0, 1, .)
    Jm = J(0, rows(z), 0)
    if (S.neq) {
        c = _cge_F(M, p, xfix, S, z)
        if (hasmissing(c)) return(0)
        if (!_cge_jac_trip(M, p, xfix, S, z, jr, jc, jv)) return(0)
        Jm = _cge_trip_dense(jr, jc, jv, S.neq, rows(z))
    }
    return(1)
}

// The primal-dual interior-point method (from version 0.15.0) for
//   min f(z) subject to c(z) = 0, L <= z <= U
// in the scaled free variables z, after Wachter and Biegler (2006): the
// barrier problem with parameter mu, decreased by the monotone rule as each
// is solved; Newton's steps on its optimality conditions, with the Hessian of
// the Lagrangian from central differences of its exact gradient and a
// multiple of the identity added until the Hessian is positive definite on
// the null space of the equations' Jacobian; the fraction-to-the-boundary
// rule; and a line search on the l1 merit function of the barrier problem.
// Returns the solution x; conv, iter, err (the largest scaled error of the
// optimality conditions), the objective fobj and the multipliers lam of the
// equations, in units of the objective per unit of each right side.
real colvector _cge_nlp_solve(struct cge_model scalar M, struct cge_par scalar p, real colvector xfix,
                              real colvector start, real matrix tok, real scalar sgn, real scalar tol,
                              real scalar maxit, real scalar trace, real scalar conv, real scalar iter,
                              real scalar err, real scalar fobj, real colvector lam, | real scalar feas,
                              real scalar soft)
{
    struct cge_sys scalar S
    real colvector map, z, L, U, il, iu, gf, c, sl, su, zl, zu, rd, dz, dzl, dzu, zn, cn, gfn, e, gp, gm
    real colvector cp, cm, sol, lamn, gphi, sig, x, esc, ev
    real matrix Jm, Jn, Jp, Jmm, W, Hs, K, Q, R, Z
    real scalar n, m, mu, f, fn, it, i, h, hp, hm, osc, sd, ed, ep, ec, emu, del, a, az, tau, nu, phi, phin
    real scalar dphi, ok, k, lmin, fp, fm, ntry
    S = _cge_sys_make(M, 0)
    n = rows(S.free)
    m = S.neq
    conv = 0
    iter = 0
    err = .
    fobj = .
    lam = J(0, 1, .)
    // soft (from version 0.18.0): a node of branch and bound returns without a
    // solution instead of stopping
    if (args() < 16) soft = 0
    if (n <= m & soft) return(start)
    if (n <= m) {
        _cge_fail("a nonlinear programme needs more free variables than equations: the model has " + strofreal(n) +
                  " free variable element(s) and " + strofreal(m) + " equation(s)", 459)
    }
    map = J(rows(M.x0), 1, 0)
    map[S.free] = (1::n)
    // the bounds of the free variables (cge_bound), scaled
    L = U = J(n, 1, .)
    for (k = 1; k <= rows(M.bdlp); k++) if (map[M.bdlp[k]]) L[map[M.bdlp[k]]] = M.bdlv[k] / M.xscale[M.bdlp[k]]
    for (k = 1; k <= rows(M.bdup); k++) if (map[M.bdup[k]]) U[map[M.bdup[k]]] = M.bduv[k] / M.xscale[M.bdup[k]]
    il = _cge_which(L :< .)
    iu = _cge_which(U :< .)
    for (k = 1; k <= rows(il); k++) {
        if (U[il[k]] < . & U[il[k]] - L[il[k]] <= 1e-12 * max((1, abs(L[il[k]])))) {
            if (soft) return(start)
            _cge_fail(_cge_poslabel(M, S.free[il[k]]) + ": its lower and upper bounds are equal; fix it with cge_variable, fixed", 459)
        }
    }
    // the start, pushed into the bounds
    z = start[S.free] :/ M.xscale[S.free]
    for (i = 1; i <= n; i++) {
        // inside by a margin, as Wachter and Biegler's bound push, at most a
        // quarter of the interval
        if (L[i] < . & U[i] < .) {
            z[i] = max((z[i], L[i] + min((1e-2 * max((1, abs(L[i]))), 0.25 * (U[i] - L[i])))))
            z[i] = min((z[i], U[i] - min((1e-2 * max((1, abs(U[i]))), 0.25 * (U[i] - L[i])))))
        }
        else if (L[i] < .) z[i] = max((z[i], L[i] + 1e-2 * max((1, abs(L[i])))))
        else if (U[i] < .) z[i] = min((z[i], U[i] - 1e-2 * max((1, abs(U[i])))))
    }
    // the objective scaled so that its largest derivative at the start is at
    // most 100
    osc = 1
    if (!_cge_nlp_eval(M, p, xfix, S, z, tok, sgn, osc, map, f, gf, c, Jm)) {
        if (soft) return(start)
        _cge_fail("the objective or the equations cannot be evaluated at the start of the nonlinear programme", 459)
    }
    osc = max((1, max(abs(gf)) / 100))
    f = f / osc
    gf = gf / osc
    mu = 0.1
    lam = J(m, 1, 0)
    // least-squares multipliers to start
    if (m) {
        lam = -lusolve(Jm * Jm' + 1e-12 * I(m), Jm * gf)
        if (hasmissing(lam)) lam = J(m, 1, 0)
        else if (max(abs(lam)) > 1e3) lam = J(m, 1, 0)
    }
    sl = su = J(n, 1, 1)
    zl = zu = J(n, 1, 0)
    if (rows(il)) {
        sl[il] = z[il] - L[il]
        zl[il] = mu :/ sl[il]
    }
    if (rows(iu)) {
        su[iu] = U[iu] - z[iu]
        zu[iu] = mu :/ su[iu]
    }
    nu = 1
    for (it = 0; it <= maxit; it++) {
        iter = it
        // the optimality conditions, scaled as in Wachter and Biegler (2006)
        rd = gf - zl + zu
        if (m) rd = rd + Jm' * lam
        sd = max((100, (sum(abs(lam)) + sum(zl) + sum(zu)) / max((1, m + rows(il) + rows(iu))))) / 100
        ed = max(abs(rd)) / sd
        ep = (m ? max(abs(c)) : 0)
        ec = 0
        if (rows(il)) ec = max((ec, max(abs(sl[il] :* zl[il])) / sd))
        if (rows(iu)) ec = max((ec, max(abs(su[iu] :* zu[iu])) / sd))
        err = max((ed, ep, ec))
        if (trace) printf("{txt}Iteration %f: objective {res}%14.8g{txt}, dual {res}%9.2e{txt}, primal {res}%9.2e{txt}, complementarity {res}%9.2e{txt}, mu %9.2e\n",
                          it, sgn * f * osc, ed, ep, ec, mu)
        // whether the point satisfies the equations, to the tolerance or to
        // 1e-8 of the scaled residuals, for the statuses (from version 0.16.0)
        feas = (ep < max((tol, 1e-8)))
        if (err < tol) {
            conv = 1
            break
        }
        if (it == maxit) {
            _cge_stop_set(2)
            break
        }
        if (_cge_timeup()) break
        // the barrier parameter, decreased while each barrier problem is solved
        while (mu > tol / 10) {
            emu = max((ed, ep))
            if (rows(il)) emu = max((emu, max(abs(sl[il] :* zl[il] :- mu)) / sd))
            if (rows(iu)) emu = max((emu, max(abs(su[iu] :* zu[iu] :- mu)) / sd))
            if (emu > 10 * mu) break
            mu = max((tol / 10, min((0.2 * mu, mu^1.5))))
        }
        // the Hessian of the Lagrangian: central differences of its exact
        // gradient, one-sided toward the inside near a bound
        W = J(n, n, .)
        ok = 1
        for (i = 1; i <= n; i++) {
            h = 1e-6 * max((1, abs(z[i])))
            hp = hm = h
            if (L[i] < .) if (z[i] - h <= L[i]) hm = 0
            if (U[i] < .) if (z[i] + h >= U[i]) hp = 0
            if (hp == 0 & hm == 0) hp = hm = min((sl[i], su[i])) / 4
            e = J(n, 1, 0)
            if (hp > 0) {
                e[i] = hp
                if (!_cge_nlp_eval(M, p, xfix, S, z + e, tok, sgn, osc, map, fp, gp, cp, Jp)) ok = 0
                else if (m) gp = gp + Jp' * lam
            }
            else gp = rd + zl - zu
            if (hm > 0) {
                e[i] = -hm
                if (!_cge_nlp_eval(M, p, xfix, S, z + e, tok, sgn, osc, map, fm, gm, cm, Jmm)) ok = 0
                else if (m) gm = gm + Jmm' * lam
            }
            else gm = rd + zl - zu
            if (!ok) break
            W[., i] = (gp - gm) / (hp + hm)
        }
        if (!ok) break
        W = (W + W') / 2
        sig = J(n, 1, 0)
        if (rows(il)) sig[il] = zl[il] :/ sl[il]
        if (rows(iu)) sig[iu] = sig[iu] + zu[iu] :/ su[iu]
        Hs = W + diag(sig)
        // positive definite on the null space of the Jacobian
        if (m) {
            qrd(Jm', Q, R)
            Z = Q[., (m + 1)..n]
            lmin = min(symeigenvalues(Z' * Hs * Z))
        }
        else lmin = min(symeigenvalues(Hs))
        del = max((0, 1e-8 * max((1, max(abs(diagonal(Hs))))) - lmin))
        // the step
        gphi = gf
        if (rows(il)) gphi[il] = gphi[il] - mu :/ sl[il]
        if (rows(iu)) gphi[iu] = gphi[iu] + mu :/ su[iu]
        sol = J(0, 1, .)
        for (ntry = 1; ntry <= 4; ntry++) {
            if (m) {
                K = (Hs + del * I(n), Jm' \ Jm, -(ntry > 1 ? 1e-8 * 10^ntry : 0) * I(m))
                sol = lusolve(K, -(gphi \ c))
            }
            else sol = lusolve(Hs + del * I(n), -gphi)
            if (!hasmissing(sol)) break
            del = max((1e-6, 10 * del))
        }
        if (hasmissing(sol)) break
        dz = sol[|1 \ n|]
        lamn = (m ? sol[|n + 1 \ n + m|] : J(0, 1, .))
        dzl = dzu = J(n, 1, 0)
        if (rows(il)) dzl[il] = mu :/ sl[il] - zl[il] - (zl[il] :/ sl[il]) :* dz[il]
        if (rows(iu)) dzu[iu] = mu :/ su[iu] - zu[iu] + (zu[iu] :/ su[iu]) :* dz[iu]
        // the fraction to the boundary
        tau = max((0.99, 1 - mu))
        a = az = 1
        for (k = 1; k <= rows(il); k++) {
            if (dz[il[k]] < 0) a = min((a, -tau * sl[il[k]] / dz[il[k]]))
            if (dzl[il[k]] < 0) az = min((az, -tau * zl[il[k]] / dzl[il[k]]))
        }
        for (k = 1; k <= rows(iu); k++) {
            if (dz[iu[k]] > 0) a = min((a, tau * su[iu[k]] / dz[iu[k]]))
            if (dzu[iu[k]] < 0) az = min((az, -tau * zu[iu[k]] / dzu[iu[k]]))
        }
        // the line search on the l1 merit function of the barrier problem
        if (m) nu = max((nu, max(abs(lamn)) + 1))
        phi = f + (m ? nu * sum(abs(c)) : 0)
        if (rows(il)) phi = phi - mu * sum(ln(sl[il]))
        if (rows(iu)) phi = phi - mu * sum(ln(su[iu]))
        dphi = gphi' * dz - (m ? nu * sum(abs(c)) : 0)
        ok = 0
        for (; a >= 1e-12; a = a / 2) {
            zn = z + a * dz
            if (!_cge_nlp_eval(M, p, xfix, S, zn, tok, sgn, osc, map, fn, gfn, cn, Jn)) continue
            phin = fn + (m ? nu * sum(abs(cn)) : 0)
            if (rows(il)) phin = phin - mu * sum(ln(zn[il] - L[il]))
            if (rows(iu)) phin = phin - mu * sum(ln(U[iu] - zn[iu]))
            // Armijo's condition, with room for rounding
            if (phin <= phi + 1e-4 * a * min((dphi, 0)) + 1e-13 * max((1, abs(phi)))) {
                ok = 1
                break
            }
        }
        if (!ok) break
        z = zn
        f = fn
        gf = gfn
        c = cn
        Jm = Jn
        if (m) lam = lam + a * (lamn - lam)
        if (rows(il)) {
            sl[il] = z[il] - L[il]
            zl[il] = zl[il] + az * dzl[il]
            // the bound multipliers stay close to mu / slack
            zl[il] = rowmax((rowmin((zl[il], 1e10 * mu :/ sl[il])), mu :/ (1e10 :* sl[il])))
        }
        if (rows(iu)) {
            su[iu] = U[iu] - z[iu]
            zu[iu] = zu[iu] + az * dzu[iu]
            zu[iu] = rowmax((rowmin((zu[iu], 1e10 * mu :/ su[iu])), mu :/ (1e10 :* su[iu])))
        }
    }
    // a point the method cannot improve, before its iteration limit, at which
    // the equations hold and the optimality conditions nearly do, is
    // accepted, as IPOPT's acceptable level (from version 0.18.0)
    if (!conv & it < maxit & err < max((1e3 * tol, 1e-7)) & ep < max((tol, 1e-8))) conv = 1
    x = xfix
    x[S.free] = z :* M.xscale[S.free]
    if (S.reduced) _cge_derive(M, p, x)
    fobj = sgn * f * osc
    // the marginal of each equation: the change in the objective per unit of
    // its right side
    if (m) {
        esc = select(M.escale, S.mask)
        lam = -sgn * osc :* lam :/ esc
    }
    return(x)
